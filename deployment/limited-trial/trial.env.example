# Inject values through the approved platform secret/config channel, never Git.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
WX_APP_ID=
WX_APP_SECRET=
WX_STAFF_APP_ID=
WX_STAFF_APP_SECRET=
