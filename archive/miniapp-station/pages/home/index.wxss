.page-container {
  background: linear-gradient(180deg, #007AFF 0%, #00C6FF 100%);
  min-height: 100vh;
}

.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 24rpx 20rpx;
  color: #fff;
}

.greeting {
  font-size: 28rpx;
  opacity: 0.9;
}

.station-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.3);
}

/* 数据卡片 */
.stats-section {
  padding: 0 24rpx;
  margin-top: -20rpx;
  z-index: 10;
  position: relative;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.stat-icon {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #007AFF;
  margin-bottom: 4rpx;
}

.stat-value.warning {
  color: #FF4D4F;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 快捷入口 */
.quick-entry {
  background: #fff;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.entry-item image {
  width: 80rpx;
  height: 80rpx;
}

.entry-item text {
  font-size: 24rpx;
  color: #333;
}