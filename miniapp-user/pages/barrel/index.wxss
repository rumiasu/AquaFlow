.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 概况卡片 */
.summary-card {
  background: var(--accent-gradient);
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  color: #fff;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
}

.deposit-badge {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.summary-main {
  text-align: center;
  margin-bottom: 40rpx;
}

.bucket-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bucket-count {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.bucket-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 500;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.return-btn {
  margin-top: 24rpx;
  height: 72rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-regular);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-value.highlight {
  color: var(--price-color);
}

.info-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

/* 退桶记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  padding: 20rpx;
  background-color: var(--bg-gray);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
}

.record-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-qty {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.record-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-1 {
  color: var(--warning-color);
  background-color: rgba(217, 119, 6, 0.08);
}

.status-2 {
  color: var(--primary-color);
  background-color: var(--primary-bg);
}

.status-3 {
  color: var(--success-color);
  background-color: rgba(5, 150, 105, 0.08);
}

.status-4 {
  color: var(--error-color);
  background-color: rgba(220, 38, 38, 0.08);
}

.record-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-note {
  font-size: 24rpx;
  color: var(--text-regular);
}

.record-deposit {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
  font-size: 26rpx;
  color: var(--price-color);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-content.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-secondary);
  padding: 0 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.return-tip {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-bottom: 24rpx;
}

.return-tip .highlight {
  color: var(--primary-color);
  font-weight: 700;
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-btn text {
  font-size: 36rpx;
  color: var(--text-primary);
  line-height: 1;
}

.qty-input {
  width: 100rpx;
  height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 16rpx;
  color: var(--text-primary);
}

.deposit-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.deposit-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.deposit-max {
  font-size: 24rpx;
  color: var(--primary-color);
  white-space: nowrap;
  padding: 8rpx 16rpx;
  background-color: var(--primary-bg);
  border-radius: 8rpx;
}

.note-input {
  width: 100%;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.modal-footer {
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background-color: var(--bg-gray);
  color: var(--text-regular);
}

.modal-btn.confirm {
  background: var(--primary-gradient);
  color: #fff;
}

.modal-btn.confirm.disabled {
  background: var(--text-placeholder);
}
