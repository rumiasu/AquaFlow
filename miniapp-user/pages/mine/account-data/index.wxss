.page { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}
.card { padding: 24rpx; margin-bottom: 24rpx; border-radius: var(--radius-md); background: var(--bg-white);
  border: 1rpx solid var(--border-color);
}
.title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; color: var(--text-primary); }
.body { display: block; font-size: 26rpx; line-height: 1.7; margin-bottom: 16rpx; color: var(--text-regular); word-break: break-all; }
.error { display: block; font-size: 26rpx; color: var(--error-color); margin-bottom: 16rpx;
  line-height: 1.7;
  background: var(--error-bg);
  padding: 20rpx;
}
textarea { width: 100%; height: 180rpx; margin-bottom: 24rpx; font-size: 26rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
}
.record { padding-top: 16rpx; border-top: 1rpx solid var(--border-color);
  min-height: 88rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.card button { min-height: 44px; padding: 18rpx 24rpx; border-radius: var(--radius-sm); color: var(--primary-color); background: var(--primary-bg); font-size: 14px; line-height: 1.6; margin: 16rpx 0 0; white-space: normal; }
.card picker .body { min-height: 88rpx; display: flex; align-items: center; background: var(--bg-gray); padding: 0 20rpx; border-radius: var(--radius-sm); }

/* 本页所有状态共用的可读与触控边界。 */
.card .title { line-height: 1.5; }
.card button[disabled] { color: var(--text-regular); background: var(--bg-gray); }
.record .body { margin-bottom: 0; }
