.container { background: #f5f6f7; min-height: 100vh; padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page-intro { padding-bottom: 24rpx; }
.page-intro-title { display: block; color: #172b4d; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.page-intro-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.6; margin-top: 10rpx; }
.company-card { padding: 24rpx; background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; }
.company-name-row { padding: 4rpx 0 24rpx; border-bottom: 1rpx solid #e3e8ef; }
.company-name { color: #172b4d; font-size: 34rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.info-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e3e8ef; box-sizing: border-box; }
.label { color: #526174; font-size: 28rpx; flex-shrink: 0; width: 164rpx; line-height: 1.6; }
.value { color: #172b4d; font-size: 30rpx; text-align: right; line-height: 1.6; min-width: 0; word-break: break-all; }
.input { flex: 1; min-width: 0; height: 88rpx; font-size: 30rpx; color: #172b4d; text-align: right; }
.update-note { display: block; color: #637083; font-size: 26rpx; line-height: 1.7; margin-top: 20rpx; }
.action-bar { margin-top: 28rpx; }
.edit-btn, .btn { padding: 20rpx; border-radius: 16rpx; font-size: 30rpx; line-height: 1.8; min-height: 96rpx; font-weight: 600; box-sizing: border-box; margin: 0; }
.edit-btn, .confirm { color: #fff; background: var(--primary-color); }
.btn-row { display: flex; gap: 20rpx; flex-wrap: wrap; }
.btn { flex: 1; min-width: 220rpx; }
.cancel { color: #155aaf; background: #edf3fb; }
.comparison-card { margin-top: 20rpx; }

/* 本页状态反馈：正文可读、操作至少 88rpx，蓝色只承担可执行动作。 */
.state-card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; padding: 28rpx; margin: 20rpx 0; }
.state-title { display: block; color: #172b4d; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.state-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; margin-top: 8rpx; }
.state-error { border-color: #e4b9b3; }
.state-success { border-color: #bddacb; }
.state-banner { background: #eaf2ff; color: #235393; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; margin: 20rpx 0; }
.state-actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 16rpx; }
.state-button { margin: 20rpx 0 0; padding: 16rpx 24rpx; min-height: 88rpx; background: var(--primary-color); color: #fff; border-radius: 14rpx; font-size: 28rpx; font-weight: 600; line-height: 1.8; box-sizing: border-box; }
.state-actions .state-button { margin-top: 0; }
.state-button.secondary { color: #155aaf; background: #edf3fb; }
button { font-family: inherit; }
button::after { border: 0; }
button[disabled] { color: #637083; background: #e8edf3; opacity: 1; }
