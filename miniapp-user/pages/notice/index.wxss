.container { background: #f5f6f7; min-height: 100vh; padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page-intro { padding-bottom: 24rpx; }
.page-intro-title { display: block; color: #172b4d; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.page-intro-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.6; margin-top: 10rpx; }
.notice-item { padding: 28rpx 24rpx; margin-bottom: 20rpx; border: 1rpx solid #dce3ed; border-radius: 20rpx; background: #fff; min-height: 144rpx; box-sizing: border-box; }
.notice-item:active { background: #edf3fb; }
.notice-item-top { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 24rpx; }
.notice-type { flex-shrink: 0; font-size: 24rpx; line-height: 1.6; border-radius: 8rpx; padding: 4rpx 10rpx; color: #155aaf; background: #edf3fb; }
.notice-title { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; color: #172b4d; line-height: 1.6; word-break: break-all; }
.notice-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; }
.notice-time { color: #637083; font-size: 26rpx; line-height: 1.6; word-break: break-all; }
.notice-link { color: #155aaf; font-size: 28rpx; line-height: 1.6; }

/* 本页状态反馈：正文可读、操作至少 88rpx，蓝色只承担可执行动作。 */
.state-card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; padding: 28rpx; margin: 20rpx 0; }
.state-title { display: block; color: #172b4d; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.state-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; margin-top: 8rpx; }
.state-error { border-color: #e4b9b3; }
.state-success { border-color: #bddacb; }
.state-banner { background: #eaf2ff; color: #235393; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; margin: 20rpx 0; }
.state-actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 16rpx; }
.state-button { margin: 20rpx 0 0; padding: 16rpx 24rpx; min-height: 44px; background: var(--primary-color); color: #fff; border-radius: 14rpx; font-size: 14px; font-weight: 600; line-height: 1.8; box-sizing: border-box; }
.state-actions .state-button { margin-top: 0; }
.state-button.secondary { color: #155aaf; background: #edf3fb; }
button { font-family: inherit; }
button::after { border: 0; }

.notice-list { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; overflow: hidden; }
.notice-item { margin: 0; border: 0; border-radius: 0; border-bottom: 1rpx solid #e3e8ef; min-height: 44px; }
.notice-item:last-child { border-bottom: 0; }

.notice-item.af-entry { display:block; }

/* Visual v2: page hierarchy and reading rhythm. */
.notice-list { margin:12px 16px; border-radius:14px; overflow:hidden; }
.notice-item { min-height:64px; box-sizing:border-box; }
.notice-title { min-width:0; overflow-wrap:anywhere; }
.notice-time { color:var(--af2-muted); }
