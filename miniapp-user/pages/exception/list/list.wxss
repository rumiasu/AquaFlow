.page-container { background: #f5f6f7; min-height: 100vh; padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.header { margin-bottom: 24rpx; }
.header-title { display: block; color: #172b4d; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.header-subtitle { display: block; color: #526174; font-size: 28rpx; line-height: 1.6; margin-top: 10rpx; }
.exception-card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; margin-bottom: 20rpx; overflow: hidden; }
.card-header { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 24rpx; border-bottom: 1rpx solid #e3e8ef; }
.order-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.order-id { font-size: 30rpx; font-weight: 600; color: #172b4d; word-break: break-all; line-height: 1.6; }
.time { font-size: 26rpx; color: #637083; line-height: 1.6; }
.status-badge { color: #526174; background: #f0f3f7; font-size: 26rpx; padding: 6rpx 16rpx; border-radius: 10rpx; line-height: 1.6; }
.status-badge.warning { color: var(--warning-color); background: var(--warning-bg); }
.status-badge.primary, .status-badge.info { color: #155aaf; background: #edf3fb; }
.status-badge.success { color: #226344; background: #edf8f1; }
.card-body { padding: 24rpx; }
.info-row { display: flex; align-items: flex-start; gap: 20rpx; margin-bottom: 16rpx; }
.label { flex-shrink: 0; width: 112rpx; font-size: 26rpx; line-height: 1.7; color: #637083; }
.value { color: #172b4d; font-size: 28rpx; line-height: 1.7; min-width: 0; word-break: break-all; }
.discrepancy-value { font-weight: 600; }
.compensation-row { margin-bottom: 0; }
.card-footer { border-top: 1rpx solid #e3e8ef; padding: 24rpx; }
.progress-info { display: flex; align-items: center; margin-bottom: 20rpx; }
.step { display: flex; flex-direction: column; align-items: center; flex: 1; }
.step-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #c8d2df; }
.step.active .step-dot { background: var(--primary-color); }
.step-text { font-size: 26rpx; color: #637083; line-height: 1.6; text-align: center; margin-top: 8rpx; }
.step.active .step-text { color: #155aaf; }
.step-line { flex: 1; height: 2rpx; background: #c8d2df; }
.step-line.active { background: var(--primary-color); }
.detail-link { display: block; color: #155aaf; font-size: 28rpx; text-align: right; min-height: 64rpx; line-height: 64rpx; }
.load-more { padding: 0 0 24rpx; text-align: center; }
.detail-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(15, 30, 50, .5); z-index: 100; display: flex; align-items: flex-end; }
.detail-panel { background: #fff; border-radius: 28rpx 28rpx 0 0; width: 100%; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.close-button { min-height: 44px; padding: 16rpx 20rpx; font-size: 14px; line-height: 1.8; color: #155aaf; background: #edf3fb; border-radius: 12rpx; margin: 0; }
.detail-scroll { height: 52vh; margin-top: 16rpx; }
.detail-content { padding: 8rpx 4rpx 24rpx; }
.detail-order { display: block; font-size: 32rpx; color: #172b4d; font-weight: 600; line-height: 1.6; word-break: break-all; margin-bottom: 16rpx; }
.detail-line { display: block; color: #172b4d; font-size: 28rpx; line-height: 1.8; word-break: break-all; }
.detail-important { background: #edf3fb; padding: 20rpx; border-radius: 14rpx; margin: 20rpx 0; }
.detail-label { display: block; color: #526174; font-size: 26rpx; margin: 24rpx 0 8rpx; }
.detail-note { display: block; color: #172b4d; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; }

/* 本页状态反馈：正文可读、操作至少 88rpx，蓝色只承担可执行动作。 */
.state-card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; padding: 28rpx; margin: 20rpx 0; }
.state-title { display: block; color: #172b4d; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.state-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; margin-top: 8rpx; }
.state-error { border-color: #e4b9b3; }
.state-success { border-color: #bddacb; }
.state-banner { background: #eaf2ff; color: #235393; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; margin: 20rpx 0; }
.state-actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 16rpx; }
.state-button { margin: 20rpx 0 0; padding: 16rpx 24rpx; min-height: 44px; background: var(--primary-color); color: #fff; border-radius: 14rpx; font-size: 14px; font-weight: 600; line-height: 1.8; box-sizing: border-box; }
.state-actions .state-button { margin-top: 0; }
.state-button.secondary { color: #155aaf; background: #edf3fb; }
button { font-family: inherit; }
button::after { border: 0; }
button[disabled] { color: #637083; background: #e8edf3; opacity: 1; }
