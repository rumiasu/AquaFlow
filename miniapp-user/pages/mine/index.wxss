.page-container {
  padding: 24rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: var(--accent-gradient);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-primary);
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.phone {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.6);
}

/* 统计卡片 */
.stats-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.stats-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}

/* 水桶卡片 */
.barrel-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--accent-color);
}

.barrel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.barrel-info {
  display: flex;
  justify-content: space-around;
}

.barrel-item {
  text-align: center;
}

.barrel-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-color);
  display: block;
}

.barrel-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: background-color 0.15s;
}

.menu-item:active {
  background-color: var(--bg-gray);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 退出按钮 */
.btn-logout {
  background: #fff;
  color: var(--error-color);
  border: 1rpx solid rgba(220, 38, 38, 0.3);
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  margin-top: 20rpx;
  font-weight: 500;
}

.btn-logout:active {
  background: rgba(220, 38, 38, 0.04);
}
