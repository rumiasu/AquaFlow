.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ══ 关键事实卡（2026-10-07 #19 R4，正本 docs/design/36 §2）══
   原整版蓝头（var(--header-gradient) + 白字）降级为暖纸白卡：
   对象、单号、状态章、金额一屏读完，与全端「列表页=详情页=暖纸白卡」同规（R1）。 */
.fact-card {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
}

.fact-top {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  align-items: baseline;
  margin-bottom: var(--spacing-sm);
}

.fact-name {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
}

.fact-no {
  overflow-wrap: anywhere;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.fact-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.fact-amount-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 16rpx;
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--border-light);
}

.fact-amount {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
}

/* 收款口径章：需收=警示（要行动），已付=成功，其余=中性灰。
   判据一律后端投影（needCollect / payState），class 在 js 里算好（R2：状态色两端同义）。 */
.fact-pay {
  font-size: var(--font-sm);
  padding: 2rpx 16rpx;
  border-radius: var(--radius-round);
  background: var(--bg-gray);
  color: var(--text-regular);
}

.fact-pay-need {
  background: var(--warning-bg);
  color: var(--warning-color);
  font-weight: 600;
}

.fact-pay-paid {
  background: var(--success-bg);
  color: var(--success-color);
}

/* 状态章（R2）： tint 底 + 实色文字，不再用蓝头上的半透明白块。
   状态与配色的对应关系没变，只换呈现（pending=警示 / 配送中·已送达=品牌 / 完成=成功 / 取消=中性）。 */
.status-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-sm);
  font-weight: 600;
  background: var(--bg-gray);
  color: var(--text-regular);
}

.status-delivering {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.status-pending {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.status-delivered {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.status-cancelled {
  background: var(--bg-gray);
  color: var(--text-secondary);
}

.status-completed {
  background: var(--success-bg);
  color: var(--success-color);
}

.status-warning {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.aux-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--bg-gray);
  color: var(--text-regular);
}

.aux-tag.aux-offline {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.aux-tag.aux-transfer {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.aux-tag.aux-return {
  background: var(--error-bg);
  color: var(--error-color);
}

.aux-tag.aux-target {
  background: var(--primary-bg);
  color: var(--primary-color);
}

/* 联系信息卡片 */
.info-card {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-light);
}

.info-row:last-child {
  border-bottom: none;
}


.info-text {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.info-text.address {
  line-height: 1.5;
}

.info-action {
  font-size: var(--font-sm);
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: var(--radius-round);
}

/* 通用区块 */
.section {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
  display: block;
}

/* 区块标题下的一句说明（[2026-09-26] 送达凭证那一块要说明"几张、谁拍的"）。
   与 pages/order/complete.wxss 的同名类保持同一规格 —— 同一端里两页不一致会显得像没做完。 */
.section-tip {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-md);
}

/* 订单内容 */
.order-content {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.content-name {
  font-size: var(--font-lg);
  color: var(--text-primary);
  margin-right: var(--spacing-sm);
}

.content-spec {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-right: var(--spacing-sm);
}

.content-qty {
  font-size: var(--font-lg);
  color: var(--text-primary);
  font-weight: 600;
}

/* 历史订单 */
.history-row {
  display: flex;
  align-items: center;
}

.history-item {
  flex: 1;
  text-align: center;
}

.history-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.history-value {
  font-size: var(--font-xl);
  color: var(--primary-color);
  font-weight: 700;
  display: block;
}

.history-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-light);
}

/* 客户备注 */
.notes-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.note-item {
  display: flex;
  align-items: flex-start;
}

.note-icon {
  color: var(--warning-color);
  font-size: var(--font-md);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.note-text {
  font-size: var(--font-md);
  color: var(--text-regular);
  line-height: 1.5;
}

/* 信息行 */
.info-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.info-value {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 600;
}

/* 操作按钮栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--bg-card);
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  gap: var(--spacing-sm);
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) 0;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: 600;
  line-height: 1.4;
}

.action-btn::after {
  border: none;
}


.action-nav, .action-collect {
  background: rgba(46, 74, 104, 0.1);
  color: var(--primary-color);
}

.action-complete {
  background: var(--primary-color);
  color: #fff;
}

/* 更多操作（2026-10-07 #11）：与导航同级的次按钮，点开半屏弹层 */
.action-more {
  background: var(--bg-card);
  color: var(--text-regular);
  border: 1rpx solid var(--border-color);
}

.action-bar-confirm {
  gap: var(--spacing-md);
}

.action-bar-confirm .action-btn {
  padding: var(--spacing-lg) 0;
  font-size: var(--font-md);
  border-radius: var(--radius-round);
}

.action-accept {
  background: var(--primary-color);
  color: #ffffff;
}

.action-reject {
  background: #ffffff;
  color: var(--error-color);
  /* R3：危险动作 = 错误色描边/文字，不做实心红块（原 2rpx var(--error-bg) 浅得看不见） */
  border: 2rpx solid var(--error-color) !important;
}

/* ══ 更多操作半屏弹层（2026-10-07 #11，正本 docs/design/36 §3）══
   形态与首页「配送遇到问题」弹层同款（overlay + 底部 sheet + 条目列表），
   条目 = 名称 + 一句说明 + 箭头；拒付是唯一错误色条目（两步确认仍在原处理器里）。 */
.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 201;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: var(--spacing-lg) var(--spacing-lg) calc(var(--spacing-lg) + env(safe-area-inset-bottom));
}

.sheet-actions {
  max-height: 60vh;
}

.sheet-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.sheet-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-sm);
  border-bottom: 1rpx solid var(--border-light);
}

.sheet-item:last-of-type {
  border-bottom: none;
}

.sheet-item-info {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet-item-name {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
}

.sheet-item-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.sheet-item-arrow {
  font-size: var(--font-xl);
  color: var(--text-placeholder);
  margin-left: var(--spacing-sm);
}

/* 客户拒付（v60）：弹层里唯一的错误色条目 —— 它用于「已送达待收款」时登记拒付风险，
   不是危险按钮（真正动账在第 2 步确认弹窗），但视觉上必须与普通善后动作分开。 */
.sheet-item-danger .sheet-item-name {
  color: var(--error-color);
}

.sheet-item-danger .sheet-item-desc {
  color: var(--error-color);
  opacity: 0.75;
}

.sheet-cancel {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: var(--radius-md);
}

/* ========== 楼层上报与楼梯凭证（v43；凭证 [2026-09-26] 由「楼层凭证」改名） ========== */
.floor-warn {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: var(--warning-color);
  background: var(--warning-bg);
  border-radius: 999rpx;
}

.floor-proof-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.floor-proof-title {
  font-size: 26rpx;
  color: var(--text-regular);
}

.floor-proof-add {
  font-size: 24rpx;
  color: var(--primary-color);
}

.floor-proof-photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.floor-proof-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin: 0 12rpx 12rpx 0;
}

.floor-proof-tip {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* ========== 支付流水与手工退款（2026-09-18） ========== */
.pay-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.pay-row:last-child {
  border-bottom: none;
}

.pay-main {
  flex: 1;
  min-width: 0;
}

.pay-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.pay-method {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.pay-status {
  font-size: 22rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-right: 12rpx;
}

.pay-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 负金额 = 退款冲正流水，标红一眼可辨 */
.pay-amount-refund {
  color: var(--error-color);
}

.pay-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.pay-note {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.4;
}

.pay-refund {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  color: var(--error-color);
  border: 1rpx solid var(--error-bg);
  border-radius: 999rpx;
}
