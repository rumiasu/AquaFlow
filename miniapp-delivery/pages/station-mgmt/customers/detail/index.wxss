.page { background: var(--bg-color); min-height: 100vh; padding: 24rpx 24rpx 40rpx; }

/* ===== 头部画像卡 ===== */
.profile-header {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.header-info { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 36rpx; font-weight: 700; color: var(--text-primary); }
.phone { font-size: 26rpx; color: var(--text-secondary); }
.badge-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 4rpx; }
.badge { font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 20rpx; color: #fff; }
.badge.type { background: var(--primary-bg); color: var(--primary-color); }
.badge.level { color: #fff; }
.badge.act-ACTIVE { background: var(--success-bg); color: var(--success-color); }
.badge.act-SILENT { background: var(--warning-bg); color: var(--warning-color); }
.badge.act-LOST { background: var(--error-bg); color: var(--error-color); }
.badge.act-NONE { background: var(--bg-gray); color: var(--text-secondary); }
.badge.cod-on { background: var(--success-bg); color: var(--success-color); }
.badge.cod-off { background: var(--bg-gray); color: var(--text-secondary); }

/* ===== 区块 ===== */
.section {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

/* ===== 指标宫格 ===== */
.metric-grid { display: flex; }
.metric-grid.second { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border-color); }
.metric { flex: 1; display: flex; flex-direction: column; align-items: center; }
/* 2026-10-22：普通读数曾与蓝色操作混在一起；仅收敛默认数字颜色，欠桶与配送中仍用各自语义色。 */
.metric-value { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.metric-value.small { font-size: 26rpx; }
.metric-value.warn { color: var(--error-color); }
.metric-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

/* ===== 明细行 ===== */
.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-top: 1rpx solid var(--border-color);
  gap: 20rpx;
}
.row:first-of-type { border-top: none; }
.label { color: var(--text-secondary); flex-shrink: 0; }
.value { color: var(--text-primary); text-align: right; }
.value.warn { color: var(--error-color); }
.tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10rpx; }
.tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-bg);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* ===== 本站资产 ===== */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title.no-mb { margin-bottom: 0; }
.section-note { font-size: 24rpx; color: var(--text-secondary); }

.asset-grid { margin-top: 4rpx; }
.metric-value.transit { color: var(--warning-color); }

.sub-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 28rpx 0 8rpx;
}
.sub-title.no-mb { margin-bottom: 0; }

/* 标题行 + 右侧「还空桶」入口 */
.sub-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}
.link-btn {
  font-size: 14px;
  color: var(--primary-color);
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: 999rpx;
}
/* 「还空桶」+「资产调整」两个文字链并排（原本只有一个链接，直接放在 .sub-title-row 里） */
.link-row { display: flex; align-items: center; gap: 12rpx; }

/* over 文案：欠桶(红) / 水站暂存(灰蓝)。over<0 是合法状态，颜色只做区分不做警告 */
.asset-item-sub.over-owed { color: var(--error-color); }
.asset-item-sub.over-storage { color: var(--primary-color); }

.asset-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border-color);
}
.asset-item:first-of-type { border-top: none; }
.asset-item-main { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.asset-item-name { font-size: 26rpx; color: var(--text-primary); }
.asset-item-spec { font-size: 24rpx; color: var(--text-secondary); }
.asset-item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.asset-item-qty { font-size: 26rpx; font-weight: 600; color: var(--primary-color); }
.asset-item-sub { font-size: 24rpx; color: var(--text-secondary); }

.record-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border-color);
}
.record-left { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.record-line1 { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.record-cat {
  font-size: 24rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  color: #fff;
  flex-shrink: 0;
}
.record-cat.cat-barrel { background: var(--primary-color); }
.record-cat.cat-ticket { background: var(--warning-color); }
.record-cat.cat-deposit { background: var(--success-color); }
.record-type { font-size: 25rpx; color: var(--text-primary); }
.record-meta { font-size: 21rpx; color: var(--text-secondary); line-height: 1.5; }
.record-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.record-change { font-size: 26rpx; font-weight: 600; }
.record-change.in { color: var(--success-color); }
.record-change.out { color: var(--error-color); }
.record-change.flat { color: var(--text-secondary); }
.record-status { font-size: 21rpx; color: var(--text-secondary); }

.record-toggle {
  text-align: center;
  padding: 20rpx 0 4rpx;
  font-size: 24rpx;
  color: var(--primary-color);
}

.asset-loading { font-size: 24rpx; color: var(--text-secondary); padding: 16rpx 0; }
.asset-empty {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 24rpx 0 8rpx;
  line-height: 1.6;
}
.asset-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: var(--error-bg);
  border: 1rpx solid var(--error-bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.asset-error-text { font-size: 24rpx; color: var(--error-color); flex: 1; }

/* ---- 客户特权（v40） ---- */

.empty-line {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  padding: 8rpx 0;
}

.priv-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}

.priv-main {
  flex: 1;
  overflow: hidden;
}

.priv-name {
  display: block;
  font-size: 27rpx;
  color: var(--text-primary);
}

.priv-note {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.priv-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  border-radius:12rpx;
  font-size: 14px;
  margin-left: 12rpx;
  white-space: nowrap;
}

.priv-btn-off {
  border-color: var(--error-bg);
  color: var(--error-color);
}

.priv-add-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 18rpx 0 6rpx;
}

.priv-add-row {
  display: flex;
  flex-wrap: wrap;
}

.priv-add-row .priv-btn {
  margin: 0 16rpx 12rpx 0;
}

.priv-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 34rpx;
  margin-top: 10rpx;
}
.asset-retry {
  font-size: 24rpx;
  color: #fff;
  background: var(--error-color);
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
  flex-shrink: 0;
}

/* ===== 权限开关 ===== */
.switch-row { align-items: center; }
.switch-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.hint { font-size: 24rpx; color: var(--text-secondary); }

/* ===== 最近订单 ===== */
.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-top: 1rpx solid var(--border-color);
}
.order-item:first-of-type { border-top: none; }
.order-no { color: var(--text-secondary); width: 120rpx; }
.order-status { flex: 1; color: var(--text-primary); text-align: center; }
.order-amount { color: var(--primary-color); font-weight: 600; }

.loading, .empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-md, 28rpx);
  padding-top: 120rpx;
}

.error-banner {
  background: var(--error-bg);
  border: 1rpx solid var(--error-color);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.error-text { font-size: 28rpx; font-weight: 600; color: var(--error-color); }
.error-hint { font-size: 24rpx; color: var(--text-secondary); line-height: 1.5; }

/* ============ 纯还桶弹窗 ============ */
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 900;
}
.modal {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 901;
  background: var(--bg-card, #fff);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 80vh; overflow-y: auto;
}
.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.modal-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.modal-close { font-size: 40rpx; color: var(--text-secondary); padding: 0 8rpx; }
.modal-tip {
  font-size: 23rpx; color: var(--text-secondary);
  background: var(--bg-gray); border-radius: 12rpx;
  padding: 16rpx 20rpx; margin-bottom: 8rpx; line-height: 1.6;
}
.modal-tip .strong { color: var(--text-primary); font-weight: 600; }
.return-item {
  /* 2026-10-28 RC3：全宽步进器独占下一行，窄屏不再挤压商品说明。 */
  display: flex; flex-direction: column; align-items: stretch; gap: 12rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border-color);
}
.return-item-main { display: flex; flex-direction: column; gap: 6rpx; flex: none; width: 100%; min-width: 0; }
.return-item-name { font-size: 26rpx; color: var(--text-primary); overflow-wrap: anywhere; word-break: break-all; }
.return-item-hint { font-size: 24rpx; color: var(--text-secondary); }
.return-item-input {
  width: 140rpx; height: 64rpx; text-align: center;
  background: var(--bg-gray); border-radius: 10rpx;
  font-size: 28rpx; color: var(--text-primary);
}
.modal-footer { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-btn {
  flex: 1; height: auto; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; min-height:44px; display:flex; align-items:center; justify-content:center; }
.modal-btn.cancel { background: var(--bg-gray); color: var(--text-secondary); }
.modal-btn.confirm { background: var(--primary-color); color: #fff; }
.modal-btn.confirm.disabled { opacity: 0.6; }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.page { box-sizing:border-box; }
.profile-header,.section { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); padding:24rpx; }
.avatar { width:80rpx; height:80rpx; border-radius:12rpx; font-size:34rpx; }
.name-row,.section-title-row,.sub-title-row { flex-wrap:wrap; gap:12rpx; }
.name { font-size:36rpx; overflow-wrap:break-word; }
.phone { display:flex; align-items:center; min-height:44px; font-size:30rpx; color:var(--primary-color); }
.section-title { border-left:0; padding-left:0; line-height:1.5; font-size:30rpx; }
.link-btn,.priv-btn,.asset-retry,.record-toggle { min-height: 44px; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; padding:16rpx; font-size: 14px; border-radius:8rpx; }
.link-row .link-btn { display:flex; width:100%; background:var(--primary-color); color:#fff; font-weight:600; }
.metric-grid,.asset-grid { display:flex; flex-wrap:wrap; }
.metric { flex:none; width:50%; min-width:0; box-sizing:border-box; padding:20rpx 8rpx; align-items:flex-start; border-radius:0; background:#fff; border-bottom:1rpx solid var(--border-color); }
.metric-value,.metric-value.small { font-size:34rpx; overflow-wrap:anywhere; max-width:100%; }
.metric-label,.section-note,.asset-item-sub,.hint,.record-meta { font-size:26rpx; color:var(--text-regular); line-height:1.6; }
.asset-item,.record-item,.order-item { flex-wrap:wrap; gap:12rpx; }
.asset-item-main,.record-left { min-width:0; }
.asset-item-name,.record-type { font-size:28rpx; overflow-wrap:break-word; }
.modal { max-height:85vh; overflow-y:auto; border-radius:16rpx; }
.modal-close { min-width:88rpx; min-height:88rpx; display:flex; justify-content:center; align-items:center; }
.modal-btn { min-height: 44px; font-size: 14px; }
.return-item-input { min-width:96rpx; min-height:88rpx; font-size:30rpx; }
.modal-tip,.error-hint { font-size:28rpx; line-height:1.6; color:var(--text-regular); }

/* 资产明细的两个次动作独占一行，窄屏不把“资产调整”拆成单字。 */
.sub-title-row .link-row { width: 100%; display: flex; flex-wrap: wrap; gap: 12rpx; }
.sub-title-row .link-row .link-btn { flex: 1; width: auto; min-width: 180rpx; white-space: nowrap; color: var(--primary-color); background: #fff; border: 1rpx solid var(--primary-color); }
.consumption-toggle, .order-item { min-height: 44px; box-sizing: border-box; }
.modal-close { min-width: 44px; min-height: 44px; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Page-specific role grouping. */

.sub-title-row .link-row { width:100%; display:flex; flex-wrap:wrap; gap:8px 20px; }
.sub-title-row .link-row .af-entry { flex:none; min-width:110px; }
.link-row .b3-on-place-order { width:100%; }
.modal-footer { gap:8px; }

/* Asset types keep consistent blue, teal and money surfaces. */
.asset-grid .s-asset-physical { background:var(--af2-surface-physical); }
.asset-grid .s-asset-order { background:var(--af2-surface-order); }
.metric-grid.second .s-asset-money { background:var(--af2-surface-money); }
.s-asset-physical .metric-value,.s-asset-physical .metric-label { color:var(--af2-ink-physical); }
.s-asset-order .metric-value,.s-asset-order .metric-label { color:var(--af2-ink-order); }
.s-asset-money .metric-value,.s-asset-money .metric-label { color:var(--af2-ink-money); }
.asset-grid .metric,.metric-grid.second .s-asset-money { border-radius:14px; padding:12px; box-sizing:border-box; }
.return-item { display:flex; flex-direction:column; align-items:stretch; gap:8px; }



/* Recent-order identifiers and amounts may be long; keep the row actionable. */
.order-item .order-no { flex:0 1 100px; width:auto; min-width:0; overflow-wrap:anywhere; }
.order-item .order-status { min-width:0; }
.order-item .order-amount { min-width:0; max-width:100%; overflow-wrap:anywhere; }
.order-item > text:last-child { margin-left:auto; flex:none; }
