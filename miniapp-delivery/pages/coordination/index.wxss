/* 自绘导航栏 + 状态胶囊（.navbar* / .status-chip*）：与「配送」页共用一份样式 */
@import "../../styles/station-navbar.wxss";

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 40rpx;
}

.no-auth {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 60rpx;
  text-align: center;
}


.no-auth-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.no-auth-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 60rpx;
}

.no-auth-btn {
  width: 100%;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #ffffff;
  border-radius:12rpx;
  font-size: 14px;
  border: none;
  max-width: 480rpx; min-height:44px; display:flex; align-items:center; justify-content:center; }

/* ========== 常驻「水站管理」入口（首页，紧跟自绘导航栏） ==========
   [2026-09-26 Wave1 轨道 G] 它是本页**唯一不受服务端事项影响**的入口（零待办、部分加载失败
   都照旧在），所以不吃 `.todo-card` 的显隐、也不放在那张卡里 —— 见 index.wxml 里那段注释。
   一条干净的行：图标 + 名称 + 箭头；**不附功能清单**（§6：同级入口不用每个附一串功能清单）。
   左右 20rpx 与它下面那张 `.todo-card` 对齐（两张卡是相邻的一对，别一个 20 一个 24）。 */
.mgmt-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  box-shadow: none;
  min-height: 96rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
}

.mgmt-entry:active {
  opacity: 0.7;
}


.mgmt-entry-title {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.mgmt-entry-arrow {
  font-size: var(--font-lg);
  color: var(--text-secondary);
}

.tab-bar {
  display: flex;
  background: #ffffff;
  margin: 20rpx 24rpx 0;
  border-radius: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 0;
  box-sizing: border-box;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.tab-item {
  flex-shrink: 0;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-regular);
  border-radius: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.15s ease;
  min-height: 96rpx;
  box-sizing: border-box;
}

.tab-item.active {
  color: #ffffff;
  font-weight: 600;
  background: var(--primary-color);
}

.tab-count {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.08);
  text-align: center;
}

.tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.list {
  padding: 20rpx 24rpx 0;
}

.order-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.order-card-exception {
  border: 2rpx solid var(--error-color);
  background: var(--error-bg);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-pending { background: var(--af-soft); color: var(--af-text-secondary); }
.status-delivering { background: var(--primary-bg); color: var(--primary-color); }
.status-transfer { background: var(--primary-bg); color: var(--af-text-secondary); }
.status-return { background: var(--error-bg); color: var(--error-color); }
.status-completed { background: var(--success-bg); color: var(--success-color); }
.status-exception { background: var(--error-bg); color: var(--error-color); }
.status-approval { background: var(--error-bg); color: var(--error-color); }

/* ========== 客户信用标（待分配卡片，2026-09-22） ==========
   文案与判据全在后端（CustomerRiskService），这里只有**颜色**。
   两档就够（站长是力工，多一档就多一次误判）：
     黄 risk-warn   = 关注：有挂账，都在账期内 —— **这是正常经营**，别做成告警的样子；
     红 risk-danger = 预警 / 冻结：已逾期或超额度，才需要立刻处理。
   `.order-card.risk-*` 给整张卡加一条左侧色边，扫一眼列表就知道哪几单要留意。
   `.risk-plain` 是"后端给了个我没见过的等级"的兜底（中性灰）—— 认不出来就别乱标红。 */
.risk-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.risk-tag.risk-warn { background: var(--af-soft); color: var(--af-text-secondary); border: 2rpx solid var(--af-soft); }
.risk-tag.risk-danger { background: var(--error-bg); color: var(--error-color); border: 2rpx solid var(--error-bg); }
.risk-tag.risk-plain { background: var(--bg-gray); color: var(--text-regular); border: 2rpx solid var(--border-color); }

.order-card.risk-warn { border-left: 8rpx solid var(--af-text-secondary); }
.order-card.risk-danger { border-left: 8rpx solid var(--error-color); }

.risk-note {
  font-size: 24rpx;
  line-height: 1.5;
  margin: -8rpx 0 18rpx;
}

.risk-note.risk-warn { color: var(--af-text-secondary); }
.risk-note.risk-danger { color: var(--error-color); }
.risk-note.risk-plain { color: var(--text-secondary); }

/* 「审批」页签内的子页签（客户 / 站内） */
.sub-tab-bar {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0 16rpx;
}

.sub-tab-item {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  background: #ffffff;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.sub-tab-item.active {
  color: #ffffff;
  font-weight: 600;
  background: var(--primary-color);
}

.sub-tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.order-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: auto;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-row {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-label {
  flex-shrink: 0;
  color: var(--text-secondary);
  width: 100rpx;
}

.info-value {
  flex: 1;
  line-height: 1.5;
  min-width: 0;
  overflow-wrap: anywhere;
}

.info-phone {
  color: var(--primary-color);
  margin-left: 8rpx;
}

.info-address .info-value {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.transfer-info, .return-info {
  padding: 16rpx 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.transfer-row, .return-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.from-label, .return-label {
  color: var(--text-secondary);
}

.from-value, .return-value {
  color: var(--text-primary);
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.exception-info {
  padding: 16rpx 20rpx;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.exception-reason {
  font-size: 26rpx;
  color: var(--error-color);
  line-height: 1.5;
}

.card-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-outline,
.btn-primary,
.btn-danger {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 16px;
  font-weight: 500;
  padding: 0;
  border: none;
}

.btn-outline-small,
.btn-primary-small,
.btn-danger-small {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 14px;
  font-weight: 500;
  padding: 0;
  border: none;
}

.btn-outline, .btn-outline-small {
  background: #ffffff;
  color: var(--text-regular);
  border: 2rpx solid var(--border-color);
}

.btn-primary, .btn-primary-small {
  background: var(--primary-color);
  color: #ffffff;
}

.btn-danger {
  background: var(--error-color);
  color: #ffffff;
}

.btn-danger-small {
  background: var(--error-bg);
  color: var(--error-color);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 「看全部订单 ›」：列表底部的轻量跳转，不是主操作，所以做成居中文字链而不是按钮 */
.list-foot-link {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--primary-color);
}
.list-foot-link:active { opacity: 0.6; }

/* [2026-09-27 走查 M04 修] 「待分配」队列标题行 + 常驻「查全部订单 ›」。
   两件事必须同时看得见：标题说明这一列是什么（动作视角），链接把人送到状态台账；
   原来只有沉在列表末尾的那一条，20 条待分配时得滚到底才找得到。 */
.queue-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}
.queue-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.queue-link {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 8rpx 0 8rpx 24rpx;
}
.queue-link:active { opacity: 0.6; }

.modal-overlay {
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

/* 遮罩与内容是兄弟，背景拦截 touchmove 不影响内容中的原生 scroll-view。 */
.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.modal-content {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
  max-height: 85%;
  display: flex;
  flex-direction: column;
}

.modal-title {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--text-primary);
}

.modal-list {
  height: 50vh;
  max-height: 640rpx;
  min-height: 0;
  flex-shrink: 1;
}

.modal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--bg-gray);
  min-height: 112rpx;
  box-sizing: border-box;
}

.modal-item:active {
  background: var(--bg-color);
}

.modal-item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.modal-item-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.modal-item-phone {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.modal-item-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
}

.modal-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.modal-cancel {
  flex-shrink: 0;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border: none;
  width: 100%;
}

/* ========== 抢单池样式 ========== */
.pool-card {
  border-left: 6rpx solid var(--primary-color);
}

/* ========== 「一眼看到钱」金额块（抢单池 / 指定外派里别站指定本店的那些行共用） ========== */
/* 放在卡片最上面（标题行之下、商品行之前）：抢单决策的第一信息是钱，不是商品名 */
.fee-box {
  padding: 14rpx 16rpx;
  background: var(--bg-gray);
  border: 2rpx solid var(--af-soft);
  border-radius: 10rpx;
  margin-bottom: 12rpx; border-left:4rpx solid var(--af-text-secondary); }

.fee-row-main {
  display: flex;
  align-items: baseline;
}

.fee-label {
  font-size: 24rpx;
  color: var(--af-text-secondary);
  flex-shrink: 0;
}

.fee-amount {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--af-text-secondary);
  margin-left: 12rpx;
}

.fee-detail {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
}

.fee-detail-item {
  font-size: 26rpx;
  color: var(--af-text-secondary);
  margin-right: 20rpx;
}

.fee-source {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.fee-source-label {
  font-size: 24rpx;
  color: var(--af-text-secondary);
  flex-shrink: 0;
}

.fee-source-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-left: 8rpx;
}

/* 结算去向：整句由后端下发（settleNote），前端只负责显示 */
.fee-settle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--success-color);
  line-height: 1.5;
}

/* 押金/桶权益风险提示（文案由后端下发 crossStationRiskNote，前端原样展示、不改写） */
.risk-box {
  display: flex;
  flex-direction: column;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  background: var(--bg-gray);
  border: 1rpx solid var(--af-soft);
  border-radius: 10rpx; border-left: 4rpx solid var(--af-text-secondary); }

.risk-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--af-text-secondary);
  margin-bottom: 6rpx;
}

.risk-text {
  font-size: 24rpx;
  color: var(--af-text-secondary);
  line-height: 1.5;
}

.pool-product-info {
  padding: 12rpx 16rpx;
  background: var(--bg-color);
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.pool-product-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.pool-product-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.pool-match-info {
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.match-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.match-name {
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* 商品匹配标签 */
.match-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.match-full {
  background: var(--success-bg);
  color: var(--success-color);
}

.match-partial {
  background: var(--af-soft);
  color: var(--af-text-secondary);
}

.match-none {
  background: var(--error-bg);
  color: var(--error-color);
}

/* 抢单池状态标签 */
.status-pool {
  background: var(--primary-bg);
  color: var(--primary-color);
}

/* ========== 外派样式（「外派」页签：一键外派 / 指定外派两个子页签共用） ========== */
.dispatch-card {
  border-left: 6rpx solid var(--af-text-secondary);
}

.status-dispatch {
  background: var(--af-soft);
  color: var(--af-text-secondary);
}

/* 订单状态小标（等待接单 / 已接单 …）：文案是后端下发的 Orders.statusText。
   ⚠️ 原来的 .dispatch-accepted / .dispatch-rejected / .dispatch-completed 已删
   （[2026-09-26]）：它们配的是 `item.dispatchStatus`，而后端**从来没下发过这个字段**
   （CrossStationDispatchController 的 dispatch-tracking 只填 dispatchKind / deliveryStationName），
   那四个分支恒不渲染 —— 是死代码。要按状态配色就用后端 statusText + 这个通用小标。 */
.dispatch-status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  background: var(--af-soft);
  color: var(--af-text-secondary);
}

.dispatch-info {
  padding: 12rpx 16rpx;
  background: var(--bg-color);
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.dispatch-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.dispatch-label {
  color: var(--text-secondary);
}

.dispatch-value {
  color: var(--text-primary);
  font-weight: 500;
}

/* 外派久未接单的提示块（2026-09-27 产品裁定 docs/design/31 §8.3）。
   与上面 .dispatch-info 同一形状，只是底色偏暖表示"要你决定"，与"信息展示"区分开。 */
.dispatch-stale {
  padding: 12rpx 16rpx;
  background: var(--bg-gray);
  border-radius: 10rpx;
  margin-bottom: 12rpx; border-left: 4rpx solid var(--primary-color); color: var(--text-regular); }

.dispatch-stale-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--af-text-secondary);
  margin-bottom: 12rpx;
}

/* ========== 退回待确认样式 ========== */
.return-card {
  border-left: 6rpx solid var(--af-text-secondary);
}

.status-return {
  background: var(--af-soft);
  color: var(--af-text-secondary);
}

/* ========== 指定外派里"别站指定本店"那几行（蓝色左边条，与本站派出去的橙色区分） ========== */
.incoming-card {
  border-left: 6rpx solid var(--primary-color);
}

.status-incoming {
  background: var(--primary-bg);
  color: var(--primary-color);
}

/* ========== tag-row ========== */
.tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  flex: 1;
}

/* ========== 其他待处理（首页顶部，只列不在本页 tab 里的项） ==========
   [2026-09-19 收敛] 原先是 15 项分三级带分组标题的大卡，现在只留 8 项、**不分级标题**。
   `.todo-item-on` 标的是"**这个计数非零**"（wxml 绑的是 `hasCount`），**不是等级** ——
   卡里 8 项全是 P1/P2，一项 P0 都没有；P0 只体现在「首页」tab 红点上（走 `p0Total`）。
   ⚠️ 别再加回 `.todo-group` / `.todo-group-title` / `.todo-item-p0` 那几条 ——
      它们是给"三级分组"用的，那套结构已经去掉（要恢复三级显示时再从 git 历史取）。
   [2026-09-26 文案] 标题改成「其他待处理」，原副标题（`不在订单页里的`）按 §7 去掉，
   那条 `.todo-hint` 规则一并删掉（留着就是死样式）。**显隐条件与 8 项口径都没动**。
*/
.todo-card {
  margin: 16rpx 20rpx 4rpx;
  padding: 22rpx 20rpx 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.todo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.todo-row {
  display: flex;
  flex-wrap: wrap;
}

.todo-item {
  width: 25%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.todo-count {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* 非零 = 有东西要办，转红（0 保持灰：显示但不着色，站长一眼能分出今天有没有事） */
.todo-item-on .todo-count {
  color: var(--error-color);
}

.todo-label {
  font-size: 30rpx;
  color: var(--text-regular);
  margin-top: 6rpx;
  text-align: center;
  white-space: normal;
  overflow-wrap: break-word;
}

/* 金额只有"逾期应收"那一项有（服务端只给有金额含义的项下发 amount） */
.todo-amount {
  font-size: 34rpx;
  color: var(--error-color);
  margin-top: 4rpx;
  white-space: normal;
  overflow-wrap: break-word;
}


.guide-entry { padding: 20rpx 32rpx; text-align: right; color: var(--primary-color); font-size: 26rpx; }
.guide-step { padding: 20rpx 8rpx; line-height: 1.6; font-size: 28rpx; }
.section-caption { padding: 20rpx 4rpx; color: var(--text-regular); font-size: 26rpx; }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.card-actions button:not(.af-action):not(.af-choice), .no-auth-btn, .modal-cancel, .todo-card button:not(.af-action):not(.af-choice) { height: auto; min-height: 44px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.card-actions button:not(.af-action):not(.af-choice) { flex: 1 1 240rpx; }
.todo-item { min-height: 112rpx; box-sizing: border-box; }
/* 2026-10-22：单项仍占四分之一列曾留下大片空白；改成一行，计数和金额口径不动。 */
.todo-row-single .todo-item { width: 100%; min-height: 88rpx; flex-direction: row; gap: 16rpx; flex-wrap: wrap; }
.todo-row-single .todo-count { min-width: 48rpx; }
.todo-row-single .todo-label { flex: 1; margin-top: 0; text-align: left; }
.todo-row-single .todo-amount { margin-top: 0; margin-left: auto; }
.guide-entry { min-height: 96rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-end; margin: 0 24rpx; padding: 12rpx 8rpx; }
.sub-tab-item { min-height: 88rpx; box-sizing: border-box; border-radius: 10rpx; }
.risk-box, .risk-note, .exception-reason, .dispatch-stale-text { font-size: 28rpx; line-height: 1.6; overflow-wrap: anywhere; }
.info-phone { flex-basis: 100%; margin-left: 116rpx; font-size: 28rpx; }
.fee-row-main, .fee-source, .queue-head { flex-wrap: wrap; gap: 12rpx; }
.modal-item-info { min-width: 0; overflow-wrap: anywhere; }
.dispatch-stale button:not(.af-action):not(.af-choice) { min-height: 44px; height: auto; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; border-radius: 12rpx; }

/* 常亮提示点；不使用呼吸或闪烁，已营业后只保留紧凑查看入口。 */
.setup-launch-entry { display:flex; align-items:center; gap:12rpx; margin-bottom:20rpx; padding:20rpx; border:1rpx solid var(--af-border); border-radius:12rpx; background:var(--af-soft); color:var(--text-primary); font-size:14px; line-height:1.5; }
.setup-launch-dot { width:8px; height:8px; flex-shrink:0; border-radius:50%; background:var(--af-primary); }
.setup-launch-main { flex:1; min-width:0; }
.setup-launch-main text { display:block; }
.setup-launch-state { margin-top:4rpx; font-size:13px; color:var(--text-regular); }
.setup-launch-quiet { min-height:36px; display:flex; align-items:center; justify-content:flex-end; margin-bottom:8rpx; font-size:13px; color:var(--text-regular); }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .card-actions { gap: 8px; flex-wrap: wrap; justify-content: flex-end; align-items: center; } .card-actions .af-action { margin: 0; } .tabs, .sub-tabs { gap: 4px; padding: 4px 0; } .b2-choice { flex: 1 1 auto; min-width: 0; } .b2-choice .af-choice__face { width: 100%; gap: 6px; } .setup-launch-entry { border-color: var(--af-border); background: var(--af-soft); }

/* Visual v2: scenes are below measured stationNavbar; no synthetic metrics. */
.v2-workbench { background:var(--af2-page); padding-bottom:calc(88px + env(safe-area-inset-bottom)); }
.v2-work-overview { display:flex; align-items:center; gap:8px; margin:12px 16px; min-height:132px; padding:16px; background:var(--af2-strong); color:#FFFFFF; }
.v2-overview-copy { flex:1; min-width:0; position:relative; z-index:1; }
.v2-overview-title { display:block; font-size:20px; line-height:28px; font-weight:600; overflow-wrap:anywhere; }
.v2-overview-note { display:block; margin-top:8px; font-size:13px; line-height:20px; color:#DCE8F1; }
.v2-management-link { margin-top:10px; min-height:44px; padding:5px 12px; border:0; gap:10px; font-size:14px; line-height:22px; color:#253D59; background:#F5F9FC; }
.v2-delivery-scene,.v2-scene-fallback { width:178px; height:111px; flex:none; }
.v2-scene-fallback { display:flex; align-items:center; justify-content:center; }
.v2-workbench .setup-launch-entry { margin:8px 16px; }
.v2-workbench .ui-state,.v2-workbench > view > .load-error { margin:8px 16px; }
.v2-todo { margin:12px 16px; padding:0 12px; background:#FFFFFF; border:1px solid var(--af2-line); border-radius:14px; box-shadow:var(--af2-shadow); }
.v2-todo-summary { display:flex; align-items:center; gap:8px; min-height:48px; flex-wrap:wrap; }
.v2-todo .todo-title { flex:none; font-size:14px; line-height:22px; margin:0; }
.v2-todo-first { flex:1; min-width:0; display:flex; flex-wrap:wrap; gap:4px; font-size:13px; line-height:20px; color:var(--af2-muted); overflow-wrap:anywhere; }
.v2-todo-first-count { font-weight:600; }
.v2-todo-toggle { margin-left:auto; }
.v2-todo-toggle .af-action__face { padding:4px; background:transparent; color:var(--af2-primary); }
.v2-todo-read-state { display:block; padding:4px 0 8px; font-size:14px; line-height:22px; color:var(--af2-ink); overflow-wrap:anywhere; }
.v2-todo .todo-row { padding-bottom:12px; gap:8px; }
.v2-todo .todo-item { flex:1 1 110px; min-height:72px; width:auto; padding:10px; border:1px solid var(--af2-line); border-radius:10px; background:var(--af2-page); }
.v2-workbench .v2-queues { box-sizing:border-box; display:flex; width:calc(100% - 32px); margin:12px 16px; padding:0; background:transparent; overflow:visible; border-radius:0; }
.v2-queue-tab { flex:1 1 0; width:25%; padding:0 3px; min-height:68px; }
.v2-queue-tab .af-choice__face { min-height:68px; position:relative; flex-direction:column; gap:2px; padding:4px 0 9px; border:0; background:transparent; border-radius:12px; }
.v2-queue-tab .tab-count { display:block; margin:0; min-width:0; padding:0; border-radius:0; background:transparent; color:var(--af2-ink); font-size:24px; line-height:30px; font-weight:600; overflow-wrap:anywhere; }
.v2-queue-label { font-size:13px; line-height:20px; color:var(--af2-muted); }
.v2-queue-tab.af-choice--selected .af-choice__face { background:#FFFFFF; color:var(--af2-primary); box-shadow:var(--af2-shadow); }
.v2-queue-tab.af-choice--selected .tab-count,.v2-queue-tab.af-choice--selected .v2-queue-label { color:var(--af2-primary); }
.v2-queue-indicator { position:absolute; bottom:2px; width:20px; height:3px; border-radius:2px; background:var(--af2-primary); }
.v2-workbench .list { margin-top:16px; padding:0 16px; }
.v2-workbench .queue-head { padding:0; margin-bottom:10px; }
.v2-workbench .queue-title { font-size:18px; line-height:26px; }
.v2-workbench .order-card { padding:14px; margin:0 0 12px; border-radius:16px; border:1px solid var(--af2-line); box-shadow:var(--af2-shadow); }
.v2-workbench .card-header { margin-bottom:12px; }
.v2-workbench .info-row { margin-bottom:6px; }
.v2-workbench .info-label { width:36px; flex:none; font-size:13px; line-height:20px; color:var(--af2-muted); }
.v2-workbench .info-value { min-width:0; font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.v2-workbench .info-phone { margin-left:36px; font-size:13px; line-height:20px; }
.v2-workbench .card-actions { margin-top:12px; padding-top:12px; border-top:1px solid var(--af2-line); }
.v2-workbench .card-actions .af-action--primary { flex:1; min-height:44px; }
.v2-workbench .card-actions .af-action--secondary { flex:0 1 auto; min-height:44px; }
.v2-workbench .empty { display:flex; flex-direction:column; align-items:center; gap:8px; padding:20px 12px; color:var(--af2-muted); font-size:14px; line-height:22px; }
.v2-empty-image { width:176px; max-width:100%; height:117px; display:block; }
.v2-workbench .guide-entry { min-height:44px; margin:12px 16px; padding:8px 0; font-size:13px; line-height:20px; }
@media screen and (max-width:359px) { .v2-delivery-scene,.v2-scene-fallback { width:126px; height:84px; } .v2-work-overview { padding:14px; gap:4px; } .v2-overview-title { font-size:18px; line-height:26px; } }
@media (prefers-contrast:more) { .v2-overview-note { color:#FFFFFF; } }

.v2-workbench .v2-todo { background:var(--af2-surface-current); border-color:var(--af2-surface-current); }
