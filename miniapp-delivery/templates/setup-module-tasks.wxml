<template name="setupModuleTasks">
  <view class="setup-module-bar" wx:if="{{loading || error || (ready && tasks.length)}}">
    <text class="setup-module-title">本页上线准备</text>
    <text class="setup-module-copy" wx:if="{{loading}}">正在读取本页准备事项…</text>
    <view wx:elif="{{error}}"><text class="setup-module-copy">{{error}}</text><button class="af-action af-action--quiet" bindtap="refreshModuleSetup"><view class="af-action__face">重新核对</view></button></view>
    <view wx:else>
      <view class="setup-module-task" wx:for="{{tasks}}" wx:key="key">
        <view class="setup-module-task-head">
          <text class="setup-module-mark {{item.done ? 'is-done' : ''}}" wx:if="{{item.done || (item.key !== 'ticketPackage' && item.levelText !== '选填')}}" aria-label="{{item.done ? '已完成' : '必填项'}}">{{item.done ? '✓' : '○'}}</text><text class="setup-module-task-name">{{item.label}}</text>
          <text class="setup-module-level is-optional" wx:if="{{!item.done && (item.key === 'ticketPackage' || item.levelText === '选填')}}">选填</text>
          <text class="setup-module-state is-pending" wx:if="{{!item.done && item.key !== 'ticketPackage' && item.levelText !== '选填'}}">待填写</text>
          <button class="af-action af-action--quiet setup-module-action" data-key="{{item.key}}" bindtap="onModuleSetupTask"><view class="af-action__face">{{item.done ? '查看' : item.key === 'catalogOnShelf' ? '去上架商品' : item.key === 'ticketPackage' ? '查看水票商品' : '去填写'}}</view></button>
        </view>
        <text class="setup-module-copy" wx:if="{{!item.done && item.key !== 'stationPhone' && item.key !== 'stationPosition'}}">{{item.suggestion || item.why}}</text>
      </view>
    </view>
  </view>
</template>
