<import src="../../templates/station-navbar.wxml" />

<view class="container custom-tabbar-page">
  <!--
    自绘导航栏（b 方案）：**水站营业状态就在「配送」字样的左边** ——
    配送员接单前第一眼看到"今天休息 / 配送延迟"。结构与尺寸见共用件
    templates/station-navbar.wxml（样式 styles/station-navbar.wxss，数据与方法 behaviors/stationNavbar.js）。
  -->
  <template is="stationNavbar"
            data="{{title: '配送', statusBarHeight: statusBarHeight, navBarHeight: navBarHeight, navTitleRight: navTitleRight, navTitleLeft: navTitleLeft, navLeftMax: navLeftMax, stationStatusText: stationStatusText, stationStatusNote: stationStatusNote, stationStatusHint: stationStatusHint, stationStatusError: stationStatusError, stationPendingCount: stationPendingCount, rightPad: true, stationPanelShow: stationPanelShow, stationPanelLoading: stationPanelLoading, stationPanelItems: stationPanelItems, stationPanelPending: stationPanelPending, stationPanelDone: stationPanelDone, stationPanelShowAll: stationPanelShowAll, stationPanelSummary: stationPanelSummary, stationPanelOnlineHint: stationPanelOnlineHint, stationPanelError: stationPanelError, stationPanelReadReady: stationPanelReadReady, stationPanelRefreshing: stationPanelRefreshing}}" />

  <!--
    [2026-09-20 真机联调] 部分列表接口失败时的显式提示。
    没有它的话，后端没起 / 换了网时配送员看到的只是几个空白列表，会读成「今天没有单」；
    失败与"确实没单"必须能区分（AGENTS §8.17 / §8.22）。loadError 为空串时整块不渲染。
  -->
  <!-- 2026-10-14：配送角色标题不能代替具体站名；仅显示已核对的当前绑定站。 -->

  <view wx:if="{{isManager}}">
    <view class="setup-launch-entry" wx:if="{{stationOperatingStatus === 3}}" bindtap="openStationPanel">
      <text class="setup-launch-dot"></text><view class="setup-launch-main"><text>{{setupProgressKnown ? (setupRequiredPending > 0 ? '还需完成 ' + setupRequiredPending + ' 项必填' : '已具备上线条件') : '上线准备待核实'}}</text><text class="setup-launch-state">{{stationStatusText || '营业状态待核实'}}</text></view><text>查看 ›</text>
    </view>
  </view>
  <view class="delivery-launch-state" wx:elif="{{stationOperatingStatus === 3}}"><text>本站{{stationStatusText}}</text><text>请联系站长完成上线准备；已接配送任务仍可处理。</text></view>
  <view class="delivery-launch-state" wx:elif="{{stationOperatingStatus == null}}"><text>营业状态待核实</text><text>可重新进入配送页核对，已接任务仍可处理。</text></view>

  <view class="home-station-identity"><text>{{homeStationLabel}}</text></view>
  <view class="home-read-feedback" wx:if="{{loadError || (!loading && !readReady.unpaid)}}">
    <view class="home-read-feedback-copy">
      <text class="home-read-feedback-title">{{loadError || '待收款记录暂未加载'}}</text>
      <text class="home-read-feedback-note" wx:if="{{!readReady.unpaid}}">待收款未加载，不代表结清。</text>
    </view>
    <button class="home-read-feedback-retry" bindtap="onRetryVisibleData" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
  </view>
  <button class="unpaid-shortcut" wx:if="{{deliveredUnpaidOrders.length > 0}}" bindtap="onShowUnpaidRecords">已送达待收款 {{deliveredUnpaidOrders.length}} 单 · 查看收款记录 ›</button>
  <view class="collection-recovery" wx:if="{{collectionVerifiedText}}"><text>{{collectionVerifiedText}}</text></view>
  <view class="collection-recovery" wx:for="{{collectionRecoveryItems}}" wx:key="id">
    <text>订单 #{{item.id}}：{{item.text}}</text>
    <button wx:if="{{item.canRetryReport}}" size="mini" catchtap="onRetryReport" data-id="{{item.id}}">重试原反馈</button>
    <button size="mini" catchtap="onVerifyCollection" data-id="{{item.id}}">核实当前订单</button>
    <button size="mini" catchtap="onOpenRecoveryOrder" data-id="{{item.id}}">查看订单详情</button>
  </view>

  <!--
    Tab 切换。名字与后端订单状态一一对齐（constant/OrderStatus）：
      待配送 = status 1（还没开始送）· 配送中 = status 2 · 今日送达 = 今日实际送达的 status 3/4。
    ⚠️ [2026-09-19] 第一个页签原叫「待接单」，改叫「待配送」：**站长自己也会接单**
    （acceptOrder 允许 DELIVERY 与 STATION_MANAGER），一个"待接单"的标签在站长眼里
    读起来像"还没人派单"，而它实际装的是"本站所有还没开始配送的单"
    （= 已分配给我的 + 全站待分配的，见 index.js 的合并逻辑）。按「接单配送」= status 1→2。
  -->
  <!-- 2026-10-22：原统计区重复占据首屏，数量并入同一筛选入口；仍取各列表长度，不另算业务总数。 -->
  <view id="home-task-filters" class="tab-bar">
    <view class="tab-item {{activeTab === 'assigned' ? 'active' : ''}}" bindtap="switchTab" data-tab="assigned">
      <text class="stat-label">待配送</text>
      <text class="stat-unit">{{readReady.assigned ? assignedOrders.length + ' 单' : '—'}}</text>
    </view>
    <view class="tab-item {{activeTab === 'delivering' ? 'active' : ''}}" bindtap="switchTab" data-tab="delivering">
      <text class="stat-label">配送中</text>
      <text class="stat-unit">{{readReady.delivering ? deliveringOrders.length + ' 单' : '—'}}</text>
    </view>
    <view class="tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">
      <text class="stat-label">今日送达</text>
      <text class="stat-unit">{{readReady.completed ? completedOrders.length + ' 单' : '—'}}</text>
    </view>
  </view>

  <!-- 待配送列表（站长分配给我、以及全站还没派出去的单；还没点「接单配送」）。
       §4 的字段顺序：小区/街道与楼栋门牌 → 楼层/电梯（知道才显示）→ 本单商品与数量
       → 「需收 / 已付 ¥X」→ 联系人 → 主动作；订单号留在卡头当次要信息（报问题用）。 -->
  <view class="order-list" wx:if="{{activeTab === 'assigned'}}">
    <!--
      「转给我的单」（[2026-09-27] 产品裁定：**转单必须双方同意**）。
      ⚠️ 为什么放在这里而不是单开一个页签：转单只有一种终态 —— 同意后它**就是我的待配送单**，
      拒绝后它留在原配送员名下、与我再无关系。单开页签会让"待配送"与"待接收"两张表长期并存，
      配送员得自己记住"先看哪个"。放在待配送最上方、且**只在我有待接收时才出现**，
      就是要它显眼但会消失。
      待确认期间订单还挂在发起人名下（后端 transferToStaff 不改归属），所以这些单**不在**
      assignedOrders 里 —— 两个列表是互斥的，同一单不会同时出现两次。
    -->
    <view class="transfer-in-card" wx:for="{{incomingTransfers}}" wx:key="id">
      <view class="card-header">
        <view class="tag-row">
          <text class="status-tag status-transfer">待我确认</text>
          <text class="transfer-from" wx:if="{{item.fromStaffName}}">来自 {{item.fromStaffName}}</text>
        </view>
        <text class="order-id">#{{item.id}}</text>
      </view>
      <view class="address-info" wx:if="{{item.addressDetail || item.addressSnapshot}}">
        <text class="address-text">{{item.addressDetail || item.addressSnapshot}}</text>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.itemSummaryText}}</text>
        <text class="product-qty" wx:if="{{item.itemMetaText}}">{{item.itemMetaText}}</text>
      </view>
      <view class="pay-line">
        <text class="pay-label {{item.isUnpaid ? 'pay-need' : ''}}">{{item.payLabel}}</text>
        <text class="pay-amount {{item.isUnpaid ? 'pay-need' : ''}}">{{item.amountText}}</text>
      </view>
      <view class="contact-row">
        <text class="customer-name">{{item.customerName || item.receiverName}}</text>
        <text class="customer-phone" wx:if="{{item.customerPhone || item.receiverPhone}}"
              catchtap="onCallCustomer" data-phone="{{item.customerPhone || item.receiverPhone}}">{{item.customerPhone || item.receiverPhone}}</text>
      </view>
      <view class="card-actions">
        <button class="btn-accept" catchtap="onAcceptTransfer" data-id="{{item.id}}">同意，我来送</button>
        <button class="btn-reject-transfer" catchtap="onRejectTransfer" data-id="{{item.id}}">不接受</button>
      </view>
    </view>
    <view class="order-card" wx:for="{{assignedOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="card-header">
        <view class="tag-row">
          <text class="status-tag status-pending">待配送</text>
        </view>
        <text class="order-id">#{{item.id}}</text>
      </view>
      <view class="address-info" wx:if="{{item.addressDetail || item.addressSnapshot}}">
        <text class="address-text">{{item.addressDetail || item.addressSnapshot}}</text>
      </view>
      <!-- 楼层/电梯：出车前就知道要不要上楼（文案按三态算好，不确定时整行不显示） -->
      <view class="address-info" wx:if="{{item.floorText}}">
        <text class="address-text floor-text">{{item.floorText}}</text>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.itemSummaryText}}</text>
        <text class="product-qty" wx:if="{{item.itemMetaText}}">{{item.itemMetaText}}</text>
      </view>
      <view class="pay-line">
        <text class="pay-label {{item.isUnpaid ? 'pay-need' : ''}}">{{item.payLabel}}</text>
        <text class="pay-amount {{item.isUnpaid ? 'pay-need' : ''}}">{{item.amountText}}</text>
      </view>
      <view class="contact-row">
        <text class="customer-name">{{item.customerName || item.receiverName}}</text>
        <text class="customer-phone" wx:if="{{item.customerPhone || item.receiverPhone}}"
              catchtap="onCallCustomer" data-phone="{{item.customerPhone || item.receiverPhone}}">{{item.customerPhone || item.receiverPhone}}</text>
      </view>
      <view class="customer-note-preview" wx:if="{{item.customerNotePreview}}">备注：{{item.customerNotePreview}}</view>
      <view class="card-actions">
        <button class="btn-accept" catchtap="onAcceptOrder" data-id="{{item.id}}">接单配送</button>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!loading && readReady.assigned && assignedOrders.length === 0 && readReady.transfers && incomingTransfers.length === 0}}">
      <!-- [2026-09-26] 配送员看不到"本站还没派出去的单"（产品裁定：未分配的不该出现在配送员面前），
           所以空态要说清"等站长派单"，否则他会以为自己今天真的没活干。 -->
      <text class="empty-text" wx:if="{{onlyAssigned}}">还没有派给你的单，等站长分配</text>
      <text class="empty-text" wx:else>暂无待配送订单</text>
    </view>
  </view>

  <!-- 配送中列表 -->
  <view class="order-list" wx:elif="{{activeTab === 'delivering'}}">
    <view class="order-card" wx:for="{{deliveringOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="card-header">
        <view class="tag-row">
          <text class="status-tag status-delivering">配送中</text>
          <text class="aux-tag aux-offline" wx:if="{{item.isOffline}}">线下</text>
        </view>
        <text class="order-id">#{{item.id}}</text>
      </view>
      <view class="address-info" wx:if="{{item.addressDetail || item.addressSnapshot}}">
        <text class="address-text">{{item.addressDetail || item.addressSnapshot}}</text>
      </view>
      <!-- 楼层/电梯：正在送的这一单要不要上楼 -->
      <view class="address-info" wx:if="{{item.floorText}}">
        <text class="address-text floor-text">{{item.floorText}}</text>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.itemSummaryText}}</text>
        <text class="product-qty" wx:if="{{item.itemMetaText}}">{{item.itemMetaText}}</text>
      </view>
      <view class="pay-line">
        <text class="pay-label {{item.isUnpaid ? 'pay-need' : ''}}">{{item.payLabel}}</text>
        <text class="pay-amount {{item.isUnpaid ? 'pay-need' : ''}}">{{item.amountText}}</text>
      </view>
      <view class="contact-row">
        <text class="customer-name">{{item.customerName || item.receiverName}}</text>
        <text class="customer-phone" wx:if="{{item.customerPhone || item.receiverPhone}}"
              catchtap="onCallCustomer" data-phone="{{item.customerPhone || item.receiverPhone}}">{{item.customerPhone || item.receiverPhone}}</text>
      </view>
      <view class="customer-note-preview" wx:if="{{item.customerNotePreview}}">备注：{{item.customerNotePreview}}</view>
      <view class="card-actions">
        <button class="btn-complete" catchtap="onCompleteOrder" data-id="{{item.id}}">完成配送</button>
        <button class="btn-mediate-small" catchtap="onMediateOrder" data-id="{{item.id}}">配送遇到问题</button>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!loading && readReady.delivering && deliveringOrders.length === 0}}">
      <text class="empty-text">暂无配送中订单</text>
    </view>
  </view>

  <!-- 今日实际送达列表：支付状态另列，不能把已送达未收款说成已完成。 -->
  <view class="order-list" wx:elif="{{activeTab === 'completed'}}">
    <view class="order-card {{item.status === 4 && !item.isUnpaid ? 'completed-order-card' : ''}}" wx:for="{{completedOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="card-header">
        <view class="tag-row">
          <text class="status-tag {{item.isUnpaid ? 'status-warning' : 'status-completed'}}">{{item.statusText || '当前状态待核实'}}</text>
          <text class="aux-tag aux-offline" wx:if="{{item.isOffline}}">线下</text>
          <text class="aux-tag aux-unpaid" wx:if="{{item.isUnpaid}}">待收款</text>
        </view>
        <text class="order-id">#{{item.id}}</text>
        <text class="order-time">{{item.deliveryTime || '送达日期待核实'}}</text>
      </view>
      <view class="address-info" wx:if="{{item.addressDetail || item.addressSnapshot}}">
        <text class="address-text">{{item.addressDetail || item.addressSnapshot}}</text>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.itemSummaryText}}</text>
        <text class="product-qty" wx:if="{{item.itemMetaText}}">{{item.itemMetaText}}</text>
      </view>
      <view class="pay-line">
        <text class="pay-label {{item.isUnpaid ? 'pay-need' : ''}}">{{item.payLabel}}</text>
        <text class="pay-amount {{item.isUnpaid ? 'pay-need' : ''}}">{{item.amountText}}</text>
      </view>
      <view class="contact-row">
        <text class="customer-name">{{item.receiverName || item.customerName}}</text>
        <!-- 2026-10-07：完成卡沿用收件快照拨号，不另读跨站客户档案。 -->
        <text class="customer-phone" wx:if="{{item.receiverPhone || item.customerPhone}}"
          catchtap="onCallCustomer" data-phone="{{item.receiverPhone || item.customerPhone}}">{{item.receiverPhone || item.customerPhone}}</text>
      </view>
      <view class="customer-note-preview" wx:if="{{item.customerNotePreview}}">备注：{{item.customerNotePreview}}</view>
      <view class="complete-footer">
        <text class="return-barrel" wx:if="{{item.returnBucketQty > 0}}">回桶 {{item.returnBucketQty}} 个</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!loading && readReady.completed && completedOrders.length === 0}}">
      <text class="empty-text">今日暂无已送达订单</text>
    </view>
  </view>

  <!-- 待收款明细完整保留；配送任务优先，顶部入口可直接定位到此。 -->
  <view id="home-unpaid-records" class="unpaid-section" wx:if="{{deliveredUnpaidOrders.length > 0}}">
    <view class="unpaid-header">
      <text class="unpaid-title">已送达 · 待收款</text>
      <text class="unpaid-count">{{deliveredUnpaidOrders.length}} 单</text>
    </view>
    <button class="unpaid-back-to-tasks" bindtap="onBackToTaskFilters">返回配送任务筛选</button>
    <block>
      <view class="order-card" wx:for="{{deliveredUnpaidOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap">
        <view class="card-header">
          <view class="tag-row">
            <text class="status-tag status-warning">已配送待付款</text>
            <text class="aux-tag aux-offline" wx:if="{{item.isOffline}}">线下</text>
            <text class="aux-tag aux-unpaid" wx:if="{{item.isUnpaid}}">待收款</text>
          </view>
          <text class="order-id">#{{item.id}}</text>
        </view>
        <view class="address-info" wx:if="{{item.addressDetail || item.addressSnapshot}}">
          <text class="address-text">{{item.addressDetail || item.addressSnapshot}}</text>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.itemSummaryText}}</text>
          <text class="product-qty" wx:if="{{item.itemMetaText}}">{{item.itemMetaText}}</text>
        </view>
        <view class="pay-line">
          <text class="pay-label {{item.isUnpaid ? 'pay-need' : ''}}">{{item.payLabel}}</text>
          <text class="pay-amount {{item.isUnpaid ? 'pay-need' : ''}}">{{item.amountText}}</text>
          <text class="pay-extra" wx:if="{{item.returnBucketQty > 0}}">回桶 {{item.returnBucketQty}} 个</text>
        </view>
        <view class="contact-row">
          <text class="customer-name">{{item.customerName || item.receiverName}}</text>
          <text class="customer-phone" wx:if="{{item.receiverPhone}}" catchtap="onCallCustomer" data-phone="{{item.receiverPhone}}">{{item.receiverPhone}}</text>
        </view>
        <view class="customer-note-preview" wx:if="{{item.customerNotePreview}}">备注：{{item.customerNotePreview}}</view>
        <view class="card-actions">
          <button class="btn-accept" catchtap="onConfirmCollection" data-id="{{item.id}}" disabled="{{item.collectionBusy}}">{{item.collectionBusy ? '收款待核实' : '确认收款'}}</button>
        </view>
      </view>
    </block>
  </view>

  <view class="loading-state" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view>

  <!--
    配送员「配送遇到问题」弹层。
    ⚠️ [2026-09-27 产品口径] **异常上报是主项，排在最前**，转单与退回站长降为"这单我确实送不了"
    之后的安排。原先把"请同事接手"排在第一项，配送员遇到"客户不接电话"这类**现场问题**时
    第一眼看到的是"把单转走"—— 于是问题本身没有留痕，只是换了个人去撞同一堵墙。
    三行的顺序不是排版偏好：它决定配送员第一反应点哪一个。
    ⚠️ index.js 传给后端的 reason 字符串（'配送员调解转单' / '配送员调解退回'）是业务标识，
       可能被后端或站长端读取 —— 改文案**不许**跟着改它。
  -->
  <view class="modal-overlay" wx:if="{{showMediateModal}}" bindtap="onCloseMediateModal">
    <view class="modal-content" catchtap="stopPropagation">
      <text class="modal-title">配送遇到问题</text>
      <text class="modal-desc">先上报问题留痕，再决定这单怎么安排</text>
      <scroll-view class="modal-scroll" scroll-y>
      <view class="modal-list">
        <view class="modal-item" bindtap="onReportProblem" hover-class="press-feedback">
          <view class="modal-item-info">
            <text class="modal-item-name">上报配送问题</text>
            <text class="modal-item-desc">记录现场问题，通知站长</text>
          </view>
          <text class="modal-item-arrow">›</text>
        </view>
      </view>
      <text class="modal-sub-title">这单我确实送不了</text>
      <view class="modal-list">
        <view class="modal-item" bindtap="onMediateToColleague" hover-class="press-feedback">
          <view class="modal-item-info">
            <text class="modal-item-name">请同事接手这单</text>
            <text class="modal-item-desc">从本站配送员里选一位，他同意后这单归他送</text>
          </view>
          <text class="modal-item-arrow">›</text>
        </view>
        <view class="modal-item" bindtap="onMediateToStation" hover-class="press-feedback">
          <view class="modal-item-info">
            <text class="modal-item-name">退回去让站长重新安排</text>
            <text class="modal-item-desc">这单回到待分配，站长确认后重新派人</text>
          </view>
          <text class="modal-item-arrow">›</text>
        </view>
      </view>
      </scroll-view>
      <button class="modal-cancel" bindtap="onCloseMediateModal">取消</button>
    </view>
  </view>
</view>
<business-dialog id="business-dialog" />
