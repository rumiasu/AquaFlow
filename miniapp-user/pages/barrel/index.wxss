/* [2026-10-13] 必要说明曾误用低对比次要/占位色；只改正常文字为正文辅助色，保留非文本与禁用态原声明。 */
.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部三列统计：办理入口不能占用统计列的宽度。 */
.stats-card {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: none;
}

.stat-col {
  flex: 1;
  min-width: 0;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-regular);
}

.stat-value-row {
  display: flex;
  align-items: baseline;
}

.stat-number {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  word-break: break-all;
}

.stat-number.deposit {
  color: var(--text-primary);
}

.stat-number.owed {
  color: var(--error-color);
}

.stat-unit {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-left: 6rpx;
}

/* 「押金流水 ›」入口：整列可点（bindtap 在 .stat-col 上），这里只做视觉提示 */
.stat-link {
  /* 22rpx=11px 低于「其它必要可读字≥12逻辑px」原标准（G04-barrel-rights）；别改回 22rpx。 */
  font-size: 26rpx;
  color: var(--primary-color);
}

.stat-divider {
  width: 1rpx;
  background-color: var(--border-light);
  align-self: stretch;
  margin: 24rpx 0;
}

.rights-actions {
  display: flex;
  justify-content: flex-end;
  margin: 0 24rpx 24rpx;
}

.rights-purchase-btn {
  margin: 0;
  padding: 14rpx 24rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  color: var(--primary-color);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.6;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rights-purchase-btn::after {
  border: none;
}

.owed-tip {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 59, 48, 0.08);
  border: 1rpx solid rgba(255, 59, 48, 0.3);
  border-radius: var(--radius-md);
  color: var(--error-color);
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 水站暂存：中性提示，不是警告——over<0 是合法状态，只是让顾客知道桶在哪 */
.storage-tip {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(10, 132, 255, 0.08);
  border: 1rpx solid rgba(10, 132, 255, 0.3);
  border-radius: var(--radius-md);
  color: var(--primary-color);
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  box-shadow: none;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.return-btn-small {
  padding: 0 20rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--primary-color);
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.return-btn-small text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 水桶列表 */
.bucket-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bucket-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--bg-color);
  border-radius: 0;
  background: #fff;
  border-bottom: 1rpx solid var(--border-color);
}

.bucket-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.bucket-icon {
  font-size: 40rpx;
}

.bucket-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  word-break: break-all;
}

.bucket-id {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.bucket-time {
  /* 22rpx=11px 低于「其它必要可读字≥12逻辑px」原标准（G04-barrel-rights）；别改回 22rpx。 */
  font-size: 26rpx;
  color: var(--text-regular);
}

.bucket-status {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  font-weight: 500;
  max-width: 40%;
  word-break: break-all;
  box-sizing: border-box;
}

.status-0 {
  color: var(--primary-color);
  background-color: var(--primary-bg);
}

.status-1 {
  color: var(--warning-color);
  background-color: rgba(255, 149, 0, 0.1);
}

.status-2 {
  color: var(--primary-color);
  background-color: var(--primary-bg);
}

.status-3 {
  color: var(--success-color);
  background-color: rgba(52, 199, 89, 0.1);
}

.status-4 {
  color: var(--error-color);
  background-color: rgba(255, 59, 48, 0.1);
}

/* 记录分成摘要与整行操作，窄屏也不让按钮挤占类型/状态。 */
.barrel-record {
  display: block;
}

.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-header .bucket-info {
  flex: 1;
  min-width: 0;
}

.record-header .bucket-icon {
  flex-shrink: 0;
}

.record-header .bucket-detail {
  min-width: 0;
  overflow-wrap: break-word;
}

.record-header .bucket-status {
  flex-shrink: 0;
  max-width: 42%;
  box-sizing: border-box;
  line-height: 1.5;
}

.record-return {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.record-summary {
  display: block;
  color: var(--text-regular);
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}

.record-summary.refund-fact {
  color: var(--text-regular);
}

.record-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.record-action {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 500;
  min-height: 88rpx;
}

.record-action::after {
  border: none;
}

.record-action-primary {
  color: #fff;
  background: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

.record-action-secondary {
  color: var(--text-regular);
  background: #fff;
  border: 1rpx solid var(--border-color);
}

/* 押金说明卡片 */
.info-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: none;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-regular);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-regular);
}

/* 爱护水桶卡片 */
.eco-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: none;
}

.eco-content {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.eco-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.eco-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eco-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.eco-desc {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

.eco-btn {
  padding: 14rpx 28rpx;
  background-color: var(--bg-color);
  border-radius: 20rpx;
  display: inline-block;
  align-self: flex-start;
}

.eco-btn text {
  font-size: 14px;
  color: var(--primary-color);
  font-weight: 500;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  max-height: 90vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-content.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  /* × 为文本字形，白底需≥4.5:1（G04 return-refund）；--text-secondary(#637083) 仅 2.67:1，别改回。 */
  color: var(--text-regular);
  padding: 0 8rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 32rpx;
  min-height: 0;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  flex-shrink: 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.return-tip {
  /* 26rpx=13px：办理水站为原关键「站别」字段，须≥14逻辑px（G04 return-refund）；别改回 26rpx。 */
  font-size: 28rpx;
  color: var(--text-regular);
  margin-bottom: 24rpx;
}

.return-tip .highlight {
  color: var(--primary-color);
  font-weight: 700;
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 88rpx;
  height: auto;
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0; min-height:44px; display:flex; align-items:center; justify-content:center; }

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-btn text {
  font-size: 36rpx;
  color: var(--text-primary);
  line-height: 1;
}

.qty-input {
  width: 100rpx;
  height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 16rpx;
  color: var(--text-primary);
}

.deposit-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.deposit-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.deposit-max {
  font-size: 26rpx;
  color: var(--primary-color);
  white-space: nowrap;
  padding: 8rpx 16rpx;
  background-color: var(--primary-bg);
  border-radius: 8rpx;
}

/* 退桶试算（金额由后端按押金条批次算出，前端只读展示） */
.preview-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding: 8rpx 0;
}

.preview-amount {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.preview-placeholder {
  font-size: 26rpx;
  color: var(--text-regular);
}

/*
  试算算不出来时的原因说明（2026-09-27 加）。与 .preview-blocked 同色同形：
  「还没选商品数量」是中性灰，而「缺一个前置条件，你得去做一件事」要更醒目。
  ⚠️ 与 .preview-blocked 是并列的两块，改配色时两处一起改。
*/
.preview-hint {
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx; border-left:4rpx solid var(--warning-color); }

.preview-hint text {
  font-size: 26rpx;
  color: var(--warning-color);
}

.preview-blocked {
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx; border-left:4rpx solid var(--warning-color); }

.preview-blocked text {
  font-size: 26rpx;
  color: var(--warning-color);
}

.preview-lots {
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.preview-lots-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-regular);
  margin-bottom: 8rpx;
}

.preview-lot text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.preview-warn {
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx; border-left:4rpx solid var(--warning-color); }

.preview-warn text {
  font-size: 26rpx;
  color: var(--warning-color);
}

.preview-storage {
  padding: 8rpx 0 16rpx;
}

.preview-storage text {
  font-size: 26rpx;
  color: var(--text-regular);
}

.note-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.water-type-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.water-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  /* 26rpx=13px：商品名为原关键「商品」字段，须≥14逻辑px；别改回 26rpx。 */
  font-size: 28rpx;
  color: var(--text-primary);
}

.water-type-item.active {
  border-color: var(--primary-color);
  background-color: var(--primary-bg);
  color: var(--primary-color);
}

.water-type-qty {
  /* 22rpx=11px 低于「其它必要可读字≥12逻辑px」（G04 return-refund 可退权益分列）；别改回 22rpx。 */
  font-size: 26rpx;
  color: var(--text-regular);
  margin-top: 4rpx;
}

.water-type-item.active .water-type-qty {
  color: var(--primary-color);
}

.modal-footer {
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.modal-btn {
  flex: 1;
  height: auto;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  min-height: 44px;
  padding: 16rpx;
  box-sizing: border-box;
}

.modal-btn.cancel {
  background-color: var(--bg-gray);
  color: var(--text-regular);
}

.modal-btn.confirm {
  background: var(--primary-color);
  color: #fff;
}

.modal-btn.confirm.disabled {
  background: var(--text-placeholder);
}

/* 当前水站提示条（2026-09-20）：水票/押金/桶权益按「客户 × 水站」隔离，
   页面要能一眼看出"这是哪个站的账"。样式与 pages/deposit/records 同名类保持一致。 */
.station-bar {
  display: flex;
  flex-direction: column;
  padding: 4rpx 8rpx 20rpx;
}

.station-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-bar-tip {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 桶账明细沿用原白卡，只调整信息层次。 */
.asset-bucket-item .bucket-info { min-width: 0; flex: 1; }
.asset-bucket-item .bucket-detail { min-width: 0; }
.asset-bucket-item .bucket-id { overflow-wrap: break-word; }
.asset-bucket-item .bucket-status { flex-shrink: 0; margin-left: 12rpx; }
.bucket-detail-toggle { margin-top: 12rpx; font-size: 26rpx; color: var(--primary-color); }
.bucket-account-detail { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border-color); }
.bucket-account-detail text { display: block; color: var(--text-regular); font-size: 26rpx; line-height: 1.7; }

.bucket-detail-toggle { min-height: 88rpx; display: flex; align-items: center; }
.asset-bucket-item { align-items: flex-start; gap: 16rpx; }

.eco-card { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); }
.eco-content { flex: 1; min-width: 280rpx; margin-bottom: 0; }
.eco-btn { min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--radius-sm); }

/* 本页所有状态共用的可读与触控边界。 */
.stale-note { display: block; margin: 20rpx 24rpx; color: var(--warning-color); background: var(--bg-gray); padding: 20rpx; font-size: 26rpx; line-height: 1.65; border-left: 4rpx solid var(--warning-color); }
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.bucket-detail, .bucket-info { min-width: 0; overflow-wrap: anywhere; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
.modal-btn.confirm.disabled { background: var(--bg-gray); color: var(--text-regular); }
.modal-btn.confirm.disabled text { color: var(--text-regular); }
.return-tip > text { display: block; margin-bottom: 12rpx; }
.empty-next-note { display:block; margin-top:12rpx; font-size:26rpx; line-height:1.7; }
.empty-asset-action { margin:20rpx 24rpx; min-height:88rpx; padding:20rpx; background:var(--primary-color); color:#fff; border-radius:12rpx; font-size:28rpx; line-height:1.6; }
.empty-asset-action.secondary { color:var(--primary-color); background:var(--primary-bg); }
.bucket-detail-pressed { background:var(--primary-bg); }

/* 2026-10-28：当前资产优先；明细与规则保留为44px可展开入口。 */
.stats-card { flex-wrap:wrap; gap:16rpx; padding:24rpx; background:#fff; border:1rpx solid var(--border-light); }
.stat-col { flex:1 1 170rpx; min-width:0; overflow-wrap:anywhere; }
.stat-divider { display:none; }
.stat-number { font-size:26px; line-height:1.25; }
.stat-label,.stat-link,.bucket-time,.water-type-qty { font-size:14px; line-height:1.6; }
.stat-link,.bucket-detail-toggle,.modal-close,.return-btn-small,.water-type-item,.form-row,.preview-row { min-height:44px; box-sizing:border-box; }
.history-toggle,.detail-toggle { margin:0; padding:10px 12px; min-height:44px; height:auto; font-size:14px; line-height:1.5; color:var(--primary-color); background:transparent; white-space:normal; }
.detail-toggle { justify-content:flex-start; text-align:left; }
.history-toggle::after,.detail-toggle::after { border:0; }
.section-header { flex-wrap:wrap; gap:12rpx; }
.record-header,.record-actions { flex-wrap:wrap; gap:16rpx; }
.record-actions button { min-height:44px; white-space:normal; }
.asset-bucket-item { flex-wrap:wrap; }
.qty-btn { min-width:48px; min-height:48px; }
.qty-input { min-height:48px; }
.modal-close { min-width:44px; }
.modal-body { min-height:0; overflow-y:auto; }
.modal-btn.confirm { min-height:48px; }
.quantity-error { display:block; color:var(--error-color); font-size:14px; line-height:1.6; }
.eco-card { background:#fff; border-top:1rpx solid var(--border-light); }

.ui-draft-notice { margin:16rpx 24rpx; padding:20rpx; background:#fff; border:1rpx solid var(--border-light); border-radius:12rpx; font-size:14px; line-height:1.6; }
.ui-draft-notice .af-action { margin:4px 8px 0 0; }
.ui-draft-notice button::after { border:0; }

.asset-key { display:flex; flex-wrap:wrap; gap:8px; margin:8px 12px 16px; }
.asset-key > view { flex:1 1 70px; display:flex; align-items:center; gap:5px; color:var(--af-text-secondary); font-size:13px; line-height:1.4; }
.modal-footer { gap:8px; }
.modal-footer .af-action--cancel { width:80px; }

/* 数量与押金各有明确标题、单位，颜色仅辅助区分。 */
.stats-card { gap:8px; margin:12px 16px; background:transparent; overflow:visible; }
.stat-col { background:var(--af2-surface-physical); border-radius:14px; padding:14px 8px; box-sizing:border-box; }
.stat-col.stat-money { background:var(--af2-surface-money); }
.stat-divider { display:none; }
.stat-label,.stat-unit { color:var(--af2-ink); }
.stat-link { color:var(--af2-ink-money); }
.asset-key { background:var(--af2-surface-neutral); border-radius:12px; }
@media (max-width:340px) { .stats-card { flex-wrap:wrap; } .stat-col { flex:1 1 85px; } .stat-number { overflow-wrap:anywhere; } }

/* Bounded phone feedback: asset facts, product identity and money actions have separate hierarchy. */
.barrel-assets-page { padding:12px 16px calc(24px + env(safe-area-inset-bottom)); box-sizing:border-box; }
.barrel-assets-page .stats-card { display:flex; flex-wrap:nowrap; gap:8px; margin:12px 0; padding:0; border:0; }
.barrel-assets-page .stat-col { flex:1 1 0; min-width:0; padding:12px 6px; gap:6px; border-radius:12px; }
.barrel-assets-page .stat-label,.barrel-assets-page .stat-unit { font-size:13px; line-height:20px; }
.barrel-assets-page .stat-number { font-size:24px; line-height:32px; }
.barrel-assets-page .stat-money .stat-number { color:var(--af2-ink-money); }
.barrel-assets-page .stat-neutral { background:var(--af2-surface-neutral); }
.barrel-assets-page .stat-owed { background:var(--af2-surface-physical); }
.barrel-assets-page .stat-link { min-height:0; font-size:13px; line-height:20px; }
.barrel-assets-page .rights-actions { margin:0 0 16px; justify-content:flex-start; align-items:center; flex-wrap:wrap; gap:8px 12px; }
.barrel-assets-page .rights-purchase { display:flex; align-items:center; gap:8px; min-height:48px; margin:0; background:var(--af2-ink-money); color:#FFFFFF; }
.rights-purchase-note { color:var(--af2-muted); font-size:14px; line-height:22px; }
.barrel-assets-page .section { margin:0 0 16px; padding:14px; border:1px solid var(--af2-line); border-radius:14px; }
.barrel-assets-page .section-header { margin-bottom:12px; gap:4px 8px; }
.barrel-assets-page .section-title { font-size:17px; line-height:25px; }
.barrel-return-entry .af-action__face { background:transparent; color:var(--af2-ink-money); padding-left:4px; padding-right:4px; }
.barrel-assets-page .asset-bucket-item { display:block; width:100%; padding:12px 0; background:transparent; border-bottom:1px solid var(--af2-line); }
.asset-bucket-item:last-child { border-bottom:0; }
.barrel-assets-page .asset-bucket-item .bucket-info { width:100%; display:flex; align-items:flex-start; gap:12px; }
.asset-product-photo { display:block; width:72px; height:96px; flex:0 0 72px; border-radius:10px; background:var(--af2-surface-neutral); }
.asset-photo-placeholder { display:flex; align-items:center; justify-content:center; }
.barrel-assets-page .asset-bucket-item .bucket-detail { flex:1; min-width:0; gap:4px; }
.barrel-assets-page .asset-bucket-item .bucket-id { display:block; white-space:normal; overflow-wrap:anywhere; word-break:break-word; font-size:15px; line-height:23px; font-weight:600; }
.bucket-spec { font-size:13px; line-height:20px; color:var(--af2-muted); }
.barrel-assets-page .asset-bucket-item .bucket-time { font-size:14px; line-height:22px; }
.asset-deposit-standard { font-size:14px; line-height:22px; color:var(--af2-ink-money); }
.barrel-assets-page .bucket-detail-toggle { margin-top:0; min-height:44px; font-size:14px; line-height:22px; }
.barrel-rules-link { display:flex; align-items:center; min-height:44px; padding:0 4px; color:var(--af2-muted); font-size:14px; line-height:22px; }
.barrel-assets-page .local-empty { display:block; margin:8px 0; padding:12px 8px; font-size:14px; line-height:22px; }

/* 资产指标同容器；空态两项操作有明确层级与间距。 */
.barrel-assets-page .stats-card { gap:0; padding:4px; background:#fff; border:1px solid #DDE5EF; border-radius:14px; }
.barrel-assets-page .stat-col,.barrel-assets-page .stat-col.stat-money { background:transparent; border-radius:0; }
.barrel-assets-page .stat-divider { display:block; align-self:stretch; width:1px; margin:12px 0; background:#DDE5EF; }
.barrel-assets-page .rights-purchase { background:#1264D6; }
.empty-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:10px; margin-top:12px; }
.empty-actions button.af-action { width:auto; min-height:44px; margin:0; }
.empty-barrel-icon { display:flex; align-items:center; justify-content:center; width:64px; height:64px; margin:0 auto 8px; border-radius:50%; background:#EAF2FF; }
.barrel-assets-page .status-1 { color:#244D7D; background:#EAF2FF; }
.barrel-assets-page .preview-hint,.barrel-assets-page .preview-blocked,.barrel-assets-page .preview-warn,.barrel-assets-page .stale-note { border-left-color:#1264D6; }
.barrel-assets-page .preview-hint text,.barrel-assets-page .preview-blocked text,.barrel-assets-page .preview-warn text,.barrel-assets-page .stale-note { color:#244D7D; }
