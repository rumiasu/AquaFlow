/* 自绘导航栏 + 状态胶囊（.navbar* / .status-chip*）：与「配送」页共用一份样式 */
@import "../../styles/station-navbar.wxss";

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 40rpx;
}

.no-auth {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 60rpx;
  text-align: center;
}

.no-auth-icon {
  font-size: 140rpx;
  margin-bottom: 36rpx;
}

.no-auth-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.no-auth-desc {
  display: block;
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 60rpx;
}

.no-auth-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #4F8EF7;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 8rpx 8rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.15s ease;
}

.tab-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #4F8EF7;
}

.tab-count {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.08);
  text-align: center;
}

.tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.list {
  padding: 20rpx 24rpx 0;
}

.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-card-exception {
  border: 2rpx solid #FF3B30;
  background: #FFF5F5;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-pending { background: #FFF1DC; color: #CC7700; }
.status-delivering { background: #E3F2FD; color: #1976D2; }
.status-transfer { background: #E8DAEF; color: #7B1FA2; }
.status-return { background: #FFEBEE; color: #C62828; }
.status-completed { background: #E8F5E9; color: #2E7D32; }
.status-exception { background: #FFEBEE; color: #D32F2F; }
.status-approval { background: #FFEBEE; color: #C62828; }

/* ========== 客户信用标（待分配卡片，2026-09-22） ==========
   文案与判据全在后端（CustomerRiskService），这里只有**颜色**。
   两档就够（站长是力工，多一档就多一次误判）：
     黄 risk-warn   = 关注：有挂账，都在账期内 —— **这是正常经营**，别做成告警的样子；
     红 risk-danger = 预警 / 冻结：已逾期或超额度，才需要立刻处理。
   `.order-card.risk-*` 给整张卡加一条左侧色边，扫一眼列表就知道哪几单要留意。
   `.risk-plain` 是"后端给了个我没见过的等级"的兜底（中性灰）—— 认不出来就别乱标红。 */
.risk-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.risk-tag.risk-warn { background: #FFF8E1; color: #B26A00; border: 2rpx solid #FFD666; }
.risk-tag.risk-danger { background: #FFEBEE; color: #C62828; border: 2rpx solid #FFA39E; }
.risk-tag.risk-plain { background: #F5F5F5; color: #666666; border: 2rpx solid #E0E0E0; }

.order-card.risk-warn { border-left: 8rpx solid #E6A23C; }
.order-card.risk-danger { border-left: 8rpx solid #F56C6C; }

.risk-note {
  font-size: 24rpx;
  line-height: 1.5;
  margin: -8rpx 0 18rpx;
}

.risk-note.risk-warn { color: #B26A00; }
.risk-note.risk-danger { color: #C62828; }
.risk-note.risk-plain { color: #888888; }

/* 「审批」页签内的子页签（客户 / 站内） */
.sub-tab-bar {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0 16rpx;
}

.sub-tab-item {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.sub-tab-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #4F8EF7;
}

.sub-tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}

.order-id {
  font-size: 24rpx;
  color: #888888;
  margin-left: auto;
}

.order-time {
  font-size: 22rpx;
  color: #aaaaaa;
}

.info-row {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 10rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-label {
  flex-shrink: 0;
  color: #888888;
  width: 100rpx;
}

.info-value {
  flex: 1;
  line-height: 1.5;
}

.info-phone {
  color: #4F8EF7;
  margin-left: 8rpx;
}

.info-address .info-value {
  color: #555555;
}

.transfer-info, .return-info {
  padding: 16rpx 20rpx;
  background: #f7f8fb;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.transfer-row, .return-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.from-label, .return-label {
  color: #888888;
}

.from-value, .return-value {
  color: #333333;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.exception-info {
  padding: 16rpx 20rpx;
  background: rgba(255, 59, 48, 0.08);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.exception-reason {
  font-size: 26rpx;
  color: #D32F2F;
  line-height: 1.5;
}

.card-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.btn-outline,
.btn-primary,
.btn-danger {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  border: none;
}

.btn-outline-small,
.btn-primary-small,
.btn-danger-small {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 0;
  border: none;
}

.btn-outline, .btn-outline-small {
  background: #ffffff;
  color: #666666;
  border: 2rpx solid #e0e0e0;
}

.btn-primary, .btn-primary-small {
  background: #4F8EF7;
  color: #ffffff;
}

.btn-danger {
  background: #FF3B30;
  color: #ffffff;
}

.btn-danger-small {
  background: #FFEBEE;
  color: #C62828;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999999;
}

/* 「看全部订单 ›」：列表底部的轻量跳转，不是主操作，所以做成居中文字链而不是按钮 */
.list-foot-link {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: #4F8EF7;
}
.list-foot-link:active { opacity: 0.6; }

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #1a1a1a;
}

.modal-list {
  max-height: 640rpx;
  overflow-y: auto;
}

.modal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.modal-item:active {
  background: #f7f8fb;
}

.modal-item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.modal-item-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.modal-item-phone {
  font-size: 24rpx;
  color: #888888;
}

.modal-item-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.modal-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

.modal-cancel {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #666666;
  background: #f5f6f8;
  border: none;
  width: 100%;
}

/* ========== 抢单池样式 ========== */
.pool-card {
  border-left: 6rpx solid #4F8EF7;
}

/* ========== 「一眼看到钱」金额块（抢单池 / 他站外派共用） ========== */
/* 放在卡片最上面（标题行之下、商品行之前）：抢单决策的第一信息是钱，不是商品名 */
.fee-box {
  padding: 14rpx 16rpx;
  background: #FFF9EC;
  border: 2rpx solid #FFE0A3;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.fee-row-main {
  display: flex;
  align-items: baseline;
}

.fee-label {
  font-size: 24rpx;
  color: #8A6D3B;
  flex-shrink: 0;
}

.fee-amount {
  font-size: 40rpx;
  font-weight: 600;
  color: #E65100;
  margin-left: 12rpx;
}

.fee-detail {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
}

.fee-detail-item {
  font-size: 22rpx;
  color: #8A6D3B;
  margin-right: 20rpx;
}

.fee-source {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.fee-source-label {
  font-size: 22rpx;
  color: #8A6D3B;
  flex-shrink: 0;
}

.fee-source-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 结算去向：整句由后端下发（settleNote），前端只负责显示 */
.fee-settle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2E7D32;
  line-height: 1.5;
}

/* 押金/桶权益风险提示（文案由后端下发 crossStationRiskNote，前端原样展示、不改写） */
.risk-box {
  display: flex;
  flex-direction: column;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFD591;
  border-radius: 10rpx;
}

.risk-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #AD6800;
  margin-bottom: 6rpx;
}

.risk-text {
  font-size: 22rpx;
  color: #874D00;
  line-height: 1.5;
}

.pool-product-info {
  padding: 12rpx 16rpx;
  background: #f7f8fb;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.pool-product-label {
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

.pool-product-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.pool-match-info {
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.match-label {
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

.match-name {
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* 商品匹配标签 */
.match-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.match-full {
  background: #E8F5E9;
  color: #2E7D32;
}

.match-partial {
  background: #FFF8E1;
  color: #F57F17;
}

.match-none {
  background: #FFEBEE;
  color: #C62828;
}

/* 抢单池状态标签 */
.status-pool {
  background: #E3F2FD;
  color: #1976D2;
}

/* ========== 外派追踪样式 ========== */
.dispatch-card {
  border-left: 6rpx solid #FF9800;
}

.status-dispatch {
  background: #FFF3E0;
  color: #E65100;
}

.dispatch-status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  background: #FFF8E1;
  color: #F57F17;
}

.dispatch-accepted {
  background: #E8F5E9;
  color: #2E7D32;
}

.dispatch-rejected {
  background: #FFEBEE;
  color: #C62828;
}

.dispatch-completed {
  background: #E8F5E9;
  color: #2E7D32;
}

.dispatch-info {
  padding: 12rpx 16rpx;
  background: #f7f8fb;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.dispatch-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.dispatch-label {
  color: #888888;
}

.dispatch-value {
  color: #333333;
  font-weight: 500;
}

/* ========== 退回待确认样式 ========== */
.return-card {
  border-left: 6rpx solid #FF9500;
}

.status-return {
  background: #FFF3E0;
  color: #E8590C;
}

/* ========== 他站外派样式 ========== */
.incoming-card {
  border-left: 6rpx solid #007AFF;
}

.status-incoming {
  background: #E7F1FF;
  color: #007AFF;
}

/* ========== tag-row ========== */
.tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  flex: 1;
}

/* ========== 其他待办（首页顶部，只列不在本页 tab 里的项） ==========
   [2026-09-19 收敛] 原先是 15 项分三级带分组标题的大卡，现在只留 8 项、**不分级标题**。
   `.todo-item-on` 标的是"**这个计数非零**"（wxml 绑的是 `hasCount`），**不是等级** ——
   卡里 8 项全是 P1/P2，一项 P0 都没有；P0 只体现在「首页」tab 红点上（走 `p0Total`）。
   ⚠️ 别再加回 `.todo-group` / `.todo-group-title` / `.todo-item-p0` 那几条 ——
      它们是给"三级分组"用的，那套结构已经去掉（要恢复三级显示时再从 git 历史取）。
*/
.todo-card {
  margin: 16rpx 20rpx 4rpx;
  padding: 22rpx 20rpx 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.todo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.todo-hint {
  font-size: 22rpx;
  color: #8a9099;
}

.todo-row {
  display: flex;
  flex-wrap: wrap;
}

.todo-item {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.todo-count {
  font-size: 40rpx;
  font-weight: 600;
  color: #a3a8b0;
}

/* 非零 = 有东西要办，转红（0 保持灰：显示但不着色，站长一眼能分出今天有没有事） */
.todo-item-on .todo-count {
  color: #d4380d;
}

.todo-label {
  font-size: 22rpx;
  color: #4e5969;
  margin-top: 6rpx;
  text-align: center;
}

/* 金额只有"逾期应收"那一项有（服务端只给有金额含义的项下发 amount） */
.todo-amount {
  font-size: 20rpx;
  color: #d4380d;
  margin-top: 4rpx;
}

