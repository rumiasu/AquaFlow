.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }

/* 页签（员工 / 绑定申请）。与本站其他多页签页同款：下划线式，不占两行 */
.tabs { display: flex; border-bottom: 1rpx solid var(--border-color); margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--text-secondary); position: relative; }
.tab.tab-on { color: var(--primary-color); font-weight: 600; }
.tab.tab-on::after { content: ''; position: absolute; left: 50%; bottom: -1rpx; transform: translateX(-50%); width: 48rpx; height: 4rpx; border-radius: 2rpx; background: var(--primary-color); }
.tab-count { font-size: 22rpx; margin-left: 6rpx; color: var(--text-secondary); }
.tab-badge { color: var(--error-color); }

.hint { font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; padding: 0 4rpx 20rpx; }
.empty-hint { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--text-secondary); }

.toolbar { margin-bottom: 20rpx; }
.btn-add { width: 100%; padding: 20rpx; background: var(--primary-gradient); color: #fff; border: none; border-radius: var(--radius-round); font-size: 28rpx; font-weight: 600; }
.btn-add::after { border: none; }

.search-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; background: var(--bg-card); border-radius: 40rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.search-btn { background: var(--primary-gradient); color: #fff; border-radius: 40rpx; padding: 0 32rpx; display: flex; align-items: center; font-size: 28rpx; }

.filter-chips { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.chip { font-size: 26rpx; color: var(--text-secondary); padding: 10rpx 28rpx; border-radius: 30rpx; background: var(--bg-card); }
.chip.active { color: #fff; background: var(--primary-gradient); }

.staff-card { background: var(--bg-card); border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm); display: flex; align-items: flex-start; gap: 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; color: #fff; font-size: 36rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-blue { background: var(--primary-color); }
.staff-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.name-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.staff-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.badge { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 20rpx; color: #fff; }
.badge.role { background: var(--primary-color); }
.badge.on { background: var(--success-color); }
.badge.off { background: var(--text-secondary); }
.badge.unbind { background: var(--error-color); }
.staff-phone { font-size: 26rpx; color: var(--text-secondary); }
.staff-phone.muted { color: var(--text-placeholder); }
.staff-note { font-size: 24rpx; color: var(--text-secondary); }
.card-actions { display: flex; flex-direction: column; gap: 12rpx; flex-shrink: 0; }
/* 卡片动作统一口径：主操作实心主色，次操作描边，危险操作红色描边 */
.btn-profile { padding: 14rpx 28rpx; background: transparent; color: var(--primary-color); border: 1rpx solid var(--primary-color); border-radius: var(--radius-round); font-size: 26rpx; }
.btn-profile::after { border: none; }
.btn-detach { padding: 14rpx 28rpx; background: transparent; color: var(--error-color); border: 1rpx solid var(--error-color); border-radius: var(--radius-round); font-size: 26rpx; }
.btn-detach::after { border: none; }
/* 站长行没有「解除」按钮，用一行灰字说明原因（不渲染任何东西会让站长以为界面坏了） */
.self-note { font-size: 22rpx; color: var(--text-placeholder); text-align: center; line-height: 1.5; }
.btn-approve { padding: 14rpx 28rpx; background: var(--primary-gradient); color: #fff; border: none; border-radius: var(--radius-round); font-size: 26rpx; }
.btn-approve::after { border: none; }
.btn-approve[disabled] { opacity: 0.45; }
.btn-reject { padding: 14rpx 28rpx; background: transparent; color: var(--text-regular); border: 1rpx solid var(--border-color); border-radius: var(--radius-round); font-size: 26rpx; }
.btn-reject::after { border: none; }
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 1000; }
.modal-content { background: var(--bg-card); border-radius: 24rpx 24rpx 0 0; padding: 32rpx; width: 100%; }
.modal-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); text-align: center; margin-bottom: 24rpx; }
.modal-input { width: 100%; padding: 20rpx; border: 2rpx solid var(--border-color); border-radius: 12rpx; font-size: 28rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.modal-hint { font-size: 24rpx; color: var(--text-secondary); text-align: center; margin-bottom: 24rpx; display: block; }
.btn-submit { width: 100%; padding: 20rpx; background: var(--primary-gradient); color: #fff; border: none; border-radius: var(--radius-round); font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.btn-submit::after { border: none; }
.btn-cancel { width: 100%; padding: 20rpx; background: var(--bg-gray); color: var(--text-secondary); border: none; border-radius: var(--radius-round); font-size: 28rpx; }
.btn-cancel::after { border: none; }
