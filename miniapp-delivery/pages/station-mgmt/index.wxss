.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx 24rpx 48rpx; }

/*
  分区（[2026-09-26] 三列彩色宫格 → 行列表，分组名见 docs/design/29 §5）：
  **区标题带蓝色左竖条，竖条之下就是这个分区的全部条目**。
  分区之间靠 `margin` 拉开距离，不再用横线 —— 横线会把"分区"读成"两段式划分"。
  ⚠️ 五个分区**统一用这一种标题**（原先「现场数据」那套居中分隔线已删）：五组现在是同一层级
     的目录，用两套标题反而让人以为"经营数据"是另一个页面。
*/
.group { margin-bottom: 24rpx; }
.group-head { display: flex; align-items: center; padding: 20rpx 4rpx 16rpx; }
.group-bar {
  width: 6rpx; height: 30rpx; border-radius: 3rpx;
  background: var(--primary-color); margin-right: 14rpx;
}
.group-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); letter-spacing: 1rpx; }

/* 一组入口共用一张卡，卡内行间用细线分隔（§6：有共同语义的一组才包卡，卡内用分隔线） */
.entry-card {
  background: var(--bg-card); border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm); overflow: hidden;
}
/* 行高 ≥ 88rpx（§6：列表行不小于 ~88rpx），按压反馈用底色而非位移 */
.entry-row {
  display: flex; align-items: center; padding: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.entry-row:last-child { border-bottom: none; }
.entry-row:active { background: var(--bg-gray); }
.entry-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.entry-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
/* 辅助说明用 --text-regular 而非 --text-secondary：后者是"灰色占位"（§6 规定不承载规则内容） */
.entry-desc { font-size: 24rpx; color: var(--text-regular); margin-top: 6rpx; line-height: 1.4; }
.entry-arrow { font-size: 32rpx; color: var(--text-secondary); margin-left: 16rpx; }

/* 入口徽标（红点计数）：用于 应收账款 / 退桶审批 / 业务待办与退出 等待办计数提示 */
.entry-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  background: var(--error-color);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.entry-unknown { color:var(--text-secondary); font-size:22rpx; white-space:nowrap; }
.badge-error { margin:16rpx 24rpx; padding:20rpx; background:var(--warning-bg); color:var(--warning-color); font-size:26rpx; }
