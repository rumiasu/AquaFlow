.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }

/* 口径说明：讲清"这里是什么、这里能做什么" */
.hint {
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.fb-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.who {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.time { font-size: 22rpx; color: var(--text-placeholder); }

/* 分类标签：文字就是后端字段原文，颜色只做视觉区分，不参与逻辑判断 */
.category {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--primary-bg);
  color: var(--primary-color);
  margin-bottom: 12rpx;
}

.content {
  display: block;
  font-size: 25rpx;
  color: var(--text-regular);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.card-foot {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.foot-item { font-size: 22rpx; color: var(--text-secondary); }
.foot-item.muted { color: var(--text-placeholder); }

/* 四种状态（加载中 / 失败 / 空 / 有数据）共用容器，但文案由 js 分派，样式不表达数据是否存在 */
.state { text-align: center; padding: 100rpx 24rpx; }
.state-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.state-msg {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #d32f2f;
  line-height: 1.6;
  word-break: break-all;
}
.state-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-placeholder);
  line-height: 1.6;
}
.state.error { padding-top: 80rpx; }

.retry-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 26rpx;
}

/* .empty 保留给"权限不足"分支（它不该长得像"没有数据"，用同一个居中文案块即可） */
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }
