.container {
  padding-bottom: 130rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 水桶提示 */
.barrel-tip {
  display: flex;
  align-items: center;
  background-color: rgba(217, 119, 6, 0.06);
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(217, 119, 6, 0.15);
}

.barrel-tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.barrel-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--warning-color);
}

.barrel-tip-text .highlight {
  font-weight: 700;
  color: var(--warning-color);
}

.section {
  background-color: #fff;
  margin: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--warning-color);
}

/* 商品信息 */
.product-section {
  display: flex;
  align-items: center;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-gray);
  margin-right: 24rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--price-color);
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: var(--price-color);
  font-weight: 700;
}

/* 地址卡片 */
.address-card {
  display: flex;
  align-items: center;
}

.address-info {
  flex: 1;
}

.address-top {
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.address-phone {
  font-size: 26rpx;
  color: var(--text-regular);
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.address-empty {
  flex: 1;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.address-arrow {
  color: var(--text-placeholder);
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* 数量 */
.quantity-row {
  display: flex;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-btn text {
  font-size: 36rpx;
  color: var(--text-primary);
  line-height: 1;
}

.qty-input {
  width: 100rpx;
  height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 16rpx;
  color: var(--text-primary);
}

.quantity-tip {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 备注 */
.note-input {
  width: 100%;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(15, 23, 42, 0.06);
  z-index: 100;
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--price-color);
}

.total-price .price-symbol {
  font-size: 26rpx;
}

.submit-btn {
  width: 260rpx;
  height: 80rpx;
  background: var(--primary-gradient);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

.submit-btn.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}

/* 超额弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-content.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-secondary);
  padding: 0 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.exceed-warn {
  display: flex;
  align-items: flex-start;
  background-color: rgba(217, 119, 6, 0.06);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.warn-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.warn-text {
  font-size: 26rpx;
  color: var(--warning-color);
  line-height: 1.6;
}

.warn-text .highlight {
  color: var(--warning-color);
  font-weight: 700;
}

.cost-detail {
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.cost-label {
  font-size: 26rpx;
  color: var(--text-regular);
}

.cost-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.cost-value.deposit {
  color: var(--warning-color);
}

.cost-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
}

.cost-total .cost-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.cost-total .cost-value.total {
  font-size: 32rpx;
  color: var(--price-color);
  font-weight: 700;
}

.exceed-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background-color: var(--bg-gray);
  color: var(--text-regular);
}

.modal-btn.confirm {
  background: var(--primary-gradient);
  color: #fff;
}
