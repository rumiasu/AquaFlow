.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: #fff;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.2);
}

.user-info {
  flex: 1;
}

.user-nick-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.role-chip {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}
.role-chip.role-manager {
  background: rgba(255, 193, 7, 0.95);
  color: var(--text-regular);
}
.role-chip.role-delivery {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.bind-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bind-status.bind-ok {
  margin-top: 10rpx;
  color: #ffffff;
}

.bind-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--error-bg);
  flex-shrink: 0;
}
.bind-dot.bind-BOUND { background: var(--success-color); }
.bind-dot.bind-PENDING { background: var(--af-text-secondary); }
.bind-dot.bind-REJECTED { background: var(--error-color); }
.bind-dot.bind-PENDING_UNBIND { background: var(--af-text-secondary); }
.bind-dot.bind-UNBOUND { background: var(--text-placeholder); }

.bind-text {
  /* 24rpx=12px 低于原关键文本≥14逻辑px（G04-roles-stations 绑定前提）；别改回 24rpx。 */
  font-size: 28rpx;
  color: var(--text-regular);
}

.arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  padding-left: 16rpx;
}

.manager-entry-card {
  margin-top: 24rpx;
  background: var(--primary-bg);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.manager-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}


.manager-entry-text {
  display: flex;
  flex-direction: column;
}
.manager-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color);
}
.manager-entry-desc {
  font-size: 24rpx;
  color: var(--text-regular);
  margin-top: 6rpx;
}

.manager-entry-arrow {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
  padding: 12rpx 24rpx;
  background: rgba(255, 213, 79, 0.18);
  border-radius: 999rpx;
}

/* 配送员绑定操作卡 */
.bind-action-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: none;
  position: relative;
  z-index: 1;
  border: 1rpx solid var(--border-color);
}

.bind-info-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--primary-bg);
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.bind-info-line.bind-info-warning { background: var(--bg-gray); border-left:4rpx solid var(--af-text-secondary); }
.bind-info-line.bind-info-wait { background: var(--bg-gray); border-left:4rpx solid var(--af-text-secondary); }
.bind-info-line.bind-info-danger { background: var(--error-bg); }
.bind-info-line.bind-info-none { background: var(--bg-gray); }

.bind-info-label {
  /* 26rpx=13px 低于原关键文本≥14逻辑px（G04-roles-stations 当前查看站/下单站）；别改回 26rpx。 */
  font-size: 28rpx;
  color: var(--text-regular);
}
.bind-info-value {
  /* 同上：当前站名为原关键字段，须≥14逻辑px。 */
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}
.bind-info-warning .bind-info-value { color: var(--af-text-secondary); }
.bind-info-wait .bind-info-value { color: var(--af-text-secondary); }
.bind-info-danger .bind-info-value { color: var(--error-color); }
.bind-info-none .bind-info-value { color: var(--text-regular); }

.bind-actions-row {
  display: flex;
  gap: 16rpx;
}

.bind-action-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 14px;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
}
.bind-action-btn::after { border: none; }

.bind-action-blue {
  background: var(--primary-gradient);
  color: #ffffff;
}
.bind-action-gray {
  background: var(--bg-gray);
  color: var(--text-regular);
}

.stats-card {
  background: var(--bg-card);
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: none;
  padding: 32rpx 24rpx;
  border: 1rpx solid var(--border-color);
}

.stats-row {
  display: flex;
  align-items: center;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: block;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 「未填成本」（缺成本，见 _decorateProfit）与"有异常"用同一个警示色 ——
   两者都表示"这个数别按 0 理解"。正常态不套这个类：满屏红字会让真正需要看的那一格失去信号。
   **只管颜色，不改字号**。 */
.stats-value.stats-warn {
  color: var(--error-color);
}

/* 金额格专用：三格里它是唯一可能到 5 位数的（¥12345.67），40rpx 会挤出格子。
   nowrap 是兜底 —— 宁可让金额格窄一点也不要在数字中间换行（"¥123\n45.67" 会被读错）。 */
.stats-value.stats-money {
  font-size: 32rpx;
  white-space: normal;
  overflow-wrap: anywhere;
}

/* 第三格的第二行（欠桶 N 户）：比 label 更弱，且**自己可点**（catchtap）——
   一格两数时必须让两个目标各自可点，否则用户点哪都是同一个页面。 */
.stats-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  /* 比 --text-secondary(var(--text-secondary)) 再浅一档：它是同一格里的次要数字，不该与 label 抢注意力。
     app.wxss 没有这一档变量，故写死色值（别引不存在的 --text-tertiary）。 */
  color: var(--text-regular);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-light);
}

/* 站长 section card */
.section-card {
  background: #ffffff;
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.section-link {
  font-size: 24rpx;
  color: var(--primary-color);
}
/* 标题行右侧那一簇（[2026-09-26 Wave1 轨道 G]「员工」改成可折叠后加的）：
   摘要文字 + 展开/收起 + 「更多 ›」三者一行，别各自换行把标题挤掉。 */
.section-head-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 「配送员 N · 待审批 M」——**折叠时也必须在**（AGENTS §8.22：看不见 ≠ 没有） */
.staff-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.section-toggle {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary-color);
}

.station-info-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.station-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}
.station-address {
  font-size: 26rpx;
  color: var(--text-regular);
}
.station-phone {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.station-info-empty {
  padding: 20rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
/* [2026-09-26 Wave1 轨道 G] 原 `.station-edit`（「编辑资料 ›」蓝色链接）随入口一起去掉，
   换成一行**不可点**的灰字提示：本页只留水站摘要，改资料走「水站管理 → 水站资料」。
   ⚠️ 别再把它改成可点跳转 —— 那正好把刚收掉的重复入口加回来。 */
.station-edit-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 员工入口（2026-09-19 IA 重组）：本页保留完整的「配送员管理 / 绑定申请」列表与原地操作，
   站长端 pages/station-mgmt/staff/ 是更全的那一份（多了搜索、筛选、画像、新增），
   两边数据同源，标题行的「更多 ›」跳过去。 */
.staff-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 4rpx;
}
.staff-entry-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.staff-entry-arrow {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 管理 Tab */
.mgmt-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border-light);
  margin-bottom: 20rpx;
}
.mgmt-tab {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
.mgmt-tab.active {
  color: var(--primary-color);
  font-weight: 700;
}
.mgmt-tab.active::after {
  content: '';
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: -2rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary-color);
}

.tab-count {
  display: inline-block;
  min-width: 32rpx;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: var(--border-color);
  color: var(--text-regular);
  margin-left: 8rpx;
}
.tab-count.tab-badge {
  background: var(--error-color);
  color: #ffffff;
}

.mgmt-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
.mgmt-empty-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}
/* 折叠态那一行（[2026-09-26 Wave1 轨道 G]）：有待审批时点名条数，
   与标题行的 `.staff-summary` 一起保证"收起来也看得见有几条要办"。 */
.staff-folded-hint {
  padding: 8rpx 0 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.staff-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  flex-wrap: wrap;
}
.staff-item:last-child { border-bottom: none; }
.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.staff-avatar.staff-avatar-blue { background: var(--primary-color); }
.staff-info {
  flex: 1;
  min-width: 160rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow-wrap: anywhere;
}
.staff-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.staff-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}
.staff-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.staff-remove-btn {
  flex-shrink: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 14px;
  padding: 10rpx 26rpx;
  line-height: 1.4;
  background: var(--error-bg);
  color: var(--error-color);
}
.staff-remove-btn::after { border: none; }
/* 站长行没有「解除」按钮，用一行灰字说明原因（不渲染任何东西会让站长以为界面坏了） */
.staff-self-note {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-placeholder);
  padding: 10rpx 12rpx;
}
.staff-action-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.staff-btn {
  border: none;
  border-radius: 999rpx;
  font-size: 14px;
  padding: 8rpx 22rpx;
  line-height: 1.4;
}
.staff-btn::after { border: none; }
.staff-btn-green {
  background: var(--success-bg);
  color: var(--primary-color);
}
.staff-btn-gray {
  background: var(--bg-gray);
  color: var(--text-regular);
}
.menu-list {
  background: var(--bg-card);
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: none;
  overflow: hidden;
  border: 1rpx solid var(--border-color);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 112rpx;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}


.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.logout-btn {
  margin: 0 24rpx;
  padding: 28rpx;
  text-align: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}

.logout-btn text {
  font-size: 14px;
  color: var(--error-color);
}

.login-tip {
  margin: 48rpx 24rpx;
  text-align: center;
}

.login-tip-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 32rpx;
}

.btn-login {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 14px;
  font-weight: 600;
  padding: 24rpx 48rpx;
}

.btn-login::after {
  border: none;
}

.btn-login-secondary {
  background: var(--primary-gradient);
  margin-top: 20rpx;
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.bind-action-btn, .btn-login, .staff-btn, .staff-remove-btn { height: auto; min-height: 44px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.staff-action-col { flex-direction: row; flex-wrap: wrap; width: 100%; }
.staff-action-col button:not(.af-action):not(.af-choice) { flex: 1; }
.user-info, .manager-entry-text { min-width: 0; overflow-wrap: anywhere; }
.section-head-right { flex-wrap: wrap; gap: 16rpx; }
.section-toggle, .section-link { min-height: 96rpx; display: inline-flex; align-items: center; }
.role-chip { border-radius: 8rpx; }
.stats-item { min-width: 0; }
.logout-btn { min-height: 44px; box-sizing: border-box; }

/* 白底身份区不沿用旧深色页头的白字。 */
.role-chip.role-delivery { background: var(--primary-bg); color: var(--primary-color); }
.role-chip.role-manager { background: var(--bg-color); color: var(--text-primary); }
.arrow { color: var(--text-secondary); }
.manager-entry-arrow { background: transparent; border-radius: 8rpx; }
.manager-entry-desc { font-size: 26rpx; line-height: 1.6; }

.station-info-link {min-height:48px;padding:12rpx 8rpx;border-radius:12rpx;}
.station-entry-pressed {opacity:.75;background:rgba(0,100,180,.08);}

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .menu-list { padding: 0 16px; } .b2-menu-entry, .b2-feature-entry { gap: 12px; justify-content: space-between; border-bottom: 1px solid var(--af-border); } .b2-feature-icon { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--af-border); border-radius: 8px; color: var(--af-primary); font-size: 17px; } .staff-action-col { display: flex; gap: 8px; flex-wrap: wrap; } .bind-actions-row { display: flex; justify-content: flex-end; } .b2-logout { margin: 24px auto; width: auto; } .mgmt-tabs { display: flex; gap: 8px; } .mgmt-tabs .af-choice { flex: 1; }

.b2-feature-group { margin: 16px; display: flex; flex-direction: column; gap: 8px; }
.b2-feature-group .b2-feature-entry { border: 0; }
.b2-line-document { width: 20px; height: 25px; border: 1.5px solid var(--af-primary); border-radius: 3px; box-sizing: border-box; padding: 5px 4px; }
.b2-line-document view { height: 1.5px; margin-bottom: 4px; background: var(--af-primary); }
.b2-line-clock { position: relative; width: 24px; height: 24px; border: 1.5px solid var(--af-primary); border-radius: 50%; box-sizing: border-box; }
.b2-clock-hand { position: absolute; left: 10px; top: 4px; width: 6px; height: 8px; border-left: 1.5px solid var(--af-primary); border-bottom: 1.5px solid var(--af-primary); }

.role-chip.role-manager, .role-chip.role-delivery { background: var(--af-soft); color: var(--af-strong); border-radius: 6px; border: 1px solid var(--af-border); }
.bind-status.bind-ok { color: var(--af-text-secondary); }
.manager-entry-card { border-color: var(--af-border); border-radius: 10px; box-shadow: none; }
.manager-entry-title { font-size: 16px; line-height: 24px; font-weight: 600; }
.manager-entry-desc { font-size: 12px; line-height: 18px; color: var(--af-text-secondary); }

/* User decision: a single compact workbench entry in manager Mine; original handler is unchanged. */
.manager-entry-card.v2-manager-entry { display:flex; align-items:center; gap:12px; min-height:56px; padding:12px 16px; margin:12px 16px; border:1px solid var(--af2-line); border-radius:12px; background:#FFFFFF; }
.v2-manager-entry .manager-entry-title { flex:1; min-width:0; color:var(--af2-ink); font-size:16px; line-height:24px; font-weight:600; overflow-wrap:anywhere; }
.v2-manager-entry .manager-entry-arrow { color:var(--af2-primary); font-size:22px; line-height:28px; }

.manager-entry-card.v2-manager-entry { background:var(--af2-surface-current); border-color:var(--af2-surface-current); }

/* Astra26 D11: identity, business assets and navigation keep different density. */
.b2-d11{background:var(--af2-page);color:var(--af2-ink)}
.header{padding:16px 16px 12px;background:var(--af2-top);border:0}
.user-row{gap:12px;min-height:56px}
.avatar{width:48px;height:48px;margin:0;border:0;border-radius:16px;background:#FFFFFF}
.nickname{font-size:20px;line-height:28px;color:var(--af2-ink)}
.bind-text{font-size:14px;line-height:22px;color:var(--af2-muted)}
.role-chip{font-size:12px;line-height:18px}
.manager-entry-card.v2-manager-entry{box-sizing:border-box;min-height:56px;margin:12px 0 0;padding:10px 12px;background:#F9FBFC;border-color:var(--af2-line)}
.stats-card{margin:16px;padding:12px;background:#FFFFFF;border:1px solid var(--af2-line);border-radius:16px;box-shadow:none}
.stats-row{gap:8px;align-items:stretch}
.stats-divider{display:none}
.stats-item{flex:1;min-width:0;padding:4px;border-radius:10px;box-sizing:border-box}
.stats-item.v2-money-stat{background:transparent;color:var(--af2-ink)}
.stats-value{font-size:22px;line-height:30px;white-space:normal;overflow-wrap:anywhere;word-break:break-all}
.stats-label,.stats-sub{font-size:13px;line-height:20px;white-space:normal}
.stats-sub{min-height:44px;display:flex;align-items:center;justify-content:center}
.section-card,.bind-action-card{margin:16px;border:1px solid var(--af2-line);border-radius:16px;box-shadow:none;background:#FFFFFF}
.section-title{font-size:16px;line-height:24px}
.b2-feature-group{margin:16px;gap:10px}
.b2-feature-entry{min-height:64px;background:#FFFFFF;border:1px solid var(--af2-line);border-radius:14px;padding:12px}
.b2-feature-icon{width:40px;height:40px;border:0;border-radius:10px;background:var(--af2-surface-neutral)}
.v2-money-entry{background:var(--af2-surface-money);border-color:var(--af2-surface-money)}
.v2-money-entry .b2-feature-icon{background:rgba(255,255,255,.55)}
.menu-list{margin:16px;padding:0 16px;border:1px solid var(--af2-line);border-radius:14px;background:#FFFFFF}
.b2-menu-entry{min-height:52px;padding-left:0;padding-right:0}
.menu-text{font-size:15px;line-height:23px}
@media(max-width:340px){.stats-row{gap:4px}.stats-item{padding-left:2px;padding-right:2px}.stats-value{font-size:22px}}

/* Astra33: personal delivery shortcuts precede low-frequency station management. */
.user-nick-wrap { flex-wrap:wrap; gap:8px; }
.role-chip.role-manager,.role-chip.role-delivery { display:inline-flex; align-items:center; box-sizing:border-box; min-height:24px; margin:0; padding:1px 8px; border:1px solid var(--af2-line); border-radius:6px; font-size:13px; line-height:20px; }
.role-chip.role-manager { background:var(--af2-surface-neutral); color:var(--af2-ink); }
.role-chip.role-delivery { background:var(--af2-surface-current); color:var(--af2-primary); }
.stats-heading { display:block; margin:4px 4px 10px; font-size:15px; line-height:23px; font-weight:600; color:var(--af2-ink); }
.stats-item.role-stat-current { background:transparent; }
.stats-item.role-stat-physical { background:transparent; }
.role-stat-current .stats-value { color:var(--af2-ink); }
.role-stat-physical .stats-value:not(.stats-warn) { color:var(--af2-ink); }
.personal-shortcuts { margin:16px; }
.personal-shortcuts-heading { display:block; margin:0 0 8px; font-size:15px; line-height:23px; font-weight:600; color:var(--af2-ink); }
.personal-shortcuts-grid { display:flex; flex-wrap:wrap; gap:8px; }
.personal-shortcut { display:flex; flex:1 1 104px; flex-direction:row; align-items:center; justify-content:center; gap:6px; min-width:104px; min-height:56px; padding:8px 6px; box-sizing:border-box; border-radius:12px; }
.personal-shortcut text { font-size:15px; line-height:23px; text-align:center; white-space:normal; overflow-wrap:anywhere; }
.personal-shortcut-money { background:#F9FBFC; color:var(--af2-ink); }
.personal-shortcut-physical { background:#F9FBFC; color:var(--af2-ink); }
.personal-shortcut-history { background:#F9FBFC; color:var(--af2-ink); }
.personal-history-icon { width:20px; height:20px; border-color:var(--af2-muted); }
.personal-history-icon .b2-clock-hand { left:8px; top:3px; width:5px; height:7px; border-color:var(--af2-muted); }
.bind-action-card.bind-action-compact { display:flex; flex-wrap:wrap; align-items:center; gap:4px 12px; padding:4px 12px; }
.bind-action-compact .bind-info-line { flex:1 1 140px; min-width:0; margin:0; padding:0; background:transparent; gap:4px 8px; flex-wrap:wrap; }
.bind-action-compact .bind-info-label,.bind-action-compact .bind-info-value { font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.bind-action-compact .bind-actions-row { flex:0 1 auto; min-width:0; margin:0; }
.bind-action-compact .af-action { min-height:44px; margin:0; }


/* The custom tab bar is 100rpx + 1rpx border + safe area; reserve it once. */
.container.custom-tabbar-page.b2-d11 { box-sizing:border-box; padding-bottom:calc(101rpx + 16px + env(safe-area-inset-bottom)); }
.stats-heading { margin:0 0 8px; }
.stats-value { color:var(--af2-ink); margin-bottom:4px; }
.stats-row { flex-wrap:wrap; }
.stats-row .stats-item { flex:1 1 80px; }
.manager-stats-row .stats-item { flex:1 1 120px; }
.mine-risk-summary { display:flex; flex-wrap:wrap; gap:4px 12px; padding-top:8px; margin-top:8px; border-top:1px solid var(--af2-line); }
.mine-risk-entry { box-sizing:border-box; display:flex; flex:1 1 120px; align-items:center; gap:6px; min-width:0; min-height:44px; font-size:13px; line-height:20px; color:var(--af2-ink); }
.mine-risk-entry icon { flex:none; }
.mine-risk-count { margin-left:auto; min-width:0; overflow-wrap:anywhere; }
.mine-risk-arrow { flex:none; color:var(--af2-primary); }
.personal-shortcut icon,.personal-history-icon { flex:none; }
.section-card { padding:12px; }
.mine-station-card .section-header { margin-bottom:6px; }
.mine-station-card .section-title { font-size:14px; line-height:22px; }
.mine-station-card .station-info-link { min-height:44px; padding:0; gap:4px; }
.mine-station-title { display:flex; align-items:baseline; gap:10px; min-width:0; }
.mine-station-title .station-name { flex:1; min-width:0; font-size:16px; line-height:24px; color:var(--af2-ink); overflow-wrap:anywhere; }
.mine-station-title .station-edit-hint { flex:none; margin:0; font-size:13px; line-height:20px; color:var(--af2-primary); }
.mine-station-detail { display:flex; flex-wrap:wrap; gap:2px 12px; align-items:baseline; min-width:0; }
.mine-station-detail .station-address { flex:1 1 160px; min-width:0; font-size:13px; line-height:20px; overflow-wrap:anywhere; }
.mine-station-detail .station-phone { font-size:13px; line-height:20px; color:var(--af2-muted); overflow-wrap:anywhere; }

.b2-menu-entry { gap:10px; }
.b2-menu-entry icon { flex:none; }
.b2-menu-entry .menu-text { flex:1; min-width:0; }
.b2-logout { box-sizing:border-box; display:flex; align-items:center; justify-content:center; width:160px; min-height:48px; margin:20px auto; padding:8px 20px; color:#5D6B7D; background:#FFFFFF; border:1px solid #7C8A9C; border-radius:8px; }
.personal-shortcut { background:#FFFFFF; border:1px solid #DDE5EF; }
.stats-card { background:#EAF2FF; }
