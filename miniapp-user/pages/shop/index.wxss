.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 品牌头 */
.brand-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  padding: 48rpx 40rpx;
  text-align: center;
}

.brand-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 24rpx;
}

.brand-login {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.9);
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 56rpx;
}

.brand-login text {
  color: #4facfe;
  font-size: 24rpx;
  font-weight: 600;
}

/* 搜索栏 */
.search-bar {
  padding: 24rpx;
  background-color: #fff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

/* 区块 */
.section {
  background-color: #fff;
  margin: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 产品网格 */
.product-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.owned-tag {
  background-color: #f6ffed;
  color: #52c41a;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #b7eb8f;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.product-note {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff4d4f;
}

.price-value {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.buy-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 32rpx;
  background-color: #4facfe;
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
}

.buy-btn.login-required {
  background-color: #999;
}
