<!-- 站长端「水票档位」：给本站**某款水**挂价目表（10 张 / 20 张 / 100 张各卖多少钱），
     外加一个站级的「统一折扣」（买多少张打几折，价格按各款水自己的价现算）。
     规格见 docs/design/19 与 docs/design/26 §26.11。均价由服务端算并快照，本页只展示服务端返回的值。 -->
<view class="page">
  <view class="settings-section-nav"><button wx:for="{{settingsSections}}" wx:key="target" data-target="{{item.target}}" disabled="{{!productId && item.target !== 'ticket-products'}}" bindtap="onSettingsSection" class="af-choice b3-on-settings-section" hover-class="af-action--pressed"><view class="af-choice__face">{{item.label}}</view></button></view>


  <view class="card" wx:if="{{ticketReadinessText || ticketReadinessError}}"><text>{{ticketReadinessText || ticketReadinessError}}</text><button wx:if="{{ticketReadinessError}}" bindtap="refreshTicketReadiness" class="af-action af-action--quiet b3-refresh-ticket-readiness" hover-class="af-action--pressed"><view class="af-action__face">重新核对水票准备</view></button></view>
  <view class="card" id="ticket-products">
    <view class="title-line"><view class="card-title">水票售价</view><help-tip title="水票售价" text="这里设置本站票价，不是客户持券账或购买记录。商品套餐按本站与商品设置；需要单张购买时可设置1张套餐。统一折扣按各款水自己的水票价折算；商品挂过自己的档位时，以该商品档位为准。" /></view>
    <view class="scope-switch">
      <button class="af-choice b3-on-open-product-picker {{!isUnified ? 'af-choice--selected' : ''}}" disabled="{{saving}}" bindtap="onOpenProductPicker" hover-class="af-action--pressed"><view class="af-choice__face">商品套餐</view></button>
      <button class="af-choice b3-on-open-unified {{isUnified ? 'af-choice--selected' : ''}}" disabled="{{saving}}" bindtap="onOpenUnified" hover-class="af-action--pressed"><view class="af-choice__face">站级统一折扣</view></button>
    </view>
    <block wx:if="{{!isUnified}}">
      <text class="scope-label">适用商品</text>
      <button class="af-entry af-entry--two-line b3-on-open-product-picker" bindtap="onOpenProductPicker" disabled="{{saving}}" hover-class="af-action--pressed"><image class="product-thumb" wx:if="{{productImage && !productImageFailed}}" src="{{productImage}}" mode="aspectFill" binderror="onProductImageError" data-id="{{productId}}" />
        <view class="product-thumb thumb-fallback" wx:else>水</view>
        <view class="product-identity"><text class="product-name">{{productName || '选择商品'}}</text><text class="product-spec" wx:if="{{productSpec}}">{{productSpec}}</text></view>
        <text class="change-product">{{productId ? '更换' : '选择'}} ›</text></button>
    </block>
    <view class="hint" wx:else>设置范围：本站统一折扣。按张数设置折扣，价格按各款水的票价折算。</view>
    <view class="hint warning" wx:if="{{productSelectionError}}">{{productSelectionError}}</view>
    <view class="hint warning" wx:if="{{productLoadError}}">{{productLoadError}}<button class="af-action af-action--quiet b3-load-products" bindtap="loadProducts" disabled="{{productsLoading || saving}}" hover-class="af-action--pressed"><view class="af-action__face">重新加载商品</view></button></view>
    <view class="compact-state" wx:elif="{{productsLoading}}">正在读取商品…</view>
    <view class="compact-state" wx:elif="{{!products.length}}">本站还没有上架商品，可先设置站级统一折扣。</view>
  </view>

  <block wx:if="{{productId}}">
    <view id="ticket-tiers"></view>
    <view class="hint warning" wx:if="{{packageLoadError && !productSelectionError}}">{{packageLoadError}}<button class="af-action af-action--quiet b3-load-packages" bindtap="loadPackages" disabled="{{loading || saving}}" hover-class="af-action--pressed"><view class="af-action__face">重新加载档位</view></button></view>
    <view class="compact-state" wx:elif="{{loading}}">正在读取档位…</view>
    <!-- ===== 统一折扣列表 ===== -->
    <view class="card" wx:if="{{isUnified}}">
      <view class="card-title">本站统一折扣档（{{discounts.length}} 个）</view>
      <view class="empty" wx:if="{{!loading && !packageLoadError && !discounts.length}}">
        尚未设置统一折扣档，可在下方新增。
      </view>
      <view class="row" wx:for="{{discounts}}" wx:key="id">
        <view class="row-main">
          <view class="row-between">
            <text class="row-title">{{item.qty}} 张 · {{item.discountText}}</text>
          </view>
          <text class="row-sub">
            {{item.title ? item.title + ' · ' : ''}}{{item.statusText}}
          </text>
        </view>
        <view class="actions">
          <button class="af-action af-action--quiet b3-on-edit-tier" bindtap="onEditTier" data-id="{{item.id}}" disabled="{{saving || loading || packageLoadError}}" hover-class="af-action--pressed"><view class="af-action__face">编辑</view></button>
          <button class="af-action af-action--secondary b3-on-toggle-status" bindtap="onToggleStatus" data-id="{{item.id}}" disabled="{{saving || loading || (!isUnified && (productsLoading || productLoadError || productSelectionError)) || packageLoadError}}" hover-class="af-action--pressed">{{item.status === 1 ? '停用' : '启用'}}</button>
          <button class="af-action af-action--danger-quiet b3-on-delete" bindtap="onDelete" data-id="{{item.id}}" disabled="{{saving || loading || (!isUnified && (productsLoading || productLoadError || productSelectionError)) || packageLoadError}}" hover-class="af-action--pressed">删除</button>
        </view>
      </view>

    </view>

    <!-- ===== 某款水的定制档位列表 ===== -->
    <view class="card" wx:if="{{!isUnified}}">
      <view class="card-title">本站该商品的档位（{{packages.length}} 个）</view>
      <view class="empty" wx:if="{{!loading && !packageLoadError && !packages.length}}">尚未设置套餐，可在下方新增。</view>
      <view class="row" wx:for="{{packages}}" wx:key="id">
        <view class="row-main">
          <view class="row-between">
            <text class="row-title">{{item.qty}} 张 · ¥{{item.price}}</text>
            <text class="row-amount">每张 ¥{{item.unitPrice}}</text>
          </view>
          <text class="row-sub">
            {{item.title ? item.title + ' · ' : ''}}{{item.statusText}}
            <text wx:if="{{item.saveText}}"> · {{item.saveText}}</text>
          </text>
        </view>
        <view class="actions">
          <button class="af-action af-action--quiet b3-on-edit-tier" bindtap="onEditTier" data-id="{{item.id}}" disabled="{{saving || loading || packageLoadError}}" hover-class="af-action--pressed"><view class="af-action__face">编辑</view></button>
          <button class="af-action af-action--secondary b3-on-toggle-status" bindtap="onToggleStatus" data-id="{{item.id}}" disabled="{{saving || loading || (!isUnified && (productsLoading || productLoadError || productSelectionError)) || packageLoadError}}" hover-class="af-action--pressed">{{item.status === 1 ? '下架' : '上架'}}</button>
          <button class="af-action af-action--danger-quiet b3-on-delete" bindtap="onDelete" data-id="{{item.id}}" disabled="{{saving || loading || (!isUnified && (productsLoading || productLoadError || productSelectionError)) || packageLoadError}}" hover-class="af-action--pressed">删除</button>
        </view>
      </view>

    </view>

    <!-- 平台预设档：只给统一折扣用（普通商品的档位是"这款水的价目表"，与站级折扣无关）。
         点一下只填表单、不保存 —— 站长按自己的经营情况改完再存。 -->
    <view class="card" wx:if="{{isUnified}}">
      <button class="af-action af-action--quiet b3-on-toggle-presets" bindtap="onTogglePresets" hover-class="af-action--pressed"><view class="af-action__face">{{presetsExpanded ? '收起建议折扣' : '查看建议折扣'}}</view></button><block wx:if="{{presetsExpanded || !discounts.length}}">
      <block wx:if="{{presets.length}}">
        <view class="preset-row">
          <view class="af-choice b3-on-apply-preset" wx:for="{{presets}}" wx:key="qty"
                bindtap="onApplyPreset" data-id="{{item.qty}}"><view class="af-choice__face"><text class="preset-qty">{{item.qty}} 张</text>
            <text class="preset-price">{{item.discountText}}</text>
            <text class="preset-sub">按各款水的价折算</text></view></view>
        </view>
        <view class="hint">
          平台给的是建议折扣，改完点下面的「保存」才生效。
        </view>
      </block>
      <view class="empty" wx:else>暂时取不到预设，直接填张数与折扣也可以。</view></block>
    </view>

    <view class="card" id="ticket-edit">
      <button class="af-action af-action--quiet b3-on-toggle-tier-editor" bindtap="onToggleTierEditor" hover-class="af-action--pressed"><view class="af-action__face">{{editingTierId ? '编辑现有档位' : '新增档位'}} · {{!editorCollapsed && (editorExpanded || formDirty || (!packages.length && !discounts.length)) ? '收起保留输入' : formDirty ? '继续填写草稿' : '展开'}}</view></button><view wx:if="{{!editorCollapsed && (editorExpanded || formDirty || (!packages.length && !discounts.length))}}">
      <view class="field quantity-field">
        <view class="quantity-label"><text class="field-label">张数</text><text class="field-note">1–5000 张，每次 1 张</text></view>
        <integer-stepper value="{{form.qty}}" min="{{1}}" max="{{5000}}" step="{{1}}" label="档位张数" placeholder="如 10" disabled="{{saving}}" bind:change="onQtyChange" />
        <text class="field-error" wx:if="{{qtyError && !form.qty}}">{{qtyError}}</text>
      </view>
      <!-- 统一折扣：填**折扣**，不填价；普通商品：填这一档的总价 -->
      <view class="field" wx:if="{{isUnified}}">
        <text class="field-label">折扣</text>
        <input class="field-input" disabled="{{saving}}" confirm-type="done" bindconfirm="hideKeyboard" type="digit" value="{{form.discount}}"
               bindinput="onInput" data-field="discount" placeholder="9.5 折就填 9.5" />
      </view>
      <view class="field" wx:else>
        <text class="field-label">总价</text>
        <input class="field-input" disabled="{{saving}}" confirm-type="done" bindconfirm="hideKeyboard" type="digit" value="{{form.price}}"
               bindinput="onInput" data-field="price" placeholder="这一组一共多少钱" />
      </view>
      <view class="field">
        <text class="field-label">名称（可选）</text>
        <input class="field-input" disabled="{{saving}}" confirm-type="done" bindconfirm="hideKeyboard" value="{{form.title}}"
               bindinput="onInput" data-field="title" placeholder="如 10 张 9.5 折" />
      </view>
      <view class="field">
        <text class="field-label">排序（可选）</text>
        <input class="field-input" disabled="{{saving}}" confirm-type="done" bindconfirm="hideKeyboard" type="number" value="{{form.sort}}"
               bindinput="onInput" data-field="sort" placeholder="数字越小越靠前" />
      </view>
      <text class="draft-note" wx:if="{{formDirty}}">草稿尚未保存，仅在本页保留；切换设置可选择保留或放弃。</text>
      <view class="layout-submit-group"><button class="af-action af-action--primary b3-on-save af-action--block" bindtap="onSave" disabled="{{saving || loading || (!isUnified && (productsLoading || productLoadError || productSelectionError)) || packageLoadError || qtyError}}" loading="{{saving}}" hover-class="af-action--pressed">
        {{saving ? '处理中…' : '保存' + (isUnified ? '折扣档' : '套餐')}}
      </button></view>
      <view class="hint">同一张数再保存会更新原档。{{isUnified ? '折扣按各款水的票价折算。' : '每张均价在保存后显示于上方列表。'}}</view></view>
    </view>

  </block>

  <view class="card">
    <button class="af-action af-action--quiet b3-on-help" bindtap="onHelp" hover-class="af-action--pressed"><view class="af-action__face">档位怎么定</view></button>
    <button class="af-entry b3-on-ticket-purchase-history" bindtap="onTicketPurchaseHistory" disabled="{{saving}}" hover-class="af-action--pressed"><view class="af-entry__body">查看购票收款记录 ›</view><text class="af-entry__arrow" aria-hidden="true">›</text></button>
  </view>

  <page-container show="{{showProductPicker}}" position="bottom" overlay="{{true}}" close-on-slide-down="{{false}}" duration="{{0}}" custom-style="height:84%;background:#fff;border-radius:16rpx 16rpx 0 0;overflow:hidden;" bindbeforeleave="onCloseProductPicker" bindclickoverlay="onCloseProductPicker">
    <view class="product-picker">
      <view class="picker-header"><text class="picker-title">选择适用商品</text><button class="af-action af-action--cancel b3-on-close-product-picker" bindtap="onCloseProductPicker" aria-label="关闭商品选择" hover-class="af-action--pressed">×</button></view>
      <view class="picker-search-wrap"><input class="product-search" value="{{productKeyword}}" bindinput="onProductSearch" bindconfirm="hideKeyboard" confirm-type="done" placeholder="搜索名称、品牌或规格" aria-label="搜索商品" /></view>
      <view class="picker-status" wx:if="{{productsLoading}}">正在读取商品…</view>
      <view class="picker-status warning" wx:elif="{{productLoadError}}">{{productLoadError}}<button class="af-action af-action--quiet b3-load-products" bindtap="loadProducts" hover-class="af-action--pressed"><view class="af-action__face">重新加载商品</view></button></view>
      <view class="picker-status" wx:elif="{{!products.length}}">本站还没有上架商品。</view>
      <view class="picker-status" wx:elif="{{!visibleProducts.length}}">没有匹配商品，请换个关键词。</view>
      <scroll-view class="picker-list" scroll-y="{{true}}" wx:else>
        <button class="af-choice b3-on-choose-product {{pendingProductId === item.id + '' ? 'option-selected' : ''}}" wx:for="{{visibleProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="onChooseProduct" aria-label="{{item.name}} {{item.spec}}" hover-class="af-action--pressed"><view class="af-choice__face"><image class="product-thumb" wx:if="{{item.imageUrl && !item.imageFailed}}" src="{{item.imageUrl}}" mode="aspectFill" binderror="onProductImageError" data-id="{{item.id}}" />
          <view class="product-thumb thumb-fallback" wx:else>水</view>
          <view class="product-identity"><text class="product-name">{{item.name}}</text><text class="product-spec" wx:if="{{item.spec}}">{{item.spec}}</text></view>
          <text class="selection-mark">{{pendingProductId === item.id + '' ? '已选' : '选择'}}</text></view></button>
      </scroll-view>
      <view class="picker-footer"><button class="af-action af-action--cancel b3-on-close-product-picker af-action--form" bindtap="onCloseProductPicker" hover-class="af-action--pressed">取消</button><button class="af-action af-action--secondary b3-on-confirm-product" bindtap="onConfirmProduct" disabled="{{productsLoading || productLoadError || !pendingProductId || saving}}" hover-class="af-action--pressed">确认选择</button></view>
    </view>
  </page-container>
</view>
<business-dialog id="business-dialog" />
