<view class="page">
  <!-- 加载失败（契约 A3）：**不走"下单成功/尽快配送"的兜底** ——
       订单可能压根不存在（比如上次那个把响应对象当订单号的旧版本），
       说"尽快配送"就是拿一个没查到的事实去承诺。 -->
  <view class="success-hero" wx:if="{{loadState === 'failed'}}">
    <view class="success-circle warn">
      <icon name="warn" size="56rpx" color="#FFFFFF" />
    </view>
    <text class="success-title">没查到这张订单</text>
    <text class="success-desc">{{loadErrorText}}</text>
    <view class="pay-btn retry" bindtap="onReload">
      <text class="pay-btn-text">重试查一次</text>
    </view>
  </view>

  <block wx:else>
  <!-- 结果区：标题与说明**按服务端事实**渲染（订单状态 + 支付状态），
       未知/已取消/已退款/没查完都不许落到"下单成功，尽快配送"。 -->
  <view class="success-hero">
    <view class="success-circle {{heroTone === 'warn' ? 'warn' : ''}}">
      <icon name="{{heroTone === 'warn' ? 'warn' : 'check'}}" size="56rpx" color="#FFFFFF" />
    </view>
    <text class="success-title">{{heroTitle}}</text>
    <text class="success-desc" wx:if="{{heroDesc}}">{{heroDesc}}</text>
    <!-- 付款说明由后端下发（payHint）：没有在线支付入口时，用它解释"钱怎么付"，
         而不是留一个点了没用的按钮。 -->
    <text class="success-desc" wx:if="{{payHint}}">{{payHint}}</text>
    <text class="success-desc" wx:if="{{statusText}}">订单状态：{{statusText}}</text>
  </view>

  <!-- 去支付按钮：条件一律用后端下发的 canRepay（= 当前渠道真的能付掉），
       不用 paymentStatus 自己判断。现金单（货到付款）不给在线支付入口。 -->
  <view class="pay-section" wx:if="{{canRepay}}">
    <view class="pay-btn" bindtap="onPayNow">
      <text class="pay-btn-text">{{repayLabel}} ¥{{orderAmount}}</text>
    </view>
  </view>

  <!-- 常用订单保存区 -->
  <view class="template-section" wx:if="{{!isDefaultSet}}">
    <view class="template-card" bindtap="onSaveTemplate">
      <view class="template-left">
        <view class="template-icon-wrap">
          <icon name="zap" size="40rpx" color="#2E4A68" />
        </view>
        <view class="template-text">
          <text class="template-title">存为常用订单</text>
          <text class="template-hint">下次一键复购，省时省力</text>
        </view>
      </view>
      <text class="template-arrow">›</text>
    </view>
  </view>

  <!-- 已保存提示 -->
  <view class="template-section" wx:if="{{isDefaultSet}}">
    <view class="template-card saved">
      <view class="template-left">
        <view class="template-icon-wrap saved">
          <icon name="check" size="40rpx" color="#10B981" />
        </view>
        <view class="template-text">
          <text class="template-title saved">已存为常用订单</text>
          <text class="template-hint">首页可一键复购</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="action-row">
      <view class="action-card primary" bindtap="onViewOrders">
        <view class="action-icon-wrap primary">
          <icon name="order" size="44rpx" color="#2E4A68" />
        </view>
        <view class="action-info">
          <text class="action-title">查看订单</text>
          <text class="action-desc">追踪配送状态</text>
        </view>
      </view>
      <view class="action-card secondary" bindtap="onBackHome">
        <view class="action-icon-wrap secondary">
          <icon name="home" size="44rpx" color="#475569" />
        </view>
        <view class="action-info">
          <text class="action-title">返回首页</text>
          <text class="action-desc">继续下单</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示：**不再承诺"30 分钟内送达"** ——
       没有任何时间来源（水站没配时效、系统也没有排班），写一个具体分钟数就是在替水站承诺。
       想知道进度就点上面的「查看订单」。 -->
  <view class="bottom-tip">
    <text class="tip-text">配送时间以水站安排为准，进度可在「查看订单」里看到</text>
  </view>
  </block>
</view>
