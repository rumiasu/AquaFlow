.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.notice-detail {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.notice-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.notice-content {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.8;
}
