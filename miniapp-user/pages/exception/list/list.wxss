.page-container {
  background: var(--bg-gray);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  padding: 40rpx 24rpx 24rpx;
  background: #2E4A68;
  border-radius: 0 0 32rpx 32rpx;
  color: #fff;
}
.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.exception-list {
  padding: 24rpx;
}

.exception-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.order-info { display: flex; flex-direction: column; gap: 4rpx; }
.order-id { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.time { font-size: 22rpx; color: var(--text-secondary); }
.status-badge {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-badge.warning { background: var(--error-bg); color: var(--error-color); }
.status-badge.primary { background: var(--primary-bg); color: var(--primary-color); }
.status-badge.success { background: var(--success-bg); color: var(--success-color); }
.status-badge.info { background: var(--primary-bg); color: var(--primary-color); }
.status-badge.default { background: var(--bg-gray); color: var(--text-secondary); }

.card-body { padding: 20rpx 24rpx; }
.info-row { display: flex; gap: 24rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.info-item { display: flex; align-items: center; gap: 8rpx; min-width: 180rpx; }
.label { font-size: 22rpx; color: var(--text-secondary); }
.value { font-size: 24rpx; font-weight: 500; color: var(--text-primary); }
.value.short { color: var(--error-color); font-weight: 600; }
.value.over { color: var(--success-color); font-weight: 600; }
.category-tag { background: var(--primary-bg); color: var(--primary-color); padding: 2rpx 12rpx; border-radius: 12rpx; font-size: 22rpx; }
.compensation-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: var(--success-bg);
  color: var(--success-color);
}

.card-footer { padding: 20rpx 24rpx; border-top: 1rpx solid var(--border-light); }
.progress-info { display: flex; align-items: center; gap: 0; }
.step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; }
.step-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--border-color); border: 2rpx solid #fff; box-shadow: 0 0 0 2rpx var(--border-color); transition: all 0.3s; }
.step.active .step-dot { background: var(--primary-color); box-shadow: 0 0 0 2rpx var(--primary-color); }
.step-text { margin-top: 8rpx; font-size: 20rpx; color: var(--text-secondary); white-space: nowrap; }
.step.active .step-text { color: var(--primary-color); font-weight: 500; }
.step-line { flex: 1; height: 2rpx; background: var(--border-color); margin: 0 -12rpx; }
.step-line.active { background: var(--primary-color); }

.status-badge { padding: 4rpx 16rpx; font-size: 22rpx; border-radius: 20rpx; font-weight: 500; }
.status-badge.warning { background: var(--error-bg); color: var(--error-color); }
.status-badge.primary { background: var(--primary-bg); color: var(--primary-color); }
.status-badge.success { background: var(--success-bg); color: var(--success-color); }
.status-badge.info { background: var(--primary-bg); color: var(--primary-color); }
.status-badge.default { background: var(--bg-gray); color: var(--text-secondary); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 24rpx;
  color: var(--text-secondary);
}
.empty-state image { width: 160rpx; height: 160rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.empty-subtext { font-size: 24rpx; color: var(--text-placeholder); }

.load-more { display: flex; justify-content: center; align-items: center; padding: 40rpx 0; }
.loading-spinner { width: 40rpx; height: 40rpx; border: 2rpx solid var(--border-light); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.load-more-text { font-size: 26rpx; color: var(--text-secondary); }
.safe-area { height: 80rpx; }