<!-- 站长端「利润」：进货成本 + 期间报表。规格见 docs/design/20 §2。
     用词 [2026-09-26 产品口径]：面向站长写「利润」不写"毛利"（本仓用户是小水站，"毛利"是财务术语）。
     金额与文案全部用服务端下发的值（含 profitText / profitRateText / costBasisNote），本页不做利润算术。 -->
<view class="page af2-page finance-page gross-profit-page">

  <block wx:if="{{report}}">
    <!-- 合计 -->
    <view class="hero af2-tone-panel af2-tone-money {{!showProfit ? 'hero-income-only' : ''}} {{splitIncome ? 'hero-split-income' : ''}}">
      <text class="hero-period" wx:if="{{report.from && report.to}}">{{report.from}} 至 {{report.to}}</text>
      <!-- 2026-11-10：销售收入已含服务费，旧 totalProfit 未计服务费，和首屏收入对不上。此处沿用明细的销售净利。 -->
      <view class="hero-item hero-profit" wx:if="{{showProfit}}"><icon name="chart" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" />
        <text class="hero-label">销售净利</text>
        <text class="hero-num">{{profitView.netProfitText}}</text>
      </view>
      <view class="hero-item hero-income">
        <text class="hero-label">{{splitIncome ? '订单水费及服务费' : '销售收入'}}</text>
        <text class="hero-num">{{splitIncome ? profitView.orderIncomeText : profitView.totalIncomeText}}</text>
      </view>
      <view class="hero-item hero-ticket" wx:if="{{splitIncome}}">
        <text class="hero-label">购票实收</text>
        <text class="hero-num">{{profitView.ticketRevenueText}}</text>
      </view>
      <view class="hero-item hero-cost" wx:if="{{costComplete}}">
        <text class="hero-label">出库成本</text>
        <text class="hero-num">{{profitView.totalCostText}}</text>
      </view>
      <view class="hero-item hero-wage">
        <text class="hero-label">计件工钱</text>
        <text class="hero-num">{{profitView.wageText}}</text>
      </view>
    </view>

    <text class="income-only-note profit-unavailable-note" wx:if="{{profitUnavailableReason}}">{{profitUnavailableReason}}</text>
  </block>

  <!-- 期间 -->
  <view class="card period-card">
    <view class="period-toggle" bindtap="onTogglePeriod" role="button" aria-label="统计期间，{{periodExpanded ? '收起' : '调整统计期间'}}">
      <view class="period-toggle-heading"><text class="card-title">统计期间</text><text class="period-action">{{periodExpanded ? '收起' : '调整'}}</text></view>
      <!-- 已读取期间在顶部金额卡显示一次；还没读到报表时才在此展示所选范围。 -->
      <text class="period-current" wx:if="{{!report || !report.from || !report.to}}">{{from || '本月 1 号'}} 至 {{to || '今天'}}</text>
    </view>
    <block wx:if="{{periodExpanded}}">
    <picker mode="date" value="{{from}}" bindchange="onDate" data-field="from">
      <view class="picker">开始：{{from || '本月 1 号'}}</view>
    </picker>
    <picker mode="date" value="{{to}}" bindchange="onDate" data-field="to">
      <view class="picker">结束：{{to || '今天'}}</view>
    </picker>
    <view class="chips">
      <view class="af-choice {{quickRange === 1 ? 'af-choice--selected' : ''}}" bindtap="onQuickRange" data-days="1"><text class="af-choice__face">今日</text></view>
      <view class="af-choice {{quickRange === 0 ? 'af-choice--selected' : ''}}" bindtap="onQuickRange" data-days="0"><text class="af-choice__face">本月</text></view>
      <view class="af-choice {{quickRange === 7 ? 'af-choice--selected' : ''}}" bindtap="onQuickRange" data-days="7"><text class="af-choice__face">近7天</text></view>
      <view class="af-choice {{quickRange === 30 ? 'af-choice--selected' : ''}}" bindtap="onQuickRange" data-days="30"><text class="af-choice__face">近30天</text></view>
    </view>
    <text class="period-note">含结束日</text>
    </block>
    <!-- [2026-09-24] 原文"服务端按「结束日 + 1 天」做上界"是实现口径（对应 AGENTS §8.19），
         站长只需要知道"结束日当天算在内、今天的销量不会漏"这一条结论。 -->

  </view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>

  <view class="ui-state" wx:if="{{reportError}}"><text class="ui-state-title">本期经营数据加载失败</text><text class="ui-state-copy">{{reportError}}</text><button class="af-action af-action--quiet" bindtap="onRetryReport"><text class="af-action__face">重新读取报表</text></button></view>
  <block wx:if="{{report}}">
    <view class="af-entry analysis-entry" wx:if="{{showProfit && profitChart.length}}" bindtap="onToggleAmountComparison"><icon name="bill" size="22px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text class="af-entry__body">金额结构</text><text class="af-entry__arrow">{{amountComparisonExpanded ? '收起' : '查看 ›'}}</text></view>
    <view class="card profit-chart-card" wx:if="{{amountComparisonExpanded && showProfit && profitChart.length}}">
      <view class="card-title">本期金额结构</view>
      <block wx:if="{{profitChart.length}}">
        <view class="profit-chart-row" wx:for="{{profitChart}}" wx:key="key">
          <text class="profit-chart-label">{{item.label}}</text>
          <view class="profit-chart-track"><view class="profit-chart-bar chart-{{item.key}} {{item.negative ? 'chart-negative' : ''}}" style="width: {{item.width}}%;"></view></view>
          <text class="profit-chart-value">{{item.text}}</text>
        </view>
        <text class="profit-chart-note">条长按金额绝对值比较；负数以红色标示。</text>
      </block>
      <text class="profit-chart-note" wx:else>金额或成本待核实，暂不显示对比。</text>
    </view>

    <!-- 这里逐项展开首屏与金额结构的同一组金额。票款与履约的跨期选择见 design/16 §12。 -->
    <view class="card" wx:if="{{report.profitBasisNote}}">
      <view class="af-entry analysis-entry" bindtap="onToggleIncomeDetails"><icon name="bill" size="22px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text class="af-entry__body">{{showProfit ? '收入与销售净利' : '收入与成本明细'}}</text><text class="af-entry__arrow">{{incomeDetailsExpanded ? '收起' : '展开 ›'}}</text></view>
      <block wx:if="{{incomeDetailsExpanded}}">
      <view class="ledger-row">
        <text class="ledger-label">单数</text>
        <text class="ledger-value">{{profitView.orderCountText}} 单</text>
      </view>
      <!-- 购票实收与订单水费分列。兑票单单独支付的费用由后端计入下方服务费。 -->
      <view class="ledger-row">
        <text class="ledger-label">订单收入（水费）</text>
        <text class="ledger-value">{{profitView.orderRevenueText}}</text>
      </view>
      <view class="ledger-row">
        <text class="ledger-label">水票收入（买票实收）</text>
        <text class="ledger-value">{{profitView.ticketRevenueText}}</text>
      </view>
      <view class="ledger-row">
        <text class="ledger-label">配送费</text>
        <text class="ledger-value">{{profitView.deliveryFeeText}}</text>
      </view>
      <view class="ledger-row">
        <text class="ledger-label">楼层费</text>
        <text class="ledger-value">{{profitView.floorFeeText}}</text>
      </view>
      <view class="ledger-row ledger-strong" wx:if="{{!splitIncome}}">
        <text class="ledger-label">销售收入</text>
        <text class="ledger-value">{{profitView.totalIncomeText}}</text>
      </view>
      <view class="ledger-row ledger-strong" wx:else>
        <text class="ledger-label">订单水费及服务费</text>
        <text class="ledger-value">{{profitView.orderIncomeText}}</text>
      </view>
      <block wx:if="{{costComplete}}">
      <view class="ledger-row">
        <text class="ledger-label">{{splitIncome ? '出库成本' : '− 出库成本'}}</text>
        <text class="ledger-value">{{profitView.totalCostText}}</text>
      </view>
      </block>
      <view class="ledger-row">
        <text class="ledger-label">{{splitIncome ? '计件工钱' : '− 计件工钱'}}</text>
        <text class="ledger-value">{{profitView.wageText}}</text>
      </view>
      <view class="ledger-row ledger-strong" wx:if="{{showProfit}}">
        <text class="ledger-label">销售净利</text>
        <text class="ledger-value">{{profitView.netProfitText}}</text>
      </view>
      </block>
      <!--
        [2026-09-26 产品反馈"利润里太罗嗦了"] 这两段口径提示从"铺在屏幕上"改成**一行版**，
        完整解释（为什么一张水票单的利润是负的、工钱什么时候产生、人工调整为何不计入…）
        按统计范围、费用水票和成本风险分组收在页面底部，文字仍由服务端下发。
        ⚠️ 别把长文搬回这里，也别在前端 js 里抄一份口径。
      -->
    </view>

    <!-- 合作款独立于销售利润；摘要与折叠明细均直接展示服务端行。 -->
    <view class="card cooperation-card" wx:if="{{report.cooperation}}">
      <view class="finance-section-head"><icon name="wallet" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><view class="card-title">合作待交与待收</view></view>
      <text class="card-sub">合作款单独核对，不并入上方销售利润。</text>
      <view class="ledger-row" wx:for="{{cooperationView.summary}}" wx:key="key">
        <text class="ledger-label">{{item.label}}</text>
        <text class="ledger-value">{{item.amountText}}</text>
      </view>
      <view class="profit-help-group" wx:for="{{cooperationView.sections}}" wx:key="key">
        <view class="af-entry profit-help-toggle" bindtap="onToggleCooperationGroup" data-group="{{item.key}}" role="button" aria-label="{{item.title}}，{{item.expanded ? '收起' : '展开'}}">
          <text class="profit-help-title">{{item.title}}</text>
          <text class="profit-help-action">{{item.expanded ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{item.expanded}}">
          <view class="ledger-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="key">
            <text class="ledger-label">{{row.label}}</text>
            <text class="ledger-value">{{row.amountText}}</text>
          </view>
        </view>
      </view>
      <text class="profit-chart-note" wx:if="{{!cooperationView.summary.length && !cooperationView.sections.length}}">{{report.cooperation.scopeNote || '合作款数据待核实'}}</text>
    </view>

    <!-- 成本口径集中在页面底部的分组说明，避免与收入构成重复铺开。 -->

    <!-- 明细 -->
    <view class="card">
      <view class="card-title">按商品明细（{{report.items.length}} 项）</view>
      <view class="empty finance-empty" wx:if="{{!report.items.length}}"><icon name="chart" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text>该期间暂无销售记录</text></view>
      <view class="row" wx:for="{{report.items}}" wx:key="productId">
        <view class="row-main">
          <view class="row-between">
            <text class="row-title">{{item.productName}}</text>
            <!-- [2026-09-25 评审问题 6] 行收入用 revenueTotal = 订单水费 + 该商品本期购票实收
                 （票款在下面单独标一行）。用旧的 item.revenue 会让"用票兑出去的商品"显示成
                 "卖出 2、收入 0、利润负"，看起来像报表坏了 —— 钱其实在买票那一刻收过了。 -->
            <text class="row-amount">{{splitIncome ? '订单水费 ' + item.orderRevenueText : '收入 ' + item.revenueTotalText}}</text>
          </view>
          <text class="row-sub">
            卖出 {{item.soldQtyText}} · 出库成本 {{item.costAmountText}}
          </text>
          <text class="row-sub" wx:if="{{item.ticketRevenue > 0}}">
            购票实收 {{item.ticketRevenueText}}
          </text>
          <!-- 行利润的文案整句来自后端（缺成本那行是「未填成本，无法计算」）—— 前端只标警示色 -->
          <text class="row-sub {{item.profit === null ? 'row-warn' : ''}}" wx:if="{{showProfit}}">
            利润：{{item.profitText}}<text wx:if="{{item.profitRateText}}"> · 利润率 {{item.profitRateText}}</text>
          </text>
        </view>

      </view>
      <!-- 操作提示只留一处（上面「未填成本的商品」那张卡已说清「点商品名补录」）：
           同一句在两张卡里各写一遍，正是产品说的"太罗嗦"。 -->
    </view>
  </block>

  <view class="card profit-help-card" wx:if="{{report}}">
    <view class="af-entry profit-help-entry" bindtap="onToggleHelpVisible" role="button" aria-label="统计与计算说明，{{profitHelpVisible ? '收起' : '展开'}}">
      <text class="profit-help-entry-title">? 统计说明</text>
      <text class="profit-help-action">{{profitHelpVisible ? '收起' : '查看'}}</text>
    </view>
    <block wx:if="{{profitHelpVisible}}">
    <view class="profit-help-group" wx:for="{{profitHelpSections}}" wx:key="key">
      <view class="af-entry profit-help-toggle" bindtap="onToggleHelpGroup" data-group="{{item.key}}">
        <text class="profit-help-title">{{item.title}}</text>
        <text class="profit-help-action">{{item.expanded ? '收起' : '展开'}}</text>
      </view>
      <view class="profit-help-body" wx:if="{{item.expanded}}">
        <text class="profit-help-note" wx:for="{{item.notes}}" wx:for-item="note" wx:key="index">{{note}}</text>
      </view>
    </view>
    <view class="profit-help-all" wx:if="{{profitHelpSections.length}}" bindtap="onShowHelp">展开或收起全部说明</view>
    <view class="profit-help-all" wx:else bindtap="onShowHelp">查看利润说明</view>
    </block>
  </view>

</view>
<business-dialog id="business-dialog" />
