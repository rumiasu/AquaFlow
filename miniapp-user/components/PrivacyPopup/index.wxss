.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-dialog {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #1e40af;
  display: inline;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-btn.reject {
  background: #f5f5f5;
  color: #999;
}

.privacy-btn.agree {
  background: #1e40af;
  color: #fff;
}
