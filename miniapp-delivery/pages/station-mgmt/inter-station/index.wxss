/* 站长端「站间结算」台账（v67）。与 receivable / owed-barrels 页保持同一观感：
   一张卡 = 一笔，金额在右上，口径与状态用浅色小标签，动作按钮在底部。 */

.page {
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  background: var(--bg-gray);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 三个汇总数 ===== */
.sum-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sum-card {
  flex: 1;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx 12rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-card:last-child {
  margin-right: 0;
}

.sum-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.sum-value.receive {
  color: var(--success-color);
}

.sum-value.pay {
  color: #BD3328;
}

.sum-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.scope-note {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  padding: 0 6rpx 16rpx;
}

/* ===== 分区 ===== */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 6rpx 6rpx 12rpx;
}

.hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  padding: 8rpx 6rpx 12rpx;
}

/* ===== 卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-main {
  font-size: 28rpx;
  color: var(--text-primary);
}

.row-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.row-sub {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 0 10rpx 8rpx 0;
}

.sub-text {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.btn-outline-small {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  margin-left: 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--text-primary);
}

.btn-outline-small::after {
  border: none;
}

.btn-ok-small {
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  margin-left: 12rpx;
  border-radius: 10rpx;
  background: var(--primary-color);
  color: #ffffff;
}

.btn-ok-small::after {
  border: none;
}


/* 新责任面板沿原台账层次；长按钮换行，输入框不使用原生默认宽度。 */
.actions { flex-wrap: wrap; gap: 12rpx; }
.actions button { max-width: 100%; min-height: 76rpx; margin: 0; white-space: normal; word-break: break-all; line-height: 1.6; }
.aftercare-section { padding-top: 12rpx; }
.aftercare-section text { display: block; margin: 10rpx 0; font-size: 26rpx; line-height: 1.7; word-break: break-all; }
.aftercare-section .section-title { line-height: 1.6; word-break: break-all; }
.aftercare-section .card { border: 1rpx solid var(--border-color); }
.aftercare-section input, .aftercare-section textarea { display: block; box-sizing: border-box; width: 100%; margin: 18rpx 0; padding: 18rpx 20rpx; background: var(--bg-card); border: 1rpx solid var(--border-color); border-radius: 12rpx; color: var(--text-primary); font-size: 28rpx; line-height: 1.6; }
.aftercare-section input { height: 88rpx; }
.aftercare-section textarea { height: 200rpx; }
.aftercare-section button { min-height: 80rpx; margin: 16rpx 0; padding: 16rpx 20rpx; font-size: 26rpx; line-height: 1.6; white-space: normal; word-break: break-all; border-radius: 12rpx; color: var(--primary-color); background: var(--bg-card); border: 1rpx solid var(--border-color); }
.aftercare-section button[disabled] { color: var(--text-secondary); background: var(--bg-gray); }
.aftercare-section .actions button { margin: 0; }
.aftercare-section .aftercare-error { padding: 16rpx; border-radius: 12rpx; color: var(--error-color); background: var(--error-bg); }

/* 本页按账事实与办理动作排版；不改变金额、状态或办理资格。 */

.page { background: var(--bg-color); }
.sum-grid { flex-wrap: wrap; gap: 2rpx; padding: 20rpx; background: #fff; border-radius: 12rpx; }
.sum-card { border-radius: 0; min-width: 0; padding: 18rpx 4rpx; margin-right: 0; align-items: flex-start; word-break: break-all; }
.sum-label,.scope-note,.sub-text { font-size: 25rpx; color: var(--text-regular); line-height: 1.6; }
.card { border-radius: 10rpx; }.row { align-items: flex-start; gap: 14rpx; flex-wrap: wrap; }.row-main { min-width: 0; word-break: break-all; }.row-amount { margin-left: auto; font-size: 36rpx; word-break: break-all; }
.reversal-section { padding: 22rpx; background: var(--warning-bg); border-left: 6rpx solid var(--warning-color); border-radius: 8rpx; }
.actions { justify-content: flex-start; }.actions button { flex: 1 1 240rpx; }
.page button,.aftercare-section button { box-sizing: border-box; min-height: 88rpx; height: auto; max-width: 100%; padding: 20rpx; border-radius: 8rpx; font-size: 27rpx; line-height: 1.6; white-space: normal; word-break: break-all; }
.aftercare-section .card { padding: 24rpx 0; border: 0; border-top: 1rpx solid var(--border-color); border-radius: 0; background: transparent; }
.aftercare-section { background: #fff; padding: 24rpx; border-radius: 12rpx; }
.aftercare-section input,.aftercare-section textarea { background: var(--bg-color); border-radius: 8rpx; }
