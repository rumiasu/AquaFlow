# AquaFlow 后端必需的环境变量（复制为 .env 或直接在系统中配置）
# 注意：这些值一旦泄露，等同于把系统管理权交出去，禁止提交进仓库。
# 已被泄露的旧密钥请务必先去对应平台吊销并重新生成，不要直接复用。

# ---- JWT ----
# 签名密钥，长度 >= 32 位。泄露 = 任何人可伪造任意身份（含站长）的 token
JWT_SECRET=

# ---- 微信小程序 ----
# 微信公众平台 -> 开发管理 -> 开发设置
# 客户端小程序（miniapp-user，顾客）
WX_APP_ID=
WX_APP_SECRET=
# 员工端小程序（miniapp-delivery，站长 + 配送员）——与客户端是两个不同 appid。
# 不填只影响员工端微信登录（本地可用 dev-login），但生产必须配齐（prod 缺失即拒启）。
WX_STAFF_APP_ID=
WX_STAFF_APP_SECRET=

# ---- 腾讯云 COS ----
# 控制台 -> 访问管理 -> API 密钥管理
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/aquaflow?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- 其他 ----
# 生产环境必须显式配置实际前端域名，禁止使用 * 或 localhost
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# 开发登录后门开关：仅本地开发可设为 true，生产必须保持 false（接口本身已在 prod 环境移除）
# DEV_LOGIN_ENABLED=false

# ---- 告警（可选）----
# 系统故障告警的外部渠道。留空则只落 alert_log 表 + ERROR 日志（不是"告警没发生"）。
# 分级：系统故障→系统管理员（本渠道）；运营故障→水站站长（站长端 /api/manager/alerts 可查）。
#
# 不建群、直接到微信的推荐配法（Server酱）：
#   ALERT_SYSTEM_WEBHOOK=https://sctapi.ftqq.com/你的SendKey.send
#   ALERT_WEBHOOK_FORMAT=SERVERCHAN        # 消息落到微信「放糖服务号」，无需加群
# 建群场景（企业微信/钉钉群机器人，两者同格式，也是默认值）：
#   ALERT_SYSTEM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   ALERT_WEBHOOK_FORMAT=WECOM
# 自建接收端/其它中介：
#   ALERT_WEBHOOK_FORMAT=RAW               # 原样发 {"title","source","content","level"}
# ALERT_SYSTEM_WEBHOOK=
# ALERT_WEBHOOK_FORMAT=

# ---- 限流（可选）----
# 登录类端点（login / wx-login / wx-login-staff / dev-login / refresh / change-password）
# 的按 IP 固定窗口限流，默认每分钟 20 次。与按用户名锁定 [AQ-040] 正交，两层都要有。
# 多实例部署时必须改为集中式计数器（Redis），否则每个实例各限一份，等于放宽 N 倍。
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
