.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; padding-bottom: 140rpx; }

/* 顶部栏 */
.top-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.count-text { font-size: 26rpx; color: var(--text-secondary); }
.filter-tabs { display: flex; gap: 8rpx; }
.tab {
  font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 20rpx;
  background: var(--bg-card); color: #999;
}
.tab.active { background: var(--primary, #4F8EF7); color: #fff; }

/* product card */
.product-card {
  background: var(--bg-card); border-radius: 16rpx; margin-bottom: 20rpx;
  display: flex; overflow: hidden; position: relative;
}
.product-card:active { opacity: 0.85; }

.product-img {
  width: 200rpx; height: 200rpx; flex-shrink: 0; background: #f5f5f5;
}

.product-info {
  flex: 1; padding: 20rpx 24rpx; display: flex; flex-direction: column;
  justify-content: space-between; gap: 6rpx; min-width: 0;
}
.name-row { display: flex; align-items: center; justify-content: space-between; }
.product-name { font-size: 28rpx; font-weight: 600; color: #333; }
.product-brand { font-size: 22rpx; color: var(--text-secondary); }
.info-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.product-price { font-size: 32rpx; font-weight: 700; color: #f44336; }
.product-spec { font-size: 24rpx; color: var(--text-secondary); }
.product-deposit { font-size: 22rpx; color: var(--text-secondary); }

.tag-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-top: 4rpx; }
.stock-tag {
  font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 8rpx;
  background: #f5f5f5; color: #999;
}
.stock-tag.in { background: #e3f2fd; color: #1976d2; }
.stock-tag.out { background: #fce4ec; color: #c62828; }

.shelf-tag {
  font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 8rpx;
}
.shelf-tag.on { background: #e8f5e9; color: #4caf50; }
.shelf-tag.off { background: #fafafa; color: #9e9e9e; }

.ticket-tag {
  font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 8rpx;
  background: #fff3e0; color: #e65100;
}

.priority-tag {
  font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 8rpx;
  background: #f5f5f5; color: #999;
  transition: all 0.2s;
}

.priority-tag.on {
  background: #fff8e1; color: #f57f17;
  font-weight: 500;
}

.priority-tag:active {
  opacity: 0.7;
}

.status-tag { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 8rpx; }
.status-tag.on { background: #e8f5e9; color: #4caf50; }
.status-tag.off { background: #fafafa; color: #9e9e9e; }

.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

/* FAB 新增按钮 */
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--primary, #4F8EF7); color: #fff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 142, 247, 0.4);
  z-index: 50;
}
.fab:active { transform: scale(0.92); }
.fab-icon { font-size: 56rpx; font-weight: 300; line-height: 1; margin-top: -4rpx; }

/* modal */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal-content {
  background: #fff; border-radius: 24rpx; width: 620rpx; max-height: 85vh;
  padding: 40rpx; overflow-y: auto;
}
.modal-header { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 32rpx; }

.modal-img { display: flex; flex-direction: column; align-items: center; margin-bottom: 28rpx; }
.preview-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #f5f5f5; }
.img-upload-hint { font-size: 22rpx; color: var(--primary); margin-top: 8rpx; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.form-input {
  width: 100%; padding: 20rpx 24rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  font-size: 28rpx; box-sizing: border-box;
}
.form-picker { width: 100%; }
.picker-text {
  padding: 20rpx 24rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  font-size: 28rpx; color: #333;
}
.form-row { display: flex; gap: 20rpx; }
.form-group.half { flex: 1; min-width: 0; }

/* 开关区 */
.switch-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; margin-bottom: 8rpx; border-top: 1rpx solid #f0f0f0; border-bottom: 1rpx solid #f0f0f0;
}
.switch-item { display: flex; align-items: center; gap: 12rpx; }
.switch-label { font-size: 26rpx; color: #333; }

.modal-footer { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-cancel, .btn-save, .btn-delete {
  flex: 1; height: 88rpx; border-radius: 16rpx; font-size: 30rpx; border: none;
}
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-delete { background: #ffebee; color: #f44336; }
.btn-save { background: var(--primary, #4F8EF7); color: #fff; }
.btn-save[disabled] { opacity: 0.6; }
