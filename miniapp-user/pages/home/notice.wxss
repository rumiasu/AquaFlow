.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.notice-detail {
  background-color: #fff;
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
  word-break: break-all;
}

.notice-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.notice-content {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 2026-10-02：失败状态常驻，刷新失败时旧记录不能冒充本次结果。 */
.page-state { margin: 0 0 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; text-align: left; }
.page-state-text { display: block; font-size: 28rpx; color: var(--text-regular); line-height: 1.6; }
.page-state-error { color: var(--error-color); }
.page-state-retry { margin-top: 20rpx; font-size: 28rpx; color: #fff; background: var(--primary-color);
  min-height: 88rpx;
  line-height: 1.6;
  padding: 20rpx 28rpx;
}


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
.page-intro { padding: 4rpx 0 24rpx; }

/* 公告按原文阅读，不截断长标题或正文；原生导航继续负责顶部安全区。 */
.container { box-sizing: border-box; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.notice-content { font-size: 32rpx; line-height: 1.9; overflow-wrap: anywhere; }
.notice-title { overflow-wrap: anywhere; }
.notice-time, .notice-content-empty, .page-state-note { display: block; font-size: 28rpx; line-height: 1.7; color: var(--text-regular); word-break: break-all; }
.notice-content-empty { padding: 24rpx 0; }
.page-state-note { margin-top: 12rpx; }
.page-state-retry, .page-state-back { min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--radius-md); }
.page-state-back { margin-top: 16rpx; padding: 20rpx; font-size: 28rpx; line-height: 1.6; color: var(--text-regular); background: var(--bg-gray); }
.page-state-retry::after, .page-state-back::after { border: 0; }
