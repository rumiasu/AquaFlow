/* 辅助说明图形保持小，独立触控区为 88rpx；费用、后果与异常仍由页面常显。 */
.help-tip { flex-shrink: 0; display: inline-flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; vertical-align: middle; }
.help-tip-glyph { width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; border-radius: 50%; border: 1rpx solid var(--border-color); color: var(--text-regular); font-size: 26rpx; }
.help-tip-hover { background: var(--bg-gray); }
