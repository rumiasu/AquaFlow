<view class="container">
  <view class="grid">
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/dashboard/index">
      <text class="module-icon">📊</text>
      <text class="module-title">数据看板</text>
      <text class="module-desc">今日运营统计</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/orders/index">
      <text class="module-icon">📋</text>
      <text class="module-title">订单管理</text>
      <text class="module-desc">查看本站订单</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/customers/index">
      <text class="module-icon">👤</text>
      <text class="module-title">客户查询</text>
      <text class="module-desc">搜索本站客户</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/products/index">
      <text class="module-icon">💧</text>
      <text class="module-title">商品与库存</text>
      <text class="module-desc">选品上架、本站定价、库存流水</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/station-status/index">
      <text class="module-icon">📣</text>
      <text class="module-title">营业状态与公告</text>
      <text class="module-desc">休息/延迟、给顾客留言、发公告</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/place-order/index">
      <text class="module-icon">📞</text>
      <text class="module-title">代客下单</text>
      <text class="module-desc">电话叫水当场录单，桶的流动才入账</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/receivables/index">
      <text class="module-icon">🧾</text>
      <text class="module-title">应收账款</text>
      <text class="module-desc">待收款、账期、逾期提醒与核销</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/payroll/index">
      <text class="module-icon">💰</text>
      <text class="module-title">计件工资</text>
      <text class="module-desc">按桶计价、结算单、人工调整</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/ticket-packages/index">
      <text class="module-icon">🎫</text>
      <text class="module-title">水票档位</text>
      <text class="module-desc">10 张、20 张、100 张各卖多少钱</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/gross-profit/index">
      <text class="module-icon">📈</text>
      <text class="module-title">毛利报表</text>
      <text class="module-desc">进货成本、期间毛利、未填成本提示</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/delivery-config/index">
      <text class="module-icon">🚚</text>
      <text class="module-title">配送计费</text>
      <text class="module-desc">起送量、配送范围、运费、楼层费</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/barrel-return/index">
      <text class="module-icon">🔄</text>
      <text class="module-title">退桶审批</text>
      <text class="module-desc">审核客户退桶申请</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/owed-barrels/index">
      <text class="module-icon">⏳</text>
      <text class="module-title">欠桶台账</text>
      <text class="module-desc">谁欠桶、欠几个、欠了几天</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/barrel-exceptions/index">
      <text class="module-icon">🛠</text>
      <text class="module-title">桶异常</text>
      <text class="module-desc">回桶差异单、处理进度与桶损耗读数</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/alerts/index">
      <text class="module-icon">🔔</text>
      <text class="module-title">运营告警</text>
      <text class="module-desc">桶异常等待处置、补偿留痕</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/customer-feedback/index">
      <text class="module-icon">✉️</text>
      <text class="module-title">客户反馈</text>
      <text class="module-desc">顾客在小程序里报的问题（只读）</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/payments/index">
      <text class="module-icon">💰</text>
      <text class="module-title">待确认收款</text>
      <text class="module-desc">核对到账、确认订单收款与购票入账</text>
    </view>
    <view class="module-card" bindtap="onNavigate" data-url="/pages/station-mgmt/staff/index">
      <text class="module-icon">👥</text>
      <text class="module-title">员工管理</text>
      <text class="module-desc">管理配送员</text>
    </view>
  </view>
</view>
