.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 通用区块 */
.section {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: 12rpx;
  box-shadow: none;
  padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-lg);
  display: block;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.info-value {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
  flex: 1;
}

/* 「所属水站」缺名称时的重试入口（[2026-09-27 走查 D06]）：
   已绑定但名字没拉到时，说的是「名称暂未加载」+ 可点这一下补拉，不再写成「未分配」。 */
.info-retry {
  font-size: var(--font-sm);
  color: var(--primary-color);
  margin-left: 16rpx;
  flex-shrink: 0;
  min-height: 96rpx;
  display: flex;
  align-items: center;
}

/* 设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 112rpx;
  box-sizing: border-box;
}

.setting-row:last-child {
  border-bottom: none;
}

/* 带副标题的设置行（如「待办提醒」）：文字竖排、开关靠右 */
.setting-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.setting-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.setting-label {
  font-size: var(--font-md);
  color: var(--text-primary);
}

.setting-arrow {
  font-size: var(--font-lg);
  color: var(--text-secondary);
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: var(--spacing-xl) var(--spacing-lg);
}

.version-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.logout-btn { min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-size: 14px; color: var(--error-color); }
