/* 新建资产调整单。单位一律 rpx；.container / .card 沿用 app.wxss 既有类，不重复定义 */
.banner {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.6;
}
.banner.warn { background: var(--error-bg); border: 1rpx solid var(--error-bg); color: var(--error-color); }

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.field { padding: 16rpx 0; border-top: 1rpx solid var(--border-light); }
.field:first-of-type { border-top: none; }
.field-label { font-size: 26rpx; color: var(--text-regular); display: block; margin-bottom: 12rpx; }
.required { color: var(--error-color); margin-left: 6rpx; }

.picker-value,
.field-input,
.field-textarea {
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
}
.field-textarea { min-height: 160rpx; }
.picker-value .placeholder,
.field-input .placeholder { color: var(--text-placeholder); font-size: 26rpx; }

.field-hint { font-size: 24rpx; color: var(--text-secondary); margin-top: 12rpx; line-height: 1.6; }
.field-link { font-size: 24rpx; color: var(--primary-color); margin-top: 14rpx; }

/* 欠桶方向：补记 / 核销 二选一（OVER_ADJUST 的 qty 是带符号增量，必须让站长明确选） */
.sign-row { display: flex; gap: 16rpx; }
.sign-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  background: #fff;
  font-size: 14px;
  color: var(--text-regular);
}
.sign-btn.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
  color: var(--primary-color);
  font-weight: 600;
}

/* 证据图 */
.evidence-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.evidence-item { position: relative; width: 160rpx; height: 160rpx; }
.evidence-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: var(--bg-gray); }
.evidence-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}
.evidence-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 试算结果 */
.preview-type { font-size: 26rpx; color: var(--primary-color); margin-bottom: 16rpx; }
.preview-head,
.preview-row { display: flex; align-items: center; padding: 14rpx 0; font-size: 26rpx; }
.preview-head { color: var(--text-secondary); font-size: 24rpx; border-bottom: 1rpx solid var(--border-light); }
.preview-row { border-bottom: 1rpx solid var(--border-light); }
.col { flex: 1; text-align: center; color: var(--text-primary); }
.col-name { flex: 1.2; text-align: left; color: var(--text-regular); }
.col.after { font-weight: 600; color: var(--primary-color); }
.preview-note {
  font-size: 23rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}
.preview-note.warn { background: var(--bg-gray); color: var(--warning-color); border-left:4rpx solid var(--warning-color); }

/* 底部操作 */
.footer { display: flex; gap: 20rpx; margin: 0 24rpx; }
.btn-half {
  flex: 1;
  height: 92rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}
.btn-half.ghost { background: #fff; color: var(--primary-color); border: 2rpx solid var(--primary-color); }
.btn-half.primary { background: var(--primary-gradient); color: #fff; font-weight: 600; }
.footer-tip {
  margin: 20rpx 24rpx 60rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
}

.denied {
  text-align: center;
  padding: 140rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 2026-10-06：搜索与结果整行可点，小屏允许身份信息换行。 */
.customer-search-row { display:flex; align-items:center; gap:16rpx; }
.customer-search-row input { flex:1; min-width:0; }
.customer-search-row button:not(.af-action):not(.af-choice):not(.af-entry) { flex-shrink:0; margin:0; }
.customer-option { display:flex; flex-direction:column; padding:24rpx 0; border-bottom:1rpx solid var(--primary-bg); overflow-wrap:anywhere; }
.customer-selected { padding:24rpx 0 12rpx; font-weight:600; overflow-wrap:anywhere; }
.customer-selector .field-hint { display:block; font-size:24rpx; line-height:1.6; color:var(--text-secondary); }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { box-sizing:border-box; }
.card { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.card-title { font-size:32rpx; line-height:1.5; border-left:0; padding-left:0; }
.field-label { font-size:30rpx; font-weight:600; }
.field-input,.picker-value { min-height:96rpx; font-size:30rpx; border-radius:10rpx; box-sizing:border-box; border:1rpx solid var(--border-color); }
.field-hint,.footer-tip,.preview-note { font-size:28rpx; line-height:1.6; color:var(--text-regular); }
.field-link { min-height:88rpx; display:flex; align-items:center; font-size:28rpx; }
.sign-row { flex-wrap:wrap; }
.sign-btn { min-width:240rpx; min-height: 44px; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:10rpx; }
.preview-head,.preview-row { font-size:28rpx; gap:12rpx; }
.col { min-width:0; overflow-wrap:anywhere; }
.btn-half { min-height: 44px; display:flex; align-items:center; justify-content:center; border-radius:10rpx; font-size: 14px; box-sizing:border-box; }
.footer { gap:16rpx; }
.footer-tip { padding-bottom:28rpx; }

.evidence-del { width:44px; height:44px; line-height:44px; top:-8px; right:-8px; z-index:1; }
.field-hint button:not(.af-action):not(.af-choice):not(.af-entry) { min-height:44px; height:auto; line-height:1.5; }

.product-toggle { min-height:44px; height:auto; line-height:1.5; white-space:normal; padding:20rpx; background:#fff; color:var(--primary-color); border:1rpx solid var(--border-color); }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .card { border-radius:14px; box-shadow:none; } .card-title { padding-bottom:12px; border-bottom:1px solid var(--af-border); } .preview-head,.preview-row { display:flex; align-items:center; gap:8px; } .preview-head { background:var(--af2-surface-neutral); color:var(--af2-ink-neutral); border-radius:8px; } .preview-row .after { color:var(--af2-strong); font-weight:600; } .evidence-row { gap:8px; }
