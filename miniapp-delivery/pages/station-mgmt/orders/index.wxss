.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }
.tab-bar { display: flex; background: var(--bg-card); border-radius: 16rpx; margin-bottom: 24rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--text-regular); }
.tab-item.active { color: var(--primary-color); font-weight: 600; background: var(--primary-bg); }
.tab-badge { display: inline-block; min-width: 32rpx; box-sizing: border-box; padding: 0 10rpx; margin-left: 8rpx; font-size: 20rpx; font-weight: 400; line-height: 32rpx; border-radius: 16rpx; background: var(--border-color); color: var(--text-secondary); vertical-align: middle; }
.tab-item.active .tab-badge { background: var(--primary-color); color: #fff; }
.order-card { background: var(--bg-card); border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.card-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.status-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; margin-right: 16rpx; }
.status-pending { background: var(--warning-bg); color: var(--warning-color); }
.status-delivering { background: var(--primary-bg); color: var(--primary-color); }
.status-completed { background: var(--success-bg); color: var(--success-color); }

.status-warning { background: var(--warning-bg); color: var(--warning-color); }
.status-cancelled { background: #F4EFE4; color: var(--text-secondary); }
.order-id { font-size: 26rpx; color: var(--text-secondary); flex: 1; }
.order-time { font-size: 22rpx; color: var(--text-secondary); }
.customer-info { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.customer-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.customer-phone { font-size: 26rpx; color: var(--text-secondary); }
.product-info { display: flex; justify-content: space-between; }
.product-name { font-size: 26rpx; color: var(--text-regular); }
.product-qty { font-size: 26rpx; color: var(--text-regular); }
.amount-info { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border-color); }
.amount-label { font-size: 24rpx; color: var(--text-secondary); }
.order-amount { font-size: 30rpx; font-weight: 600; color: var(--primary-color); }
.empty, .loading { text-align: center; color: var(--text-secondary); font-size: var(--font-md); padding-top: 120rpx; }
/* 跨站履约单：归并成一行（默认收起），点开看逐单明细。视觉上刻意与本站单区分（虚线边框） */
.cross-card { border: 1rpx dashed var(--border-color); border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; background: var(--bg-color); }
.cross-head { display: flex; align-items: baseline; justify-content: space-between; }
.cross-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.cross-amount { font-size: 28rpx; color: var(--text-primary); }
.cross-toggle { font-size: 24rpx; color: var(--text-secondary); }
.cross-sub { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 24rpx; color: var(--text-secondary); }
.cross-row { border-top: 1rpx solid var(--border-color); padding-top: 14rpx; margin-top: 14rpx; }
.cross-row-head { display: flex; align-items: center; }
.cross-row-body { display: flex; justify-content: space-between; margin-top: 8rpx; }
.cross-row-addr { margin-top: 6rpx; font-size: 24rpx; color: var(--text-secondary); }

.history-controls { margin:20rpx 0; padding:20rpx; background:#fff; border-radius:16rpx; }
.history-search-row,.history-date-row,.history-selected { display:flex; gap:16rpx; align-items:center; flex-wrap:wrap; }
.history-search-row input { flex:1; min-width:180rpx; height:76rpx; }
.history-search-row button { margin:0; flex-shrink:0; }
.history-date-row { margin-top:20rpx; font-size:24rpx; }
.history-date-row picker { padding:16rpx; background:var(--primary-bg); border-radius:12rpx; }
.history-customer-row { padding:20rpx 0; border-bottom:1rpx solid var(--primary-bg); }
.history-customer-row text { display:block; color:var(--text-secondary); font-size:24rpx; }
.history-selected { padding:16rpx 0; font-size:24rpx; }.history-selected text { color:var(--primary-color); }
.history-scope { font-size:24rpx; line-height:1.6; color:var(--text-secondary); margin-top:14rpx; }
.history-error { color:var(--warning-color); padding:20rpx 0; }.history-more { padding:28rpx; text-align:center; color:var(--primary-color); }
.history-tabs { display:flex; gap:20rpx; padding:20rpx 0; font-size:26rpx; }.history-tabs .active { color:var(--primary-color); font-weight:600; }
