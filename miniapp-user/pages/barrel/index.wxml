<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <block wx:else>
    <!-- [2026-09-20] 部分桶接口失败时的提示：没有它，失败渲染出来的「权益 0 · 占用 0」
         与"确实没有桶"长得一模一样（loadError 为空串时不渲染）。 -->
    <view class="load-error" wx:if="{{loadError}}">{{loadError}}</view>

    <!-- 当前水站：桶权益与押金按「客户 × 水站」隔离。不写清楚，客户换个站会以为桶/押金丢了。
         文案与样式照抄 pages/deposit/records（同一条提示条，保持一致）。 -->
    <view class="station-bar" wx:if="{{stationName}}">
      <text class="station-bar-name">{{stationName}}</text>
      <text class="station-bar-tip">桶与押金按水站独立，这里只显示该站的数据</text>
    </view>
    <view class="stats-card">
      <view class="stat-col">
        <text class="stat-label">{{summary.independentRights ? '用桶权益' : '持有桶'}}</text>
        <view class="stat-value-row">
          <text class="stat-number">{{summary.independentRights ? summary.rightBuckets : summary.heldBuckets}}</text>
          <text class="stat-unit">个</text>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col" bindtap="onDepositRecords">
        <!--
          「押金余额」不是「押金」也不是「可退押金」（docs/design/29 §7）：
          这个数是 customer_deposit_account.balance，回答"现在账上还有多少"，
          退桶能拿回多少要看退桶预览的「本次可退」（后端按押金条批次 FIFO 算），两者不是一个数。
          ⚠️ 也**不许**写成"现在即可退"—— 余额里有配送中桶的预收部分，当下退不出来。
        -->
        <text class="stat-label">押金余额</text>
        <view class="stat-value-row">
          <text class="stat-number deposit">¥{{summary.depositBalance}}</text>
        </view>
        <!-- 余额只回答"现在多少"，流水才回答"为什么变"（退桶/丢桶赔偿/调整都只在这里看得见） -->
        <text class="stat-link">押金流水 ›</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col">
        <text class="stat-label">欠桶</text>
        <view class="stat-value-row">
          <text class="stat-number owed">{{summary.owedBuckets}}</text>
          <text class="stat-unit">个</text>
        </view>
      </view>
    </view>

    <!-- 独立办理入口另起一行，避免窄屏挤占三列统计；显隐和办理事件保持同一入口。 -->
    <view class="rights-actions" wx:if="{{summary.independentRights}}">
      <button class="rights-purchase-btn" bindtap="onPurchaseRights">交桶押金（不含水）</button>
    </view>

    <view class="owed-tip" wx:if="{{summary.owedBuckets > 0}}">
      <text>欠桶 {{summary.owedBuckets}} 个：不影响下单；退桶前需先还清对应商品的欠桶</text>
    </view>

    <!-- 多还的桶寄在水站：over<0 是合法状态，以前被当成 0 完全不显示，
         于是顾客还了 3 个只拿走 1 个却看不出来，这是"我的桶呢"类咨询的直接来源 -->
    <view class="storage-tip" wx:if="{{summary.storageBuckets > 0 && !summary.independentRights}}">
      <text>另有 {{summary.storageBuckets}} 个空桶寄存在水站（您多还的桶，可随时取回或用于下次换水）</text>
    </view>

    <view class="section">
      <view class="section-header">
        <!--
          [2026-09-27 走查 C07 修] 原标题「长期桶资产（按商品聚合）」是**建模语言**
          （"资产"是表名口径："按商品聚合"是实现方式），顾客不需要知道系统怎么存的。
          顾客要回答的是"我有哪些桶、几个、能不能退" —— 换成「我的水桶」，一句人话。
          ⚠️ 只改标题与空态文案：分组口径（`customerBarrelAsset` 由后端下发）、
             数量与"押金 ¥X/桶"一律没动。
        -->
        <text class="section-title">我的水桶</text>
        <view class="return-btn-small" bindtap="onShowReturnModal" wx:if="{{maxReturnQty > 0}}">
          <text>申请退桶</text>
        </view>
      </view>

      <view class="bucket-list" wx:if="{{customerBarrelAsset.length > 0}}">
        <view class="bucket-item" wx:for="{{customerBarrelAsset}}" wx:key="productId">
          <view class="bucket-info">
            <view class="bucket-icon"><icon name="barrel" size="40rpx" color="#2E4A68" /></view>
            <view class="bucket-detail">
              <text class="bucket-id">{{item.productName}} {{item.productSpec}}</text>
              <text class="bucket-time" wx:if="{{!summary.independentRights}}">持有 {{item.heldTotalQty || 0}} 桶<text wx:if="{{item.inTransitQty > 0}}">（含配送中 {{item.inTransitQty}}）</text> / 欠桶 {{item.owedQty || 0}}</text>
              <text class="bucket-time" wx:if="{{summary.independentRights}}">实际在手 {{item.occupiedQty}} 桶 · 可用权益 {{item.availableRights}} 个</text>
            </view>
          </view>
          <view class="bucket-status">
            <text>押金 ¥{{item.deposit}}/桶</text>
          </view>
        </view>
      </view>

      <!-- 空态：原文「暂无长期桶资产」同样是建模语言；改成顾客视角的一句话 -->
      <empty wx:else text="还没有可退的水桶"></empty>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">水桶记录</text>
      </view>
      <view class="bucket-list" wx:if="{{records.length > 0}}">
        <view class="bucket-item" wx:for="{{records}}" wx:key="id">
          <view class="bucket-info">
            <view class="bucket-icon"><icon name="barrel" size="40rpx" color="#2E4A68" /></view>
            <view class="bucket-detail">
              <!-- ⚠️ BarrelRecord 没有 barrelNo 字段，原写法 item.barrelNo || ('桶号 #' + item.id)
                   永远走兜底分支，把流水主键当成"桶号"报给客户（假桶号）。
                   类型/数量/备注后端都已下发（typeText/quantity/note），照实展示即可。 -->
              <text class="bucket-id">{{item.typeText}}<text wx:if="{{item.quantity > 0}}"> · {{item.quantity}} 桶</text></text>
              <text class="bucket-time" wx:if="{{item.note}}">{{item.note}}</text>
              <text class="bucket-time" wx:if="{{item.createTime}}">{{item.createTime}}</text>
            </view>
          </view>
          <!-- statusText 只对退桶申请（type=2）有值，其余类型后端不下发（见 BarrelRecord.getStatusText） -->
          <view class="bucket-status status-{{item.status || 0}}" wx:if="{{item.statusText}}">
            <text>{{item.statusText}}</text>
          </view>
          <view wx:if="{{item.returnDetail}}">
            <text>{{item.returnDetail.pickupModeText}} · 应交回 {{item.returnDetail.requiredBarrels}} 桶 · 取桶费 ¥{{item.returnDetail.pickupFee}}</text>
            <button wx:if="{{item.returnDetail.status === 'APPROVED' && !item.returnDetail.customerConfirmedTime}}" data-id="{{item.id}}" bindtap="onReturnConfirm">确认批准的安排</button>
            <button wx:if="{{item.returnDetail.status === 'APPLIED' || item.returnDetail.status === 'APPROVED'}}" data-id="{{item.id}}" bindtap="onReturnWithdraw">撤回申请</button>
          </view>
        </view>
      </view>
      <empty wx:else text="暂无水桶记录"></empty>
    </view>

    <view class="info-card">
      <view class="info-row" wx:if="{{summary.depositPerBucket > 0}}">
        <text class="info-label">最近一次每桶押金</text>
        <text class="info-value">¥{{summary.depositPerBucket}}</text>
      </view>
      <view class="info-tip">
        <text>不同商品的押金不同，申请前可查看预计金额；水站确认收到空桶后再处理退款</text>
      </view>
    </view>

    <view class="eco-card">
      <view class="eco-content">
        <view class="eco-icon"><icon name="droplet" size="40rpx" color="#10B981" /></view>
        <view class="eco-text">
          <text class="eco-title">爱护水桶</text>
          <text class="eco-desc">水桶是可循环使用的资源，请妥善保管，避免暴晒和污染</text>
        </view>
      </view>
      <view class="eco-btn" bindtap="onEcoRuleTap">
        <text>了解回收规则</text>
      </view>
    </view>
  </block>

  <view class="modal-mask" wx:if="{{showReturnModal}}" bindtap="onCloseReturnModal"></view>
  <view class="modal-content {{showReturnModal ? 'show' : ''}}" catchtap="">
    <view class="modal-header">
      <text class="modal-title">申请退桶</text>
      <text class="modal-close" bindtap="onCloseReturnModal">×</text>
    </view>

    <view class="modal-body">
      <view class="return-tip">
        <text>当前可退 <text class="highlight">{{maxReturnQty}}</text> 桶</text>
      </view>

      <view class="form-row" wx:if="{{customerBarrelAsset.length > 0}}">
        <text class="form-label">商品</text>
        <view class="water-type-list">
          <view class="water-type-item {{returnForm.productId === item.productId ? 'active' : ''}}"
                wx:for="{{customerBarrelAsset}}" wx:key="productId"
                data-id="{{item.productId}}" bindtap="onSelectProduct">
            <text>{{item.productName}}{{item.productSpec ? ' ' + item.productSpec : ''}}</text>
            <!-- 退桶选择处显示「可退」而不是「持有」：可退 = 占用（权益 + over），
                 配送中的桶还没到手、退不了；欠桶时占用也会小于权益。 -->
            <text class="water-type-qty">可退 {{summary.independentRights ? item.availableRights : (item.occupiedQty || 0)}} {{summary.independentRights ? '份权益' : '桶'}}</text>
          </view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">退桶数量</text>
        <view class="quantity-control">
          <view class="qty-btn {{returnForm.quantity <= 1 ? 'disabled' : ''}}" bindtap="onReturnQtyChange" data-type="minus">
            <text>-</text>
          </view>
          <input class="qty-input" type="number" value="{{returnForm.quantity}}" bindinput="onReturnQtyInput"></input>
          <view class="qty-btn {{returnForm.quantity >= maxReturnQty ? 'disabled' : ''}}" bindtap="onReturnQtyChange" data-type="add">
            <text>+</text>
          </view>
        </view>
      </view>

      <!-- 退款金额由后端按押金条批次 FIFO 核销算出，顾客不能自己填 -->
      <view class="form-row">
        <text class="form-label">预计退回</text>
        <view class="preview-row">
          <text class="preview-amount" wx:if="{{preview && !preview.blocked}}">¥{{preview.refundAmount}}</text>
          <text class="preview-placeholder" wx:elif="{{previewing}}">计算中...</text>
          <text class="preview-placeholder" wx:else>{{previewHint || '请选择商品和数量'}}</text>
        </view>
      </view>

      <!--
        算不出来的**原因**要常驻显示，不能只弹一次 toast：
        最典型是「还没选服务水站」（试算必须带 waterStationId，后端只认请求参数）。
        以前这里失败被静默吞掉，顾客看到的是一个空白金额框，与「后端算不出」分不清。
      -->
      <view class="preview-hint" wx:if="{{previewHint}}">
        <text>{{previewHint}}</text>
      </view>

      <view class="preview-blocked" wx:if="{{preview && preview.blocked}}">
        <text>{{preview.blockedReason}}</text>
      </view>

      <view class="preview-lots" wx:if="{{preview && preview.lots.length > 0}}">
        <text class="preview-lots-title">预计金额明细</text>
        <view class="preview-lot" wx:for="{{preview.lots}}" wx:key="lotId">
          <text>{{item.qty}} 个 × ¥{{item.unitPrice}}</text>
        </view>
      </view>

      <view class="preview-warn" wx:if="{{preview && preview.hasMigratedPrice}}">
        <text>含历史推断单价，实际金额请与水站确认</text>
      </view>

      <view class="preview-storage" wx:if="{{preview && preview.storageQty > 0}}">
        <text>{{summary.independentRights ? '另有待领取或暂存容量' : '另有空桶寄存在水站'}} {{preview.storageQty}} 个；本次应交桶数量以批准安排为准</text>
      </view>

      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="note-input" placeholder="如：搬家、换地址等" value="{{returnForm.note}}" bindinput="onReturnNoteInput"></input>
      </view>
      <view class="form-row" wx:if="{{summary.independentRights}}" bindtap="onPickupMode"><text>交接方式：{{returnForm.pickupModeText || '到店退桶'}} ›</text></view>
      <view wx:if="{{summary.independentRights}}">必须先批准并确认安排，再交桶。未领桶的权益也可申请退还；仅退还当前未被订单占用的权益。</view>
    </view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onCloseReturnModal">
        <text>取消</text>
      </view>
      <view class="modal-btn confirm {{submitting ? 'disabled' : ''}}" bindtap="onSubmitReturn">
        <text>{{submitting ? '提交中...' : '提交申请'}}</text>
      </view>
    </view>
  </view>
</view>
