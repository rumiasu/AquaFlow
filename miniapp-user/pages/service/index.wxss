.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.service-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.service-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.service-item:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.service-value-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.call-btn,
.copy-btn {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.call-btn {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.2);
}

.copy-btn {
  background-color: var(--bg-gray);
  color: var(--text-regular);
  border: 1rpx solid var(--border-color);
}

.other-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.other-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.other-item:last-child {
  border-bottom: none;
}

.other-item:active {
  background-color: var(--bg-gray);
}

.other-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.other-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}
