.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }
.toolbar { margin-bottom: 20rpx; }
.btn-add { width: 100%; padding: 20rpx; background: var(--primary-gradient); color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; }
.staff-card { background: var(--bg-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.staff-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.staff-name { font-size: 28rpx; font-weight: 600; display: block; }
.staff-phone { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; }
.staff-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: #fafafa; color: #9e9e9e; }
.staff-status.active { background: #e8f5e9; color: #4caf50; }
.card-actions { margin-top: 12rpx; }
.btn-detach { padding: 14rpx; background: #fff3e0; color: #f57c00; border: none; border-radius: 10rpx; font-size: 26rpx; width: 100%; }
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: flex-end; z-index: 1000; }
.modal-content { background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; width: 100%; }
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.modal-input { width: 100%; padding: 20rpx; border: 2rpx solid #eee; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.modal-hint { font-size: 24rpx; color: var(--text-secondary); text-align: center; margin-bottom: 24rpx; display: block; }
.btn-submit { width: 100%; padding: 20rpx; background: var(--primary-gradient); color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 12rpx; }
.btn-cancel { width: 100%; padding: 20rpx; background: #f5f5f5; color: var(--text-secondary); border: none; border-radius: 12rpx; font-size: 28rpx; }
