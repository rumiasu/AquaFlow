.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg-gray);
}

/* ===== 页签 ===== */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 30rpx;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 27rpx;
  color: var(--text-regular);
  border: 1rpx solid var(--bg-gray);
}

.tab-on {
  color: #ffffff;
  background: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 600;
}

/* 角标只在 WARN 非零时才渲染（wxml 里判断）：有数就是提醒，没有就不占位置 */
.tab-badge {
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--error-color);
  color: #ffffff;
  font-size: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.filter {
  font-size: 24rpx;
  color: var(--text-regular);
  padding: 6rpx 18rpx;
  background: var(--bg-gray);
  border-radius: 10rpx;
}

.filter-on {
  color: #ffffff;
  background: var(--primary-color);
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 30rpx 0;
  text-align: center;
}

.empty-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* ===== 统计 ===== */
.stats-row {
  display: flex;
  margin-top: 16rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.stats-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-top: 16rpx;
}

/* ===== 异常单 ===== */
.ex {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg-gray);
}

.ex:last-child {
  border-bottom: none;
}

.ex-pending {
  background: var(--error-bg);
  margin: 0 -24rpx;
  padding: 20rpx 24rpx;
}

.ex-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.ex-tag {
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.ex-tag-pending {
  color: #ffffff;
  background: var(--error-color);
}

.ex-cat {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-left: 14rpx;
}

.ex-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: auto;
}

.ex-row {
  display: flex;
  margin-top: 8rpx;
}

.ex-label {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.ex-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  word-break: break-all;
}

.ex-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.load-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  padding-top: 16rpx;
}

.page-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding: 0 8rpx 40rpx;
}

/* ===== 处理留痕（原「运营告警」页，2026-09-19 并入本页页签 2） =====
   颜色统一成本页的字面色值（原来那页用的是 --var 变量）：同一页面里两种色板混用，
   以后调色必然只改到一半。 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 25rpx;
  color: var(--text-regular);
  border: 1rpx solid var(--bg-gray);
}

.filter-item.active {
  background: var(--primary-bg);
  color: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 600;
}

.filter-num {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.filter-item.active .filter-num {
  color: var(--primary-color);
}

/* 口径说明：把"只列运营告警"讲清楚，避免站长找不到系统故障告警时以为漏了数据 */
.hint {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.alert-card {
  background: var(--bg-gray);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx; border-left: 4rpx solid var(--warning-color); }

.alert-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

/* 级别标签：颜色只表达"要不要处理"，不参与任何逻辑判断 */
.level {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.level.level-error {
  background: var(--error-bg);
  color: var(--error-color);
}

.level.level-warn {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.level.level-info {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.time {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.content {
  display: block;
  font-size: 25rpx;
  color: var(--text-regular);
  line-height: 1.6;
  word-break: break-all;
}

.card-foot {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.foot-item {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.notify {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 处置入口按钮（2026-09-20 开放 A1）：只两个动作，且没有金额输入框的样式可言 ——
   刻意不提供输入类控件的样式，避免后来者"顺手加个输入框"。 */
.ex-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.ex-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 14px;
  line-height: 1.4;
}

.ex-btn-ghost {
  color: var(--text-regular);
  border: 1rpx solid rgba(71, 85, 105, 0.35);
}

.ex-btn-primary {
  color: #fff;
  background-color: #1264D6;
}

/* 本页按账事实与办理动作排版；不改变金额、状态或办理资格。 */

.page { background: var(--bg-color); }.card,.alert-card { border-radius: 12rpx; box-shadow: none; }.tabs { flex-wrap: wrap; }.tab { flex: 1; min-height: 88rpx; box-sizing: border-box; border-radius: 8rpx; padding: 20rpx; justify-content: center; }
.card-head { align-items: flex-start; flex-wrap: wrap; gap: 12rpx; }.filter { min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; padding: 20rpx; border-radius: 8rpx; margin-left: auto; }
.ex { border-radius: 0; border: 0; border-top: 1rpx solid var(--border-color); padding: 24rpx 0; }.ex-pending { margin: 0; border-left: 4rpx solid var(--warning-color); padding-left: 18rpx; }.ex-head { flex-wrap: wrap; gap: 12rpx; }.ex-value { min-width: 0; word-break: break-all; }.ex-actions { flex-wrap: wrap; gap: 12rpx; }.ex-btn { min-height: 44px; box-sizing: border-box; padding: 20rpx; border-radius: 8rpx; white-space: normal; word-break: break-all; line-height: 1.6; flex: 1 1 200rpx; display: flex; align-items: center; justify-content: center; }
.stats-note,.page-note,.hint,.content { color: var(--text-regular); font-size: 25rpx; line-height: 1.7; }.stats-row { flex-wrap: wrap; }.stats-item { min-width: 0; word-break: break-all; }.filter-bar { flex-wrap: wrap; }.filter-item,.load-hint { min-height: 88rpx; box-sizing: border-box; border-radius: 8rpx; padding: 20rpx; display: flex; align-items: center; justify-content: center; }

/* 2026-10-28：本页信息层级、小屏长字与触控下限；业务语义由原数据决定。 */
button:not(.af-action):not(.af-choice):not(.af-entry) { min-height:44px; height:auto; line-height:1.45; white-space:normal; box-sizing:border-box; }
.btn-primary,.primary-button,.btn-confirm { min-height:48px; }

.section-disclosure { width:100%; margin:0; padding:12px; color:#1264d6; background:#f4f8ff; text-align:left; border:1px solid #dbe3ed; font-size:14px; }
.ex-actions { display:flex; flex-wrap:wrap; gap:8px; }
.ex-actions .ex-btn { margin:0; padding:10px 14px; flex:1 1 100px; min-height:44px; font-size:14px; }
.ex-row { align-items:flex-start; gap:12px; }
.ex-value { min-width:0; overflow-wrap:anywhere; font-size:15px; line-height:1.6; }
.ex-time,.stats-note,.page-note { font-size:14px; line-height:1.6; }
.filter,.filter-item,.tab,.load-hint { min-height:44px; box-sizing:border-box; display:flex; align-items:center; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .tabs,.filter-bar { background:var(--af2-surface-neutral); border-radius:10px; } .card { border-radius:14px; box-shadow:none; } .ex-head { padding:12px; border-radius:10px; background:var(--af2-surface-danger); } .ex-head .ex-cat,.ex-head .ex-id { color:var(--af2-ink-danger); } .ex-actions { gap:8px; }
