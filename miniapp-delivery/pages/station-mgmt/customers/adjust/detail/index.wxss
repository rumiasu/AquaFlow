/* 资产调整单详情。单位一律 rpx；.container / .card 沿用 app.wxss 既有类，不重复定义 */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.head-left { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.adjust-no { font-size: 30rpx; font-weight: 700; color: var(--text-primary); word-break: break-all; }
.adjust-type { font-size: 26rpx; color: var(--primary-color); }

/* 状态色：文案用后端下发的 statusText，这里只管配色 */
.status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.status.pending { background: #fff3e0; color: #f57c00; }
.status.effective { background: #e8f5e9; color: #4caf50; }
.status.muted { background: #f4f4f5; color: #909399; }

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  font-size: 26rpx;
  padding: 12rpx 0;
}
.row .label { color: var(--text-secondary); flex-shrink: 0; }
.row .value { color: var(--text-primary); text-align: right; word-break: break-all; }
.row .value.strong { font-weight: 600; color: var(--primary-color); font-size: 30rpx; }
.row .value.link { color: var(--primary-color); text-decoration: underline; }

.reason { font-size: 26rpx; color: var(--text-primary); line-height: 1.7; word-break: break-all; }

.evidence-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.evidence-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: var(--bg-gray); }

.snap-head, .snap-row { display: flex; align-items: center; padding: 14rpx 0; font-size: 26rpx; }
.snap-head { color: var(--text-secondary); font-size: 22rpx; border-bottom: 1rpx solid var(--border-light); }
.snap-row { border-bottom: 1rpx solid var(--border-light); }
.col { flex: 1; text-align: center; color: var(--text-primary); }
.col-name { flex: 1.2; text-align: left; color: var(--text-regular); }
.col.after { font-weight: 600; color: var(--primary-color); }

.raw-block { margin-bottom: 16rpx; }
.raw-label { display: block; font-size: 22rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.raw-text {
  display: block;
  font-size: 22rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  word-break: break-all;
  line-height: 1.6;
}

.footer { margin: 0 24rpx; }
.btn-main, .btn-danger {
  height: 92rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-main { background: var(--primary-gradient); color: #fff; }
.btn-danger { background: #fff; color: var(--error-color); border: 2rpx solid var(--error-color); }
.footer-tip {
  margin: 8rpx 24rpx 60rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
}

.denied, .loading, .empty {
  text-align: center;
  padding: 140rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
