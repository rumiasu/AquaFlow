.page { background: var(--bg-color); min-height: 100vh; padding: 24rpx 24rpx 40rpx; }

/* ===== 时间范围切换 ===== */
.range-bar {
  display: flex;
  background: var(--bg-card, #fff);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
}
.range-item.active {
  background: var(--primary-color);
  color: #fff;
  font-weight: 600;
}

/* ===== 区块 ===== */
.section {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}
.section-head .section-title { margin-bottom: 0; }
.section-note { font-size: 24rpx; color: var(--text-secondary); }

/*
  口径说明（2026-09-27 加）：紧跟在指标卡下面，说清"这几个数按什么口径统计的"。
  为什么单独一个类、不复用 .section-note：那个是标题行里的短标签（单行、右对齐），
  这句是**正文**（可能折两行），行高与上边距都要另给，否则会贴着卡片、很难读。
*/
.scope-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
}

/* ===== 指标卡 ===== */
.metric-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.metric-card {
  width: calc((100% - 12px) / 2);
  min-width: 0;
  background: var(--bg-color);
  border-radius: 16rpx;
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}
.metric-value { font-size: 34rpx; font-weight: 700; color: var(--primary-color); }
.metric-label { font-size: 24rpx; color: var(--text-secondary); }
.delta { display: flex; align-items: center; gap: 4rpx; font-size: 21rpx; }
.delta-arrow { font-size: 24rpx; }
.delta-text { font-size: 21rpx; }
.delta.up .delta-text, .delta.up .delta-arrow { color: var(--success-color); }
.delta.down .delta-text, .delta.down .delta-arrow { color: var(--error-color); }
.delta.flat .delta-text, .delta.flat .delta-arrow { color: var(--text-secondary); }
/* good/bad 覆盖默认涨跌配色（取消单上涨=红但其实是坏消息要标红，金额上涨=绿） */
.delta.good .delta-text, .delta.good .delta-arrow { color: var(--success-color); }
.delta.bad .delta-text, .delta.bad .delta-arrow { color: var(--error-color); }
.delta-prev { font-size: 24rpx; color: var(--text-secondary); }

/* ===== 图表 ===== */
.chart-canvas { width: 100%; }
.chart-canvas.trend { height: 380rpx; }
.chart-canvas.donut { height: 300rpx; }
.metric-switch { display: flex; background: var(--bg-color); border-radius: 10rpx; padding: 4rpx; }
.ms-item { font-size: 24rpx; padding: 6rpx 18rpx; color: var(--text-secondary); border-radius: 8rpx; }
.ms-item.on { background: var(--primary-color); color: #fff; }

/* ===== 双列 ===== */
.two-col { display: flex; gap: 16rpx; align-items: stretch; }
.two-col .col { flex: 1; min-width: 0; box-sizing: border-box; }

/* ===== 横向条形 ===== */
.hbar-item { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; }
.hbar-label { font-size: 23rpx; color: var(--text-secondary); width: 100rpx; flex-shrink: 0; }
.hbar-track { flex: 1; height: 16rpx; background: var(--bg-color); border-radius: 8rpx; overflow: hidden; }
.hbar-fill { height: 100%; background: var(--primary-color); border-radius: 8rpx; }
.hbar-value { font-size: 21rpx; color: var(--text-primary); width: 90rpx; text-align: right; flex-shrink: 0; }

/* ===== 图例 ===== */
.legend { display: flex; flex-direction: column; gap: 10rpx; margin-top: 8rpx; }
.legend-item { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { flex: 1; color: var(--text-primary); }
.legend-val { color: var(--text-secondary); }

/* ===== 排行榜 ===== */
.rank-item { display: flex; gap: 16rpx; padding: 14rpx 0; align-items: flex-start; }
.rank-no {
  width: 40rpx; height: 40rpx;
  border-radius: 10rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-weight: 600;
}
.rank-no.rank-1 { background: var(--error-color); color: #fff; }
.rank-no.rank-2 { background: var(--warning-color); color: #fff; }
.rank-no.rank-3 { background: var(--success-color); color: #fff; }
.rank-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.rank-body.full { width: 100%; }
.rank-line1 { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.rank-name { font-size: 25rpx; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-val { font-size: 24rpx; color: var(--text-secondary); flex-shrink: 0; }
/* 统一排行榜样式：隐藏所有进度条，保持纯文本排行 */
.rank-track { display: none; }
.rank-fill { display: none; }
.rank-fill.green { display: none; }
.rank-sub { font-size: 24rpx; color: var(--text-secondary); }

/* ===== 时段分布 ===== */
.hour-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 4rpx;
  padding-top: 20rpx;
}
.hour-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  gap: 4rpx;
}
.hour-bar {
  width: 60%;
  min-height: 2rpx;
  background: var(--primary-color);
  border-radius: 3rpx 3rpx 0 0;
  opacity: 0.75;
}
.hour-label { font-size: 16rpx; color: var(--text-secondary); transform: scale(0.75); }

/* ===== 其它 ===== */
.empty-tip { font-size: 24rpx; color: var(--text-secondary); padding: 16rpx 0; line-height: 1.6; }
.loading { text-align: center; color: var(--text-secondary); font-size: var(--font-md, 28rpx); padding-top: 120rpx; }
.error-banner {
  background: var(--error-bg);
  border: 1rpx solid var(--error-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  font-size: 25rpx; color: var(--error-color);
}
.retry { color: #fff; background: var(--error-color); border-radius: 24rpx; padding: 8rpx 28rpx; font-size: 24rpx; flex-shrink: 0; }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.page { box-sizing:border-box; }
.range-bar { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.range-item { min-height:88rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; font-size:28rpx; color:var(--text-regular); }
.range-item.active { color:#fff; border-radius:8rpx; }
.section { border-radius:12rpx; box-shadow:none; padding:24rpx; border:1rpx solid var(--border-color); }
.section-head { flex-wrap:wrap; gap:14rpx; }
.section-title { font-size:30rpx; line-height:1.4; border-left:0; padding-left:0; }
.metric-card { background:#fff; border-radius:0; align-items:flex-start; padding:20rpx 8rpx; border-bottom:1rpx solid var(--border-color); }
.metric-value { font-size:40rpx; color:var(--text-primary); overflow-wrap:anywhere; max-width:100%; }
.metric-label,.scope-note { font-size:26rpx; color:var(--text-regular); line-height:1.6; }
.delta-text,.delta-prev,.section-note { font-size:24rpx; line-height:1.5; }
.two-col { flex-direction:column; gap:0; }
.two-col .col { width:100%; }
.ms-item { min-height:88rpx; display:flex; align-items:center; padding:0 24rpx; font-size:26rpx; box-sizing:border-box; }
.hbar-label { font-size:26rpx; width:132rpx; color:var(--text-regular); }
.hbar-value { font-size:25rpx; width:132rpx; }
.rank-line1 { flex-wrap:wrap; align-items:flex-start; }
.rank-name { font-size:28rpx; white-space:normal; overflow-wrap:break-word; }
.rank-val,.rank-sub,.legend-item { font-size:26rpx; color:var(--text-regular); }
.retry { min-height:88rpx; display:flex; align-items:center; box-sizing:border-box; border-radius:10rpx; }
.error-banner { flex-wrap:wrap; font-size:28rpx; line-height:1.6; }

/* 2026-10-28：本页信息层级、小屏长字与触控下限；业务语义由原数据决定。 */
button:not(.af-action):not(.af-choice):not(.af-entry) { min-height:44px; height:auto; line-height:1.45; white-space:normal; box-sizing:border-box; }
.btn-primary,.primary-button,.btn-confirm { min-height:48px; }

.analysis-disclosure { width:100%; padding:12px; margin:12px 0; color:#1264d6; background:#fff; border:1px solid #dbe3ed; font-size:14px; }
.two-col { flex-wrap:wrap; gap:12px; }
.two-col .col { min-width:240px; flex:1 1 240px; margin:0 0 12px; }
.hour-scroll { width:100%; }
.hour-chart { width:720px; min-width:720px; }
.hour-col { min-width:28px; }
.hour-label { font-size:12px; transform:none; }
.section-note,.rank-sub,.legend-name,.legend-val { font-size:14px; line-height:1.5; }
.rank-line1 { flex-wrap:wrap; gap:6px 12px; }
.rank-name { min-width:0; overflow-wrap:anywhere; }
.ms-item { display:inline-flex; align-items:center; min-height:44px; min-width:44px; justify-content:center; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .metric-grid { gap:12px; } .metric-card { border:0; border-radius:14px; box-shadow:none; background:var(--af2-surface-neutral); } .metric-card.s-money-metric { background:var(--af2-surface-money); } .s-money-metric .metric-value { color:var(--af2-ink-money); } .section { border-radius:14px; box-shadow:none; } .hbar-track,.rank-track { background:var(--af2-surface-neutral); }

.metric-card.s-physical-metric { background:var(--af2-surface-physical); } .s-physical-metric .metric-value { color:var(--af2-ink-physical); }
