.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.address-list {
  padding: 20rpx 24rpx;
}

.address-item {
  background-color: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-light);
}

.address-item.selectable {
  border: 2rpx solid transparent;
}

.address-item.selectable:active {
  border-color: var(--primary-color);
  background-color: var(--primary-bg);
}

.address-info {
  margin-bottom: 20rpx;
}

.selectable .address-info {
  margin-bottom: 0;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx 0;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: var(--text-regular);
}

.default-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.address-detail {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  font-weight: 600;
  line-height: 1.6;
  word-break: break-all;
}

.address-tag .tag {
  font-size: 22rpx;
  color: var(--text-regular);
  background-color: var(--bg-gray);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-light);
  flex-wrap: wrap;
}

.action-btn {
  font-size: 26rpx;
  color: var(--text-regular);
  min-height: 88rpx;
  min-width: 128rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-btn.delete {
  color: var(--error-color);
}

.select-hint {
  display: block;
  text-align: right;
  font-size: 26rpx;
  color: var(--primary-light);
  padding-top: 12rpx;
}

.add-btn {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  height: 88rpx;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: none;
}


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
