<!-- 首页：当前订单优先；复购直达确认；静态商品海报使用本站实际商品，不承诺优惠。 -->

<template name="station-product-poster">
  <view class="product-poster" bindtap="onGoShop">
    <view class="poster-art {{artFailed ? 'poster-art-fallback' : ''}}">
      <image wx:if="{{!artFailed}}" class="poster-art-image" src="/assets/banner/home-water-impact.jpg" mode="aspectFill" binderror="onPosterArtError" />
      <view class="poster-headline">
        <text>家里用水，</text>
        <text>随手就订</text>
      </view>
      <text class="poster-art-note" wx:if="{{!artFailed}}">场景示意 · 非商品实拍</text>
    </view>
    <view class="poster-product">
      <image class="poster-product-image" wx:if="{{product.imageUrl && !productImageFailed}}" src="{{product.imageUrl}}" mode="aspectFit" binderror="onPosterProductImageError" />
      <view class="poster-product-image poster-product-placeholder" wx:else><text>商品</text></view>
      <view class="poster-copy">
        <text class="poster-kicker">本站商品</text>
        <text class="poster-name">{{product.name}}</text>
        <text class="poster-spec" wx:if="{{product.spec}}">{{product.spec}}</text>
        <text class="poster-image-note" wx:if="{{product.imageUrl === '/assets/product/barrel-neutral-template.webp'}}">商品示意图 · 包装以实物为准</text>
      </view>
      <view class="poster-buy">
        <text class="poster-price">¥{{product.priceText}}</text>
        <text class="poster-unit">/{{product.quantityUnit}} · 商品零售价</text>
        <text class="poster-link">选水订购 ›</text>
      </view>
    </view>
    <text class="poster-fee">配送、楼层费及新增押金在确认页核算</text>
  </view>
</template>
<view class="page {{isLogin && state === 'ready' && !loading && catalogState === 'ready' && productsView.length > 0 ? 'has-checkout' : ''}}">
  <view class="home-water-backdrop" wx:if="{{!homeWaterBackdropFailed}}" aria-hidden="true">
    <image class="home-water-image" src="/assets/banner/home-water-light.webp" mode="aspectFill" binderror="onHomeWaterBackdropError" />
    <view class="home-water-fade"></view>
  </view>
  <view class="home-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-nav-row" style="height: {{navBarHeight}}px; width: {{navContentWidth}}px;">
      <text class="home-nav-title">送水到家</text>
    </view>
  </view>
  <view class="hero">
    <view class="home-station-heading" wx:if="{{isLogin && currentStationId}}">
      <text class="home-section-label">服务水站</text>
      <view class="station-chip" bindtap="onOpenStationList">
        <text class="station-chip-name">{{currentStationName || '水站名称暂未加载'}}</text>
        <text class="station-chip-arrow">切换 ›</text>
      </view>
    </view>
    <view class="hero-intro" wx:else>
      <text class="home-section-label">日常饮水</text>
      <text class="hero-brand">家里用水，随手就订</text>
    </view>
  </view>

  <!--
    水站营业状态（软状态，v32）：与站名同属「头部」，排在最前 —— 客户第一眼就知道这家站今天什么状态。
    ⚠️ 只提示、不阻断下单；文案与"要不要变黄"都来自后端（statusText / note / customerHint 非空即提醒），
    **没有**任何 1..4 映射。
  -->
  <view class="station-status-row" wx:if="{{isLogin && stationStatusText}}">
    <view class="status-chip {{stationStatusHint ? 'status-chip-warn' : ''}}" bindtap="onStationStatusTap">
      <text class="status-dot"></text>
      <text class="status-chip-text">{{stationStatusText}}</text>
      <text class="status-chip-note" wx:if="{{stationStatusNote}}">· {{stationStatusNote}}</text>
      <text class="status-chip-arrow">›</text>
    </view>
  </view>

  <view class="home-feedback" wx:if="{{loadError}}">
    <view class="home-feedback-row">
      <view class="home-feedback-copy">
        <text class="home-feedback-title">部分信息暂未加载</text>
        <text class="home-feedback-sub">{{loadImpactSummary}}{{loading || notificationsLoading || homeRetrying ? ' · 正在重试' : ''}}</text>
        <text class="home-feedback-sub" wx:if="{{catalogState === 'error'}}">原选购数量已保留，加载后可继续选水</text>
      </view>
      <button class="home-feedback-retry" bindtap="onRetryHome" disabled="{{loading || notificationsLoading || homeRetrying}}">{{loading || notificationsLoading || homeRetrying ? '重试中' : '重新加载'}}</button>
      <button class="home-feedback-toggle" bindtap="onToggleLoadDetails">{{showLoadDetails ? '收起' : '详情'}}</button>
    </view>
    <view class="home-feedback-details" wx:if="{{showLoadDetails}}">
      <text class="home-feedback-detail" wx:for="{{loadIssueDetails}}" wx:key="key">{{item.text}}</text>
    </view>
  </view>

  <view class="home-loading" wx:if="{{loading}}" role="status">
    <view class="home-loading-mark" aria-hidden="true"></view>
    <text class="home-loading-title">{{currentStationId ? '正在加载订水信息' : '正在查找服务水站'}}</text>
    <text class="home-loading-sub">请稍候</text>
  </view>

  <block wx:else>
    <!-- ══ 游客态 ══ -->
    <view class="card guest-card" wx:if="{{!isLogin}}">
      <text class="guest-title">AquaFlow 送水到家</text>
      <text class="guest-desc">登录后选择服务水站，即可下单购水</text>
      <!-- 主按钮：蓝色合法出现处 ② -->
      <view class="cta guest-cta" bindtap="onLogin">登录后下单</view>
    </view>

    <block wx:if="{{isLogin}}">
      <!-- ══ 收货地址：紧跟站名的第二项，自己占一张卡、整行可点 ══ -->
      <view class="card addr" wx:if="{{currentStationId && state === 'ready'}}" bindtap="onAddressTap">
        <text class="addr-label">收货地址</text>
        <text class="addr-text {{address ? '' : 'addr-empty'}}">{{addressHint}}</text>
        <text class="row-arrow">›</text>
      </view>

      <!-- ══ 待认领：⚠️ js 全文没有 state:'claimPending' 的赋值点，这个分支目前进不来 ——
           但**不许删**（后端流程接上后它就生效） ══ -->
      <view class="card state-card" wx:if="{{state === 'claimPending'}}">
        <text class="state-title">等待水站认领</text>
        <text class="state-desc">您的客户资料正在等待对应水站确认，认领成功后即可下单购水</text>
        <view class="state-btn off">等待认领中…</view>
      </view>
      <view class="card station-welcome" wx:if="{{state === 'noStation'}}">
        <view class="station-welcome-art" aria-hidden="true">
          <view class="station-welcome-route"></view>
          <view class="station-welcome-pin"><view></view></view>
          <view class="station-welcome-house"><view></view></view>
        </view>
        <text class="station-welcome-kicker">从身边的水站开始</text>
        <text class="station-welcome-title">先选择为你送水的水站</text>
        <text class="station-welcome-desc">查看该站商品和配送安排，再选水下单</text>
        <button class="home-primary" bindtap="onOpenStationList">选择水站</button>
      </view>

      <block wx:if="{{state === 'ready'}}">
        <!-- ══ 当前订单：只在真存在进行中订单（待配送1/配送中2）时渲染。
             ⚠️ 文案只陈述后端已下发的事实 —— 不写"备货中/正在赶来"这类前端推断的承诺。
             多张进行中订单不堆大卡：给「查看全部」入口。蓝点 = 蓝色合法出现处 ③ ══ -->
        <view class="card ship" wx:if="{{activeShip}}" bindtap="onViewActiveOrder">
          <view class="dot"></view>
          <view class="ship-txt">
            <text class="ship-kicker">当前订单</text>
            <text class="ship-title">{{activeShip.title}}</text>
            <text class="ship-sub" wx:if="{{activeShip.sub}}">{{activeShip.sub}}</text>
          </view>
          <view class="ship-more" wx:if="{{activeOrderCount > 1}}" catchtap="onGoActiveOrders">
            <text class="ship-more-text">查看全部 {{activeOrderCount}} 单</text>
          </view>
          <text class="row-arrow">›</text>
        </view>

        <!-- ══ 再买上次：快捷下单入口（与上方"这单正在发生"区分开），直达确认页；原单商品、数量、地址重新读取报价，不直接付款。
             [2026-09-27 走查 C02 修] 摘要分两句：规模（共 N 种 / M 件）+ 具体是哪几款。
             原文只有一句"等N件"（N 是种数、单位写成"件"），客户点之前说不清会加进什么。 -->
        <view class="card again" wx:if="{{againOrder}}">
          <image class="again-img" wx:if="{{againOrder.img}}" src="{{againOrder.img}}" mode="aspectFit" data-id="{{againOrder.id}}" data-url="{{againOrder.img}}" data-kind="again" binderror="onHomeProductImageError" />
          <view class="again-img again-img-empty" wx:else>
            <icon name="barrel" size="48rpx" color="#9CA7B5" />
          </view>
          <view class="again-mid">
            <text class="again-title">照上次订</text>
            <text class="again-sub">{{againOrder.summary}}</text>
            <text class="again-preview" wx:if="{{againOrder.preview}}">{{againOrder.preview}}</text>
          </view>
          <view class="again-btn" bindtap="onAgainTap">再订一单</view>
        </view>

        <view class="home-feedback" wx:if="{{unavailableCartCount > 0 && (catalogState === 'ready' || catalogState === 'empty')}}">
          <view class="home-feedback-row">
            <text class="home-feedback-title">有 {{unavailableCartCount}} 种已选商品暂不可订，原数量已保留。</text>
            <button class="home-feedback-retry" bindtap="onRetryHome" disabled="{{loading || homeRetrying}}">重新核对商品</button>
          </view>
        </view>

        <view class="card catalog-state" wx:if="{{catalogState === 'error' && !loadError}}">
          <view class="catalog-state-mark" aria-hidden="true">↻</view>
          <text class="catalog-state-title">商品暂时没加载出来</text>
          <text class="catalog-state-desc">重新加载后再选水，你之前选的数量会保留</text>
          <button class="home-primary" bindtap="onRetryHome">重新加载</button>
          <button class="home-text-action" bindtap="onOpenStationList">切换水站</button>
        </view>
        <view class="card catalog-state" wx:elif="{{catalogState === 'empty'}}">
          <view class="catalog-state-mark" aria-hidden="true">水</view>
          <text class="catalog-state-title">该水站暂无可订商品</text>
          <text class="catalog-state-desc">可以切换其他服务水站，或稍后重新查看</text>
          <button class="home-primary" bindtap="onOpenStationList">切换水站</button>
          <button class="home-text-action" bindtap="onRetryHome">重新查看</button>
        </view>

        <!-- 2026-10-22：老客海报曾把数量操作推到结算栏下方；有复购或进行中订单时优先选水。 -->
        <template wx:if="{{!activeShip && !againOrder && productsView.length > 0}}" is="station-product-poster" data="{{product: productsView[0], artFailed: posterArtFailed, productImageFailed: posterProductImageFailed}}" />

        <!-- ══ 订水区：数量即选即算，步进器即选即算 ══ -->
        <view class="card shop-sec" wx:if="{{productsView.length > 0}}">
          <view class="sec-head">
            <text class="sec-title">选水订购</text>
            <!-- 搜索入口：进商城页并自动聚焦搜索框（搜索范围 = 本站商品）
                 2026-09-12：Step5 重写时丢过这个入口；同日把冗余的 pages/home/search 合并进商城页 -->
            <view class="sec-more" bindtap="onGoSearch">搜索 ›</view>
            <!-- 商城入口（用户 2026-09-12 拍板保留）：文字入口，海报不轮播 -->
            <view class="sec-more" bindtap="onGoShop">更多商品 ›</view>
          </view>
          <view class="prod" wx:for="{{productsView}}" wx:key="id">
            <image class="prod-img" wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" data-id="{{item.id}}" data-url="{{item.imageUrl}}" binderror="onHomeProductImageError" />
            <view class="prod-img prod-img-empty" wx:else>
              <icon name="barrel" size="48rpx" color="#9CA7B5" />
            </view>
            <view class="prod-info">
              <text class="prod-name">{{item.name}}</text>
              <text class="product-image-note" wx:if="{{item.imageUrl === '/assets/product/barrel-neutral-template.webp'}}">商品示意图 · 包装以实物为准</text>
              <text class="prod-spec" wx:if="{{item.brand || item.spec}}">{{item.brand}}{{item.brand && item.spec ? ' · ' : ''}}{{item.spec}}</text>
              <!-- 与本次购买有关的押金只留一行说明；详细桶账户计算不放商品行（口径见 §3）
                   文案由 JS 预计算：有桶权益的顾客显示"本次无需加收桶押金…"，不再无脑显示单价押金 -->
              <text class="prod-deposit" wx:if="{{item.depositNote}}">{{item.depositNote}}</text>
              <view class="prod-purchase-row">
              <view class="prod-price-row">
                <text class="prod-price">¥{{item.priceText}}</text>
                <text class="prod-price-unit">/{{item.quantityUnit}}</text>
              </view>
            <view class="stepper">
              <view class="stepper-hit" bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="minus">
                <view class="stepper-btn {{item.qty > 0 ? 'on' : ''}}">−</view>
              </view>
              <text class="stepper-qty" wx:if="{{item.qty > 0}}">{{item.qty}}</text>
              <text class="stepper-hint" wx:else>选数量</text>
              <view class="stepper-hit" bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="add">
                <view class="stepper-btn on">＋</view>
              </view>
            </view>
              </view>
            </view>

          </view>
        </view>

        <template wx:if="{{(activeShip || againOrder) && productsView.length > 0}}" is="station-product-poster" data="{{product: productsView[0], artFailed: posterArtFailed, productImageFailed: posterProductImageFailed}}" />

        <!-- ══ 水桶与押金入口：首页只留入口 + 必要欠桶提醒；权益/占用/押金的真实口径在桶账页 ══ -->
        <view class="card barrel" wx:if="{{barrelVisible}}" bindtap="onGoBarrel">
          <icon name="barrel" size="36rpx" color="#637083" />
          <view class="barrel-txt">
            <text class="barrel-line">{{barrelLine1}}</text>
            <text class="barrel-sub" wx:if="{{barrelLine2}}">{{barrelLine2}}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </block>
    </block>
  </block>

  <!-- 2026-10-12：原“商品小计”未区分零售与票价；明确零售预估，支付口径到结算页核实。历史模式保留旧押金预估。 -->
  <view class="checkout" wx:if="{{isLogin && state === 'ready' && !loading && catalogState === 'ready' && productsView.length > 0}}">
    <view class="sum">
      <view class="sum-total-row" wx:if="{{total.count > 0}}">
        <text class="sum-detail">零售预估</text>
        <text class="sum-total">¥{{total.grandText}}</text>
        <text class="sum-detail">{{total.detailText}}</text>
      </view>
      <view class="sum-total-row" wx:else>
        <text class="sum-detail">零售预估</text>
        <text class="sum-total sum-total-empty">¥0</text>
        <text class="sum-detail">（未选商品）</text>
      </view>
      <!-- ⚠️ 原来写死「配送免运费」：配送费是站级配置（v35），站长一旦配了费，
           首页承诺免运费、结算页照收 —— 客户拿着两张截图来吵架。
           首页算不出运费（还没选地址），所以这里**不做费用承诺**，只报件数并指向结算页报价。 -->
      <text class="sum-sub">{{total.count > 0 ? '已选 ' + total.count + ' 件 · 支付金额以结算页报价为准' : '选中数量后自动合计'}}</text>
      <text class="sum-recovery" wx:if="{{total.count > 0 && purchaseHint}}">{{purchaseHint}}</text>
      <text class="sum-recovery" wx:elif="{{total.count > 0 && homeQuoteState === 'error'}}">费用暂未核实，确认页核对后才能提交订单。</text>
    </view>
    <!-- 主按钮：蓝色合法出现处 ②；置灰用 #9CA7B5，不是浅蓝 -->
    <view class="cta {{total.count > 0 ? '' : 'off'}}" bindtap="onSubmit">确认订单</view>
  </view>

  <!-- ══ 水站选择弹层（保留原有交互） ══ -->
  <view class="station-picker-mask" wx:if="{{showStationList}}" bindtap="onCloseStationList"></view>
  <view class="station-picker {{showStationList ? 'show' : ''}}">
    <view class="station-picker-header">
      <text class="station-picker-title">选择服务水站</text>
      <view class="station-picker-close" bindtap="onCloseStationList">
        <text>关闭</text>
      </view>
    </view>
    <view class="station-picker-list">
      <view class="station-picker-item {{item.id === currentStationId ? 'active' : ''}}"
            wx:for="{{stationList}}" wx:key="id"
            bindtap="onSelectStation" data-id="{{item.id}}">
        <view class="station-picker-item-info">
          <text class="station-picker-item-name">{{item.displayName || '水站名称暂未加载'}}</text>
          <text class="station-picker-item-addr" wx:if="{{item.address}}">{{item.address}}</text>
        </view>
        <text class="station-picker-item-check" wx:if="{{item.id === currentStationId}}">当前</text>
      </view>
      <!--
        空态要分两种：[2026-09-20] 原来只有「暂无可用水站」一句 —— 接口失败时列表也是空的，
        于是"没查到"被说成"平台确实没有水站"，客户会以为整平台都没站可下单（AGENTS §8.22）。
        stationListError 由 loadStationList 在失败时写入（含可读原因）。
      -->
      <view class="station-picker-empty" wx:if="{{stationListLoading}}">正在加载水站…</view>
      <view class="station-picker-empty" wx:elif="{{stationListError}}">
        <text>水站列表暂未加载，请重试</text>
        <button class="station-picker-retry" bindtap="onRetryStationList">重新加载</button>
      </view>
      <view class="station-picker-empty" wx:elif="{{stationList.length === 0}}">暂无可用水站</view>
    </view>
  </view>
</view>
