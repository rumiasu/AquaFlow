.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部双列统计卡片 */
.stats-card {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.stat-col {
  flex: 1;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stat-value-row {
  display: flex;
  align-items: baseline;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.stat-number.deposit {
  color: var(--success-color);
}

.stat-number.owed {
  color: var(--error-color);
}

.stat-unit {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 6rpx;
}

/* 「押金流水 ›」入口：整列可点（bindtap 在 .stat-col 上），这里只做视觉提示 */
.stat-link {
  font-size: 22rpx;
  color: var(--primary-color);
}

.stat-divider {
  width: 1rpx;
  background-color: var(--border-light);
  align-self: stretch;
  margin: 24rpx 0;
}

.owed-tip {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 59, 48, 0.08);
  border: 1rpx solid rgba(255, 59, 48, 0.3);
  border-radius: var(--radius-md);
  color: var(--error-color);
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 水站暂存：中性提示，不是警告——over<0 是合法状态，只是让顾客知道桶在哪 */
.storage-tip {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(10, 132, 255, 0.08);
  border: 1rpx solid rgba(10, 132, 255, 0.3);
  border-radius: var(--radius-md);
  color: #0a84ff;
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.return-btn-small {
  padding: 10rpx 24rpx;
  background: var(--primary-bg);
  border-radius: 20rpx;
  border: 1rpx solid var(--primary-color);
}

.return-btn-small text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 水桶列表 */
.bucket-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bucket-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: var(--bg-color);
  border-radius: var(--radius-md);
}

.bucket-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bucket-icon {
  font-size: 40rpx;
}

.bucket-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bucket-id {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.bucket-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.bucket-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.status-0 {
  color: var(--primary-color);
  background-color: var(--primary-bg);
}

.status-1 {
  color: var(--warning-color);
  background-color: rgba(255, 149, 0, 0.1);
}

.status-2 {
  color: var(--primary-color);
  background-color: var(--primary-bg);
}

.status-3 {
  color: var(--success-color);
  background-color: rgba(52, 199, 89, 0.1);
}

.status-4 {
  color: var(--error-color);
  background-color: rgba(255, 59, 48, 0.1);
}

/* 押金说明卡片 */
.info-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-regular);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 爱护水桶卡片 */
.eco-card {
  background-color: #fff;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.eco-content {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.eco-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.eco-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eco-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.eco-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.eco-btn {
  padding: 14rpx 28rpx;
  background-color: var(--bg-color);
  border-radius: 20rpx;
  display: inline-block;
  align-self: flex-start;
}

.eco-btn text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-content.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-secondary);
  padding: 0 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.return-tip {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-bottom: 24rpx;
}

.return-tip .highlight {
  color: var(--primary-color);
  font-weight: 700;
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-btn text {
  font-size: 36rpx;
  color: var(--text-primary);
  line-height: 1;
}

.qty-input {
  width: 100rpx;
  height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 16rpx;
  color: var(--text-primary);
}

.deposit-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.deposit-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.deposit-max {
  font-size: 24rpx;
  color: var(--primary-color);
  white-space: nowrap;
  padding: 8rpx 16rpx;
  background-color: var(--primary-bg);
  border-radius: 8rpx;
}

/* 退桶试算（金额由后端按押金条批次算出，前端只读展示） */
.preview-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding: 8rpx 0;
}

.preview-amount {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.preview-placeholder {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.preview-blocked {
  background-color: #FFF4E5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.preview-blocked text {
  font-size: 26rpx;
  color: #B45309;
}

.preview-lots {
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.preview-lots-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.preview-lot text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.preview-warn {
  background-color: #FFF4E5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.preview-warn text {
  font-size: 24rpx;
  color: #B45309;
}

.preview-storage {
  padding: 8rpx 0 16rpx;
}

.preview-storage text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.note-input {
  width: 100%;
  height: 72rpx;
  background-color: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
}

.water-type-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.water-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  background-color: var(--bg-gray);
  font-size: 26rpx;
  color: var(--text-primary);
}

.water-type-item.active {
  border-color: var(--primary-color);
  background-color: var(--primary-bg);
  color: var(--primary-color);
}

.water-type-qty {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.water-type-item.active .water-type-qty {
  color: var(--primary-color);
}

.modal-footer {
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background-color: var(--bg-gray);
  color: var(--text-regular);
}

.modal-btn.confirm {
  background: var(--primary-gradient);
  color: #fff;
}

.modal-btn.confirm.disabled {
  background: var(--text-placeholder);
}

/* 当前水站提示条（2026-09-20）：水票/押金/桶权益按「客户 × 水站」隔离，
   页面要能一眼看出"这是哪个站的账"。样式与 pages/deposit/records 同名类保持一致。 */
.station-bar {
  display: flex;
  flex-direction: column;
  padding: 4rpx 8rpx 20rpx;
}

.station-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-bar-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
