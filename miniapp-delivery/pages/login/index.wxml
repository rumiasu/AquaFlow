<view class="login-page">
  <view class="logo-area">
    <view class="logo-icon">💧</view>
    <text class="title">AquaFlow 员工登录</text>
    <text class="subtitle">请使用微信登录</text>
  </view>

  <view class="btn-area">
    <!-- 微信一键登录：仅 wx.login 静默换 openid，不弹任何授权框 -->
    <button class="btn-primary" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading}}">
      <text wx:if="{{loading}}">登录中...</text>
      <text wx:else>微信一键登录</text>
    </button>
    <button class="btn-dev" bindtap="onDevLogin" disabled="{{loading}}">
      开发者登录
    </button>
  </view>

  <view class="agreement">
    <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgreement">
      <text wx:if="{{agreed}}" class="check-icon">✓</text>
    </view>
    <text class="agreement-text">我已阅读并同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>

  <view class="tips">
    <text class="tip-text">已绑定员工可直接登录</text>
    <text class="tip-text">未绑定请联系站长录入</text>
  </view>
</view>
