.empty {
  box-sizing: border-box;
  padding: 64rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-title {
  color: var(--text-primary);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.5;
}
.empty-text {
  color: var(--text-regular);
  font-size: var(--text-body);
  line-height: 1.6;
  word-break: break-all;
}
