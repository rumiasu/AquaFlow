.page-container { padding: 24rpx; }

.status-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.status-card.status-1 { border-left: 8rpx solid var(--warning-color); }
.status-card.status-2 { border-left: 8rpx solid var(--primary-color); }
.status-card.status-3 { border-left: 8rpx solid var(--success-color); }
.status-card.status-4 { border-left: 8rpx solid #7c3aed; }
.status-card.status-5 { border-left: 8rpx solid var(--error-color); }

.status-main {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pay-badge {
  display: inline-block;
  background: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.info-section {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-action {
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  font-weight: 500;
}

.btn-cancel {
  background: rgba(220, 38, 38, 0.06);
  color: var(--error-color);
}

.btn-reorder {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.btn-call {
  background: rgba(5, 150, 105, 0.06);
  color: var(--success-color);
}
