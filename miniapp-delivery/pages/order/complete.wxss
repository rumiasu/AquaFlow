/* [2026-10-13] 必要说明曾误用低对比次要/占位色；只改正常文字为正文辅助色，保留非文本与禁用态原声明。 */
/* 底部留白覆盖固定栏：两行按钮文字 96rpx + 按钮内边距 64rpx + 栏内边距 64rpx
   + 16rpx 间隔 = 240rpx；安全区在内容与底栏两处同时预留，长内容保持自然滚动。 */
.container { background: var(--bg-color); min-height: 100vh; padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }

/* [2026-09-27 走查 D03 修] 页头卡片：原来只有"成功态"一种样式，
   现在同一个卡位承载 提交前 / 提交中 / 成功 三态（见 wxml 的 resultState 分支）。 */
.head-card { background: var(--bg-card); margin: var(--spacing-md); border-radius: 12rpx; box-shadow: none; padding: 28rpx;
  text-align: left;
  border: 1rpx solid var(--border-color);
}
.head-title { font-size: 38rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: var(--spacing-xs); }
.head-subtitle { font-size: var(--font-sm); color: var(--text-regular); line-height: 36rpx; }
/* 成功态样式保留原名（.success-header 已并入 .head-card，成功时用的是同一张卡） */
.success-header { background: var(--bg-card); margin: var(--spacing-md); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: var(--spacing-xl) var(--spacing-lg); text-align: center; }
.success-icon { width: 100rpx; height: 100rpx; background: var(--success-color); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 52rpx; font-weight: 700; margin: 0 auto var(--spacing-md); }
.success-title { font-size: var(--font-xxl); font-weight: 700; color: var(--success-color); display: block; margin-bottom: var(--spacing-sm); }
.success-subtitle { font-size: var(--font-md); color: var(--text-regular); }

/* 四组标题与事实卡对齐；仅布局，不表达已完成阶段。 */
.seg-head { display: flex; align-items: center; margin: var(--spacing-md) var(--spacing-md) 0; }
.seg-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }

.section { background: var(--bg-card); margin: var(--spacing-md); border-radius: 12rpx; box-shadow: none; padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}
.section-title { font-size: var(--font-md); font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-lg); display: block; }
/* 标题 + 「?」（2026-09-24）。下边距挪到这一行上，否则问号会被标题自己的 margin 顶偏。
   [2026-09-26] 现在有两节用它：「送达凭证」与「楼层与楼梯凭证」（三段的标题已提到 .seg-head）。 */
.section-title-row { display: flex; align-items: center; margin-bottom: var(--spacing-lg); }
.section-title-row .section-title { margin-bottom: 0; }
.required { color: var(--error-color); margin-left: 4rpx; font-size: 26rpx; }

/* ========== 客户卡 + 钱卡（[2026-09-26]：原来是 7 行「标签 + 值」平铺，又长又平） ==========
   风格对齐「常用软件」的配送页：客户名一行、可点动作靠右、金额独占一行大字。
   ⚠️ 原来的 .order-info-row / .order-label / .order-value 已删（[2026-09-26]）——
      它们只服务那块平铺列表，留着会变成"看起来还有一处旧样式"的误导。 */
.cust-card {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: 12rpx;
  box-shadow: none;
  padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}
.cust-main { display: flex; align-items: center; gap: 12rpx; margin-bottom: var(--spacing-sm); }
.cust-name { font-size: var(--font-xl); font-weight: 700; color: var(--text-primary); }
/* 付款方式降级成一个标签：它是事实、不是标题（原来占一整行「付款方式：货到付款」） */
.cust-tag {
  font-size: var(--font-sm);
  color: var(--text-regular);
  background: var(--bg-color);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.cust-row { display: flex; align-items: center; padding: 14rpx 0; border-top: 2rpx solid var(--bg-gray);
  /* 固定现场联系热区下限，避免320px窄屏按rpx缩小。 */
  min-height: 48px;
  box-sizing: border-box;
  gap: 16rpx;
}
/* [2026-09-26] 原来的 .cust-row-icon（📞 / 📍）已删：§6 员工端逐步去除表情符号，
   行尾的「拨打」「复制」已经把动作说清楚了。 */
.cust-row-text { flex: 1; font-size: 30rpx; color: var(--text-primary); word-break: break-all;
  line-height: 1.5;
}
.cust-row-action {
  font-size: 14px;
  color: var(--primary-color);
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-left: 16rpx;
}

.money-card {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: 12rpx;
  box-shadow: none;
  padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}
.money-line { display: flex; align-items: baseline; justify-content: space-between; }
.money-label { font-size: var(--font-md); color: var(--text-regular); }
/* 红字大字**只**给"本次要收的钱"（.money-line 里的 collect 分支）。
   [2026-09-27 走查 D01 修] 已付款的单原来也走这一条 ⇒ 看着像还要收这么多钱。 */
.money-amount { font-size: 56rpx; font-weight: 700; color: var(--error-color); line-height: 1.1; }
/* 已付款 / 不归本次收：主结论是一句话，总额降级成普通字号、中性色 */
.money-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.money-headline { font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.money-headline-paid { color: var(--success-color); }
.money-headline-wait { color: var(--af-text-secondary); }
.money-amount-muted { font-size: var(--font-md); color: var(--text-regular); }
.money-line-muted { margin-top: 8rpx; }

/* [2026-09-27 走查 D02 修] 送货清单：商品名 + 数量，常显（新押金单 / 纯瓶装水单也要看得到送什么） */
.goods-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 14rpx 0; border-top: 2rpx solid var(--bg-gray); }
.goods-row:first-of-type { border-top: none; }
.goods-name { flex: 1; font-size: 30rpx; color: var(--text-primary); word-break: break-all; }
.goods-qty { flex-shrink: 0; font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.goods-empty { padding: 14rpx 0; font-size: var(--font-sm); color: var(--text-regular); }
.money-meta { margin-top: 8rpx; }
.money-meta-item { display: block; font-size: var(--font-sm); color: var(--text-regular); line-height: 36rpx; }
/* 备货没齐：单独一条醒目提示 + 补货入口（齐了整块不渲染） */
.money-prep {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--spacing-md);
  padding: 12rpx 16rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md); border-left: 4rpx solid var(--af-text-secondary); }
.money-prep-text { flex: 1; font-size: var(--font-sm); color: var(--af-text-secondary); line-height: 34rpx; }
.money-prep-link { font-size: var(--font-sm); color: var(--af-text-secondary); font-weight: 600; flex-shrink: 0; margin-left: 12rpx; }

.item-return { padding: 16rpx 0; }
.item-header { margin-bottom: 12rpx; }
.item-name-wrap { display: flex; align-items: center; gap: 12rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.item-spec { font-size: 24rpx; color: var(--text-regular); background: var(--bg-color); padding: 4rpx 12rpx; border-radius: 8rpx; }

.barrel-row { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.barrel-label { font-size: 28rpx; color: var(--text-primary); }
.num-blue { font-weight: 700; color: var(--primary-color); }

/* 加减是这一页**唯一的数字输入动作**（在门口一边数桶一边点），按 §6 的控件尺寸给到 88rpx：
   64rpx 那一版在真机上偏小、还容易点空（点了没反应最容易被当成"坏了"）。 */
/* 数量输入在局部层内绘制，滚经固定底栏时随控件一起被盖住；窄屏不压缩加减触区。 */
.barrel-stepper { position: relative; z-index: 0; display: flex; flex-shrink: 0; align-items: center; gap: 12rpx; }
.step-btn { width: 96rpx; height: auto; border-radius: 12rpx; background: var(--bg-color); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 300; color: var(--text-primary); border: 2rpx solid var(--border-color);
  box-sizing: border-box; min-width:48px; min-height:48px; display:flex; align-items:center; justify-content:center; }
.step-btn:active { background: var(--primary-bg); }
.step-btn-disabled { opacity: 0.4; }
.step-input { width: 112rpx; height: 96rpx; text-align: center; font-size: 38rpx; font-weight: 700; border: 2rpx solid var(--border-color); border-radius: var(--radius-md);
  min-height: 48px;
  box-sizing: border-box;
}

.discrepancy-section { margin-top: 16rpx; padding: 16rpx; background: var(--bg-gray); border-radius: var(--radius-md); border: 2rpx solid var(--af-border); border-left: 4rpx solid var(--af-text-secondary); }
.discrepancy-warn { font-size: 26rpx; color: var(--error-color); font-weight: 600; margin-bottom: 12rpx; }

.reason-list { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 12rpx; }
.reason-item { display: flex; align-items: center; gap: 12rpx; background: #fff; padding: 12rpx 16rpx; border-radius: var(--radius-md); border: 2rpx solid var(--af-border); }
.reason-label { font-size: 26rpx; color: var(--text-primary); flex: 1; }
.reason-qty-wrap { display: flex; align-items: center; gap: 4rpx; }
.reason-qty-label { font-size: 24rpx; color: var(--text-regular); }
.reason-qty-input { width: 60rpx; height: 48rpx; text-align: center; font-size: 28rpx; font-weight: 600; border: 2rpx solid var(--border-color); border-radius: 8rpx; }
.reason-remove { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; color: var(--error-color); font-size: 28rpx; }

.add-reason-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 16rpx; border: 2rpx dashed var(--af-border); border-radius: var(--radius-md); background: var(--af-soft); }
.add-reason-icon { font-size: 28rpx; color: var(--af-text-secondary); }
.add-reason-text { font-size: 26rpx; color: var(--af-text-secondary); font-weight: 500; }

.reason-hint { font-size: 24rpx; color: var(--text-regular); margin-top: 8rpx; text-align: center; }

.item-divider { height: 2rpx; background: var(--border-light); margin: 16rpx 0; }

.first-order-tip { text-align: center; padding: 32rpx 24rpx; background: var(--success-bg); border-radius: var(--radius-md); border: 2rpx solid var(--success-bg); }
/* [2026-09-26] 原来的 .first-order-icon（🆕）已删：提示文案自己就说清了，
   表情符号在「动作/状态」之外只增加噪音（§6）。 */
.first-order-text { font-size: 30rpx; font-weight: 600; color: var(--success-color); display: block; margin-bottom: 8rpx; }
.first-order-desc { font-size: 24rpx; color: var(--success-color); display: block; line-height: 1.5; }

.section-collect { background: var(--bg-gray); border: 2rpx solid var(--af-border); border-left: 4rpx solid var(--af-text-secondary); }
.collect-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03); }
.collect-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.collect-label { font-size: 26rpx; color: var(--text-regular); }
.collect-amount-text { font-size: 30rpx; font-weight: 700; color: var(--af-text-secondary); }
/* ⚠️ 原来的 `.order-value.amount` / `.order-value.link` 已删（[2026-09-26]）：它们只给上面那块
   平铺信息行的大号金额与"去补货"着色用，而那块已经换成 .money-card（金额 56rpx 独占一行、
   补货入口自带 .money-prep-link）。留着就是"看起来还有一处旧样式"的误导。 */
.collect-sub-text { font-size: 26rpx; color: var(--text-regular); }
.collect-tip { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-regular); line-height: 1.6; }

/* 「更多（选填）」折叠条（契约 C2）：正常路径只留"商品 / 回桶 / 收钱"三件事 */
.more-toggle { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; background: var(--bg-card); border: 2rpx solid var(--border-color); border-radius: var(--radius-md);
  min-height: 96rpx;
  box-sizing: border-box;
}
.more-toggle-text { font-size: 26rpx; color: var(--text-regular); }
.more-toggle-icon { font-size: 24rpx; color: var(--text-secondary); }

.collect-selector { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
  flex-wrap: wrap;
}
.collect-option { text-align: center; padding: 20rpx 0; border: 2rpx solid var(--border-color); border-radius: 12rpx; background: #fff; transition: all .2s;
  min-height: 112rpx;
  box-sizing: border-box;
  min-width: 220rpx;
}
.collect-option.active { border-color: var(--primary-color); background: var(--primary-bg); }
.collect-option-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); display: block; }
.collect-option.active .collect-option-name { color: var(--primary-color); }
.collect-option-desc { font-size: 24rpx; color: var(--text-regular); display: block; margin-top: 8rpx; line-height: 1.5; padding: 0 8rpx; }

.section-tip { display: block; font-size: var(--font-sm); color: var(--text-regular); margin-bottom: var(--spacing-md); }
.photo-grid { display: flex; gap: var(--spacing-md); flex-wrap: wrap; }
.photo-item { position: relative; width: 200rpx; height: 200rpx; border-radius: var(--radius-md); overflow: hidden; }
.photo-img { width: 100%; height: 100%; }
.photo-remove { position: absolute; top: 0; right: 0; width: 48rpx; height: 48rpx; background: rgba(0,0,0,.55); color: #fff; font-size: 32rpx; line-height: 48rpx; text-align: center; border-radius: 0 0 0 var(--radius-md); }
.photo-remove { width: 44px; height: 44px; line-height: 44px; }
.photo-add { width: 200rpx; height: 200rpx; border: 2rpx dashed var(--border-color); border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; background: var(--bg-color); }
/* [2026-09-26] 原来的 .photo-add-icon（📷 / 🪜）已删 —— 「添加照片」这四个字就是动作本身（§6）。 */
.photo-add-text { font-size: 14px; color: var(--af-text-secondary); }

.note-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-md); }
.note-label { font-size: var(--font-md); color: var(--text-regular); }
.note-count { font-size: var(--font-sm); color: var(--text-regular); }
.note-input { width: 100%; min-height: 140rpx; padding: var(--spacing-md); border: 2rpx solid var(--border-color); border-radius: var(--radius-md); font-size: var(--font-md); box-sizing: border-box; }

.footer { position: fixed; z-index: 20; bottom: 0; left: 0; right: 0; background: var(--bg-card); padding: var(--spacing-lg) var(--spacing-md); padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06); }
.btn-confirm { width: 100%; background: var(--primary-color); color: #fff; border: none; border-radius: 12rpx; font-size: var(--font-lg); font-weight: 700; line-height: 1.5; padding: var(--spacing-lg) 0;
  min-height: 48px;
  white-space: normal;
}
.btn-confirm::after { border: none; }
/* [2026-09-27 走查 D03 修] 提交在途：按钮必须**看起来不能再点**（disabled 属性之外再给视觉，
   否则"点了没反应"与"正在提交"分不清 —— 本仓"静默无反应"的老毛病）。 */
.btn-confirm-busy { background: var(--text-secondary); }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); display: flex; align-items: flex-end; z-index: 1000; }
.modal-content { width: 100%; background: var(--bg-card); border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding: var(--spacing-xl) var(--spacing-lg) calc(var(--spacing-xl) + env(safe-area-inset-bottom)); max-height: 80vh; overflow-y: auto; }
.modal-title { display: block; font-size: var(--font-xl); font-weight: 700; color: var(--text-primary); text-align: center; margin-bottom: var(--spacing-sm); }
.modal-desc { display: block; font-size: var(--font-sm); color: var(--text-regular); text-align: center; margin-bottom: var(--spacing-lg); }
.modal-list { margin-bottom: var(--spacing-lg); }
.modal-item { display: flex; align-items: center; padding: var(--spacing-md) 0; border-bottom: 2rpx solid var(--bg-gray); }
.modal-item:last-child { border-bottom: none; }
.modal-item-disabled { opacity: 0.4; }
.modal-item-info { flex: 1; }
.modal-item-name { font-size: var(--font-md); color: var(--text-primary); display: block; }
.modal-item-desc { font-size: var(--font-sm); color: var(--text-secondary); display: block; margin-top: 4rpx; }
.modal-check { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--success-color); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; }
.modal-cancel { width: 100%; background: var(--bg-gray); color: var(--text-primary); border: none; border-radius: var(--radius-round); font-size: var(--font-md); font-weight: 600; padding: var(--spacing-md) 0; }
.modal-cancel::after { border: none; }

/* ========== 楼层与楼梯凭证（v43；[2026-09-26] 默认收起、有争议才展开） ========== */
.floor-row {
  display: flex;
  align-items: center;
  margin: 12rpx 0 8rpx;
}

.floor-input {
  width: 200rpx;
  padding: 12rpx 20rpx;
  background: var(--bg-gray);
  border-radius: 10rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.floor-unit {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-left: 12rpx;
}

/* 楼梯凭证的小标题（块内第二段，比 .section-title 弱一档） */
.floor-proof-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-regular);
  margin: var(--spacing-md) 0 var(--spacing-sm);
}

/* 「楼梯 / 楼层有争议？」入口：一行可点的浅色条目，不做成按钮（它不是主流程动作） */
.dispute-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
}
.dispute-entry-text {
  font-size: 26rpx;
  color: var(--text-regular);
}
.dispute-entry-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.cust-address .cust-row-text { font-size: 34rpx; font-weight: 700; }
.cust-row-text, .goods-name, .money-meta-item { min-width: 0; overflow-wrap: anywhere; }
.barrel-stepper { margin-left: auto; }
.barrel-label { font-size: 28rpx; line-height: 1.5; }
.reason-item { flex-wrap: wrap; gap: 12rpx; }
.reason-remove { min-width: 96rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; }
.reason-qty-input { min-height: 96rpx; }
.add-reason-btn, .dispute-entry, .modal-item, .modal-cancel { min-height: 44px; box-sizing: border-box; }
.container > button:not(.af-action), .upload-recovery-panel button:not(.af-action) { height: auto; min-height: 44px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.upload-recovery-panel { margin: 24rpx 24rpx calc(260rpx + env(safe-area-inset-bottom)); padding: 24rpx; border: 2rpx solid var(--af-text-secondary); border-radius: 12rpx; background: var(--bg-gray); line-height: 1.6; border-left: 4rpx solid var(--af-text-secondary); }
.upload-recovery-panel text { display: block; overflow-wrap: anywhere; }
.upload-recovery-panel image { display: block; max-width: 100%; }

.cust-main, .money-line, .money-head, .goods-row { flex-wrap: wrap; gap: 12rpx; }
.container > button { max-width: 100%; }

/* 2026-10-28 B2: group geometry is local; action faces and colors come from B0. */
.b2-complete { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --bg-gray: var(--af-soft); --border-color: var(--af-border); --error-color: var(--af-danger); --success-color: var(--af-positive); --success-bg: var(--af-soft); background: var(--af-canvas); padding-bottom: calc(144px + env(safe-area-inset-bottom)); }
.b2-complete .head-card, .b2-complete .cust-card, .b2-complete .money-card, .b2-complete .section { margin: 12px 16px; padding: 16px; border-radius: 10px; border-color: var(--af-border); box-shadow: none; }
.b2-complete .head-card { border: 0; border-left: 4px solid var(--af-primary); border-radius: 0; background: transparent; margin-top: 20px; }
.b2-complete .head-title { font-size: 23px; line-height: 30px; color: var(--af-ink); }
.b2-complete .head-subtitle { font-size: 13px; line-height: 20px; color: var(--af-text-secondary); display: block; }
.b2-complete .seg-head { margin: 24px 16px 8px; gap: 8px; }
.b2-complete .seg-title, .b2-complete .section-title { font-size: 17px; line-height: 24px; color: var(--af-ink); font-weight: 600; }
.b2-section-symbol { display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--af-border); border-radius: 6px; color: var(--af-primary); background: var(--af-soft); font-size: 12px; font-weight: 600; }
.b2-complete .section-title-row { gap: 8px; }
.b2-complete .money-amount { color: var(--af-strong); font-size: 30px; }
.b2-complete .money-headline-wait, .b2-complete .collect-amount-text { color: var(--af-strong); }
.b2-complete .money-prep { border-left-color: var(--af-primary); gap: 8px; }
.b2-complete .money-prep-link { min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; color: var(--af-primary); }
.b2-complete .barrel-row { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
.b2-complete .barrel-stepper { margin-left: 0; gap: 0; max-width: 100%; }
.b2-complete .step-btn { width: 48px; min-width: 48px; min-height: 48px; height: 48px; background: var(--af-soft); color: var(--af-strong); border: 1px solid var(--af-border); border-radius: 6px; font-size: 24px; }
.b2-complete .step-input { width: 80px; height: 48px; min-height: 48px; border: 1px solid var(--af-border); border-radius: 0; color: var(--af-ink); font-size: 20px; }
.b2-complete .step-btn-disabled { opacity: 1; color: var(--af-disabled-text); background: var(--af-disabled-bg); }
.b2-complete .discrepancy-section { background: var(--af-soft); border-color: var(--af-border); border-left-color: var(--af-danger); padding: 12px; }
.b2-complete .reason-item { padding: 8px; gap: 8px; border-color: var(--af-border); }
.b2-complete .reason-qty-input { min-height: 44px; width: 52px; }
.b2-reason-remove { margin-left: auto; flex: 0 0 auto; }
.b2-reason-entry, .b2-photo-add { width: 100%; gap: 10px; border-bottom: 1px solid var(--af-border); }
.b2-optional { color: var(--af-text-secondary); font-size: 12px; }
.b2-complete .section-collect { border-left: 1px solid var(--af-border); background: var(--af-surface); }
.b2-complete .collect-card { padding: 0; box-shadow: none; margin-bottom: 12px; }
.b2-complete .collect-selector { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 8px; align-items: start; }
.b2-collect-option { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 6px 0; }
.b2-collect-option .af-choice__face { width: 100%; box-sizing: border-box; justify-content: center; }
.b2-complete .collect-option-desc { font-size: 12px; line-height: 18px; margin-top: 0; color: var(--af-text-secondary); text-align: left; }
.b2-more-toggle, .b2-dispute-entry { gap: 8px; justify-content: space-between; }
.b2-complete .footer { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); box-shadow: 0 -2px 6px rgba(22,45,72,.08); border-top: 1px solid var(--af-border); }
.b2-complete .floor-input { min-height: 44px; }
.upload-recovery-panel .af-action { margin: 6px 0; }

.b2-complete .section-tip, .b2-complete .reason-hint, .b2-complete .money-meta-item, .b2-complete .collect-tip { font-size: 13px; line-height: 20px; color: var(--af-text-secondary); } .b2-complete .first-order-tip { background: var(--af-soft); border-color: var(--af-border); text-align: left; } .b2-complete .first-order-text { color: var(--af-strong); } .b2-complete .first-order-desc { color: var(--af-text-secondary); font-size: 13px; line-height: 20px; }

/* 2026-10-29 visual-L: semantic task surfaces, quantities and native proof tools. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); }
.lv2-complete .head-card { margin:16px; padding:12px 0 12px 12px; border-radius:0; }
.lv2-complete .seg-head.lv2-group-heading { display:flex; align-items:center; gap:10px; margin:20px 16px 0; padding:12px 14px; border-radius:16px 16px 0 0; }
.lv2-group-order { background:var(--af2-surface-order); color:var(--af2-ink-order); }
.lv2-group-physical { background:var(--af2-surface-physical); color:var(--af2-ink-physical); }
.lv2-group-money { background:var(--af2-surface-money); color:var(--af2-ink-money); }
.lv2-complete .lv2-group-heading .seg-title { color:inherit; }
.lv2-complete .cust-card, .lv2-complete .section, .lv2-complete .money-card { margin:0 16px 12px; padding:16px; border-radius:0 0 16px 16px; border:0; box-shadow:none; }
.lv2-complete .money-card { background:var(--af2-surface-money); border-radius:0; }
.lv2-complete .money-amount { color:var(--af2-ink); font-size:30px; line-height:38px; }
.lv2-complete .section-collect { border-radius:0 0 16px 16px; }
.lv2-complete .section-title-row { gap:10px; }
.lv2-complete .goods-row { align-items:center; flex-wrap:nowrap; gap:12px; padding:12px 0; }
.lv2-sku-thumb { width:56px; height:56px; display:flex; flex:none; align-items:center; justify-content:center; border-radius:12px; background:var(--af2-surface-neutral); overflow:hidden; }
.lv2-sku-thumb image { width:100%; height:100%; }
.lv2-sku-fallback { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }
.lv2-complete .goods-name { min-width:0; flex:1; font-size:15px; line-height:22px; }
.lv2-complete .goods-qty { font-size:16px; line-height:24px; max-width:35%; white-space:normal; }
.lv2-quantity-label { display:flex; flex-wrap:wrap; gap:6px 12px; justify-content:space-between; align-items:baseline; width:100%; }
.lv2-quantity-context { color:var(--af2-muted); font-size:13px; line-height:20px; }
.lv2-complete .barrel-row { gap:12px; }
.lv2-complete .barrel-stepper { align-self:flex-start; }
.lv2-complete .step-btn { background:var(--af2-surface-physical); color:var(--af2-ink-physical); }
.lv2-complete .item-return + .item-return { margin-top:8px; }
.lv2-complete .b2-reason-entry { margin-top:8px; }
.lv2-complete .b2-photo-add { min-height:60px; width:auto; flex:1 1 160px; padding:8px; border:1px dashed var(--af2-line); border-radius:12px; }
.lv2-complete .photo-item { width:88px; height:88px; border-radius:12px; }
.lv2-complete .photo-grid { gap:10px; }
.lv2-optional { font-size:13px; font-weight:400; color:var(--af2-muted); }
.lv2-complete .modal-content { box-sizing:border-box; border-radius:20px 20px 0 0; max-height:82vh; padding:16px 20px calc(20px + env(safe-area-inset-bottom)); }
.lv2-sheet-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px; }
.lv2-complete .lv2-sheet-head .modal-title { margin:0; font-size:18px; line-height:26px; text-align:left; }
.lv2-complete .modal-desc { font-size:14px; line-height:22px; text-align:left; }
.lv2-complete .modal-item { min-height:52px; }
@media(max-width:340px) { .lv2-complete .goods-row { gap:8px; } .lv2-sku-thumb { width:48px; height:48px; } .lv2-complete .goods-qty { max-width:32%; } }

/* Local camera outline: V0 has no camera name; never use a generic fallback for proof. */
.lv2-proof-glyph { box-sizing:border-box; position:relative; flex:none; width:24px; height:18px; border:1.5px solid var(--af2-ink-neutral); border-radius:4px; }
.lv2-proof-glyph::before { content:""; position:absolute; top:-5px; left:5px; width:9px; height:4px; border:1.5px solid var(--af2-ink-neutral); border-bottom:0; border-radius:3px 3px 0 0; }
.lv2-proof-glyph view { box-sizing:border-box; position:absolute; left:7px; top:3px; width:8px; height:8px; border:1.5px solid var(--af2-ink-neutral); border-radius:50%; }
.lv2-complete .section { border-radius:16px; }
.lv2-complete .lv2-return-section, .lv2-complete .section-collect, .lv2-complete .lv2-money-standalone { border-radius:0 0 16px 16px; }
.lv2-complete .money-amount, .lv2-complete .money-amount-muted, .lv2-complete .collect-sub-text { min-width:0; max-width:100%; white-space:normal; word-break:break-all; overflow-wrap:anywhere; }
