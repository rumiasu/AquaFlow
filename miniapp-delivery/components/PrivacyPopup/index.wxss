.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.privacy-popup {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  text-align: center;
  margin-bottom: 32rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 48rpx;
}

/* display: inline 是必需的：链接已由 <text> 改成 <navigator>（open-type="openPrivacyContract"），
   navigator 默认块级，不加这一行「…请仔细阅读并同意《用户隐私保护指引》。」会被拆成三行。 */
.privacy-link {
  color: var(--primary-color);
  display: inline;
}

.privacy-buttons {
  display: flex;
  gap: 24rpx;
}

.btn-reject {
  flex: 1;
  background: var(--bg-gray);
  color: #666666;
  border: none;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  padding: 24rpx 0;
}

.btn-reject::after {
  border: none;
}

.btn-agree {
  flex: 1;
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.btn-agree::after {
  border: none;
}

.privacy-dialog, .privacy-popup { box-sizing: border-box; width: calc(100% - 48rpx); max-height: 85vh; overflow-y: auto; padding: 32rpx 24rpx; border-radius: var(--radius-lg); }
.privacy-btn, .btn-reject, .btn-agree { min-height: 96rpx; height: auto; line-height: 1.5; padding: 24rpx 12rpx; box-sizing: border-box; font-size: 28rpx; }
.privacy-btn.reject, .btn-reject { color: var(--text-regular); background: var(--bg-gray); }
