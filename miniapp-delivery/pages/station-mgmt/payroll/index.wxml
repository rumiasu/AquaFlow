<!-- 站长端「计件工资」：单价配置 + 结算单 + 自定义工资条目（v44）。规格见 docs/design/18。
     状态 / 方向文案一律用服务端下发的 statusText / directionText，本页不自带 1/2 映射表。

     2026-10-07：按三份最终 HTML 适配手机比例；原有配置、筛选、人工调整与明细继续保留。 -->
<view class="page">

  <view class="tabs">
    <view class="tab {{tab === 'rate' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="rate">计件单价</view>
    <view class="tab {{tab === 'settle' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="settle">结算单</view>
    <view class="tab {{tab === 'items' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="items">自定义条目</view>
    <view class="tab-help" bindtap="onShowHelp">怎么算</view>
  </view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="load-error" wx:if="{{payrollReadError}}">
    <text>{{payrollReadError}}。{{loaded ? '以下为上次取回资料，重新核对后可操作。' : '请重新加载工资资料。'}}</text>
    <button class="retry-button" bindtap="loadAll" disabled="{{loading}}">重新加载</button>
  </view>

  <!-- ============ 计件单价 ============ -->
  <block wx:if="{{tab === 'rate'}}">
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">计件单价</text>
        <help-tip title="计件单价" text="{{tips.rate}}" />
      </view>
      <text class="card-sub">先点一个商品，再填它的计件单价。</text>

      <view class="product-list">
        <view class="product-card product-default {{rateForm.productId === '0' ? 'product-selected' : ''}}"
              bindtap="onRateProduct" data-id="{{0}}">
          <view class="product-image default-image"><text>¥</text></view>
          <view class="product-copy">
            <text class="product-name">默认单价</text>
            <text class="product-spec">所有商品兜底</text>
            <text class="product-price">{{defaultCurrentText}}</text>
          </view>
          <text class="product-check" wx:if="{{rateForm.productId === '0'}}">✓</text>
        </view>
        <view class="product-card {{rateForm.productId === item.id + '' ? 'product-selected' : ''}}"
              wx:for="{{rateProducts}}" wx:key="id" bindtap="onRateProduct" data-id="{{item.id}}">
          <image class="product-image" wx:if="{{item.imageUrl && !item.imageFailed}}" src="{{item.imageUrl}}"
                 mode="aspectFit" binderror="onProductImageError" data-id="{{item.id}}" />
          <view class="product-image product-placeholder" wx:else><text>商品</text><text>暂无图片</text></view>
          <view class="product-copy">
            <text class="product-name">{{item.name}}</text>
            <text class="product-spec">{{item.spec || '规格未填写'}}</text>
            <text class="product-price">{{item.currentRateText}}</text>
          </view>
          <text class="product-check" wx:if="{{rateForm.productId === item.id + ''}}">✓</text>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="card-title rate-form-title">{{selectedRateName}}</text>
      <text class="card-sub" wx:if="{{rateForm.productId !== '0'}}">楼层补贴统一按默认单价中的楼层设置计算。</text>
      <view class="field">
        <text class="label">每送 1 {{selectedRateUnit}}</text>
        <input class="input" type="digit" value="{{rateForm.perBucketAmount}}"
               disabled="{{savingRate}}" bindinput="onRateInput" data-field="perBucketAmount" placeholder="{{'元/' + selectedRateUnit}}" />
      </view>
      <view class="field">
        <text class="label">楼层补贴 / 层</text>
        <input class="input" type="digit" value="{{rateForm.floorBonusPerLevel}}"
               disabled="{{savingRate}}" bindinput="onRateInput" data-field="floorBonusPerLevel" placeholder="元/层" />
      </view>
      <view class="field">
        <text class="label">几层以内不补</text>
        <input class="input" type="number" value="{{rateForm.floorFreeLevel}}"
               disabled="{{savingRate}}" bindinput="onRateInput" data-field="floorFreeLevel" placeholder="层数" />
      </view>

      <button class="btn-primary" disabled="{{!isManager || savingRate || loading || payrollReadError}}" bindtap="onSaveRate">
        {{savingRate ? '保存中…' : '保存'}}
      </button>
    </view>

    <view class="card" wx:if="{{rates.length}}">
      <view class="card-title-row">
        <text class="card-title">已配单价</text>
        <text class="card-count">{{rates.length}} 条</text>
      </view>
      <view class="row configured-rate {{item.isDefault ? 'configured-default' : ''}}" wx:for="{{rates}}" wx:key="id">
        <view class="row-main">
          <text class="row-title">{{item.productName}}</text>
          <text class="row-sub">每{{item.quantityUnit}} ¥{{item.perBucketAmount}} · 楼层 ¥{{item.floorBonusPerLevel}}/层（{{item.floorFreeLevel}} 层内免）</text>
        </view>
      </view>
    </view>
    <!--
      未配单价时的空态：必须说清后果，否则站长看到空台账分不清「没配」与「这月没人送水」。
      后果的判据在服务端 StaffEarningServiceImpl（rateOf 商品专属价优先、回落 product_id=0；
      两处都没有即全 0；楼层补贴同样只读 product_id=0 那一行）—— 见 index.js 的 decorateRates。
      文案在 js 里拼好（rateEmptyText）再下发：wxml 属性里做带 \n 的拼接会编译报错，且门禁查不出。
      文案不许出现开发词（接口/后端/字段/落库…），也不许写 markdown 的星号粗体 —— text 会原样渲染。
    -->
    <view class="card" wx:if="{{!loading && !payrollReadError && !rates.length}}">
      <view class="card-title-row">
        <text class="card-title">已配单价</text>
        <text class="card-count">0 条</text>
      </view>
      <view class="empty">{{rateEmptyText}}</view>
    </view>
    <!-- 有商品的专属价是 0：默认价兜不住它（专属价优先），那款水完成配送就是 0 元 -->
    <view class="card" wx:if="{{hasProductZero}}">
      <view class="card-title-row">
        <text class="card-title">注意</text>
      </view>
      <view class="empty">{{productZeroText}}</view>
    </view>
  </block>

  <!-- ============ 结算单 ============ -->
  <block wx:if="{{tab === 'settle'}}">
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">生成结算单</text>
        <help-tip title="结算单期间" text="{{tips.period}}" />
      </view>
      <text class="card-sub">选人 + 选期间，一次把这个期间里还没结的工钱都结进去。</text>
      <view class="empty" wx:if="{{!loading && !payrollReadError && !staffList.length}}">本站还没有员工。</view>
      <block wx:else>
        <view class="field">
          <text class="label">配送员</text>
          <picker mode="selector" range="{{staffList}}" range-key="name" bindchange="onGenStaff">
            <view class="picker {{genForm.staffId ? '' : 'picker-empty'}}">
              <block wx:for="{{staffList}}" wx:key="id">
                <text wx:if="{{item.id === genForm.staffId}}">{{item.name}}</text>
              </block>
              <text wx:if="{{!genForm.staffId}}">请选择</text>
            </view>
          </picker>
        </view>
        <view class="field-2col">
          <view class="field col">
            <text class="label">开始</text>
            <picker mode="date" value="{{genForm.periodStart}}" bindchange="onGenDate" data-field="periodStart">
              <view class="picker {{genForm.periodStart ? '' : 'picker-empty'}}">{{genForm.periodStart || '请选择'}}</view>
            </picker>
          </view>
          <view class="field col">
            <text class="label">结束</text>
            <picker mode="date" value="{{genForm.periodEnd}}" bindchange="onGenDate" data-field="periodEnd">
              <view class="picker {{genForm.periodEnd ? '' : 'picker-empty'}}">{{genForm.periodEnd || '请选择'}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <text class="label">备注（可选）</text>
          <input class="input" value="{{genForm.note}}" bindinput="onGenNote" placeholder="如 9 月上半月" />
        </view>
        <button class="btn-primary" disabled="{{!isManager || generating || loading || payrollReadError}}" bindtap="onGenerate">
          {{generating ? '生成中…' : '生成结算单'}}
        </button>
      </block>
    </view>

    <view class="card">
      <view class="card-title-row">
        <text class="card-title">人工调整</text>
        <help-tip title="人工调整" text="{{tips.adjust}}" />
      </view>
      <!-- 与钱直接相关的那句必须留在屏幕上，不能只藏在「?」里 -->
      <text class="card-sub">这笔会进结算单；补钱填正数，扣钱填负数（如 -50）。</text>
      <view class="field">
        <text class="label">配送员</text>
        <picker mode="selector" range="{{staffList}}" range-key="name" bindchange="onAdjustStaff">
          <view class="picker {{adjustForm.staffId ? '' : 'picker-empty'}}">
            <block wx:for="{{staffList}}" wx:key="id">
              <text wx:if="{{item.id === adjustForm.staffId}}">{{item.name}}</text>
            </block>
            <text wx:if="{{!adjustForm.staffId}}">请选择</text>
          </view>
        </picker>
      </view>
      <view class="field">
        <text class="label">金额</text>
        <input class="input" type="digit" value="{{adjustForm.amount}}"
               bindinput="onAdjustInput" data-field="amount" placeholder="扣钱请填负数，如 -50" />
      </view>
      <view class="field">
        <text class="label">原因</text>
        <input class="input" value="{{adjustForm.note}}" bindinput="onAdjustInput"
               data-field="note" placeholder="建议写清楚，对账要看" />
      </view>
      <button class="btn-ghost" disabled="{{!isManager || adjusting || loading || payrollReadError}}" bindtap="onAdjust">
        {{adjusting ? '提交中…' : '提交调整'}}
      </button>
    </view>

    <view class="card">
      <view class="card-title-row">
        <text class="card-title">结算单历史</text>
        <text class="card-count">{{filteredPayrolls.length}} 张匹配</text>
      </view>
      <input class="payroll-search" value="{{payrollKeyword}}" placeholder="筛选员工姓名或编号" bindinput="onPayrollSearch" />
      <view class="payroll-date-row"><picker mode="date" value="{{payrollStart}}" data-field="payrollStart" bindchange="onPayrollFilterDate"><view>{{payrollStart || '期间开始'}}</view></picker><text>至</text><picker mode="date" value="{{payrollEnd}}" data-field="payrollEnd" bindchange="onPayrollFilterDate"><view>{{payrollEnd || '期间结束'}}</view></picker><text bindtap="onClearPayrollFilter">清除筛选</text></view>
      <view class="hint">{{payrollScope}} 按结算期间与所选日期相交筛选。</view>
      <view class="empty" wx:if="{{payrollMoreError}}">{{payrollMoreError}}。已加载记录保留，点击下方重试。</view>
      <button class="btn-ghost" wx:if="{{payrollHasMore}}" bindtap="onExpandPayrollHistory"
              disabled="{{!isManager || loading || payrollLoadingMore || payrollReadError}}">
        {{payrollLoadingMore ? '正在加载更早记录…' : payrollMoreError ? '重试加载更早记录' : '继续加载更早记录'}}
      </button>
      <view class="empty" wx:if="{{payrollListError}}" bindtap="loadAll">{{payrollListError}} · 点击重试</view>
      <view class="empty" wx:elif="{{!loading && !filteredPayrolls.length}}">当前已加载范围内没有匹配的结算单。</view>
      <view class="slip" wx:for="{{filteredPayrolls}}" wx:key="id" bindtap="onOpenPayroll" data-id="{{item.id}}">
        <view class="slip-top">
          <view class="slip-person"><text class="slip-label">配送员</text><text class="slip-name">{{item.staffName}}</text></view>
          <text class="pill {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="slip-money">
          <text class="slip-amount">¥{{item.totalAmount}}</text>
          <text class="slip-period">{{item.periodText}}</text>
        </view>
        <text class="slip-sub" wx:if="{{item.paidTime}}">发放时间 {{item.paidTime}}</text>
        <text class="slip-sub" wx:if="{{item.note}}">备注：{{item.note}}</text>
        <view class="slip-actions">
          <button class="slip-action slip-action-main" wx:if="{{isManager && item.status === 1}}" catchtap="onConfirmPayroll"
                  disabled="{{payrollBusyId !== null || loading || payrollReadError}}" data-id="{{item.id}}">{{payrollBusyId === item.id ? '处理中…' : '确认结算单'}}</button>
          <button class="slip-action slip-action-pay" wx:if="{{isManager && item.status === 2}}" catchtap="onPayPayroll"
                  disabled="{{payrollBusyId !== null || loading || payrollReadError}}" data-id="{{item.id}}">{{payrollBusyId === item.id ? '处理中…' : '标记发放'}}</button>
          <button class="slip-action slip-action-detail" catchtap="onOpenPayroll" data-id="{{item.id}}">查看明细</button>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 自定义工资条目（v44） ============ -->
  <block wx:if="{{tab === 'items'}}">
    <view class="card">
      <view class="card-title-row">
        <text class="card-title">{{itemForm.id ? '编辑条目' : '新增条目'}}</text>
        <help-tip title="自定义条目" text="{{tips.item}}" />
      </view>
      <!-- [2026-09-26] 产品反馈：要说清"这类钱系统不会自己算"。这句话与钱直接相关，留在屏幕上 -->
      <text class="card-sub">系统不会自己算这类钱：名目你自己定，每次的金额也要你自己填。</text>
      <view class="field">
        <text class="label">条目名称</text>
        <input class="input" value="{{itemForm.name}}" bindinput="onItemName" disabled="{{savingItem}}"
               placeholder="如 高温补贴 / 迟到扣款（20 字以内）" />
      </view>
      <view class="field">
        <text class="label">方向</text>
        <view class="direction-options">
          <button class="direction-option {{itemForm.direction === item.value ? 'direction-selected' : ''}}"
                  wx:for="{{directions}}" wx:key="value" data-index="{{index}}" bindtap="onItemDirection"
                  disabled="{{savingItem}}">{{item.text}}</button>
        </view>
      </view>
      <view class="field">
        <text class="label">排序（可选）</text>
        <input class="input" type="number" value="{{itemForm.sort}}" bindinput="onItemSort" disabled="{{savingItem}}"
               placeholder="数字小的排前面" />
      </view>
      <button class="btn-primary" disabled="{{!isManager || savingItem || itemBusyId !== null || loading || payrollReadError}}" bindtap="onSaveItem">
        {{savingItem ? '保存中…' : (itemForm.id ? '保存修改' : '新增条目')}}
      </button>
      <button class="btn-ghost" wx:if="{{itemForm.id}}" disabled="{{savingItem}}" bindtap="onItemFormReset">取消编辑</button>
    </view>

    <view class="card">
      <view class="card-title-row">
        <text class="card-title">自定义条目</text>
        <text class="card-count">{{items.length}} 条</text>
      </view>
      <view class="empty" wx:if="{{!loading && !payrollReadError && !items.length}}">
        还没有自定义条目。
        加项/扣项定义一次，以后录钱选一下就行（如「高温补贴」「迟到扣款」）。
      </view>
      <view class="row item-card" wx:for="{{items}}" wx:key="id">
        <view class="row-main">
          <view class="row-between">
            <text class="row-title">{{item.name}}</text>
            <text class="pill {{item.enabled ? 'pill-on' : 'pill-off'}}">{{item.directionText}}</text>
          </view>
          <text class="row-sub">
            {{item.enabled ? '启用中 · 录钱时可选' : '已停用 · 不再出现在录钱入口（历史流水照旧）'}}
          </text>
          <view class="actions-row">
            <button class="item-record" catchtap="onRecordOpen" data-id="{{item.id}}"
                    disabled="{{!isManager || !item.enabled || recording || itemBusyId !== null || loading || payrollReadError}}">{{item.enabled ? '记一笔' : '已停用'}}</button>
            <button class="item-more" catchtap="onItemMore" data-id="{{item.id}}" aria-label="{{item.name + '的更多操作'}}"
                    disabled="{{!isManager || itemBusyId !== null || savingItem || recording || loading || payrollReadError}}">⋯</button>
          </view>
          <text class="item-more-hint">更多操作：改名/改方向 · {{item.enabled ? '停用' : '启用'}} · 删除</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title-row">
        <text class="card-title">未结算明细</text>
        <help-tip title="按条目汇总" text="{{tips.itemSummary}}" />
      </view>
      <view class="empty" wx:if="{{!staffList.length}}">本站还没有员工。</view>
      <view class="field" wx:else>
        <text class="label">配送员</text>
        <picker mode="selector" range="{{staffList}}" range-key="name" bindchange="onSummaryStaff">
          <view class="picker {{summaryStaffId ? '' : 'picker-empty'}}">
            <block wx:for="{{staffList}}" wx:key="id">
              <text wx:if="{{item.id === summaryStaffId}}">{{item.name}}</text>
            </block>
            <text wx:if="{{!summaryStaffId}}">请选择</text>
          </view>
        </picker>
      </view>

      <view class="empty" wx:if="{{summaryLoading}}">加载中…</view>

      <view class="load-error" wx:if="{{!summaryLoading && summaryError}}" bindtap="loadSummary">{{summaryError}} · 点击重试</view>
      <block wx:if="{{!summaryLoading && !summaryError && summaryStaffId}}">
        <view class="sum-box" wx:if="{{itemSummary.length}}">
          <view class="sum-title">按条目汇总（只统计带条目的流水）</view>
          <view class="sum-row" wx:for="{{itemSummary}}" wx:key="itemId">
            <text class="sum-name">{{item.name}}</text>
            <text class="sum-dir">{{item.directionText}}</text>
            <text class="sum-amount {{item.total > 0 ? 'sum-add' : 'sum-deduct'}}">{{item.total > 0 ? '+' : ''}}{{item.total}}</text>
          </view>
        </view>

        <view class="row" wx:for="{{summaryEarnings}}" wx:key="id">
          <view class="row-main">
            <view class="row-between">
              <text class="row-title">{{item.displayText}}</text>
              <text class="row-amount {{item.amount > 0 ? 'sum-add' : 'sum-deduct'}}">¥{{item.amount}}</text>
            </view>
            <text class="row-sub">
              {{item.dateText}}
              <text wx:if="{{item.qty}}"> · {{item.qty}} × ¥{{item.unitAmount}}</text>
              <text wx:if="{{item.orderId}}"> · 订单 #{{item.orderId}}</text>
              <text wx:if="{{item.note}}"> · {{item.note}}</text>
            </text>
          </view>
        </view>
        <view class="empty" wx:if="{{!summaryEarnings.length}}">这位配送员还没有未结算的收益。</view>
        <view class="row-between sum-total" wx:if="{{summaryEarnings.length}}">
          <text class="sum-dir">未结合计（含没有条目的调整）</text>
          <text class="row-amount">¥{{unsettledTotal}}</text>
        </view>
      </block>
    </view>
  </block>

  <!-- 明细 -->
  <view class="mask" wx:if="{{detail || detailLoading || detailError}}" bindtap="onCloseDetail"></view>
  <view class="dialog" wx:if="{{detail || detailLoading || detailError}}">
    <text class="dialog-title">{{detailName}} 的结算单</text>
    <view class="empty" wx:if="{{detailLoading}}">加载中…</view>
    <view class="load-error" wx:if="{{detailError}}" bindtap="onRetryDetail">{{detailError}} · 点击重试</view>
    <button class="btn-ghost" wx:if="{{!detail}}" bindtap="onCloseDetail">关闭</button>
    <block wx:if="{{detail}}">
      <view class="slip-hero">
        <text class="slip-hero-amount">¥{{detail.payroll.totalAmount}}</text>
        <text class="slip-hero-label">合计</text>
      </view>
      <view class="kv"><text class="kv-k">单号</text><text class="kv-v">{{detail.payroll.payrollNo}}</text></view>
      <view class="kv"><text class="kv-k">期间</text><text class="kv-v">{{detail.payroll.periodText}}</text></view>
      <view class="kv"><text class="kv-k">状态</text><text class="kv-v">{{detail.payroll.statusText}}</text></view>
      <view class="sum-box" wx:if="{{detail.itemSummary.length}}">
        <view class="sum-title">按条目汇总（只统计带条目的流水）</view>
        <view class="sum-row" wx:for="{{detail.itemSummary}}" wx:key="itemId">
          <text class="sum-name">{{item.name}}</text>
          <text class="sum-dir">{{item.directionText}}</text>
          <text class="sum-amount {{item.total > 0 ? 'sum-add' : 'sum-deduct'}}">{{item.total > 0 ? '+' : ''}}{{item.total}}</text>
        </view>
      </view>
      <scroll-view class="detail-scroll" scroll-y>
        <view class="row" wx:for="{{detail.earnings}}" wx:key="id">
          <view class="row-main">
            <!-- 明细行只认服务端算好的 displayText（带条目的显示条目名，其余回落 kindText） -->
            <view class="row-between">
              <text class="row-title">{{item.displayText}}</text>
              <text class="row-amount">¥{{item.amount}}</text>
            </view>
            <text class="row-sub">
              {{item.dateText}}
              <text wx:if="{{item.qty}}"> · {{item.qty}} × ¥{{item.unitAmount}}</text>
              <text wx:if="{{item.orderId}}"> · 订单 #{{item.orderId}}</text>
            </text>
            <text class="row-sub" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
        </view>
        <view class="empty" wx:if="{{!detail.earnings.length}}">这张结算单没有明细。</view>
      </scroll-view>
      <view class="btn-ghost" bindtap="onCloseDetail">关闭</view>
    </block>
  </view>

  <!-- 「记一笔」：选中条目后只填正数金额，加还是扣由条目决定（v44）。 -->
  <view class="mask" wx:if="{{record}}" bindtap="onRecordClose"></view>
  <view class="dialog" wx:if="{{record}}">
    <text class="dialog-title">记一笔 · {{record.itemName}}</text>
    <!-- 手填提示放在最上面：用户点进来第一眼就知道"金额得自己填" -->
    <text class="card-sub">金额要你自己填；加还是扣，由这个条目决定。</text>
    <view class="kv"><text class="kv-k">方向</text><text class="kv-v">{{record.directionText}}</text></view>
    <view class="empty" wx:if="{{!staffList.length}}">本站还没有员工。</view>
    <view class="field" wx:else>
      <text class="label">配送员</text>
        <picker mode="selector" range="{{staffList}}" range-key="name" bindchange="onRecordStaff" disabled="{{recording}}">
        <view class="picker {{record.staffId ? '' : 'picker-empty'}}">
          <block wx:for="{{staffList}}" wx:key="id">
            <text wx:if="{{item.id === record.staffId}}">{{item.name}}</text>
          </block>
          <text wx:if="{{!record.staffId}}">请选择</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">金额</text>
      <input class="input" type="digit" value="{{record.amount}}" bindinput="onRecordInput"
             disabled="{{recording}}" data-field="amount" placeholder="填正数，如 50" />
    </view>
    <view class="field">
      <text class="label">备注（可选）</text>
      <input class="input" value="{{record.note}}" bindinput="onRecordInput"
             disabled="{{recording}}" data-field="note" placeholder="如 7 月高温补贴" />
    </view>
    <button class="btn-primary" disabled="{{!isManager || recording || !staffList.length}}" bindtap="onRecordSubmit">
      {{recording ? '提交中…' : '确认记一笔'}}
    </button>
    <button class="btn-ghost" disabled="{{recording}}" bindtap="onRecordClose">取消</button>
  </view>

  <!-- 更多操作只从当前条目取 id；取消或切 Tab 都丢弃菜单选择。 -->
  <view class="mask menu-mask" wx:if="{{itemMenuId !== null}}" bindtap="onItemMenuClose" catchtouchmove="onStopTap"></view>
  <view class="item-menu" wx:if="{{itemMenuId !== null}}" catchtap="onStopTap">
    <text class="menu-title">{{itemMenuName}}</text>
    <button class="menu-action" data-action="edit" bindtap="onItemMenuAction">改名 / 改方向</button>
    <button class="menu-action" data-action="toggle" bindtap="onItemMenuAction">{{itemMenuEnabled ? '停用' : '启用'}}</button>
    <button class="menu-action menu-danger" data-action="delete" bindtap="onItemMenuAction">删除条目</button>
    <text class="menu-hint">用过的条目只能停用，历史流水保留。</text>
    <button class="menu-cancel" bindtap="onItemMenuClose">取消</button>
  </view>

</view>
