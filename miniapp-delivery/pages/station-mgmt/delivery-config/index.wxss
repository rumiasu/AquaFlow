/* 配送计费配置（v36+）：沿用站内其它管理页的卡片 + 选项样式约定 */
.container {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 36rpx;
  margin-top: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.badge-on {
  background: #e8f7ee;
  color: #1a9c53;
}

.badge-warn {
  background: #fff4e5;
  color: #c47b00;
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #444;
  margin: 20rpx 0 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.options {
  display: flex;
  flex-direction: column;
}

.option {
  border: 2rpx solid #e6e8eb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.option.active {
  border-color: #1a9c53;
  background: #f2fbf6;
}

.option-name {
  display: block;
  font-size: 28rpx;
  color: #222;
}

.option-desc {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 32rpx;
}

.btn-primary {
  margin-top: 24rpx;
  background: #1a9c53;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
