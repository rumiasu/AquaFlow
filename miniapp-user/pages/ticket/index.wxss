.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 水票余额卡片 */
.ticket-balance-card {
  margin: 24rpx;
  padding: 28rpx;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: none;
}

.balance-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.balance-label {
  font-size: 26rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.balance-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.balance-count {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.balance-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.balance-total {
  font-size: 26rpx;
  color: #fff;
  line-height: 1.6;
}

.balance-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

/* 标签栏 */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-regular);
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.tab-content {
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* 水票列表 */
.ticket-list {
  background-color: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: none;
}

.ticket-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.ticket-item:last-child {
  border-bottom: none;
}

.ticket-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  word-break: break-all;
}

.ticket-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.ticket-spec {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 「本票可用于购买该款水」—— 说明的是适用范围（一条账户 = 一款水），是整句信息不是占位灰。
   颜色用 --text-regular，适用范围不降为占位色。
   字号 24rpx：§6 允许辅助信息 24–26rpx，这里不是关键规则。 */
.ticket-use {
  font-size: 26rpx;
  color: var(--text-regular);
}

.ticket-expire {
  font-size: 26rpx;
  color: var(--text-regular);
}

.ticket-quantity {
  display: flex;
  align-items: baseline;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.quantity-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.quantity-unit {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 消费记录 */
.record-list {
  background-color: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: none;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  word-break: break-all;
}

.record-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.record-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.record-quantity {
  display: flex;
  align-items: baseline;
}

.quantity-change {
  font-size: 28rpx;
  font-weight: 600;
}

.quantity-change.increase {
  color: var(--success-color);
}

.quantity-change.decrease {
  color: var(--error-color);
}

/* 购买水票按钮 */
.buy-ticket-section {
  padding: 32rpx 24rpx;
}

.buy-ticket-btn {
  height: auto;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none; min-height:44px; display:flex; align-items:center; justify-content:center; }

.buy-ticket-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.buy-ticket-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 购买弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-body {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-placeholder);
  padding: 0 8rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-scroll {
  flex: 1;
  max-height: 58vh;
  min-height: 0;
}

.modal-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin: 20rpx 0 12rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-item {
  padding: 16rpx 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  max-width: 100%;
  word-break: break-all;
}

.product-item.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.product-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.product-price {
  font-size: 26rpx;
  color: var(--price-color);
}

.qty-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 88rpx;
  height: auto;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
  flex-shrink: 0; min-height:44px; display:flex; align-items:center; justify-content:center; }

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-input {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  min-width: 0;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.method-item.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
}

.method-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-color);
}

.method-radio.checked {
  border-color: var(--primary-color);
  background: var(--primary-color);
  box-shadow: inset 0 0 0 6rpx #fff;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: auto;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
}

.modal-btn.cancel {
  border: 2rpx solid var(--border-color);
}

.modal-btn.cancel text {
  color: var(--text-regular);
  font-size: 14px;
}

.modal-btn.confirm {
  background: var(--primary-color);
  box-shadow: none;
}

.modal-btn.confirm text {
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.modal-btn.confirm.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}

/* ---- 水票档位（价目表） ---- */

.pkg-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pkg-item {
  flex: 1;
  min-width: 180rpx;
  padding: 18rpx 16rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
}

.pkg-item.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.pkg-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.pkg-price {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.pkg-sub {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.6;
}

.pkg-clear {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  text-align: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pkg-lock {
  display: block;
  font-size: 26rpx;
  color: var(--text-regular);
  margin-top: 8rpx;
  line-height: 32rpx;
}

/* 当前水站提示条（2026-09-20）：水票/押金/桶权益按「客户 × 水站」隔离，
   页面要能一眼看出"这是哪个站的账"。样式与 pages/deposit/records 同名类保持一致。 */
.station-bar {
  display: flex;
  flex-direction: column;
  padding: 4rpx 8rpx 20rpx;
}

.station-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-bar-tip {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* [2026-10-07 #15] 退出说明帮助链接：低调的文字链，不做按钮 */
.ticket-help {
  margin: 0 24rpx 12rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.ticket-help text {
  font-size: 26rpx;
  color: var(--text-secondary);
  border-bottom: 1rpx solid var(--text-placeholder);
}

/* [2026-10-07 #15] 原购买恢复卡：替代"错误条里塞裸 button"。
   原购买 = 钱可能已付出但未核实，需要独立卡片与按钮主次（主/次/危险）。
   底色走 --warning-bg（2026-10-07 新增 token，docs/design/36 §1.1）。 */
.recovery-card {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-gray);
  border-left: 6rpx solid var(--warning-color);
}
.recovery-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}
.recovery-text {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.5;
}
.recovery-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
/* 原生 <button> 改形：清默认样式，disabled 态由 [disabled] 选择器表达（闸门仍在元素上） */
button.recovery-btn {
  margin: 0;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 14px;
  line-height: 1.4;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 240rpx;
}
button.recovery-btn::after {
  border: none;
}
button.recovery-btn[disabled] {
  opacity: 0.45;
}
.recovery-btn-primary {
  background: var(--primary-color);
  color: #fff;
}
.recovery-btn-plain {
  background: var(--bg-white);
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}
.recovery-btn-danger {
  background: transparent;
  color: var(--error-color);
  border: 1rpx solid var(--error-color);
}
.stale-note { display: block; padding: 20rpx 24rpx; color: var(--warning-color); background: var(--bg-gray); font-size: 26rpx; line-height: 1.65; border-left: 4rpx solid var(--warning-color); }
.modal-label, .pkg-sub, .pkg-lock, .ticket-expire, .ticket-use, .record-time { font-size: 26rpx; line-height: 1.65; }
.modal-close, .ticket-help, .pkg-clear, .load-error > view { min-height: 88rpx; display: flex; align-items: center; }

/* 本页所有状态共用的可读与触控边界。 */
.modal-close { color: var(--text-regular); }
.modal-label { color: var(--text-regular); }
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.pkg-item { min-width: 0; overflow-wrap: anywhere; }
.load-error button { min-height: 44px; font-size: 14px; padding: 18rpx; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
.modal-btn.confirm[disabled], .modal-btn.confirm.disabled { background: var(--bg-gray); color: var(--text-regular); }
.modal-btn.confirm[disabled] text, .modal-btn.confirm.disabled text { color: var(--text-regular); }
.purchase-copies-error { display:block; margin-top:16rpx; color:var(--danger-color, #C53929); font-size:26rpx; line-height:1.6; }
.purchase-copies { padding:28rpx; margin:24rpx 0; background:var(--bg-gray); border-radius:16rpx; }
.copies-heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16rpx; font-size:30rpx; font-weight:600; line-height:1.5; }
.copies-heading text + text { color:var(--text-regular); font-size:26rpx; font-weight:400; }
.purchase-copies .qty-row { justify-content:flex-start; gap:16rpx; margin:24rpx 0; }
.purchase-copies .qty-btn { margin:0; min-width:44px; min-height:44px; padding:8rpx; height:auto; background:#fff; color:var(--primary-color); font-size:32rpx; line-height:1.5; }
.purchase-copies .qty-input { max-width:180rpx; min-height:44px; background:#fff; border:1rpx solid var(--border-color); border-radius:10rpx; font-size:34rpx; font-weight:600; }
.purchase-total { display:flex; justify-content:space-between; gap:16rpx; padding-top:20rpx; border-top:1rpx solid var(--border-color); font-size:32rpx; font-weight:600; line-height:1.5; }

/* 2026-10-28：余额与购买同行，历史保持次级；套餐纵向显示避免长名称挤列。 */
.ticket-balance-card { background:#fff; border:1rpx solid var(--border-light); gap:20rpx; flex-wrap:wrap; }
.balance-left { flex:1 1 260rpx; }
.balance-label,.balance-total { color:var(--text-regular); font-size:14px; }
.balance-count { color:var(--text-primary); font-size:32px; }
.balance-unit { color:var(--text-regular); font-size:14px; }
.balance-buy { margin:0; min-height:48px; padding:12px 18px; line-height:1.5; font-size:16px; color:#fff; background:var(--primary-color); border-radius:12rpx; white-space:normal; }
.balance-buy[disabled] { background:var(--bg-gray); color:var(--text-regular); }
.tab-item,.ticket-help,.modal-close,.product-item,.method-item { min-height:44px; height:auto; box-sizing:border-box; }
.modal-close { min-width:44px; }
.ticket-name,.record-name,.product-name,.pkg-title { font-size:16px; line-height:1.5; }
.ticket-use,.ticket-spec,.record-time,.record-direction,.pkg-sub,.pkg-lock,.modal-label { font-size:14px; line-height:1.6; }
.record-direction { color:var(--text-regular); }
.pkg-list { display:flex; flex-direction:column; }
.pkg-item { flex:none; min-width:0; min-height:44px; text-align:left; padding:16px; }
.pkg-price { margin-top:8rpx; }
.product-list { flex-direction:column; }
.product-item { width:100%; }
.qty-btn,.qty-input,.modal-btn.confirm { min-height:48px; }
.modal-btn.cancel { flex:0 1 120px; }
.modal-footer { flex-wrap:wrap; }
.purchase-total { flex-wrap:wrap; }

.ui-draft-notice { margin:16rpx 24rpx; padding:20rpx; background:#fff; border:1rpx solid var(--border-light); border-radius:12rpx; font-size:14px; line-height:1.6; }
.ui-draft-notice .af-action { margin:4px 8px 0 0; }
.ui-draft-notice button::after { border:0; }

.modal-footer { gap:8px; }
.modal-footer .af-action--cancel { width:80px; }
.load-error button.af-action--quiet { padding:0; }

.pkg-item.active, .method-item.active { border-color:var(--af-primary); background:var(--af-soft); }
.tab-item.active { color:var(--af-primary); }

.tabs { padding:4px; background:var(--af-soft); border:0; }
.tab-item.af-choice { min-height:44px; height:auto; padding:6px 2px; }
.tab-item.active::after { display:none; }
.pkg-selected { color:var(--af-primary); font-weight:600; }

/* Visual v2: page hierarchy and semantic surfaces. */
.ticket-balance-card { background:var(--af2-surface-order); border-radius:14px; }
.ticket-balance-card .balance-label,.ticket-balance-card .balance-count,.ticket-balance-card .balance-unit { color:var(--af2-ink-order); }
.pkg-item.active { background:var(--af2-surface-order); border-color:var(--af2-ink-order); }
.pkg-selected { color:var(--af2-ink-order); }
.pkg-item { min-height:44px; box-sizing:border-box; }

.ticket-balance-card { gap:12px; align-items:center; }
.ticket-balance-card .balance-left { min-width:0; }

/* 抬高键盘或文案变长时，优先保留标题与底部操作，列表占剩余空间。 */
.modal-header,.modal-footer { flex-shrink:0; }
.modal-scroll { flex:1 1 auto; min-height:0; }
