<view class="page-container">
  <view class="header">
    <view class="user-row" bindtap="{{isLogin ? 'onEditProfile' : 'onLogin'}}">
      <image class="avatar" src="{{isLogin && userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/image/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{isLogin ? (userInfo.nickName || userInfo.nickname || '用户') : '点击登录'}}</text>
        <view class="user-tag" wx:if="{{isLogin}}">
          <text>普通用户</text>
        </view>
      </view>
      <icon name="arrow" size="32rpx" color="rgba(255,255,255,0.7)" />
    </view>
  </view>

  <view class="wallet-card" wx:if="{{isLogin}}">
    <view class="wallet-row">
      <view class="wallet-item">
        <text class="wallet-label">余额(元)</text>
        <text class="wallet-value">{{customerStats.balance || '0.00'}}</text>
      </view>
      <view class="wallet-divider"></view>
      <view class="wallet-item">
        <text class="wallet-label">押金(元)</text>
        <text class="wallet-value">{{barrelSummary ? barrelSummary.depositBalance : '0.00'}}</text>
      </view>
    </view>
    <view class="recharge-btn" bindtap="onRecharge">
      <icon name="plus" size="32rpx" color="#FFFFFF" />
      <text>充值</text>
    </view>
  </view>

  <view class="stats-card" wx:if="{{isLogin && customerStats}}">
    <view class="stats-grid">
      <view class="stat-item" bindtap="onGoOrder">
        <text class="stat-value">{{customerStats.totalOrders || 0}}</text>
        <text class="stat-label">累计订单</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" wx:for="{{isLogin ? loginMenu : guestMenu}}" wx:key="title"
      data-url="{{item.url}}" bindtap="onMenuTap">
      <view class="menu-icon-wrap">
        <icon name="{{item.icon}}" size="40rpx" color="#0EA5E9" />
      </view>
      <text class="menu-title">{{item.title}}</text>
      <icon name="arrow" size="28rpx" color="#CBD5E1" />
    </view>
  </view>

  <view class="invite-banner" wx:if="{{isLogin}}" bindtap="onInvite">
    <view class="invite-text">
      <text class="invite-title">邀请好友</text>
      <text class="invite-desc">邀请好友注册，双方均可获得优惠券</text>
    </view>
    <view class="invite-btn">
      <text>立即邀请</text>
    </view>
  </view>

  <button wx:if="{{isLogin}}" class="btn-logout" bindtap="onLogout">
    <icon name="logout" size="32rpx" color="#EF4444" />
    <text>退出登录</text>
  </button>
</view>
