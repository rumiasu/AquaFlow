/* 自绘导航栏 + 状态胶囊（.navbar* / .status-chip*）：与「首页」共用一份样式 */
@import "../../styles/station-navbar.wxss";

.home-station-identity { padding: 16rpx 24rpx; color: var(--text-regular); font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; }

/* ========== Tab 栏 ========== */
.tab-bar {
  display: flex; background: #fff; margin: 16rpx 24rpx 0; border-radius: 12rpx;
  box-shadow: none; overflow: hidden; position: relative; z-index: 2;
  border: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1; min-width: 0; text-align: center; padding: 24rpx 8rpx; font-size: 26rpx; color: var(--text-secondary); font-weight: 500; position: relative; transition: all 0.2s;
  min-height: 48px;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  align-items: center;
  justify-content: center;
}

.stat-label { font-size: 14px; opacity: 1; white-space: nowrap; }
.stat-unit { font-size: 13px; font-weight: 600; opacity: 1; white-space: nowrap; }

.tab-item.active { color: var(--primary-color); font-weight: 600; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 20%; right: 20%; height: 4rpx;
  background: var(--primary-color); border-radius: 2rpx;
}

/* ========== 订单列表 ========== */
.order-list { padding: 16rpx 24rpx; }

.order-card {
  background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: none; transition: transform 0.15s;
  border: 1rpx solid var(--border-color);
}

.order-card:active { transform: scale(0.98); }

/* ===== 「转给我的单」（待我确认的转单，[2026-09-27] 双方同意）=====
   与普通待配送卡刻意区分：左侧一道琥珀色边 + 浅底，因为它是一张**要我决定**的卡，
   不是"等着我去送"的卡。同意后它变成下面的普通卡（后端把归属改到我名下）。 */
.transfer-in-card {
  background: var(--bg-gray); border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx;
  border-left: 4rpx solid var(--warning-color); box-shadow: none;
}
.status-transfer { background: rgba(240,160,32,0.14); color: var(--warning-color); }
.transfer-from { font-size: 24rpx; color: var(--text-secondary); }
/* 不接受：次要动作，不做成和"同意"抢视线的实心按钮 */
.btn-reject-transfer {
  flex: 1; background: #fff; color: var(--text-regular); border: 1rpx solid var(--border-light);
  border-radius:12rpx; font-size: 14px; padding: 16rpx 0; line-height: 1.4;
}
.btn-reject-transfer::after { border: none; }

.card-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.status-tag {
  font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 20rpx; font-weight: 500; flex-shrink: 0;
}

.status-pending { background: rgba(255,149,0,0.1); color: var(--status-pending); }
.status-delivering { background: var(--primary-bg); color: var(--status-delivering); }
.status-completed { background: rgba(52,199,89,0.1); color: var(--status-completed); }

.order-id { font-size: 24rpx; color: var(--text-secondary); font-weight: 500; }
.order-time { font-size: 24rpx; color: var(--text-placeholder); margin-left: auto; }

/* 联系人一行（§4 的「联系」位置，排在主动作之前）：号码整块可点 = 直接拨号。
   [2026-09-26] 去掉了行首的 📍/🛗 装饰图标（§6：员工端逐步去除表情符号，动作旁保留文字）——
   地址与楼层文案本身就是自解释的，图标只是抢视觉。 */
.contact-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.customer-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.customer-phone { font-size: 16px; color: var(--primary-color); padding: 4rpx 0;
  /* 2026-10-25：96rpx 在窄屏不足44px；现场联系用固定触控下限。 */
  min-height: 48px;
  display: flex;
  align-items: center;
  word-break: break-all;
}

.product-info { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 8rpx; flex-wrap: wrap; }
/* ⚠️ 商品摘要**不截断**（2026-09-27 产品口径：商品信息不要隐藏省略）——允许换行、长词可断。
   `flex: 1` 让它占满剩余宽度后再换行，`min-width: 0` 是 flex 子项能收缩的前提（别删）。 */
.product-name { font-size: 30rpx; color: var(--text-regular); flex: 1; min-width: 0; word-break: break-all; }
.product-qty { font-size: 30rpx; color: var(--text-primary); flex-shrink: 0;
  font-weight: 700;
}

/* 「已付 / 需收 ¥X」：这一单要不要现场收钱，扫一眼就知道（§4 的字段顺序里排在商品之后、
   联系人之前）。钱还没到手时用琥珀色挑出来，已付就是普通深色 —— 不靠颜色独立传意（§6）。 */
.pay-line { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 12rpx;
  padding: 16rpx 0;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--border-color);
}
.pay-label { font-size: 24rpx; color: var(--text-secondary); }
.pay-amount { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.pay-need { color: var(--status-pending); }
.pay-extra { font-size: 24rpx; color: var(--text-secondary); margin-left: auto; }

.address-info { display: flex; align-items: flex-start; gap: 6rpx; margin-bottom: 12rpx; }
/* 地址是这张卡的第一信息（§4 字段顺序第一条、§6「配送地址 32–36rpx」），所以它最大最重；
   楼层/电梯是第二眼信息（要不要上楼），与地址同列但小一档，两行大字会互相抢。 */
.address-text { font-size: 36rpx; font-weight: 700; color: var(--text-primary); line-height: 1.4;
  overflow-wrap: anywhere;
}
.address-text.floor-text { font-size: 14px; font-weight: 400; color: var(--text-secondary); }

.card-actions { display: flex; gap: 12rpx; margin-top: 8rpx;
  flex-wrap: wrap;
}
/* 2026-10-25：现场主动作至少48px；保留原动作层级，长文案可撑高。 */
.btn-accept {
  flex: 1; height: auto; line-height: 1.5; background: var(--primary-color); color: #fff;
  border-radius:12rpx; font-size: 14px; font-weight: 600; border: none;
  box-shadow: none; min-height:48px; display:flex; align-items:center; justify-content:center; }
.btn-accept::after { border: none; }

.btn-complete {
  flex: 1; height: auto; line-height: 1.5; background: #0960D7; color: #fff;
  border-radius:12rpx; font-size: 14px; font-weight: 600; border: none;
  box-shadow: none; min-height:48px; display:flex; align-items:center; justify-content:center; }
.btn-complete::after { border: none; }

.btn-outline-small {
  height: auto; line-height: 1.5; padding: 0 24rpx;
  background: #fff; color: var(--text-secondary);
  border-radius:12rpx; font-size: 14px; border: 2rpx solid var(--border-color); min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-outline-small::after { border: none; }

.complete-footer { margin-top: 8rpx; }
.return-barrel { font-size: 24rpx; color: var(--success-color); font-weight: 500; }

/* ========== 待收款 ========== */
.unpaid-section { margin: 16rpx 24rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx; border-left: 4rpx solid var(--warning-color); }
.unpaid-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; padding: 16rpx 0; }
.unpaid-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.unpaid-count { font-size: 24rpx; color: var(--text-placeholder); }
.unpaid-shortcut, .unpaid-back-to-tasks { min-height: 88rpx; height: auto; padding: 16rpx 24rpx; line-height: 1.5; box-sizing: border-box; font-size: 28rpx; color: var(--text-regular); }
.unpaid-shortcut { margin: 16rpx 24rpx; text-align: left; background: var(--bg-gray); border-left: 4rpx solid var(--warning-color); }
.unpaid-back-to-tasks { color: var(--primary-color); background: #fff; margin-bottom: 16rpx; }
.unpaid-shortcut::after, .unpaid-back-to-tasks::after { border: none; }
/* [2026-10-06] 折叠/展开切换 */
.unpaid-toggle { font-size: 24rpx; color: var(--primary-color); margin-left: 16rpx; }
.status-warning { background: rgba(255,149,0,0.1); color: var(--status-pending); }

/* ========== 空状态 ==========
   [2026-09-26] 原来的 .empty-icon（📭）已随表情符号一起去掉（§6）：
   空态只留一句话，靠留白而不是大图标占位。 */
.empty-state {
  display: flex; flex-direction: column; align-items: center; padding: 80rpx 0;
}
.empty-text { font-size: 28rpx; color: var(--text-placeholder); }

/* ========== 辅助小标签 ========== */
.tag-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; flex: 1; }

.aux-tag {
  display: inline-block;
  font-size: 14px;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.aux-tag.aux-offline {
  background: rgba(255, 149, 0, 0.12);
  color: #8A4B00;
}

.aux-tag.aux-unpaid {
  background: rgba(255, 59, 48, 0.1);
  color: var(--error-color);
}

.aux-tag.aux-transfer {
  background: rgba(123, 31, 162, 0.1);
  color: var(--warning-color);
}

.aux-tag.aux-return {
  background: rgba(255, 59, 48, 0.1);
  color: var(--error-color);
}

.aux-tag.aux-target {
  background: var(--primary-bg);
  color: var(--primary-color);
}

/* ========== 按钮补充 ========== */
.btn-outline {
  height: auto;
  line-height: 1.5;
  flex: 1;
  background: #ffffff;
  color: var(--text-regular);
  border: 2rpx solid var(--border-color);
  border-radius:12rpx;
  font-size: 14px;
  font-weight: 500; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-outline::after { border: none; }

.btn-primary {
  height: auto;
  line-height: 1.5;
  flex: 1;
  background: var(--primary-color);
  color: #ffffff;
  border-radius:12rpx;
  font-size: 16px;
  font-weight: 600;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-primary::after { border: none; }

.btn-primary-small {
  height: auto;
  line-height: 1.5;
  padding: 0 24rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius:12rpx;
  font-size: 14px;
  font-weight: 500;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-primary-small::after { border: none; }

/* ========== 加载 ========== */
.loading-state { text-align: center; padding: 40rpx 0; }
.loading-text { font-size: 24rpx; color: var(--text-placeholder); }

/* ========== 「配送遇到问题」（§7 把「调解」换成配送员看得懂的说法；按钮变长了，
   所以这里只保证它与旁边的主按钮同高对齐，宽度按文字走） ========== */
.btn-mediate {
  flex: 1; height: auto; line-height: 1.5;
  background: var(--primary-bg); color: var(--primary-color);
  border-radius:12rpx; font-size: 14px; font-weight: 600; border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-mediate::after { border: none; }

.btn-mediate-small {
  height: auto; line-height: 1.5; padding: 0 24rpx;
  background: var(--primary-bg); color: var(--primary-color);
  border-radius:12rpx; font-size: 14px; font-weight: 500; border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-mediate-small::after { border: none; }

/* ========== 拒绝按钮（红色系） ========== */
.btn-reject {
  flex: 1; height: auto; line-height: 1.5;
  background: var(--error-bg); color: var(--error-color);
  border-radius:12rpx; font-size: 14px; font-weight: 600; border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-reject::after { border: none; }

/* ========== 自定义弹窗 ========== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5); display: flex; align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-title {
  flex-shrink: 0;
  display: block; font-size: 34rpx; font-weight: 700; color: var(--text-primary);
  text-align: center; margin-bottom: 8rpx;
}

.modal-desc {
  flex-shrink: 0;
  display: block; font-size: 26rpx; color: var(--text-regular);
  text-align: center; margin-bottom: 32rpx;
}

.modal-list { margin-bottom: 24rpx; }
.modal-scroll { height: 50vh; min-height: 0; flex-shrink: 1; }
.modal-cancel { flex-shrink: 0; }

/* 「这单我确实送不了」的分组标题（[2026-09-27]）：把"上报问题"与"把单交出去"分开，
   避免配送员把两组动作读成一件事。 */
.modal-sub-title {
  display: block; font-size: 26rpx; color: var(--text-regular);
  margin: 8rpx 0 12rpx; padding-left: 4rpx;
}

.modal-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx; background: var(--bg-color); border-radius: 16rpx;
  margin-bottom: 16rpx; transition: background 0.15s;
}
.modal-item:active { background: var(--bg-gray); }
.press-feedback { background: var(--bg-gray); opacity: 0.82; }

.modal-item-info { flex: 1; }
.modal-item-name { display: block; font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.modal-item-desc { display: block; font-size: 26rpx; color: var(--text-regular); margin-top: 4rpx; }
.modal-item-arrow { font-size: 36rpx; color: var(--text-placeholder); margin-left: 16rpx; }

.modal-cancel {
  width: 100%; height: 88rpx; line-height: 88rpx; background: var(--bg-gray);
  color: var(--text-secondary); border-radius: 16rpx; font-size: 30rpx;
  font-weight: 500; border: none; margin-top: 8rpx;
}
.modal-cancel::after { border: none; }

/* 首页读取失败合并为一个区块；文字、操作独立成列，避免原生按钮与正文内联断句。 */
.home-read-feedback { display:flex; align-items:center; gap:16rpx; margin:16rpx 24rpx; padding:16rpx 20rpx; border-left:4rpx solid var(--primary-color); border-radius:10rpx; background:var(--bg-gray); }
.home-read-feedback-copy { flex:1; min-width:0; }
.home-read-feedback-title,.home-read-feedback-note { display:block; white-space:normal; overflow-wrap:anywhere; line-height:1.6; }
.home-read-feedback-title { color:var(--text-primary); font-size:28rpx; font-weight:600; }
.home-read-feedback-note { margin-top:6rpx; color:var(--text-regular); font-size:24rpx; }
.home-read-feedback-retry { flex:0 0 auto; min-height:44px; margin:0; padding:12rpx 18rpx; font-size:14px; line-height:1.5; background:var(--primary-bg); color:var(--primary-color); }
@media (max-width:340px) { .tab-item { flex-direction:column; gap:4rpx; } }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.card-actions button, .modal-cancel { height: auto; min-height: 44px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.card-actions button { flex: 1 1 240rpx; }
.card-actions .btn-accept, .card-actions .btn-complete { min-height: 48px; }
.unpaid-section .order-card { margin-bottom: 12rpx; }
.home-station-identity { font-weight: 600; }
.pay-label { font-size: 14px; }
.pay-amount { font-size: 16px; }
.modal-item { min-height: 96rpx; box-sizing: border-box; }
.collection-recovery { margin: 20rpx 24rpx; padding: 24rpx; background: var(--bg-gray); color: var(--text-regular); border-radius: 12rpx; font-size: 28rpx; line-height: 1.6; border-left: 4rpx solid var(--primary-color); }
.collection-recovery text { display: block; white-space: normal; }
.collection-recovery button { margin: 16rpx 0 0; min-height: 44px; padding: 16rpx 24rpx; }

.setup-launch-entry { display:flex; align-items:center; gap:12rpx; margin-bottom:20rpx; padding:20rpx; border:1rpx solid #E8C598; border-radius:12rpx; background:#FFF8ED; color:var(--text-primary); font-size:14px; line-height:1.5; }
.setup-launch-dot { width:8px; height:8px; flex-shrink:0; border-radius:50%; background:#D47A16; }
.setup-launch-main { flex:1; min-width:0; }
.setup-launch-main text { display:block; }
.setup-launch-state { margin-top:4rpx; font-size:13px; color:var(--text-regular); }
.setup-launch-quiet { min-height:36px; display:flex; align-items:center; justify-content:flex-end; margin-bottom:8rpx; font-size:13px; color:var(--text-regular); }
.delivery-launch-state {display:flex;flex-direction:column;gap:8rpx;margin:16rpx 0;padding:20rpx;background:#fff7e8;border-radius:16rpx;font-size:14px;line-height:1.6;color:#784811;}
