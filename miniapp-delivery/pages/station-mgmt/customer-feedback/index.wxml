<view class="container">
  <view class="work-head"><text class="work-title">反馈与退款争议</text></view>

  <!-- 普通反馈与退款争议的处理范围不同，保留结案后果。 -->
  <view class="hint" wx:if="{{!denied}}">
    <!-- [2026-09-24] 去掉"后端暂无回复/处置功能"这类开发措辞：站长需要知道的是
         **"这里只能看，回不了"** —— 不然他会到处找回复按钮。 -->
    <text>普通反馈仅供查看。退款争议结案不会办理退款或改变金额，顾客可再次提出异议。</text>
  </view>

  <!-- 权限不足：不说"暂无数据"，否则配送员会以为本站真的没有反馈 -->
  <view class="empty" wx:if="{{denied}}">
    <text>{{deniedText}}</text>
  </view>

  <block wx:else>
    <view class="section-tabs"><button class="af-choice b3-on-set-section {{activeSection === 'disputes' ? 'af-choice--selected' : ''}}" data-section="disputes" bindtap="onSetSection" hover-class="af-action--pressed"><view class="af-choice__face">退款争议</view></button><button class="af-choice b3-on-set-section {{activeSection === 'feedback' ? 'af-choice--selected' : ''}}" data-section="feedback" bindtap="onSetSection" hover-class="af-action--pressed"><view class="af-choice__face">普通反馈</view></button></view>
    <view wx:if="{{activeSection === 'disputes'}}">
    <view class="fb-card">
      <text class="category">退款争议</text><text wx:if="{{disputesLoading}}">正在核对…</text>
      <text class="content" wx:if="{{disputesError}}">{{disputesError}}</text><button wx:if="{{disputesError}}" bindtap="onRetryDisputes" class="af-action af-action--quiet b3-on-retry-disputes" hover-class="af-action--pressed"><view class="af-action__face">重新核对争议</view></button>
      <text wx:if="{{!disputesLoading && !disputesError && !disputes.length}}">暂无退款争议记录</text>
      <button wx:if="{{disputesMore && !disputesLoading}}" bindtap="onMoreDisputes" class="af-action af-action--quiet b3-on-more-disputes" hover-class="af-action--pressed"><view class="af-action__face">继续加载争议记录</view></button>
      <view wx:for="{{disputes}}" wx:key="disputeKey" wx:if="{{!selectedDispute || (selectedDispute.refundType === item.refundType && selectedDispute.refundId === item.refundId)}}">
        <view class="b3-dispute-state {{selectedDispute ? 'is-current' : ''}}"><text class="b3-dispute-status">{{item.statusText}}</text><text class="content">{{item.objectText}}</text></view><text class="content" wx:if="{{item.lastResult}}">上一轮结果：{{item.lastResult}}</text>
        <button wx:if="{{!selectedDispute}}" data-type="{{item.refundType}}" data-id="{{item.refundId}}" bindtap="onOpenDispute" class="af-entry b3-on-open-dispute" hover-class="af-action--pressed"><view class="af-entry__body">查看争议与处理</view><text class="af-entry__arrow" aria-hidden="true">›</text></button>
        <button wx:else bindtap="onReturnDispute" disabled="{{disputeSubmitting}}" class="af-action af-action--quiet b3-on-return-dispute" hover-class="af-action--pressed"><view class="af-action__face">返回争议列表</view></button>
        <view wx:if="{{selectedDispute && selectedDispute.refundType === item.refundType && selectedDispute.refundId === item.refundId}}">
          <text class="content" wx:if="{{disputeError}}">{{disputeError}}</text>
          <block wx:if="{{disputeReady}}">
            <text class="content">结案无需顾客确认，请记录核实依据和结果。结案不收退钱，也不取消顾客既有权利。</text>
            <text class="content" wx:if="{{selectedDispute.canClose && !pendingDispute}}">未提交说明仅在本页保留。</text>
            <textarea wx:if="{{selectedDispute.canClose || pendingDispute}}" disabled="{{pendingDispute || disputeSubmitting}}" maxlength="1000" placeholder="核实依据、处理结果与后续安排" value="{{disputeResult}}" bindinput="onDisputeResult" />
            <button class="af-action af-action--primary b3-on-close-dispute af-action--block" wx:if="{{selectedDispute.canClose && !pendingDispute}}" loading="{{disputeSubmitting}}" disabled="{{disputeSubmitting}}" bindtap="onCloseDispute" hover-class="af-action--pressed">登记结果并结案</button>
            <button class="af-action af-action--secondary b3-on-retry-close-dispute" wx:if="{{pendingDispute}}" disabled="{{disputeSubmitting}}" bindtap="onRetryCloseDispute" hover-class="af-action--pressed">重试原结案</button>
            <button wx:if="{{selectedDispute.actions.length}}" bindtap="onToggleDisputeHistory" class="af-action af-action--quiet b3-on-toggle-dispute-history" hover-class="af-action--pressed"><view class="af-action__face">处理历史 · {{disputeHistoryExpanded ? '收起' : '展开'}}</view></button>
            <block wx:if="{{disputeHistoryExpanded}}"><view class="b3-dispute-history" wx:for="{{selectedDispute.actions}}" wx:for-item="entry" wx:key="id"><text class="content">{{entry.actionText}} · {{entry.createTime}}</text><text class="content">{{entry.reason}}</text></view></block>
          </block>
        </view>
      </view>
    </view>
    </view>
    <view wx:if="{{activeSection !== 'disputes'}}">
    <!-- ① 失败：后端 message 原样展示。这条分支必须与下面的"暂无客户反馈"分开，
         否则接口挂了会看起来像"确实没有反馈"（本仓 §8.22）。 -->
    <view class="state error" wx:if="{{type === 'error'}}">
      <text class="state-title">加载失败</text>
      <text class="state-msg">{{errMsg}}</text>
      <text class="state-hint">请重试或下拉刷新。</text>
      <view class="retry-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- ② 确实没有 -->
    <view class="state" wx:elif="{{type === 'empty'}}">
      <text class="state-title">暂无客户反馈</text>
      <text class="state-hint">顾客提交反馈后会出现在这里。</text>
    </view>

    <!-- ③ 加载中 -->
    <view class="state" wx:elif="{{type === 'loading'}}">
      <text class="state-title">加载中...</text>
    </view>

    <!-- ④ 列表 -->
    <block wx:else>
      <view class="fb-card" wx:for="{{list}}" wx:key="id">
        <view class="card-head">
          <!-- whoText 由 js 的 decorate() 算好：有姓名→姓名；没姓名有客户号→"客户 #<id>"；
               两个都没有→"匿名顾客"。⚠️ 匿名记录在**后端响应里就没有** customerId/customerName
               （SQL 层置 NULL），所以这里不是"前端藏起来"，而是**根本没拿到**。
               本页不读 anonymous 标志位自己拼身份文案（后端刻意不下发该字段）。 -->
          <text class="who">{{item.whoText}}</text>
          <text class="time">{{item.timeText}}</text>
        </view>

        <!-- category 是提交方写的原文（顾客端一键上报写死"错误报告"），原样透传，前端不建映射表 -->
        <text class="category" wx:if="{{item.categoryText}}">{{item.categoryText}}</text>
        <text class="content" wx:if="{{item.refundObjectText}}">{{item.refundObjectText}} · {{item.authorText}}</text>

        <text class="content">{{item.content}}</text>

        <view class="card-foot">
          <text class="foot-item" wx:if="{{item.contactText}}">{{item.contactText}}</text>
          <text class="foot-item muted" wx:else>{{item.noContactText}}</text>
          <text class="foot-item muted" wx:if="{{item.customerIdText}}">{{item.customerIdText}}</text>
        </view>
        <button wx:if="{{item.refundType && item.refundId}}" size="mini" bindtap="onOpenRefundNote" data-id="{{item.id}}" class="af-action af-action--quiet b3-on-open-refund-note" hover-class="af-action--pressed"><view class="af-action__face">补充说明</view></button>
        <view wx:if="{{selectedFeedbackId === item.id}}" class="refund-note-form">
          <text class="content">证据可后补，原说明会保留。未提交的新说明仅在本页保留。</text>
          <textarea maxlength="1000" disabled="{{pendingRefundNote || noteSubmitting}}" placeholder="补充说明（可选）" value="{{noteContent}}" bindinput="onNoteInput" />
          <button class="af-action af-action--primary b3-on-submit-refund-note af-action--block" wx:if="{{!pendingRefundNote}}" loading="{{noteSubmitting}}" disabled="{{noteSubmitting}}" bindtap="onSubmitRefundNote" hover-class="af-action--pressed">提交说明</button>
          <button class="af-action af-action--secondary b3-on-retry-original-note" wx:if="{{pendingRefundNote}}" disabled="{{noteSubmitting}}" loading="{{noteSubmitting}}" bindtap="onRetryOriginalNote" hover-class="af-action--pressed">结果待确认，重试原说明</button>
        </view>
      </view>
    </block>
    </view>
  </block>

</view>
<business-dialog id="business-dialog" />
