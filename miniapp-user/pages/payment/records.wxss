.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 0;
  padding: 28rpx 24rpx;
  margin-bottom: 0;
  box-shadow: none;
  border-bottom: 1rpx solid var(--border-color);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-bottom: 10rpx;
}

.record-purpose {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}

.record-order {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.record-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.record-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
  max-width: 45%;
  word-break: break-all;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price-color);
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.record-status {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--bg-gray);
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.status-2 {
  background: var(--success-bg);
  color: var(--success-color);
}

.status-1 {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.status-3 {
  color: var(--text-secondary);
}

.status-4 {
  color: var(--text-regular);
}
.record-method {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.record-order, .record-time {
  display: block;
  line-height: 1.6;
}

.error-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
}

.error-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--warning-color);
  font-size: 30rpx;
  font-weight: 600;
}

.error-message, .refresh-hint {
  display: block;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.refresh-hint { margin-bottom: 20rpx; }

.retry-button {
  margin: 24rpx 0 0;
  padding: 20rpx 28rpx;
  display: inline-block;
  width: auto;
  min-height: 44px;
  line-height: 1.6;
  font-size: 14px;
  color: var(--primary-color);
  background: var(--primary-bg);
  border-radius: var(--radius-md);
}

.retry-button::after { border: none; }


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
.page-intro { padding: 4rpx 0 24rpx; }

.record-list { overflow: hidden; border-radius: var(--radius-md); border: 1rpx solid var(--border-color); background: #fff; }
.record-item:last-child { border-bottom: 0; }

/* 本页所有状态共用的可读与触控边界。 */
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.record-main, .record-right { min-width: 0; overflow-wrap: anywhere; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
