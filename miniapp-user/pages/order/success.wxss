.page {
  min-height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 订单状态区 ========== */
.success-hero {
  padding-top: 32rpx;
  text-align: center;
  margin-bottom: 28rpx;
  width: 100%;
}

.success-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--success-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  position: relative;
  box-shadow: none;
}

/* 结果不是"成功"时（已取消 / 已退款 / 没查到 / 还没付款）换暖色，
   避免"绿勾 + 尽快配送"的视觉暗示与真实状态相反（契约 A3） */
.success-circle.warn {
  background: var(--warning-color);
  box-shadow: none;
}

.success-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(5, 150, 105, 0.2);
  animation: ring-expand 1.5s ease-out infinite;
}

@keyframes ring-expand {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}

.success-check {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
  margin-top: -4rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: var(--text-regular);
  display: block;
  line-height: 1.7;
  word-break: break-all;
}

/* 结果区的金额（后端总额，前端只格式化）：与状态说明分行、字号小一档，
   让"现在是哪一步"优先于"多少钱"。 */
.success-amount {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--text-regular);
  font-weight: 500;
}

/* ========== 不能在线支付时的付款说明行 ==========
   后端 payHint（"货到付款，配送员送达时收款" / "水票支付，下单即视同已付"）
   原来只在"有支付按钮"的分支里被读，现金单反而看不到付款方式。 */
.pay-hint-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
  flex-wrap: wrap;
}

.pay-hint-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.5;
}

.pay-hint-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 常用订单区 ========== */
.template-section {
  width: 100%;
  padding: 0;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.template-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.template-card:active {
  transform: scale(0.98);
}

.template-card.saved {
  border-color: rgba(5, 150, 105, 0.3);
  background: #ffffff;
}

.template-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.template-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: none;
}

.template-icon-wrap.saved {
  background: var(--success-bg);
  box-shadow: none;
}

.template-icon {
  font-size: 36rpx;
}

.template-check {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}

.template-text {
  flex: 1;
}

.template-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.template-title.saved {
  color: var(--success-color);
}

.template-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

.template-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
  margin-left: 12rpx;
}

/* ========== 操作按钮 ========== */
.actions {
  width: 100%;
  padding: 0;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.action-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.action-card {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: none;
  transition: transform 0.2s;
  gap: 16rpx;
  min-height: 104rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
}

.action-card:active {
  transform: scale(0.96);
}

.action-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
  flex-shrink: 0;
}

.action-icon-wrap.primary {
  background: var(--primary-bg);
  box-shadow: none;
}

.action-icon-wrap.secondary {
  background: var(--bg-gray);
  box-shadow: none;
}

.action-icon-text {
  font-size: 40rpx;
}

.action-info {
  text-align: left;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.5;
}

/* ========== 底部提示 ========== */
.bottom-tip {
  margin-top: 0;
  padding-bottom: 80rpx;
  padding: 12rpx 0 0;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.7;
}

/* ========== 去支付按钮 ========== */
.pay-section {
  width: 100%;
  padding: 0;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.pay-btn {
  width: 100%;
  height: auto;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  min-height: 44px;
  padding: 20rpx;
  box-sizing: border-box;
}

.pay-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.pay-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

/* 「重试查一次」（加载失败时）：与去支付按钮同形，但语义是"重新读一次"，不是付款 */
.pay-btn.retry {
  background: var(--text-secondary);
  box-shadow: 0 6rpx 24rpx rgba(100, 116, 139, 0.3);
}
.result-loading { width: 100%; padding: 36rpx 0; }
.load-error { width: 100%; margin-bottom: 24rpx; box-sizing: border-box; }
.load-error .af-action { margin-top:8px; }
.template-hint, .action-desc, .tip-text { font-size: 26rpx; line-height: 1.65; }

.current-order-primary { min-height:48px; margin:20rpx 24rpx; border-radius:12rpx; color:#fff; background:var(--primary-color); font-size:16px; line-height:1.5; padding:12px; }
.template-card { box-shadow:none; padding:20rpx; border:1rpx solid var(--border-light); min-height:44px; }
.template-title { font-size:16px; }
.template-hint,.success-desc { font-size:14px; line-height:1.7; }
.action-card,.pay-btn { min-height:48px; height:auto; }
.action-row { flex-wrap:wrap; }
.action-card { flex:1 1 240rpx; }

.page > .af-action--block { margin-bottom:12px; }

/* Visual v2: page hierarchy and semantic surfaces. */
.template-card,.action-card { border-radius:14px; }
.action-card { min-height:56px; }
.template-card { background:var(--af2-surface-neutral); }
