  line-height: 1.5;
}

.pending-order-sub {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  color: var(--warning-color);
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.asset-detail-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  background: var(--primary-bg);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.detail-link-text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
  margin-right: 8rpx;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.asset-checkbox {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.checkbox-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.asset-popup .popup-btns .btn-ok.disabled {
  background: var(--text-placeholder);
  color: var(--text-regular);
}

/* ========== 详细说明的展开区（2026-09-26 轨道 E：并进首次确认弹窗，不再是第二层弹窗）==========
   §3：必需勾选与确认放同一层、详细条款按需展开。开关行复用原来的说明入口
   （.asset-detail-link / .detail-link-text，见下面那一组），这里只加展开/收起的方向提示。 */
.asset-more-glyph {
  font-size: 28rpx;
  line-height: 1;
  color: var(--primary-color);
  transform: rotate(90deg);
}

.asset-more-glyph.up {
  transform: rotate(-90deg);
}

/* ⚠️ 展开区在 .asset-scroll 里：内容再长也只是把滚动区撑长，
   勾选行与「确认下单」始终留在滚动区外、任何字号下都够得着（见 wxml 的护栏注释）。 */
.asset-detail {
  padding-top: 4rpx;
  border-top: 1rpx solid var(--border-light);
}

/* ========== 资产使用说明（原「第二层弹窗」的样式；说明现已并进首次确认弹窗）==========
   ⚠️ [2026-09-26 轨道 E] 下面这组 .asset-detail-popup / .asset-detail-content 规则
   **现在没有元素使用**（为满足"勾选与确认同一层"，说明改成了上面的展开区）。
   按仓库删除协议**先保留、不删**；确认无用的登记见本轮回传。
   这段历史坑留着（它记的是"为什么必须写 .popup-content.asset-detail-popup"）：
   WXML 曾是 class="popup-content asset-detail-popup"（同一个元素），子孙选择器匹配不到，
   整套定位失效 → 卡片留在 translateY(100%) 的屏幕外，点说明入口只看到整屏灰白。 */
.popup-content.asset-detail-popup {
  top: 50%;
  left: 50%;
  right: auto;
  bottom: auto;
  transform: translate(-50%, -50%) scale(0.9);
  border-radius: 24rpx;
  box-shadow: var(--shadow-lg);
  padding: 0;
  width: calc(100% - 64rpx);
  max-width: 700rpx;
  max-height: 90vh;
  overflow: hidden;
  /* 列布局：标题固定、正文占满剩余高度并自己滚动、底部按钮固定（长内容/窄屏都够得着） */
  display: flex;
  flex-direction: column;
}

.asset-popup.show .popup-content.asset-detail-popup {
  transform: translate(-50%, -50%) scale(1);
  animation: popupFadeIn 0.25s ease;
}

.asset-detail-popup .popup-title {
  background: var(--primary-color);
  color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.asset-detail-content {
  padding: 32rpx;
  /* ⚠️ 不能用 max-height: 70vh + 依赖 scroll-view 自己滚：卡片本身还有标题与按钮，
     两者相加会超过 90vh，把「我知道了」顶出屏幕。改为占满剩余高度并 min-height: 0
     （flex 子项默认 min-height:auto，不给 0 就不会收缩、也就滚不起来）。 */
  flex: 1;
  min-height: 0;
}

.detail-intro {
  font-size: 26rpx;
  color: var(--text-regular);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

/* 下面两条的宿主元素随说明弹窗一起没了（同上：保留不删）。
   展开区里的说明文字用 .detail-intro / .detail-rule-item / .detail-bold，仍在用。 */
.detail-rule {
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  margin-bottom: 24rpx; border-left:4rpx solid var(--warning-color); }

.detail-checkbox {
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-right: 8rpx;
}

.detail-rule-title {
  font-size: 26rpx;
  color: var(--warning-color);
  font-weight: 600;
}

.detail-rule-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid var(--primary-color);
}

.detail-rule-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
  flex-shrink: 0;
}

.detail-rule-text {
  font-size: 34rpx;
  color: var(--text-regular);
  line-height: 1.7;
}

.detail-bold {
  font-weight: 700;
  color: var(--text-primary);
}

/* 首次确认弹窗里的勾选行（**真的闸门**，不是装饰性 ☐）：
   未勾选 = 中性灰，勾选后 = 品牌蓝（§6：蓝色用于选中状态，不靠彩虹色）。
   它在 wxml 里与「确认下单」同在滚动区外的一层 —— 见 create.wxml 的护栏注释。 */
.detail-agree {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border-color);
  margin-bottom: 24rpx;
}

/* 勾选后变蓝：让"已经确认过"看得见（按钮的灰/亮也随之变化） */
.detail-agree.is-checked {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.detail-agree.is-checked .detail-checkbox {
  color: var(--primary-color);
}

.detail-agree-text {
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

/* 未勾选说明时「确认下单」变灰（仍可点，点了给提示 —— 见 onAssetConfirmOk） */
.asset-warning .popup-btns .btn-ok.disabled {
  background: var(--text-placeholder);
  color: #FFFFFF;
}

/* 说明展开区底部的「问水站」入口（2026-09-26 随文案重写新增）：
   取到电话就是拨号行，取不到就跳客服页 —— 两态都要看得懂、点得动。 */
.detail-call {
  display: flex;
  align-items: center;
