<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.aquaflow.mapper.WaterTypeMapper">
    <select id="list" resultType="WaterType">
        select * from water_type
    </select>

    <select id="listByKeyword" resultType="WaterType">
        select * from water_type
        <where>
            <if test="keyword != null and keyword != ''">
                and (name like concat('%', #{keyword}, '%') or spec like concat('%', #{keyword}, '%'))
            </if>
        </where>
    </select>
</mapper>
