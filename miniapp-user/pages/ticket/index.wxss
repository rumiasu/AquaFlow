.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 水票余额卡片 */
.ticket-balance-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  background: var(--primary-gradient);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-primary);
}

.balance-left {
  display: flex;
  flex-direction: column;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.balance-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.balance-count {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.balance-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.balance-total {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.balance-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

/* 标签栏 */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-regular);
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.tab-content {
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* 水票列表 */
.ticket-list {
  background-color: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.ticket-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.ticket-item:last-child {
  border-bottom: none;
}

.ticket-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ticket-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.ticket-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ticket-expire {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.ticket-quantity {
  display: flex;
  align-items: baseline;
}

.quantity-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-right: 8rpx;
}

.quantity-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 消费记录 */
.record-list {
  background-color: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.record-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-quantity {
  display: flex;
  align-items: baseline;
}

.quantity-change {
  font-size: 28rpx;
  font-weight: 600;
}

.quantity-change.increase {
  color: var(--success-color);
}

.quantity-change.decrease {
  color: var(--error-color);
}

/* 购买水票按钮 */
.buy-ticket-section {
  padding: 32rpx 24rpx;
}

.buy-ticket-btn {
  height: 96rpx;
  background: var(--primary-gradient);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
}

.buy-ticket-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.buy-ticket-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 购买弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-body {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-placeholder);
  padding: 0 8rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 50vh;
}

.modal-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin: 20rpx 0 12rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-item {
  padding: 16rpx 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.product-item.active {
  border-color: var(--primary-color);
  background: rgba(79,142,247,0.06);
}

.product-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.product-price {
  font-size: 22rpx;
  color: var(--price-color);
}

.qty-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
}

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-input {
  flex: 1;
  height: 64rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.method-item.active {
  border-color: var(--primary-color);
  background: rgba(79,142,247,0.06);
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.method-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-color);
}

.method-radio.checked {
  border-color: var(--primary-color);
  background: var(--primary-color);
  box-shadow: inset 0 0 0 6rpx #fff;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  border: 2rpx solid var(--border-color);
}

.modal-btn.cancel text {
  color: var(--text-regular);
  font-size: 30rpx;
}

.modal-btn.confirm {
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
}

.modal-btn.confirm text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-btn.confirm.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}

/* ---- 水票档位（价目表） ---- */

.pkg-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pkg-item {
  flex: 1;
  min-width: 180rpx;
  padding: 18rpx 16rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  text-align: center;
}

.pkg-item.active {
  border-color: var(--primary-color);
  background: rgba(79, 142, 247, 0.06);
}

.pkg-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.pkg-price {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.pkg-sub {
  display: block;
  font-size: 21rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.pkg-clear {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  text-align: center;
}

.pkg-lock {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 32rpx;
}

/* 当前水站提示条（2026-09-20）：水票/押金/桶权益按「客户 × 水站」隔离，
   页面要能一眼看出"这是哪个站的账"。样式与 pages/deposit/records 同名类保持一致。 */
.station-bar {
  display: flex;
  flex-direction: column;
  padding: 4rpx 8rpx 20rpx;
}

.station-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-bar-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
