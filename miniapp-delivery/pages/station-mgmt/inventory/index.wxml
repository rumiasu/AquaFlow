<view class="container">
  <view class="inventory-list" wx:if="{{!loading}}">
    <view class="inv-card" wx:for="{{list}}" wx:key="id">
      <view class="inv-info">
        <text class="inv-name">{{item.displayName}}</text>
        <text class="inv-status {{item.lowStock ? 'warn' : 'ok'}}">
          {{item.lowStock ? '低库存' : item.statusText}}
        </text>
      </view>
      <view class="inv-qty">
        <text class="qty-num {{item.lowStock ? 'warn' : ''}}">{{item.quantity || 0}}</text>
        <text class="qty-unit">桶</text>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0}}"><text>暂无库存</text></view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>