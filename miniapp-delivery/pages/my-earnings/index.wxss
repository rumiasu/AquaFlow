.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg-color);
}

.summary {
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
  flex-wrap: wrap;
  gap: 24rpx;
}

.summary-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 260rpx;
}

.summary-side {
  width: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border-left: none;
  padding-left: 0;
  min-width: 220rpx;
  flex: 1;
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}

.summary-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.summary-value {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.summary-value-sm {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 12rpx;
}

.summary-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.6;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.chip {
  padding: 10rpx 24rpx;
  margin: 0 16rpx 12rpx 0;
  font-size: 26rpx;
  color: var(--text-regular);
  background: #ffffff;
  border-radius: 10rpx;
}

.chip-on {
  color: #ffffff;
  background: var(--primary-color);
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  text-align: center;
}

.payroll {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-gray);
}

.payroll:last-child {
  border-bottom: none;
}

.payroll-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.payroll-no {
  font-size: 28rpx;
  color: var(--text-primary);
}

.payroll-status {
  font-size: 24rpx;
  color: var(--primary-color);
}

.payroll-period {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.payroll-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.payroll-paid {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-gray);
  flex-wrap: wrap;
  gap: 16rpx;
}

.item:last-child {
  border-bottom: none;
}

.item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
  min-width: 240rpx;
}

.item-kind {
  font-size: 28rpx;
  color: var(--text-primary);
}

.item-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.item-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.item-detail {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.note {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding: 0 8rpx 40rpx;
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.chip { height: auto; min-height: 96rpx; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; flex: 1; }
.payroll-no, .payroll-period, .item-detail { overflow-wrap: anywhere; }

.item-right { max-width: 100%; overflow-wrap: anywhere; }
