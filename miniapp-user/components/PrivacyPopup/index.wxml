<view class="privacy-mask" wx:if="{{show}}">
  <view class="privacy-dialog" aria-role="dialog" aria-label="隐私保护提示">
    <view class="privacy-title">隐私保护提示</view>
    <view class="privacy-content">
      在使用小程序前，请阅读并同意
      <navigator class="privacy-link" open-type="openPrivacyContract">《隐私保护指引》</navigator>
      。我们将获取您的位置信息用于收货地址定位。
    </view>
    <view class="privacy-btns">
      <button class="privacy-btn reject" aria-label="拒绝隐私授权" bindtap="onReject">拒绝</button>
      <button class="privacy-btn agree" aria-label="同意隐私授权" id="privacy-agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgree">同意</button>
    </view>
  </view>
</view>
