.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* ========== 游客登录入口 ==========
   [2026-09-26 Wave3 H1] 原为渐变品牌头（.brand-header / .brand-icon / .brand-name /
   .brand-slogan / .brand-login 五条规则），随「删品牌头与口号」一并去掉 ——
   本页不许出现大面积品牌色与渐变页头（docs/design/29 §6）。
   这条是游客在本页**唯一**的登录入口，样式按 §6 的普通容器规格走：白面、16rpx 圆角、无渐变。 */
.guest-login {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.guest-login-text { flex: 1; min-width: 0; }

.guest-login-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.guest-login-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  /* 这里不用 --text-secondary(#637083)：对白底只有 2.67:1，达不到 §6「灰色占位不承载
     价格、地址、警告」的可读要求。--text-regular(#4B596A) 是 5.39:1，且客户端已在本页
     .station-picker-close 等处用它做整句提示。 */
  color: var(--text-regular);
}

.guest-login-arrow {
  font-size: 32rpx;
  color: var(--text-placeholder);
  margin-left: 12rpx;
}

/* ========== 水站选择栏 ========== */
.station-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 1;
}

.station-bar-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-left: 12rpx;
}

.station-bar-empty {
  color: var(--text-secondary);
}

.station-bar-switch {
  background: var(--primary-bg);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}

.station-bar-switch text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ========== 水站选择弹窗 ========== */
.station-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.station-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
}

.station-picker.show {
  transform: translateY(0);
}

.station-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.station-picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.station-picker-close {
  padding: 8rpx 16rpx;
}

.station-picker-close text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.station-picker-list {
  padding: 16rpx 0;
  overflow-y: auto;
  max-height: calc(70vh - 100rpx);
}

.station-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  transition: background 0.15s;
}

.station-picker-item:active {
  background: var(--bg-gray);
}

.station-picker-item.active {
  background: var(--primary-bg);
}

.station-picker-item-info {
  flex: 1;
}

.station-picker-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.station-picker-item-addr {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.station-picker-item-check {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.station-picker-empty {
  padding: 60rpx 0;
  text-align: center;
}

.station-picker-empty text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.search-bar { padding: 24rpx; background-color: #fff; }

.search-input-wrap {
  display: flex; align-items: center; background-color: var(--bg-gray);
  border-radius: 32rpx; padding: 0 24rpx; height: 64rpx;
  border: 1rpx solid var(--border-color);
}

.search-icon { font-size: 28rpx; margin-right: 12rpx; }

.search-input { flex: 1; font-size: 28rpx; color: var(--text-primary); }

.search-clear { font-size: 32rpx; color: var(--text-secondary); padding: 0 8rpx; }

.section {
  background-color: #fff; margin: 24rpx; padding: 28rpx 24rpx;
  border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx; font-weight: 700; color: var(--text-primary);
  display: block; margin-bottom: 20rpx;
}

.product-grid { display: flex; flex-direction: column; gap: 20rpx; }

.product-card {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.product-card:active { opacity: 0.85; }

.product-img {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: var(--bg-gray);
}

.product-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img-placeholder text {
  font-size: 56rpx;
}

.owned-tag {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background-color: rgba(5, 150, 105, 0.85);
  color: #fff;
  font-size: 26rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.product-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 商城列表的商品名也不截断（2026-09-27 产品口径）——`flex:1 + min-width:0` 保留，它让长名字换行而不是把卡片撑破 */
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.product-brand {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price-color);
}

.product-deposit {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.buy-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 28rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 26rpx;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.2);
  text-align: center;
  margin-top: 8rpx;
}

.buy-btn.login-required { background: var(--text-placeholder); box-shadow: none; }

/* ========== 按钮行 ========== */
.btn-row {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.cart-btn {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  background: var(--bg-gray);
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  border-radius: 26rpx;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
}

.cart-btn:active {
  opacity: 0.7;
}

.buy-btn {
  flex: 1;
}

/* ========== 浮动购物车 ========== */
.fab-cart {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.4);
  z-index: 90;
}

.fab-cart:active {
  transform: scale(0.92);
}

.fab-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--error-color);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.fab-cart-badge text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 水站营业状态横幅（软状态：只提示，不阻断下单）===== */
.station-status-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx; border-left: 4rpx solid var(--warning-color); }

.station-status-banner .banner-icon {
  font-size: 30rpx;
  line-height: 1.4;
}

.station-status-banner .banner-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--warning-color);
  line-height: 1.5;
}

/* 商品区域用分隔线组织，不叠加装饰卡片。 */
.container { padding: 16rpx 0 200rpx; }
.section { box-shadow: none; padding: 24rpx 20rpx; }
.catalog-note { display: block; color: var(--text-regular); font-size: 26rpx; line-height: 1.6; margin-bottom: 20rpx; }
.search-input-wrap { height: 88rpx; border-radius: var(--radius-md); }
.search-clear { min-width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.product-grid { gap: 0; }
.product-card { box-shadow: none; padding: 24rpx 0; border-radius: 0; overflow: visible; }
.product-card + .product-card { border-top: 1rpx solid var(--border-color); }
.product-img { width: 136rpx; height: 184rpx; border-radius: var(--radius-md); }
.product-info { padding: 0 0 0 20rpx; }
.product-name { font-size: 32rpx; }
.product-brand, .product-deposit { font-size: 26rpx; color: var(--text-regular); line-height: 1.5; }
.product-price { font-size: 38rpx; }
.btn-row { flex-wrap: wrap; }
.buy-btn, .cart-btn { min-width: 140rpx; min-height: 44px; height: auto; box-sizing: border-box; line-height: 1.4; padding: 20rpx 12rpx; display: flex; justify-content: center; align-items: center; font-size: 14px; border-radius: var(--radius-md); box-shadow: none; margin-top: 0; }
.station-picker-close { min-height: 88rpx; display: flex; align-items: center; }
.fab-cart { border-radius: var(--radius-lg); box-shadow: var(--shadow-md); bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.fab-cart:active { transform: none; }

/* 本页所有状态共用的可读与触控边界。 */
.container { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }
.search-clear, .station-picker-close { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }
.station-picker button, .load-error button { min-height: 44px; font-size: 14px; line-height: 1.6; padding: 20rpx; }
.product-info, .name-row { min-width: 0; }
.product-brand, .catalog-note { color: var(--text-regular); line-height: 1.6; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }

.container { padding-bottom:calc(100px + env(safe-area-inset-bottom)); }
.catalog-quantity { display:flex; align-items:center; gap:8px; }
.catalog-quantity button { width:48px; min-width:48px; min-height:48px; height:auto; margin:0; padding:8px; background:var(--primary-bg); color:var(--primary-color); font-size:20px; line-height:1.4; }
.catalog-quantity input { min-width:44px; width:56px; min-height:48px; text-align:center; font-size:18px; border:1rpx solid var(--border-color); border-radius:8rpx; }
.btn-row { flex-wrap:wrap; justify-content:flex-start; gap:12px; }
.buy-btn { min-height:44px; padding:8px 0; background:transparent; color:var(--primary-color); flex:none; font-size:14px; }
.buy-btn text { color:var(--primary-color); }
.fab-cart { width:auto; height:auto; min-height:48px; left:24rpx; right:24rpx; bottom:calc(16rpx + env(safe-area-inset-bottom)); padding:12px 16px; box-sizing:border-box; border-radius:12rpx; font-size:16px; line-height:1.5; }
.quantity-error { color:var(--error-color); font-size:14px; line-height:1.6; }
.switch-remember label { display:flex; align-items:center; min-height:44px; padding:12px; font-size:14px; line-height:1.6; color:var(--text-regular); }
.station-picker-close,.station-picker-item,.search-clear,.station-bar { min-height:44px; }

.product-img { width:60px; height:84px; margin:12px 0 12px 12px; border-radius:8rpx; }
.product-info { padding:12px; }
.product-card { align-items:flex-start; }
.catalog-quantity { flex-wrap:wrap; }
.buy-btn { height:auto; line-height:1.5; box-shadow:none; border-radius:0; }

.catalog-quantity-shared { width:180px; max-width:100%; min-width:0; }

.buy-link { flex:none; margin:0; }
.fab-cart.af-action { background:var(--af-primary); box-shadow:none; border-radius:8px; }
.station-picker .af-action--quiet, .load-error .af-action--quiet { padding:0; }

/* 真实商品图和购买工具分层；窄屏操作行自然换行。 */
.station-bar { background:var(--af2-surface-order); }
.product-card { align-items:flex-start; gap:12px; padding:16px 0; }
.product-img { width:20%; max-width:76px; min-width:56px; height:96px; margin:0; background:var(--af2-surface-neutral); border-radius:10px; }
.product-info { padding:0; gap:6px; }
.product-price { color:var(--af2-ink); font-size:20px; }
.btn-row { align-items:center; gap:4px 12px; }
.catalog-quantity-shared { width:142px; }
.buy-link { min-height:44px; }
@media (max-width:340px) { .product-card { flex-wrap:wrap; } .product-info { flex:1 1 175px; } .btn-row { width:100%; } }

/* Visual v2: page hierarchy and semantic surfaces. */
.search-bar { margin:12px 16px 0; padding:0; background:transparent; }
.search-input-wrap { background:var(--af2-surface); }
.section { margin:12px 16px; border-radius:14px; }

/* 商品操作归属原行；小屏先给数量工具完整宽度。 */
.product-card { flex-wrap:wrap; }
.product-img { width:76px; min-width:76px; }
.product-info { flex:1 1 0; }
.btn-row { flex:0 0 calc(100% - 88px); width:calc(100% - 88px); margin:0 0 0 88px; }
.quantity-error { flex-basis:100%; }
@media (max-width:340px) {
  .product-img { width:68px; min-width:68px; }
  .btn-row { flex-basis:100%; width:100%; margin-left:0; }
}
