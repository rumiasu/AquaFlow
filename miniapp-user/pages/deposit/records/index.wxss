.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.station-bar {
  display: flex;
  flex-direction: column;
  padding: 4rpx 8rpx 20rpx;
}

.station-bar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-bar-tip {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 加载失败卡片：与「暂无押金流水」严格分开，且文案是后端 message 原文 */
.error-card {
  background-color: #fff;
  border: 1rpx solid rgba(181, 68, 44, 0.3);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: none;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: var(--error-color);
  line-height: 1.6;
}

.error-btn {
  margin-top: 28rpx;
  height: auto;
  line-height: 1.6;
  text-align: center;
  border-radius: var(--radius-md);
  background-color: var(--primary-color);
  color: #fff;
  font-size: 14px;
  min-height: 44px;
  padding: 20rpx;
  box-sizing: border-box;
}

.error-btn.ghost {
  background-color: transparent;
  border: 1rpx solid var(--border-color);
  color: var(--primary-color);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 0;
  padding: 28rpx 24rpx;
  margin-bottom: 0;
  box-shadow: none;
  border-bottom: 1rpx solid var(--border-color);
  gap: 16rpx;
}

.record-main {
  flex: 1;
  padding-right: 0;
  min-width: 0;
  word-break: break-all;
}

.record-type {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.record-time {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.record-note {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.5;
}

.record-order {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-regular);
}

.record-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--price-color);
  white-space: normal;
  max-width: 46%;
  word-break: break-all;
  text-align: right;
}

/* 方向配色：正 = 入账，负 = 扣减。字号与字重一致，只有颜色不同（金额本身已带符号） */
.record-amount.amount-in {
  color: var(--success-color);
}

.record-amount.amount-out {
  color: var(--error-color);
}

.record-amount.amount-flat {
  color: var(--text-secondary);
}

.records-heading { padding: 8rpx 0 24rpx; }
.records-title { display: block; font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.records-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.7; color: var(--text-regular); }
.record-list { overflow: hidden; border: 1rpx solid var(--border-color); border-radius: var(--radius-md); background: #fff; }
.record-item:last-child { border-bottom: 0; }
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.refresh-hint { font-size: 26rpx; line-height: 1.6; color: var(--text-regular); padding: 20rpx 0; }

/* 本页所有状态共用的可读与触控边界。 */
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.error-btn { min-height: 44px; }
.record-main { min-width: 0; overflow-wrap: anywhere; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }

.record-item { gap:20rpx; align-items:flex-start; }
.record-main { min-width:0; overflow-wrap:anywhere; }
.record-amount { max-width:55%; font-size:18px; line-height:1.5; overflow-wrap:anywhere; }
.error-btn { min-height:44px; }

.error-card .af-action { margin:12px 8px 0 0; }

/* Visual v2: page hierarchy and reading rhythm. */
.record-list { margin:12px 16px; border-radius:14px; overflow:hidden; background:var(--af2-surface); }
.record-item { gap:12px; border-radius:0; }
.record-main { min-width:0; overflow-wrap:anywhere; }
.record-amount { text-align:right; overflow-wrap:anywhere; }
.records-heading { background:var(--af2-surface-money); border-radius:12px; padding:12px 16px; }

.record-date { padding:10px 16px; background:var(--af2-surface-neutral); color:var(--af2-ink-neutral); font-size:13px; line-height:1.5; font-weight:600; }

.record-type-row { display:flex; align-items:center; gap:8px; }
.record-direction-mark { flex:none; width:24px; height:24px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--af2-surface-money); color:var(--af2-ink-money); font-size:16px; }
