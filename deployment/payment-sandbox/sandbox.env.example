# Non-secret target/identity placeholders. Fill only after independent target/backup review.
SPRING_PROFILES_ACTIVE=payment-sandbox
DEV_LOGIN_ENABLED=false
MOCK_WECHAT_PAY=false
MOCK_PAYMENT_ISOLATED=false
MOCK_PAYMENT_CUSTOMER_IDS=
SERVER_FORWARD_HEADERS_STRATEGY=none
SPRING_SQL_INIT_MODE=never
PAYMENT_SANDBOX_ENV_ID=
PAYMENT_SANDBOX_SERVICE_ID=
PAYMENT_SANDBOX_BINDING_ID=
# Runtime values must be mapped from the reviewed platform deployment identity; never from an HTTP request.
PAYMENT_SANDBOX_RUNTIME_ENV_ID=
PAYMENT_SANDBOX_RUNTIME_SERVICE_ID=
PAYMENT_SANDBOX_DB_HOST=
PAYMENT_SANDBOX_DB_PORT=
PAYMENT_SANDBOX_DB_NAME=
PAYMENT_SANDBOX_DB_SERVER_UUID=
# Credentials must use the platform secret channel; do not save a completed env file or include it in an image.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
WX_APP_ID=
WX_APP_SECRET=
WX_STAFF_APP_ID=
WX_STAFF_APP_SECRET=
CORS_ALLOWED_ORIGINS=
