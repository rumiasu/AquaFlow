<view class="order-card" bindtap="onOrderTap">
  <view class="card-header">
    <text class="order-id">订单 #{{order.id}}</text>
    <view class="status-group">
      <text class="status-tag {{statusClass}}">{{statusText}}</text>
      <text class="pay-tag pay-{{order.paymentStatus === 2 ? 'paid' : order.paymentStatus === 0 ? 'unpaid' : 'other'}}">
        {{payStatusText}}
      </text>
    </view>
  </view>
  <view class="card-content">
    <view class="product-info">
      <text class="product-name">{{order.waterTypeName}}</text>
      <text class="product-spec" wx:if="{{order.waterTypeSpec}}">{{order.waterTypeSpec}}</text>
      <text class="product-qty">×{{order.quantity}}桶</text>
    </view>
    <view class="delivery-info">
      <text class="address">{{order.addressDetail}}</text>
      <text class="time">{{order.createTime}}</text>
    </view>
  </view>
  <view class="card-footer">
    <view class="footer-left">
      <text class="amount" wx:if="{{order.amount}}">¥{{order.amount}}</text>
    </view>
    <view class="footer-actions">
      <button wx:if="{{order.status === 1 || order.status === 4}}" class="btn-cancel" catchtap="onCancel">取消订单</button>
      <button wx:if="{{order.status === 3}}" class="btn-reorder" catchtap="onReorder">再次购买</button>
    </view>
  </view>
</view>
