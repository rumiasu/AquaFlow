.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.service-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: none;
}

.service-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.service-item:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.service-value-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.service-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  line-height: 1.6;
}

.call-btn,
.copy-btn {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 500;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}


.copy-btn {
  background-color: var(--bg-gray);
  color: var(--text-regular);
  border: 1rpx solid var(--border-color);
}

.other-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: none;
}

.other-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.other-item:last-child {
  border-bottom: none;
}

.other-item:active {
  background-color: var(--bg-gray);
}

.other-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.other-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.category-item {
  padding: 12rpx 20rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-regular);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.category-item.active {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background: var(--primary-bg);
}

.content-input {
  width: 100%;
  height: 200rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 2026-10-28 RC3：320px视口88rpx只有约37.5px，输入触控框固定至少48px。 */
.contact-input {
  width: 100%;
  height: 48px;
  min-height: 48px;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 匿名提交开关（v46）：左文案右 switch，说明文字要能一眼读完后果 */
.anonymous-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 0;
  background: transparent;
  border-radius: 0;
  border-top: 1rpx solid var(--border-color);
}

.anonymous-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.anonymous-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.anonymous-desc {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.7;
}


.history-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-content {
  font-size: 28rpx;
  color: var(--text-primary);
}

.history-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }

.service-label { line-height: 1.7; word-break: break-all; }
.service-section > textarea:not(.content-input) { width: 100%; min-height: 180rpx; box-sizing: border-box; padding: 20rpx; background: var(--bg-gray); font-size: 28rpx; margin: 20rpx 0; }

.dispute-record { min-height: 88rpx; padding: 20rpx 0; display: flex; align-items: center; border-top: 1rpx solid var(--border-color); box-sizing: border-box; }
.dispute-record .service-label { margin-bottom: 0; }
.history-toggle { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; margin: 24rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); background: #fff; color: var(--primary-color); font-size: 28rpx; box-sizing: border-box; }

/* 本页所有状态共用的可读与触控边界。 */
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.history-status { margin: 24rpx; color: var(--text-regular); font-size: 26rpx; line-height: 1.65; }
.service-label { color: var(--text-regular); }
.history-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.service-section picker { min-height: 88rpx; display: flex; align-items: center; padding: 12rpx 0; }
.dispute-reason { display: block; width: 100%; height: 180rpx; padding: 20rpx; margin: 20rpx 0; font-size: 28rpx; line-height: 1.65; background: var(--bg-gray); border-radius: 8rpx; color: var(--text-primary); box-sizing: border-box; }
.refund-purpose { margin: 28rpx 0 16rpx; }
.refund-purpose-title { display: block; color: var(--text-primary); font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.refund-purpose-note { display: block; margin-top: 8rpx; color: var(--text-regular); font-size: 26rpx; line-height: 1.65; }
.refund-action-history { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border-light); }

/* 先填写反馈，退款关联与记录作为次级入口。 */
.field-label { display: block; margin: 20rpx 0 12rpx; font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.contact-input { margin-top: 0; }
.refund-option { display: flex; align-items: center; min-height: 88rpx; color: var(--primary-color); font-size: 28rpx; border-bottom: 1rpx solid var(--border-light); }
.category-item { min-height: 88rpx; }
.anonymous-row { align-items: center; }

.service-tabs { display: flex; margin: 24rpx 24rpx 0; background: #fff; border-radius: var(--radius-md); padding: 4rpx; }
.service-tab { flex: 1; min-height: 44px; display: flex; align-items: center; justify-content: center; color: var(--text-regular); font-size: 28rpx; }
.service-tab.active { color: var(--primary-color); font-weight: 600; border-bottom: 4rpx solid var(--primary-color); }
.refund-note-toggle { min-height: 44px; display: flex; align-items: center; color: var(--primary-color); font-size: 28rpx; border-top: 1rpx solid var(--border-light); margin-top: 24rpx; }
.category-item, .refund-option, .dispute-record, .history-toggle, .service-section picker { min-height: 44px; }

/* 客服页布局：触控容器与内部可见选择面分开；动作外观由共享合同提供。 */
.service-contact-title { display:flex; align-items:center; gap:8px; margin-bottom:8px; color:var(--af-strong); font-size:16px; font-weight:600; }
.call-btn { min-width:64px; }
.service-tabs { padding:4px; background:var(--af-soft); border-radius:8px; }
.service-tab { min-height:44px; padding:6px 4px; box-sizing:border-box; border:0; }
.service-tab.active { border:0; }
.category-list { gap:0 8px; margin:0 0 12px; }
.category-item { min-height:44px; padding:6px 0; border:0; background:transparent; }
.category-label { padding:0 10px; }
.category-item.active { border:0; background:transparent; }

.content-input, .contact-input { background:var(--af-surface); border:1px solid var(--af-border); border-radius:8px; }
.feedback-btn { min-height:48px; margin-top:24px; border-radius:8px; }
.refund-option { min-height:52px; margin-top:12px; }

/* 水站联系方式与反馈填写分层，原有费用争议说明保留。 */
.page-intro { padding:20px 16px 4px; }
.service-item { background:var(--af2-surface-order); padding:14px; border-radius:12px; }
.service-contact-title { color:var(--af2-ink-order); }
.service-tabs { margin:12px 16px 0; background:var(--af2-surface-neutral); }
.service-section { border-radius:14px; }
.contact-input { min-height:44px; box-sizing:border-box; }

/* Visual v2: page hierarchy and semantic surfaces. */
.category-list { display:flex; flex-wrap:wrap; }
.category-item { flex:0 1 auto; }
.field-label { margin-top:20px; }
.content-input { box-sizing:border-box; }
