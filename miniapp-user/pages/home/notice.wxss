.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 24rpx;
}

.notice-detail {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.notice-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.notice-time {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 32rpx;
}

.notice-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}
