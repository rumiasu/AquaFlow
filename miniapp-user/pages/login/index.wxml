<view class="page">
  <view class="login-bg"></view>
  <view class="login-content">
    <view class="logo-section">
      <view class="logo-wrap">
        <image class="logo" src="/assets/logo/aquaflow.jpg" mode="aspectFit"></image>
      </view>
      <text class="app-name">AquaFlow</text>
      <text class="app-desc">桶装水配送服务</text>
    </view>

    <view class="login-section">
      <!-- 微信一键登录：仅 wx.login 静默换 openid，不弹任何授权框 -->
      <button class="wx-login-btn" bindtap="onWxLogin" disabled="{{loading}}">
        <text wx:if="{{loading}}">登录中...</text>
        <text wx:else>微信一键登录</text>
      </button>

      <!-- 当前草稿如实告知未启用；仍不新增强制复选框或把登录视为全部隐私处理授权。 -->
      <view class="agreement">
        <text class="agreement-text">{{agreementNotice}}</text>
        <text class="agreement-text agreement-link" bindtap="onOpenAgreement" data-type="user">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-text agreement-link" bindtap="onOpenAgreement" data-type="privacy">《隐私政策》</text>
      </view>

      <!-- [2026-09-20] 仅非正式版显示：它直连 /api/auth/dev-login，该端点在 prod 下不存在。
           开发版/体验版保留（真机联调微信登录不通时的唯一退路），判断见 index.js 的注释。 -->
      <view class="dev-login-btn" bindtap="onDevLogin" wx:if="{{showDevLogin}}">
        <text>测试账号直接登录</text>
      </view>
    </view>
  </view>
</view>
