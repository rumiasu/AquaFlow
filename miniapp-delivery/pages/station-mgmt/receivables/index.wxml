<!-- 站长端「应收账款」台账。规格见 docs/design/20 §1 / §1.5。
     单笔金额、逾期天数与核销结果由服务端下发；所选合计按整数分相加用于登记前核对。 -->
<view class="page af2-page finance-page receivables-page {{customer ? 'has-settlement' : ''}}">

  <!-- 总览 -->
  <view class="receivable-overview af2-tone-panel af2-tone-money" wx:if="{{overview}}"><view class="finance-section-head"><icon name="wallet" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text class="card-title">应收账款</text></view>
    <view class="receivable-overview-main"><text class="receivable-amount">¥{{overview.outstandingAmount}}</text><text class="receivable-label">待收款合计</text></view>
    <view class="receivable-overview-details">
      <view class="receivable-metric"><text class="receivable-aux {{overview.overdueAmount > 0 ? 'hero-danger' : ''}}">¥{{overview.overdueAmount}}</text><text class="receivable-label">其中已逾期</text></view>
      <view class="receivable-metric"><text class="receivable-aux">{{overview.customerCount}}</text><text class="receivable-label">欠款客户</text><text class="receivable-label" wx:if="{{overview.overdueCustomerCount > 0}}">{{overview.overdueCustomerCount}} 家逾期</text></view>
    </view>
  </view>
  <!--
    [2026-09-27 走查 M05 修] 这一行原来是 `overview.scopeNote` —— 后端下发的口径说明
    原文是「待收款 = 支付状态为待收款且未取消的订单合计；逾期 = 其中已过应付日期的部分」，
    读起来像数据库注释（"支付状态为待收款"是列值口径，不是站长的话）。
    现在两件事分开：
      · 常显的一句用人话（"客户还没付的订单款"），只讲**这一页装的是什么**；
      · 后端那句口径收进「?」（HelpTip 已在本端 app.json 全局注册），要较真的人点开看。
    ⚠️ 后端仍在下发 scopeNote，本页不再直接铺在页面上 —— 口径的**数值**判据一个字没改。
  -->
  <view class="hint" wx:if="{{overview}}">
    <text>未付订单款；逾期不加收费用。</text>
    <help-tip title="这一页的口径" text="{{overview.scopeNote}}" />
  </view>
  <view class="load-error" wx:if="{{loadError}}">
    <text>待收账款没加载出来，不能据此判断已经结清。</text>
    <text>{{loadError}}</text>
    <view class="link" bindtap="onRetryLoad">重新加载</view>
  </view>

  <!--
    [2026-09-27 走查 M05 修] **当前筛选必须看得见**：首页「逾期应收」入口带 `?overdue=1`
    进来（coordination/index.js 的 TODO_ROUTES.overdueReceivable），落地就是逾期集合；
    原来入口不带参数、页面也没有任何筛选提示，站长不知道自己看的是全部还是逾期。
    两个按钮互斥、随时可切回全部 —— 报告明确要求"保留未逾期应收的查询能力"。
  -->
  <view class="filter-bar" wx:if="{{overview}}">
    <view class="af-choice {{!onlyOverdue ? 'af-choice--selected' : ''}}" bindtap="onFilterAll"><text class="af-choice__face">全部待收</text></view>
    <view class="af-choice {{onlyOverdue ? 'af-choice--selected' : ''}}" bindtap="onFilterOverdue"><text class="af-choice__face">只看逾期</text></view>
  </view>

  <!-- 客户列表 -->
  <block wx:if="{{!customer}}">
    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <!-- 空态分三种：逾期筛选下没结果 / 本站真的没有待收 / 列表为空。
         [2026-09-27 走查 M05] 逾期视图的空态必须给出回「全部待收」的路，否则站长会以为本站账全清了。 -->
    <view class="empty" wx:elif="{{!loadError && !customers.length && onlyOverdue}}">
      暂无逾期客户；全部待收仍可查询。
    </view>
    <view class="empty finance-empty" wx:elif="{{!loadError && !customers.length}}"><icon name="wallet" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text>当前没有待收款</text></view>
    <view class="card receivable-customer" wx:for="{{loadError ? [] : customers}}" wx:key="customerId"
          bindtap="onPickCustomer" data-id="{{item.customerId}}">
      <view class="receivable-customer-body">
      <view class="row-between">
        <text class="row-title">{{item.customerName}}</text>
        <text class="row-amount">¥{{item.outstandingAmount}}</text>
      </view>
      <view class="row-sub">
        {{item.orderCount}} 单待收
        <text wx:if="{{item.earliestDueDate}}"> · 最早 {{item.earliestDueDate}} 到期</text>
        <text wx:else> · 未设账期</text>
      </view>
      <view class="overdue-tag" wx:if="{{item.overdueAmount > 0}}">
        逾期 ¥{{item.overdueAmount}}（{{item.overdueOrderCount}} 单，最长 {{item.maxOverdueDays}} 天）
      </view>
      </view><text class="receivable-customer-arrow">›</text>
    </view>
  </block>

  <!-- 某客户的待收明细 + 核销 -->
  <block wx:else>
    <view class="card">
      <view class="row-between">
        <text class="row-title">{{customer.customerName}}</text>
        <text class="row-amount">¥{{customer.outstandingAmount}}</text>
      </view>
      <view class="row-sub">
        账期：{{customer.dueDays ? customer.dueDays + ' 天（月结）' : '未设账期（即时结清）'}}
      </view>
      <view class="btn-row">
        <view class="af-action af-action--quiet" bindtap="onEditTerms"><text class="af-action__face">设置账期</text></view>
        <view class="af-action af-action--quiet" bindtap="onShowTermsHelp"><text class="af-action__face">账期说明</text></view>
        <view class="af-action af-action--quiet" bindtap="onBack"><text class="af-action__face">返回列表</text></view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="card-title">待收明细（{{orders.length}} 单）</text>
        <text class="link" wx:if="{{!ordersError && !loadError}}" bindtap="onSelectAll">{{selectedCount > 0 ? '取消全选' : '全选'}}</text>
      </view>
      <view class="empty" wx:if="{{ordersLoading}}">加载中…</view>
      <view class="load-error" wx:elif="{{ordersError}}">
        <text>明细没加载出来，不能把它当作没有待收订单。</text>
        <text>{{ordersError}}</text>
        <view class="link" bindtap="onRetryOrders">重新加载明细</view>
      </view>
      <view class="empty" wx:elif="{{!orders.length}}">没有待收订单。</view>
      <view class="row" wx:for="{{ordersError || loadError ? [] : orders}}" wx:key="orderId"
            bindtap="onToggleOrder" data-id="{{item.orderId}}">
        <view class="check {{item.checked ? 'check-on' : ''}}"><text wx:if="{{item.checked}}">✓</text></view>
        <view class="row-main">
          <text class="row-title">订单 #{{item.orderId}} · {{item.amountText}}</text>
          <text class="row-sub">
            下单 {{item.createDateText}}
            <text wx:if="{{item.dueDateText}}"> · 应付 {{item.dueDateText}}</text>
            <text wx:else> · 无账期</text>
          </text>
          <text class="row-danger" wx:if="{{item.overdue}}">已逾期 {{item.overdueDays}} 天</text>
        </view>
      </view>
    </view>

    <view class="card settlement-bar">
      <view class="settlement-receipt" wx:if="{{settlementReceipt}}">{{settlementReceipt}}</view>
      <view class="settlement-total"><text>已选 {{selectedCount}} 单</text><view><text class="settlement-label">所选合计 </text><text class="settlement-amount">{{selectedAmountText || '待核实'}}</text></view></view><view class="settlement-caution">核实所选款项已实际收到后登记。</view>
      <view class="af-action af-action--primary af-action--block {{settling || loadError || ordersError || !selectedCount ? 'btn-disabled is-disabled' : ''}}" bindtap="onSettle">
        {{settling ? '登记中…' : '登记已收款'}}
      </view>
      <view class="hint">
        <!--
          [2026-09-27 走查 M06 修] 按钮原文「核销所选（收款 + 销账）」：「核销」是账务术语
          （POS/ERP 里的写法），站长要表达的动作是"这钱我收到了、给他销掉"。
          按钮改说动作；解释里**保留"核销"这个词**并当场解释它是什么意思 ——
          报告的原话是"收钱动作写『登记已收款』，解释里保留核销含义"。
          ⚠️ 只改文案：请求体、幂等口径、整批回滚的语义一个字没动。
        -->
        仅登记实际收到的钱并销账，不会向客户扣款。
      </view>
    </view>
  </block>

  <!-- 账期编辑（站级，v60：同一客户在别的站可以是另一个账期） -->
  <view class="mask" wx:if="{{termsVisible}}" bindtap="onCloseTerms"></view>
  <view class="dialog" wx:if="{{termsVisible}}">
    <view class="dialog-head"><icon name="bill" size="22px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text class="dialog-title">{{customer.customerName}} 的账期</text><button class="af-action af-action--quiet dialog-close" bindtap="onCloseTerms" aria-label="关闭账期编辑">×</button></view>

    <!--
      验资（v60）：等级 / 可赊额度 / 已用 / 逾期 —— **全部是服务端算好的**（GET /customers/{id}/risk），
      这里只渲染、不做任何算术，也不自带"关注=黄"这类映射：等级文案用后端下发的 levelText。
      risk 为 null（还没拉到或拉失败）时整块不显示 —— 不编造一个"正常"。
    -->
    <view class="risk-box" wx:if="{{risk}}">
      <view class="risk-line">
        <text class="risk-label">信用等级</text>
        <text class="risk-value">{{risk.levelText}}</text>
      </view>
      <view class="risk-line">
        <text class="risk-label">可赊额度</text>
        <text class="risk-value">¥{{risk.creditLimit}}</text>
      </view>
      <view class="risk-line">
        <text class="risk-label">已用额度</text>
        <text class="risk-value">¥{{risk.outstandingCredit}}</text>
      </view>
      <view class="risk-note">{{risk.reason}}</view>
    </view>

    <text class="label">账期（天）</text>
    <input class="dialog-input" type="number" placeholder="留空 = 未设账期（即时结清）"
           value="{{termsInput}}" bindinput="onTermsInput" />
    <view class="hint">
      新账期只用于之后的订单；历史到期日不变。
    </view>
    <view class="btn-row">
      <view class="af-action af-action--cancel af-action--form" bindtap="onCloseTerms">取消</view>
      <view class="af-action af-action--primary af-action--grow {{termsSaving ? 'btn-disabled is-disabled' : ''}}" bindtap="onSaveTerms">
        {{termsSaving ? '保存中…' : '保存'}}
      </view>
    </view>
    <!--
      重算未结账单：正因为"改账期不会改动历史订单"，才必须有这个显式动作。
      没有它，站长改完账期只会看到"老单没变"，然后以为系统坏了。
    -->
    <view class="recalc-note">历史未结账单</view>
    <view class="af-action af-action--danger-quiet {{recalcBusy ? 'btn-disabled is-disabled' : ''}}" bindtap="onRecalcTerms">
      {{recalcBusy ? '重算中…' : '把未结账单也改成新账期'}}
    </view>
  </view>

</view>
<business-dialog id="business-dialog" />
