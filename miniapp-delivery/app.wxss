/* ========== AquaFlow 配送员小程序 设计系统 ========== */
/*
 * [2026-09-26 轨道 D] 品牌色统一：色值照抄 miniapp-user/styles/variable.wxss，
 * 同一套品牌语法（浅灰白底 / 白色内容区 / 高对比文字 / 功能蓝 #1677FF / 紧凑圆角 / 极少阴影）。
 * 两端各自维护自己的 token、没有共享层 —— 这里是**同值**，不是引用。
 * ⚠️ --accent-gradient / --primary-gradient / --header-gradient 三个名字是历史包袱：
 * 「无渐变」硬规则下**只降级值、不改名**（客户端 variable.wxss:14-18 是先例）——
 * 改名会炸全端 25 处 var(--*-gradient) 引用，引用侧一处都不用动。
 */
page {
  /* 主色 - 功能蓝（唯一的品牌/交互色） */
  --primary-color: #1264D6;
  --primary-light: #1264D6;
  --primary-dark: #0D4FA8;
  --primary-bg: #EAF3FF;

  /* 「无渐变」硬规则：历史渐变变量统一降级为纯色（名字保留，见文件头注释） */
  --accent-color: #1264D6;
  --accent-gradient: #1264D6;
  --primary-gradient: #1264D6;
  --header-gradient: #1264D6;

  /* 功能色 */
  --success-color: #16834A;
  --warning-color: #A95516;
  --error-color: #BD3328;
  --info-color: #1677FF;

  /* 功能色浅底（2026-10-07 新增，与用户端 variable.wxss 同值；语义正本 docs/design/36 §1.1） */
  --success-bg: #EAF6EE;
  --warning-bg: #FFF3E8;
  --error-bg: #FFF0EE;

  /* 配送状态色 */
  --status-pending: #A95516;
  --status-delivering: #1677FF;
  --status-completed: #16834A;

  /* 中性色 */
  --text-primary: #182230;
  --text-regular: #4B596A;
  --text-secondary: #637083;
  --text-placeholder: #9CA7B5;

  /* 背景色 */
  --bg-color: #F5F6F7;
  --bg-white: #FFFFFF;
  --bg-gray: #F0F2F5;
  --bg-card: #FFFFFF;

  /* 边框 */
  --border-color: #DAE0E8;
  --border-light: #E8ECF1;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-round: 999rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 阴影（极少，仅分层用） */
  --shadow-sm: 0 2rpx 12rpx rgba(43, 42, 38, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(43, 42, 38, 0.05);
  --shadow-lg: 0 8rpx 32rpx rgba(43, 42, 38, 0.06);
  --shadow-primary: 0 8rpx 24rpx rgba(22, 119, 255, 0.10);
}

/* 全局容器 */
.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/*
 * [2026-09-26] 自绘底栏（tabBar.custom = true）下，tab 页的根容器要**自己**留出导航条的高度：
 * 原生 tabBar 会占掉视口，自绘的是浮在内容上（position: fixed），不留白最后一张卡片会被压住。
 * 高度 = 100rpx 导航条 + 底部安全区 + 一点余量。用法：三个 tab 页的根 view 加这个类。
 */
.container.custom-tabbar-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-success {
  background: var(--success-color);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-success::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

/* 卡片通用样式 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin: var(--spacing-md);
  padding: var(--spacing-lg);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: var(--spacing-md) 0;
}

/*
 * [2026-09-20 真机联调] 「部分数据没加载出来」提示条（全局，各页可复用）。
 * 为什么需要它：多个列表/汇总请求失败时被静默降级成空数据，页面渲染出的
 * 「0 单 / 0 桶」与"确实没有"完全无法区分（AGENTS §8.22）。
 * 用法：data 里放一个 loadError 字符串（空串 = 全部正常），wxml 写
 * `<view class="load-error" wx:if="{{loadError}}">{{loadError}}</view>`。
 * 当前使用方：pages/home（配送页看板）。色值走色板变量，别写死。
 */
.load-error {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 149, 0, 0.12);
  border-left: 6rpx solid var(--warning-color);
  color: var(--text-regular);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 2026-10-22：主动作保持完整触控高度，长文字允许换行。 */
.btn-primary, .btn-outline, .btn-gradient, .btn-success { box-sizing: border-box; min-height: 96rpx; display: flex; align-items: center; justify-content: center; line-height: 1.45; white-space: normal; }

/* 2026-10-22：仅留言省略一行，地址、商品、金额与动作仍按原规则完整展示。 */
.customer-note-preview {
  display: block;
  min-width: 0;
  max-width: 100%;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-regular);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 员工界面：恢复状态与正文层级。仅本端使用，不承载业务状态判断。 */
page { color: var(--text-primary); font-size: 28rpx; line-height: 1.55; background: var(--bg-color); }
button { box-sizing: border-box; font-size: 28rpx; line-height: 1.5; white-space: normal; word-break: break-all; border-radius: 12rpx; }
button[disabled] { opacity: .58; }
input, textarea { color: var(--text-primary); box-sizing: border-box; }
.ui-state { box-sizing: border-box; margin: 24rpx; padding: 28rpx; border: 1rpx solid var(--border-color); border-radius: 12rpx; background: var(--bg-white); }
.ui-state-title { display: block; color: var(--text-primary); font-size: 32rpx; font-weight: 600; line-height: 1.45; }
.ui-state-copy { display: block; margin-top: 12rpx; color: var(--text-regular); font-size: 28rpx; line-height: 1.65; word-break: break-all; }
.ui-state-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.ui-state button { margin: 20rpx 0 0; min-height: 80rpx; padding: 16rpx 24rpx; background: var(--primary-bg); color: var(--primary-color); font-weight: 600; }
.ui-state-actions button { margin: 0; flex: 1 1 220rpx; }
.ui-state button::after { border: none; }
.ui-stale { display: block; padding: 16rpx 20rpx; margin: 16rpx 0; background: var(--warning-bg); color: var(--warning-color); font-size: 26rpx; line-height: 1.6; border-radius: 8rpx; }
.load-error button { margin: 16rpx 0 0; color: var(--primary-color); background: #fff; min-height: 72rpx; padding: 12rpx 20rpx; }
.ui-proof-frame { overflow: hidden; }
.ui-image-fallback { width: 100%; height: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 12rpx; background: var(--bg-gray); color: var(--text-regular); font-size: 24rpx; line-height: 1.5; text-align: center; word-break: break-all; }
.ui-proof-image { display: block; width: 100%; height: 280rpx; }
