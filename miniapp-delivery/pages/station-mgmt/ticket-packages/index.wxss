@import "../../../styles/settings-sections.wxss";
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* [v54] 平台预设档：横排的"一键填入"卡片，数字全部来自后端，前端不做算术 */
.preset-row {
  display: flex;
  flex-wrap: wrap;
}
.preset-chip {
  min-width: 180rpx;
  flex: 1;
  padding: 16rpx 18rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx dashed var(--warning-color);
  border-radius: 12rpx;
  background: var(--primary-bg);
}
.preset-chip:last-child {
  margin-right: 0;
}
.preset-qty {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}
.preset-price {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 4rpx;
}
.preset-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}
.field-label {
  width: 220rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  height: 64rpx;
  background: var(--bg-gray);
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  overflow: hidden;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-title {
  font-size: 28rpx;
  color: var(--text-primary);
}
.row-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}
.row-sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 34rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}
.mini-btn {
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--border-color);
  color: var(--text-primary);
  border-radius:12rpx;
  font-size: 14px;
  margin-bottom: 10rpx;
  white-space: nowrap;
  text-align: center;
}
.mini-btn-danger {
  border-color: var(--error-bg);
  color: var(--error-color);
}

.btn-primary {
  height: auto;
  line-height: 1.5;
  text-align: center;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 16px;
  margin-top: 20rpx; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-ghost {
  height: auto;
  line-height: 1.5;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 14px;
  color: var(--text-primary); min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-disabled {
  background: var(--primary-bg);
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  line-height: 40rpx;
}
.hint {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 14rpx;
}

.product-search { background:var(--bg-gray); border-radius:12rpx; padding:20rpx; margin:16rpx 0; }
.product-thumb { width:64rpx; height:64rpx; border-radius:10rpx; flex-shrink:0; }
.thumb-fallback { display:flex; align-items:center; justify-content:center; background:var(--primary-bg); color:var(--text-secondary); }
.product-identity { display:flex; flex-direction:column; min-width:0; overflow-wrap:anywhere; }.product-spec { font-size: 24rpx; color:var(--text-secondary); }
.history-link { padding:18rpx 0; color:var(--primary-color); font-size:26rpx; }.warning { color:var(--warning-color); }

/* 本页按账事实与办理动作排版；不改变金额、状态或办理资格。 */

.page { box-sizing: border-box; background: var(--bg-color); min-height: 100vh; }.card { border-radius: 12rpx; }
.field { align-items: flex-start; flex-direction: column; gap: 12rpx; border-color: var(--border-color); }.field-label { width: auto; }.field-input { flex: none; width: 100%; min-width: 0; height: 88rpx; box-sizing: border-box; border-radius: 8rpx; }
.row { display: block; border-color: var(--border-color); padding: 24rpx 0; }.row-main { overflow: visible; min-width: 0; }.row-between { gap: 12rpx; align-items: flex-start; flex-wrap: wrap; }.row-title { word-break: break-all; font-weight: 600; }.row-amount { word-break: break-all; }
.actions { flex-direction: row; flex-wrap: wrap; gap: 16rpx; margin: 18rpx 0 0; }.mini-btn { flex: 1; min-width: 160rpx; margin: 0; }
.mini-btn,.btn-primary,.btn-ghost,.history-link { min-height: 48px; height: auto; box-sizing: border-box; padding: 20rpx; border-radius: 8rpx; display: flex; justify-content: center; align-items: center; line-height: 1.6; white-space: normal; word-break: break-all; }
.hint,.row-sub,.product-spec { color: var(--text-regular); font-size: 25rpx; line-height: 1.6; }.hint.warning { color: var(--warning-color); }
.preset-chip { border-radius: 8rpx; background: var(--primary-bg); border-color: var(--border-color); }.product-search { min-height: 88rpx; box-sizing: border-box; border-radius: 8rpx; }

/* 商品选择只占摘要入口；原生容器处理返回与滚动锁，列表和确认区分别布局。 */
.title-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.title-line .card-title { margin-bottom: 0; }
.scope-switch { display: flex; gap: 12rpx; margin: 20rpx 0; }
.scope-button { flex: 1; min-width: 0; margin: 0; padding: 16rpx 8rpx; min-height: 44px; line-height: 1.5; font-size: 14px; color: var(--text-regular); background: var(--bg-gray); border: 1rpx solid var(--border-color); border-radius: 8rpx; }
.scope-active { color: var(--primary-color); background: var(--primary-bg); border-color: var(--primary-color); }
.scope-label { display: block; font-size: 14px; color: var(--text-regular); margin-bottom: 12rpx; }
.selected-product { display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 64px; margin: 0; padding: 16rpx; background: var(--bg-gray); text-align: left; line-height: 1.5; border-radius: 8rpx; box-sizing: border-box; }
.product-identity { flex: 1; min-width: 0; text-align: left; }
.product-name { display: block; color: var(--text-primary); font-size: 16px; word-break: break-all; line-height: 1.5; }
.product-spec { display: block; word-break: break-all; }
.change-product,.selection-mark { flex: none; font-size: 14px; color: var(--primary-color); }
.compact-state { color: var(--text-regular); font-size: 14px; line-height: 1.6; padding: 16rpx 0 0; }
.empty { padding: 8rpx 0; }
.quantity-field { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.quantity-label { display: flex; flex: 1; min-width: 100rpx; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.quantity-field integer-stepper { flex: 2; width: auto; min-width: 168px; }
.field-note,.draft-note { color: var(--text-regular); font-size: 14px; line-height: 1.6; }
.draft-note { display: block; margin-top: 16rpx; }
.field-error { color: var(--error-color); font-size: 14px; line-height: 1.6; }
.inline-retry { margin: 8rpx 0; padding: 12rpx 20rpx; min-height: 44px; font-size: 14px; line-height: 1.5; color: var(--primary-color); background: var(--primary-bg); }
.history-link { width: 100%; margin: 12rpx 0 0; background: transparent; color: var(--text-regular); font-size: 14px; }
.product-picker { display: flex; flex-direction: column; height: 100%; min-height: 0; box-sizing: border-box; }
.picker-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex: none; padding: 12rpx 24rpx; }
.picker-title { font-size: 18px; font-weight: 600; color: var(--text-primary); }
.picker-close { flex: none; width: 48px; min-height: 48px; margin: 0; padding: 0; line-height: 48px; font-size: 26px; background: transparent; color: var(--text-regular); }
.picker-search-wrap { flex: none; padding: 0 24rpx 16rpx; }
.picker-search-wrap .product-search { width: 100%; margin: 0; min-height: 44px; padding: 12rpx 16rpx; font-size: 16px; }
.picker-status { flex: 1; min-height: 0; padding: 16rpx 24rpx; font-size: 14px; color: var(--text-regular); line-height: 1.6; overflow-y: auto; }
.picker-list { flex: 1; height: 0; min-height: 0; }
.picker-option { display: flex; align-items: center; gap: 16rpx; width: 100%; margin: 0; padding: 20rpx 24rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--border-color); border-radius: 0; background: #fff; line-height: 1.5; }
.option-selected { background: var(--primary-bg); }
.picker-footer { flex: none; display: flex; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border-color); background: #fff; }
.picker-footer button { flex: 1; min-width: 0; margin: 0; min-height: 48px; padding: 12rpx; line-height: 1.5; font-size: 16px; border-radius: 8rpx; }
.picker-cancel { color: var(--text-regular); background: var(--bg-gray); }
.picker-confirm { color: #fff; background: var(--primary-color); }
.scope-button::after,.selected-product::after,.inline-retry::after,.picker-option::after,.picker-close::after,.picker-footer button::after,.history-link::after,.btn-primary::after,.btn-ghost::after,.mini-btn::after { border: none; }
.btn-primary[disabled],.picker-confirm[disabled] { color: var(--text-secondary); background: var(--bg-gray); }
.scope-button[disabled],.selected-product[disabled],.mini-btn[disabled] { opacity: .6; }

.picker-status.warning { color: var(--warning-color); }
.btn-ghost { background: transparent; }
