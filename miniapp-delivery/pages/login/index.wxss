.login-page {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 64rpx 32rpx;
  background: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 48rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 74, 104, 0.25);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.form-area {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 50rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: var(--text-regular);
  margin-bottom: 12rpx;
  display: block;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: var(--primary-color);
}

.btn-area {
  width: 100%;
  margin-bottom: 40rpx;
}

.btn-primary {
  width: 100%;
  height: auto;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: none; min-height:44px; display:flex; align-items:center; justify-content:center; }

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-dev {
  width: 100%;
  height: auto;
  background: #fff;
  color: var(--text-secondary);
  border-radius: 12rpx;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-color);
  margin-top: 24rpx; min-height:44px; display:flex; align-items:center; justify-content:center; }

.btn-dev::after {
  border: none;
}

/* [2026-09-24] 「点击即同意」的告知行：贴在登录按钮正下方，居中。
   原来是 margin-bottom（它当时是页面最后一个块）；现在它夹在按钮与"开发者登录"之间，
   改成上下留白，避免和按钮挤在一起。
   ⚠️ .checkbox / .checkbox.checked / .check-icon 三条规则已删 —— 必须勾选的复选框
   随产品要求去掉了，规则留着会让人以为界面上还有个勾选框。 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 24rpx 0;
  flex-wrap: wrap;
  padding: 0;
  line-height: 1.7;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 2026-10-07：两个协议名已接只读草稿；品牌链接色沿用 design/36 §1.1。 */
.agreement-strong {
  font-size: 24rpx;
  color: var(--primary-color);
  text-decoration: underline;
}

.tips {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-regular);
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.btn-primary, .btn-dev { height: auto; min-height: 48px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.agreement-strong { display: inline-flex; min-height: 88rpx; align-items: center; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .btn-area > .af-action--block { margin-top: 16px; } .btn-area > .af-action--quiet { margin: 16px auto 0; } .agreement { gap: 2px; } .agreement .b2-inline-tool { padding: 0 2px; }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-login { padding:36px 20px; justify-content:flex-start; }
.lv2-login .logo-area { padding:24px 0 20px; margin:0 0 20px; gap:14px; }
.lv2-login-mark { width:64px; height:64px; display:flex; align-items:center; justify-content:center; background:var(--af2-surface-order); border-radius:18px; }
.lv2-login .title { font-size:28px; line-height:36px; margin:0; font-weight:600; }
.lv2-login .btn-area { margin:0; padding:20px 16px; background:var(--af2-surface); box-sizing:border-box; border-radius:16px; }
.lv2-login .btn-area > .af-action--primary { margin-top:0; }
.lv2-login .agreement { margin-top:14px; font-size:13px; line-height:22px; flex-wrap:wrap; }
.lv2-login .agreement .af-action__face { background:transparent; font-size:13px; padding:4px; }
.lv2-login .tips { margin-top:18px; text-align:left; }
.lv2-login .tip-text { font-size:13px; line-height:20px; color:var(--af2-muted); }

/* 临时测试凭据只留在当前表单；使用原页面色彩和操作按钮。 */
.test-login { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border-color, #e2e8f0); }
.test-login-title { display: block; margin-bottom: 16rpx; font-size: 26rpx; color: var(--text-secondary, #64748b); }
.test-login-input { box-sizing: border-box; height: 88rpx; margin-bottom: 16rpx; padding: 0 24rpx; border: 1rpx solid var(--border-color, #d8e0e8); border-radius: 16rpx; background: var(--bg-color, #fff); color: var(--text-primary, #1e293b); font-size: 28rpx; }

/* 白底品牌标记与页面正文分开，便于小尺寸阅读。 */
.aiquan-login-mark { width: 54px; height: 54px; }
