.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.privacy-popup {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  text-align: center;
  margin-bottom: 32rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 48rpx;
}

.privacy-link {
  color: #4F8EF7;
}

.privacy-buttons {
  display: flex;
  gap: 24rpx;
}

.btn-reject {
  flex: 1;
  background: #F5F5F5;
  color: #666666;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 24rpx 0;
}

.btn-reject::after {
  border: none;
}

.btn-agree {
  flex: 1;
  background: linear-gradient(135deg, #4F8EF7 0%, #3A7BD5 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.btn-agree::after {
  border: none;
}
