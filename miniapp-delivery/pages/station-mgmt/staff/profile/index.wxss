.page { background: var(--bg-color); min-height: 100vh; padding: 24rpx 24rpx 40rpx; }

.error-banner {
  background: var(--error-bg);
  border: 1rpx solid var(--error-color);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.error-text { font-size: 28rpx; font-weight: 600; color: var(--error-color); }
.error-hint { font-size: 24rpx; color: var(--text-secondary); line-height: 1.5; }

/* ===== 头部画像卡 ===== */
.profile-header {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.header-info { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 36rpx; font-weight: 700; color: var(--text-primary); }
.phone { font-size: 26rpx; color: var(--text-secondary); }
.badge-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 4rpx; }
.badge { font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 20rpx; color: #fff; }
.badge.role { background: var(--primary-bg); color: var(--primary-color); }
.badge.perf { color: #fff; }
.badge.rate { background: var(--primary-bg); color: var(--primary-color); }
.badge.status-on { background: var(--success-bg); color: var(--success-color); }
.badge.status-off { background: var(--bg-gray); color: var(--text-secondary); }

/* ===== 区块 ===== */
.section {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

/* ===== 指标宫格 ===== */
.metric-grid { display: flex; }
.metric-grid.second { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border-color); }
.metric { flex: 1; display: flex; flex-direction: column; align-items: center; }
.metric-value { font-size: 32rpx; font-weight: 700; color: var(--primary-color); }
.metric-value.small { font-size: 26rpx; }
.metric-value.warn { color: var(--error-color); }
.metric-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

/* ===== 明细行 ===== */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-top: 1rpx solid var(--border-color);
}
.row:first-of-type { border-top: none; }
.label { color: var(--text-secondary); }
.value { color: var(--text-primary); }
.value.warn { color: var(--error-color); }

/* ===== 进行中订单 ===== */
.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border-color);
  gap: 20rpx;
}
.order-item:first-of-type { border-top: none; }
.order-left { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.order-customer { font-size: 27rpx; color: var(--text-primary); font-weight: 600; }
.order-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.order-status { font-size: 24rpx; color: var(--text-secondary); }
.order-amount { font-size: 28rpx; color: var(--primary-color); font-weight: 600; }

.loading, .empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-md, 28rpx);
  padding-top: 120rpx;
}

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.page { box-sizing:border-box; }
.profile-header,.section { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); padding:24rpx; }
.avatar { width:80rpx; height:80rpx; border-radius:12rpx; font-size:34rpx; }
.name-row { flex-wrap:wrap; }
.name { font-size:36rpx; overflow-wrap:break-word; }
.phone { font-size:30rpx; color:var(--primary-color); display:flex; align-items:center; min-height:88rpx; }
.section-title { border-left:0; padding-left:0; line-height:1.5; font-size:30rpx; }
.metric-grid { display:flex; flex-wrap:wrap; }
.metric { flex:none; width:50%; min-width:0; box-sizing:border-box; align-items:flex-start; padding:20rpx 8rpx; border-bottom:1rpx solid var(--border-color); }
.metric-value { font-size:34rpx; overflow-wrap:anywhere; max-width:100%; }
.metric-label,.row .label,.error-hint { font-size:26rpx; color:var(--text-regular); line-height:1.6; }
.row .value { font-size:28rpx; overflow-wrap:break-word; }
.order-item { flex-wrap:wrap; align-items:flex-start; gap:16rpx; }
.order-left { min-width:0; }
.order-customer { font-size:32rpx; line-height:1.5; }
.order-address { font-size:28rpx; color:var(--text-regular); line-height:1.6; }
.order-right { flex-wrap:wrap; }
.order-amount { font-size:32rpx; }
.order-item { min-height:44px; box-sizing:border-box; }
.order-address { overflow:visible; white-space:normal; overflow-wrap:anywhere; }
.metrics-toggle { min-height:44px; height:auto; display:flex; align-items:center; justify-content:center; color:var(--primary-color); background:#fff; font-size:14px; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .profile-header { border-radius:14px; background:var(--af2-surface-order); } .profile-header .name { color:var(--af2-ink-order); } .order-item { border-bottom:1px solid var(--af-border); } .metric-grid.second .metric { background:var(--af2-surface-money); border-radius:12px; } .metric-grid.second .metric-value { color:var(--af2-ink-money); } .section { border-radius:14px; box-shadow:none; }


/* Restored order-row flex groups also contain very long currency values. */
.order-right { min-width:0; max-width:100%; overflow-wrap:anywhere; }
