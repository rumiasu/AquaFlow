<view class="container">
  <view class="service-section" wx:if="{{!refundRef}}">
    <text class="section-title">我的退款争议</text><text wx:if="{{myDisputesLoading}}">正在核对…</text>
    <text class="load-error" wx:if="{{myDisputesError}}">{{myDisputesError}}</text><button wx:if="{{myDisputesError}}" bindtap="onRetryMyDisputes">重新核对争议</button>
    <text wx:if="{{!myDisputesLoading && !myDisputesError && !myDisputes.length}}">暂无退款争议记录</text>
    <view wx:for="{{myDisputes}}" wx:key="disputeKey" data-type="{{item.refundType}}" data-id="{{item.refundId}}" bindtap="onHistoryRefund">
      <text class="service-label">{{item.objectText}} · {{item.statusText}} ›</text>
    </view><button wx:if="{{myDisputesMore && !myDisputesLoading}}" bindtap="onMoreMyDisputes">继续加载争议记录</button>
  </view>
  <!-- 客服信息 -->
  <view class="service-section" wx:if="{{!refundRef}}">
    <view class="service-item">
      <text class="service-label">客服电话</text>
      <view class="service-value-row">
        <!-- [2026-09-20 真机联调] 这里原来无论什么原因都写「未获取到」——
             电话接口失败与水站没登记电话长得一模一样（AGENTS §8.22）。现在如实分开说。 -->
        <text class="service-value">{{serviceInfo.phone || (phoneError ? '没查出来（' + phoneError + '）' : '该水站暂未登记')}}</text>
        <view class="call-btn" bindtap="onCallPhone">
          <text>拨打</text>
        </view>
      </view>
    </view>

    <!-- 电话没查出来时给一条显式说明：别让客户以为"水站没有电话" -->
    <view class="load-error" wx:if="{{phoneError && !serviceInfo.phone}}">水站电话没查出来（{{phoneError}}），不代表水站没留电话，可稍后重试</view>

    <!-- Station 当前没有其他联系方式字段，避免重复引导客户拨同一号码。 -->
  </view>

  <!-- 意见反馈表单 -->
  <view class="service-section">
    <text class="section-title">{{refundRef ? '退款异议与补充说明' : '意见反馈'}}</text>
    <block wx:if="{{!refundRef}}">
      <view class="call-btn" bindtap="onShowRefundOptions">关联一笔退款（可选）</view>
      <picker wx:if="{{refundOptions.length}}" range="{{refundOptions}}" range-key="objectText" bindchange="onSelectRefund">
        <view class="service-label">选择原款或退押金申请</view>
      </picker>
      <text class="load-error" wx:if="{{refundOptionsError}}">{{refundOptionsError}}</text>
      <view class="service-label" wx:if="{{refundOptionsMore}}" bindtap="onMoreRefundOptions">继续加载更早记录</view>
    </block>
    <block wx:else>
      <text class="service-label">{{refundRef.objectText || '正在核对退款记录'}}</text>
      <text class="service-label">仅本人和负责这笔退款的水站可查看，需保留身份。说明可不填，也可稍后再补充证据；提交说明不会办理退款或改变金额。</text>
      <view class="load-error" wx:if="{{refundError}}">{{refundError}} <text bindtap="onRetryRefund">重试</text></view>
      <view wx:if="{{refundReady && dispute}}">
        <text class="service-label">{{dispute.statusText}}</text>
        <text class="service-label" wx:if="{{dispute.lastResult}}">水站已登记结果：{{dispute.lastResult}}</text>
        <text class="service-label">水站可登记结果并结案，无需你确认；结案不会改变退款资格或实际退款。若仍有异议，可以再次提出。</text>
        <textarea wx:if="{{dispute.canOpen || pendingDispute}}" maxlength="1000" placeholder="请说明退款异议" value="{{disputeReason}}" bindinput="onDisputeReason" />
        <button wx:if="{{dispute.canOpen || pendingDispute}}" loading="{{disputeSubmitting}}" disabled="{{disputeSubmitting}}" bindtap="onOpenDispute">提出退款异议</button>
        <button wx:if="{{pendingDispute}}" disabled="{{disputeSubmitting}}" bindtap="onRetryDispute">重试原异议</button>
        <view wx:for="{{dispute.actions}}" wx:for-item="entry" wx:key="id"><text class="service-label">{{entry.actionText}} · {{entry.createTime}}</text><text class="history-content">{{entry.reason}}</text></view>
      </view>
    </block>
    <view class="category-list" wx:if="{{!refundRef}}">
      <view class="category-item {{category === '配送服务' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="配送服务">
        <text>配送服务</text>
      </view>
      <view class="category-item {{category === '商品与水' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="商品与水">
        <text>商品与水</text>
      </view>
      <view class="category-item {{category === '水桶押金' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="水桶押金">
        <text>水桶押金</text>
      </view>
      <view class="category-item {{category === '其他' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="其他">
        <text>其他</text>
      </view>
    </view>
    <textarea class="content-input" placeholder="{{refundRef ? '说明可选，证据可稍后补充' : '请描述您遇到的问题或建议...'}}" maxlength="{{refundRef ? 1000 : 500}}" value="{{content}}" bindinput="onContentInput" />
    <input class="contact-input" placeholder="联系方式（可选）" value="{{contact}}" bindinput="onContactInput" />

    <!-- 匿名提交开关（v46）。默认关闭 = 实名（data.anonymous 初值 false）。
         文案必须讲清后果，不能只写一个"匿名"了事：
           · 匿名之后水站认不出是谁提的 —— 也就没法针对性地回复/回访他；
           · 留了联系方式则例外：那是他主动留下的，水站仍能通过它联系。
         ⚠️ 本页只负责如实上报用户的选择，**不做任何身份隐藏**：
         站长端拿不到姓名/客户号是后端查询 SQL 层做的（FeedbackMapper）。
         前端隐藏 = 没隐藏（改个 setData 就看见了）。 -->
    <view class="anonymous-row" wx:if="{{!refundRef}}">
      <view class="anonymous-text">
        <text class="anonymous-label">匿名提交</text>
        <text class="anonymous-desc" wx:if="{{anonymous}}">已开启：这条反馈不会带上你的姓名，水站认不出是谁提的，也没法回复你；如果你填了联系方式，水站仍能通过它联系你。</text>
        <text class="anonymous-desc" wx:else>未开启（实名）：水站能看到你的姓名，可以针对你的问题回复你。</text>
      </view>
      <switch checked="{{anonymous}}" bindchange="onAnonymousChange" />
    </view>

    <view class="feedback-btn {{submitting || (refundRef && !refundReady) ? 'disabled' : ''}}" bindtap="onSubmit">
      <text>{{submitting ? '提交中...' : (refundRef ? '提交说明' : '提交反馈')}}</text>
    </view>
    <view wx:if="{{pendingRefundNote && !submitting}}" class="service-label" bindtap="onRetryOriginalNote">上一条结果待确认，点此重试原说明</view>
  </view>

  <!-- 我的反馈历史 -->
  <view class="other-section" wx:if="{{history.length > 0}}">
    <view class="other-item" wx:for="{{history}}" wx:key="id">
      <view class="history-main">
        <text class="service-label" wx:if="{{item.refundObjectText}}">{{item.refundObjectText}} · {{item.authorText}}</text>
        <text class="history-content">{{item.content}}</text>
        <text class="history-time">{{item.createTime}}</text>
        <button wx:if="{{!refundRef && item.refundType && item.refundId}}" data-type="{{item.refundType}}" data-id="{{item.refundId}}" bindtap="onHistoryRefund">查看退款争议与说明</button>
      </view>
    </view>
  </view>
  <!-- [2026-09-20] 历史拉不到时原来整块消失 = "你没提过反馈"。改成一句实情，别让客户以为记录丢了 -->
  <view class="other-section" wx:elif="{{historyError}}">
    <view class="other-item">
      <text class="history-content">反馈历史没加载出来（{{historyError}}），不代表你没有提过反馈</text>
    </view>
  </view>
</view>
