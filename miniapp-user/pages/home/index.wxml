<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="logo-row">
        <image class="logo-img" src="/assets/logo/aquaflow.jpg" mode="aspectFill" />
        <view class="logo-text">
          <text class="logo-name">AquaFlow</text>
          <text class="logo-slogan">纯净之水 净享生活</text>
        </view>
      </view>
      <view class="search-bar" bindtap="onSearchTap">
        <icon name="search" size="32rpx" color="#94A3B8" />
        <text class="search-bar-placeholder">搜索商品名称</text>
      </view>
    </view>
  </view>

  <loading wx:if="{{loading}}"></loading>

  <block wx:else>
    <view class="station-bar" wx:if="{{isLogin}}" bindtap="onOpenStationList">
      <icon name="location" size="32rpx" color="#0EA5E9" />
      <text class="station-bar-label" wx:if="{{currentStation}}">{{currentStation.name}}</text>
      <text class="station-bar-label station-bar-empty" wx:else>请选择服务水站</text>
      <icon name="arrow" size="24rpx" color="#94A3B8" />
    </view>

    <view class="no-station-section" wx:if="{{state === 'claimPending' && !loading}}">
      <view class="no-station-card">
        <icon name="location" size="80rpx" color="#F59E0B" />
        <text class="no-station-title">等待水站认领</text>
        <text class="no-station-desc">您的客户资料正在等待对应水站确认，认领成功后即可下单购水</text>
        <view class="no-station-btn pending">
          <text>等待认领中…</text>
        </view>
      </view>
    </view>

    <view class="no-station-section" wx:if="{{state === 'noStation' && !claimPending && !loading}}">
      <view class="no-station-card">
        <icon name="location" size="80rpx" color="#0EA5E9" />
        <text class="no-station-title">请选择服务水站</text>
        <text class="no-station-desc">选择水站后可查看该站商品并下单</text>
        <view class="no-station-btn" bindtap="onOpenStationList">
          <text>选择水站</text>
        </view>
      </view>
    </view>

    <view class="banner" bindtap="onBannerTap" wx:if="{{state !== 'noStation' && state !== 'claimPending'}}">
      <image class="banner-img" src="/assets/banner/banner1.jpg" mode="aspectFill" />
      <view class="banner-overlay">
        <text class="banner-title">纯净好水 健康生活</text>
        <text class="banner-subtitle">专业配送，品质如一</text>
        <view class="banner-btn">
          <text>立即下单</text>
        </view>
      </view>
    </view>

    <view class="address-section" wx:if="{{isLogin && state !== 'noStation' && state !== 'claimPending'}}">
      <view class="address-card" bindtap="onAddressTap">
        <icon name="location" size="36rpx" color="#0EA5E9" />
        <view class="address-text" wx:if="{{address}}">
          <text class="address-detail">{{addressText || address.detail}}</text>
        </view>
        <view class="address-text" wx:else>
          <text class="address-empty">点击设置配送地址</text>
        </view>
        <icon name="arrow" size="32rpx" color="#CBD5E1" />
      </view>
    </view>

    <view class="quick-actions" wx:if="{{isLogin && state !== 'noStation' && state !== 'claimPending'}}">
      <view class="action-item" bindtap="onGoOrder">
        <view class="action-icon action-icon-primary">
          <icon name="cart" size="44rpx" color="#FFFFFF" />
        </view>
        <text class="action-text">立即下单</text>
      </view>
      <view class="action-item" bindtap="onGoOrderList">
        <view class="action-icon action-icon-success">
          <icon name="order" size="44rpx" color="#FFFFFF" />
        </view>
        <text class="action-text">我的订单</text>
      </view>
      <view class="action-item" bindtap="onGoTicket">
        <view class="action-icon action-icon-warning">
          <icon name="ticket" size="44rpx" color="#FFFFFF" />
        </view>
        <text class="action-text">我的水票</text>
      </view>
      <view class="action-item" bindtap="onGoBarrel">
        <view class="action-icon action-icon-accent">
          <icon name="barrel" size="44rpx" color="#FFFFFF" />
        </view>
        <text class="action-text">我的水桶</text>
      </view>
    </view>

    <view class="section" wx:if="{{isLogin && recentOrders.length > 0 && state !== 'noStation' && state !== 'claimPending'}}">
      <view class="section-header">
        <text class="section-title">常用订单</text>
        <text class="section-link" bindtap="onGoTemplates">更多</text>
        <icon name="arrow" size="24rpx" color="#0EA5E9" />
      </view>
      <view class="recent-order-list">
        <view class="recent-order-card" wx:for="{{recentOrders}}" wx:key="id"
              bindtap="onViewOrder" data-id="{{item.id}}">
          <view class="recent-order-items">
            <view class="recent-order-item" wx:for="{{item.displayItems}}" wx:for-item="it" wx:key="name">
              <text class="recent-order-item-name">{{it.name}}</text>
              <text class="recent-order-item-spec" wx:if="{{it.spec}}">{{it.spec}}</text>
              <text class="recent-order-item-qty">×{{it.qty}}</text>
            </view>
          </view>
          <view class="recent-order-footer">
            <text class="recent-order-price">¥{{item.nextAmountText}}</text>
            <text class="recent-order-date">{{item.displayDate}}</text>
            <view class="recent-order-btn" catchtap="onReorder" data-id="{{item.id}}">
              <icon name="cart" size="28rpx" color="#FFFFFF" />
              <text>复购</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{isLogin && hasBarrelModule && state !== 'noStation' && state !== 'claimPending'}}">
      <view class="section-header">
        <text class="section-title">我的水桶</text>
        <text class="section-link" bindtap="onGoBarrel">查看全部</text>
        <icon name="arrow" size="24rpx" color="#0EA5E9" />
      </view>

      <!-- 站级汇总 -->
      <view class="barrel-summary">
        <view class="bs-item">
          <text class="bs-num">{{barrelSummary.heldBuckets || 0}}</text>
          <text class="bs-label">持有</text>
        </view>
        <view class="bs-item">
          <text class="bs-num">{{barrelSummary.deliveryBuckets || 0}}</text>
          <text class="bs-label">配送中</text>
        </view>
        <view class="bs-item">
          <text class="bs-num {{barrelSummary.owedBuckets > 0 ? 'owed' : ''}}">{{barrelSummary.owedBuckets || 0}}</text>
          <text class="bs-label">欠桶</text>
        </view>
        <view class="bs-item">
          <text class="bs-num">¥{{barrelSummary.depositBalance > 0 ? barrelSummary.depositBalance : (barrelSummary.depositTotal || 0)}}</text>
          <text class="bs-label">押金</text>
        </view>
      </view>
      <view class="owed-tip" wx:if="{{barrelSummary.owedBuckets > 0}}">
        <text>欠桶 {{barrelSummary.owedBuckets}} 桶：待回收空桶，退桶请与水站确认</text>
      </view>

      <!-- 持有明细 + 优先续购 -->
      <view class="barrel-sub-header" wx:if="{{barrelProducts.length > 0}}">
        <text class="barrel-sub-title">优先续购</text>
      </view>
      <view class="product-list" wx:if="{{barrelProducts.length > 0}}">
        <view class="product-card" wx:for="{{barrelProducts}}" wx:key="id">
          <view class="product-img" wx:if="{{item.imageUrl}}">
            <image src="{{item.imageUrl}}" mode="aspectFill" style="width:100%;height:100%;" />
          </view>
          <view class="product-img product-img-placeholder" wx:else>
            <text>💧</text>
          </view>
          <view class="product-info">
            <view class="name-row">
              <text class="product-name">{{item.name}}</text>
              <view class="barrel-tag" wx:if="{{item.barrelQty > 0}}">
                <text>持有{{item.barrelQty}}桶</text>
              </view>
            </view>
            <text class="product-brand" wx:if="{{item.brand || item.spec}}">{{item.brand}}{{item.brand && item.spec ? ' · ' : ''}}{{item.spec}}</text>

            <view class="barrel-meta-row">
              <text class="barrel-meta">持有 {{item.barrelQty || 0}}</text>
              <text class="barrel-meta transit" wx:if="{{item.inTransitQty > 0}}">配送中 {{item.inTransitQty}}</text>
              <text class="barrel-meta deposit">押金 ¥{{item.depositTotalText}}</text>
            </view>

            <view class="info-row" wx:if="{{item.hasProduct}}">
              <text class="product-price">¥{{item.price}}</text>
              <text class="product-deposit" wx:if="{{item.deposit > 0}}">押金 ¥{{item.deposit}}/桶</text>
            </view>
            <view class="stepper-row" wx:if="{{item.hasProduct}}">
              <view class="stepper-btn {{cart[item.id] <= 0 ? 'disabled' : ''}}"
                    bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="minus">
                <text>−</text>
              </view>
              <input class="stepper-input" type="number"
                     value="{{cart[item.id] || 0}}"
                     bindinput="onCartQtyInput" data-id="{{item.id}}" />
              <view class="stepper-btn"
                    bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="add">
                <text>+</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="barrel-empty" wx:else>
        <text>暂无桶资产明细</text>
      </view>
    </view>

    <view class="section" wx:if="{{(state !== 'noStation' && state !== 'claimPending') && products.length > 0}}">
      <view class="section-header">
        <text class="section-title">购物区 · 可供商品</text>
        <view class="shop-entry" bindtap="onGoShop">
          <text class="shop-entry-text">进入商城</text>
          <icon name="arrow" size="24rpx" color="#0EA5E9" />
        </view>
      </view>
      <view class="product-list">
        <view class="product-card" wx:for="{{products}}" wx:key="id">
          <view class="product-img" wx:if="{{item.imageUrl}}">
            <image src="{{item.imageUrl}}" mode="aspectFill" style="width:100%;height:100%;" />
          </view>
          <view class="product-img product-img-placeholder" wx:else>
            <text>💧</text>
          </view>
          <view class="product-info">
            <view class="name-row">
              <text class="product-name">{{item.name}}</text>
            </view>
            <text class="product-brand" wx:if="{{item.brand}}">{{item.brand}} · {{item.spec}}</text>
            <view class="info-row">
              <text class="product-price">¥{{item.price}}</text>
              <text class="product-deposit" wx:if="{{item.deposit > 0}}">押金 ¥{{item.deposit}}</text>
            </view>
            <view class="stepper-row">
              <view class="stepper-btn {{cart[item.id] <= 0 ? 'disabled' : ''}}"
                    bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="minus">
                <text>−</text>
              </view>
              <input class="stepper-input" type="number"
                     value="{{cart[item.id] || 0}}"
                     bindinput="onCartQtyInput" data-id="{{item.id}}" />
              <view class="stepper-btn"
                    bindtap="onCartQtyChange" data-id="{{item.id}}" data-type="add">
                <text>+</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="shop-banner" wx:if="{{isLogin && state !== 'noStation' && state !== 'claimPending'}}" bindtap="onGoShop">
      <view class="shop-banner-left">
        <view class="shop-banner-icon-wrap">
          <icon name="shop" size="48rpx" color="#FFFFFF" />
        </view>
        <view class="shop-banner-text">
          <text class="shop-banner-title">浏览全部商品</text>
          <text class="shop-banner-desc">查看{{currentStation.name || '水站'}}所有在售商品</text>
        </view>
      </view>
      <view class="shop-banner-arrow">
        <text class="shop-banner-btn-text">进入商城</text>
        <icon name="arrow" size="28rpx" color="#0EA5E9" />
      </view>
    </view>

    <view class="guest-section" wx:if="{{!isLogin}}">
      <view class="guest-banner">
        <image class="guest-banner-icon" src="/assets/logo/aquaflow.jpg" mode="aspectFill" />
        <text class="guest-banner-title">AquaFlow 送水到家</text>
        <text class="guest-banner-desc">请先登录选择服务水站后下单购水</text>
        <view class="guest-banner-btn" bindtap="onLogin">
          <text>登录后下单</text>
        </view>
      </view>
    </view>
  </block>

  <view class="fab-cart" wx:if="{{isLogin && cartCount > 0}}" bindtap="onSubmit">
    <icon name="cart" size="40rpx" color="#FFFFFF" />
    <view class="fab-cart-badge">
      <text>{{cartCount}}</text>
    </view>
  </view>

  <view class="station-picker-mask" wx:if="{{showStationList}}" bindtap="onCloseStationList"></view>
  <view class="station-picker {{showStationList ? 'show' : ''}}">
    <view class="station-picker-header">
      <text class="station-picker-title">选择服务水站</text>
      <view class="station-picker-close" bindtap="onCloseStationList">
        <text>关闭</text>
      </view>
    </view>
    <view class="station-picker-list">
      <view class="station-picker-item" wx:for="{{stationList}}" wx:key="id"
            bindtap="onSelectStation" data-id="{{item.id}}"
            class="{{item.id === currentStationId ? 'active' : ''}}">
        <view class="station-picker-item-info">
          <text class="station-picker-item-name">{{item.name}}</text>
          <text class="station-picker-item-addr" wx:if="{{item.address}}">{{item.address}}</text>
        </view>
        <text class="station-picker-item-check" wx:if="{{item.id === currentStationId}}">当前</text>
      </view>
      <view class="station-picker-empty" wx:if="{{stationList.length === 0}}">
        <text>暂无可用水站</text>
      </view>
    </view>
  </view>
</view>
