<view class="container">
  <!-- 隐私授权弹窗：本页用 wx.chooseLocation 导航、wx.chooseImage 传图，必须渲染（原因见 components/PrivacyPopup/index.js 文件头） -->
  <privacy-popup />
  <view class="info-card" wx:if="{{writePending}}">
    <text>操作仍在处理中，请稍候</text>
  </view>
  <view class="info-card" wx:if="{{detailError}}">
    <text wx:if="{{detailOutcomeText}}">{{detailOutcomeText}}</text>
    <text>详情刷新失败：{{detailError}}</text>
    <button size="mini" bindtap="onRetryDetail" loading="{{loading}}" disabled="{{loading || writePending}}">重新加载</button>
  </view>
  <!-- ══ 关键事实卡（2026-10-07 #19 R4，正本 docs/design/36 §2）══
       原整版蓝头降级为暖纸白卡：对象、单号、状态章、金额一屏读完（R1 详情页=暖纸白卡）。
       状态章 tint 底+实色字（R2）；金额与收款口径一律读后端投影
       （totalAmount / payStateText / needCollect，class 在 js 里算好，wxml 不做判断）。 -->
  <view class="fact-card">
    <view class="fact-top">
      <text class="fact-name">{{order.receiverName || order.customerName}}</text>
      <text class="fact-no">订单 {{order.orderNo || order.id}}</text>
    </view>
    <view class="fact-status-row">
      <text class="status-badge status-{{order.statusClass}}">{{order.statusText}}</text>
      <text class="aux-tag aux-{{l.type}}" wx:for="{{order.labels}}" wx:for-item="l" wx:key="type">{{l.text}}</text>
    </view>
    <view class="fact-amount-row" wx:if="{{order.amountText}}">
      <text class="fact-amount">{{order.amountText}}</text>
      <text class="fact-pay fact-pay-{{order.payChipClass}}" wx:if="{{order.payStateText}}">{{order.payStateText}}</text>
    </view>
  </view>

  <!-- 联系信息卡片 -->
  <view class="info-card" wx:if="{{order.dispatchAgreement && order.dispatchAgreement.serviceAmount !== undefined}}">
    <text>本单外包服务报价 ¥{{order.dispatchAgreement.serviceAmount}}（含水费及配送费用）</text>
    <text>{{order.dispatchAgreement.barrelNote}} · {{order.dispatchAgreement.barrelItems}} · 桶折款 ¥{{order.dispatchAgreement.barrelAmount}}</text>
    <button wx:if="{{isManager && order.status === 1 && order.dispatchAgreement.canEditQuote}}" bindtap="onEditDispatchQuote">调整本单外包报价</button>
    <button wx:if="{{isManager && order.status === 1 && order.dispatchAgreement.canEditQuote && order.dispatchAgreement.netBarrels > 0}}" bindtap="onEditBarrelTerms">明确净送桶补偿安排</button>
  </view>
  <view class="info-card">
    <view class="info-row" bindtap="onCallPhone">
      <text class="info-text">{{order.receiverPhone || order.customerPhone}}</text>
      <text class="info-action">拨打</text>
    </view>
    <view class="info-row" bindtap="onCopyAddress">
      <text class="info-text address">{{order.addressSnapshot || order.addressDetail}}</text>
      <text class="info-action">复制</text>
    </view>
    <!-- 楼层 / 电梯：配送员据此知道要不要上楼。文案已在 js 里按三态算好，
         不确定时整行不显示（不放假数据）。 -->
    <view class="info-row" wx:if="{{order.floorText}}">
      <text class="info-text">{{order.floorText}}</text>
    </view>
    <!-- 备货情况（契约 C4）：出发前就知道"这单备齐了没、还缺哪些商品"。
         口径由后端给（需求快照 − 已预留），不是库存实物量；最终仍以后端出库校验为准。 -->
    <view class="info-row" wx:if="{{order.stockPrepText}}">
      <text class="info-text">{{order.stockPrepText}}</text>
    </view>
  </view>

  <!--
    楼层上报与楼梯凭证（v43）：站长看的"两行对照" —— 配送员上报多少、客户地址里填的是多少。
    不一致时打提示标（防虚报）；权威的"标记"在收益明细的 note 里（后端生成）。
    照片不强制：配送员当时没拍，站长可以在这里补传（和客户就楼层/爬楼有争议时它是唯一凭证）。
    ⚠️ [2026-09-26] 「楼层凭证」统一改名「楼梯凭证」—— 配送员端那一块同时改名叫「楼层与楼梯凭证」，
       两端口径必须一致（同一张照片在两个端叫两个名字，站长与配送员对话时会对不上）。
  -->
  <view class="section" wx:if="{{order.reportedFloor || floorPhotos.length}}">
    <text class="section-title">楼层上报</text>
    <view class="info-row" wx:if="{{order.reportedFloorText}}">
      <text class="info-text">{{order.reportedFloorText}}</text>
      <text class="floor-warn" wx:if="{{order.floorMismatch}}">与地址不一致</text>
    </view>
    <view class="floor-proof-head">
      <text class="floor-proof-title">楼梯凭证</text>
      <text class="floor-proof-add" bindtap="onAddFloorPhoto">{{floorUploading ? '上传中…' : '＋ 补传照片'}}</text>
    </view>
    <view class="floor-proof-photos" wx:if="{{floorPhotos.length}}">
      <image class="floor-proof-img" wx:for="{{floorPhotos}}" wx:key="index" src="{{item}}"
             mode="aspectFill" data-index="{{index}}" bindtap="onPreviewFloorPhoto" />
    </view>
    <text class="floor-proof-tip" wx:else>还没有照片（不强制，但和客户就楼层有争议时它是唯一凭证）</text>
  </view>

  <!--
    送达凭证（[2026-09-26] 原名「签收凭证」）：配送员完成配送时拍的照片（`order_image.type = 1`）。
    客户打电话说"没收到水"时，站长在这里能看到当时拍下来的现场；**只读**（送达现场该由当时在场的人拍）。
    ⚠️ 只在**有照片**时成块显示；已送达/已完成却没有照片时给一句实话 ——
       "有照片"与"没拍"必须能区分（否则站长会以为配送员每次都拍了）。
  -->
  <view class="section" wx:if="{{deliveryPhotos.length}}">
    <text class="section-title">送达凭证</text>
    <text class="section-tip">配送员送达时拍的现场照片（{{deliveryPhotos.length}} 张）</text>
    <view class="floor-proof-photos">
      <image class="floor-proof-img" wx:for="{{deliveryPhotos}}" wx:key="index" src="{{item}}"
             mode="aspectFill" data-index="{{index}}" bindtap="onPreviewDeliveryPhoto" />
    </view>
  </view>
  <view class="section" wx:elif="{{showNoDeliveryProofTip}}">
    <text class="section-title">送达凭证</text>
    <text class="floor-proof-tip">配送员没有上传送达照片（不强制；客户说没收到时就没有现场凭据了）</text>
  </view>

  <!-- 订单内容 -->
  <view class="section">
    <text class="section-title">订单内容</text>
    <view class="order-content" wx:for="{{order.items}}" wx:for-item="it" wx:key="id">
      <text class="content-name">{{it.productNameSnapshot}}</text>
      <text class="content-spec" wx:if="{{it.specSnapshot}}">{{it.specSnapshot}}</text>
      <text class="content-qty">× {{it.quantity}} {{it.quantityUnit}}</text>
    </view>
  </view>

  <!--
    [2026-09-27 走查 D04 修] 标题原文是「客户备注」—— 而 `order.notes` 是把
    `orders.special_note`（**一个自由文本列**）按换行拆出来的全部内容，里面既有客户下单时
    自己写的留言，也有系统追加的操作留痕（`[分配] 站长分配给 配送5`、`[接单] 配送员ID=4`、
    `[外派]`、`[配送备注]`…，写入点见 OrderMapper.appendSpecialNote 的全部调用方）。
    挂到「客户备注」下面，等于**把系统记录冒称成客户说的话**：站长照着它去质问客户
    （"你不是备注了要放门口吗"），而那句话根本不是客户写的。
    ⚠️ 在这里**不许**用"像不像系统标记"的字符串规则去过滤/截断（会把客户原话一起切掉，
      而且标记形态没有契约保证）。后端 DTO 现在也**没有**区分客户留言与操作记录两个字段
      （`orders.special_note` 一列兼两用，见 docs/audit/history/review/2026-09-27-GPT-两端运行时体验走查.md 的 D04），
      所以这里退到报告允许的做法：**如实标成中性的「订单备注」**，内容原样保留、一条不删。
      等后端补下发"客户留言"字段后，这一块再拆成两段（需后端配合，已登记）。
  -->
  <view class="section" wx:if="{{order.deliveryTimeRequest}}">
    <text class="section-title">客户期望送达</text>
    <text class="info-text">{{order.deliveryTimeRequest}}</text>
    <text class="section-tip">期望时间供安排参考，不代表已约定送达时间。</text>
  </view>
  <view class="section" wx:if="{{order.notes && order.notes.length > 0}}">
    <text class="section-title">订单备注</text>
    <text class="section-tip">客户留言（包括期望送达时间）与处理记录逐行显示；期望时间供安排参考。</text>
    <view class="notes-list">
      <view class="note-item" wx:for="{{order.notes}}" wx:key="index">
        <text class="note-icon">⚠</text>
        <text class="note-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 回桶：标签与数值都由 js 算好（见 detail.js#buildReturnPlan）。
       首单是「押金桶 · 无需回桶」、送达后是「已回桶 N 个」，不下发桶的单整行不渲染 -->
  <view class="section" wx:if="{{order.returnValue}}">
    <view class="info-row-between">
      <text class="info-label">{{order.returnLabel}}</text>
      <text class="info-value">{{order.returnValue}}</text>
    </view>
  </view>

  <!-- 付款方式：文案由后端 order.payMethodText 下发，前端不自带 1/2/3 映射表、不写兜底默认值
       （写 `|| '现金'` 等于在展示层再造一份映射，后端改口径时这里会显示错的） -->
  <view class="section">
    <view class="info-row-between">
      <text class="info-label">付款方式</text>
      <text class="info-value">{{order.paymentMethodText}}</text>
    </view>
  </view>

  <!--
    历史订单（[2026-09-27 走查 D05 修]：**从配送正文里挪到后面**）。
    它回答的是"这个客户值不值得多照顾"（客户经营分析），而配送员上门的动作顺序是
    "认人认地址 → 搬什么货 → 有没有客户交待 → 收几只旧桶 → 收不收钱"。
    原先这一卡夹在「订单内容」与「客户备注」之间：常规送达要先滚过两个经营指标
    才能看到客户到底交代了什么（放门口 / 先打电话），那是本页最该被先看到的一句话。
    改法只动了**位置**：数值口径（historyCount / lastOrderDays）与展示形态一律没变。
  -->
  <view class="section">
    <text class="section-title">历史订单</text>
    <view class="history-row">
      <view class="history-item">
        <text class="history-label">近一年配送</text>
        <text class="history-value">{{order.historyCount || 0}}次</text>
      </view>
      <view class="history-divider"></view>
      <view class="history-item">
        <text class="history-label">最近一次</text>
        <text class="history-value">{{order.lastOrderDays || 0}}天前</text>
      </view>
    </view>
  </view>

  <!--
    支付流水（2026-09-18 接线）：接的是此前两个无界面端点
      GET /api/payments/by-order  按订单查该订单的全部支付流水（含退款冲正流水）
      PUT /api/payments/{id}/refund 站长对**单笔已付款流水**手工退款
    仅站长可见（后端两个端点都是 STATION_MANAGER 专属，配送员点了只会拿到权限不足）。
    ⚠️ 方式 / 状态文案一律用后端下发的 methodText / statusText，金额用后端给的 amount 原值，
       本页不做任何 1/2/3 映射，也不做金额加减。
    流水为空时整块不显示（与上方"楼层上报"同一处理，不显示空壳区块）。
  -->
  <view class="section" wx:if="{{canRefundPayment && payments.length}}">
    <text class="section-title">支付流水</text>
    <view class="pay-row" wx:for="{{payments}}" wx:key="id">
      <view class="pay-main">
        <view class="pay-line">
          <text class="pay-method">{{item.methodText}}</text>
          <text class="pay-status">{{item.statusText}}</text>
          <text class="pay-amount {{item.isRefund ? 'pay-amount-refund' : ''}}">{{item.amountText}}</text>
        </view>
        <text class="pay-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        <text class="pay-note" wx:if="{{item.note}}">{{item.note}}</text>
      </view>
      <!-- 只有「已付款」的流水可退；退款/已取消的流水不出现按钮，
           避免站长对着一条已退款的流水反复点（后端也会拒，但那是白点一次） -->
      <view class="pay-refund" wx:if="{{item.canRefund}}" data-id="{{item.id}}" data-index="{{index}}"
            bindtap="onRefundPayment">退款</view>
    </view>
  </view>

  <!-- ══ 操作区（2026-10-07 #11，正本 docs/design/36 §3）══
       主区：完成配送（主，仅 canComplete），导航/确认收款（次），更多操作（低频）。
       低频动作全部收进下方半屏弹层；所有显示条件（canComplete / canReport / canTransfer /
       canWithdrawTransfer / canReturn / canRequestCancel / 拒付三件套）保留原业务判据；处理器补单次执行和页面身份保护。 -->
  <view class="action-bar" wx:if="{{order.id && !loading && !detailError && !order.transferTarget}}">
    <button class="action-btn action-nav" bindtap="onNavigate" wx:if="{{!order.canCollect}}">
      <text>导航</text>
    </button>
    <button class="action-btn action-collect" bindtap="onConfirmCollection" wx:if="{{order.canCollect}}" disabled="{{actionBusy}}">
      <text>确认收款</text>
    </button>
    <button class="action-btn action-complete" bindtap="onComplete" disabled="{{actionBusy}}" wx:if="{{order.canComplete}}">
      <text class="action-icon">✓</text>
      <text>完成配送</text>
    </button>
    <button class="action-btn action-more" bindtap="onOpenMoreActions" disabled="{{actionBusy}}" wx:if="{{hasMoreActions}}">
      <text>更多操作</text>
    </button>
  </view>

  <view class="action-bar action-bar-confirm" wx:if="{{!loading && !detailError && order.canAcceptTransfer}}">
    <button class="action-btn action-reject" bindtap="onRejectTransfer" disabled="{{actionBusy}}">
      <text>拒绝转单</text>
    </button>
    <button class="action-btn action-accept" bindtap="onAcceptTransfer" disabled="{{actionBusy}}">
      <text>同意接手</text>
    </button>
  </view>

  <!-- ══ 更多操作半屏弹层（2026-10-07 #11）══
       点条目 = onMoreAction 统一分发：先关弹层、再调**原处理器**（弹层上叠 ActionSheet/Modal 会乱）。
       原按钮上的业务注释随条目保留（转单待确认收起 / 撤回只画转让行 / 申请取消只有配送中 / 拒付 v60）。 -->
  <view class="sheet-mask" wx:if="{{showMoreActions}}" bindtap="onCloseMoreActions" catchtouchmove="onSheetTouchMove"></view>
  <view class="sheet" wx:if="{{showMoreActions}}" catchtouchmove="onSheetTouchMove">
    <view class="sheet-title">更多操作</view>
    <scroll-view class="sheet-actions" scroll-y>

    <!-- 异常反馈（原 action-bar 第三钮）：记录现场问题，通知站长（实现 utils/delivery-problem，与首页共用） -->
    <view class="sheet-item" wx:if="{{order.canReport}}" data-act="onReport" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">异常反馈</text>
        <text class="sheet-item-desc">记录现场问题，通知站长</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    <!-- 转给同事：转单待对方确认期间收起「转给同事」——后端本来就拒绝第二条待确认转单，
         两个按钮并排只会让人先点错一个（2026-09-29 清单2）。 -->
    <view class="sheet-item" wx:if="{{order.canTransfer}}" data-act="onTransfer" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">转单给其他配送员</text>
        <text class="sheet-item-desc">从本站配送员里选一位，他同意后这单归他送</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    <!-- 撤回转单（2026-09-29 拍板 清单2）：转单改双方同意制后，发起人的反悔出口。
         只画**转让行**（transferPendingSubKind === 'TRANSFER'）：退回站长 / 站内取消申请
         各有各的决策路径；站间指定退回（DIRECTED）走协调页那套「召回/退回」，不在这条路上。 -->
    <view class="sheet-item" wx:if="{{order.canWithdrawTransfer}}" data-act="onCancelTransfer" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">{{cancelTransferBusy ? '撤回中…' : '撤回转单'}}</text>
        <text class="sheet-item-desc">对方还没确认前可以反悔</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    <!-- 退回站长：提交退回申请，站长确认后重新派人 -->
    <view class="sheet-item" wx:if="{{order.canReturn}}" data-act="onReturnToStation" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">退回站长</text>
        <text class="sheet-item-desc">提交退回申请，站长确认后重新派人</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    <!-- 申请取消：**只有「配送中(2)」给这个入口**（2026-09-22 修）。
         待配送(1) 本来就有「拒单」正门（走 rejectOrder，不经审批）；已送达(3) 不可取消。 -->
    <view class="sheet-item" wx:if="{{order.canRequestCancel}}" data-act="onRequestCancel" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">申请取消订单</text>
        <text class="sheet-item-desc">提交后需站长审批</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    <!-- 客户拒付（v60 接线）：**已送达(3) 且还要收款**时，可登记拒付风险。
         后端 POST /api/manager/exceptions?orderId= 是 STATION_MANAGER 专属，这里只对站长画。
         弹层里唯一的错误色条目（真正动账在原处理器的第 2 步确认弹窗）。 -->
    <view class="sheet-item sheet-item-danger" wx:if="{{isManager && order.status === 3 && order.needCollect}}"
          data-act="onRefusalWriteOff" bindtap="onMoreAction">
      <view class="sheet-item-info">
        <text class="sheet-item-name">{{refusalBusy ? '处理中…' : (order.independentBusinessRules ? '确认客户拒付（保留欠款）' : '客户拒付（走历史核销）')}}</text>
        <text class="sheet-item-desc">已送达待收款时登记拒付，两步确认</text>
      </view>
      <text class="sheet-item-arrow">›</text>
    </view>

    </scroll-view>
    <view class="sheet-cancel" bindtap="onCloseMoreActions">取消</view>
  </view>
</view>
