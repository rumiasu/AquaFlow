.page { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}
.card { padding: 24rpx; margin-bottom: 24rpx; border-radius: var(--radius-md); background: var(--bg-white);
  border: 1rpx solid var(--border-color);
}
.title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; color: var(--text-primary); }
.body { display: block; font-size: 26rpx; line-height: 1.7; margin-bottom: 16rpx; color: var(--text-regular); word-break: break-all; }
.error { display: block; font-size: 26rpx; color: var(--error-color); margin-bottom: 16rpx;
  line-height: 1.7;
  background: var(--error-bg);
  padding: 20rpx;
}
textarea { width: 100%; height: 180rpx; margin-bottom: 24rpx; font-size: 26rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
}
.record { padding-top: 16rpx; border-top: 1rpx solid var(--border-color);
  min-height: 88rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.card picker .body { min-height: 88rpx; display: flex; align-items: center; background: var(--bg-gray); padding: 0 20rpx; border-radius: var(--radius-sm); }

/* 本页所有状态共用的可读与触控边界。 */
.card .title { line-height: 1.5; }
.record .body { margin-bottom: 0; }

.tabs { display: flex; background: #fff; border-radius: var(--radius-md); margin-bottom: 24rpx; }
.tab { flex: 1; min-height: 44px; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--text-regular); }
.tab.active { color: var(--primary-color); font-weight: 600; border-bottom: 4rpx solid var(--primary-color); }
.closure-check { background: var(--bg-gray); border-radius: var(--radius-sm); padding: 20rpx; margin-bottom: 20rpx; }
.card picker .body, .record { min-height: 44px; }

.card .af-action { margin:8px 8px 0 0; }
.tabs { padding:4px; background:var(--af-soft); }
.tab.active { border:0; }
.request-status { display:block; color:var(--af-strong); font-size:20px; line-height:1.4; font-weight:600; margin-bottom:12px; }

/* Visual v2: page hierarchy and semantic surfaces. */
.card,.record { border-radius:14px; }
.closure-check { background:var(--af2-surface-neutral); border-radius:12px; }
.request-status { color:var(--af2-ink-order); }
.tab { min-height:44px; }

.account-profile-hint { color:var(--text-regular); }
.account-intake-status { display:block; padding:12px; margin-bottom:12px; border-radius:10px; background:var(--af2-surface-neutral); color:var(--text-primary); font-size:14px; line-height:1.5; }

/* 办理流程仅作说明；真实申请状态只出现在记录与详情。 */
.card { box-shadow:none; border-color:var(--border-light); padding:32rpx; }
.account-process { display:flex; align-items:center; gap:8px; margin:20px 0 10px; padding:16px 12px; background:var(--af2-surface-neutral); border-radius:10px; }
.account-process-step { display:flex; flex:1; min-width:0; align-items:center; flex-direction:column; gap:4px; color:var(--af2-ink); font-size:12px; line-height:20px; text-align:center; }
.account-process-number { display:flex; align-items:center; justify-content:center; width:24px; height:24px; color:var(--af2-primary); background:var(--af2-surface-order); border-radius:50%; font-size:12px; font-weight:600; }
.account-process-arrow { flex:none; color:var(--af2-muted); }
.account-process-note { display:block; color:var(--af2-muted); font-size:12px; line-height:20px; }
.record { border-radius:0; line-height:1.6; overflow-wrap:anywhere; }
.account-page .record.af-entry { display:flex; align-items:center; gap:12px; min-height:52px; border-bottom:1px dashed var(--af2-line); }
.account-page .record .af-entry__body { display:flex; flex:1; min-width:0; align-items:flex-start; flex-direction:column; gap:4px; }
.account-page .record .af-entry__title { color:var(--af2-ink); font-size:15px; font-weight:600; overflow-wrap:anywhere; }
.account-page .record-status { color:var(--af2-primary); font-size:12px; }
.account-page .record .af-entry__arrow { flex:none; color:var(--af2-muted); }
.request-status { display:inline-block; padding:8rpx 16rpx; border-radius:var(--radius-sm); background:var(--primary-bg); color:var(--primary-color); font-size:var(--text-body); }
.body { word-break:normal; overflow-wrap:anywhere; }
.error { overflow-wrap:anywhere; }
.card textarea { font-size:var(--text-body); min-height:160rpx; }
#request-detail { border-top:4rpx solid var(--primary-color); }
