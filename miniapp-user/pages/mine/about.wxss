.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.about-section {
  padding: 48rpx 24rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 26rpx;
  color: #999;
}

.info-section {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #333;
}

.info-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.copyright {
  text-align: center;
}

.copyright text {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  line-height: 1.8;
}
