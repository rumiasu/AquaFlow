# AquaFlow 后端必需的环境变量（复制为 .env 或直接在系统中配置）
# 注意：这些值一旦泄露，等同于把系统管理权交出去，禁止提交进仓库。
# 已被泄露的旧密钥请务必先去对应平台吊销并重新生成，不要直接复用。

# ---- JWT ----
# 签名密钥，长度 >= 32 位。泄露 = 任何人可伪造任意身份（含站长）的 token
JWT_SECRET=

# ---- 微信小程序 ----
# 微信公众平台 -> 开发管理 -> 开发设置
# 客户端小程序（miniapp-user，顾客）
WX_APP_ID=
WX_APP_SECRET=
# 员工端小程序（miniapp-delivery，站长 + 配送员）——与客户端是两个不同 appid。
# 不填只影响员工端微信登录（本地可用 dev-login），但生产必须配齐（prod 缺失即拒启）。
WX_STAFF_APP_ID=
WX_STAFF_APP_SECRET=

# ---- 腾讯云 COS ----
# 控制台 -> 访问管理 -> API 密钥管理
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/aquaflow?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- 其他 ----
# 生产环境必须显式配置实际前端域名，禁止使用 * 或 localhost
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# 开发登录后门开关：仅本地开发可设为 true，生产必须保持 false（接口本身已在 prod 环境移除）
# DEV_LOGIN_ENABLED=false

# ---- 告警（可选）----
# 系统故障告警的外部渠道。留空则只落 alert_log 表 + ERROR 日志（不是"告警没发生"）。
# 分级：系统故障→系统管理员（本渠道）；运营故障→水站站长（站长端 /api/manager/alerts 可查）。
#
# 不建群、直接到微信的推荐配法（Server酱）：
#   ALERT_SYSTEM_WEBHOOK=https://sctapi.ftqq.com/你的SendKey.send
#   ALERT_WEBHOOK_FORMAT=SERVERCHAN        # 消息落到微信「放糖服务号」，无需加群
# 建群场景（企业微信/钉钉群机器人，两者同格式，也是默认值）：
#   ALERT_SYSTEM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   ALERT_WEBHOOK_FORMAT=WECOM
# 自建接收端/其它中介：
#   ALERT_WEBHOOK_FORMAT=RAW               # 原样发 {"title","source","content","level"}
# ALERT_SYSTEM_WEBHOOK=
# ALERT_WEBHOOK_FORMAT=

# ---- 限流（可选）----
# 登录类端点（login / wx-login / wx-login-staff / dev-login / refresh / change-password）
# 的按 IP 固定窗口限流，默认每分钟 20 次。与按用户名锁定 [AQ-040] 正交，两层都要有。
# 多实例部署时必须改为集中式计数器（Redis），否则每个实例各限一份，等于放宽 N 倍。
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# 微信未付单超时自动取消（分钟；<=0 = 关闭）。只对微信单生效：现金是货到付款、水票要等扣票，
# 都不适用于"超时就取消"。见 service/UnpaidWechatOrderSweeper.java 与 docs/design/04 §4.8。
# WECHAT_PAY_TIMEOUT_MINUTES=30

# ---- 微信支付模拟渠道（可选，默认关闭；[2026-09-20] 新增）----
# 开启后顾客选「微信支付」点一下就成功，用于真实支付渠道接入前的全链路联调。
# ⚠️ **生产必须保持 false** —— 开启等于任何人选微信支付都能零元购。
# 它**只**取代"真实付款"这一下（payment_record 由 待收款(1) 直接置 已付款(2)）：
# 金额服务端重算、一单一条活跃流水（uk_payment_active_order）、水票扣减、押金入账、
# 订单付款状态只前进（markPaidIfCollectable）、对账等式 —— 全部照跑，一个字没放宽。
# 退款路径随之联动：模拟收到的钱能模拟退回，凭据里写明"模拟"，避免测试数据被当成真实资金记录。
# 本地默认在 application-local.yml 里打开；真实渠道接入时应**删掉**这个开关，别留成"永真"。
# MOCK_WECHAT_PAY=false

# ---- 企业身份（可选，默认关闭）----
# 平台级总开关：关掉后报价不再下发"可申请企业身份"提示、/api/enterprise/** 一律返回业务错误。
# ⚠️ 这个开关**没有前端入口**（产品裁定：平台级不做前端可视化），只能从这里/环境变量改。
# 关掉不影响已经是企业身份的历史客户。
# ENTERPRISE_IDENTITY_ENABLED=false
# 「大额订单」= 只算水：桶装水数量与"水费"（不含押金/配送费/楼层费）两条口径，命中任一即提示。
# 桶数是主口径（默认 30 桶）；金额口径默认关闭（0），需要的水站可在站长端按站单独设阈值。
# ENTERPRISE_LARGE_ORDER_BARRELS=30
# ENTERPRISE_LARGE_ORDER_WATER_AMOUNT=0
