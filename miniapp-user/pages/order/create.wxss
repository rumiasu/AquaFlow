  color: var(--primary-color);
  font-weight: 600;
}

/* 同上一组：宿主元素（原说明弹窗的按钮区）已不存在，保留不删 */
.asset-detail-popup .popup-btns {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-light);
  background: var(--bg-color);
  border-radius: 0 0 24rpx 24rpx;
}

.asset-detail-popup .popup-btns .btn-ok {
