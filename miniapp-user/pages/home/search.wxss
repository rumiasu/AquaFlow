.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.search-input {
  flex: 1;
  height: 64rpx;
  background-color: var(--bg-gray);
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.clear-btn {
  margin-left: 16rpx;
  color: var(--text-secondary);
  font-size: 36rpx;
}

.history-section,
.result-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.clear-history {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 12rpx 24rpx;
  background-color: var(--bg-gray);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text-regular);
}

.result-list {
  padding: 0;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.result-item:last-child {
  border-bottom: none;
}

.result-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  margin-right: 16rpx;
  background-color: var(--bg-gray);
}

.result-info {
  flex: 1;
}

.result-name {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.result-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.empty-section {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  color: var(--text-secondary);
  font-size: 28rpx;
}
