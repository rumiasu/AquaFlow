.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.company-card {
  background-color: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.company-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.company-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.company-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
  word-break: break-all;
  line-height: 1.5;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  min-height: 88rpx;
  gap: 20rpx;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row .label {
  font-size: 28rpx;
  color: var(--text-secondary);
  width: 132rpx;
  flex-shrink: 0;
}

.info-row .value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  min-width: 0;
  text-align: right;
  word-break: break-all;
  line-height: 1.6;
}

.info-row .input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
  height: 88rpx;
}

.action-bar {
  margin-top: 32rpx;
}

.edit-btn {
  background-color: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
  box-sizing: border-box;
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
  box-sizing: border-box;
}

.btn.cancel {
  background-color: var(--bg-gray);
  color: var(--text-secondary);
}

.btn.confirm {
  background-color: var(--primary-color);
  color: #fff;
}

.btn.disabled {
  opacity: 0.6;
}

.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
.page-intro { padding: 4rpx 0 24rpx; }
