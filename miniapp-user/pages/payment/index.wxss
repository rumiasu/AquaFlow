.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
}

/* 订单摘要 */
.order-summary {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.summary-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.summary-info {
  flex: 1;
}

.summary-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.summary-qty {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

.summary-addr {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.addr-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.addr-text {
  font-size: 26rpx;
  color: var(--text-regular);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-barrel {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.barrel-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.barrel-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

/* 金额明细 */
.amount-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.amount-row.total {
  padding-top: 20rpx;
}

.amount-label {
  font-size: 28rpx;
  color: var(--text-regular);
}

.amount-row.total .amount-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.amount-value {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 24rpx;
  color: var(--price-color);
  font-weight: 600;
}

.amount-num-small {
  font-size: 28rpx;
  color: var(--price-color);
  font-weight: 600;
}

.amount-num {
  font-size: 40rpx;
  color: var(--price-color);
  font-weight: 700;
}

.amount-detail {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.amount-hint {
  font-size: 24rpx;
  color: var(--success-color);
  font-weight: 500;
}

.amount-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 12rpx 0;
}

/* 支付方式 */
.pay-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.method-item.active {
  border-color: var(--primary-color);
  background: linear-gradient(135deg, rgba(30,64,175,0.03), rgba(59,130,246,0.06));
}

.method-item.disabled {
  opacity: 0.5;
}

.method-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.method-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.method-text {
  flex: 1;
}

.method-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.method-check text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(15, 23, 42, 0.06);
}

.submit-btn {
  height: 88rpx;
  background: var(--primary-gradient);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
}

.submit-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}
