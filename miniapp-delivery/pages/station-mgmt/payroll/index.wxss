/*
 * 2026-10-07：按最终 HTML 的奶油底、白卡、纵向商品卡和金额层次适配。
 * 附件是宽 550px 的画布；手机按内容宽度调整间距，输入和主操作仍保留触控高度。
 */
page { background: #FAF7F0; }
.page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ============ 顶部页签（分段控件） ============ */
.tabs {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
  box-shadow: 0 4rpx 20rpx rgba(43,42,38,0.04);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 64rpx;
  border-radius: 20rpx;
}
.tab-on {
  background: var(--primary-gradient);
  color: #fff;
  font-weight: 600;
}
.tab-help {
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 0 16rpx;
  flex-shrink: 0;
}

/* ============ 卡片 ============ */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(43,42,38,0.04);
}
.card-title-row {
  display: flex;
  align-items: center;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
/* 标题右侧的计数/单位（弱化，不与标题抢注意力） */
.card-count {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
/* 标题下的一句话：**与钱有关或说清后果**的才放这里，概念解释进 help-tip */
.card-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 10rpx;
}

/* ============ 商品 chip ============ */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 4rpx;
}
.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--bg-gray);
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--text-primary);
  background: #fff;
  margin: 0 16rpx 16rpx 0;
}
.chip-on {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background: var(--primary-bg);
  font-weight: 600;
}

/* ============ 表单：标签在上、控件在下 ============ */
.field {
  margin-top: 20rpx;
}
.field.col {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}
.field-2col {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.label {
  display: block;
  font-size: 25rpx;
  color: var(--text-regular);
  margin-bottom: 10rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  background: var(--bg-gray);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}
.picker {
  min-height: 88rpx;
  line-height: 40rpx;
  padding: 24rpx 20rpx;
  background: var(--bg-gray);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  overflow-wrap: anywhere;
}
/* 还没选：与"已经选了一个值"必须看得出区别（原来两者同色，等于没提示） */
.picker-empty {
  color: var(--text-secondary);
}

/* ============ 列表行 ============ */
.row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg-gray);
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  align-items: flex-start;
}
.row-title {
  font-size: 27rpx;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}
.row-amount {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}
.row-sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 34rpx;
}

/* ============ pill：状态标签与行内按钮 ============ */
.pill {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.pill-on {
  background: var(--success-bg);
  color: var(--success-color);
}
.pill-off {
  background: var(--bg-gray);
  color: var(--text-secondary);
}
/* 结算单状态（颜色由 js 的 statusPillClass 挑，文案来自服务端 statusText） */
.pill-draft {
  background: var(--warning-bg);
  color: var(--warning-color);
}
.pill-confirmed {
  background: var(--primary-bg);
  color: var(--primary-color);
}
.pill-paid {
  background: var(--success-bg);
  color: var(--success-color);
}

.actions-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.pill-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  border-radius: 999rpx;
  font-size: 24rpx;
  margin: 0 12rpx 10rpx 0;
  white-space: nowrap;
}
.pill-btn-main {
  background: var(--primary-color);
  color: #fff;
}
.pill-btn-danger {
  border-color: var(--error-color);
  color: var(--error-color);
}

/* ============ 结算单卡片 ============ */
.slip {
  padding: 28rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 28rpx;
  margin-top: 24rpx;
}
.slip:last-child {
  border-bottom: 2rpx solid var(--border-color);
}
.slip-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.slip-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}
.slip-amount {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  color: var(--primary-color);
  overflow-wrap: anywhere;
  line-height: 1.2;
}
.slip-mid {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.slip-period {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  line-height: 36rpx;
}
.slip-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 32rpx;
}
.slip-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}
.slip-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ============ 按条目汇总 ============ */
.sum-box {
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 18rpx;
  margin: 16rpx 0;
}
.sum-title {
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.sum-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.sum-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
}
.sum-dir {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 0 12rpx;
}
.sum-amount {
  font-size: 28rpx;
  font-weight: 600;
}
.sum-add {
  color: var(--success-color);
}
.sum-deduct {
  color: var(--error-color);
}
.sum-total {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--bg-gray);
  margin-top: 8rpx;
}

/* ============ 按钮 ============ */
.btn-primary {
  min-height: 88rpx;
  line-height: 40rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 28rpx;
}
.btn-ghost {
  min-height: 88rpx;
  line-height: 40rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-top: 18rpx;
}
.btn-disabled {
  opacity: 0.55;
}

/* ============ 空态 / 加载 ============ */
.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  line-height: 40rpx;
}
/* 注：卡片内的空态直接复用 .empty —— .card 自带 padding: 24rpx，
   不要再给空态加左右内边距，否则文字会比同卡的标题/输入框更靠里。 */

/* ============ 弹窗（明细 / 记一笔） ============ */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9;
}
.dialog {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: 6%;
  max-height: 86%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 10;
  box-sizing: border-box;
  overflow-y: auto;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.dialog-title {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  overflow-wrap: anywhere;
}
/* 明细弹窗顶部的合计（"这张单多少钱"第一眼就要看到） */
.slip-hero {
  text-align: center;
  padding: 16rpx 0 20rpx;
}
.slip-hero-amount {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.2;
}
.slip-hero-label {
  font-size: 23rpx;
  color: var(--text-secondary);
}
.kv {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}
.kv-k {
  width: 120rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.kv-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  word-break: break-all;
}
.detail-scroll {
  max-height: 520rpx;
  margin-top: 8rpx;
}

.payroll-search { padding:18rpx; background:var(--primary-bg); border-radius:12rpx; margin:12rpx 0; }
.payroll-date-row { display:flex; flex-wrap:wrap; gap:16rpx; align-items:center; font-size:24rpx; margin:18rpx 0; }.payroll-date-row picker { padding:14rpx; background:var(--primary-bg); border-radius:10rpx; }

/* 原生 button 的默认边框/边距会挤窄双按钮；只约束本页。 */
.page button { margin-left: 0; margin-right: 0; box-sizing: border-box; }
button::after { border: none; }
button[disabled] { background: #F4EFE4 !important; color: #A39E92 !important; opacity: 0.7; }
/* style v2 的 button:not([size='mini']) 自带固定宽度；单类选择器在原生页会输给它。 */
.page button.btn-primary, .page button.btn-ghost, .page button.retry-button { width: 100%; }
.product-list { margin-top: 24rpx; }
.product-card { display: flex; align-items: center; gap: 24rpx; padding: 24rpx; border: 2rpx solid var(--border-color); border-radius: 22rpx; margin-top: 18rpx; background: #fff; }
.product-default { background: #F8F9FC; }
.product-selected { border: 3rpx solid var(--primary-color); padding: 23rpx; }
.product-image { width: 100rpx; height: 128rpx; border-radius: 14rpx; flex-shrink: 0; background: #F4EFE4; }
.product-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; color: var(--text-secondary); font-size: 20rpx; }
.default-image { display: flex; align-items: center; justify-content: center; background: #E8F0F8; color: var(--primary-color); font-size: 48rpx; font-weight: 600; }
.product-copy { flex: 1; min-width: 0; }
.product-name { display: block; font-size: 29rpx; font-weight: 600; color: var(--text-primary); line-height: 40rpx; overflow-wrap: anywhere; }
.product-spec, .product-price { display: block; font-size: 24rpx; line-height: 34rpx; margin-top: 4rpx; overflow-wrap: anywhere; color: var(--text-regular); }
.product-spec { color: var(--text-secondary); }
.product-check { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: var(--primary-color); color: #fff; font-size: 28rpx; flex-shrink: 0; }
.configured-rate { padding: 24rpx; border: 2rpx solid var(--border-color); border-radius: 20rpx; margin-top: 20rpx; }
.configured-rate:last-child { border-bottom: 2rpx solid var(--border-color); }
.configured-default, .configured-default:last-child { background: #F8F9FC; border-color: #F8F9FC; }
.slip-person { flex: 1; min-width: 0; }
.slip-label { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 6rpx; }
.slip-money { text-align: center; padding: 32rpx 0; border-top: 2rpx solid #F1ECE1; border-bottom: 2rpx solid #F1ECE1; margin: 24rpx 0; }
.slip-action { flex: 1; min-width: 180rpx; min-height: 88rpx; padding: 24rpx 12rpx; line-height: 40rpx; font-size: 26rpx; border-radius: 20rpx; }
.slip-action-main { background: var(--primary-color); color: #fff; font-weight: 600; }
.slip-action-pay { background: var(--success-color); color: #fff; font-weight: 600; }
.slip-action-detail { border: 2rpx solid var(--border-color); background: #fff; color: var(--text-regular); }
.page button.slip-action { width: 0; }
.direction-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.direction-option { flex: 1; min-width: 160rpx; min-height: 88rpx; padding: 22rpx; line-height: 40rpx; font-size: 28rpx; border: 2rpx solid transparent; border-radius: 20rpx; background: #F4EFE4; color: var(--text-regular); }
.direction-selected { border-color: var(--primary-color); color: var(--text-primary); }
.page button.direction-option { width: 0; }
.item-card, .item-card:last-child { padding: 28rpx; border: 2rpx solid var(--border-color); border-radius: 28rpx; margin-top: 24rpx; }
.item-card .row-title { font-weight: 600; font-size: 30rpx; flex: 1; min-width: 0; }
.item-card .actions-row { display: flex; flex-wrap: nowrap; gap: 20rpx; margin-top: 24rpx; }
.item-record { flex: 1; min-width: 0; min-height: 88rpx; padding: 24rpx 12rpx; line-height: 40rpx; border-radius: 20rpx; font-size: 28rpx; background: var(--primary-color); color: #fff; font-weight: 600; }
.item-more { width: 88rpx; height: 88rpx; line-height: 80rpx; padding: 0; border: 2rpx solid var(--border-color); border-radius: 20rpx; color: var(--text-secondary); background: #fff; font-size: 40rpx; flex-shrink: 0; }
.page button.item-record { width: 0; }
.page button.item-more { width: 88rpx; }
.item-more-hint { display: block; font-size: 22rpx; color: var(--text-secondary); border-top: 2rpx solid #F1ECE1; padding-top: 18rpx; margin-top: 20rpx; line-height: 34rpx; }
.menu-mask { z-index: 20; }
.item-menu { position: fixed; z-index: 21; left: 0; right: 0; bottom: 0; padding: 28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; box-sizing: border-box; max-height: 85%; overflow-y: auto; }
.menu-title { display: block; font-size: 28rpx; font-weight: 600; padding: 8rpx 0 24rpx; overflow-wrap: anywhere; }
.menu-action, .menu-cancel { width: 100%; background: #fff; color: var(--text-primary); font-size: 30rpx; line-height: 44rpx; padding: 24rpx; border-top: 2rpx solid #F1ECE1; border-radius: 0; }
.menu-danger { color: var(--error-color); }
.menu-cancel { background: #F4EFE4; border: none; border-radius: 20rpx; margin-top: 20rpx; }
.page button.menu-action, .page button.menu-cancel { width: 100%; }
.menu-hint { display: block; text-align: center; color: var(--text-secondary); font-size: 23rpx; padding: 12rpx; line-height: 34rpx; }
.load-error { background: #FFF3E0; color: var(--text-regular); padding: 24rpx; border-radius: 20rpx; margin-bottom: 24rpx; font-size: 25rpx; line-height: 38rpx; overflow-wrap: anywhere; }
.retry-button { background: #fff; color: var(--primary-color); font-size: 26rpx; line-height: 40rpx; padding: 20rpx; margin-top: 16rpx; }
.hint { color: var(--text-secondary); font-size: 23rpx; line-height: 36rpx; margin: 12rpx 0; }
@media (max-width: 350px) {
  .tab { font-size: 24rpx; }
  .tab-help { width: 100%; text-align: right; line-height: 56rpx; box-sizing: border-box; }
  .product-card { gap: 18rpx; padding: 20rpx; }
  .product-selected { padding: 19rpx; }
  .product-image { width: 88rpx; height: 112rpx; }
  .slip-actions { flex-direction: column; align-items: stretch; }
  .slip-action { flex: none; }
  .page button.slip-action { width: 100%; }
}
