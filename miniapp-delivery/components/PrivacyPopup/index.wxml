<view class="privacy-mask" wx:if="{{show}}" catchtouchmove="preventMove">
  <view class="privacy-popup">
    <view class="privacy-title">用户隐私保护提示</view>
    <view class="privacy-content">
      <text>感谢您使用本小程序。在您使用本小程序前，请仔细阅读并同意</text>
      <!-- 2026-10-02 修复（F-54「员工端隐私指引链接不可点击」）：
           原来这里是无点击行为的 <text class="privacy-link">，点《用户隐私保护指引》毫无反应，
           微信隐私授权页拉不起来、也不报错。改为 navigator + open-type="openPrivacyContract"，
           与 miniapp-user 同组件保持一致（那边就是这个写法）。
           坑：navigator 默认块级，去掉 <text> 后这一句会被拆成三行，故 .privacy-link 必须留 display:inline。 -->
      <navigator class="privacy-link" open-type="openPrivacyContract">《用户隐私保护指引》</navigator>
      <text>。</text>
    </view>
    <view class="privacy-buttons">
      <button class="btn-reject" bindtap="onReject">不同意</button>
      <button class="btn-agree" id="privacy-agree-btn" bindtap="onAgree">同意</button>
    </view>
  </view>
</view>
