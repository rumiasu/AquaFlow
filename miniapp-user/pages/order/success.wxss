.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f8ef 0%, #f5f7fa 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 成功动画区 ========== */
.success-hero {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.success-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(82, 196, 26, 0.3);
}

.success-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(82, 196, 26, 0.2);
  animation: ring-expand 1.5s ease-out infinite;
}

@keyframes ring-expand {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}

.success-check {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
  margin-top: -4rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* ========== 常用订单区 ========== */
.template-section {
  width: 100%;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.template-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #fff;
}

.template-card:active {
  transform: scale(0.98);
}

.template-card.saved {
  border-color: #b7eb8f;
  background: linear-gradient(135deg, #f6ffed, #fff);
}

.template-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.template-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd666, #ffb347);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.3);
}

.template-icon-wrap.saved {
  background: linear-gradient(135deg, #95de64, #73d13d);
  box-shadow: 0 4rpx 12rpx rgba(115, 209, 61, 0.3);
}

.template-icon {
  font-size: 36rpx;
}

.template-check {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}

.template-text {
  flex: 1;
}

.template-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.template-title.saved {
  color: #52c41a;
}

.template-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.template-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

/* ========== 操作按钮 ========== */
.actions {
  width: 100%;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
}

.action-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.action-card:active {
  transform: scale(0.96);
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-icon-wrap.primary {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  box-shadow: 0 6rpx 20rpx rgba(79, 172, 254, 0.3);
}

.action-icon-wrap.secondary {
  background: linear-gradient(135deg, #ff9a76, #ffc371);
  box-shadow: 0 6rpx 20rpx rgba(255, 154, 118, 0.3);
}

.action-icon-text {
  font-size: 40rpx;
}

.action-info {
  text-align: center;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
}

/* ========== 底部提示 ========== */
.bottom-tip {
  margin-top: auto;
  padding-bottom: 80rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ccc;
}
