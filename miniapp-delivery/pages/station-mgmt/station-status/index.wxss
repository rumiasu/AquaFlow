/* 营业状态 + 公告（站长）。营业状态是软状态：只影响顾客看到的提示，不阻断下单。 */

.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title { font-size: 32rpx; font-weight: 600; }
/* 标题 + 「?」：问号紧贴标题，不用 .card-header 的 space-between 把它甩到最右边（2026-09-24） */
.card-title-row { display: flex; align-items: center; }
.card-sub { display: block; font-size: 24rpx; color: var(--text-secondary); margin-top: 10rpx; line-height: 1.5; }

.badge {
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
.badge-on { background: var(--success-bg); color: var(--success-color); }
.badge-warn { background: var(--warning-bg); color: var(--warning-color); }
.badge-off { background: rgba(0, 0, 0, 0.05); color: var(--text-secondary); }

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.option {
  flex: 1 1 46%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.option.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
}

.option-name { display: block; font-size: 28rpx; font-weight: 600; }
.option-desc { display: block; font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }

.field { margin-top: 24rpx; }
.label { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 10rpx; }

.input, .textarea {
  width: 100%;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input { height: 80rpx; }
.textarea { min-height: 160rpx; }

.counter { display: block; text-align: right; font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }

.preview {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--bg-gray); border-left: 4rpx solid var(--primary-color); color: var(--text-regular); }
.preview-label { display: block; font-size: 24rpx; color: var(--warning-color); }
.preview-text { display: block; font-size: 26rpx; color: var(--text-primary); margin-top: 8rpx; line-height: 1.5; }

.btn-primary {
  margin-top: 28rpx;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #fff;
  border-radius:12rpx;
  font-size: 16px;
  font-weight: 600;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-primary.flex1 { flex: 1; margin-top: 0; }

.link { font-size: 26rpx; color: var(--primary-color); }

.notice {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 22rpx 0;
}
.notice:first-of-type { border-top: none; }

.notice-head { display: flex; align-items: center; justify-content: space-between; }
.notice-title { font-size: 28rpx; font-weight: 600; }
.notice-content { display: block; font-size: 24rpx; color: var(--text-regular); margin-top: 8rpx; line-height: 1.5; }

.notice-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.notice-time { font-size: 24rpx; color: var(--text-secondary); }
.notice-actions { display: flex; gap: 24rpx; }
.btn-link { font-size: 14px; color: var(--primary-color); }
.btn-link.danger { color: var(--error-color); }

.empty { text-align: center; font-size: 24rpx; color: var(--text-secondary); padding: 40rpx 0; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.modal {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header { font-size: 32rpx; font-weight: 600; }

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.switch-label { font-size: 26rpx; }

.modal-footer { display: flex; gap: 16rpx; margin-top: 32rpx; }

.btn-cancel {
  flex: 1;
  height: auto;
  line-height: 1.5;
  border-radius: 42rpx;
  font-size: 14px;
  border: none;
  background: rgba(0, 0, 0, 0.05);
  color: var(--text-secondary); min-height:44px; display:flex; align-items:center; justify-content:center; }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.card { border-radius:12rpx; border:1rpx solid var(--border-color); }
.card-header,.card-title-row,.notice-head,.notice-footer { flex-wrap:wrap; gap:12rpx; }
.card-title { font-size:34rpx; }
.card-sub { font-size:28rpx; color:var(--text-regular); line-height:1.6; }
.options { gap:12rpx; }
.option { flex:1 1 100%; min-height:104rpx; border-radius:10rpx; }
.option.active { background:var(--primary-bg); }
.option-name { font-size:30rpx; }
.option-desc { font-size:26rpx; line-height:1.6; color:var(--text-regular); }
.textarea,.input { border:1rpx solid var(--border-color); border-radius:10rpx; font-size:30rpx; }
.preview { border-radius:8rpx; }
.preview-label,.preview-text,.notice-content { font-size:28rpx; line-height:1.6; }
.link,.btn-link { min-height: 44px; box-sizing:border-box; display:inline-flex; align-items:center; padding:12rpx 16rpx; font-size: 14px; }
.btn-primary,.btn-cancel { min-height: 48px; height:auto; line-height:1.5; padding:20rpx; border-radius:10rpx; font-size: 16px; box-sizing:border-box; }
.modal { max-height:86vh; border-radius:16rpx; }
.modal-footer { flex-wrap:wrap; gap:16rpx; }
