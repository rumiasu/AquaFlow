.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.address-list {
  padding: 24rpx;
}

.address-item {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-light);
}

.address-item.selectable {
  border: 2rpx solid transparent;
}

.address-item.selectable:active {
  border-color: var(--primary-color);
  background-color: var(--primary-bg);
}

.address-info {
  margin-bottom: 20rpx;
}

.selectable .address-info {
  margin-bottom: 0;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: var(--text-regular);
}

.default-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.address-tag .tag {
  font-size: 22rpx;
  color: var(--text-regular);
  background-color: var(--bg-gray);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.action-btn {
  font-size: 26rpx;
  color: var(--text-regular);
}

.action-btn.delete {
  color: var(--error-color);
}

.select-hint {
  display: block;
  text-align: right;
  font-size: 26rpx;
  color: var(--primary-light);
  padding-top: 12rpx;
}

.add-btn {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  height: 88rpx;
  background: var(--primary-gradient);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}
