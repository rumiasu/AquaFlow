.page {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 总览：三个数字一眼看完，逾期标红 */
.hero {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.hero-item {
  flex: 1;
  text-align: center;
}
.hero-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.hero-danger {
  color: var(--error-color);
}
.hero-label {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-title {
  font-size: 28rpx;
  color: var(--text-primary);
}
.row-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.row-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 36rpx;
}
.row-danger {
  display: block;
  font-size: 24rpx;
  color: var(--error-color);
  margin-top: 6rpx;
}

.overdue-tag {
  margin-top: 12rpx;
  background: rgba(181, 68, 44, 0.08);
  color: var(--error-color);
  font-size: 23rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  overflow: hidden;
}

.check {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
}
.check-on {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.link {
  color: var(--primary-color);
  font-size: 26rpx;
}

.btn-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.btn-ghost {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-round);
  font-size: 25rpx;
  color: var(--text-regular);
  margin-right: 16rpx;
}
.btn-primary {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: var(--radius-round);
  font-size: 30rpx;
  font-weight: 600;
}
.btn-inline {
  flex: 1;
  margin-left: 16rpx;
}
.btn-disabled {
  opacity: 0.45;
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 24rpx 0;
  line-height: 40rpx;
}
.hint {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}

/* 本页已有 24rpx 内边距，全局 .load-error 的左右 margin 会让提示条比卡片窄一截，这里对齐卡片 */
.load-error {
  margin: 0 0 20rpx;
}

/* ========== 当前筛选（[2026-09-27 走查 M05]） ==========
   首页「逾期应收」入口带 ?overdue=1 进来 ⇒ 落地就是逾期视图，这里必须让人**看得见**
   自己正在看哪个集合，并且一键切回全部（报告要求保留未逾期应收的查询能力）。
   样式与站内其他页签条同族：选中项用主色底。 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 26rpx;
  box-shadow: var(--shadow-sm);
}
.filter-item.active {
  background: var(--primary-color);
  color: #fff;
  font-weight: 600;
}

/* ========== 验资块（v60，账期弹窗内） ==========
   数字与那句话**全部来自服务端**（GET /customers/{id}/risk），这里只负责排版与配色。
   只染"预警/冻结"为红、"关注"为黄 —— 与后端 CustomerRiskService 的两档口径一致：
   关注是**正常经营**（月结客户天天如此），别做成告警的样子。 */
.risk-box {
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.risk-line {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  line-height: 42rpx;
}
.risk-label { color: var(--text-secondary); }
.risk-value { color: var(--text-primary); font-weight: 500; }
.risk-note {
  font-size: 23rpx;
  color: var(--warning-color);
  line-height: 34rpx;
  margin-top: 8rpx;
}

/* 「把未结账单也改成新账期」—— 与保存按钮分开一格，避免误点 */
.btn-recalc {
  display: block;
  margin-top: 20rpx;
  text-align: center;
}

/* 账期编辑弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.dialog {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 30%;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 10;
  box-shadow: var(--shadow-lg);
}
.dialog-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.dialog-input {
  height: 80rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
