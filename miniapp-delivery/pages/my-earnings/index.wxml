<!--
  员工端「我的工资」：只读自助页（规格 docs/design/18）。
  金额 / 时间 / 文案全部由 JS 预格式化（wxml 里不能调方法，也不能用 Math、Date）。
  这里刻意没有「提现 / 打款」按钮：发钱是站长在线下做的，系统只登记发放状态。
-->
<view class="page">

  <!-- 未结合计是配送员最关心的那个数，放在最上面 -->
  <view class="summary">
    <view class="summary-main">
      <text class="summary-label">未结合计（元）</text>
      <text class="summary-value">{{unsettledTotalText}}</text>
      <text class="summary-hint">还没被结算单算进去的工钱</text>
    </view>
    <view class="summary-side">
      <text class="summary-label">区间收益（元）</text>
      <text class="summary-value-sm">{{periodTotalText}}</text>
      <text class="summary-hint">{{from}} 至 {{to}}</text>
    </view>
  </view>

  <view class="chips">
    <view class="chip {{range === 'month' ? 'chip-on' : ''}}" bindtap="onRange" data-range="month">本月至今</view>
    <view class="chip {{range === 'today' ? 'chip-on' : ''}}" bindtap="onRange" data-range="today">只看今天</view>
  </view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>

  <block wx:if="{{!loading}}">
    <!-- ============ 结算单 ============ -->
    <view class="card">
      <view class="card-title">我的结算单</view>
      <view class="empty" wx:if="{{payrolls.length === 0}}">站长还没有给你开过结算单</view>
      <view class="payroll" wx:for="{{payrolls}}" wx:key="id">
        <view class="payroll-row">
          <text class="payroll-no">{{item.payrollNo}}</text>
          <text class="payroll-status">{{item.statusText}}</text>
        </view>
        <view class="payroll-row">
          <text class="payroll-period">{{item.periodText}}</text>
          <text class="payroll-amount">￥{{item.totalText}}</text>
        </view>
        <view class="payroll-paid" wx:if="{{item.paidText}}">已发放登记时间：{{item.paidText}}</view>
      </view>
    </view>

    <!-- ============ 收益明细 ============ -->
    <view class="card">
      <view class="card-title">收益明细</view>
      <view class="empty" wx:if="{{items.length === 0}}">这个区间还没有收益（没配计件单价时不会产生收益）</view>
      <view class="item" wx:for="{{items}}" wx:key="id">
        <view class="item-left">
          <text class="item-kind">{{item.kindText}}</text>
          <text class="item-meta">{{item.timeText}}<block wx:if="{{item.orderId}}"> · 订单 #{{item.orderId}}</block></text>
          <text class="item-meta" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="item-right">
          <text class="item-amount">{{item.amountText}}</text>
          <text class="item-detail" wx:if="{{item.detailText}}">{{item.detailText}}</text>
        </view>
      </view>
    </view>

    <!-- 口径说明由服务端下发，前端不复述 -->
    <view class="note" wx:if="{{note}}">{{note}}</view>
  </block>

</view>
