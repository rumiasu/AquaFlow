/* 站长资产调整单列表。单位一律 rpx；通用容器/卡片沿用 app.wxss 的 .container / .card，不在此重复定义 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: var(--bg-card);
}
.topbar-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.topbar-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.topbar-sub { font-size: 24rpx; color: var(--text-secondary); }
.btn-new {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

.record-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}
.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.card-head-left { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.adjust-no { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.adjust-type { font-size: 24rpx; color: var(--primary-color); }

/* 状态色：文案用后端下发的 statusText，这里只管配色 */
.status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.status.pending { background: var(--warning-bg); color: var(--warning-color); }
.status.effective { background: var(--success-bg); color: var(--success-color); }
.status.muted { background: var(--bg-gray); color: var(--text-secondary); }

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.info-row .label { color: var(--text-secondary); flex-shrink: 0; }
.info-row .value { color: var(--text-primary); text-align: right; word-break: break-all; }
.info-row .value.strong { font-weight: 600; color: var(--primary-color); }

.card-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn-ghost, .btn-exec {
  flex: 1;
  height: auto;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-ghost { background: var(--bg-gray); color: var(--text-regular); }
.btn-exec { background: var(--primary-gradient); color: #fff; font-weight: 600; }

.denied, .empty {
  text-align: center;
  padding: 140rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
.list-footer { text-align: center; padding: 20rpx 0 40rpx; font-size: 24rpx; color: var(--text-secondary); }

/* 2026-10-06：搜索与结果整行可点，小屏允许身份信息换行。 */
.customer-search-row { display:flex; align-items:center; gap:16rpx; }
.customer-search-row input { flex:1; min-width:0; }
.customer-search-row button { flex-shrink:0; margin:0; }
.customer-option { display:flex; flex-direction:column; padding:24rpx 0; border-bottom:1rpx solid var(--primary-bg); overflow-wrap:anywhere; }
.customer-selected { padding:24rpx 0 12rpx; font-weight:600; overflow-wrap:anywhere; }
.customer-selector .field-hint { display:block; font-size:24rpx; line-height:1.6; color:var(--text-secondary); }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { box-sizing:border-box; }
.topbar { flex-wrap:wrap; gap:16rpx; }
.topbar-title { font-size:36rpx; }
.topbar-sub { font-size:26rpx; color:var(--text-regular); line-height:1.6; }
.record-card { border:1rpx solid var(--border-color); border-radius:12rpx; box-shadow:none; }
.card-head { min-height:88rpx; gap:16rpx; }
.adjust-no { font-size:30rpx; overflow-wrap:anywhere; }
.info-row { gap:20rpx; font-size:28rpx; align-items:flex-start; }
.info-row .value { min-width:0; overflow-wrap:anywhere; }
.value.strong { font-size:34rpx; }
.label { color:var(--text-regular); }
.btn-new,.btn-ghost,.btn-exec { min-height: 44px; display:flex; justify-content:center; align-items:center; padding:16rpx 24rpx; box-sizing:border-box; border-radius:10rpx; font-size: 14px; }
.card-actions { gap:16rpx; }
