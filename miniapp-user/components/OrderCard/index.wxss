.order-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-id { font-size: 28rpx; color: #666; font-weight: 500; }
.status-group { display: flex; gap: 10rpx; align-items: center; }
.status-tag {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
}
.status-tag.warning { background: #fff7e6; color: #fa8c16; }
.status-tag.primary { background: #e6f7ff; color: #1890ff; }
.status-tag.success { background: #f6ffed; color: #52c41a; }
.status-tag.cancelled { background: #fff1f0; color: #f5222d; }
.status-tag.default { background: #f5f5f5; color: #999; }
.pay-tag {
  font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx;
}
.pay-tag.paid { background: #f6ffed; color: #52c41a; }
.pay-tag.unpaid { background: #fff1f0; color: #f5222d; }
.pay-tag.other { background: #f5f5f5; color: #999; }
.card-content { margin-bottom: 16rpx; }
.product-info { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.product-name { font-size: 30rpx; font-weight: 600; color: #333; }
.product-spec { font-size: 24rpx; color: #999; }
.product-qty { font-size: 26rpx; color: #666; margin-left: auto; }
.delivery-info { display: flex; flex-direction: column; gap: 4rpx; }
.address { font-size: 26rpx; color: #666; }
.time { font-size: 24rpx; color: #999; }
.card-footer {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 16rpx; border-top: 1rpx solid #f0f0f0;
}
.footer-left { display: flex; align-items: center; }
.amount { font-size: 32rpx; font-weight: 600; color: #fa8c16; }
.footer-actions { display: flex; gap: 16rpx; }
.btn-reorder, .btn-cancel {
  font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 30rpx;
  line-height: 1.6; margin: 0;
}
.btn-reorder {
  border: 1rpx solid #1890ff; color: #1890ff; background: #fff;
}
.btn-cancel {
  border: 1rpx solid #f5222d; color: #f5222d; background: #fff;
}
