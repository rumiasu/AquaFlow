<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <block wx:else>
    <!-- 品牌头（游客可见） -->
    <view class="brand-header">
      <text class="brand-icon">💧</text>
      <text class="brand-name">AquaFlow</text>
      <text class="brand-slogan">新鲜水源 · 快速配送 · 品质保障</text>
      <view class="brand-login" wx:if="{{!isLogin}}" bindtap="onLogin">
        <text>登录下单享优惠</text>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索水类型" value="{{keywords}}" bindinput="onSearch" />
        <text class="search-clear" wx:if="{{keywords}}" bindtap="onClearSearch">×</text>
      </view>
    </view>

    <!-- 全部水类型 -->
    <view class="section">
      <text class="section-title">全部水类型</text>

      <view class="product-grid">
        <view
          class="product-card"
          wx:for="{{allProducts}}"
          wx:key="id"
          wx:if="{{!keywords || item.name.indexOf(keywords) >= 0 || (item.spec && item.spec.indexOf(keywords) >= 0) || (item.note && item.note.indexOf(keywords) >= 0)}}"
        >
          <view class="card-header">
            <text class="product-name">{{item.name}}</text>
            <view class="owned-tag" wx:if="{{myProductIds.indexOf(item.id) >= 0}}">
              <text>已有</text>
            </view>
          </view>
          <text class="product-spec">{{item.spec}}</text>
          <text class="product-note" wx:if="{{item.note}}">{{item.note}}</text>
          <view class="card-footer">
            <view class="product-price" wx:if="{{item.price}}">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
              <text class="price-unit">/桶</text>
            </view>
            <view class="buy-btn {{isLogin ? '' : 'login-required'}}" bindtap="onBuyNow" data-id="{{item.id}}">
              <text>{{isLogin ? '去下单' : '登录购买'}}</text>
            </view>
          </view>
        </view>
      </view>

      <empty wx:if="{{allProducts.length === 0}}" text="暂无水类型"></empty>
    </view>
  </block>
</view>
