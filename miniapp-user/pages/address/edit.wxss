.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== 主卡片 ===== */
.addr-card {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  box-shadow: none;
}

/* ===== 表单行 ===== */
.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.field-row:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 110rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}

/* ===== 定位按钮（嵌入区域行右侧） ===== */
.auto-row {
  border-bottom: none;
}

.auto-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--primary-color);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  height: auto;
  flex-shrink: 0; min-height:44px; display:flex; align-items:center; justify-content:center; }

.auto-btn text {
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

/* ===== 省市区 ===== */
.region-row {
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 0;
}

.region-row .field-label {
  margin-bottom: 12rpx;
}

.region-fields {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.region-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-gray);
  border-radius: 8rpx;
  padding: 0 16rpx;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
}

/* ===== 区域快捷建议 ===== */
.suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0 16rpx 110rpx;
}

.suggest-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
}

.suggest-tag.active {
  color: var(--primary-color);
  background: var(--primary-bg);
}

/* ===== 标签行（家/公司/父母家） ===== */
.label-row {
  padding: 16rpx 0;
}

.label-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.label-chip {
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border: 2rpx solid transparent;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.label-chip.active {
  color: var(--primary-color);
  background: var(--primary-bg);
  border-color: var(--primary-color);
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 32rpx;
  margin-top: 8rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.default-toggle {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  position: relative;
}

.check-box::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 28rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg) translate(-2rpx, -4rpx);
  opacity: 0;
}

.check-box.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.check-box.checked::after {
  opacity: 1;
}

.default-text {
  font-size: 26rpx;
  color: var(--text-regular);
}

.save-btn {
  height: auto;
  padding: 0 40rpx;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
  font-weight: 500; min-height:44px; display:flex; align-items:center; justify-content:center; }

.save-btn.disabled {
  background: var(--text-placeholder);
}


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }

.field-help { display: block; margin: 20rpx 0 0; font-size: 24rpx; line-height: 1.6; color: var(--text-regular); }

/* 本页状态反馈：正文可读、操作至少 88rpx，蓝色只承担可执行动作。 */
.state-card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 20rpx; padding: 28rpx; margin: 20rpx 0; }
.state-title { display: block; color: #172b4d; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.state-note { display: block; color: #526174; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; margin-top: 8rpx; }
.state-error { border-color: #e4b9b3; }
.state-success { border-color: #bddacb; }
.state-banner { background: #eaf2ff; color: #235393; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; margin: 20rpx 0; }
.state-actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 16rpx; }
.state-button { margin: 20rpx 0 0; padding: 16rpx 24rpx; min-height: 44px; background: var(--primary-color); color: #fff; border-radius: 14rpx; font-size: 14px; font-weight: 600; line-height: 1.8; box-sizing: border-box; }
.state-actions .state-button { margin-top: 0; }
.state-button.secondary { color: #155aaf; background: #edf3fb; }
button { font-family: inherit; }
button::after { border: 0; }

.container { padding-left: 24rpx; padding-right: 24rpx; box-sizing: border-box; background: #f5f6f7; }
.page-intro { padding-left: 0; padding-right: 0; }
.addr-card { margin-left: 0; margin-right: 0; border: 1rpx solid #dce3ed; border-radius: 20rpx; }
.field-input, .region-input { font-size: 30rpx; color: #172b4d; }
.field-label { color: #526174; font-size: 28rpx; width: 128rpx; }
.field-help { color: #526174; font-size: 26rpx; }
.page-intro-title { color: #172b4d; }
.page-intro-note { color: #526174; font-size: 28rpx; }
.auto-btn, .save-btn { background: var(--primary-color); margin: 0; line-height: 1.8; box-sizing: border-box; }
.auto-btn text { font-size: 14px; }
.label-chip { font-size: 28rpx; color: #526174; }
.label-chip.active { color: #155aaf; background: #edf3fb; border-color: var(--primary-color); }
.default-text { color: #526174; font-size: 28rpx; }
.default-toggle { min-width: 280rpx; }
.save-btn { min-width: 260rpx; }

/* 地图是辅助操作，保存保持主动作；窄屏区域字段纵向排列。 */
.auto-btn { background: var(--primary-bg); }
.auto-btn text { color: var(--primary-color); }
.region-fields { flex-wrap: wrap; }
.region-input { min-height: 44px; flex: 1 1 160rpx; }
.label-chip, .default-toggle { min-height: 44px; }

.group-title { display: block; padding-top: 28rpx; font-size: 30rpx; font-weight: 600; color: var(--text-primary); }

.label-chip.af-choice, .label-chip.active.af-choice { padding:6px 0; border:0; background:transparent; }
button.address-save { min-width:120px; margin:0; }

/* Visual v2: page hierarchy and semantic surfaces. */
.addr-card { border-radius:14px; }
.field-row { min-height:52px; }
.field-input,.region-input { min-height:44px; box-sizing:border-box; }
.region-fields { flex-wrap:wrap; }

/* 默认设置与长保存状态在窄屏或大字下可自然换行。 */
.bottom-bar { flex-wrap:wrap; gap:8px 12px; }
.default-toggle { min-width:0; flex:0 1 auto; }
.default-text { overflow-wrap:anywhere; }
