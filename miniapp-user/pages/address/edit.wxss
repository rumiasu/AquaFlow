.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== 主卡片 ===== */
.addr-card {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  box-shadow: none;
}

/* ===== 表单行 ===== */
.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.field-row:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 110rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}

/* ===== 定位按钮（嵌入区域行右侧） ===== */
.auto-row {
  border-bottom: none;
}

.auto-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--primary-color);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.auto-btn text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 省市区 ===== */
.region-row {
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 0;
}

.region-row .field-label {
  margin-bottom: 12rpx;
}

.region-fields {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.region-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-gray);
  border-radius: 8rpx;
  padding: 0 16rpx;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
}

/* ===== 区域快捷建议 ===== */
.suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0 16rpx 110rpx;
}

.suggest-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
}

.suggest-tag.active {
  color: var(--primary-color);
  background: var(--primary-bg);
}

/* ===== 标签行（家/公司/父母家） ===== */
.label-row {
  padding: 16rpx 0;
}

.label-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.label-chip {
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border: 2rpx solid transparent;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.label-chip.active {
  color: var(--primary-color);
  background: var(--primary-bg);
  border-color: var(--primary-color);
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 32rpx;
  margin-top: 8rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.default-toggle {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  position: relative;
}

.check-box::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 28rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg) translate(-2rpx, -4rpx);
  opacity: 0;
}

.check-box.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.check-box.checked::after {
  opacity: 1;
}

.default-text {
  font-size: 26rpx;
  color: var(--text-regular);
}

.save-btn {
  height: 88rpx;
  padding: 0 40rpx;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.save-btn.disabled {
  background: var(--text-placeholder);
}


.page-intro { padding: 28rpx 24rpx 8rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }

.field-help { display: block; margin: 20rpx 0 0; font-size: 24rpx; line-height: 1.6; color: var(--text-regular); }
