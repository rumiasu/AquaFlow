<page-meta page-style="{{showEdit || showSetting ? 'overflow: hidden;' : ''}}" />
<view class="container">
  <!-- 隐私授权弹窗：本页用 wx.chooseImage 传商品图，必须渲染（原因见 components/PrivacyPopup/index.js 文件头） -->
  <privacy-popup />
  <view class="work-read-error" wx:if="{{productCreationRecovery}}">
    <text>{{productCreationRecovery.productId ? '原商品已创建，建档尚未全部完成' : '原商品创建结果待核实'}}</text>
    <text>{{productCreationRecovery.message}}</text>
    <button wx:if="{{productCreationRecovery.phase === 'packages-pending'}}" bindtap="onContinueCreatedProduct" disabled="{{saving || inboundBusy}}">继续原商品档位</button>
    <button wx:else bindtap="onVerifyProductCreation" disabled="{{saving || inboundBusy}}">重新读取商品目录</button>
  </view>
  <!-- 顶部：分段 + 搜索 + 分类筛选 -->
  <view class="top-bar">
    <view class="tabs">
      <text class="tab {{tab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">全部目录</text>
      <text class="tab {{tab === 'selected' ? 'active' : ''}}" bindtap="onTabChange" data-tab="selected">已选用</text>
      <text class="tab {{tab === 'mine' ? 'active' : ''}}" bindtap="onTabChange" data-tab="mine">我的商品</text>
    </view>
    <input class="search-input" placeholder="搜索名称/品牌/规格" value="{{keyword}}" bindinput="onKeywordInput" />
    <view class="chips category-filters">
      <text class="chip {{category === 0 ? 'active' : ''}}" bindtap="onCategoryFilter" data-value="0">全部</text>
      <text class="chip {{category === 1 ? 'active' : ''}}" bindtap="onCategoryFilter" data-value="1">桶装水</text>
      <text class="chip {{category === 2 ? 'active' : ''}}" bindtap="onCategoryFilter" data-value="2">瓶装水</text>
      <text class="chip {{category === 3 ? 'active' : ''}}" bindtap="onCategoryFilter" data-value="3">饮水器</text>
    </view>
    <!-- 快捷筛选：一眼找到"该处理的"（未上架 / 低库存 / 已开水票 / 我改过价的） -->
    <scroll-view class="quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chips quick-filters">
        <text class="chip quick {{quick === 'offShelf' ? 'active' : ''}}" bindtap="onQuickFilter" data-value="offShelf">未上架</text>
        <text class="chip quick {{quick === 'lowStock' ? 'active' : ''}}" bindtap="onQuickFilter" data-value="lowStock">库存少于20</text>
        <text class="chip quick {{quick === 'ticket' ? 'active' : ''}}" bindtap="onQuickFilter" data-value="ticket">已开水票</text>
        <text class="chip quick {{quick === 'priceOverridden' ? 'active' : ''}}" bindtap="onQuickFilter" data-value="priceOverridden">我改过价</text>
      </view>
    </scroll-view>
    <view class="hint-row">
      <text class="hint">共 {{viewList.length}} 个商品</text>
      <view class="hint-actions">
        <text class="link" bindtap="onOpenSubmissions">上报记录</text>
        <text class="link" bindtap="onOpenRecords">库存流水</text>
      </view>
    </view>
  </view>



  <!-- 选品 / 我的商品列表 -->
  <view class="work-read-error" wx:if="{{!loading && loadError}}"><text>{{loadError}}</text><text>商品尚未核实，这不代表没有商品。</text><button bindtap="loadData">重新加载商品</button></view>
  <view class="list" wx:if="{{!loading && !loadError}}">
    <view class="card" wx:for="{{viewList}}" wx:key="id" data-item="{{item}}" data-id="{{item.id}}" bindtap="onOpenSetting">
      <view class="thumb" wx:if="{{item.imageUrl && !brokenImages[item.imageUrl]}}">
        <image src="{{item.imageUrl}}" binderror="onDisplayImageError" data-src="{{item.imageUrl}}" mode="aspectFit" style="width:100%;height:100%;" />
      </view>
      <view class="thumb placeholder" wx:else><text>暂无图片</text></view>

      <view class="info">
        <view class="name-row">
          <text class="name">{{item.displayName}}</text>
          <text class="tag platform" wx:if="{{!item.ownerStationId}}">平台</text>
          <text class="tag mine" wx:if="{{item.ownerStationId}}">自定义</text>
          <text class="tag submit" wx:if="{{item.submission}}">上报·{{item.submission.statusText}}</text>
        </view>
        <text class="sub" wx:if="{{item.brand || item.spec}}">{{item.brand}} {{item.spec}}</text>
        <text class="water-template-hint" wx:if="{{item.imageUrl === templateImage}}">{{imageNotice}}</text>
        <text class="sub muted">{{item.categoryLabel}} · 参考价 ¥{{item.refPriceText}}<text wx:if="{{item.deposit > 0 && item.category === 1}}"> · 参考押金 ¥{{item.refDepositText}}</text></text>

        <view class="tags">
          <text class="tag stock" wx:if="{{item.selected}}">库存 {{item.stockText}}</text>
          <text class="tag on" wx:if="{{item.selected && item.enabled === 1}}">已上架</text>
          <text class="tag off" wx:if="{{item.selected && item.enabled !== 1}}">未上架</text>
          <text class="tag price" wx:if="{{item.selected}}">本站价 ¥{{item.effectivePriceText}}</text>
          <text class="tag ticket" wx:if="{{item.selected && item.ticketEnabled === 1}}">水票 ¥{{item.ticketPrice}}</text>
          <text class="tag star" wx:if="{{item.selected && item.priorityDisplay === 1}}">优先展示</text>
        </view>
        <view class="action">
          <button class="product-card-primary" wx:if="{{!item.selected}}" catchtap="onSelectProduct" data-id="{{item.id}}">选用商品</button>
          <button class="product-card-primary" wx:else catchtap="onOpenSetting" data-item="{{item}}">编辑商品</button>
          <button class="product-card-more" wx:if="{{item.ownerStationId}}" catchtap="onProductMore" data-item="{{item}}">更多</button>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{viewList.length === 0}}">
      <text wx:if="{{tab === 'mine'}}">还没有自定义商品，点下面的「＋ 自定义商品」添加</text>
      <text wx:else>没有匹配的商品</text>
    </view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 模板属于新建入口，主动展开，不在正常目录里重复铺商品。 -->
  <view class="water-templates" wx:if="{{showWaterTemplates && !loading && !loadError}}">
    <view class="water-template-heading"><text class="water-template-title">从模板新建</text><button class="water-template-close" bindtap="onToggleWaterTemplates">收起</button></view>
    <text class="water-template-hint">选好模板后，按实物填写规格、金额和库存，默认不上架。</text>
    <view class="water-template-row" wx:for="{{waterTemplates}}" wx:key="id">
      <image class="water-template-image" wx:if="{{!brokenImages[item.imageUrl]}}" src="{{item.imageUrl}}" mode="aspectFit" binderror="onDisplayImageError" data-src="{{item.imageUrl}}" /><view wx:else class="water-template-image ui-image-fallback">商品示意图暂无法显示</view>
      <view class="water-template-info">
        <text class="water-template-name">{{item.name}}</text>
        <text class="water-template-spec">{{item.spec || '容量待按实物填写'}} / {{item.unit}}</text>
        <text class="water-template-hint">{{item.imageNotice}}</text>
      </view>
      <view class="water-template-actions">
        <button class="water-template-use" bindtap="onUseWaterTemplate" data-id="{{item.id}}" disabled="{{saving || uploading}}">使用模板</button>
        <text class="water-template-edit" bindtap="onEditWaterTemplate" data-id="{{item.id}}">按实物修改</text>
      </view>
    </view>
  </view>

  <view class="product-editor-resume" wx:if="{{productEditorResume && !showEdit}}">
    <text>上次编辑尚未保存，仅在本页暂存。</text>
    <button bindtap="onResumeProductEditor" disabled="{{saving || inboundBusy}}">继续未保存编辑</button>
  </view>

  <view class="footer" wx:if="{{!showEdit && !showSetting && !showRecords && !showSubmissions && !showPresetPicker}}">
    <button class="btn-template" bindtap="onToggleWaterTemplates" disabled="{{loading || !!loadError}}">{{showWaterTemplates ? '收起模板' : '从模板新建'}}</button>
    <button class="btn-define" bindtap="openAdd">＋ 自定义商品</button>
  </view>

  <!-- ============ 本站设置 ============ -->
  <view class="modal-mask" wx:if="{{showSetting}}" catchtouchmove="preventMove" bindtap="closeSetting"></view>
  <view class="modal product-edit-modal product-setting-modal" wx:if="{{showSetting}}" style="{{productEditSheetStyle}}" catchtap="stopPropagation">
      <view class="product-edit-header">
        <view class="product-edit-heading">
          <view class="modal-header">编辑商品</view>
          <button class="product-setting-close" bindtap="closeSetting" disabled="{{saving || inboundBusy}}" aria-label="关闭编辑">关闭 ×</button>
        </view>
        <text class="modal-sub">{{setting.name}} · {{setting.brand}} {{setting.spec}}</text>
      </view>
      <scroll-view class="product-edit-body" scroll-y enhanced show-scrollbar>
        <view class="product-edit-content">
          <view class="ui-state" wx:if="{{inboundRecovery}}">
            <text class="ui-state-title">原入库 {{inboundRecovery.quantity}} 件</text>
            <text class="ui-state-copy">原编号和数量已保留。继续原入库会核实或执行这笔记录，不使用新输入数量，不重复增加已完成的原入库。</text>
            <button bindtap="onContinueOriginalInbound" loading="{{inboundBusy}}" disabled="{{saving || inboundBusy}}">继续原入库</button>
          </view>
          <view class="ui-state" wx:if="{{inboundError || productSaveError}}"><text class="ui-state-copy">{{inboundError || productSaveError}}</text></view>

          <text class="product-source-note">平台商品的名称、图片和规格由平台维护；这里只修改本站信息。</text>
      <view class="product-form-section stock-editor">
        <view class="product-section-heading"><text class="product-section-title">库存</text><text class="product-section-caption">当前 {{setting.quantity == null ? '未加载' : setting.quantity}} 件</text></view>
        <view class="seg">
          <text class="seg-item {{stockMode === 'in' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="in">进货入库</text>
          <text class="seg-item {{stockMode === 'check' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="check">核对库存</text>
          <text class="seg-item {{stockMode === 'loss' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="loss">实物短缺</text>
        </view>
        <text class="product-field-help">{{stockMode === 'in' ? '填写本次到货数量，库存会增加。' : stockMode === 'check' ? '填写实际总数，不是增减数量。' : '填写实际剩余总数，提交前需说明短缺原因。'}}</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="number" placeholder="{{stockMode === 'in' ? '本次到货数量' : '实际剩余总数'}}" value="{{stockInput}}" bindinput="onStockInput" disabled="{{saving || inboundBusy || setting.quantity == null}}" />
        <view class="stock-preview" wx:if="{{stockAfterText}}"><text>{{stockAfterText}}</text></view>
        <view class="product-stock-actions">
          <button class="stock-submit" bindtap="onSubmitStock" loading="{{inboundBusy}}" disabled="{{saving || inboundBusy || setting.quantity == null}}">{{stockMode === 'in' ? (inboundRecovery ? '继续原入库' : '确认入库') : stockMode === 'loss' ? '登记短缺' : '确认实际数量'}}</button>
          <button class="stock-records" bindtap="onFilterRecordsByCurrent">查看本商品流水</button>
        </view>
        <text class="product-field-help">库存操作单独提交，不随底部保存。</text>
      </view>

      <!-- 价格提醒：行内非阻断（原来一律弹阻断式 modal，把"保存成功"也变成要确认） -->
      <view class="warn-inline" wx:if="{{warningsInline.length}}">
        <text class="warn-title">价格提醒（不影响保存）</text>
        <text class="warn-item" wx:for="{{warningsInline}}" wx:key="*this">· {{item}}</text>
      </view>

      <view class="product-section-heading product-section-spaced"><text class="product-section-title">价格与展示</text></view>
      <view class="form-row">
        <view class="form-item">
          <text class="label">本站售价(元)</text>
          <text class="product-field-help">参考价 ¥{{setting.refPriceText}}</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="留空不改；0 恢复参考价" value="{{setting.salePrice}}" data-field="salePrice" bindinput="onSettingFieldInput" bindblur="onPriceBlur"  disabled="{{saving || inboundBusy}}" />
        </view>
        <!-- 押金只对桶装水开放（2026-09-19）：瓶装水/一次性桶/饮水器都没有"回收退押"这件事，
             填了也收不进来（后端按"只有桶装水能设押金"直接拒绝），所以这里不显示输入框。 -->
        <view class="form-item" wx:if="{{setting.category === 1}}">
          <text class="label">本站押金(元)</text>
          <text class="product-field-help">参考押金 ¥{{setting.refDepositText}}</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="留空不改；0 恢复参考押金" value="{{setting.depositPrice}}" data-field="depositPrice" bindinput="onSettingFieldInput" bindblur="onPriceBlur"  disabled="{{saving || inboundBusy}}" />
        </view>
      </view>

      <view class="switch-row">
        <view class="switch-item">
          <text class="switch-label">上架商城</text>
          <switch checked="{{setting.enabled}}" bindchange="onSettingShelfChange"  disabled="{{saving || inboundBusy}}" />
        </view>
        <view class="switch-item">
          <text class="switch-label">优先展示</text>
          <switch checked="{{setting.priorityDisplay}}" bindchange="onSettingPriorityChange"  disabled="{{saving || inboundBusy}}" />
        </view>
      </view>

      <view class="switch-row">
        <view class="switch-item">
          <text class="switch-label">推出水票</text>
          <switch checked="{{setting.ticketEnabled}}" bindchange="onSettingTicketChange"  disabled="{{saving || inboundBusy}}" />
        </view>
      </view>
      <view class="form-item" wx:if="{{setting.ticketEnabled}}">
        <text class="label">水票散买单张价(元/张)</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="如：20" value="{{setting.ticketPrice}}" data-field="ticketPrice" bindinput="onSettingFieldInput"  disabled="{{saving || inboundBusy}}" />
      </view>

      <!--
        水票档位（商品上架时的「基本」定义）：基本档位就在这里配完，
        更丰富的设置（档位标题 / 排序 / 单独上下架）进「水票档位」独立模块。
        ⚠️ 没挂档位 = 客户只能按上面的单张价散买 —— 所以这里必须有明确提示，
           不能让人以为打开开关就自动有档位（"水票还在按张卖"就是这么来的）。
      -->
      <view class="pkg-block" wx:if="{{setting.ticketEnabled}}">
        <view class="pkg-head">
          <view class="pkg-title-row">
            <text class="pkg-title">水票档位</text>
            <!-- [2026-09-24] 这段说明原来在本文件里**原样出现了两次**（另一处在独立档位模块），
                 每次都平铺一整行。现在统一收进「?」；两处文字必须保持逐字一致 ——
                 改一处要一起改，否则同一条规则两个说法。 -->
            <help-tip title="水票档位" text="填「张数 + 总价」，例如 10 张 190 元；清空总价 = 删除该档位（保存后生效）。没挂档位时客户只能按单张价买。" />
          </view>
          <text class="link" catchtap="onOpenTicketPackages">更多档位设置 ›</text>
        </view>

        <view class="pkg-row {{item.deleted ? 'pkg-row-deleted' : ''}}" wx:for="{{pkgRows}}" wx:key="key">
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="pkg-input qty" type="number" value="{{item.qty}}" data-index="{{index}}" bindinput="onPkgQtyInput" disabled="{{saving || inboundBusy || (showEdit && productCreationPending) || pkgLoading || pkgError || !pkgReady}}" placeholder="张数" />
          <text class="pkg-unit">张</text>
          <text class="pkg-arrow"></text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="pkg-input price" type="digit" value="{{item.price}}" data-index="{{index}}" bindinput="onPkgPriceInput" disabled="{{saving || inboundBusy || (showEdit && productCreationPending) || pkgLoading || pkgError || !pkgReady}}" placeholder="总价" />
          <text class="pkg-unit">元</text>
          <text class="pkg-del" data-index="{{index}}" catchtap="onRemovePkgRow">{{item.deleted ? '撤销' : '删除'}}</text>
        </view>

        <text class="pkg-empty" wx:if="{{pkgLoading}}">正在读取水票档位…</text>
        <view class="ui-state" wx:elif="{{pkgError}}"><text class="ui-state-copy">{{pkgError}}</text><button size="mini" bindtap="onRetryPkgRows">重新读取档位</button></view>
        <text class="pkg-empty" wx:elif="{{pkgReady && !pkgRows.length}}">尚无水票档位</text>
        <text class="link" wx:if="{{pkgReady && !pkgLoading && !pkgError}}" catchtap="onAddPkgRow">＋ 加一档</text>
      </view>

          <view class="product-setting-secondary" wx:if="{{!setting.ownerStationId}}">
            <button class="btn-danger" bindtap="onRemoveProduct">移除本站配置</button>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer product-edit-footer">
        <button class="btn-cancel" bindtap="closeSetting" disabled="{{saving || inboundBusy}}">取消</button>
        <button class="btn-save" bindtap="onSaveSetting" loading="{{saving}}" disabled="{{saving || inboundBusy || (setting.ticketEnabled && (pkgLoading || pkgError))}}">保存修改</button>
      </view>
  </view>

  <!-- ============ 自己定义商品 ============ -->
  <!-- Native container owns Back; no synthetic page-stack entry or global navigation interception. -->
  <page-container show="{{showEdit}}" position="bottom" overlay="{{true}}" close-on-slide-down="{{false}}" duration="{{0}}" custom-style="height:100%;background:transparent;" bindbeforeleave="onProductEditorBeforeLeave" bindclickoverlay="closeEdit">
  <view class="product-editor-stage" wx:if="{{showEdit}}">
  <view class="modal-mask product-editor-dismiss-area" catchtouchmove="preventMove" bindtap="closeEdit"></view>
  <view class="modal product-edit-modal" wx:if="{{showEdit}}" style="{{productEditSheetStyle}}" catchtap="stopPropagation">
      <view class="product-edit-header">
        <view class="product-edit-heading">
          <view class="modal-header">{{isAdd ? '自己定义商品' : '编辑商品'}}</view>
          <button class="product-edit-close" bindtap="closeEdit" disabled="{{saving || inboundBusy}}" aria-label="关闭编辑">关闭 ×</button>
        </view>
        <text class="modal-sub">商品仅供本站使用，可在保存后另行上报。</text>
      </view>
      <scroll-view class="product-edit-body" scroll-y enhanced show-scrollbar>
        <view class="product-edit-content">
          <view class="ui-state" wx:if="{{productCreationPending}}">
            <text class="ui-state-copy">{{productCreationRecovery.message}}</text>
            <button wx:if="{{productCreationRecovery.phase === 'packages-pending'}}" bindtap="onContinueCreatedProduct" disabled="{{saving || inboundBusy}}">继续原商品档位</button>
            <button wx:else bindtap="onVerifyProductCreation" disabled="{{saving || inboundBusy}}">重新读取商品目录</button>
          </view>
          <view class="ui-state" wx:if="{{productSaveError}}"><text class="ui-state-copy">{{productSaveError}}</text></view>
          <view class="template-edit-note" wx:if="{{editTemplateId}}">
            <text>已带入名称与图片，规格以实物标签为准；金额和库存由本站填写，默认不上架。</text>
            <button class="edit-help-toggle" bindtap="onToggleEditHelp">{{editHelpExpanded ? '收起说明' : '查看建档说明'}}</button>
            <text class="edit-help-detail" wx:if="{{editHelpExpanded}}">模板用于快速填写商品资料，不代表当前实物规格或官方定价。请核对商品包装、净容量和本站售价；需要时可换成实际商品图。</text>
          </view>

          <view class="product-section-heading"><text class="product-section-title">商品资料</text></view>
          <view class="product-image-section">
            <view class="modal-img product-edit-image">
              <image class="preview" wx:if="{{(productImagePreviewUrl || editForm.imageUrl) && !brokenImages[productImagePreviewUrl || editForm.imageUrl]}}" src="{{productImagePreviewUrl || editForm.imageUrl}}" binderror="onDisplayImageError" data-src="{{productImagePreviewUrl || editForm.imageUrl}}" mode="aspectFit" />
              <view class="preview placeholder" wx:else>
                <text wx:if="{{productImageBusy || productImageState === 'selecting' || productImageState === 'uploading'}}">正在处理图片</text>
                <text wx:elif="{{productImagePreviewUrl || editForm.imageUrl}}">图片暂无法显示</text>
                <text wx:else>暂无商品图片</text>
              </view>
            </view>
            <text class="product-image-caption" wx:if="{{productImagePreviewUrl}}">{{productImageBusy ? '所选图片预览，正在上传' : productImageState === 'failed' ? '仅本地预览，尚未上传成功' : '所选图片预览'}}</text>
            <text class="product-image-caption" wx:elif="{{editForm.imageUrl}}">当前商品图片</text>
            <text class="product-image-status {{productImageState === 'failed' ? 'is-warning' : ''}}" wx:if="{{productImageHint}}">{{productImageHint}}</text>
            <view class="product-image-actions">
              <block wx:if="{{!productImageBusy}}">
                <button class="product-image-action" wx:if="{{productImageState === 'failed' && productImagePreviewUrl}}" bindtap="onRetryProductImage" disabled="{{saving}}">重试上传</button>
                <button class="product-image-action {{productImageState === 'failed' ? 'secondary' : ''}}" bindtap="uploadImage" disabled="{{saving}}">{{productImageState === 'failed' ? '重新选择图片' : editForm.imageUrl ? '更换商品图片' : '上传商品图片'}}</button>
                <button class="product-image-action secondary" bindtap="openPresetPicker" disabled="{{saving}}">从图库选择</button>
              </block>
            </view>
            <button class="product-image-help" wx:if="{{productImageState === 'failed'}}" bindtap="onCopyProductImageProblem">复制问题信息</button>
            <text class="water-template-hint" wx:if="{{editForm.imageUrl === templateImage}}">{{imageNotice}}</text>
          </view>

      <view class="form-item">
        <text class="label">商品名称</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" placeholder="如：农夫山泉18.9L" value="{{editForm.name}}" data-field="name" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
      </view>

      <view class="form-row">
        <view class="form-item half">
          <text class="label">品牌</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" placeholder="如：农夫山泉" value="{{editForm.brand}}" data-field="brand" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
        <view class="form-item half">
          <text class="label">规格</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" placeholder="请按实物标签填写净容量" value="{{editForm.spec}}" data-field="spec" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
      </view>

      <view class="form-row">
        <view class="form-item half">
          <text class="label">类型</text>
          <picker bindchange="onEditCategoryChange" value="{{editCategoryIndex}}" range="{{categoryNames}}" disabled="{{saving || inboundBusy || productCreationPending}}">
            <view class="picker-text">{{categoryNames[editCategoryIndex] || '请选择'}}</view>
          </picker>
        </view>

      </view>

      <view class="form-item">
        <text class="label">商品说明（可修改）</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" placeholder="选填，按实际商品填写" value="{{editForm.description}}" data-field="description" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
      </view>

      <view class="product-section-heading product-section-spaced"><text class="product-section-title">价格与展示</text></view>
      <view class="form-row">
        <view class="form-item half">
          <text class="label">本站售价(元)</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="0.00" value="{{editForm.price}}" data-field="price" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
        <view class="form-item half" wx:if="{{editForm.category === 1}}">
          <text class="label">押金(元)</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="0" value="{{editForm.deposit}}" data-field="deposit" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>

      </view>

        <view class="form-item" wx:if="{{isAdd}}">
          <text class="label">初始库存(件)</text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="number" placeholder="0" value="{{editForm.quantity}}" data-field="quantity" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>

      <view class="switch-row product-display-switches">
        <view class="switch-item">
          <text class="switch-label">上架商城</text>
          <switch checked="{{editForm.enabled}}" bindchange="onEditSwitchChange" data-field="enabled"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
        <view class="switch-item">
          <text class="switch-label">优先展示</text>
          <switch checked="{{editForm.priorityDisplay}}" bindchange="onEditSwitchChange" data-field="priorityDisplay" disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
        <view class="switch-item" wx:if="{{editForm.category !== 3}}">
          <text class="switch-label">推出水票</text>
          <switch checked="{{editForm.ticketEnabled}}" bindchange="onEditSwitchChange" data-field="ticketEnabled"  disabled="{{saving || inboundBusy || productCreationPending}}" />
        </view>
      </view>
      <view class="form-item" wx:if="{{editForm.category !== 3 && editForm.ticketEnabled}}">
        <text class="label">水票散买单张价(元/张)</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="digit" placeholder="如：20" value="{{editForm.ticketPrice}}" data-field="ticketPrice" bindinput="onEditFieldInput"  disabled="{{saving || inboundBusy || productCreationPending}}" />
      </view>

      <!-- 档位：与「本站设置」共用同一份行数据（新建商品时用 create 返回的 id 挂上去） -->
      <view class="pkg-block" wx:if="{{editForm.category !== 3 && editForm.ticketEnabled}}">
        <view class="pkg-head">
          <view class="pkg-title-row">
            <text class="pkg-title">水票档位</text>
            <!-- [2026-09-24] 这段说明原来在本文件里**原样出现了两次**（另一处在独立档位模块），
                 每次都平铺一整行。现在统一收进「?」；两处文字必须保持逐字一致 ——
                 改一处要一起改，否则同一条规则两个说法。 -->
            <help-tip title="水票档位" text="填「张数 + 总价」，例如 10 张 190 元；清空总价 = 删除该档位（保存后生效）。没挂档位时客户只能按单张价买。" />
          </view>
          <text class="link" catchtap="onOpenTicketPackages">更多档位设置 ›</text>
        </view>
        <view class="pkg-row {{item.deleted ? 'pkg-row-deleted' : ''}}" wx:for="{{pkgRows}}" wx:key="key">
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="pkg-input qty" type="number" value="{{item.qty}}" data-index="{{index}}" bindinput="onPkgQtyInput" disabled="{{saving || inboundBusy || (showEdit && productCreationPending) || pkgLoading || pkgError || !pkgReady}}" placeholder="张数" />
          <text class="pkg-unit">张</text>
          <text class="pkg-arrow"></text>
          <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="pkg-input price" type="digit" value="{{item.price}}" data-index="{{index}}" bindinput="onPkgPriceInput" disabled="{{saving || inboundBusy || (showEdit && productCreationPending) || pkgLoading || pkgError || !pkgReady}}" placeholder="总价" />
          <text class="pkg-unit">元</text>
          <text class="pkg-del" data-index="{{index}}" catchtap="onRemovePkgRow">{{item.deleted ? '撤销' : '删除'}}</text>
        </view>
        <text class="pkg-empty" wx:if="{{pkgLoading}}">正在读取水票档位…</text>
        <view class="ui-state" wx:elif="{{pkgError}}"><text class="ui-state-copy">{{pkgError}}</text><button size="mini" bindtap="onRetryPkgRows">重新读取档位</button></view>
        <text class="pkg-empty" wx:elif="{{pkgReady && !pkgRows.length}}">尚无水票档位</text>
        <text class="link" wx:if="{{pkgReady && !pkgLoading && !pkgError}}" catchtap="onAddPkgRow">＋ 加一档</text>
      </view>

          <block wx:if="{{!isAdd}}">
            <view class="ui-state" wx:if="{{inboundRecovery}}"><text class="ui-state-copy">原入库 {{inboundRecovery.quantity}} 件尚待完成，请继续原入库，勿另记一笔。</text></view>
            <view class="ui-state" wx:if="{{inboundError}}"><text class="ui-state-copy">{{inboundError}}</text></view>
      <view class="product-form-section stock-editor">
        <view class="product-section-heading"><text class="product-section-title">库存</text><text class="product-section-caption">当前 {{setting.quantity == null ? '未加载' : setting.quantity}} 件</text></view>
        <view class="seg">
          <text class="seg-item {{stockMode === 'in' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="in">进货入库</text>
          <text class="seg-item {{stockMode === 'check' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="check">核对库存</text>
          <text class="seg-item {{stockMode === 'loss' ? 'active' : ''}}" bindtap="onStockModeChange" data-mode="loss">实物短缺</text>
        </view>
        <text class="product-field-help">{{stockMode === 'in' ? '填写本次到货数量，库存会增加。' : stockMode === 'check' ? '填写实际总数，不是增减数量。' : '填写实际剩余总数，提交前需说明短缺原因。'}}</text>
        <input adjust-position="{{false}}" bindkeyboardheightchange="onProductKeyboardHeightChange" class="input" type="number" placeholder="{{stockMode === 'in' ? '本次到货数量' : '实际剩余总数'}}" value="{{stockInput}}" bindinput="onStockInput" disabled="{{saving || inboundBusy || setting.quantity == null}}" />
        <view class="stock-preview" wx:if="{{stockAfterText}}"><text>{{stockAfterText}}</text></view>
        <view class="product-stock-actions">
          <button class="stock-submit" bindtap="onSubmitStock" loading="{{inboundBusy}}" disabled="{{saving || inboundBusy || setting.quantity == null}}">{{stockMode === 'in' ? (inboundRecovery ? '继续原入库' : '确认入库') : stockMode === 'loss' ? '登记短缺' : '确认实际数量'}}</button>
          <button class="stock-records" bindtap="onFilterRecordsByCurrent">查看本商品流水</button>
        </view>
        <text class="product-field-help">库存操作单独提交，不随底部保存。</text>
      </view>

          </block>
        </view>
      </scroll-view>
      <view class="modal-footer product-edit-footer">
        <button class="btn-cancel" bindtap="closeEdit" disabled="{{saving}}">取消</button>
        <button class="btn-save" bindtap="onSaveEdit" loading="{{saving}}" disabled="{{saving || inboundBusy || productCreationPending || productImageBusy || (editForm.ticketEnabled && (pkgLoading || pkgError))}}">{{saving ? '保存中…' : productCreationPending ? '先完成原建档' : isAdd ? '创建商品' : '保存修改'}}</button>
      </view>
  </view>
  </view>
  <!-- ============ 平台统一图库（选图） ============ -->
  <!-- 图在**小程序包内**：后端下发路径，前端直接当 src 用，不依赖 COS、不会过期 -->
  <view class="modal-mask product-preset-mask" wx:if="{{showPresetPicker}}" catchtouchmove="preventMove" bindtap="closePresetPicker">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-header">选择平台图</view>
      <view class="modal-sub">通用桶装水示意图，不代表具体品牌包装；选中后可更换为实际商品图</view>

      <view class="preset-loading" wx:if="{{presetLoading}}"><text>加载中...</text></view>
      <view class="ui-state" wx:elif="{{presetError}}"><text class="ui-state-copy">{{presetError}}</text><button size="mini" bindtap="openPresetPicker">重新读取图库</button></view>
      <view class="preset-empty" wx:elif="{{presetReady && presetImages.length === 0}}"><text>暂无可选图片</text></view>

      <view class="preset-grid" wx:else>
        <view
          class="preset-item {{editForm.imageUrl === item.path ? 'active' : ''}}"
          wx:for="{{presetImages}}"
          wx:key="key"
          data-path="{{item.path}}"
          data-object-name="{{item.objectName}}"
          bindtap="onPickPresetImage"
        >
          <image class="preset-thumb" wx:if="{{!brokenImages[item.path]}}" src="{{item.path}}" mode="aspectFit" lazy-load binderror="onDisplayImageError" data-src="{{item.path}}" /><view class="preset-thumb ui-image-fallback" wx:else>图片暂无法显示</view>
          <text class="preset-check" wx:if="{{editForm.imageUrl === item.path}}">已选</text>
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-save" bindtap="closePresetPicker">关闭</button>
      </view>
    </view>
  </view>
  </page-container>

  <!-- ============ 库存流水 ============ -->
  <view class="modal-mask" wx:if="{{showRecords}}" catchtouchmove="preventMove" bindtap="closeRecords">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-header">库存流水</view>
      <view class="modal-sub">入库、库存核对、实物短缺和配送出库均有记录；下单预留及取消释放不改变实物</view>

      <view class="filter-row">
        <text class="filter-chip" wx:if="{{recordsFilterName}}">
          {{recordsFilterName}}
          <text class="filter-clear" catchtap="onClearRecordsFilter">×</text>
        </text>
        <text class="filter-hint" wx:else>本站全部商品（编辑商品时可只看单品）</text>
      </view>

      <view class="ui-state" wx:if="{{recordsError}}"><text class="ui-state-copy">{{recordsError}}</text><button size="mini" bindtap="loadRecords">重新读取流水</button></view>
      <view class="records" wx:elif="{{recordsReady && !recordsLoading}}">
        <view class="record" wx:for="{{records}}" wx:key="id">
          <view class="record-main">
            <text class="record-product">{{item.productText}}</text>
            <text class="record-meta">{{item.timeText}} · {{item.refText}}</text>
          </view>
          <text class="record-type">{{item.typeText}}</text>
          <text class="record-delta {{item.delta > 0 ? 'plus' : 'minus'}}">{{item.deltaText}}</text>
        </view>
        <view class="empty" wx:if="{{records.length === 0}}"><text>暂无流水</text></view>
        <view class="load-more" wx:if="{{records.length >= recordsLimit}}" bindtap="onLoadMoreRecords">
          <text>加载更多（当前 {{records.length}} 条）</text>
        </view>
      </view>
      <view class="loading" wx:elif="{{recordsLoading}}">正在读取库存流水…</view>

      <view class="modal-footer">
        <button class="btn-save" bindtap="closeRecords">关闭</button>
      </view>
    </view>
  </view>

  <!-- ============ 上报记录（自定义商品上报通用库的处理进度）============ -->
  <view class="modal-mask" wx:if="{{showSubmissions}}" catchtouchmove="preventMove" bindtap="closeSubmissions">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-header">上报记录</view>
      <view class="modal-sub">上报后由开发者人工处置：已纳入通用库的商品，别站也能选到</view>
      <view class="loading" wx:if="{{submissionsLoading}}">正在读取上报记录…</view>
      <view class="ui-state" wx:elif="{{submissionsError}}"><text class="ui-state-copy">{{submissionsError}}</text><button size="mini" bindtap="onOpenSubmissions">重新读取上报记录</button></view>
      <view class="records" wx:elif="{{submissionsReady && submissions.length}}">
        <view class="record" wx:for="{{submissions}}" wx:key="id">
          <view class="record-main">
            <text class="record-product">{{item.productName}}</text>
            <text class="record-meta">{{item.timeText}}<text wx:if="{{item.note}}"> · {{item.note}}</text></text>
          </view>
          <text class="tag {{item.status === 1 ? 'on' : (item.status === 2 ? 'star' : 'off')}}">{{item.statusText}}</text>
        </view>
      </view>
      <view class="empty" wx:elif="{{submissionsReady}}"><text>还没有上报记录（商品卡「更多」中可上报）</text></view>
      <view class="modal-footer">
        <button class="btn-save" bindtap="closeSubmissions">关闭</button>
      </view>
    </view>
  </view>

</view>
