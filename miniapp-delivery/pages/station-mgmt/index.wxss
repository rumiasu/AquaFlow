.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx 24rpx 48rpx; }

/*
  分区（对齐运营商 App「查询服务」那种版面）：
  **区标题带蓝色左竖条，竖条之下就是这个分区的全部条目**。
  分区之间靠 `margin` 拉开距离，不再用横线 —— 横线会把"分区"读成"两段式划分"。
*/
.group { margin-bottom: 12rpx; }
.group-head { display: flex; align-items: center; padding: 28rpx 4rpx 20rpx; }
.group-bar {
  width: 6rpx; height: 30rpx; border-radius: 3rpx;
  background: var(--primary, #4F8EF7); margin-right: 14rpx;
}
.group-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); letter-spacing: 1rpx; }

.grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx 8rpx; }
.module-card {
  background: var(--bg-card); border-radius: 20rpx; padding: 28rpx 12rpx 24rpx;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  box-shadow: var(--shadow-sm);
}
.module-card:active { opacity: 0.75; }
/* 占位格：只为让最后一行的格数补齐，不显示任何东西（三列网格靠它保持对齐） */
.module-card.placeholder { background: transparent; box-shadow: none; pointer-events: none; }
.module-icon { font-size: 52rpx; line-height: 1; margin-bottom: 14rpx; }
.module-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 8rpx; }
.module-desc { font-size: 20rpx; line-height: 1.4; color: var(--text-secondary); }

/*
  G 分区（现场数据）用**居中分隔线 + 标题**的弱化样式：
  它是"看数据"，不是"办事"，不该和上面六个分区同等重量。
*/
.group-divider { display: flex; align-items: center; padding: 36rpx 8rpx 20rpx; }
.divider-line { flex: 1; height: 1rpx; background: var(--border-color); }
.divider-text { font-size: 26rpx; color: var(--text-secondary); padding: 0 24rpx; letter-spacing: 2rpx; }

.coming-soon { opacity: 0.5; }
