<page-meta page-style="{{showPurchase ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="container">
  <asset-station-view id="asset-station-view" station-id="{{viewStationId}}" station-name="{{stationName}}" status-text="{{viewStationStatusText}}" order-station-name="{{orderStationName}}" busy="{{submitting || recoveringPurchase}}" bind:change="onAssetStationChange" />
  <loading wx:if="{{loading}}"></loading>

  <view class="ticket-content" wx:else>
    <!--
      数据没加载出来的提示（空串时不渲染）。[2026-09-20 真机联调] 原来任一请求失败都被静默吞掉，
      页面照旧显示「0 张 / 暂无水票 / 暂无记录」。样式复用 styles/common.wxss 的 .load-error。
    -->
    <view class="load-error" wx:if="{{loadError}}">{{loadError}}<view bindtap="onRetryAssets">重新加载 ›</view></view>
    <button class="af-action af-action--secondary" wx:if="{{needLogin}}" bindtap="onLogin">去登录</button>
    <view class="load-error" wx:if="{{purchaseNotice}}">{{purchaseNotice}}</view>
    <!-- [2026-10-07 #15] 原购买恢复提示：原来是 .load-error 错误条里塞裸 <button>（默认样式，
         与本页设计系统违和，且恢复类关键操作与错误提示无层级）。
         改成结构化恢复卡：标题说"是什么"，正文原样透传 purchaseStorageError / purchaseRecoveryText，
         按钮按查询工具、恢复入口及结束操作分层。
         ⚠️ 按钮仍是原生 <button>：disabled 语义由它承载（如"结束原购买"在 purchaseStorageError
         非空时被禁），改成 view 会丢这道闸门；绑定与条件一行未动。 -->
    <view class="recovery-card" wx:if="{{purchaseStorageError}}">
      <view class="recovery-title">原购买记录待核实</view>
      <view class="recovery-text">{{purchaseStorageError}}</view>
      <view class="recovery-actions">
        <button class="af-action af-action--quiet" bindtap="onQueryPurchaseResult" disabled="{{submitting || recoveringPurchase}}"><text class="af-action__face">重新读取原购买</text></button>
      </view>
    </view>
    <!-- 原购买恢复入口不依赖商品在售；未知结果不能另起编号再买。 -->
    <view class="recovery-card" wx:if="{{pendingPurchase}}">
      <view class="recovery-title">有一笔水票购买待核实</view>
      <view class="recovery-text">{{purchaseRecoveryText}}</view>
      <view class="recovery-actions">
        <button class="af-action af-action--quiet" bindtap="onQueryPurchaseResult" disabled="{{submitting || recoveringPurchase}}"><text class="af-action__face">查询原购买结果</text></button>
        <button class="af-action af-action--secondary" wx:if="{{!pendingPurchase.result}}" bindtap="onRetryOriginalPurchase" disabled="{{submitting || recoveringPurchase}}">重试原购买</button>
        <button class="af-action af-action--danger-quiet" wx:if="{{!pendingPurchase.result}}" bindtap="onCloseOriginalPurchase" disabled="{{submitting || recoveringPurchase || purchaseStorageError}}">核实后结束原购买</button>
        <button class="af-action af-action--secondary" wx:if="{{pendingPurchase.result && !purchaseStorageError}}" bindtap="onStartNextPurchase" disabled="{{submitting || recoveringPurchase}}">另买一笔水票</button>
      </view>
    </view>

    <view class="ui-draft-notice" wx:if="{{uiDraftAvailable || uiDraftError}}"><text>{{uiDraftError || '有一份未提交的选购填写'}}</text><button class="af-action af-action--quiet" wx:if="{{uiDraftAvailable}}" bindtap="onRestoreUiDraft" disabled="{{submitting || recoveringPurchase || pendingPurchase || purchaseStorageError}}"><text class="af-action__face">恢复暂存选购</text></button><button class="af-action af-action--quiet" wx:else bindtap="readUiDraft"><text class="af-action__face">重试读取暂存</text></button></view>
    <!-- 当前水站：水票按「客户 × 水站」隔离（A 站买的票不能抵 B 站的单，也不在 B 站显示）。
         不写清楚，客户换个站就会以为"我的票少了" —— 站长接到这种电话也解释不了。
         文案与样式照抄 pages/deposit/records（那里已有同一条提示条，保持一致）。 -->

    <!-- 可用水票卡片 -->
    <view class="ticket-balance-card">
      <icon name="ticket" size="28px" color="#244F82" variant="duotone" />
      <view class="balance-left">
        <text class="balance-label">可用水票{{refreshing ? (totalTickets == null ? ' · 更新中' : ' · 更新中（上次读取）') : ''}}</text>
        <view class="balance-amount">
          <!-- [2026-09-20] 余额没拉到就显示「—」：显示 0 张会让客户以为票没了（钱的事，宁可不显示数） -->
          <text class="balance-count">{{totalTickets == null || (accountsFailed && !accountsStale) ? '—' : totalTickets}}</text>
          <text class="balance-unit">张</text>
        </view>
        <text class="balance-total" wx:if="{{totalValue > 0}}">剩余批次票面额 ¥{{totalValue}}（非退款金额）</text>
      </view>
      <button class="af-action af-action--secondary" bindtap="onShowPurchase" disabled="{{needLogin || pendingPurchase || purchaseStorageError || submitting || recoveringPurchase}}">{{purchaseDraftSaved ? '继续选购' : '购买水票'}}</button>
    </view>
    <text class="stale-note" wx:if="{{accountsStale}}">水票余额与明细为上次读取，当前余额待重新核对。</text>

    <!-- [2026-10-07 #15] 「剩余水票退出说明」原来是置顶裸 <button>（默认样式、比余额卡还显眼）。
         降级为余额卡下的帮助链接：要退的人找得到，不买的人不被打扰。handler onExitHelp 不变。 -->
    <view class="ticket-help" bindtap="onExitHelp">
      <text>剩余水票怎么退？查看说明 ›</text>
    </view>

    <!-- 标签切换 -->
    <view class="tabs">
      <view
        class="tab-item af-choice {{currentTab === item.id ? 'active af-choice--selected' : ''}}"
        wx:for="{{tabs}}"
        wx:key="id"
        bindtap="onTabChange"
        data-id="{{item.id}}"
      >
        <text class="af-choice__face">{{item.name}}</text>
      </view>
    </view>

    <!-- 水票明细 -->
    <view class="tab-content" wx:if="{{currentTab === 0}}">
      <view class="section-title">水票明细{{refreshing ? ' · 更新中' : ''}}</view>
      <view class="ticket-list">
        <view class="ticket-item" wx:for="{{accounts}}" wx:key="id">
          <view class="ticket-info">
            <text class="ticket-name">{{item.productName || item.waterTypeName}}</text>
            <!-- 票账户按商品展示，不推断通用票。 -->
            <text class="ticket-spec" wx:if="{{item.productSpec || item.waterTypeSpec}}">{{item.productSpec || item.waterTypeSpec}}</text>
            <text class="ticket-expire" wx:if="{{item.expireTime}}">有效期至 {{item.expireTime}}</text>
          </view>
          <view class="ticket-quantity">
            <text class="quantity-value">{{item.remainQuantity}}</text>
            <text class="quantity-unit">张</text>
          </view>
        </view>
        <!-- [2026-09-20] 空态必须分两种：拉失败时 accounts 也是空的，一句「暂无水票」会把
             "没查到"说成"你确实没有票"（AGENTS §8.22）。 -->
        <view class="local-empty" wx:if="{{accounts.length === 0 && !accountsFailed}}"><text>暂无水票</text></view>
        <view class="local-empty" wx:elif="{{accountsFailed}}"><text>水票明细没加载出来，请点上方重新加载</text></view>
      </view>
    </view>

    <!-- 消费记录 -->
    <view class="tab-content" wx:if="{{currentTab === 1}}">
      <view class="section-title">消费记录{{refreshing ? ' · 更新中' : ''}}</view>
      <text class="stale-note" wx:if="{{recordsStale}}">以下为上次读取的消费记录，请重新加载核对。</text>
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-info">
            <text class="record-name">{{item.productName || item.waterTypeName}}</text>
            <text class="record-direction">{{item.changeDirection}}</text>
            <text class="record-time">{{item.createTime}}</text>
          </view>
          <view class="record-quantity">
            <text class="quantity-change {{item.changeClass}}">{{item.changeText}} 张</text>
          </view>
        </view>
        <!-- [2026-09-20] 同上：记录拉失败时 records 也是空的，别把"没查到"说成"确实没有记录" -->
        <view class="local-empty" wx:if="{{records.length === 0 && !recordsFailed}}"><text>暂无记录</text></view>
        <view class="local-empty" wx:elif="{{recordsFailed}}"><text>消费记录没加载出来，请点上方重新加载</text></view>
      </view>
    </view>

  </view>

  <!-- 购买水票弹窗 -->
  <view class="modal-mask" wx:if="{{showPurchase}}" bindtap="onClosePurchase"></view>
  <view class="modal-body {{showPurchase ? 'show' : ''}}" wx:if="{{showPurchase}}" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">购买水票</text>
      <text class="modal-close" bindtap="onClosePurchase">×</text>
    </view>

    <scroll-view scroll-y class="modal-scroll">
      <!-- 选择商品。
           ⚠️ 这里**只有真实商品**，没有"统一水票"这种东西 —— 产品口径「统一水票在站长端是特殊化的，
           但在**用户端看起来没区别**…不是专门卖统一水票」。某款水按不按统一折扣卖，
           体现在下面拉到的档位上，不体现在商品名上。 -->
      <text class="modal-label">购票水站：{{stationName || '水站 #' + viewStationId}}</text>
      <text class="modal-label">选择商品</text>
      <text class="modal-label" wx:if="{{productsLoading}}">正在加载可购买商品…</text>
      <text class="load-error" wx:elif="{{productsFailed}}">可购买商品未能加载，请返回页面重新加载；原购买仍可恢复。</text>
      <text class="modal-label" wx:elif="{{!buyProducts.length}}">本站暂无可购买水票的商品。</text>
      <product-selector items="{{buyProductOptions}}" selected-id="{{buyForm.productId}}" disabled="{{submitting || recoveringPurchase || pendingPurchase || purchaseStorageError}}" bind:change="onBuyProductChange" />

      <!-- 档位（价目表）。两种来源在界面上**长得一样**：
             · CUSTOM  = 站长给这款水挂的定制档位；
             · UNIFIED = 站级统一折扣按**这款水自己的价**折算出来的档位。
           总价与均价全部用服务端下发的值，这里不做 price/qty 的算术。 -->
      <block wx:if="{{buyPackages.length}}">
        <text class="modal-label">选择水票套餐</text>
        <view class="pkg-list">
          <view
            class="pkg-item {{buyForm.selectedTierKey === item.selectionKey ? 'active' : ''}}"
            wx:for="{{buyPackages}}"
            wx:key="selectionKey"
            data-id="{{item.packageId || item.id || item.qty}}"
            data-source="{{item.source}}"
            bindtap="onBuyPackageSelect"
          >
            <text class="pkg-title">{{item.title || item.qty + ' 张'}}<text class="pkg-selected" wx:if="{{buyForm.selectedTierKey === item.selectionKey}}"> · 已选</text></text>
            <text class="pkg-price">¥{{item.price}}</text>
            <text class="pkg-sub">每份 {{item.qty}} 张 · ¥{{item.unitPrice}}/张</text>
          </view>
        </view>
      </block>

      <!--
        [2026-09-20] 档位（优惠价目表）没拉到时的说明。原来这里什么都不显示 ——
        客户看到的就是"这款水没有优惠档位"，与"确实没配档位"无法区分（AGENTS §8.22）。
        套餐未核实时提示重新读取；原购买仍按持久凭据恢复。
      -->
      <text class="modal-label" wx:if="{{packagesLoading}}">正在读取购票档位…</text>
      <view class="load-error" wx:if="{{packagesError}}">{{packagesError}}<button class="af-action af-action--quiet" bindtap="onRetryPackages"><text class="af-action__face">重新加载档位</text></button></view>
      <text class="modal-label" wx:if="{{packagesLoaded && !buyPackages.length && !packagesError}}">本商品暂未设置可购套餐，请联系水站。</text>

      <view class="purchase-copies" wx:if="{{buyForm.selectedTierKey}}">
        <view class="copies-heading"><text>购买份数</text><text>每份 {{buyForm.packageQty}} 张 · ¥{{buyForm.packagePrice}}</text></view>
        <integer-stepper value="{{buyForm.copies}}" min="{{1}}" max="{{buyCopiesMax}}" label="购买份数" disabled="{{submitting || recoveringPurchase || pendingPurchase || purchaseStorageError}}" bind:change="onBuyQuantityInput" />
        <view class="purchase-total"><text>共 {{buyForm.quantity == null ? '—' : buyForm.quantity}} 张</text><text>合计 ¥{{buyForm.totalPrice == null ? '—' : buyForm.totalPrice}}</text></view>
        <text class="purchase-copies-error" wx:if="{{purchaseCopiesError}}">{{purchaseCopiesError}}</text>
        <text class="pkg-lock">按整份购买，单次最多 5000 张。付款金额以本次购买结果为准。</text>
      </view>

      <!-- 支付方式 -->
      <text class="modal-label">支付方式</text>
      <view class="method-list">
        <view
          class="method-item {{buyForm.paymentMethod === item.id ? 'active' : ''}}"
          wx:for="{{buyMethods}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onBuyPaymentMethodSelect"
        >
          <view class="method-info">
            <text class="method-name">{{item.name}}</text>
            <text class="method-desc">{{item.desc}}</text>
          </view>
          <view class="method-radio {{buyForm.paymentMethod === item.id ? 'checked' : ''}}"></view>
        </view>
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="af-action af-action--cancel af-action--form" bindtap="onClosePurchase">
        <text>暂存关闭</text>
      </view>
      <button class="af-action af-action--primary af-action--form af-action--grow {{submitting ? 'is-disabled' : ''}}" bindtap="onBuySubmit" disabled="{{submitting || !buyForm.productId || !buyForm.selectedTierKey || buyForm.totalPrice == null}}">
        <text>{{submitting ? '购买中…' : !buyForm.productId ? '请先选择商品' : !buyForm.selectedTierKey ? '请选择水票套餐' : purchaseCopiesError ? '请核对购买份数' : buyForm.totalPrice == null ? '金额待核实' : '确认购买 ¥' + buyForm.totalPrice}}</text>
      </button>
    </view>
  </view>
</view>
<business-dialog id="business-dialog" />
