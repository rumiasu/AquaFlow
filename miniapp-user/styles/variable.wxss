/* ========== AquaFlow 深邃蓝设计系统 ========== */
page {
  /* 主色 */
  --primary-color: #1e40af;
  --primary-light: #3b82f6;
  --primary-dark: #1e3a8a;
  --primary-bg: rgba(30, 64, 175, 0.08);

  --accent-color: #06b6d4;
  --accent-gradient: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #06b6d4 100%);
  --primary-gradient: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);

  /* 功能色 */
  --success-color: #059669;
  --warning-color: #d97706;
  --error-color: #dc2626;
  --info-color: #3b82f6;

  /* 价格色 */
  --price-color: #ea580c;

  /* 中性色 */
  --text-primary: #0f172a;
  --text-regular: #475569;
  --text-secondary: #94a3b8;
  --text-placeholder: #cbd5e1;

  /* 背景色 */
  --bg-color: #f0f4f8;
  --bg-white: #ffffff;
  --bg-gray: #f8fafc;
  --bg-card: #ffffff;

  /* 边框 */
  --border-color: #e2e8f0;
  --border-light: #f1f5f9;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 999rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(15, 23, 42, 0.1);
  --shadow-primary: 0 8rpx 24rpx rgba(30, 64, 175, 0.25);
}
