.page{padding:32rpx}.title{display:block;font-size:36rpx;font-weight:600}.tip{display:block;color:#666;line-height:1.7;margin:20rpx 0}.field{padding:24rpx 0;border-bottom:1rpx solid #ddd;display:flex;gap:20rpx}.amount{display:block;font-size:40rpx;padding:30rpx 0;color:#2e4a68}.error{color:#b53333;display:block}.record{padding:24rpx 0;border-bottom:1rpx solid #ddd}button{margin-top:24rpx}
.history{margin-top:48rpx;padding-top:32rpx;border-top:2rpx solid #ddd}.section-title{display:block;font-size:32rpx;font-weight:600}.record-id{display:block;color:#666;font-size:24rpx;margin-bottom:12rpx}
.recovery{margin:28rpx 0;padding:24rpx;border:1rpx solid #e0bb72;border-radius:12rpx;background:#fffaf0}.recovery-record{padding:20rpx 0;border-bottom:1rpx solid #ead9b6}.recovery-record text{display:block;word-break:break-all}
