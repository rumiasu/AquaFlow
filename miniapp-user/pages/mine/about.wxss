.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.about-section {
  padding: 48rpx 24rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 24rpx;
  padding: 40rpx 0;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-section {
  background-color: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 48rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 104rpx;
  box-sizing: border-box;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item:active {
  background-color: var(--bg-gray);
}

.info-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.info-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

.copyright {
  text-align: center;
}

.copyright text {
  display: block;
  font-size: 26rpx;
  color: var(--text-placeholder);
  line-height: 1.8;
}

/* 本页所有状态共用的可读与触控边界。 */
.about-section { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.logo { width: 112rpx; height: 112rpx; margin: 0 auto 20rpx; }
.logo-section { padding: 24rpx 0; }
.copyright text { color: var(--text-regular); }

/* Visual v2: page hierarchy and reading rhythm. */
.about-section { margin:16px; border-radius:14px; }
.logo-section { padding:24px 16px; }
.info-item { min-height:52px; }
.app-version { color:var(--af2-muted); }

/* 英文名单独成行，避免与版本号连在一起。 */
.brand-english { display: block; margin-bottom: 8rpx; font-size: 26rpx; color: var(--text-secondary); }
