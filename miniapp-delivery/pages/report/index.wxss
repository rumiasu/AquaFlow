.container { background: var(--bg-color); min-height: 100vh; padding-bottom: 200rpx; }

.section { background: var(--bg-card); margin: var(--spacing-md); border-radius: 12rpx; box-shadow: none; padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}
.section-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-lg); display: block; }

.category-list { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
.category-item { text-align: center; padding: 16rpx; border: 2rpx solid var(--border-color); border-radius: var(--radius-md); transition: all .2s;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.category-item.active { border-color: var(--primary-color); background: var(--primary-bg); }
.cat-text { font-size: 28rpx; color: var(--text-regular); }
.category-item.active .cat-text { color: var(--primary-color); font-weight: 600; }

.content-input { width: 100%; min-height: 260rpx; padding: var(--spacing-md); border: 2rpx solid var(--border-color); border-radius: var(--radius-md); font-size: var(--font-md); box-sizing: border-box; }
.char-count { text-align: right; font-size: 24rpx; color: var(--text-secondary); display: block; margin-top: 8rpx; }

.contact-input { width: 100%; padding: var(--spacing-md); border: 2rpx solid var(--border-color); border-radius: var(--radius-md); font-size: var(--font-md); box-sizing: border-box;
  height: 96rpx;
}

.footer { position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg-card); padding: var(--spacing-lg) var(--spacing-md); padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06); }
.btn-submit { width: 100%; background: var(--primary-color); color: #fff; border: none; border-radius: 12rpx; font-size: var(--font-lg); font-weight: 700; padding: var(--spacing-lg) 0; }
.btn-submit::after { border: none; }
.btn-submit[disabled] { opacity: .5; }

.history-item { padding: var(--spacing-md) 0; border-bottom: 1rpx solid var(--border-color); }
.history-item:last-child { border-bottom: none; }
.history-content { font-size: var(--font-md); color: var(--text-primary); line-height: 1.6; margin-bottom: var(--spacing-sm);
  overflow-wrap: anywhere;
}
.history-meta { display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.history-cat { font-size: var(--font-sm); color: var(--primary-color); background: var(--primary-bg); padding: 4rpx 16rpx; border-radius: 20rpx; }
.history-time { font-size: var(--font-sm); color: var(--text-secondary); }
.empty { text-align: center; color: var(--text-secondary); font-size: var(--font-md); padding: var(--spacing-lg) 0; }
.loading { text-align: center; color: var(--text-secondary); font-size: var(--font-md); padding: var(--spacing-lg) 0; }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.btn-submit { height: auto; min-height: 44px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }

.form-card { margin:var(--spacing-md); background:var(--bg-card); border:1rpx solid var(--border-color); border-radius:12rpx; }
.form-card .section { margin:0; border:0; border-radius:0; box-shadow:none; }
.history-toggle { min-height:44px; display:flex; align-items:center; }
.submit-notice { display:block; padding:0 24rpx 24rpx; color:var(--text-regular); line-height:1.6; }
.btn-submit { min-height:48px; }

.draft-notice { display:block; color:var(--text-regular); font-size:26rpx; line-height:1.6; margin:12rpx 0; }
.draft-actions { display:flex; flex-wrap:wrap; gap:12rpx; margin:12rpx 0; }
.draft-actions button:not(.af-action):not(.af-choice) { min-height:44px; height:auto; line-height:1.5; padding:16rpx 20rpx; background:#fff; color:var(--primary-color); border:1rpx solid var(--border-color); }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .category-list { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 4px 8px; } .category-list .af-choice { width: 100%; min-width: 0; } .category-list .af-choice__face { width: 100%; } .b2-feedback-title { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; } .b2-feedback-title .section-title { margin-bottom: 0; } .b2-feedback-symbol { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--af-border); border-radius: 6px; color: var(--af-primary); font-size: 12px; } .draft-actions { display: flex; flex-wrap: wrap; gap: 8px; } .contact-input { min-height: 44px; } .footer { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); } .b2-history-entry { border-bottom: 1px solid var(--af-border); }

/* 2026-10-29 visual-L: writing surface, low-weight options, separate history. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); }
.lv2-report { padding:16px 16px calc(126px + env(safe-area-inset-bottom)); box-sizing:border-box; }
.lv2-report .form-card { margin:0 0 20px; border:0; border-radius:16px; overflow:hidden; }
.lv2-report .form-card .section { padding:16px; }
.lv2-form-head { display:flex; align-items:center; gap:12px; padding:0 0 20px; }
.lv2-form-title { flex:1; font-size:22px; line-height:30px; font-weight:600; color:var(--af2-ink); }
.lv2-report .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-report .section-title { font-size:15px; line-height:22px; margin-bottom:10px; }
.lv2-report .draft-notice { font-size:13px; line-height:20px; margin:8px 0; color:var(--af2-muted); }
.lv2-report .lv2-draft-fact { margin-bottom:12px; }
.lv2-report .category-list { gap:4px 8px; }
.lv2-report .cat-text { font-size:14px; line-height:20px; }
.lv2-report .af-choice--selected .af-choice__face { background:var(--af2-surface-order); }
.lv2-report .content-input { min-height:200px; font-size:15px; line-height:24px; padding:12px; border-radius:12px; }
.lv2-report .contact-input { height:auto; min-height:48px; font-size:15px; padding:12px; border-radius:10px; }
.lv2-report > .section { margin:0; padding:0 16px 16px; border:0; border-radius:16px; }
.lv2-report .lv2-history-entry { min-height:60px; margin:0; }
.lv2-report .lv2-history-entry .section-title { margin:0; }
.lv2-report .history-item { padding:14px 0; }
.lv2-report .history-time { font-size:12px; line-height:18px; }
.lv2-report .history-content { font-size:14px; line-height:22px; }
.lv2-report .footer { padding:12px 16px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--af2-line); box-shadow:none; }
