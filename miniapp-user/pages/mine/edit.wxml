<view class="container">
  <view class="page-intro"><text class="page-intro-title">个人资料</text><text class="page-intro-note">用于联系与配送服务</text></view>
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>

  <view class="save-error" wx:if="{{saveError}}">{{saveError}}</view>
  <button class="submit-btn" wx:if="{{needLogin}}" bindtap="onLogin"><text>去登录</text></button>
  <button class="submit-btn {{submitting ? 'disabled' : ''}}" disabled="{{submitting}}" loading="{{submitting}}" bindtap="onSubmit">
    <text>{{submitting ? '保存中...' : '保存资料'}}</text>
  </button>
</view>
<business-dialog id="business-dialog" />
