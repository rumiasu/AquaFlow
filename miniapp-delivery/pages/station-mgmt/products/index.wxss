@import "../../../styles/setup-module-tasks.wxss";
/* 商品与库存（站长）：选品目录 + 本站设置 + 自己定义商品。
   2026-09-16 重构后本页承担 11 项功能中的：选品、本站设置（上架/价格/水票/优先展示）、
   库存入库与盘点、库存流水、自定义商品增删改、上报通用库。 */

.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.water-templates { background: var(--bg-card); padding: 24rpx; border-radius: 20rpx; margin-bottom: 20rpx; }
.water-template-title { font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; }
.water-template-hint { display: block; font-size: 24rpx; line-height: 1.5; color: var(--text-regular); }
.water-template-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; }
.water-template-image { width: 88rpx; height: 112rpx; flex-shrink: 0; border-radius: 10rpx; }
.water-template-info { flex: 1; min-width: 0; }
.water-template-name { display: block; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.water-template-spec { display: block; font-size: 24rpx; line-height: 1.5; color: var(--text-regular); }
.water-template-use { margin: 0; padding: 0 16rpx; line-height: 64rpx; font-size: 24rpx; color: var(--primary-color); background: var(--bg-color); flex-shrink: 0; }
.water-template-actions { flex-shrink: 0; text-align: center; }
.water-template-edit { display: block; padding: 14rpx 0; font-size: 24rpx; color: var(--primary-color); }
.template-edit-note { margin: 16rpx 0; padding: 16rpx; background: var(--bg-color); color: var(--text-regular); font-size: 24rpx; line-height: 1.6; border-radius: 12rpx; }

/* ===== 顶部：分段 / 搜索 / 分类 ===== */
.top-bar {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.tabs {
  display: flex;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  border-radius: 10rpx;
}

.tab.active {
  background: var(--primary-color);
  color: #fff;
  font-weight: 600;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.04);
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
}

.chip.active {
  background: var(--primary-color);
  color: #fff;
}

.hint-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.hint { font-size: 24rpx; color: var(--text-secondary); }
.link { font-size: 24rpx; color: var(--primary-color); }

/* ===== 列表 ===== */
.card {
  display: flex;
  align-items: flex-start;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-sm);
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.info { flex: 1; min-width: 0; margin-left: 20rpx; }

.name-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 600; }

.sub { display: block; font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }

.tag {
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.04);
  color: var(--text-secondary);
}

.tag.platform { background: var(--primary-bg); color: var(--primary-color); }
.tag.mine { background: var(--primary-bg); color: var(--primary-color); }
.tag.on { background: rgba(46, 158, 107, 0.10); color: var(--success-color); }
.tag.off { background: rgba(0, 0, 0, 0.04); color: var(--text-secondary); }
.tag.stock { background: var(--primary-bg); color: var(--primary-color); }
.tag.price { background: var(--primary-bg); color: var(--primary-color); }
.tag.ticket { background: var(--primary-bg); color: var(--primary-color); }
.tag.star { background: rgba(181, 68, 44, 0.08); color: var(--error-color); }

.action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: 12rpx;
}

.btn-mini {
  font-size: 14px;
  color: #fff;
  background: var(--primary-color);
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
}

/* 次要动作（设置）：描边样式，与全站「次要 = 描边」一致 */
.btn-mini.ghost {
  background: transparent;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

.mine-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.btn-link { font-size: 14px; color: var(--text-secondary); padding: 4rpx 0; }
.btn-link.danger { color: var(--error-color); }

.empty, .loading {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 80rpx 0;
}

/* ===== 底部独立入口（自己定义商品）===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.btn-define {
  width: 100%;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 16px;
  font-weight: 600;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-define::after { border: none; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.modal {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header { font-size: 32rpx; font-weight: 600; }
.modal-sub { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

.form-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.form-item { flex: 1; margin-top: 20rpx; }
.form-item.half { margin-top: 0; }

.label { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 10rpx; }

.input, .picker-text {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.stock-row { display: flex; align-items: center; gap: 16rpx; }
.stock-now { font-size: 32rpx; font-weight: 600; color: var(--primary-color); }
.stock-btns { display: flex; gap: 16rpx; margin-top: 12rpx; }

.switch-row { display: flex; gap: 40rpx; margin-top: 24rpx; }
.switch-item { display: flex; align-items: center; gap: 12rpx; }
.switch-label { font-size: 26rpx; }

.modal-img {
  position: relative;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.03);
  margin-top: 20rpx;
}

/* 平台图库入口：紧跟在自传图下方的一条轻量入口 */
.preset-entry {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  background: rgba(0, 0, 0, 0.02);
}
.preset-entry-text {
  font-size: 26rpx;
  color: var(--primary-color);
}
.preset-entry-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 预设图网格 */
.preset-loading,
.preset-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.preset-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid var(--border-color);
  background: rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}
.preset-item.active {
  border-color: var(--primary-color);
}
.preset-thumb {
  width: 100%;
  height: 100%;
}
.preset-check {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--primary-color);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.preview { width: 100%; height: 100%; }

.preview.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.img-hint {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.modal-footer { display: flex; gap: 16rpx; margin-top: 32rpx; }

.btn-cancel, .btn-save, .btn-danger {
  flex: 1;
  height: auto;
  line-height: 1.5;
  border-radius: var(--radius-round);
  font-size: 16px;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-cancel::after, .btn-save::after, .btn-danger::after { border: none; }

.btn-cancel { background: rgba(0, 0, 0, 0.05); color: var(--text-secondary); }
.btn-save { background: var(--primary-color); color: #fff; font-weight: 600; }
/* 危险动作：红色描边（非实心），与全站「danger = red outline」一致 */
.btn-danger {
  background: transparent;
  color: var(--error-color);
  border: 1rpx solid var(--error-color);
}

/* ===== 库存流水 ===== */
.records { margin-top: 20rpx; max-height: 60vh; overflow-y: auto; }

.record {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.record-delta { font-size: 26rpx; font-weight: 600; width: 100rpx; }
.record-delta.plus { color: var(--success-color); }
.record-delta.minus { color: var(--error-color); }
.record-note { flex: 1; font-size: 24rpx; color: var(--text-secondary); text-align: right; }

/* ===== P0 优化新增样式 ===== */
.chip.quick { background: var(--bg-card); border: 1rpx solid var(--border-color); }
.chip.quick.active { background: var(--primary-color); color: #fff; border-color: var(--primary-color); }

.tag.submit { background: var(--primary-bg); color: var(--primary-color); }

.hint-actions { display: flex; gap: 20rpx; }

.seg {
  display: flex;
  background: rgba(0,0,0,0.04);
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 12rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 10rpx;
  color: var(--text-secondary);
}
.seg-item.active { background: var(--primary-color); color: #fff; font-weight: 600; }

.stock-preview { margin-top: 10rpx; font-size: 24rpx; color: var(--primary-color); }

.btn-inline {
  margin-top: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 14px;
  border: none;
}
.btn-inline::after { border: none; }

.warn-inline {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx; border-left: 4rpx solid var(--warning-color); }
.warn-title { display: block; font-size: 24rpx; color: var(--warning-color); margin-bottom: 6rpx; }
.warn-item { display: block; font-size: 24rpx; color: var(--warning-color); line-height: 1.5; }

.filter-row { display: flex; align-items: center; margin-top: 16rpx; }
.filter-chip {
  font-size: 24rpx;
  background: var(--primary-bg);
  color: var(--primary-color);
  border-radius: var(--radius-round);
  padding: 8rpx 18rpx;
}
.filter-clear { margin-left: 10rpx; font-size: 26rpx; }
.filter-hint { font-size: 24rpx; color: var(--text-secondary); }

.record-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.record-product { font-size: 24rpx; color: var(--text-primary); }
.record-meta { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; }
.record-type { font-size: 24rpx; color: var(--text-secondary); width: 180rpx; flex-shrink: 0; }

.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 24rpx 0;
}

/* ========== 水票档位（商品上架快捷定义） ==========
   基本档位在这里配完，更丰富的设置跳「水票档位」独立模块 */
.pkg-block {
  margin: 8rpx 0 4rpx;
  padding: 16rpx 20rpx 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.pkg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pkg-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 标题 + 「?」成组靠左，右侧留给「更多档位设置 ›」（.pkg-head 是 space-between）2026-09-24 */
.pkg-title-row {
  display: flex;
  align-items: center;
}

/* .pkg-hint 已删（2026-09-24）：那两行说明搬进 help-tip 的「?」里，规则留着会显得
   还有一处平铺说明。 */

.pkg-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.pkg-row-deleted {
  opacity: 0.68;
}

.pkg-delete-pending,
.pkg-validation-error { display:block; margin:8rpx 0 0; font-size:24rpx; line-height:1.5; }
.pkg-delete-pending { color:var(--error-color); }
.pkg-validation-error { color:var(--error-color); }

.pkg-input {
  background: var(--bg-card);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
}

.pkg-input.qty {
  width: 110rpx;
}

.pkg-input.price {
  width: 160rpx;
}

.pkg-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 0 8rpx;
}

.pkg-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 0 6rpx;
}

.pkg-del {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--error-color);
  padding: 6rpx 12rpx;
}

.pkg-empty {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { padding-bottom:180rpx; }
.top-bar,.water-templates,.card { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.tab { min-height:88rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; font-size:28rpx; }
.search-input { height:88rpx; font-size:28rpx; border-radius:10rpx; }
.chips { flex-wrap:wrap; }
.chip { min-height:88rpx; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; font-size:26rpx; padding:12rpx 18rpx; border-radius:8rpx; }
.hint-row { flex-wrap:wrap; gap:12rpx; }
.hint { font-size:26rpx; line-height:1.6; color:var(--text-regular); }
.card { flex-wrap:wrap; gap:16rpx; }
.thumb { width:112rpx; height:144rpx; border-radius:8rpx; }
.info { min-width:0; flex:1; }
.name-row,.tags { flex-wrap:wrap; }
.name { font-size:32rpx; overflow-wrap:break-word; }
.sub,.water-template-hint,.water-template-spec,.template-edit-note,.modal-sub { font-size:26rpx; line-height:1.6; color:var(--text-regular); }
.tag { border-radius:6rpx; font-size:24rpx; }
.tag.price,.tag.stock { font-weight:600; font-size:28rpx; color:var(--text-primary); background:var(--bg-color); }
.action { width:100%; display:flex; align-items:center; justify-content:space-between; flex-direction:row; border-top:1rpx solid var(--border-color); padding-top:16rpx; gap:16rpx; }
.btn-mini,.btn-link,.water-template-use,.water-template-edit,.link,.seg-item,.btn-inline { min-height: 44px; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; padding:12rpx 16rpx; font-size: 14px; border-radius:8rpx; }
.mine-actions { display:flex; flex-wrap:wrap; gap:8rpx; }
.water-template-row { flex-wrap:wrap; border-bottom:1rpx solid var(--border-color); }
.water-template-actions { display:flex; flex-wrap:wrap; gap:12rpx; width:100%; }
.modal { border-radius:16rpx; max-height:88vh; }
.modal-header { font-size:34rpx; line-height:1.5; overflow-wrap:break-word; }
.form-row,.seg,.modal-footer,.pkg-row { flex-wrap:wrap; gap:12rpx; }
.form-item { min-width:0; }
.form-item.half { min-width:240rpx; }
.input,.picker-text { min-height:96rpx; font-size:30rpx; box-sizing:border-box; border-radius:10rpx; border:1rpx solid var(--border-color); }
.btn-cancel,.btn-save,.btn-danger,.btn-define { min-height: 48px; height:auto; line-height:1.5; padding:20rpx; border-radius:10rpx; display:flex; justify-content:center; align-items:center; box-sizing:border-box; font-size: 16px; }
.pkg-del { min-height:88rpx; display:flex; align-items:center; padding:0 16rpx; }

.action { margin-left:0; flex-wrap:wrap; box-sizing:border-box; }

/* 2026-10-24 手机反馈：轻筛选、图文同列操作；模板收在新建入口。 */
.top-bar { padding:0 20rpx 12rpx; }
.tabs { padding:0; margin-bottom:16rpx; gap:24rpx; border-bottom:1rpx solid var(--border-color); border-radius:0; background:transparent; }
.tab { min-height:44px; padding:12rpx 0; border-radius:0; border-bottom:4rpx solid transparent; font-size:14px; }
.tab.active { background:transparent; color:var(--primary-color); border-bottom-color:var(--primary-color); }
.search-input { min-height:44px; height:88rpx; font-size:14px; }
.category-filters { flex-wrap:nowrap; gap:4rpx; margin-top:8rpx; }
.category-filters .chip { flex:1; min-width:0; padding:8rpx 0; border-radius:0; background:transparent; }
.category-filters .chip.active { color:var(--primary-color); font-weight:600; }
.chip { min-height:44px; font-size:14px; }
.quick-scroll { width:100%; white-space:nowrap; }
.quick-filters { display:inline-flex; flex-wrap:nowrap; gap:12rpx; margin-top:0; }
.quick-filters .chip { flex:none; padding:8rpx 16rpx; border:0; background:var(--bg-color); color:var(--text-regular); border-radius:8rpx; }
.quick-filters .chip.active { background:var(--primary-bg); color:var(--primary-color); font-weight:600; }
.hint-row { margin-top:0; gap:8rpx; }
.hint { font-size:24rpx; }
.hint-actions { display:flex; flex-wrap:wrap; gap:8rpx; }
.hint-actions .link { min-height:44px; padding:8rpx; font-size:13px; }
.card { flex-wrap:nowrap; gap:20rpx; padding:20rpx; }
.thumb { width:112rpx; height:144rpx; background:var(--bg-color); }
.thumb.placeholder { padding:12rpx; text-align:center; font-size:24rpx; line-height:1.6; color:var(--text-regular); }
.thumb.placeholder text { width:2em; }
.info { margin-left:0; }
.name { min-width:0; max-width:100%; overflow-wrap:anywhere; word-break:break-all; }
.action { justify-content:flex-end; width:auto; border:0; padding-top:8rpx; gap:4rpx; }
.btn-mini { min-height:44px; padding:10rpx 24rpx; font-size:14px; }
.btn-mini.ghost { border-color:var(--border-color); }
.mine-actions { flex-direction:row; align-items:center; justify-content:flex-end; gap:0; }
.mine-actions .btn-link { min-height:44px; padding:8rpx 14rpx; font-size:14px; }
.footer { display:flex; align-items:center; gap:16rpx; }
.btn-template { flex:0 0 auto; margin:0; min-height:48px; padding:16rpx; height:auto; font-size:14px; line-height:1.5; color:var(--primary-color); background:var(--primary-bg); border-radius:10rpx; }
.footer .btn-define { flex:1; min-width:0; min-height:48px; margin:0; font-size:15px; }
.water-template-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.water-template-title { margin:0; }
.water-template-close { margin:0; padding:8rpx 16rpx; min-height:44px; height:auto; font-size:14px; line-height:1.5; color:var(--primary-color); background:transparent; }
.water-template-use { min-height:44px; line-height:1.5; height:auto; padding:12rpx 20rpx; color:var(--primary-color); background:var(--primary-bg); }
.water-template-edit { min-height:44px; font-size:14px; }
.water-template-use::after,.water-template-close::after,.btn-template::after { border:0; }

.work-read-error { padding:24rpx; margin:20rpx 0; background: var(--bg-gray); border-left: 4rpx solid var(--primary-color); border-radius:8rpx; color: var(--text-regular); font-size:28rpx; line-height:1.6; }
.work-read-error text { display:block; }
.work-read-error button { min-height: 44px; line-height:1.5; padding:20rpx; box-sizing:border-box; border-radius:10rpx; color:var(--primary-color); background:#fff; margin-top:20rpx; font-size: 14px; }

/* 2026-10-24：图片待核实卡留在正文；长编辑表单只滚正文，底栏始终留在弹层内。 */
.container { padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); }
.footer { z-index:10; }
.product-upload-recovery { position:static; margin:24rpx 0; padding:24rpx; border:1rpx solid var(--warning-color); border-radius:12rpx; background: var(--bg-gray); border-left: 4rpx solid var(--warning-color); }
.recovery-title,.recovery-case-label { display:block; font-size:30rpx; line-height:1.5; font-weight:600; color:var(--text-primary); overflow-wrap:anywhere; }
.recovery-note { display:block; margin-top:12rpx; font-size:26rpx; line-height:1.65; color:var(--text-regular); overflow-wrap:anywhere; }
.recovery-case { margin-top:24rpx; padding:24rpx 0 0; border-top:1rpx solid var(--border-color); }
.recovery-case-label { font-size:28rpx; }
.recovery-case-actions { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:16rpx; }
.recovery-toggle,.recovery-primary,.recovery-secondary,.recovery-independent { margin:0; min-height:88rpx; height:auto; padding:18rpx 20rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; font-size:28rpx; line-height:1.5; border-radius:10rpx; white-space:normal; overflow-wrap:anywhere; }
.recovery-toggle { width:100%; margin-top:20rpx; background:var(--primary-color); color:#fff; }
.recovery-primary,.recovery-secondary { flex:1; min-width:220rpx; }
.recovery-primary { background:var(--primary-color); color:#fff; }
.recovery-secondary,.recovery-toggle.is-secondary { color:var(--primary-color); background:var(--primary-bg); }
.recovery-new-draft { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid var(--border-color); }
.recovery-independent { margin-top:12rpx; color:var(--primary-color); background:transparent; border:1rpx solid var(--border-color); width:100%; }
.recovery-record-link,.product-image-record-link { display:flex; align-items:center; justify-content:center; width:100%; min-height:72rpx; padding:12rpx 0; box-sizing:border-box; color:var(--primary-color); font-size:26rpx; line-height:1.6; }
.product-upload-recovery button::after,.product-image-action::after,.edit-help-toggle::after { border:0; }
.product-upload-recovery button[disabled],.product-image-action[disabled] { color:var(--text-regular); background:var(--bg-color); }

.product-edit-modal { position:fixed; left:0; right:0; bottom:0; z-index:21; display:flex; flex-direction:column; height:calc(100vh - 56px); max-height:calc(100vh - 56px); padding:0; overflow:hidden; border-radius:20rpx 20rpx 0 0; }
.product-edit-header { flex-shrink:0; padding:28rpx 28rpx 20rpx; border-bottom:1rpx solid var(--border-color); }
.product-editor-stage { position:relative; height:100%; width:100%; }
.product-editor-dismiss-area { position:absolute; top:0; right:0; bottom:0; left:0; background:transparent; }
.product-edit-heading { display:flex; align-items:flex-start; gap:16rpx; }
.product-edit-heading .modal-header { flex:1; min-width:0; }
.product-edit-close,.product-setting-close { flex:none; display:flex; align-items:center; justify-content:center; min-width:60px; min-height:44px; height:auto; margin:-12rpx -12rpx 0 0; padding:12rpx; background:var(--primary-bg); color:var(--primary-color); font-size:26rpx; line-height:1.5; border-radius:10rpx; }
.product-edit-close::after,.product-setting-close::after { border:0; }
.product-editor-resume { margin:24rpx 0; padding:20rpx; background:var(--bg-card); border:1rpx solid var(--border-color); border-radius:12rpx; font-size:26rpx; line-height:1.6; }
.product-editor-resume button { margin:16rpx 0 0; color:var(--primary-color); background:var(--primary-bg); font-size: 14px; }
.recovery-record-picker { padding:20rpx 12rpx; margin-top:20rpx; background:var(--bg-card); color:var(--primary-color); font-size:26rpx; line-height:1.5; border:1rpx solid var(--border-color); border-radius:10rpx; }
.product-edit-header .modal-sub { display:block; }
.product-edit-header .modal-header,.product-edit-header .modal-sub { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; word-break:break-word; }
.product-edit-body { flex:1; min-height:0; height:0; width:100%; }
.product-edit-content { padding:24rpx 28rpx 32rpx; }
.product-edit-content .template-edit-note { margin:0 0 24rpx; }
.edit-help-toggle { display:inline-flex; align-items:center; justify-content:center; min-height:72rpx; height:auto; margin:8rpx 0 0; padding:12rpx 0; color:var(--primary-color); background:transparent; font-size:26rpx; line-height:1.5; }
.edit-help-detail { display:block; margin-top:12rpx; font-size:26rpx; line-height:1.6; color:var(--text-regular); }
.product-edit-image { height:200rpx; margin-top:0; }
.product-image-section { margin-bottom:24rpx; }
.product-image-caption { display:block; margin-top:12rpx; font-size:24rpx; line-height:1.6; color:var(--text-regular); }
.product-image-status { display:block; margin-top:16rpx; color:var(--text-regular); font-size:26rpx; line-height:1.65; overflow-wrap:anywhere; }
.product-image-status.is-warning { padding:16rpx; border:1rpx solid var(--warning-color); border-radius:10rpx; background: var(--bg-gray); color: var(--text-regular); border-left: 4rpx solid var(--error-color); }
.product-image-actions { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:16rpx; }
.product-image-action { flex:1; min-width:220rpx; min-height: 44px; margin:0; padding:18rpx 16rpx; height:auto; box-sizing:border-box; display:flex; align-items:center; justify-content:center; border-radius:10rpx; background:var(--primary-color); color:#fff; font-size: 14px; line-height:1.5; white-space:normal; }
.product-image-action.secondary { background:var(--primary-bg); color:var(--primary-color); }
.product-image-section .water-template-hint { margin-top:12rpx; }
.product-image-help { display:flex; align-items:center; justify-content:center; margin:8rpx 0 0 auto; min-height:44px; height:auto; padding:8rpx 12rpx; font-size:13px; line-height:1.5; color:var(--text-regular); background:transparent; }
.product-image-help::after { border:0; }
.product-edit-footer { flex-shrink:0; flex-wrap:nowrap; margin:0; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border-color); background:var(--bg-card); }
.product-edit-footer .btn-cancel { flex:0 0 30%; min-width:0; }
.product-edit-footer .btn-save { flex:1; min-width:0; }
.product-setting-secondary { padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid var(--border-color); }
.product-setting-secondary .btn-danger { width:100%; }
.product-preset-mask { z-index:30; }

/* Product editing remains primary; direct removal stays a visible secondary action. */
.card .action { width:100%; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12rpx; padding-top:16rpx; margin-top:8rpx; }
.product-card-primary,.product-card-remove { display:flex; align-items:center; justify-content:center; min-height:44px; min-width:0; width:auto; height:auto; margin:0; padding:12rpx 20rpx; border-radius:10rpx; font-size:14px; line-height:1.5; white-space:normal; }
.product-card-primary { background:var(--primary-color); color:#fff; font-weight:600; }
.product-card-remove { min-width:64px; color:var(--error-color); background:var(--bg-gray); border:1rpx solid var(--error-color); }
.product-card-primary::after,.product-card-remove::after { border:0; }
.product-source-note { display:block; padding:20rpx; margin-bottom:24rpx; color:var(--text-regular); background:var(--bg-gray); font-size:26rpx; line-height:1.6; border-radius:10rpx; }
.product-section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; margin-bottom:16rpx; }
.product-section-title { color:var(--text-primary); font-size:30rpx; font-weight:600; }
.product-section-caption { color:var(--text-regular); font-size:26rpx; }
.product-section-spaced { margin-top:32rpx; padding-top:24rpx; border-top:1rpx solid var(--border-color); }
.product-form-section { margin:24rpx 0; padding:24rpx 0 0; }
.product-field-help { display:block; margin:8rpx 0 12rpx; color:var(--text-regular); font-size:24rpx; line-height:1.6; word-break:break-word; }
.product-stock-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:16rpx 0 8rpx; }
.stock-submit,.stock-records { flex:1; min-width:200rpx; min-height:44px; height:auto; margin:0; padding:14rpx 16rpx; font-size:26rpx; line-height:1.5; border-radius:10rpx; white-space:normal; }
.stock-submit { color:var(--primary-color); background:var(--primary-bg); font-weight:600; }
.stock-records { color:var(--text-regular); background:transparent; border:1rpx solid var(--border-color); }
.stock-submit::after,.stock-records::after { border:0; }
.product-display-switches { flex-wrap:wrap; gap:20rpx; }
.product-display-switches .switch-item { flex:1; min-width:240rpx; }
.stock-editor .seg { display:flex; flex-wrap:nowrap; gap:4rpx; }
.stock-editor .seg-item { flex:1; min-width:0; padding:12rpx 6rpx; white-space:normal; }

/* 来源标识只留在缩略卡右上角，两类商品共用动作与编辑布局。 */
.name-row .tag.platform, .name-row .tag.mine { margin-left:auto; flex-shrink:0; }
.product-edit-content .input[disabled] { color:var(--text-regular); background:var(--bg-gray); }

.product-section-nav { display:flex; gap:8rpx; flex-shrink:0; padding:8rpx 24rpx 16rpx; background:#fff; }
.product-section-nav button { flex:1; min-width:0; min-height:44px; margin:0; padding:8rpx 4rpx; font-size:14px; line-height:1.5; color:var(--text-regular); background:var(--bg-gray); }
.product-section-nav button.active { color:var(--primary-color); background:var(--primary-bg); }
.product-section-nav button::after { border:0; }

.price-warning {margin:16rpx 0;padding:24rpx;background:var(--warning-bg);border-radius:12rpx;color:var(--text-primary);font-size:28rpx;line-height:1.6;}
.price-warning text {display:block;}.price-warning-title {font-weight:600;}.price-warning button {min-height:44px;margin-top:12rpx;}
.product-card-secondary,.report-product-entry {min-height:44px;padding:12rpx;font-size:14px;line-height:1.5;background:var(--primary-bg);color:var(--primary-color);}

/* 编辑面板按资料、售价/销售、库存分组；浅边界帮助扫读，不与保存动作争主次。 */
.product-edit-content { background:var(--bg-color); }
.product-edit-group { margin:0 0 20rpx; padding:20rpx; border:1rpx solid var(--border-color); border-radius:12rpx; background:#fff; }
.product-edit-group-details { padding-top:20rpx; }
.product-edit-group-pricing { margin-top:20rpx; }
.product-edit-group .product-section-heading { margin:0 0 12rpx; padding:0 0 12rpx; border-bottom:1rpx solid var(--border-color); }
.product-edit-group .product-section-heading.product-section-spaced { margin-top:0; padding-top:0; }
.product-edit-group .form-item { min-width:0; }
.product-edit-group .form-row { gap:12rpx; }
.product-image-section { margin-bottom:0; }
.product-image-status { margin-top:10rpx; min-height:1.5em; }
.product-image-actions { gap:8rpx; margin-top:10rpx; }
.product-image-action,.product-image-action.secondary { flex:0 1 auto; min-width:0; min-height:44px; padding:10rpx 16rpx; background:var(--bg-gray); color:var(--primary-color); border:1rpx solid var(--border-color); font-size:13px; }
.product-image-action:active { background:var(--primary-bg); }
.product-edit-group .product-display-switches { display:block; margin-top:16rpx; }
.product-edit-group .product-display-switches .switch-item { min-width:0; min-height:52px; margin:0; padding:8rpx 0; justify-content:space-between; border-bottom:1rpx solid var(--border-color); }
.product-edit-group .product-display-switches .switch-item:last-child { border-bottom:0; }
.product-edit-group .switch-label { font-size:14px; line-height:1.5; color:var(--text-primary); }
.product-initial-stock { margin-top:20rpx; }
.stock-editor { background:var(--bg-card); }
.stock-editor .product-section-heading { margin-bottom:14rpx; }

/* Inventory is a separate task from editing the product and its sales settings. */
.card .action { display:flex; flex-wrap:wrap; align-items:stretch; }
.card .action > button { flex:1 1 120rpx; min-width:0; }
.card .action > .product-card-remove { flex:0 0 auto; }
.product-card-secondary { margin:0; border-radius:10rpx; }
.product-card-secondary::after { border:0; }
.inventory-draft-resume { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:16rpx 24rpx; padding:18rpx; border:1rpx solid var(--warning-color); border-radius:12rpx; background:var(--warning-bg); color:var(--text-primary); font-size:26rpx; line-height:1.5; }
.inventory-draft-resume text { flex:1 1 100%; }
.inventory-draft-resume button { flex:1; min-width:0; min-height:44px; margin:0; padding:10rpx 12rpx; color:var(--primary-color); background:var(--primary-bg); font-size:14px; }
.inventory-draft-resume .discard-draft { color:var(--text-regular); background:#fff; border:1rpx solid var(--border-color); }
.inventory-draft-resume button::after { border:0; }
.inventory-sheet { box-sizing:border-box; }
.inventory-body { background:var(--bg-color); }
.inventory-content { padding:24rpx 28rpx 32rpx; }
.inventory-operation-nav { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; margin-bottom:20rpx; }
.inventory-operation-nav button { min-width:0; min-height:44px; margin:0; padding:8rpx 4rpx; color:var(--text-regular); background:#fff; border:1rpx solid var(--border-color); border-radius:10rpx; font-size:13px; line-height:1.4; }
.inventory-operation-nav button.active { color:var(--primary-color); background:var(--primary-bg); border-color:var(--primary-color); font-weight:600; }
.inventory-operation-nav button.inventory-history { color:var(--primary-color); }
.inventory-operation-nav button::after { border:0; }
.inventory-operation-card { padding:22rpx; border:1rpx solid var(--border-color); border-radius:12rpx; background:#fff; }
.inventory-operation-card .product-section-heading { margin-bottom:8rpx; }
.inventory-operation-card .input { margin-top:12rpx; }
.inventory-submit-note { display:block; margin-top:16rpx; color:var(--text-regular); font-size:24rpx; line-height:1.5; }
.ticket-retail-setting { margin-top:20rpx; padding:18rpx 20rpx 8rpx; border-top:1rpx solid var(--border-color); border-radius:10rpx; background:var(--bg-gray); }
.ticket-retail-setting .product-section-heading { margin-bottom:4rpx; }
.ticket-retail-setting .product-section-title { font-size:27rpx; }
.ticket-retail-setting .product-section-caption { font-size:23rpx; }
.ticket-retail-setting .form-item { margin-top:8rpx; }
