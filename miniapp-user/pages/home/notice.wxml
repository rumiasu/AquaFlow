<view class="container">
  <view class="page-state" wx:if="{{loading && !error}}" aria-role="status">
    <text class="page-state-text">{{notice ? '正在刷新公告…' : '正在加载公告…'}}</text>
  </view>
  <view class="page-state" wx:if="{{error}}" aria-role="status">
    <text class="page-state-text page-state-error">{{error}}</text>
    <text class="page-state-note" wx:if="{{loading}}">正在重试，结果尚未确认</text>
    <button class="af-action af-action--quiet" wx:if="{{canRetry}}" disabled="{{loading}}" bindtap="onRetry"><text class="af-action__face">{{loading ? '重试中' : '重新加载'}}</text></button>
    <button class="af-action af-action--quiet" bindtap="onReturnToList"><text class="af-action__face">返回公告列表</text></button>
  </view>
  <view class="notice-detail" wx:if="{{notice}}">
    <text class="notice-title" selectable>{{titleText}}</text>
    <text class="notice-time">{{timeText ? '发布于 ' + timeText : '发布时间暂未提供'}}</text>
    <view class="notice-content" wx:if="{{hasContent}}"><text selectable>{{notice.content}}</text></view>
    <text class="notice-content-empty" wx:else>这条公告暂无正文</text>
  </view>
</view>
<business-dialog id="business-dialog" />
