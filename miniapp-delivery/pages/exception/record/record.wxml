<view class="page-container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:else class="content">
    <!-- 订单基础信息 -->
    <view class="section order-info">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="label">订单号</text>
        <text class="value">{{orderId}}</text>
      </view>
      <view class="info-row">
        <text class="label">客户</text>
        <text class="value">{{order?.receiverName}} {{order?.receiverPhone}}</text>
      </view>
      <view class="info-row">
        <text class="label">水站</text>
        <text class="value">{{stationName}}</text>
      </view>
      <view class="info-row">
        <text class="label">地址</text>
        <text class="value">{{order?.addressSnapshot}}</text>
      </view>
    </view>

    <!-- 回桶录入 -->
    <view class="section">
      <view class="section-title">回桶录入</view>
      
      <view class="input-group">
        <view class="input-row">
          <view class="input-item">
            <text class="input-label">应送桶数</text>
            <text class="input-value">{{deliveryQty}}</text>
          </view>
          <view class="input-item">
            <text class="input-label">实收桶数</text>
            <input class="input-number" type="number" value="{{actualReturn}}" bindinput="onActualReturnChange" placeholder="请输入" />
          </view>
        </view>

        <view class="discrepancy-display {{discrepancy > 0 ? 'short' : (discrepancy < 0 ? 'over' : 'normal')}}">
          <text class="discrepancy-label">差异：</text>
          <text class="discrepancy-value">
            {{discrepancy > 0 ? '少回' : (discrepancy < 0 ? '多回' : '无')}} {{Math.abs(discrepancy)}} 桶
          </text>
          <text class="discrepancy-desc">{{discrepancyDesc}}</text>
        </view>
      </view>

      <!-- 现场处理动作 -->
      <view class="section">
        <view class="section-title">现场处理</view>
        <view class="action-options">
          <view wx:for="{{staffActionOptions}}" wx:key="value" class="action-option {{staffAction === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onStaffActionChange">
            <view class="action-main">
              <text class="action-label">{{item.label}}</text>
              <text class="action-desc">{{item.desc}}</text>
            </view>
            <view class="action-radio {{staffAction === item.value ? 'checked' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 给水/欠水详情 -->
      <view class="section" wx:if="{{staffAction === 'PARTIAL' || staffAction === 'OWE'}}">
        <view class="section-title">给水详情</view>
        <view class="input-row">
          <view class="input-item" wx:if="{{staffAction === 'PARTIAL' || staffAction === 'OWE'}}">
            <text class="input-label">实给水桶数</text>
            <input class="input-number" type="number" value="{{waterGiven}}" bindinput="onWaterGivenChange" placeholder="实给桶数" />
          </view>
          <view class="input-item" wx:if="{{staffAction === 'OWE'}}">
            <text class="input-label">欠水桶数</text>
            <input class="input-number" type="number" value="{{waterOwed}}" bindinput="onWaterOwedChange" placeholder="欠水桶数" />
          </view>
        </view>
        <view class="owe-tip" wx:if="{{staffAction === 'OWE' && waterOwed > 0}}">
          记录欠水 {{waterOwed}} 桶，客户下单自动抵扣
        </view>
      </view>

      <!-- 备注 -->
      <view class="section">
        <view class="section-title">备注</view>
        <textarea class="textarea" placeholder="记录现场情况、客户沟通内容等" value="{{staffNote}}" bindinput="onNoteInput" maxlength="200" />
        <text class="char-count">{{staffNote.length}}/200</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-area">
      <button class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onPreviewSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交异常记录'}}
      </button>
    </view>
  </view>

  <!-- 确认弹窗 -->
  <view wx:if="{{showConfirm}}" class="modal-overlay" bindtap="onCancelSubmit">
    <view class="modal" bindtap="stopPropagation">
      <view class="modal-title">确认提交</view>
      <view class="modal-content">{{confirmMsg}}</view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="onCancelSubmit">取消</button>
        <button class="modal-btn confirm" bindtap="onConfirmSubmit">确认提交</button>
      </view>
    </view>
  </view>
</view>