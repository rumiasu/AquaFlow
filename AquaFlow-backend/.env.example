# AquaFlow 后端必需的环境变量（复制为 .env 或直接在系统中配置）
# 注意：这些值一旦泄露，等同于把系统管理权交出去，禁止提交进仓库。
# 已被泄露的旧密钥请务必先去对应平台吊销并重新生成，不要直接复用。

# ---- JWT ----
# 签名密钥，长度 >= 32 位。泄露 = 任何人可伪造任意身份（含站长）的 token
JWT_SECRET=

# ---- 微信小程序 ----
# 微信公众平台 -> 开发管理 -> 开发设置
# 客户端小程序（miniapp-user，顾客）
WX_APP_ID=
WX_APP_SECRET=
# 员工端小程序（miniapp-delivery，站长 + 配送员）——与客户端是两个不同 appid。
# 不填只影响员工端微信登录（本地可用 dev-login），但生产必须配齐（prod 缺失即拒启）。
WX_STAFF_APP_ID=
WX_STAFF_APP_SECRET=

# ---- 腾讯云 COS ----
# 控制台 -> 访问管理 -> API 密钥管理
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/aquaflow?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- 其他 ----
# 生产环境必须显式配置实际前端域名，禁止使用 * 或 localhost
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# 开发登录后门开关：仅本地开发可设为 true，生产必须保持 false（接口本身已在 prod 环境移除）
# DEV_LOGIN_ENABLED=false
