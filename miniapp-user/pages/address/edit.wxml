<view class="container">
  <privacy-popup />
  <loading wx:if="{{loading}}"></loading>

  <view class="addr-card" wx:else>
    <!-- 联系人 -->
    <view class="field-row">
      <text class="field-label">联系人</text>
      <input class="field-input" placeholder="姓名" value="{{formData.name}}" bindinput="onInputChange" data-field="name" />
    </view>

    <!-- 电话 -->
    <view class="field-row">
      <text class="field-label">电话</text>
      <input class="field-input" placeholder="手机号码" type="number" value="{{formData.phone}}" bindinput="onInputChange" data-field="phone" />
    </view>

    <!-- 所在地区/小区 + 定位 -->
    <view class="field-row">
      <text class="field-label">区域</text>
      <input class="field-input" placeholder="小区/大厦/学校名称" value="{{formData.tag}}" bindinput="onInputChange" data-field="tag" />
      <view class="loc-btn" bindtap="onChooseLocation">
        <text class="loc-icon">📍</text>
      </view>
    </view>
    <!-- 区域快捷建议 -->
    <view class="suggest-row" wx:if="{{tagSuggestions.length > 0}}">
      <view
        class="suggest-tag {{formData.tag === item ? 'active' : ''}}"
        wx:for="{{tagSuggestions}}"
        wx:key="*this"
        bindtap="onTagSuggest"
        data-tag="{{item}}"
      >{{item}}</view>
    </view>

    <!-- 详细地址 -->
    <view class="field-row">
      <text class="field-label">门牌</text>
      <input class="field-input" placeholder="楼栋/单元/门牌号" value="{{formData.detail}}" bindinput="onInputChange" data-field="detail" />
    </view>

    <!-- 标签 -->
    <view class="field-row label-row">
      <text class="field-label">标签</text>
      <view class="label-options">
        <view
          class="label-chip {{formData.label === item ? 'active' : ''}}"
          wx:for="{{labels}}"
          wx:key="*this"
          bindtap="onLabelSelect"
          data-label="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 默认 + 保存 -->
    <view class="bottom-bar">
      <view class="default-toggle" bindtap="onToggleDefault">
        <view class="check-box {{formData.isDefault ? 'checked' : ''}}">
          <text wx:if="{{formData.isDefault}}">&#10003;</text>
        </view>
        <text class="default-text">设为默认地址</text>
      </view>
      <view class="save-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
        <text>{{submitting ? '保存中...' : '保存'}}</text>
      </view>
    </view>
  </view>
</view>
