.container {
  background: #f5f6f8;
  min-height: 100vh;
}

/* ===== 主卡片 ===== */
.addr-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ===== 表单行 ===== */
.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-row:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 110rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #333;
}

/* ===== 定位按钮（嵌入区域行右侧） ===== */
.auto-row {
  border-bottom: none;
}

.auto-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #2E4A68;
  border-radius: 32rpx;
  padding: 0 28rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.auto-btn text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 省市区 ===== */
.region-row {
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 0;
}

.region-row .field-label {
  margin-bottom: 12rpx;
}

.region-fields {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.region-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 0 16rpx;
  text-align: center;
}

/* ===== 区域快捷建议 ===== */
.suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0 16rpx 110rpx;
}

.suggest-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f6f8;
}

.suggest-tag.active {
  color: #1e40af;
  background: #eef2ff;
}

/* ===== 标签行（家/公司/父母家） ===== */
.label-row {
  padding: 16rpx 0;
}

.label-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

.label-chip {
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f6f8;
  border: 2rpx solid transparent;
}

.label-chip.active {
  color: #1e40af;
  background: #eef2ff;
  border-color: #1e40af;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 32rpx;
  margin-top: 8rpx;
}

.default-toggle {
  display: flex;
  align-items: center;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  position: relative;
}

.check-box::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 28rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg) translate(-2rpx, -4rpx);
  opacity: 0;
}

.check-box.checked {
  background: #1e40af;
  border-color: #1e40af;
}

.check-box.checked::after {
  opacity: 1;
}

.default-text {
  font-size: 26rpx;
  color: #666;
}

.save-btn {
  height: 72rpx;
  padding: 0 56rpx;
  background: #1e40af;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.save-btn.disabled {
  background: #b0b0b0;
}
