.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.form-section {
  margin: 24rpx;
  background: #fff;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

.form-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 112rpx;
  box-sizing: border-box;
  gap: 16rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: var(--font-md);
  color: var(--text-regular);
  width: 120rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  min-width: 0;
  min-height: 96rpx;
}

.submit-btn {
  margin: var(--spacing-xl) var(--spacing-md);
  background: var(--primary-color);
  border-radius: 12rpx;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.submit-btn text {
  color: #fff;
  font-size: var(--font-lg);
  font-weight: 600;
}

.submit-btn.disabled {
  background: var(--text-placeholder);
}
