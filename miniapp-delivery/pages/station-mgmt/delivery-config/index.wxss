/* 配送计费配置（v36+）：沿用站内其它管理页的卡片 + 选项样式约定 */
.container {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 金额门槛引导（2026-09-19）：上架非桶装商品后必须补金额门槛，这里给一条显眼的提示 */
.guide-card {
  border: 2rpx solid var(--warning-bg);
  background: var(--warning-bg);
}
.btn-fill {
  margin-top: 20rpx;
  background: var(--warning-color);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 配置完善度（2026-09-19）：逐条列"还差什么 / 为什么必须填 / 去哪填" */
.setup-card { border: 2rpx solid var(--warning-bg); background: var(--warning-bg); }
.setup-item { border-top: 1rpx solid var(--warning-bg); padding: 16rpx 0; }
.setup-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.setup-label { font-size: 27rpx; font-weight: 600; color: var(--warning-color); }
.setup-where { font-size: 22rpx; color: var(--warning-color); flex-shrink: 0; margin-left: 12rpx; }
/* .setup-why / .setup-action 已删（2026-09-24）：那两行说明搬进 help-tip 的「?」里了，
   留着规则会变成"看起来还有一处说明"的误导。 */

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 标题 + 「?」：问号紧贴标题，不要用 .card-header 的 space-between 把它甩到最右边
   （那样它离标题太远，看不出是在解释哪个字段）。2026-09-24 */
.card-title-row {
  display: flex;
  align-items: center;
}

/* .card-sub-warn 已删（2026-09-24）：产品要求"坐标这类概念也藏起来"，
   那句"没选点会被跳过"并进了「配送范围 ?」里。 */

/* 完善度条目右侧那一组（? + 去哪填） */
.setup-head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.badge-on {
  background: var(--success-bg);
  color: var(--success-color);
}

.badge-warn {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin: 20rpx 0 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.options {
  display: flex;
  flex-direction: column;
}

.option {
  border: 2rpx solid var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.option.active {
  border-color: var(--success-color);
  background: var(--success-bg);
}

.option-name {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}

.option-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 32rpx;
}

.btn-primary {
  margin-top: 24rpx;
  background: var(--success-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
