.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.form-section {
  margin: 24rpx;
  background: #fff;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

.form-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 112rpx;
  box-sizing: border-box;
  gap: 16rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: var(--font-md);
  color: var(--text-regular);
  width: 120rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  min-width: 0;
  min-height: 96rpx;
}

.submit-btn {
  margin: var(--spacing-xl) var(--spacing-md);
  background: var(--primary-color);
  border-radius: 12rpx;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.submit-btn text {
  color: #fff;
  font-size: var(--font-lg);
  font-weight: 600;
}

.submit-btn.disabled {
  background: var(--text-placeholder);
}

.edit-error { display:block; color:var(--error-color); margin:20rpx 0; font-size:28rpx; line-height:1.6; }
button:not(.af-action):not(.af-choice).submit-btn { color:#fff; font-size:var(--font-lg); font-weight:600; min-height:48px; height:auto; line-height:1.5; box-sizing:border-box; }

.edit-draft-note { display:block; margin:24rpx 24rpx 0; color:var(--text-regular); font-size:26rpx; line-height:1.6; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .footer, .submit-area { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-edit { padding:20px 16px 32px; }
.lv2-edit .edit-draft-note { margin:0 0 14px; font-size:13px; line-height:21px; }
.lv2-edit .form-section { margin:0 0 20px; padding:4px 16px; border:0; border-radius:16px; }
.lv2-edit .section { padding:0; }
.lv2-edit .form-item { display:flex; flex-direction:column; align-items:stretch; gap:8px; padding:16px 0; }
.lv2-edit .form-label { width:auto; font-size:14px; line-height:22px; color:var(--af2-muted); }
.lv2-edit .form-input { width:100%; flex:none; min-height:48px; font-size:16px; line-height:24px; padding:10px 12px; box-sizing:border-box; border:1px solid var(--af2-line); border-radius:10px; }
.lv2-edit .edit-error { font-size:14px; line-height:22px; margin:0 0 16px; }
.lv2-edit > .af-action--primary { margin-top:8px; }
