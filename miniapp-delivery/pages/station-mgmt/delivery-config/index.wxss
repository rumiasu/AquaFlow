@import "../../../styles/setup-module-tasks.wxss";
/* 配送计费配置（v36+）：沿用站内其它管理页的卡片 + 选项样式约定 */
.container {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 金额门槛引导（2026-09-19）：上架非桶装商品后必须补金额门槛，这里给一条显眼的提示 */
.guide-card {
  border: 2rpx solid var(--warning-bg);
  background: var(--bg-gray); border-left: 4rpx solid var(--primary-color); color: var(--text-regular); }
.btn-fill {
  margin-top: 20rpx;
  background: var(--warning-color);
  color: #fff;
  font-size: 14px;
  border-radius:12rpx;
}

/* 配置完善度（2026-09-19）：逐条列"还差什么 / 为什么必须填 / 去哪填" */
.setup-card { border: 2rpx solid var(--warning-bg); background: var(--bg-gray); border-left: 4rpx solid var(--primary-color); color: var(--text-regular); }
.setup-item { border-top: 1rpx solid var(--warning-bg); padding: 16rpx 0; }
.setup-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.setup-label { font-size: 27rpx; font-weight: 600; color: var(--warning-color); }
.setup-where { font-size: 24rpx; color: var(--warning-color); flex-shrink: 0; margin-left: 12rpx; }
/* .setup-why / .setup-action 已删（2026-09-24）：那两行说明搬进 help-tip 的「?」里了，
   留着规则会变成"看起来还有一处说明"的误导。 */

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 标题 + 「?」：问号紧贴标题，不要用 .card-header 的 space-between 把它甩到最右边
   （那样它离标题太远，看不出是在解释哪个字段）。2026-09-24 */
.card-title-row {
  display: flex;
  align-items: center;
}

/* .card-sub-warn 已删（2026-09-24）：产品要求"坐标这类概念也藏起来"，
   那句"没选点会被跳过"并进了「配送范围 ?」里。 */

/* 完善度条目右侧那一组（? + 去哪填） */
.setup-head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}

.badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.badge-on {
  background: var(--success-bg);
  color: var(--success-color);
}

.badge-warn {
  background: var(--warning-bg);
  color: var(--warning-color);
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin: 20rpx 0 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.options {
  display: flex;
  flex-direction: column;
}

.option {
  border: 2rpx solid var(--bg-gray);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.option.active {
  border-color: var(--success-color);
  background: var(--success-bg);
}

.option-name {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}

.option-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 32rpx;
}

.btn-primary {
  margin-top: 24rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 16px;
}

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { box-sizing:border-box; }
.card { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.card-title { font-size:32rpx; }
.card-header,.card-title-row { flex-wrap:wrap; gap:12rpx; }
.label { font-size:30rpx; font-weight:600; }
.input { min-height:96rpx; border:1rpx solid var(--border-color); border-radius:10rpx; font-size:30rpx; box-sizing:border-box; }
.options { flex-wrap:wrap; gap:12rpx; }
.option { flex:1 1 100%; min-height:96rpx; box-sizing:border-box; border-radius:10rpx; }
.option.active { background:var(--primary-bg); }
.option-name { font-size:30rpx; }
.option-desc,.card-sub,.setup-label,.setup-why,.setup-where { font-size:26rpx; line-height:1.6; color:var(--text-regular); }
.btn-primary,.btn-fill { min-height: 48px; height:auto; line-height:1.5; padding:20rpx; border-radius:10rpx; box-sizing:border-box; font-size: 16px; }

/* 2026-10-25：四段仍在单页统一保存；导航/选项只改变定位和可见说明，不能清除未保存输入。 */
.container { padding-bottom:calc(104px + env(safe-area-inset-bottom)); }
.fee-section-nav { position:sticky; top:0; z-index:30; display:flex; gap:4px; padding:8px 0; margin-bottom:16rpx; background:var(--bg-color); }
.fee-nav-item { flex:1; min-width:0; min-height:44px; margin:0; padding:8px 2px; font-size:13px; line-height:1.4; display:flex; align-items:center; justify-content:center; color:var(--text-regular); background:#fff; border:1rpx solid var(--border-color); border-radius:8rpx; }
.fee-nav-item.active { color:var(--primary-color); background:var(--primary-bg); border-color:var(--primary-color); font-weight:600; }
.fee-nav-item::after,.setup-summary::after { border:0; }
.setup-card { padding:12rpx 20rpx; }
.setup-summary { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:0; padding:8rpx 0; min-height:44px; background:transparent; color:var(--text-primary); text-align:left; font-size:14px; line-height:1.5; }
.setup-summary text:last-child { flex-shrink:0; color:var(--primary-color); }
.setup-required { display:block; margin-bottom:8rpx; color:var(--text-regular); font-size:13px; line-height:1.6; }
.options { flex-direction:row; flex-wrap:nowrap; gap:8rpx; margin-top:8rpx; }
.option { flex:1; min-width:0; min-height:44px; padding:12rpx 4rpx; margin:0; display:flex; align-items:center; justify-content:center; }
.option-name { font-size:14px; line-height:1.5; text-align:center; }
.selected-mode-desc { font-size:13px; line-height:1.6; margin-top:12rpx; }
.fee-save-bar { position:fixed; left:0; right:0; z-index:40; padding:12px 24rpx calc(12px + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid var(--border-color); }
.fee-save-bar.keyboard-open { padding-bottom:12px; }
.fee-save-bar .btn-primary { margin:0; width:100%; }
.fee-field-error { display:block; margin-top:8rpx; font-size:13px; line-height:1.6; color:var(--error-color); }

.fee-options-locked {opacity:.55;}

/* 单页四段保留统一保存；顶部只作规则核对与锚点，不代表额外的上线门槛。 */
.fee-rules-card { margin:16rpx 0 20rpx; padding:20rpx; border:1rpx solid var(--border-color); border-left:4rpx solid var(--primary-color); border-radius:12rpx; background:#fff; }
.fee-rules-heading,.fee-rule-summary-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.fee-rules-title { font-size:30rpx; font-weight:600; color:var(--text-primary); }
.fee-rules-badge,.fee-rule-summary-state { flex-shrink:0; font-size:24rpx; line-height:1.5; color:var(--text-regular); }
.fee-rules-badge.is-saved { color:var(--success-color); }
.fee-rules-badge.is-pending { color:var(--warning-color); }
.fee-rules-note { display:block; margin:8rpx 0 12rpx; font-size:25rpx; line-height:1.55; color:var(--text-regular); }
.fee-rule-summary { display:block; width:100%; height:auto; min-height:44px; margin:10rpx 0 0; padding:14rpx 16rpx; box-sizing:border-box; text-align:left; white-space:normal; border:1rpx solid var(--border-color); border-radius:10rpx; background:var(--bg-gray); }
.fee-rule-summary::after { border:0; }
.fee-rule-summary-title { min-width:0; font-size:27rpx; font-weight:600; color:var(--text-primary); }
.fee-rule-summary-copy { display:block; margin-top:6rpx; font-size:25rpx; line-height:1.55; color:var(--text-regular); overflow-wrap:anywhere; }
.fee-rule-summary-link { display:block; margin-top:6rpx; text-align:right; font-size:24rpx; color:var(--primary-color); }
.fee-section-heading { gap:10rpx; }
.fee-section-number { flex:none; width:42rpx; height:42rpx; line-height:42rpx; text-align:center; border-radius:50%; color:var(--primary-color); background:var(--primary-bg); font-size:22rpx; font-weight:600; }
.fee-choice-row { display:flex; gap:8rpx; margin:8rpx 0 12rpx; }
.fee-choice { flex:1; min-width:0; min-height:44px; height:auto; margin:0; padding:10rpx 8rpx; box-sizing:border-box; white-space:normal; line-height:1.45; font-size:25rpx; color:var(--text-regular); background:var(--bg-gray); border:1rpx solid var(--border-color); border-radius:8rpx; }
.fee-choice::after { border:0; }
.fee-choice.active { color:var(--primary-color); background:var(--primary-bg); border-color:var(--primary-color); font-weight:600; }
.fee-inline-help { display:block; margin:12rpx 0 4rpx; color:var(--text-regular); font-size:24rpx; line-height:1.6; }
