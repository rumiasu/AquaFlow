.container {
  min-height: 100vh;
  /* 底部留白要盖过固定 footer 的总高（提交按钮 + 两行操作），否则最后一段表单会被遮住 */
  padding: 32rpx 32rpx 340rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-header {
  margin-bottom: 40rpx;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-group {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.required {
  color: var(--error-color);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

/* [2026-09-16] .form-picker / .picker-arrow 随「补充省/市/区」级联选择器一并删除：
   省市区改为从定位结果自动解析（见 index.js onChooseLocation），不再有手选项 */

.location-group .location-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* 有省市区副行时自动长高（原为固定 88rpx，会把副行压掉） */
  min-height: 88rpx;
  height: auto;
  padding: 18rpx 28rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

/* 地址文案可与省市区副行折行，故取 flex:1 + min-width:0，避免长地址把图标挤出容器 */
.location-text-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.location-text {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.location-value.placeholder {
  color: var(--text-secondary);
}


.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #E8ECF1;
}

.btn-submit {
  width: 100%;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #ffffff;
  border-radius:12rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }

/* 退出出口：本页是 reLaunch 进来的（页面栈无上一页），没有它站长就出不去 */
.footer-action {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #DAE0E8;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.footer-action:active { opacity: 0.8; }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { padding:24rpx 24rpx 400rpx; }
.form-card { border-radius:12rpx; padding:28rpx 24rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.form-title { font-size:38rpx; }
.form-subtitle { color:var(--text-regular); line-height:1.6; }
.form-label { font-size:30rpx; font-weight:600; }
.form-input { min-height:96rpx; border:1rpx solid var(--border-color); border-radius:10rpx; }
.form-textarea { border:1rpx solid var(--border-color); border-radius:10rpx; }
.location-value { min-height:104rpx; height:auto; box-sizing:border-box; }
.location-text { line-height:1.6; }
.location-sub { color:var(--text-regular); font-size:26rpx; line-height:1.6; }
.location-sub.warn { color:var(--af-text-secondary); }
.footer { border-color:var(--border-color); }
.btn-submit { border-radius:12rpx; min-height: 44px; background:var(--primary-color); }
.footer-action { min-height:88rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; margin-top:12rpx; color:var(--text-regular); }

.container { padding-bottom:calc(160rpx + env(safe-area-inset-bottom)); }
.location-text { white-space:normal; overflow:visible; word-break:break-all; }
.location-error { display:block; color:var(--error-color); line-height:1.6; font-size:28rpx; margin-bottom:20rpx; }
.secondary-actions .footer-action { min-height:44px; }
.btn-submit { min-height:48px; }

.description-toggle { min-height:44px; display:flex; align-items:center; }
.description-toggle .form-label { margin:0; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .b2-page .af-entry { gap: 8px; } .b2-page > .af-action--block { margin-top: 20px; } .footer-actions { display: flex; flex-wrap: wrap; gap: 8px; }

.location-group.af-entry { display: block; min-height: 60px; }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-create { padding:16px 16px calc(140px + env(safe-area-inset-bottom)); }
.lv2-create .form-card { margin:0; border:0; border-radius:16px; padding:20px 16px; }
.lv2-create-head { display:flex; gap:12px; align-items:center; margin-bottom:12px; }
.lv2-create .form-title { font-size:22px; line-height:30px; margin:0; }
.lv2-create .form-subtitle { font-size:13px; line-height:20px; }
.lv2-form-group-title { display:block; color:var(--af2-muted); font-size:13px; line-height:20px; margin:20px 0 8px; }
.lv2-create .form-group { margin:0; padding:14px 0; border-bottom:1px solid var(--af2-line); }
.lv2-create .form-label { font-size:14px; line-height:22px; margin-bottom:8px; }
.lv2-create .form-input { min-height:48px; height:auto; font-size:15px; line-height:24px; border-radius:10px; padding:12px; border-color:var(--af2-line); }
.lv2-create .location-group { margin-top:16px; padding:14px; background:var(--af2-surface-order); border:0; border-radius:14px; }
.lv2-location-label { display:flex; gap:8px; align-items:center; margin-bottom:8px; }
.lv2-location-label .form-label { margin:0; }
.lv2-create .location-text { font-size:15px; line-height:23px; }
.lv2-create .location-sub { font-size:13px; line-height:20px; color:var(--af2-muted); }
.lv2-create .secondary-actions { margin:16px 0; display:flex; flex-wrap:wrap; gap:8px 16px; }
.lv2-create .footer { padding:12px 16px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--af2-line); }
