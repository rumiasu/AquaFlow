.page-container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 蓝色头部区域 */
.header {
  background: var(--header-gradient);
  padding: 60rpx 32rpx 80rpx;
  position: relative;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.2);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.user-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.user-tag text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 钱包卡片 */
.wallet-card {
  background: #fff;
  margin: -40rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 1;
}

.wallet-row {
  display: flex;
  margin-bottom: 24rpx;
}

.wallet-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.wallet-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.wallet-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.wallet-divider {
  width: 1rpx;
  background-color: var(--border-light);
  align-self: stretch;
}

.recharge-btn {
  height: 72rpx;
  background: var(--primary-gradient);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: var(--shadow-primary);
}

.recharge-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.recharge-btn:active {
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 菜单列表 */
.menu-list {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: background-color 0.15s;
}

.menu-item:active {
  background-color: var(--bg-gray);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 邀请好友横幅 */
.invite-banner {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.invite-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E65100;
}

.invite-desc {
  font-size: 24rpx;
  color: #BF360C;
}

.invite-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #FF6D00 0%, #FF9100 100%);
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.invite-btn text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

/* 退出按钮 */
.btn-logout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fff;
  color: var(--error-color);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  margin: 24rpx 24rpx 40rpx;
  font-weight: 500;
}

.btn-logout:active {
  background: rgba(239, 68, 68, 0.04);
}
