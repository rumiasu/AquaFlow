/* 与站长管理页共用暖纸底、白卡和品牌蓝；规则说明始终可见。 */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: var(--bg-color);
  color: var(--text-primary);
  font-size: 28rpx;
}

.section {
  margin: 0 0 24rpx;
  padding: 28rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.title {
  display: block;
  padding-left: 16rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.row {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  line-height: 1.7;
}

.row text {
  display: block;
  font-size: 26rpx;
  color: var(--text-regular);
}

.hint {
  display: block;
  margin: 12rpx 0;
  color: var(--text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-state {
  display: block;
  padding: 24rpx 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  color: var(--text-regular);
  font-size: 26rpx;
  line-height: 1.6;
}

.error {
  display: block;
  margin-bottom: 12rpx;
  color: var(--error-color);
  font-size: 26rpx;
  line-height: 1.6;
}

button {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  color: var(--primary-color);
  font-size: 26rpx;
  line-height: 1.6;
}

button::after {
  border: none;
}
