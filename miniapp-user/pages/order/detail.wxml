<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <view class="order-detail" wx:else>
    <!-- 订单状态 -->
    <view class="status-section">
      <text class="status-text">{{statusText}}</text>
    </view>

    <!-- 订单信息 -->
    <view class="info-section">
      <view class="info-item">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.id}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="product-section">
      <view class="section-title">商品信息</view>
      <view class="product-item">
        <view class="product-info">
          <text class="product-name">{{order.waterTypeName}}</text>
          <text class="product-spec">{{order.waterTypeSpec}}</text>
        </view>
        <view class="product-quantity">
          <text>×{{order.quantity}}桶</text>
        </view>
      </view>
    </view>

    <!-- 配送信息 -->
    <view class="delivery-section">
      <view class="section-title">配送信息</view>
      <view class="info-item">
        <text class="info-label">配送地址</text>
        <text class="info-value">{{order.addressDetail}}</text>
      </view>
      <view class="info-item" wx:if="{{order.deliveryTimeRequest}}">
        <text class="info-label">配送时间</text>
        <text class="info-value">{{order.deliveryTimeRequest}}</text>
      </view>
      <view class="info-item" wx:if="{{order.specialNote}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.specialNote}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section" wx:if="{{order.status === 3}}">
      <view class="reorder-btn" bindtap="onReorder">
        <text>再次购买</text>
      </view>
    </view>
  </view>
</view>
