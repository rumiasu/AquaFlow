<!--
  确认订单 · Wave1 轨道 E（2026-09-26 按 docs/design/29 §3「确认订单与结果」重排）
  信息顺序固定为：收货地址 → 商品与数量 → 支付方式 → 费用摘要 → 备注 → 底部主动作。
  ⚠️ 本页是「钱」的页面：费用摘要那一段有三条护栏（见该块注释），而
     tests/js/order-create-flow.test.js 的 34 条断言**没有一条检查费用文案或金额** ——
     改坏费用区不会变红，只能靠注释与人工核对。
-->
<!-- [2026-10-18] 费用明细抽屉打开时锁住页面滚动：抽屉内的 scroll-view 滚到边界后，
     滚轮/触摸会继续链到背后的下单页（实测「抽屉到底后背景跟着动」）。
     费用抽屉及确认弹层出现时锁住背景，不改金额或提交状态。
     ⚠️ page-meta 必须是页面第一个节点，不能挪到 <view class="container"> 里面。 -->
<page-meta page-style="{{showDetailPopup || showUnifiedConfirm || showOfflineConfirm || showInTransitReminder ? 'overflow: hidden;' : ''}}"></page-meta>

<view class="container" style="{{orderNavigationRecoveryStyle}}">
  <loading wx:if="{{loading}}"></loading>

  <block wx:else>
    <view class="station-status-banner station-identity" wx:if="{{stationId}}">
      <text class="banner-text">本次下单水站：{{stationName && stationNameStationId === stationId ? stationName : ('水站 #' + stationId)}}</text>
    </view>
    <!-- 水站营业状态（软状态，v32）：只提示、不阻断下单 —— 顾客仍可正常下单。
         文案由服务端下发（customerHint），前端不做 operatingStatus 1..4 的映射。 -->
    <view class="station-status-banner" wx:if="{{stationStatusHint}}">
      <icon class="banner-icon" name="alert" size="30rpx" color="#A95516" />
      <text class="banner-text">{{stationStatusHint}}</text>
    </view>

    <!--
      数据没加载出来的提示（空串时不渲染）。[2026-09-20 真机联调] 原来加载失败一律只
      console.warn/error：商品详情缺件、地址与桶权益拉不到都表现为"页面上少一块 / 押金是全额"，
      与真实业务状态无法区分（AGENTS §8.22）。样式复用 styles/common.wxss 的 .load-error
      （本页只覆盖它的左右外边距，见 create.wxss —— 不动全局文件）。
    -->
    <view class="load-error" wx:if="{{loadError}}">{{loadError}}</view>
    <view class="load-error" wx:if="{{productsError}}">{{productsError}}<button class="af-action af-action--quiet" bindtap="onRetryProducts" disabled="{{submitting || productsLoading}}" loading="{{productsLoading}}"><text class="af-action__face">重新读取完整商品清单</text></button></view>

    <view class="enterprise-entry" wx:if="{{enterpriseHint}}"><text>{{enterpriseHint}}</text><button class="af-action af-action--secondary" bindtap="onEnterpriseEntry" disabled="{{submitting || loading}}">{{enterpriseEntryError ? '重试读取申请记录' : '了解企业订水'}}</button><text class="enterprise-error" wx:if="{{enterpriseEntryError}}">{{enterpriseEntryError}}</text></view>

    <text class="station-asset-boundary">桶、水票和押金按水站分别记录，不能跨站使用。</text>

    <!-- ══ ① 收货地址：§3 要求的第一个区块（原来排在商品清单之后）══
         空态分两种：[2026-09-20] 原来只有「请选择配送地址」一句 —— 地址接口失败时 address
         同样是空的，于是"没查到"被写成"你没设地址"，客户会反复去重设地址（问题根本不在那儿）。
         addressLoadError 由 loadAddress 在失败时写入（含可读原因）。 -->
    <view class="address-card" bindtap="onAddressTap">
      <view class="address-icon-wrap">
        <icon name="location" size="36rpx" color="#1677FF" />
      </view>
      <view class="address-info" wx:if="{{address}}">
        <view class="address-top">
          <text class="address-name">{{address.name}}</text>
          <text class="address-phone">{{address.phone}}</text>
        </view>
        <text class="address-detail">{{addressText || address.detail}}</text>
      </view>
      <view class="address-empty" wx:else>
        <text wx:if="{{addressLoadError}}">收货地址没加载出来（{{addressLoadError}}），点这里重试</text>
        <text wx:else>请选择配送地址</text>
      </view>
      <text class="address-arrow">›</text>
    </view>

    <!-- ══ ② 商品与数量 ══
         商品行只放：图、名称与必要规格、水价、数量操作（§3）。桶权益与押金的明细不在这里算，
         它们的口径在下面「费用摘要」与桶账页。 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">商品清单</text>
      </view>
      <view class="product-list" wx:if="{{products.length}}">
        <view class="product-card" wx:for="{{products}}" wx:key="id">
          <image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFit" data-id="{{item.id}}" data-url="{{item.imageUrl}}" binderror="onProductImageError"></image>
          <view wx:else class="product-image product-image-empty"><text>暂无图片</text></view>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-image-note" wx:if="{{item.imageUrl === '/assets/product/barrel-neutral-template.webp'}}">商品示意图 · 包装以实物为准</text>
            <text class="product-spec" wx:if="{{item.specText}}">{{item.specText}}</text>
            <view class="product-purchase-row">
              <view class="product-price" wx:if="{{item.price}}">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.price}}</text>
                <text class="price-unit">/{{item.quantityUnit}}</text>
              </view>
            </view>
            <view class="product-subtotal" wx:if="{{item.quantity > 1}}">
              <text class="subtotal-label">零售小计</text>
              <text class="subtotal-value">¥{{item.subtotalText}}</text>
            </view>
          </view>
          <view class="stepper-wrap">
            <integer-stepper value="{{item.quantityDraft == null ? item.quantity : item.quantityDraft}}" min="{{1}}" max="{{9007199254740991}}" label="{{item.name + '数量'}}" data-index="{{index}}" bind:change="onQtyInput" disabled="{{productsLoading || productsError || submitting || submitState === 'creating' || pendingOrderId || submitState === 'unknown' || orderNavigationBusy || orderNavigationError}}" />
            <button class="checkout-remove af-action af-action--quiet" bindtap="onRemoveProduct" data-index="{{index}}" disabled="{{productsLoading || productsError || submitting || submitState === 'creating' || pendingOrderId || submitState === 'unknown' || orderNavigationBusy || orderNavigationError}}"><text class="af-action__face">移除</text></button>
            <text class="checkout-quantity-error" wx:if="{{item.quantityError}}">{{item.quantityError}}</text>
          </view>
        </view>
      </view>
      <view class="empty-cart" wx:if="{{!products.length && !productsLoading && !productsError}}">
        <text class="empty-cart-copy">当前没有选择商品</text>
        <button class="af-action af-action--secondary" bindtap="onContinueSelectingWater">继续选水</button>
      </view>
      <view class="removed-products" wx:if="{{removedProducts.length}}">
        <text class="removed-products-title">已移除商品</text>
        <view class="removed-product-row" wx:for="{{removedProducts}}" wx:key="id">
          <text class="removed-product-name">{{item.name}}</text>
          <button class="af-action af-action--quiet" bindtap="onUndoRemovedProduct" data-index="{{index}}" disabled="{{productsLoading || productsError || submitting || submitState === 'creating' || pendingOrderId || submitState === 'unknown' || orderNavigationBusy || orderNavigationError}}"><text class="af-action__face">撤销</text></button>
        </view>
      </view>
    </view>

    <!-- ══ ③ 支付方式 ══
         选项、可用性与文案全部由服务端下发（PayMethod.availableMethods），前端不自带 1/2/3 映射表
         （历史事故：前端把 2/3 写反 ⇒ 新客户 100% 下单失败）。 -->
    <view class="payment-method-section">
      <view class="section-header">
        <text class="section-title">支付方式</text>
      </view>
      <view class="payment-methods">
        <text wx:if="{{quoteLoading}}">正在核实金额和支付方式…</text>
        <view class="load-error" wx:if="{{quoteError}}">{{quoteError}}</view>
        <button class="af-action af-action--quiet" wx:if="{{quoteError && !quoteNeedsStation && submitState !== 'unknown'}}" bindtap="onRetryQuote" disabled="{{quoteLoading}}"><text class="af-action__face">重新计算费用</text></button>
        <button class="af-action af-action--quiet" wx:if="{{quoteError && quoteNeedsStation && submitState !== 'unknown'}}" bindtap="onCallStation"><text class="af-action__face">联系水站</text></button>
        <view class="payment-method {{selectedMethod === item.id ? 'selected' : ''}} {{item.enabled ? '' : 'disabled'}}"
              wx:for="{{payMethods}}" wx:key="id"
              bindtap="onSelectMethod" data-id="{{item.id}}" data-enabled="{{item.enabled}}">
          <!-- ⚠️ 图标颜色只能写字面色：Icon 组件把颜色烘进 SVG data-uri，写 var(...) 不生效。
               三个渠道一律用中性色（不再一紫一蓝一橙），选中与否由边框/底色 + 对勾表达。 -->
          <icon name="{{item.id === 1 ? 'bill' : (item.id === 2 ? 'wallet' : 'ticket')}}"
                size="40rpx" color="{{item.enabled ? '#4B596A' : '#9CA7B5'}}" />
          <view class="method-info">
            <text class="method-name">{{item.name}}</text>
            <text class="method-desc">{{item.desc}}</text>
          </view>
          <icon name="check" size="36rpx" color="#1677FF" wx:if="{{selectedMethod === item.id}}" />
        </view>
      </view>
    </view>

    <!-- 配送计费提示（v35）：起送量未达 / 超范围 / 楼层未填等。
         ⚠️ 计费文案一律由后端下发（DeliveryFeeUtil 产出），前端不自造 ——
         前后端各写一套必然对不上。 -->
    <!-- 水票不足提示（后端下发结论，前端只展示）。
         它必须说清"不支持票 + 现金/微信混合支付、票不会被扣"，否则客户会以为可以补差价。
         [2026-09-27 走查 C03] 结论下面再加**下一步的两个动作**，而不是只留一句结论：
           ① 「去买水票」——只在 `reason === 'INSUFFICIENT'`（余额不够）时出现；
              **商品根本不能用票时补票没用**，把人引去买票是错的（走查原文的硬要求）。
           ② 「改用 X 支付」——只**切换页面上的选择**并重走一次报价，**绝不自动提交**
              （走查验收原文：「不得自动改变支付方式并提交」）。
         两个动作的可用性与文案都出自后端下发的数据（`ticketPay.reason` / `methods[].name`），
         前端既不自判也不自造标签。 -->
    <!-- 只合并相同提示的展示；阻断判据、服务端文案与客户下一步动作保持原样。 -->
    <view class="fee-warn" wx:if="{{checkoutWarnings.length > 0}}">
      <text class="fee-warn-text" wx:for="{{checkoutWarnings}}" wx:key="*this">{{item}}</text>
      <view class="warn-actions" wx:if="{{isTicketPay && ticketShortfallHint}}">
        <view class="warn-action" wx:if="{{ticketAltMethod}}" bindtap="onSwitchPayMethod" data-id="{{ticketAltMethod}}">{{ticketAltLabel}}</view>
        <view class="warn-action" wx:if="{{ticketCanBuy}}" bindtap="onGoBuyTicket">去买水票</view>
      </view>
    </view>

    <!-- ══ ⑤ 备注（可选）：§3 里它排在费用摘要之后、底部主动作之前 ══ -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">备注（选填）</text>
      </view>
      <view class="quick-notes">
      <view wx:for="{{quickNotes}}" wx:key="id" bindtap="onQuickNoteTap" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-disabled="{{submitting || submitState === 'creating' || submitState === 'unknown' || pendingOrderId}}" aria-label="{{item.label}}" class="af-choice quick-note {{item.selected ? 'af-choice--selected' : ''}}">
        <view class="af-choice__face"><text class="af-choice__mark" wx:if="{{item.selected}}">✓</text><text>{{item.label}}</text></view>
      </view>
    </view>
    <input maxlength="140" class="note-input" placeholder="如：送达前请联系" value="{{note}}" bindinput="onNoteInput"></input>

    </view>

    <!-- 首次须知保留为可折叠告知；新增押金数量/价格在提交前单独授权。 -->
    <view class="asset-bar {{assetBarExpanded ? 'expanded' : ''}}" wx:if="{{firstStationAsset}}">
      <view class="asset-bar-header" bindtap="onToggleAssetBar">
        <view class="asset-bar-title">
          <icon name="alert" size="30rpx" color="#A95516" />
          <text class="asset-bar-title-text">首次下单须知</text>
        </view>
        <text class="asset-bar-toggle">{{assetBarExpanded ? '收起' : '展开'}}</text>
      </view>
      <view class="asset-bar-content" wx:if="{{assetBarExpanded}}">
        <view class="asset-fact">
          <view class="asset-fact-row">
            <text class="asset-fact-label">送水水站</text>
            <text class="asset-fact-value">{{assetNotice.stationName || '当前水站'}}</text>
          </view>
          <view class="asset-fact-row" wx:if="{{assetNotice.buckets > 0}}">
            <text class="asset-fact-label">本次新增桶押金</text>
            <text class="asset-fact-value strong">¥{{assetNotice.depositAmount}}·可退</text>
          </view>
          <view class="asset-fact-row">
            <text class="asset-fact-label">本单合计</text>
            <text class="asset-fact-value strong">¥{{assetNotice.totalAmountText}}</text>
          </view>
        </view>
        <text class="asset-bar-desc" wx:if="{{assetNotice.buckets > 0}}">押金可按规则申请退还；未领桶无需交桶，已领桶按批准安排交回。</text>
        <text class="asset-bar-desc" wx:else>本次无需再付水桶押金。</text>
        <text class="asset-bar-desc" wx:if="{{assetNotice.onlineAdvice}}">{{assetNotice.onlineAdvice}}</text>
        <view class="asset-detail-link" wx:if="{{!showAssetDetail}}" bindtap="onAssetDetailTap">
          <text class="detail-link-text">查看水桶与押金的详细说明</text>
          <text class="asset-more-glyph">›</text>
        </view>
        <view class="asset-detail" wx:if="{{showAssetDetail}}">
          <text class="detail-intro">桶与押金规则</text>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">押金可以退还。</text>未领桶无需交桶，已领桶按批准安排交回；退还申请、实际交接和退款分别办理。</text>
          </view>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">桶、水票与押金按水站分别记录。</text>它们只属于你下单的这个水站，其他水站无法查看或使用。</text>
          </view>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">更换水站不会清空原有记录。</text>换到别的水站下单后，原水站的桶、水票与押金仍然保留，回到原水站即可继续使用。</text>
          </view>
          <view class="detail-call" bindtap="onCallStation">
            <text class="detail-call-text">{{stationPhone ? '拨打水站电话 ' + stationPhone : '联系水站'}}</text>
            <icon name="arrow" size="28rpx" color="#1677FF" />
          </view>
          <view class="asset-detail-link" bindtap="onAssetDetailClose">
            <text class="detail-link-text">收起详细说明</text>
            <text class="asset-more-glyph up">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ══ 底部：只放三样 —— 实付 / 需扣水票 + 明细入口 + 当前主动作（§3）══
         「结果未知」与「已下单提示」两行**不许删**：它们防的是"重试变第二单"，
         是 §2「有订单号后网络失败围绕原单恢复」的实现。两行只在对应状态下出现，不占常显位置。 -->
    <view class="quote-block-spacer" aria-hidden="true" wx:if="{{blocked && quoteBlockSummary && !submitting && !pendingOrderId && submitState !== 'unknown' && !orderNavigationRecoveryStyle}}"></view>
    <view class="bottom-bar" wx:if="{{!loading}}">
      <!-- 提交结果无法确认（契约 A1/A3）：**不跳成功页、不支付**，把"重试会沿用同一次提交"
           说清楚 —— 服务端可能已经建单，同键重提会命中幂等拿回原单，不会重复下单。 -->
      <view class="submit-unknown" wx:if="{{submitState === 'unknown'}}">
        <text class="submit-unknown-text">{{unknownResultText}}</text>
      </view>
      <!-- [2026-09-26] 购物车没动时，这一屏记住"刚下过的那一单"：按钮变成去那张单，
           而不是再建一单（业内主流形态，见 create.js 里 pendingOrder 的说明）。
           改商品/地址/支付方式 ⇒ 指纹一变、这行与按钮文案自动回到常态。 -->
      <!-- 导航失败就地放在吸底操作区，避免顾客停在页尾时看不到页首恢复提示。 -->
      <view class="order-navigation-error" wx:if="{{orderNavigationError}}">
        <text class="order-navigation-message">{{orderNavigationError}}</text>
        <view class="order-navigation-actions">
          <button class="af-action af-action--quiet" bindtap="onRetryOrderNavigation" disabled="{{orderNavigationBusy}}"><text class="af-action__face">重试打开</text></button>
          <button class="af-action af-action--secondary" bindtap="onOpenMyOrders" disabled="{{orderNavigationBusy}}">我的订单</button>
        </view>
      </view>
      <view class="pending-order-hint" wx:if="{{pendingOrderId && !orderNavigationError}}">
        <text class="pending-order-text">{{pendingOrderPaid ? '这一单已经下好了' : (pendingOrderPaymentState === 'unpaid' ? '你刚才下的单还没付款' : (pendingOrderPaymentState === 'closed' ? '请查看这笔订单的最新状态' : '这笔订单的支付结果待确认'))}}</text>
        <text class="pending-order-sub" bindtap="onViewPendingOrder">看订单详情 ›</text>
      </view>

      <!-- 已有阻断原因靠近提交；长文可查看，原报价/恢复闸门保持不变。 -->
      <view class="quote-block-notice" wx:if="{{blocked && quoteBlockSummary && !submitting && !pendingOrderId && submitState !== 'unknown'}}">
        <text class="quote-block-summary">{{quoteBlockSummary}}</text>
        <button class="af-action af-action--quiet" wx:if="{{quoteBlockDetail}}" bindtap="onViewQuoteBlockReason"><text class="af-action__face">查看原因</text></button>
      </view>
      <view class="bar-main">
        <view class="total-info" bindtap="onShowDetail">
          <!-- 水票整单结清：底栏只留抵扣行（扣几张 + 抵扣多少）+「本次需付 ¥0.00」，
               与正文费用摘要、明细弹窗同口径。 -->
          <text class="detail-item ticket-cover" wx:if="{{ticketCoverText}}">{{ticketCoverText}}</text>
          <view class="total-row">
            <text class="total-label">{{payableAmountLabel}}</text>
            <text class="total-price">{{quoteReady ? '¥' + payableAmountText : '待核实'}}</text>
            <text class="detail-arrow">明细›</text>
          </view>
        </view>
        <!-- 硬拦 > 提交中 > 已有订单 > 常态；普通须知不增加提交门槛。 -->
        <!-- 2026-10-26：此嵌套三元曾漏一个右括号，导致整端 WXML 编译失败；每层条件须完整闭合。 -->
        <view wx:if="{{submitState === 'unknown'}}" class="checkout-submit af-action af-action--primary af-action--final" bindtap="onRetryUnknown">恢复原提交</view>
        <view wx:if="{{submitState !== 'unknown'}}" class="checkout-submit af-action af-action--primary af-action--final {{(submitting || blocked || !products.length) ? 'is-disabled' : ''}}" bindtap="onSubmit">
          <text>{{!products.length ? '先选商品' : (blocked ? (quoteNeedsStation ? '待水站完善' : '暂不可下单') : (submitting ? '提交中...' : (pendingOrderId ? (pendingOrderPaid || pendingOrderPaymentState !== 'unpaid' ? '查看这笔订单' : '继续支付') : '立即下单')))}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 支付方式确认弹窗
       只由 showOfflineConfirm 控制（现金/货到付款在 onSubmit 里置 true）。
       旧写法 `selectedMethod === 3 || showOfflineConfirm` 是旧映射残留：现在 3 = 水票、2 = 现金，
       会导致「选水票付款」也弹出确认货到付款弹窗。 -->
  <view class="method-popup {{showOfflineConfirm ? 'show' : ''}}" wx:if="{{showOfflineConfirm}}">
    <view class="popup-mask" bindtap="onOfflineConfirmCancel"></view>
    <view class="popup-content">
      <view class="popup-title">确认货到付款</view>
      <text class="popup-desc">配送员送达后现金/扫码支付，确认下单后将锁定订单</text>
      <!-- 押金走线下的风险与责任（2026-09-27 产品裁定，正本 docs/design/34）：
           产品原话「线下的提示风险，系统无法检测，产生纠纷时自负」。
           文案由**服务端下发**（报价的 depositOfflineRiskNote），这里只判"这次要不要收押金" ——
           属口径的话术只有服务端一份，前端自造同义句就会与它分叉。
           ⚠️ 有押金才说：没有押金的货到付款单不该背一句"押金风险"。 -->
      <text class="popup-desc" wx:if="{{assetNotice.offlineRiskNote}}">{{assetNotice.offlineRiskNote}}</text>
      <view class="popup-btns">
        <button class="af-action af-action--cancel af-action--form" bindtap="onOfflineConfirmCancel">取消</button>
        <button class="af-action af-action--primary af-action--form af-action--grow" bindtap="onOfflineConfirmOk">确认</button>
      </view>
    </view>
  </view>

  <!-- 配送中桶提醒弹窗 -->
  <view class="method-popup {{showInTransitReminder ? 'show' : ''}}" wx:if="{{showInTransitReminder}}">
    <view class="popup-mask" bindtap="onInTransitReminderCancel"></view>
    <view class="popup-content">
      <view class="popup-title">下单提醒</view>
      <text class="popup-desc">您的水桶正在配送中，请饮完水后再下单，或再购买新的水桶。</text>
      <view class="popup-btns">
        <button class="af-action af-action--cancel af-action--form" bindtap="onInTransitReminderCancel">再想想</button>
        <button class="af-action af-action--primary af-action--form af-action--grow" bindtap="onInTransitReminderOk">继续下单</button>
      </view>
    </view>
  </view>

  <!-- 历史首次告知弹窗保持不可达；当前说明在 .asset-bar 展示。 -->
  <view class="asset-popup {{showAssetConfirm ? 'show' : ''}}" wx:if="{{false}}">
    <view class="popup-mask" bindtap="onAssetConfirmCancel"></view>
    <view class="popup-content asset-warning">
      <view class="popup-title warning">下单前请确认</view>
      <scroll-view class="asset-scroll" scroll-y>
        <view class="asset-fact">
          <view class="asset-fact-row">
            <text class="asset-fact-label">送水水站</text>
            <text class="asset-fact-value">{{assetNotice.stationName || '当前水站'}}</text>
          </view>
          <view class="asset-fact-row" wx:if="{{assetNotice.buckets > 0}}">
            <text class="asset-fact-label">水桶押金</text>
            <text class="asset-fact-value strong">¥{{assetNotice.depositAmount}}·可退</text>
          </view>
          <view class="asset-fact-row">
            <text class="asset-fact-label">本单合计</text>
            <text class="asset-fact-value strong">¥{{assetNotice.totalAmountText}}</text>
          </view>
        </view>
        <!-- 押金那句按"这次要不要交"分两种说法：buckets=0 时不能再说"要交 x 个空桶的押金"。
             ⚠️ 只谈**桶押金**，不写成"押金都能退"这种笼统承诺 —— 未领桶无需交桶；申请、实际交接与退款分别办理。 -->
        <text class="popup-desc" wx:if="{{assetNotice.buckets > 0}}">押金可按规则申请退还；未领桶无需交桶，已领桶按批准安排交回。</text>
        <text class="popup-desc" wx:else>本次无需再付水桶押金。</text>
        <!-- 押金收款方式的建议（2026-09-27 产品裁定，正本 docs/design/34）：
             产品原话「建议第一单押金单走线上吧，弹个建议」——**是建议不是硬拦**，
             所以这里只说一句，支付方式选项一个都不动（客户仍可选现金）。
             文案由**服务端下发**（报价的 depositOnlineAdvice）：线上渠道当前不可用时服务端
             **不下发它**（建议一条走不通的路比不建议更糟），所以这里只判有没有值。 -->
        <text class="popup-desc" wx:if="{{assetNotice.onlineAdvice}}">{{assetNotice.onlineAdvice}}</text>
        <text class="popup-desc">你的水桶、水票和押金都记在这个水站名下，其他水站无法使用。</text>

        <!-- 详细条款：按需展开（默认收起）—— 要读的人点得开，不读的人不被一屏规则挡住。
             展开与收起各挂一个既有 handler（onAssetDetailTap / onAssetDetailClose），不改 js；
             这一行的类名沿用原来的说明入口（.asset-detail-link），所以文案与观感都是客户见过的。 -->
        <view class="asset-detail-link" wx:if="{{!showAssetDetail}}" bindtap="onAssetDetailTap">
          <text class="detail-link-text">查看水桶与押金的详细说明</text>
          <text class="asset-more-glyph">›</text>
        </view>
        <view class="asset-detail" wx:if="{{showAssetDetail}}">
          <text class="detail-intro">桶与押金规则</text>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">押金可以退还。</text>未领桶无需交桶，已领桶按批准安排交回；退还申请、实际交接和退款分别办理。</text>
          </view>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">桶、水票与押金按水站分别记录。</text>它们只属于你下单的这个水站，其他水站无法查看或使用。</text>
          </view>
          <view class="detail-rule-item">
            <text class="detail-rule-text"><text class="detail-bold">更换水站不会清空原有记录。</text>换到别的水站下单后，原水站的桶、水票与押金仍然保留，回到原水站即可继续使用。</text>
          </view>
          <!-- 电话行：取到就拨号，取不到就去「客服」页（那里自己会说明"是没查到"还是"没登记"）——
               不留一个点了没反应的按钮。 -->
          <view class="detail-call" bindtap="onCallStation">
            <text class="detail-call-text">{{stationPhone ? '拨打水站电话 ' + stationPhone : '联系水站'}}</text>
            <!-- 图标名用 arrow：Icon 组件里**没有 right** 这个名字，写 right 会静默回退成
                 empty（一个方块层叠图），原来的那一行就是这么渲染的。 -->
            <icon name="arrow" size="28rpx" color="#1677FF" />
          </view>
          <view class="asset-detail-link" bindtap="onAssetDetailClose">
            <text class="detail-link-text">收起详细说明</text>
            <text class="asset-more-glyph up">›</text>
          </view>
        </view>
      </scroll-view>
      <view class="popup-btns">
        <button class="af-action af-action--cancel af-action--form" bindtap="onAssetConfirmCancel">返回修改</button>
        <button class="af-action af-action--primary af-action--form af-action--grow" bindtap="onAssetConfirmOk">继续下单</button>
      </view>
    </view>
  </view>

  <!-- 缺货确认弹窗（已合并到综合确认弹窗）
       [2026-10-06] 原独立弹窗已合并到下方「综合确认弹窗」，
       缺货信息作为其中一个区块展示，保留全部业务文案。 -->
  <view class="asset-popup {{showShortageConfirm ? 'show' : ''}}" wx:if="{{false}}">
    <view class="popup-mask" bindtap="onShortageBack"></view>
    <view class="popup-content asset-warning">
      <view class="popup-title warning">部分商品库存不足</view>
      <!-- 同资产告知：中间可滚动，按钮固定在滚动区外（缺货清单可能很长） -->
      <scroll-view class="asset-scroll" scroll-y>
        <text class="popup-desc">下面这些商品当前备货不够（订单还没有提交）：</text>
        <view class="asset-rules">
          <view class="rule-item" wx:for="{{shortageItems}}" wx:key="productId">
            <text class="rule-num">·</text>
            <text>{{item.productName}}：要 {{item.requested}} 桶，现有 {{item.stock}} 桶</text>
          </view>
        </view>
        <text class="popup-desc">同意等待的话，水站到货后会联系您安排配送（具体时间以水站通知为准）；也可以返回调整数量或换个商品。</text>
      </scroll-view>
      <view class="popup-btns">
        <button class="af-action af-action--cancel af-action--form" bindtap="onShortageBack">返回调整</button>
        <button class="af-action af-action--primary af-action--form af-action--grow" bindtap="onShortageAgree">同意等待安排</button>
      </view>
    </view>
  </view>

  <!-- 费用明细：底栏打开；金额均取本次服务端报价。 -->
  <view class="detail-popup {{showDetailPopup ? 'show' : ''}}" wx:if="{{showDetailPopup}}">
    <view class="popup-mask" bindtap="onDetailPopupClose"></view>
    <view class="popup-content detail-sheet">
      <view class="detail-sheet-header">
        <text class="detail-sheet-title">费用明细</text>
        <view class="detail-sheet-close" bindtap="onDetailPopupClose">
          <text>✕</text>
        </view>
      </view>
      <scroll-view class="detail-sheet-body" scroll-y>
        <view class="detail-sheet-content">
        <block wx:if="{{quoteReady && !ticketCoverText}}">
          <view class="detail-row"><text class="detail-item-name">水费</text><text class="detail-item-price">¥{{totalWaterCostText}}</text></view>
          <view wx:if="{{extraDepositBuckets > 0}}" class="detail-deposit-group">
            <view class="detail-row"><view class="detail-row-left"><text class="detail-item-name">本次新增桶押金</text><text class="detail-item-meta">本次新增 {{extraDepositBuckets}} 份</text></view><text class="detail-item-price">¥{{extraDepositAmountText}}</text></view>
            <view class="section-link standalone-link" wx:if="{{barrelPurchases.length > 0}}" bindtap="onStandalonePurchase">也可单独办理桶押金 ›</view>
          </view>
          <view class="detail-row" wx:if="{{feeBreakdownReady && (deliveryFeeText || floorFeeText)}}"><text class="detail-item-name">配送费</text><text class="detail-item-price">¥{{deliveryFeeText || '0.00'}}</text></view>
          <view class="detail-row" wx:if="{{feeBreakdownReady && floorFeeText}}"><text class="detail-item-name">楼层费</text><text class="detail-item-price">¥{{floorFeeText}}</text></view>
          <view class="detail-row" wx:if="{{feeBreakdownReady && !deliveryFeeText && !floorFeeText}}"><text class="detail-item-name">配送费、楼层费</text><text class="detail-item-price">¥0.00</text></view>
          <view class="detail-row" wx:if="{{!feeBreakdownReady}}"><text class="detail-item-name">配送费、楼层费明细</text><text class="detail-item-price">待核实</text></view>
        </block>
        <text class="fee-hint" wx:if="{{!quoteReady && !quoteError}}">{{quoteLoading ? '正在核实本次费用…' : '请确认地址后重新计算费用。'}}</text>
        </view>
      </scroll-view>
      <view class="detail-sheet-footer">
        <!-- 水票支付且整单能被票结清：明细里各项之和 = 票抵扣 + 需付，合计显示"本次需付"（=0）。
             票不足时"本次需付"就是订单全额（本单用不了票），上方已有警示结论说明原因。 -->
        <view class="detail-total-row ticket-cover-row" wx:if="{{ticketCoverText}}">
          <text class="detail-total-label">{{ticketCoverText}}</text>
          <text class="detail-total-value">已抵扣</text>
        </view>
        <view class="detail-total-row">
          <text class="detail-total-label">{{isTicketPay ? payableAmountLabel : '合计'}}</text>
          <text class="detail-total-value">{{quoteReady ? '¥' + payableAmountText : '待核实'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ══ 综合确认弹窗（合并缺货/线下支付/配送中桶提醒）══
       [2026-10-06] 原独立弹窗合并为一个综合确认，减少弹窗疲劳。
       触发条件（任一）：
         ① 缺货（shortageItems.length > 0）
         ② 线下支付（selectedMethod === 2）
         ③ 配送中桶提醒（hasInTransitBarrels && extraDepositBuckets > 0）
       业务信息全部保留，只是合并到一个弹窗里分区块展示。 -->
  <view class="asset-popup {{showUnifiedConfirm ? 'show' : ''}}" wx:if="{{showUnifiedConfirm}}">
    <view class="popup-mask" bindtap="onUnifiedConfirmCancel"></view>
    <view class="popup-content asset-warning">
      <view class="popup-title warning">下单确认</view>
      <scroll-view class="asset-scroll" scroll-y>
        <!-- 缺货区块 -->
        <view class="unified-section" wx:if="{{shortageItems.length > 0}}">
          <view class="unified-section-header">
            <icon name="alert" size="30rpx" color="#A95516" />
            <text class="unified-section-title">部分商品库存不足</text>
          </view>
          <view class="asset-rules">
            <view class="rule-item" wx:for="{{shortageItems}}" wx:key="productId">
              <text class="rule-num">·</text>
              <text>{{item.productName}}：要 {{item.requested}} 桶，现有 {{item.stock}} 桶</text>
            </view>
          </view>
          <text class="popup-desc">同意等待的话，水站到货后会安排配送（具体时间以水站通知为准）；也可以返回调整数量或换个商品。</text>
        </view>

        <!-- 线下支付区块 -->
        <view class="unified-section" wx:if="{{selectedMethod === 2}}">
          <view class="unified-section-header">
            <icon name="wallet" size="30rpx" color="#16834A" />
            <text class="unified-section-title">货到付款</text>
          </view>
          <text class="popup-desc">配送员送达后现金/扫码支付，确认下单后将锁定订单。</text>
          <text class="popup-desc" wx:if="{{assetNotice.offlineRiskNote}}">{{assetNotice.offlineRiskNote}}</text>
        </view>

        <!-- 配送中桶提醒区块 -->
        <view class="unified-section" wx:if="{{hasInTransitBarrels && extraDepositBuckets > 0}}">
          <view class="unified-section-header">
            <icon name="barrel" size="30rpx" color="#BD3328" />
            <text class="unified-section-title">温馨提示</text>
          </view>
          <text class="popup-desc">您有正在配送中的水桶，本次下单将产生额外桶押金。</text>
        </view>

        <!-- 费用预览 -->
        <view class="unified-section" wx:if="{{barrelPurchases.length > 0}}">
          <view class="unified-section-header"><text class="unified-section-title">本次新增桶押金</text></view>
          <view class="rule-item" wx:for="{{barrelPurchases}}" wx:key="productId">
            <text>{{item.productName || '商品编号 ' + item.productId}}：新增用桶权益 {{item.quantity}} 份，单价 ¥{{item.unitPrice}}，本次桶押金 ¥{{item.amount}}</text>
          </view>
          <text class="popup-desc">点击“确认下单”即同意购买以上用桶权益，与本单水款一起付款，收齐款项后生效。已有容量被占用时，也可返回等待释放或单独办理。</text>
        </view>
        <view class="unified-fee-preview">
          <view class="fee-row">
            <text class="fee-label">水费</text>
            <text class="fee-value">¥{{totalWaterCostText}}</text>
          </view>
          <view class="fee-row" wx:if="{{extraDepositBuckets > 0}}">
            <text class="fee-label">本次新增桶押金</text>
            <text class="fee-value">¥{{extraDepositAmountText}}</text>
          </view>
          <view class="fee-row" wx:if="{{feeBreakdownReady && deliveryFeeText}}">
            <text class="fee-label">配送费</text>
            <text class="fee-value">¥{{deliveryFeeText}}</text>
          </view>
          <view class="fee-row" wx:if="{{feeBreakdownReady && floorFeeText}}">
            <text class="fee-label">楼层费</text>
            <text class="fee-value">¥{{floorFeeText}}</text>
          </view>
          <view class="fee-row total">
            <text class="fee-label total">{{payableAmountLabel}}</text>
            <text class="fee-value total">¥{{payableAmountText}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="popup-btns">
        <button class="af-action af-action--cancel af-action--form" bindtap="onUnifiedConfirmCancel">返回修改</button>
        <button class="af-action af-action--primary af-action--form af-action--grow" bindtap="onUnifiedConfirmOk">确认下单</button>
      </view>
    </view>
  </view>
</view>
<business-dialog id="business-dialog" />
