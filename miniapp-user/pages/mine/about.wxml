<view class="container">
  <view class="about-section">
    <view class="logo-section">
      <image class="logo" src="/assets/logo/aiquan-mark.png" mode="aspectFit"></image>
      <view class="af-brand-wordmark"><text class="af-brand-name">艾泉</text><text class="af-brand-english">AquaFlow</text></view>
      <text class="af-brand-function">订水</text>
      <text class="app-version">{{version ? '版本 ' + version : '版本暂未提供'}}</text>
    </view>

    <view class="info-section">
      <view class="info-item af-entry" bindtap="onOpenAgreement" data-type="user">
        <text class="info-label">服务协议</text>
        <text class="info-arrow">›</text>
      </view>
      <view class="info-item af-entry" bindtap="onOpenAgreement" data-type="privacy">
        <text class="info-label">隐私政策</text>
        <text class="info-arrow">›</text>
      </view>
      <view class="info-item af-entry" bindtap="onOpenService">
        <text class="info-label">联系水站与反馈</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

  </view>
<view class="section" wx:if="{{hasAccountHistory || accountHistoryLoading || accountHistoryError}}">
    <button wx:if="{{hasAccountHistory}}" class="af-action af-action--quiet" bindtap="onOpenAccountHistory"><text class="af-action__face">申请记录</text></button>
    <text wx:if="{{accountHistoryLoading}}">正在查询申请记录…</text>
    <text wx:if="{{accountHistoryError}}">{{accountHistoryError}}</text>
    <button wx:if="{{accountHistoryError}}" class="af-action af-action--quiet" bindtap="onRetryAccountHistory"><text class="af-action__face">重新查询</text></button>
  </view>
</view>
<business-dialog id="business-dialog" />
