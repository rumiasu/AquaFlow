.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

.content {
  padding: 24rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-title-desc {
  font-size: 24rpx;
  color: #999;
}

.switch-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #666;
}

/* 优先展示开关组 */
.priority-switch-group {
  background: linear-gradient(135deg, #FFF7E6, #FFF0D0);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #FFD591;
}

.priority-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #AD6800;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.info-item.full-width {
  grid-column: span 2;
}
.label {
  font-size: 22rpx;
  color: #999;
}
.value {
  font-size: 26rpx;
  color: #333;
  word-break: break-word;
}
.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-badge.normal { background: #f0f9ff; color: #007aff; }
.status-badge.warning { background: #fff1f0; color: #ff4d4f; }
.status-badge.stopped { background: #f5f5f5; color: #999; }

/* 保存区域 */
.save-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #007aff;
  border: none;
  border-radius: 12rpx;
}

.save-btn.disabled {
  background: #ccc;
}