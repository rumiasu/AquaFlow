.page { background: var(--bg-color, #f5f7fa); min-height: 100vh; padding: 24rpx 24rpx 40rpx; }

/* ===== 时间范围切换 ===== */
.range-bar {
  display: flex;
  background: var(--bg-card, #fff);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary, #8a9099);
  border-radius: 12rpx;
}
.range-item.active {
  background: var(--primary, #4f8ef7);
  color: #fff;
  font-weight: 600;
}

/* ===== 区块 ===== */
.section {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #1f2329);
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary, #4f8ef7);
  line-height: 1;
}
.section-head .section-title { margin-bottom: 0; }
.section-note { font-size: 22rpx; color: var(--text-secondary, #8a9099); }

/* ===== 指标卡 ===== */
.metric-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.metric-card {
  width: calc((100% - 32rpx) / 3);
  background: var(--bg-color, #f5f7fa);
  border-radius: 16rpx;
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}
.metric-value { font-size: 34rpx; font-weight: 700; color: var(--primary, #4f8ef7); }
.metric-label { font-size: 22rpx; color: var(--text-secondary, #8a9099); }
.delta { display: flex; align-items: center; gap: 4rpx; font-size: 21rpx; }
.delta-arrow { font-size: 20rpx; }
.delta-text { font-size: 21rpx; }
.delta.up .delta-text, .delta.up .delta-arrow { color: #67c23a; }
.delta.down .delta-text, .delta.down .delta-arrow { color: #f56c6c; }
.delta.flat .delta-text, .delta.flat .delta-arrow { color: #909399; }
/* good/bad 覆盖默认涨跌配色（取消单上涨=红但其实是坏消息要标红，金额上涨=绿） */
.delta.good .delta-text, .delta.good .delta-arrow { color: #67c23a; }
.delta.bad .delta-text, .delta.bad .delta-arrow { color: #f56c6c; }
.delta-prev { font-size: 20rpx; color: #b8bdc6; }

/* ===== 图表 ===== */
.chart-canvas { width: 100%; }
.chart-canvas.trend { height: 380rpx; }
.chart-canvas.donut { height: 300rpx; }
.metric-switch { display: flex; background: var(--bg-color, #f5f7fa); border-radius: 10rpx; padding: 4rpx; }
.ms-item { font-size: 22rpx; padding: 6rpx 18rpx; color: var(--text-secondary, #8a9099); border-radius: 8rpx; }
.ms-item.on { background: var(--primary, #4f8ef7); color: #fff; }

/* ===== 双列 ===== */
.two-col { display: flex; gap: 16rpx; align-items: stretch; }
.two-col .col { flex: 1; min-width: 0; box-sizing: border-box; }

/* ===== 横向条形 ===== */
.hbar-item { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; }
.hbar-label { font-size: 23rpx; color: var(--text-secondary, #8a9099); width: 100rpx; flex-shrink: 0; }
.hbar-track { flex: 1; height: 16rpx; background: var(--bg-color, #f5f7fa); border-radius: 8rpx; overflow: hidden; }
.hbar-fill { height: 100%; background: var(--primary, #4f8ef7); border-radius: 8rpx; }
.hbar-value { font-size: 21rpx; color: var(--text-primary, #1f2329); width: 90rpx; text-align: right; flex-shrink: 0; }

/* ===== 图例 ===== */
.legend { display: flex; flex-direction: column; gap: 10rpx; margin-top: 8rpx; }
.legend-item { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { flex: 1; color: var(--text-primary, #1f2329); }
.legend-val { color: var(--text-secondary, #8a9099); }

/* ===== 排行榜 ===== */
.rank-item { display: flex; gap: 16rpx; padding: 14rpx 0; align-items: flex-start; }
.rank-no {
  width: 40rpx; height: 40rpx;
  border-radius: 10rpx;
  background: var(--bg-color, #f5f7fa);
  color: var(--text-secondary, #8a9099);
  font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-weight: 600;
}
.rank-no.rank-1 { background: #f56c6c; color: #fff; }
.rank-no.rank-2 { background: #e6a23c; color: #fff; }
.rank-no.rank-3 { background: #67c23a; color: #fff; }
.rank-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.rank-body.full { width: 100%; }
.rank-line1 { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.rank-name { font-size: 25rpx; color: var(--text-primary, #1f2329); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-val { font-size: 22rpx; color: var(--text-secondary, #8a9099); flex-shrink: 0; }
.rank-track { height: 12rpx; background: var(--bg-color, #f5f7fa); border-radius: 6rpx; overflow: hidden; }
.rank-fill { height: 100%; background: var(--primary, #4f8ef7); border-radius: 6rpx; }
.rank-fill.green { background: #67c23a; }
.rank-sub { font-size: 20rpx; color: var(--text-secondary, #8a9099); }

/* ===== 时段分布 ===== */
.hour-chart {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  gap: 3rpx;
  padding-top: 20rpx;
}
.hour-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  gap: 6rpx;
}
.hour-bar {
  width: 100%;
  min-height: 3rpx;
  background: var(--primary, #4f8ef7);
  border-radius: 4rpx 4rpx 0 0;
  opacity: 0.85;
}
.hour-label { font-size: 17rpx; color: var(--text-secondary, #8a9099); transform: scale(0.8); }

/* ===== 其它 ===== */
.empty-tip { font-size: 24rpx; color: var(--text-secondary, #8a9099); padding: 16rpx 0; line-height: 1.6; }
.loading { text-align: center; color: var(--text-secondary, #8a9099); font-size: var(--font-md, 28rpx); padding-top: 120rpx; }
.error-banner {
  background: #fef0f0;
  border: 1rpx solid #fbc4c4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  font-size: 25rpx; color: #f56c6c;
}
.retry { color: #fff; background: #f56c6c; border-radius: 24rpx; padding: 8rpx 28rpx; font-size: 24rpx; flex-shrink: 0; }
