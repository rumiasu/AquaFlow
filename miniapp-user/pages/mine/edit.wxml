<view class="container">
  <view class="page-intro"><text class="page-intro-title">个人资料</text></view>
  <view class="save-error draft-notice" wx:if="{{draftMessage}}">{{draftMessage}} <button class="af-action af-action--quiet" bindtap="onRetryDraft"><text class="af-action__face">重试</text></button></view>
  <view class="save-error draft-notice" wx:if="{{draftState === 'saved' && !needLogin}}"><text>有之前保存的输入。</text><button class="af-action af-action--quiet" bindtap="onRestoreDraft"><text class="af-action__face">恢复原输入</text></button><button class="af-action af-action--quiet" bindtap="onDiscardSavedDraft"><text class="af-action__face">放弃草稿</text></button></view>
  <view class="form-section" wx:if="{{!needLogin}}">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号（选填）</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>

  <view class="save-error" wx:if="{{saveError}}">{{saveError}}</view>
  <button class="af-action af-action--secondary af-action--block" wx:if="{{needLogin}}" bindtap="onLogin"><text>去登录</text></button>
  <button wx:if="{{!needLogin}}" class="af-action af-action--primary af-action--block {{submitting ? 'disabled' : ''}}" disabled="{{submitting}}" loading="{{submitting}}" bindtap="onSubmit">
    <text>{{submitting ? '保存中...' : '保存资料'}}</text>
  </button>
</view>
<business-dialog id="business-dialog" />
