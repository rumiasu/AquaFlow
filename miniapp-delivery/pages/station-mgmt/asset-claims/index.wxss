/* 历史认领独立页面；金额和桶票分别列示，不改全局主题。 */
.claim-page { padding: 24rpx; padding-bottom: 72rpx; }
.claim-card { background: var(--bg-white, #fff); border-radius: 16rpx; padding: 24rpx; margin: 20rpx 0; }
.claim-title { display: block; font-size: 29rpx; font-weight: 600; line-height: 1.6; color: var(--text-primary, #182230); }
.claim-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.claim-status { color: var(--primary-color, #1264D6); font-size: 25rpx; margin-left: 16rpx; }
.claim-banner, .claim-notice, .claim-error { padding: 22rpx; margin-bottom: 18rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.7; }
.claim-banner { background: #edf2f6; color: #1264D6; }
.claim-notice { background: var(--bg-gray); color: var(--warning-color); border-left: 4rpx solid var(--warning-color); }
.claim-error { background: var(--bg-gray); color: var(--text-regular); border-left: 4rpx solid var(--error-color); }
.claim-muted, .claim-row { display: block; font-size: 25rpx; line-height: 1.7; margin-top: 12rpx; color: var(--text-secondary, #637083); }
.claim-amount { display: block; font-size: 29rpx; line-height: 1.7; font-weight: 600; margin-top: 16rpx; color: var(--text-primary, #182230); }
.claim-material { display: block; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; margin-top: 18rpx; }
.claim-line { padding-top: 22rpx; margin-top: 22rpx; border-top: 1rpx solid var(--border-color); }
.claim-field { font-size: 27rpx; line-height: 1.7; padding-top: 20rpx; }
.claim-picker { padding: 22rpx 14rpx; background: var(--bg-gray); border-radius: 10rpx; font-size: 27rpx; }
.claim-input { display: block; box-sizing: border-box; width: 100%; min-height: 84rpx; padding: 18rpx; margin-top: 12rpx; background: var(--bg-gray); border-radius: 10rpx; font-size: 28rpx; color: var(--text-primary, #182230); }
.claim-textarea { height: 200rpx; margin-bottom: 22rpx; }
.claim-primary, .claim-secondary { margin-top: 18rpx; min-height: 48px; font-size: 16px; border-radius: 12rpx; }
.claim-primary { background: #1264D6; color: #fff; }
.claim-secondary { background: var(--bg-gray); color: #1264D6; }
.claim-actions { display: flex; }
.claim-actions button:not(.af-action):not(.af-choice):not(.af-entry) { flex: 1; }
.claim-actions button:not(.af-action):not(.af-choice):not(.af-entry):first-child { margin-right: 18rpx; }

/* 长商品名/状态各自保留可读宽度；窄屏自动换行，不挤压金额与操作。 */
.claim-heading { flex-wrap: wrap; gap: 8rpx 16rpx; }
.claim-heading .claim-title { flex: 1; min-width: 180rpx; word-break: break-all; }
.claim-status { flex-shrink: 0; margin-left: 0; max-width: 100%; line-height: 1.7; word-break: break-all; }
.claim-picker, .claim-row, .claim-amount { word-break: break-all; }
.claim-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.work-head { padding: 8rpx 4rpx 24rpx; }
.work-title { display:block; font-size:38rpx; font-weight:700; line-height:1.4; color:var(--text-primary); }
.work-desc { display:block; margin-top:8rpx; font-size:26rpx; line-height:1.6; color:var(--text-regular); }

.claim-page { min-height:100vh; background:var(--bg-color); box-sizing:border-box; }
.claim-banner { background:var(--primary-bg); color:var(--text-regular); border-left:6rpx solid var(--primary-color); font-size:28rpx; line-height:1.6; border-radius:8rpx; }
.claim-card { border-radius:12rpx; border:1rpx solid var(--border-color); box-shadow:none; }
.claim-heading { flex-wrap:wrap; gap:12rpx; }
.claim-title { font-size:30rpx; line-height:1.6; overflow-wrap:break-word; }
.claim-status { font-size:28rpx; margin-left:0; padding:4rpx 12rpx; background:var(--primary-bg); border-radius:6rpx; }
.claim-amount { font-size:34rpx; line-height:1.6; }
.claim-muted,.claim-row { font-size:28rpx; line-height:1.6; color:var(--text-regular); }
.claim-line { border-color:var(--border-color); }
.claim-input { background:var(--bg-color); border:1rpx solid var(--border-color); border-radius:10rpx; }
.claim-primary,.claim-secondary { min-height: 48px; height:auto; line-height:1.5; box-sizing:border-box; border-radius:10rpx; padding:20rpx; font-size: 16px; }
.claim-actions { flex-wrap:wrap; gap:16rpx; }
.claim-actions button:not(.af-action):not(.af-choice):not(.af-entry) { min-width:240rpx; }
.claim-photo { display:block; width:220rpx; height:220rpx; margin-top:12rpx; background:var(--bg-gray); border-radius:10rpx; }

.claim-back { min-height:44px; height:auto; line-height:1.5; background:#fff; color:var(--primary-color); border:1rpx solid var(--border-color); margin-bottom:20rpx; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Page-specific role grouping. */

.b3-claim-state { margin:12px 0 20px; padding-left:12px; border-left:4px solid var(--af-primary); }
.b3-state-caption { display:block; color:var(--af-text-secondary); font-size:13px; line-height:20px; }
.b3-state-title { display:block; color:var(--af-strong); font-size:23px; line-height:30px; font-weight:600; }
.b3-section-heading { display:block; margin:20px 0 8px; color:var(--af-ink); font-size:16px; font-weight:600; }
.claim-actions { display:flex; align-items:stretch; gap:8px; }
.claim-actions .af-action--primary { flex:1; }
.claim-actions .af-action--secondary { flex:none; }
.b3-on-close-selection,.b3-on-retry,.b3-on-recover { margin:8px 0; }

/* Queue remains compact; status and actual assets carry their own meaning. */
.b3-claim-state { border:0; border-radius:14px; padding:14px 16px; background:var(--af2-surface-current); }
.b3-state-caption,.b3-state-title { color:var(--af2-ink-current); }
.claim-amount { display:block; padding:12px; border-radius:12px; background:var(--af2-surface-money); color:var(--af2-ink-money); }
.claim-line { padding:12px; margin:8px 0; border-radius:12px; background:var(--af2-surface-physical); }
.claim-line .claim-title,.claim-line .claim-row { color:var(--af2-ink-physical); }
.claim-select { border-radius:0; box-shadow:none; border:0; border-bottom:1px solid var(--af-border); }


.claim-select .claim-amount { padding:0; background:transparent; color:var(--af2-ink-money); }

.s-claim-section-head { display:flex; align-items:center; gap:8px; } .s-claim-section-head .b3-section-heading { flex:1; }
