.page-container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background-color: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-regular);
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.order-list {
  padding: 24rpx;
}

.orders-heading { padding: 28rpx 24rpx 16rpx; }
.orders-title { display: block; font-size: 38rpx; font-weight: 700; color: var(--text-primary); }
.orders-note { display: block; font-size: 26rpx; color: var(--text-regular); margin-top: 8rpx; }
.tab-bar { flex-wrap: wrap; }
.tab-item { min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 28rpx; padding: 12rpx 8rpx; }
.page-container { padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.orders-retry { min-height: 88rpx; margin: 16rpx 24rpx; padding: 18rpx; font-size: 28rpx; line-height: 1.6; color: var(--primary-color); background: #fff; border: 1rpx solid var(--border-color); border-radius: 12rpx; }
.list-progress { padding: 24rpx; text-align: center; color: var(--text-regular); font-size: 26rpx; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
.empty-next-note { display:block; margin-top:12rpx; font-size:26rpx; }
.empty-order-action { margin:24rpx 0 0; min-height:88rpx; padding:20rpx; background:var(--primary-color); color:#fff; font-size:28rpx; line-height:1.6; border-radius:12rpx; }
.tab-pressed { background:var(--primary-bg); }

.tab-scroll { width:100%; white-space:nowrap; background:#fff; }
.tab-bar { display:inline-flex; flex-wrap:nowrap; width:auto; min-width:100%; position:static; }
.tab-item { flex:0 0 auto; min-width:80px; min-height:44px; height:auto; padding:12px; box-sizing:border-box; font-size:16px; white-space:nowrap; }
.orders-retry,.empty-order-action { min-height:44px; }

/* 分段的点击范围与 32px 可见选择面分开。 */
.tab-bar { padding:4px; background:var(--af-soft); border:0; border-radius:8px; }
.tab-item { min-height:44px; padding:6px 2px; }
.tab-item.active::after { display:none; }
.load-error .af-action { margin:8px 0 0; }
.local-empty .af-action { margin:12px auto 0; }

/* Visual v2: page hierarchy and semantic surfaces. */
.orders-heading { padding:20px 16px 8px; }
.tab-bar { gap:4px; padding:4px; background:var(--af2-surface-neutral); border-radius:10px; }
.tab-item { min-height:44px; box-sizing:border-box; }
.order-list { padding:12px 16px; }
.local-empty { border-radius:14px; }

.empty-order-art { display:flex; align-items:center; justify-content:center; width:144px; height:96px; margin:0 auto 12px; }
.empty-order-art image { width:100%; height:100%; }
