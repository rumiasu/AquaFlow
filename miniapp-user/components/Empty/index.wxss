.empty {
  padding: 64rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.empty-img {
  width: 144rpx;
  height: 144rpx;
  opacity: 0.9;
}
.empty-text {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.empty-text { line-height: 1.6; word-break: break-all; }
