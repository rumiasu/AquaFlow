.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 65vh;
  background: var(--accent-gradient);
  border-radius: 0 0 80rpx 80rpx;
}

.login-content {
  position: relative;
  z-index: 1;
  padding: 0 48rpx;
  padding-top: 200rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 64, 175, 0.15);
}

.logo {
  width: 100rpx;
  height: 100rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.login-section {
  margin-bottom: 60rpx;
}

.wx-login-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07c160;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.wx-login-btn[disabled] {
  background: rgba(255,255,255,0.6);
  color: var(--text-placeholder);
  box-shadow: none;
}

.wx-login-btn::after {
  border: none;
}

.dev-login-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 20rpx 0;
}

.dev-login-btn text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  text-decoration: underline;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  flex-wrap: wrap;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.7);
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #07c160;
  border-color: #07c160;
}

.check-icon {
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

.agreement-link {
  font-size: 24rpx;
  color: #fff;
}
