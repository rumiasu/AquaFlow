/* 我的：先读水票与资产数值，再按需进入流水、桶账与办理。 */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
}

.row-arrow {
  color: var(--text-secondary);
  font-size: 32rpx;
  flex: none;
}

/* ── 用户行 ── */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex: none;
  background: var(--bg-gray);
}
.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
}
.user-tag {
  font-size: var(--font-xs);
  color: var(--text-regular);
  margin-top: 10rpx;
}

/* ── 押金、水票与桶三项卡 ── */
.assets-card {
  margin-top: 20rpx;
}
.assets-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 26rpx 28rpx 8rpx;
}
.assets-title {
  font-size: var(--font-lg);
  font-weight: 600;
}
.assets-station {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}
.assets-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx 4rpx;
}
.asset-cell {
  width: 50%;
  min-width: 0;
  box-sizing: border-box;
  padding: 24rpx 16rpx;
  min-height: 44px;
  display: flex;
  flex-direction: column;
}
.asset-cell:last-child {
  border-left: 1rpx solid var(--border-color);
}
.asset-cell-primary {
  width: 100%;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--primary-bg);
  border-radius: 12rpx;
}
.asset-primary-main { flex: 1; min-width: 0; }
.asset-primary-action { flex: none; color: var(--primary-color); font-size: 28rpx; font-weight: 600; }
.asset-primary-main .asset-value { display: block; font-size: 64rpx; }
.asset-entry { margin-top: 12rpx; color: var(--primary-color); font-size: 28rpx; line-height: 1.5; }
.asset-value {
  overflow-wrap: anywhere;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 8rpx;
}
/* [2026-09-27 走查 C05 修] 未加载的格子：**不能长得像 0** —— 字号调小、用中性灰、
   文案是「暂未加载」。样式与文案一起表达"这一项没拿到"，而不是"这一项是零"。 */
.asset-value.asset-value-unloaded {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-secondary);
}
/* 未加载提示条：toast 会消失，这一条常驻到数据补齐为止，点一下重新加载 */
.assets-unloaded-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--border-color);
  background: var(--bg-gray);
  padding: 18rpx 28rpx; border-left:4rpx solid var(--warning-color); }
.assets-unloaded-text {
  flex: 1;
  font-size: var(--font-xs);
  color: var(--warning-color);
  line-height: 1.5;
}
.assets-unloaded-retry {
  flex: none;
  font-size: var(--font-sm);
  color: var(--warning-color);
  font-weight: 600;
}
.asset-unit {
  font-size: var(--font-xs);
  font-weight: 400;
  color: var(--text-regular);
}
.asset-label {
  font-size: 28rpx;
  color: var(--text-regular);
}
.asset-hint {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 还空桶说明行：还空桶 ≠ 退押金，写清楚不绕弯 */
.asset-note {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid var(--border-color);
  padding: 20rpx 28rpx;
}
.asset-note-text {
  flex: 1;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.6;
}
.asset-note-link {
  flex: none;
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 600;
}

/* ── 分组菜单 ── */
.group-title {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  padding: 28rpx 12rpx 12rpx;
}
.menu-card {
  overflow: hidden;
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx;
}
.menu-row + .menu-row {
  border-top: 1rpx solid var(--border-color);
}
.menu-name {
  flex: 1;
  font-size: var(--font-md);
}
.menu-desc {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  flex: none;
}

/* ── 退出登录：低频操作降级为灰字 ── */
.logout {
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  padding: 48rpx 0 16rpx;
}

.card { box-shadow: none; }
.user-card { padding: 24rpx; }
.avatar { width: 88rpx; height: 88rpx; }
.user-tag, .assets-station, .asset-unit, .asset-hint, .asset-note-text, .assets-unloaded-text, .group-title, .menu-desc { font-size: 26rpx; color: var(--text-regular); }
.assets-head { gap: 16rpx; flex-wrap: wrap; padding: 24rpx 20rpx 8rpx; }
.assets-unloaded-tip { min-height: 96rpx; box-sizing: border-box; border-left:4rpx solid var(--warning-color); }
.asset-note { align-items: flex-start; flex-wrap: wrap; }
.asset-note-link { min-height: 88rpx; display: flex; align-items: center; color: var(--primary-color); }
.menu-row { min-height: 104rpx; box-sizing: border-box; padding: 24rpx; flex-wrap: wrap; gap: 12rpx; }
.menu-name { min-width: 180rpx; }
.menu-desc { flex-shrink: 1; word-break: break-all; }
.group-title { font-weight: 600; padding-top: 28rpx; }

/* 本页所有状态共用的可读与触控边界。 */
.asset-refresh-note { display: block; margin: 12rpx 0; font-size: 26rpx; line-height: 1.6; color: var(--warning-color); }
.asset-cell, .menu-name, .menu-desc, .user-info { min-width: 0; overflow-wrap: anywhere; }
.asset-primary-action { overflow-wrap: anywhere; max-width: 44%; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; background: var(--bg-gray); color: var(--text-regular); font-size: 32rpx; font-weight: 600; }
