<!-- 代客下单（站长）：电话/口头订单当场录入。规格见 docs/design/20 §5。
     金额一律由服务端试算下发，本页只展示（wxml 里不做任何算术）。 -->
<view class="page">
  <view class="work-head"><text class="work-title">替客户下单</text><text class="work-desc">{{step === 1 ? '1 选客户 → 2 选地址 → 3 核对订单' : (step === 2 ? '已选客户 · 接下来选择收货地址' : '核对商品、费用与支付方式后确认下单')}}</text></view>

  <view class="ui-state" wx:if="{{stationError}}"><text class="ui-state-copy">{{stationError}}</text><button size="mini" bindtap="onBackCustomers" class="af-entry b3-on-back-customers" hover-class="af-action--pressed"><view class="af-entry__body">返回客户列表</view><text class="af-entry__arrow" aria-hidden="true">›</text></button></view>
  <block wx:if="{{!stationError}}">
  <!-- 已选摘要：让站长在滚动到下半屏时仍知道"这单是给谁的、送到哪" -->
  <view class="summary" wx:if="{{customer}}">
    <view class="summary-line">
      <text class="summary-label">客户</text>
      <text class="summary-value">{{customer.name}}{{customer.phone ? ' · ' + customer.phone : ''}}</text>
      <text class="summary-change" bindtap="onChangeCustomer">切换客户</text>
    </view>
    <view class="summary-line" wx:if="{{addressText}}">
      <text class="summary-label">送达</text>
      <text class="summary-value">{{addressText}}</text>
      <text class="summary-change" bindtap="onChangeAddress">切换地址</text>
    </view>
  </view>

  <!-- 第一步：选客户（含"已建档但还没下过单"的新客户） -->
  <view class="card" wx:if="{{step === 1}}">
    <view class="card-title">选择客户</view>
    <view class="search-row">
      <input class="search-input" placeholder="搜姓名/电话/地址（地址可缩写）" value="{{keyword}}"
             bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
      <view class="af-action af-action--quiet b3-on-search" bindtap="onSearch"><view class="af-action__face">搜索</view></view>
    </view>
    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <view class="ui-state" wx:elif="{{customerError}}"><text class="ui-state-copy">{{customerError}}</text><button size="mini" bindtap="onRetryCustomers" class="af-action af-action--quiet b3-on-retry-customers" hover-class="af-action--pressed"><view class="af-action__face">重新读取客户</view></button></view>
    <view class="empty" wx:elif="{{!stationError && !customers.length}}">
      没有匹配的客户。可换姓名、电话或地址搜索；仍找不到时请先核对客户在本站的资料。
    </view>
    <view class="row af-entry" wx:for="{{customers}}" wx:key="id"
          bindtap="onPickCustomer" data-id="{{item.id}}">
      <view class="row-main">
        <text class="row-title">{{item.name}}</text>
        <text class="row-sub">{{item.phone || '未留电话'}}</text>
        <text class="row-sub" wx:if="{{item.matchedAddressText}}">{{item.matchedAddressSource === 'ORDER_HISTORY' ? '本站历史订单地址命中' : '档案地址命中'}}：{{item.matchedAddressText}}</text>
        <text class="row-sub" wx:elif="{{item.addressText}}">默认档案地址：{{item.addressText}}</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 第二步：选地址 -->
  <view class="card" wx:if="{{step === 2}}">
    <view class="card-title">选择收货地址</view>
    <view class="empty" wx:if="{{addressesLoading}}">正在读取收货地址…</view>
    <view class="ui-state" wx:elif="{{addressError}}"><text class="ui-state-copy">{{addressError}}</text><button size="mini" bindtap="onRetryAddresses" class="af-action af-action--quiet b3-on-retry-addresses" hover-class="af-action--pressed"><view class="af-action__face">重新读取地址</view></button></view>
    <view class="empty" wx:elif="{{!addresses.length}}">
      该客户还没有可用收货地址，请让客户在顾客端添加后重试。
    </view>
    <view class="row af-entry" wx:for="{{addresses}}" wx:key="id"
          bindtap="onPickAddress" data-id="{{item.id}}">
      <view class="row-main">
        <text class="row-title">{{item.name}} {{item.phone}}</text>
        <text class="row-sub">{{item.detail}}</text>
        <text class="row-sub" wx:if="{{item.floor}}">楼层 {{item.floor}}{{item.hasElevator ? ' · 有电梯' : ''}}</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 第三步：选商品 + 试算 + 下单 -->
  <block wx:if="{{step === 3}}">
    <view class="card">
      <view class="card-title">选择商品</view>
      <view class="empty" wx:if="{{productsLoading}}">正在读取商品…</view>
      <view class="ui-state" wx:elif="{{productError}}"><text class="ui-state-copy">{{productError}}</text><button size="mini" bindtap="onRetryProducts" class="af-action af-action--quiet b3-on-retry-products" hover-class="af-action--pressed"><view class="af-action__face">重新读取商品</view></button></view>
      <view class="empty" wx:elif="{{!products.length}}">本站还没有上架商品</view>
      <product-selector wx:if="{{!productsLoading && !productError && products.length}}" items="{{productOptions}}" selected-id="{{selectedProductId}}" disabled="{{submitting || unknownOrder}}" bind:change="onSelectProduct" />
      <text class="selector-hint" wx:if="{{!productsLoading && !productError && activeProduct}}">数量大于 0 才加入本单。</text>
      <view class="row selected-product" wx:if="{{!productsLoading && !productError && activeProduct}}">
        <view class="row-main"><text class="row-title">{{activeProduct.name}} · 本次数量</text><text class="row-sub">库存 {{activeProduct.availableQty != null ? activeProduct.availableQty : '待核实'}}</text></view>
        <view class="qty">
          <button class="af-action af-action--quiet b3-quantity b3-on-qty" bindtap="onQty" data-id="{{activeProduct.id}}" data-delta="{{-1}}" disabled="{{submitting || unknownOrder || activeProduct.selectedQty === 0}}" aria-label="减少数量" hover-class="af-action--pressed">−</button>
          <text class="qty-value">{{activeProduct.selectedQty}}</text>
          <button class="af-action af-action--quiet b3-quantity b3-on-qty" bindtap="onQty" data-id="{{activeProduct.id}}" data-delta="{{1}}" disabled="{{submitting || unknownOrder}}" aria-label="增加数量" hover-class="af-action--pressed">+</button>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{cartLines.length}}">
      <view class="card-title">本单明细（共 {{totalQty}} 件）</view>
      <view class="row" wx:for="{{cartLines}}" wx:key="productId">
        <view class="row-main">
          <text class="row-title">{{item.name}}</text>
          <text class="row-sub">{{item.priceText || '参考价待核实'}} × {{item.quantity}}</text>
        </view>
        <view class="qty">
          <button class="af-action af-action--quiet b3-quantity b3-on-qty" bindtap="onQty" data-id="{{item.productId}}" data-delta="{{-1}}" disabled="{{submitting || unknownOrder || productsLoading || productError}}" aria-label="减少数量" hover-class="af-action--pressed">−</button>
          <button class="af-action af-action--quiet b3-quantity b3-on-qty" bindtap="onQty" data-id="{{item.productId}}" data-delta="{{1}}" disabled="{{submitting || unknownOrder || productsLoading || productError}}" aria-label="增加数量" hover-class="af-action--pressed">+</button>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="af-action af-action--quiet b3-on-quote" bindtap="onQuote"><view class="af-action__face"><!-- [2026-09-24] 原文是"服务端试算"。站长不需要知道谁算的，
             他需要知道"算出来的钱跟顾客自己下单时一模一样"（产品反馈："接口这些有些专业了"）。 -->
        {{quoting ? '正在算…' : '核算本单费用'}}</view></view>
      <view class="hint">按本站当前规则核算费用；请核对新增押金、配送费与楼层费。</view>
    </view>

    <view class="card s-fee-summary" wx:if="{{quote}}">
      <view class="card-title">金额明细</view>
      <view class="fee-line"><text>水费</text><text>¥{{quote.waterAmount}}</text></view>
      <view class="fee-line"><text>押金</text><text>¥{{quote.depositAmount}}</text></view>
      <view class="fee-line" wx:if="{{quote.deliveryFee}}"><text>配送费</text><text>¥{{quote.deliveryFee}}</text></view>
      <view class="fee-line" wx:if="{{quote.floorFee}}"><text>楼层费</text><text>¥{{quote.floorFee}}</text></view>
      <view class="fee-line fee-total"><text>合计</text><text>¥{{quote.totalAmount}}</text></view>

      <view class="warn" wx:for="{{quote.warnings}}" wx:key="*this">· {{item}}</view>
      <view class="blocked" wx:if="{{quote.blocked}}">不满足本站配送条件：{{quote.blockReason}}</view>

      <view class="card-title" style="margin-top:24rpx;">支付方式</view>
      <view class="methods">
        <!-- 选项与文案由服务端下发，前端不自带 1/2/3 映射表 -->
        <view class="af-choice b3-on-pick-method {{selectedMethod === item.id ? 'af-choice--selected' : ''}} {{item.enabled === false ? 'b3-choice-unavailable' : ''}}"
              wx:for="{{methods}}" wx:key="id"
              bindtap="onPickMethod" data-id="{{item.id}}"><view class="af-choice__face">{{item.name}}{{item.enabled === false ? '（不可用）' : ''}}</view></view>
      </view>
    </view>

    <view class="card" wx:if="{{quote}}">
      <view class="af-action af-action--primary b3-on-submit af-action--grow af-action--final af-action--block" bindtap="onSubmit">
        {{submitting ? '提交中…' : '确认下单'}}
      </view>
      <view class="hint">缺货商品会先弹窗确认。</view>
    </view>
  </block>

  <button wx:if="{{unknownOrder}}" bindtap="onRetryOriginal" disabled="{{submitting}}" class="af-action af-action--quiet b3-on-retry-original" hover-class="af-action--pressed"><view class="af-action__face">核实原下单请求</view></button>
  </block>

</view>
<business-dialog id="business-dialog" />
