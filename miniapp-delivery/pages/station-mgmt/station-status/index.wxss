/* 营业状态 + 公告（站长）。营业状态是软状态：只影响顾客看到的提示，不阻断下单。 */

.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title { font-size: 32rpx; font-weight: 600; }
.card-sub { display: block; font-size: 22rpx; color: var(--text-secondary); margin-top: 10rpx; line-height: 1.5; }

.badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
.badge-on { background: #e8f7ee; color: #1a7f45; }
.badge-warn { background: #fff7e6; color: #b26a00; }
.badge-off { background: rgba(0, 0, 0, 0.05); color: var(--text-secondary); }

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.option {
  flex: 1 1 46%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.option.active {
  border-color: var(--primary, #4F8EF7);
  background: rgba(79, 142, 247, 0.08);
}

.option-name { display: block; font-size: 28rpx; font-weight: 600; }
.option-desc { display: block; font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; }

.field { margin-top: 24rpx; }
.label { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 10rpx; }

.input, .textarea {
  width: 100%;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input { height: 80rpx; }
.textarea { min-height: 160rpx; }

.counter { display: block; text-align: right; font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; }

.preview {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff7e6;
}
.preview-label { display: block; font-size: 22rpx; color: #b26a00; }
.preview-text { display: block; font-size: 26rpx; color: #1a1a1a; margin-top: 8rpx; line-height: 1.5; }

.btn-primary {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary, #4F8EF7);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-primary.flex1 { flex: 1; margin-top: 0; }

.link { font-size: 26rpx; color: var(--primary, #4F8EF7); }

.notice {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 22rpx 0;
}
.notice:first-of-type { border-top: none; }

.notice-head { display: flex; align-items: center; justify-content: space-between; }
.notice-title { font-size: 28rpx; font-weight: 600; }
.notice-content { display: block; font-size: 24rpx; color: #475467; margin-top: 8rpx; line-height: 1.5; }

.notice-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.notice-time { font-size: 22rpx; color: var(--text-secondary); }
.notice-actions { display: flex; gap: 24rpx; }
.btn-link { font-size: 24rpx; color: var(--primary, #4F8EF7); }
.btn-link.danger { color: #d92d20; }

.empty { text-align: center; font-size: 24rpx; color: var(--text-secondary); padding: 40rpx 0; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.modal {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header { font-size: 32rpx; font-weight: 600; }

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.switch-label { font-size: 26rpx; }

.modal-footer { display: flex; gap: 16rpx; margin-top: 32rpx; }

.btn-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  border: none;
  background: rgba(0, 0, 0, 0.05);
  color: var(--text-secondary);
}
