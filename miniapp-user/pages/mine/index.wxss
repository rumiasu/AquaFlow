/* Mine density: two asset rows, inline service icons, native tab bar owns its footprint. */
.page { min-height:100vh; padding:16px; box-sizing:border-box; background:#F2F6F9; color:#203047; }
.card { box-sizing:border-box; background:#FFFFFF; border:1px solid #DCE5ED; border-radius:14px; box-shadow:0 2px 10px rgba(29,67,101,.025); }
.row-arrow { flex:none; font-size:20px; line-height:24px; color:#53687B; }
.user-card { display:flex; align-items:center; gap:12px; padding:8px 4px 12px; border:0; box-shadow:none; background:transparent; }
.avatar { flex:none; width:48px; height:48px; border-radius:14px; background:#D8E8F4; }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; }
.user-info { flex:1; min-width:0; overflow-wrap:anywhere; }
.nickname { font-size:20px; line-height:28px; font-weight:600; }

.assets-card { margin-top:12px; border:0; background:transparent; box-shadow:none; }
.assets-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.assets-grid .asset-cell { box-sizing:border-box; display:flex; flex-direction:column; align-items:stretch; gap:8px; width:auto; min-width:0; min-height:84px; padding:10px; border:1px solid #DCE5ED; border-radius:12px; background:#F9FBFC; }
.asset-heading { display:flex; align-items:center; gap:6px; min-width:0; }
.asset-icon { display:flex; align-items:center; justify-content:center; flex:none; width:24px; height:24px; border-radius:6px; }
.asset-order .asset-icon { background:var(--af2-surface-order); }
.asset-money-tone .asset-icon { background:var(--af2-surface-money); }
.asset-physical .asset-icon { background:var(--af2-surface-physical); }
.asset-label { min-width:0; font-size:13px; line-height:20px; color:#53687B; overflow-wrap:anywhere; }
.asset-main { display:flex; align-items:baseline; gap:6px; width:100%; min-width:0; min-height:32px; }
.asset-value { flex:1; min-width:0; font-size:26px; line-height:32px; font-weight:700; color:#203047; overflow-wrap:anywhere; }
.asset-money { font-size:22px; }
.asset-value.asset-value-unloaded { font-size:14px; line-height:22px; font-weight:500; color:#526176; }
.asset-unit { font-size:12px; line-height:20px; font-weight:400; color:#53687B; }
.asset-entry { flex:none; margin:0; color:#1F5EA8; font-size:12px; line-height:20px; white-space:nowrap; }
.assets-grid--stacked { grid-template-columns:minmax(0,1fr); }
.assets-grid--stacked .asset-cell { width:auto; }
.asset-refresh-note { display:block; margin:8px 0; font-size:13px; line-height:21px; color:#53687B; overflow-wrap:anywhere; }
.asset-note { display:flex; align-items:center; gap:8px; margin-top:8px; }
.asset-note-text { font-size:13px; line-height:21px; color:#53687B; }
.assets-unloaded-tip { box-sizing:border-box; display:flex; flex-wrap:wrap; align-items:center; gap:6px 12px; min-height:44px; padding:8px 10px; margin-top:8px; border:1px solid #DCE5ED; border-radius:8px; background:#F9FBFC; }
.assets-unloaded-text { flex:1 1 120px; min-width:0; font-size:13px; line-height:21px; color:#53687B; }
.assets-unloaded-retry { flex:none; font-size:13px; line-height:21px; color:#1F5EA8; }

.group-title { display:block; margin:16px 4px 8px; font-size:18px; line-height:24px; font-weight:600; }
.quick-actions { display:flex; flex-wrap:wrap; gap:6px; padding:8px; }
.quick-actions .quick-action,.quick-actions.company-actions .quick-action { box-sizing:border-box; display:flex; flex:1 1 100px; align-items:center; justify-content:flex-start; gap:6px; width:auto; min-width:100px; min-height:56px; padding:6px; }
.quick-icon { display:flex; flex:none; align-items:center; justify-content:center; width:24px; height:24px; }
.quick-label { min-width:0; font-size:14px; line-height:22px; color:#203047; overflow-wrap:anywhere; }

/* Keep the approved 3:1 scene and its image-failure fallback. */
.scene-entry { position:relative; height:0; padding-top:33.333%; margin-top:12px; border-radius:14px; overflow:hidden; background:#DCEAF3; box-sizing:border-box; }
.scene-entry-image,.scene-entry-fallback { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.scene-entry-fallback { display:flex; justify-content:flex-end; align-items:center; padding-right:14%; box-sizing:border-box; }
.scene-entry-copy { position:absolute; top:12px; left:14px; width:42%; display:flex; flex-direction:column; align-items:flex-start; gap:3px; }
.scene-entry-title { color:#203047; font-size:18px; line-height:24px; font-weight:600; }
.scene-entry-link { color:#1F5EA8; font-size:13px; line-height:20px; margin-top:6px; }
.menu-card { overflow:hidden; }
.menu-row { box-sizing:border-box; display:flex; align-items:center; gap:10px; min-height:52px; padding:10px 14px; }
.menu-row + .menu-row { border-top:1px solid #DCE5ED; }
.menu-row icon { flex:none; }
.menu-name { flex:1; min-width:0; font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.logout { box-sizing:border-box; display:flex; align-items:center; justify-content:center; min-height:44px; padding:16px 0; font-size:14px; line-height:22px; color:#53687B; }
@media(max-width:360px) { .assets-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .assets-grid .asset-physical { grid-column:1 / -1; } .assets-grid--stacked { grid-template-columns:minmax(0,1fr); } .scene-entry-copy { top:9px; } }

.page { background:#F3F6FA; color:#223247; }
.card,.menu-row + .menu-row { border-color:#DDE5EF; }
.assets-grid .asset-order { background:#EAF2FF; border-color:#DDE5EF; }
.assets-grid .asset-money-tone,.assets-grid .asset-physical { background:#FFFFFF; }
.asset-order .asset-icon,.asset-money-tone .asset-icon,.asset-physical .asset-icon { background:#EAF2FF; }
.asset-value,.quick-label,.scene-entry-title { color:#223247; }
.asset-label,.asset-unit,.asset-refresh-note { color:#5D6B7D; }
.asset-entry,.scene-entry-link { color:#1264D6; }
button.logout { width:auto; min-width:120px; min-height:48px; margin:20px auto 0; padding:8px 24px; color:#5D6B7D; background:#FFFFFF; border:1px solid #7C8A9C; }
