.page {
  min-height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 成功动画区 ========== */
.success-hero {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.success-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--success-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(5, 150, 105, 0.3);
}

.success-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(5, 150, 105, 0.2);
  animation: ring-expand 1.5s ease-out infinite;
}

@keyframes ring-expand {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}

.success-check {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
  margin-top: -4rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
}

/* ========== 常用订单区 ========== */
.template-section {
  width: 100%;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.template-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid #fff;
}

.template-card:active {
  transform: scale(0.98);
}

.template-card.saved {
  border-color: rgba(5, 150, 105, 0.3);
  background: #ffffff;
}

.template-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.template-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f59e0b;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.template-icon-wrap.saved {
  background: var(--success-color);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.3);
}

.template-icon {
  font-size: 36rpx;
}

.template-check {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}

.template-text {
  flex: 1;
}

.template-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.template-title.saved {
  color: var(--success-color);
}

.template-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.template-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
  margin-left: 12rpx;
}

/* ========== 操作按钮 ========== */
.actions {
  width: 100%;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
}

.action-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.action-card:active {
  transform: scale(0.96);
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-icon-wrap.primary {
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
}

.action-icon-wrap.secondary {
  background: #f97316;
  box-shadow: 0 6rpx 20rpx rgba(249, 115, 22, 0.3);
}

.action-icon-text {
  font-size: 40rpx;
}

.action-info {
  text-align: center;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

/* ========== 底部提示 ========== */
.bottom-tip {
  margin-top: auto;
  padding-bottom: 80rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* ========== 去支付按钮 ========== */
.pay-section {
  width: 100%;
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.pay-btn {
  width: 100%;
  height: 96rpx;
  background: #f59e0b;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 0, 0.35);
}

.pay-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.pay-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
