.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

.content {
  padding: 24rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 订单信息 */
.order-info .info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-info .info-row:last-child {
  border-bottom: none;
}
.info-row .label {
  font-size: 26rpx;
  color: #999;
}
.info-row .value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

/* 输入组 */
.input-group {
  margin-top: 8rpx;
}

.input-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.input-item {
  flex: 1;
}
.input-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.input-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  text-align: center;
}
.input-number {
  width: 100%;
  padding: 18rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.input-number:focus {
  border-color: #007aff;
  outline: none;
}

/* 差异显示 */
.discrepancy-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.discrepancy-display.normal {
  background: #f0f9ff;
  color: #007aff;
}
.discrepancy-display.short {
  background: #fff1f0;
  color: #ff4d4f;
}
.discrepancy-display.over {
  background: #f6ffed;
  color: #52c41a;
}
.discrepancy-label {
  font-size: 26rpx;
  font-weight: 500;
}
.discrepancy-value {
  font-size: 30rpx;
  font-weight: 700;
}
.discrepancy-desc {
  font-size: 24rpx;
  opacity: 0.8;
  margin-left: 8rpx;
}

/* 动作选项 */
.action-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.action-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
}
.action-option.selected {
  border-color: #007aff;
  background: #f0f9ff;
}
.action-main {
  flex: 1;
}
.action-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}
.action-desc {
  font-size: 24rpx;
  color: #999;
}
.action-radio {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  position: relative;
}
.action-radio.checked {
  border-color: #007aff;
}
.action-radio.checked::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 12rpx;
  height: 12rpx;
  background: #007aff;
  border-radius: 50%;
}

/* 给水详情 */
.owe-tip {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #ad6800;
}

/* 备注 */
.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-family: inherit;
  resize: vertical;
}
.textarea:focus {
  border-color: #007aff;
  outline: none;
}
.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ccc;
}

/* 提交区域 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #007aff;
  border: none;
  border-radius: 12rpx;
}
.submit-btn.disabled {
  background: #ccc;
}

/* 模态框 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal {
  width: 90%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}
.modal-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
  margin-bottom: 28rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}
.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}
.modal-btn.confirm {
  background: #007aff;
  color: #fff;
}