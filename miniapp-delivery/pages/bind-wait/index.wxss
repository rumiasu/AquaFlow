.container {
  min-height: 100vh;
  padding: 48rpx 24rpx;
  background: var(--bg-color);
  box-sizing: border-box;
  text-align: left;
}

.empty-illustration {
  margin-bottom: 0;
}


.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.status-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
  text-align: left;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.status-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.status-pending {
  color: var(--warning-color);
  font-weight: 500;
}

.btn-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.btn-primary,
.btn-outline {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
  border: none;
}

.btn-outline {
  background: #ffffff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.tip-row {
  padding: 24rpx 32rpx;
  background: var(--warning-bg);
  border-radius: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--warning-color);
  line-height: 1.6;
}

/* 退出出口：PENDING_UNBIND 时撤回被禁用，没有它用户只能干等站长 */
.logout-row {
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #DAE0E8;
  background: #ffffff;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-color: var(--border-color);
}
.logout-row:active { opacity: 0.8; }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.btn-primary, .btn-outline { height: auto; min-height: 96rpx; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; flex: 1 1 240rpx; }
