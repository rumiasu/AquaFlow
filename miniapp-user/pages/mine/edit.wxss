.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx;
  box-sizing: border-box;
}

.form-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  margin-bottom: 32rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 104rpx;
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  flex-shrink: 0;
  font-weight: 500;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: left;
  min-width: 0;
  min-height: 88rpx;
}

.submit-btn {
  margin-top: 24rpx;
  height: auto;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none; min-height:44px; display:flex; align-items:center; justify-content:center; }

.submit-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}


.page-intro { padding: 4rpx 0 24rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.save-error { font-size: 28rpx; line-height: 1.65; color: var(--text-regular); background: var(--bg-gray); padding: 24rpx; border-radius: 12rpx; border-left: 4rpx solid var(--error-color); }
.submit-btn.disabled { background: var(--bg-gray); }
.submit-btn.disabled text { color: var(--text-regular); }

.draft-notice { margin-bottom: 24rpx; }
.draft-notice .af-action { margin: 6px 8px 0 0; }

.container > .af-action--block { margin-top: 16px; }

/* Visual v2: page hierarchy and semantic surfaces. */
.form-section { border-radius:14px; }
.form-item { min-height:52px; }
.form-input { min-height:44px; box-sizing:border-box; }
