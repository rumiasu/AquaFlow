.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }

.summary-card { background: var(--primary-gradient); border-radius: 12rpx; padding: 32rpx 24rpx; display: flex; margin-bottom: 24rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}
.summary-item { flex: 1; text-align: center; }
.summary-num { display: block; font-size: 44rpx; font-weight: 700; color: #fff; }
.summary-num.warn { color: var(--af-soft); }
.summary-label { display: block; font-size: 24rpx; color: rgba(255,255,255,.75); margin-top: 6rpx; }

.record-card { background: var(--bg-card); border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}
.record-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.record-customer { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.record-time { font-size: 24rpx; color: var(--text-regular); }
.record-address { font-size: 32rpx; color: var(--text-primary); margin-bottom: 8rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.record-meta { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--text-regular); flex-wrap: wrap;
  padding: 16rpx 0;
}
.meta-divider { color: var(--border-color); }
.record-bottom { margin-top: 12rpx; display: flex; flex-direction: column; gap: 6rpx; }
.discrepancy-tag { font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 8rpx; display: inline-block; align-self: flex-start; }
.discrepancy-tag.owe { background: var(--af-soft); color: var(--af-text-secondary); }
.discrepancy-tag.extra { background: var(--primary-bg); color: var(--primary-color); }
.discrepancy-note { font-size: 28rpx; color: var(--text-secondary);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

/* 2026-10-02：失败状态常驻，刷新失败时旧记录不能冒充本次结果。 */
.page-state { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 12rpx; text-align: center;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}
.page-state-text { display: block; font-size: 28rpx; color: var(--text-regular); line-height: 1.6; }
.page-state-error { color: var(--error-color); }
.page-state-retry { margin-top: 20rpx; font-size: 28rpx; color: #fff; background: var(--primary-color); }

.meta-bucket { font-size: 28rpx; }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.page-state-retry { height: auto; min-height: 96rpx; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.record-bottom { flex-wrap: wrap; gap: 12rpx; }

.summary-card { background: #fff; }
.summary-num { color: var(--primary-color); }
.summary-num.warn { color: var(--af-text-secondary); }
.summary-label { font-size: 26rpx; color: var(--text-regular); }
.summary-item { min-width: 0; overflow-wrap: anywhere; }

/* 2026-10-28：本页信息层级、小屏长字与触控下限；业务语义由原数据决定。 */
button:not(.af-action):not(.af-choice) { min-height:44px; height:auto; line-height:1.45; white-space:normal; box-sizing:border-box; }
.btn-primary,.primary-button,.btn-confirm { min-height:48px; }

.summary-card { flex-wrap:wrap; gap:16px; }
.summary-item { min-width:110px; flex:1 1 110px; }
.summary-label,.known-scope { font-size:14px; line-height:1.5; }
.known-scope { display:block; padding:10px 0 16px; color:#526276; }
.record-top { flex-wrap:wrap; gap:8px; }
.record-customer,.record-address,.meta-bucket { overflow-wrap:anywhere; }
.record-meta { flex-wrap:wrap; gap:8px; }
.discrepancy-tag.unknown { color:#526276; background:#edf2f7; }
.record-time,.discrepancy-note { font-size:14px; line-height:1.6; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-barrels { padding:20px 16px; }
.lv2-barrels .summary-card { margin:0 0 16px; padding:8px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:8px; background:var(--af2-surface-physical); border:0; border-radius:16px; }
.lv2-barrels .summary-item { padding:10px; min-width:0; border:0; }
.lv2-barrels .summary-num { font-size:26px; line-height:34px; color:var(--af2-ink-physical); font-weight:600; }
.lv2-barrels .summary-label { font-size:12px; line-height:20px; color:var(--af2-ink-physical); }
.lv2-barrels .record-list { padding:0 16px; background:var(--af2-surface); border-radius:16px; }
.lv2-barrels .record-card { border:0; border-bottom:1px solid var(--af2-line); box-shadow:none; border-radius:0; padding:16px 0; margin:0; }
.lv2-barrels .record-customer { font-size:15px; line-height:23px; }
.lv2-barrels .record-time, .lv2-barrels .record-meta, .lv2-barrels .known-scope { font-size:13px; line-height:21px; }
.lv2-barrels .record-address { font-size:14px; line-height:22px; }
.lv2-barrels .empty { display:flex; flex-direction:column; align-items:center; gap:12px; padding:40px 16px; font-size:15px; }
.lv2-barrels .summary-num, .lv2-barrels .record-customer, .lv2-barrels .record-address { min-width:0; max-width:100%; white-space:normal; overflow-wrap:anywhere; word-break:break-all; }
