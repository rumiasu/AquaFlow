.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }

/* 口径说明：讲清"这里是什么、这里能做什么" */
.hint {
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.fb-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.who {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.time { font-size: 24rpx; color: var(--text-placeholder); }

/* 分类标签：文字就是后端字段原文，颜色只做视觉区分，不参与逻辑判断 */
.category {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--primary-bg);
  color: var(--primary-color);
  margin-bottom: 12rpx;
}

.content {
  display: block;
  font-size: 25rpx;
  color: var(--text-regular);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.refund-note-form { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border-light); }
.refund-note-form textarea { width: 100%; box-sizing: border-box; min-height: 140rpx; margin: 16rpx 0; padding: 16rpx; font-size: 26rpx; background: var(--bg-color); }

.card-foot {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.foot-item { font-size: 24rpx; color: var(--text-secondary); }
.foot-item.muted { color: var(--text-placeholder); }

/* 四种状态（加载中 / 失败 / 空 / 有数据）共用容器，但文案由 js 分派，样式不表达数据是否存在 */
.state { text-align: center; padding: 100rpx 24rpx; }
.state-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.state-msg {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--error-color);
  line-height: 1.6;
  word-break: break-all;
}
.state-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-placeholder);
  line-height: 1.6;
}
.state.error { padding-top: 80rpx; }

.retry-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 26rpx;
}

/* .empty 保留给"权限不足"分支（它不该长得像"没有数据"，用同一个居中文案块即可） */
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.work-head { padding: 8rpx 4rpx 24rpx; }
.work-title { display:block; font-size:38rpx; font-weight:700; line-height:1.4; color:var(--text-primary); }
.work-desc { display:block; margin-top:8rpx; font-size:26rpx; line-height:1.6; color:var(--text-regular); }

.container { box-sizing:border-box; }
.hint { font-size:26rpx; line-height:1.6; color:var(--text-regular); padding:20rpx; background:var(--bg-color); border-left:4rpx solid var(--border-color); }
.fb-card { border-radius:12rpx; border:1rpx solid var(--border-color); box-shadow:none; }
.card-head,.card-foot { flex-wrap:wrap; gap:12rpx; }
.who { font-size:32rpx; }
.content { font-size:30rpx; line-height:1.7; color:var(--text-primary); overflow-wrap:break-word; }
.time,.foot-item,.state-hint { font-size:26rpx; color:var(--text-regular); line-height:1.6; }
.category { font-size:28rpx; border-radius:6rpx; }
.fb-card button,.retry-btn { min-height:96rpx; height:auto; line-height:1.5; padding:20rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:10rpx; font-size:28rpx; }
.fb-card textarea { width:100%; box-sizing:border-box; padding:20rpx; border:1rpx solid var(--border-color); background:var(--bg-color); border-radius:10rpx; font-size:30rpx; line-height:1.6; }
.refund-note-form { margin-top:20rpx; padding-top:20rpx; border-top:1rpx solid var(--border-color); }
