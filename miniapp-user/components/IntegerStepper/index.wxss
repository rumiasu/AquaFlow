@import "../../styles/actions.wxss";
:host { display:block; width:100%; min-width:0; }
.integer-row { display:flex; align-items:center; width:100%; border:1px solid var(--af-border); border-radius:8px; background:var(--af-surface); box-sizing:border-box; }
.step-button { flex:none; width:48px; min-width:48px; min-height:48px; margin:0; padding:0; display:flex; align-items:center; justify-content:center; font-size:24px; line-height:1.4; color:var(--af-primary); background:var(--af-soft); border-radius:6px; }
.step-button::after { border:none; }
.step-button[disabled] { color:var(--af-disabled-text); background:var(--af-disabled-bg); opacity:1; }
.integer-input { flex:1; width:0; min-width:0; height:48px; text-align:center; font-size:16px; color:var(--af-ink); }
.input-error { display:block; margin-top:8rpx; font-size:14px; line-height:1.6; color:var(--af-danger); }
