/* 资产调整单详情。单位一律 rpx；.container / .card 沿用 app.wxss 既有类，不重复定义 */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.head-left { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.adjust-no { font-size: 30rpx; font-weight: 700; color: var(--text-primary); word-break: break-all; }
.adjust-type { font-size: 26rpx; color: var(--primary-color); }

/* 状态色：文案用后端下发的 statusText，这里只管配色 */
.status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.status.pending { background: var(--warning-bg); color: var(--warning-color); }
.status.effective { background: var(--success-bg); color: var(--success-color); }
.status.muted { background: var(--bg-gray); color: var(--text-secondary); }

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  font-size: 26rpx;
  padding: 12rpx 0;
}
.row .label { color: var(--text-secondary); flex-shrink: 0; }
.row .value { color: var(--text-primary); text-align: right; word-break: break-all; }
.row .value.strong { font-weight: 600; color: var(--primary-color); font-size: 30rpx; }
.row .value.link { color: var(--primary-color); text-decoration: underline; }

.reason { font-size: 26rpx; color: var(--text-primary); line-height: 1.7; word-break: break-all; }

.evidence-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.evidence-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: var(--bg-gray); }

.snap-head, .snap-row { display: flex; align-items: center; padding: 14rpx 0; font-size: 26rpx; }
.snap-head { color: var(--text-secondary); font-size: 24rpx; border-bottom: 1rpx solid var(--border-light); }
.snap-row { border-bottom: 1rpx solid var(--border-light); }
.col { flex: 1; text-align: center; color: var(--text-primary); }
.col-name { flex: 1.2; text-align: left; color: var(--text-regular); }
.col.after { font-weight: 600; color: var(--primary-color); }

.raw-block { margin-bottom: 16rpx; }
.raw-label { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.raw-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-regular);
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  word-break: break-all;
  line-height: 1.6;
}

.footer { margin: 0 24rpx; }
.btn-main, .btn-danger {
  height: 92rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
}
.btn-main { background: var(--primary-gradient); color: #fff; }
.btn-danger { background: #fff; color: var(--error-color); border: 2rpx solid var(--error-color); }
.footer-tip {
  margin: 8rpx 24rpx 60rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
}

.denied, .loading, .empty {
  text-align: center;
  padding: 140rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { box-sizing:border-box; }
.card { border-radius:12rpx; border:1rpx solid var(--border-color); box-shadow:none; }
.card-title { border-left:0; padding-left:0; line-height:1.5; font-size:30rpx; }
.row { font-size:28rpx; gap:20rpx; }
.row .label { color:var(--text-regular); white-space:normal; max-width:44%; }
.row .value { min-width:0; overflow-wrap:anywhere; }
.row .value.strong { font-size:36rpx; }
.snap-head,.snap-row { font-size:28rpx; gap:12rpx; }
.col { min-width:0; overflow-wrap:anywhere; }
.raw-toggle { min-height:88rpx; display:flex; justify-content:space-between; align-items:center; font-size:28rpx; color:var(--primary-color); gap:20rpx; }
.raw-text { font-size:25rpx; line-height:1.7; overflow-wrap:anywhere; }
.btn-main,.btn-danger { min-height:104rpx; box-sizing:border-box; border-radius:10rpx; display:flex; justify-content:center; align-items:center; padding:20rpx; font-size: 14px; line-height:1.5; }
.footer-tip { font-size:28rpx; line-height:1.6; }

.footer .btn-main,.footer .btn-danger { white-space:normal; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .head { padding:16px; border-radius:14px; background:var(--af2-surface-current); } .head-left,.head .status { color:var(--af2-ink-current); } .snap-head { background:var(--af2-surface-neutral); color:var(--af2-ink-neutral); border-radius:8px; } .snap-row { border-bottom:1px solid var(--af-border); } .card { border-radius:14px; box-shadow:none; }
