<view class="page">
  <view class="order-summary">
    <view class="summary-title-row">
      <view class="summary-icon"><icon name="droplet" size="40rpx" color="#0EA5E9" /></view>
      <text class="summary-title">订单商品</text>
    </view>
    <view class="items-list">
      <view class="item-row" wx:for="{{items}}" wx:key="productId">
        <view class="item-info">
          <text class="item-name">{{item.productName || item.waterTypeName}} {{item.productSpec || item.waterTypeSpec}}</text>
        </view>
        <text class="item-qty">×{{item.quantity}}桶</text>
      </view>
    </view>
    <view class="summary-addr">
      <icon name="location" size="32rpx" color="#94A3B8" />
      <text class="addr-text">{{addressDetail}}</text>
    </view>
    <view class="summary-barrel" wx:if="{{totalAsset > 0 || totalNeeded > 0 || extraDepositBuckets > 0}}">
      <icon name="barrel" size="32rpx" color="#0EA5E9" />
      <text class="barrel-text">长期桶资产{{totalAsset}}桶 / 本次需要{{totalNeeded}}桶{{extraDepositBuckets > 0 ? '，缺' + extraDepositBuckets + '桶需押' : ''}}</text>
    </view>
  </view>

  <view class="amount-card">
    <view class="amount-row">
      <text class="amount-label">水费</text>
      <view class="amount-value">
        <text class="amount-symbol">¥</text>
        <text class="amount-num-small">{{waterCost}}</text>
      </view>
    </view>
    <view class="amount-row" wx:if="{{extraDepositBuckets > 0}}">
      <text class="amount-label">额外桶押金</text>
      <view class="amount-value">
        <text class="amount-symbol">¥</text>
        <text class="amount-num-small">{{extraDepositAmount}}</text>
        <text class="amount-detail">（缺 {{extraDepositBuckets}} 桶）</text>
      </view>
    </view>
    <view class="amount-row" wx:if="{{totalAsset > 0 && extraDepositBuckets == 0}}">
      <text class="amount-label">持有桶抵扣</text>
      <text class="amount-hint">{{totalAsset}}桶可覆盖本次{{totalNeeded}}桶</text>
    </view>
    <view class="amount-divider"></view>
    <view class="amount-row total">
      <text class="amount-label">合计</text>
      <view class="amount-value">
        <text class="amount-symbol">¥</text>
        <text class="amount-num">{{totalAmount}}</text>
      </view>
    </view>
  </view>

  <view class="extra-deposit-card" wx:if="{{extraDepositBuckets > 0 && extraDepositAmount > 0}}">
    <view class="deposit-header">
      <icon name="barrel" size="36rpx" color="#F59E0B" />
      <text class="deposit-title">额外桶押金确认</text>
    </view>
    <text class="deposit-text">缺 {{extraDepositBuckets}} 桶，需额外支付桶押金 ¥{{extraDepositAmount}}，押金将计入您的桶资产，退桶时退还。</text>
    <view class="deposit-check-row">
      <checkbox-group bindchange="onToggleExtraDepositConfirm">
        <label class="checkbox-label">
          <checkbox value="1" checked="{{extraDepositConfirmed}}" color="#0EA5E9"/>
          <text>我确认需支付额外桶押金</text>
        </label>
      </checkbox-group>
    </view>
  </view>

  <view class="pay-section">
    <text class="section-title">选择支付方式</text>
    <view class="method-list">
      <view
        class="method-item {{selectedMethod === item.id ? 'active' : ''}}"
        wx:for="{{methods}}"
        wx:key="id"
        bindtap="onSelectMethod"
        data-id="{{item.id}}"
      >
        <view class="method-left">
          <view class="method-icon"><icon name="{{item.icon}}" size="40rpx" color="#0EA5E9" /></view>
          <view class="method-text">
            <text class="method-name">{{item.name}}</text>
            <text class="method-desc" wx:if="{{item.id === 3}}">
              可用余额：
              <block wx:for="{{items}}" wx:key="productId">
                {{item.productName || item.waterTypeName}} {{ticketBalanceByProduct[item.productId] || 0}}张
                <text wx:if="{{index < items.length - 1}}">、</text>
              </block>
            </text>
            <text class="method-desc" wx:else>{{item.desc}}</text>
          </view>
        </view>
        <view class="method-check" wx:if="{{selectedMethod === item.id}}">
          <icon name="check" size="28rpx" color="#FFFFFF" />
        </view>
      </view>
    </view>
  </view>

  <view class="submit-bar">
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      <text>{{submitting ? '提交中...' : '确认下单'}}</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showOfflineConfirm}}" bindtap="onOfflineConfirmCancel"></view>
  <view class="modal-content {{showOfflineConfirm ? 'show' : ''}}" catchtap="">
    <view class="modal-header">
      <text class="modal-title">线下付款确认</text>
    </view>
    <view class="modal-body offline-body">
      <view class="offline-icon-wrap">
        <icon name="wallet" size="64rpx" color="#0EA5E9" />
      </view>
      <text class="offline-text">请与配送员确认付款方式及金额</text>
      <text class="offline-sub">您可以选择现金、银行转账、微信/支付宝转账等方式向配送员支付</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onOfflineConfirmCancel">
        <text>取消</text>
      </view>
      <view class="modal-btn confirm" bindtap="onOfflineConfirmOk">
        <text>我确认</text>
      </view>
    </view>
  </view>
</view>
