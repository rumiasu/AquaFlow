<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <view class="ticket-content" wx:else>
    <!-- 可用水票卡片 -->
    <view class="ticket-balance-card">
      <view class="balance-left">
        <text class="balance-label">可用水票</text>
        <view class="balance-amount">
          <text class="balance-count">{{totalTickets}}</text>
          <text class="balance-unit">张</text>
        </view>
        <text class="balance-total" wx:if="{{totalValue > 0}}">共计 ¥{{totalValue}}</text>
      </view>
      <view class="balance-icon"><icon name="ticket" size="56rpx" color="rgba(255,255,255,0.9)" /></view>
    </view>

    <!-- 标签切换 -->
    <view class="tabs">
      <view
        class="tab-item {{currentTab === item.id ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="id"
        bindtap="onTabChange"
        data-id="{{item.id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- 水票明细 -->
    <view class="tab-content" wx:if="{{currentTab === 0}}">
      <view class="section-title">水票明细</view>
      <view class="ticket-list">
        <view class="ticket-item" wx:for="{{accounts}}" wx:key="id">
          <view class="ticket-info">
            <text class="ticket-name">{{item.productName || item.waterTypeName}}</text>
            <text class="ticket-spec" wx:if="{{item.productSpec || item.waterTypeSpec}}">{{item.productSpec || item.waterTypeSpec}}</text>
            <text class="ticket-expire" wx:if="{{item.expireTime}}">有效期至 {{item.expireTime}}</text>
          </view>
          <view class="ticket-quantity">
            <text class="quantity-value">{{item.remainQuantity}}</text>
            <text class="quantity-unit">张</text>
          </view>
        </view>
        <empty wx:if="{{accounts.length === 0}}" text="暂无水票"></empty>
      </view>
    </view>

    <!-- 消费记录 -->
    <view class="tab-content" wx:if="{{currentTab === 1}}">
      <view class="section-title">消费记录</view>
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-info">
            <text class="record-name">{{item.productName || item.waterTypeName}}</text>
            <text class="record-time">{{item.createTime}}</text>
          </view>
          <view class="record-quantity">
            <text class="quantity-change {{item.increaseQty > 0 ? 'increase' : 'decrease'}}">
              {{item.increaseQty > 0 ? '+' : ''}}{{item.increaseQty > 0 ? item.increaseQty : -item.decreaseQty}}
            </text>
          </view>
        </view>
        <empty wx:if="{{records.length === 0}}" text="暂无记录"></empty>
      </view>
    </view>

    <!-- 购买水票按钮 -->
    <view class="buy-ticket-section">
      <view class="buy-ticket-btn" bindtap="onShowPurchase">
        <text>购买水票</text>
      </view>
    </view>
  </view>

  <!-- 购买水票弹窗 -->
  <view class="modal-mask" wx:if="{{showPurchase}}" bindtap="onClosePurchase"></view>
  <view class="modal-body {{showPurchase ? 'show' : ''}}" wx:if="{{showPurchase}}" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">购买水票</text>
      <text class="modal-close" bindtap="onClosePurchase">×</text>
    </view>

    <scroll-view scroll-y class="modal-scroll">
      <!-- 选择商品 -->
      <text class="modal-label">选择商品</text>
      <view class="product-list">
        <view
          class="product-item {{buyForm.productId === item.id ? 'active' : ''}}"
          wx:for="{{buyProducts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onBuyProductSelect"
        >
          <text class="product-name">{{item.name}}</text>
          <!-- 面值 = 本站水票价（后端 effectiveTicketPrice），与扣款同源 -->
          <text class="product-price" wx:if="{{item.effectiveTicketPrice}}">¥{{item.effectiveTicketPrice}}/张</text>
        </view>
      </view>

      <!-- 水票档位（价目表）：站长挂了档位才出现，没挂就照旧散买。
           总价与均价全部用服务端下发的值，这里不做 price/qty 的算术。 -->
      <block wx:if="{{buyPackages.length}}">
        <text class="modal-label">按档位买（越买越便宜）</text>
        <view class="pkg-list">
          <view
            class="pkg-item {{buyForm.packageId === item.id ? 'active' : ''}}"
            wx:for="{{buyPackages}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onBuyPackageSelect"
          >
            <text class="pkg-title">{{item.title || item.qty + ' 张'}}</text>
            <text class="pkg-price">¥{{item.price}}</text>
            <text class="pkg-sub">{{item.qty}} 张 · 均价 ¥{{item.unitPrice}}/张</text>
          </view>
        </view>
        <view class="pkg-clear" bindtap="onBuyPackageClear">
          {{buyForm.packageId ? '不按档位，改为散买' : '当前：按单张散买'}}
        </view>
      </block>

      <!-- 数量 -->
      <text class="modal-label">购买数量</text>
      <view class="qty-row">
        <view class="qty-btn {{buyForm.quantity <= 1 ? 'disabled' : ''}}" bindtap="onBuyQtyStep" data-type="minus">
          <text>-</text>
        </view>
        <input class="qty-input" type="number" value="{{buyForm.quantity}}" bindinput="onBuyQuantityInput" />
        <view class="qty-btn" bindtap="onBuyQtyStep" data-type="add">
          <text>+</text>
        </view>
      </view>
      <text class="pkg-lock" wx:if="{{buyForm.packageId}}">
        已按档位锁定张数；改数量会自动退回「按单张散买」。
      </text>

      <!-- 支付方式 -->
      <text class="modal-label">支付方式</text>
      <view class="method-list">
        <view
          class="method-item {{buyForm.paymentMethod === item.id ? 'active' : ''}}"
          wx:for="{{buyMethods}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onBuyPaymentMethodSelect"
        >
          <view class="method-info">
            <text class="method-name">{{item.name}}</text>
            <text class="method-desc">{{item.desc}}</text>
          </view>
          <view class="method-radio {{buyForm.paymentMethod === item.id ? 'checked' : ''}}"></view>
        </view>
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onClosePurchase">
        <text>取消</text>
      </view>
      <view class="modal-btn confirm {{submitting ? 'disabled' : ''}}" bindtap="onBuySubmit">
        <text>{{submitting ? '购买中...' : '确认购买 ¥' + buyForm.totalPrice}}</text>
      </view>
    </view>
  </view>
</view>
