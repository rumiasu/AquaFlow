.container {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  background: #f7f9fc;
  box-sizing: border-box;
  text-align: center;
}

.empty-illustration {
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 160rpx;
  display: inline-block;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 64rpx;
}

.status-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 40rpx;
  margin-bottom: 64rpx;
  text-align: left;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #888888;
}

.status-value {
  font-size: 28rpx;
  color: #1a1a1a;
}

.status-pending {
  color: #FF9500;
  font-weight: 500;
}

.btn-wrap {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.btn-primary,
.btn-outline {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: #4F8EF7;
  color: #ffffff;
  border: none;
}

.btn-outline {
  background: #ffffff;
  color: #4F8EF7;
  border: 2rpx solid #4F8EF7;
}

.tip-row {
  padding: 24rpx 32rpx;
  background: #FFF6E6;
  border-radius: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #B8860B;
  line-height: 1.6;
}

/* 退出出口：PENDING_UNBIND 时撤回被禁用，没有它用户只能干等站长 */
.logout-row {
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e5ea;
  background: #ffffff;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
.logout-row:active { opacity: 0.8; }
