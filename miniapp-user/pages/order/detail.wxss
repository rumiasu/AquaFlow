.page-container { padding: 20rpx; }
.status-card {
  background: #fff; border-radius: 16rpx; padding: 32rpx;
  margin-bottom: 20rpx; text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.status-card.status-1 { border-left: 8rpx solid #fa8c16; }
.status-card.status-2 { border-left: 8rpx solid #1890ff; }
.status-card.status-3 { border-left: 8rpx solid #52c41a; }
.status-card.status-4 { border-left: 8rpx solid #722ed1; }
.status-card.status-5 { border-left: 8rpx solid #f5222d; }
.status-main { font-size: 36rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.status-sub { font-size: 26rpx; color: #999; }
.pay-badge {
  display: inline-block; background: #f6ffed; color: #52c41a;
  padding: 2rpx 12rpx; border-radius: 6rpx; font-size: 24rpx;
}
.info-section {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-title {
  font-size: 30rpx; font-weight: 600; color: #333;
  margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #f0f0f0;
}
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10rpx 0;
}
.label { font-size: 28rpx; color: #999; }
.value { font-size: 28rpx; color: #333; }
.action-section {
  display: flex; flex-direction: column; gap: 16rpx; margin-top: 30rpx;
}
.btn-action {
  border-radius: 40rpx; font-size: 30rpx; padding: 20rpx 0;
  text-align: center; border: none;
}
.btn-cancel { background: #fff1f0; color: #f5222d; }
.btn-reorder { background: #e6f7ff; color: #1890ff; }
.btn-call { background: #f6ffed; color: #52c41a; }
