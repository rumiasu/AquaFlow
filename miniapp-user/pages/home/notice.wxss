.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding: 24rpx;
}

.notice-detail {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.notice-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.notice-content {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.8;
}

/* 2026-10-02：失败状态常驻，刷新失败时旧记录不能冒充本次结果。 */
.page-state { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; text-align: center; }
.page-state-text { display: block; font-size: 28rpx; color: var(--text-regular); line-height: 1.6; }
.page-state-error { color: var(--error-color); }
.page-state-retry { margin-top: 20rpx; font-size: 28rpx; color: #fff; background: var(--primary-color); }
