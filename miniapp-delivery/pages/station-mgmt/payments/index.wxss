.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }
.record-card { background: var(--bg-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-header { margin-bottom: 12rpx; display: flex; align-items: center; gap: 12rpx; }
.status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; display: inline-block; }
.status.pending { background: var(--warning-bg); color: var(--warning-color); }
.status.ticket { background: var(--primary-bg); color: var(--primary-color); }
.info-row { font-size: 26rpx; color: var(--text-primary); margin-bottom: 8rpx; display: flex; justify-content: space-between; }
.info-row .label { color: var(--text-secondary); }
.info-row .amount { font-weight: 700; }
.card-actions { margin-top: 16rpx; display: flex; gap: 16rpx; }
.btn-confirm { flex: 1; padding: 16rpx; border-radius: 12rpx; font-size: 26rpx; border: none; background: var(--primary-gradient); color: #fff; }
.hint { font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; padding: 8rpx 4rpx 20rpx; }
/* 加载失败提示条（[2026-09-27 走查 U01 同族]）：常驻到重试成功为止，不是一闪而过的 toast */
.load-error { background: var(--warning-bg); border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; font-size: 24rpx; color: var(--warning-color); line-height: 1.6; }
.load-error-retry { display: block; margin-top: 12rpx; color: var(--warning-color); font-weight: 700; }
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }

.history-controls { margin:20rpx 0; padding:20rpx; background:#fff; border-radius:16rpx; }
.history-search-row,.history-date-row,.history-selected { display:flex; gap:16rpx; align-items:center; flex-wrap:wrap; }
.history-search-row input { flex:1; min-width:180rpx; height:76rpx; }
.history-search-row button { margin:0; flex-shrink:0; }
.history-date-row { margin-top:20rpx; font-size:24rpx; }
.history-date-row picker { padding:16rpx; background:var(--primary-bg); border-radius:12rpx; }
.history-customer-row { padding:20rpx 0; border-bottom:1rpx solid var(--primary-bg); }
.history-customer-row text { display:block; color:var(--text-secondary); font-size:24rpx; }
.history-selected { padding:16rpx 0; font-size:24rpx; }.history-selected text { color:var(--primary-color); }
.history-scope { font-size:24rpx; line-height:1.6; color:var(--text-secondary); margin-top:14rpx; }
.history-error { color:var(--warning-color); padding:20rpx 0; }.history-more { padding:28rpx; text-align:center; color:var(--primary-color); }
.history-tabs { display:flex; gap:20rpx; padding:20rpx 0; font-size:26rpx; }.history-tabs .active { color:var(--primary-color); font-weight:600; }
