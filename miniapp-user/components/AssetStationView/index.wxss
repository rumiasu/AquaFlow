.scope-card { margin: 20rpx 0; padding: 20rpx 24rpx; background: var(--bg-card); border: 1rpx solid var(--border-color); border-radius: var(--radius-lg); }
.scope-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; }
.scope-badge { padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--primary-bg); color: var(--primary-color); font-size: 26rpx; line-height: 1.5; }
.scope-row { display: flex; align-items: center; gap: 20rpx; }
.scope-main, .picker-main { flex: 1; min-width: 0; }
.scope-caption { font-size: 30rpx; color: var(--text-regular); }
.scope-name { display: block; font-size: 34rpx; font-weight: 600; line-height: 1.4; color: var(--text-primary); overflow-wrap: break-word; }
.scope-switch { flex-shrink: 0; color: var(--primary-color); font-size: 34rpx; padding: 12rpx 0; min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }
.scope-context { display: block; margin-top: 4rpx; font-size: 28rpx; line-height: 1.5; color: var(--text-secondary); }
.scope-tip, .scope-order { display: block; font-size: 34rpx; line-height: 1.6; color: var(--text-regular); margin-top: 8rpx; overflow-wrap: break-word; }
.scope-status { display: block; font-size: 30rpx; line-height: 1.6; color: var(--text-regular); margin-top: 8rpx; overflow-wrap: break-word; }
.picker-scope { padding: 0 16rpx 16rpx; margin-bottom: 12rpx; border-radius: 12rpx; background: var(--bg-gray); }
.picker-mask { position: fixed; inset: 0; z-index: 1100; background: rgba(0,0,0,.4); }
.picker { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1101; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: var(--bg-card); }
.picker-head { display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 34rpx; gap: 16rpx; }
.picker-close { margin: 0; padding: 0 16rpx; font-size: 30rpx; line-height: 64rpx; background: transparent; color: var(--text-regular); white-space: nowrap; }
.picker-close::after, .picker-retry::after { border: 0; }
.picker-tip { display: block; margin: 16rpx 0; color: var(--text-regular); font-size: 30rpx; line-height: 1.6; }
.picker-list { height: 55vh; }
.picker-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 16rpx; border-bottom: 1rpx solid var(--border-color); }
.picker-row.selected { background: var(--bg-gray); border-radius: 12rpx; }
.picker-name { display: block; font-size: 34rpx; overflow-wrap: break-word; }
.picker-status, .picker-selected { display: block; font-size: 30rpx; color: var(--text-regular); margin-top: 8rpx; }
.picker-selected { flex-shrink: 0; color: var(--primary-color); }
/* 2026-10-12：原 26rpx 状态文案在 320px 仅约 11px；增大后显式允许换行，避免长站点错误挤压。 */
.picker-message { display: block; padding: 28rpx 8rpx; font-size: 34rpx; color: var(--text-regular); line-height: 1.7; white-space: normal; overflow-wrap: break-word; }
.picker-retry { margin-top: 20rpx; font-size: 34rpx; color: var(--primary-color); background: var(--bg-gray); }

.picker-close { min-height: 88rpx; display: flex; align-items: center; box-sizing: border-box; }
.picker { border-radius: 20rpx 20rpx 0 0; }

/* 弹层不进入胶囊区；小屏触控尺寸不随rpx缩小。 */
.picker { box-sizing: border-box; max-height: calc(100vh - env(safe-area-inset-top) - 88px); display: flex; flex-direction: column; }
.picker-list { min-height: 0; flex-shrink: 1; }
.scope-row, .picker-row { min-height: 48px; }
.picker-close, .picker-retry { min-height: 44px; min-width: 44px; }
.picker-processing { display: block; color: var(--text-regular); font-size: 28rpx; line-height: 1.6; margin: 0 8rpx 16rpx; }
