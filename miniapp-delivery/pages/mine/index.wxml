<view class="container custom-tabbar-page b2-page b2-d11">
  <!-- 蓝色头部 -->
  <view class="header">
    <view class="user-row" bindtap="{{isLogin ? 'onEditProfile' : 'onLogin'}}">
      <image class="avatar" src="{{isLogin && userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/image/default-avatar.png'}}" mode="aspectFill" binderror="onDisplayImageError" data-src="{{isLogin && userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/image/default-avatar.png'}}" wx:if="{{!displayImageErrors[isLogin && userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/image/default-avatar.png']}}" /><view class="avatar ui-image-fallback" wx:else>员工</view>
      <view class="user-info">
        <view class="user-nick-wrap">
          <text class="nickname">{{isLogin ? (userInfo.nickname || userInfo.nickName || roleLabel || '员工') : '点击登录'}}</text>
          <text class="role-chip role-{{isManager ? 'manager' : 'delivery'}}" wx:if="{{isLogin && (isManager || isDelivery) && (userInfo.nickname || userInfo.nickName) && (userInfo.nickname || userInfo.nickName) !== roleLabel}}">{{roleLabel}}</text>
        </view>
        <view class="bind-status" wx:if="{{isLogin && isDelivery}}">
          <text class="bind-dot bind-{{bindStatus}}"></text>
          <text class="bind-text">{{bindStatusText}}</text>
        </view>
        <view class="bind-status bind-ok" wx:if="{{isLogin && isManager && stationInfo}}">
          <text class="bind-dot bind-BOUND"></text>
          <text class="bind-text">{{stationInfo.name || '我的水站'}}</text>
        </view>
      </view>
      <text class="arrow" wx:if="{{isLogin}}">></text>
    </view>

    <!-- 站长模式入口（高亮） -->
    <view class="manager-entry-card v2-manager-entry" bindtap="onGoStationMgmt" hover-class="station-entry-pressed" wx:if="{{isLogin && isManager}}" aria-role="button" aria-label="进入工作台">
      <icon name="products" variant="duotone" size="28px" color="#1264D6" /><text class="manager-entry-title">工作台</text><text class="manager-entry-arrow" aria-hidden="true">›</text>
    </view>
  </view>

  <!-- 配送员绑定操作 -->
  <view class="bind-action-card {{bindStatus === 'BOUND' ? 'bind-action-compact' : ''}}" wx:if="{{isLogin && isDelivery}}">
    <block wx:if="{{bindStatus === 'BOUND'}}">
      <view class="bind-info-line">
        <text class="bind-info-label">当前水站</text>
        <text class="bind-info-value">{{userInfo.stationName || '已绑定'}}</text>
      </view>
      <view class="bind-actions-row">
        <button bindtap="onApplyUnbind" class="af-action af-action--quiet"><view class="af-action__face">申请解绑</view></button>
      </view>
    </block>
    <block wx:elif="{{bindStatus === 'PENDING_UNBIND'}}">
      <view class="bind-info-line bind-info-warning">
        <text class="bind-info-label">解绑审核中</text>
        <text class="bind-info-value">等待站长确认</text>
      </view>
      <view class="bind-actions-row">
        <button bindtap="onWithdrawUnbind" class="af-action af-action--quiet"><view class="af-action__face">联系站长处理</view></button>
      </view>
    </block>
    <block wx:elif="{{bindStatus === 'PENDING'}}">
      <view class="bind-info-line bind-info-wait">
        <text class="bind-info-label">绑定审核中</text>
        <text class="bind-info-value">等待站长同意</text>
      </view>
      <view class="bind-actions-row">
        <button bindtap="onWithdrawUnbind" class="af-action af-action--quiet"><view class="af-action__face">联系站长处理</view></button>
      </view>
    </block>
    <block wx:elif="{{bindStatus === 'REJECTED'}}">
      <view class="bind-info-line bind-info-danger">
        <text class="bind-info-label">绑定被拒绝</text>
        <text class="bind-info-value">可重新提交绑定申请</text>
      </view>
      <view class="bind-actions-row">
        <button bindtap="onLogin" class="af-action af-action--secondary">重新申请绑定</button>
      </view>
    </block>
    <block wx:else>
      <view class="bind-info-line bind-info-none">
        <text class="bind-info-label">未绑定水站</text>
        <text class="bind-info-value">请先申请绑定水站才能接单</text>
      </view>
      <view class="bind-actions-row">
        <button bindtap="onLogin" class="af-action af-action--secondary">申请绑定水站</button>
      </view>
    </block>
  </view>

  <!--
    统计卡片（有业务权限时才显示）—— [2026-09-19] **按角色分叉**，两个角色看的不是同一组数：
      · 站长 = 经营概况：今日净利 / 今日下单桶数 / 桶异常·欠桶
      · 配送员 = 自己的活三格：今日完成 / 配送中 / 回桶数
    为什么站长那三格不显示"今日完成/待配送"：那两件事在「配送」tab 上就是页签与角标
    （tab 名已由「待接单」改为「待配送」，与 OrderStatus 1 同名），在「我的」再报一遍就是重复。
    ⚠️ 净利是**站长专属**（利润端点是 @RequireRole("STATION_MANAGER")），
    配送员那一支绝不能去请求它 —— 那不是显示成 0，而是直接拿一个权限错误。
  -->
  <view class="stats-card" wx:if="{{isLogin && canAccessBusiness}}">
    <text class="stats-heading">{{isManager ? '本站概况' : '今日配送'}}</text>
    <!-- 2026-11-06：读取中原先与失败都显示待核实；加载时明确提示，失败仍保留待核实与重试。 -->
    <!-- Cost-complete profit and known revenue keep their original data contract. -->
    <view class="stats-row manager-stats-row" wx:if="{{isManager}}">
      <view class="stats-item v2-money-stat" bindtap="onGoTodayProfit">
        <text class="stats-value stats-money {{todayProfit && todayProfit.netProfitWarn ? 'stats-warn' : ''}}">{{managerStatsLoading ? '加载中…' : ((todayProfit && todayProfit.netProfitText) || '待核实')}}</text>
        <text class="stats-label">{{(todayProfit && todayProfit.metricLabel) || '今日收入'}}</text>
      </view>
      <view class="stats-item" bindtap="onGoTodayBuckets">
        <text class="stats-value">{{managerStatsLoading ? '加载中…' : ((todayProfit && todayProfit.barrelCountText) || '待核实')}}</text>
        <text class="stats-label">今日下单桶数</text>
      </view>
    </view>

    <!-- 配送员：自己的活（口径全部按人统计，见 /api/delivery/stats/today） -->
    <view class="stats-row" wx:else>
      <view class="stats-item role-stat-current" bindtap="onOpenTaskStat" data-tab="delivering" aria-role="button">
        <text class="stats-value">{{statsLoading ? '加载中…' : (statsReady && todayStats.deliveringBarrels !== null && todayStats.deliveringBarrels !== undefined ? todayStats.deliveringBarrels + ' 桶' : '待核实')}}</text>
        <text class="stats-label">配送中</text><text class="stats-link">查看 ›</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item" bindtap="onOpenTaskStat" data-tab="completed" aria-role="button">
        <text class="stats-value">{{statsLoading ? '加载中…' : (statsReady && todayStats.completedBarrels !== null && todayStats.completedBarrels !== undefined ? todayStats.completedBarrels + ' 桶' : '待核实')}}</text>
        <text class="stats-label">今日送达</text><text class="stats-link">查看 ›</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item role-stat-physical" bindtap="onBarrelRecords" aria-role="button">
        <text class="stats-value">{{statsLoading ? '加载中…' : (statsReady && todayStats.returnBarrels !== null && todayStats.returnBarrels !== undefined ? todayStats.returnBarrels + ' 桶' : '待核实')}}</text>
        <text class="stats-label">回桶数</text><text class="stats-link">全部记录 ›</text>
      </view>
    </view>
    <view class="stats-care" wx:if="{{isManager && !managerStatsLoading && !managerStatsError && todayProfit && !todayProfit.readFailed && todayProfit.orderCount === 0}}"><icon name="order" size="22px" color="#637083" /><text>今日暂无订单，趁空喝口水吧。</text></view>
    <!-- Hide only verified zero counts. Unknown and failed reads stay actionable. -->
    <view class="mine-risk-summary" wx:if="{{isManager && (managerStatsLoading || risk.barrelExceptionFailed || risk.owedCustomerFailed || risk.barrelExceptionCount !== 0 || risk.owedCustomerCount !== 0)}}">
      <view class="mine-risk-entry" bindtap="onGoBarrelException" wx:if="{{managerStatsLoading || risk.barrelExceptionFailed || risk.barrelExceptionCount !== 0}}">
        <icon name="barrel" size="20px" color="#1264D6" /><text>桶异常</text><text class="mine-risk-count">{{managerStatsLoading ? '加载中…' : (risk.barrelExceptionFailed || risk.barrelExceptionCount === null || risk.barrelExceptionCount === undefined ? '待核实' : risk.barrelExceptionCount)}}</text><text class="mine-risk-arrow">›</text>
      </view>
      <view class="mine-risk-entry" catchtap="onGoOwedBarrels" wx:if="{{managerStatsLoading || risk.owedCustomerFailed || risk.owedCustomerCount !== 0}}">
        <icon name="barrel" size="20px" color="#1264D6" /><text>欠桶</text><text class="mine-risk-count">{{managerStatsLoading ? '加载中…' : (risk.owedCustomerFailed || risk.owedCustomerCount === null || risk.owedCustomerCount === undefined ? '待核实' : risk.owedCustomerCount)}}<text wx:if="{{!managerStatsLoading && !risk.owedCustomerFailed && risk.owedCustomerCount !== null && risk.owedCustomerCount !== undefined}}"> 户</text></text><text class="mine-risk-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="ui-state" wx:if="{{isLogin && !isManager && statsError}}"><text class="ui-state-copy">{{statsError}}</text><button bindtap="onRetryStats" class="af-action af-action--quiet"><view class="af-action__face">重新核对配送统计</view></button></view>
  <view class="ui-state" wx:if="{{isLogin && !isManager && statsReady && todayStats.deliveryTimeUnverifiedCount > 0}}"><text class="ui-state-copy">另有 {{todayStats.deliveryTimeUnverifiedCount}} 张历史订单的送达日期待核实，未计入今日。</text></view>
  <view class="ui-state" wx:if="{{isLogin && isManager && managerStatsError}}"><text class="ui-state-copy">{{managerStatsError}}</text><button bindtap="onRetryStats" class="af-action af-action--quiet"><view class="af-action__face">重新核对经营统计</view></button></view>
  <view class="personal-shortcuts" wx:if="{{isLogin && canAccessBusiness}}">
    <text class="personal-shortcuts-heading" wx:if="{{isManager}}">我的配送</text>
    <view class="personal-shortcuts-grid">
      <view bindtap="onMyEarnings" class="personal-shortcut personal-shortcut-money" aria-role="button">
        <icon name="wallet" variant="duotone" size="20px" color="#1264D6" fill-color="#EAF2FF" /><text>我的收益</text>
      </view>
      <view bindtap="onBarrelRecords" class="personal-shortcut personal-shortcut-physical" aria-role="button">
        <icon name="barrel" variant="duotone" size="20px" color="#1264D6" fill-color="#EAF2FF" /><text>空桶记录</text>
      </view>
      <view bindtap="onMyProblemReceipts" class="personal-shortcut" aria-role="button"><text>我的反馈</text></view>
      <view bindtap="onHistory" class="personal-shortcut personal-shortcut-history" aria-role="button">
        <view class="b2-line-clock personal-history-icon"><view class="b2-clock-hand"></view></view><text>配送历史</text>
      </view>
    </view>
  </view>

  <!-- 站长：水站摘要 + 配送员管理 / 绑定申请 Tab -->
  <block wx:if="{{isLogin && isManager}}">
    <!-- 我的水站整行进入本站资料管理。 -->
    <view class="section-card mine-station-card">
      <view class="section-header">
        <text class="section-title">我的水站</text>
      </view>
      <view class="station-info-row station-info-link" wx:if="{{stationInfo}}" bindtap="onGoStationInfo" hover-class="station-entry-pressed">
        <view class="mine-station-title"><text class="station-name">{{stationInfo.name || '未命名水站'}}</text><text class="station-edit-hint">资料 ›</text></view>
        <view class="mine-station-detail"><text class="station-address">{{stationInfo.address || '未填写地址'}}</text><text class="station-phone" wx:if="{{stationInfo.phone}}">{{stationInfo.phone}}</text></view>
      </view>
      <view class="station-info-empty" wx:else>
        <!-- [2026-09-20] 空态分两种：stationInfo 为空可能是"还没建站"，也可能是这次没查到。
             ⚠️ 本页没开 enablePullDownRefresh，所以只能说"切走再切回来"（见 onShow 会重新拉取）。 -->
        <text wx:if="{{stationInfoError}}">水站资料暂未读取：{{stationInfoError}}</text>
        <text wx:else>暂未创建水站，请前往创建</text><button wx:if="{{stationInfoError}}" bindtap="onRetryRoleData" class="af-action af-action--quiet"><view class="af-action__face">重新读取水站资料</view></button>
      </view>
    </view>

    <!--
      配送员管理 / 绑定申请 —— [2026-09-26 Wave1 轨道 G] 按 §5「员工列表可折叠」**收成折叠块**，
      内容是**原样保留**的：列表、解除、绑定/解绑审批（有副作用的动作）一个都没删，
      展开后仍在本页原地操作。站长端「员工」页也有一份更全的（多了搜索、在职/离职筛选、
      员工画像、新增配送员），两处数据同源。标题行的「更多 ›」进站长端员工页 ——
      不要把它删成一个纯跳转，也别再往这里加功能（新功能加在 station-mgmt/staff/）。
      ⚠️ 折叠的**唯一危险面**是"收起来 = 把待审批藏了"（AGENTS §8.22：看不见 ≠ 没有）：
         · 标题行**始终**显示「配送员 N · 待审批 M」，收着也看得见有几条要办；
         · 一旦有待审批申请，js 会自动展开一次（用户手动收过就不再自动展开，见 onToggleStaff）。
      ⚠️ 本页是 tabBar 页，`wx:if` 只切渲染、不重建页面，收起不会丢已加载的列表数据。
    -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">员工</text>
        <view class="section-head-right">
          <text class="staff-summary">配送员 {{staffReadReady ? staffList.length : '待核实'}} · 待审批 {{applicationsReadReady ? bindApplications.length : '待核实'}}</text>
          <text bindtap="onToggleStaff" class="af-action af-action--quiet b2-inline-tool"><text class="af-action__face">{{staffExpanded ? '收起' : '展开'}}</text></text>
          <text bindtap="onGoStaff" class="af-action af-action--quiet b2-inline-tool"><text class="af-action__face">更多 ›</text></text>
        </view>
      </view>

      <view class="ui-state" wx:if="{{staffReadError || applicationsReadError}}"><text class="ui-state-copy">{{staffReadError}} {{applicationsReadError}}</text><button bindtap="onRetryStaff" class="af-action af-action--quiet"><view class="af-action__face">重新核对员工与申请</view></button></view>
      <block wx:if="{{staffExpanded}}">
      <view class="mgmt-tabs">
        <text bindtap="onMgmtTabSwitch" data-tab="0" class="af-choice b2-choice {{mgmtActiveTab === 0 ? 'af-choice--selected' : ''}}"><text class="af-choice__face"><text class="af-choice__mark" wx:if="{{mgmtActiveTab === 0}}">✓</text>配送员管理 <text class="tab-count" wx:if="{{staffList.length > 0}}">{{staffList.length}}</text></text></text>
        <text bindtap="onMgmtTabSwitch" data-tab="1" class="af-choice b2-choice {{mgmtActiveTab === 1 ? 'af-choice--selected' : ''}}"><text class="af-choice__face"><text class="af-choice__mark" wx:if="{{mgmtActiveTab === 1}}">✓</text>绑定 / 解绑申请 <text class="tab-count tab-badge" wx:if="{{bindApplications.length > 0}}">{{bindApplications.length}}</text></text></text>
      </view>

      <!-- 配送员列表 -->
      <view wx:if="{{mgmtActiveTab === 0}}">
        <view class="mgmt-empty" wx:if="{{staffReadReady && !staffReadLoading && !staffReadError && staffList.length === 0}}">
          <text>暂无配送员</text>
          <text class="mgmt-empty-hint">配送员申请加入后，可在“绑定申请”审核。</text>
        </view>
        <view class="staff-item" wx:for="{{staffList}}" wx:key="id" wx:for-item="s">
          <view class="staff-avatar">{{s._firstChar || '配'}}</view>
          <view class="staff-info">
            <text class="staff-name">{{s.name || s.nickname || s.nickName || '配送员'}}</text>
            <text class="staff-meta">
              {{s._unbindPending ? '解绑申请中' : '已绑定'}} · {{s.phone || '暂无电话'}}
            </text>
          </view>
          <!--
            「解除」只给配送员 —— 站长不可被解除（服务端 2026-09-19 补的护栏，理由见
            pages/station-mgmt/staff/index.wxml 里的同一处注释：解除站长会让水站变成没人管的孤儿）。
            这里留一行字而不是干脆不渲染，否则站长会以为是界面坏了。
          -->
          <button wx:if="{{s.role === 'DELIVERY'}}" disabled="{{s._loading || !staffReadReady || staffReadLoading}}" data-id="{{s.id || s.staffId}}" bindtap="onRemoveStaff" class="af-action af-action--danger-quiet">{{s._loading ? '处理中' : '解除'}}</button>
          <text class="staff-self-note" wx:else>站长 · 不可解除</text>
        </view>
      </view>

      <!-- 绑定申请列表 -->
      <view wx:if="{{mgmtActiveTab === 1}}">
        <view class="mgmt-empty" wx:if="{{applicationsReadReady && !applicationsReadLoading && !applicationsReadError && bindApplications.length === 0}}">
          <text>暂无绑定或解绑申请</text>
        </view>
        <view class="staff-item" wx:for="{{bindApplications}}" wx:key="id" wx:for-item="a">
          <view class="staff-avatar staff-avatar-blue">{{a._firstChar || '申'}}</view>
          <view class="staff-info">
            <text class="staff-name">{{a.name || '申请人'}}<text class="staff-tag" wx:if="{{a.typeName}}"> · {{a.typeName}}</text></text>
            <text class="staff-meta">{{a.phone || '暂无电话'}} · {{a.applyTime || '时间未知'}}</text>
            <text class="staff-meta" wx:if="{{a.applyNote}}">备注：{{a.applyNote}}</text>
          </view>
          <view class="staff-action-col">
            <button disabled="{{a._loading || !applicationsReadReady || applicationsReadLoading}}" data-id="{{a.id || a.applyId}}" bindtap="onApproveBind" class="af-action af-action--primary">{{a._loading ? '' : '同意'}}</button>
            <button disabled="{{a._loading || !applicationsReadReady || applicationsReadLoading}}" data-id="{{a.id || a.applyId}}" bindtap="onRejectBind" class="af-action af-action--secondary">{{a._loading ? '处理中' : '拒绝'}}</button>
          </view>
        </view>
      </view>
      </block>

      <!-- 折叠态：给一句能行动的实话（有待审批时点名条数，别让站长以为没事） -->
      <view class="staff-folded-hint" wx:elif="{{bindApplications.length > 0}}">
        <text>有 {{bindApplications.length}} 条绑定 / 解绑申请待审批</text>
      </view>
    </view>
  </block>

  <!-- 菜单列表 -->
  <view class="menu-list" wx:if="{{isLogin}}">

    <block wx:if="{{canAccessBusiness}}">

      

      <view bindtap="onTransfer" class="af-entry b2-menu-entry">
        <icon name="order" size="20px" color="#1264D6" />
        <text class="menu-text">转让记录</text>
        <text class="af-entry__arrow">></text>
      </view>
    </block>
    <view bindtap="onReport" class="af-entry b2-menu-entry">
      <icon name="chat" variant="duotone" size="20px" color="#1264D6" fill-color="#EAF2FF" />
      <text class="menu-text">意见反馈</text>
      <text class="af-entry__arrow">></text>
    </view>
    <view bindtap="onSettings" class="af-entry b2-menu-entry">
      <icon name="settings" variant="duotone" size="20px" color="#1264D6" fill-color="#EAF2FF" />
      <text class="menu-text">设置</text>
      <text class="af-entry__arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="af-action af-action--quiet b2-logout" wx:if="{{isLogin}}" bindtap="onLogout">
    <text>退出登录</text>
  </view>

  <!-- 未登录提示 -->
  <view class="login-tip" wx:if="{{!isLogin}}">
    <text class="login-tip-text">请先登录以使用配送端功能</text>
    <button bindtap="onGoLogin" class="af-action af-action--primary af-action--block">前往登录</button>
  </view>
</view>
<business-dialog id="business-dialog" />
