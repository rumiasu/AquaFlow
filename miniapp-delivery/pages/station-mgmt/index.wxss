/* 功能目录用统一线性图标和三列；经营事实独立显示，不按功能格伪造金额。 */
.container {box-sizing:border-box;background:var(--bg-color);min-height:100vh;padding:24rpx 24rpx 48rpx;}
.work-head {padding:8rpx 4rpx 24rpx;}.work-title {display:block;font-size:38rpx;font-weight:700;color:var(--text-primary);}.work-desc {display:block;margin-top:10rpx;font-size:28rpx;line-height:1.6;color:var(--text-regular);}
.group {margin-top:20rpx;}.group-head,.board-head {display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:48px;padding:12rpx 4rpx;}.group-title {font-size:30rpx;font-weight:600;color:var(--text-primary);}.group-action {font-size:26rpx;color:var(--primary-color);flex-shrink:0;}
.management-grid {display:flex;flex-wrap:wrap;background:#fff;border-radius:16rpx;overflow:hidden;padding:8rpx 0;}
.management-tile {box-sizing:border-box;flex:none;width:100%;min-width:0;min-height:160rpx;padding:20rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:14rpx;}
.management-icon {width:26px;height:26px;flex-shrink:0;}.tile-label {display:block;width:100%;text-align:center;font-size:14px;font-weight:500;line-height:1.5;color:var(--text-primary);overflow-wrap:break-word;white-space:normal;}
.pending-board {padding:12rpx 20rpx 20rpx;background:#fff;border-radius:16rpx;}.board-head button:not(.af-action):not(.af-choice):not(.af-entry) {flex-shrink:0;min-height:44px;padding:8rpx 16rpx;margin:0;font-size:26rpx;line-height:1.5;background:var(--primary-bg);color:var(--primary-color);}.board-head button:not(.af-action):not(.af-choice):not(.af-entry)::after {border:0;}
.pending-cards {display:flex;flex-wrap:wrap;gap:12rpx;}.pending-card {box-sizing:border-box;flex:1 1 calc(50% - 12rpx);min-width:0;min-height:120rpx;padding:20rpx;background:var(--bg-gray);border-radius:12rpx;}
.pending-entry .entry-title {display:block;font-size:34rpx;font-weight:600;line-height:1.4;}.pending-entry .entry-desc {display:block;margin-top:8rpx;font-size:30rpx;line-height:1.5;color:var(--primary-color);}.pending-value {display:block;height:auto;white-space:normal;word-break:break-word;margin-top:10rpx;font-size:38rpx;font-weight:700;color:var(--warning-color);overflow-wrap:anywhere;}.pending-unit {font-size:28rpx;margin-left:8rpx;font-weight:400;}.entry-unknown {display:block;white-space:normal;overflow-wrap:break-word;margin-top:10rpx;font-size:34rpx;line-height:1.5;color:var(--text-regular);}.pending-clear {font-size:28rpx;line-height:1.6;padding:12rpx 0;color:var(--text-regular);}
.badge-error {margin:0 0 16rpx;padding:20rpx;font-size:34rpx;line-height:1.6;color:var(--text-primary);background:var(--warning-bg);border-radius:12rpx;}.entry-pressed {background:var(--primary-bg);}
.management-list { display:flex; flex-direction:column; }
.management-list .management-tile { min-height:44px; box-sizing:border-box; width:100%; display:flex; flex-direction:row; align-items:center; justify-content:flex-start; gap:20rpx; border-bottom:1rpx solid var(--border-color); }
.management-list .management-icon { width:44rpx; height:44rpx; flex-shrink:0; }
.management-list .tile-label { white-space:normal; text-align:left; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Page-specific role grouping. */

.management-list .management-tile { display:flex; align-items:center; gap:12px; min-height:60px; border-bottom:1px solid var(--af-border); }
.management-list .management-icon { width:32px; height:32px; flex:none; }
.management-list .tile-label { flex:1; min-width:0; font-size:15px; text-align:left; }
.management-list .management-tile::after { content:'›'; color:var(--af-text-secondary); font-size:20px; }

/* Visual v2: native navigation stays native; no financial figures added. */
.v2-management { padding:12px 16px 32px; background:var(--af2-page); }
.v2-management-overview { min-height:126px; padding:16px; display:flex; align-items:center; gap:8px; background:var(--af2-strong); color:#FFFFFF; }
.v2-management-copy { flex:1; min-width:0; }
.v2-management-title { display:block; font-size:22px; line-height:30px; font-weight:600; overflow-wrap:anywhere; }
.v2-management-note { display:block; margin-top:10px; color:#DCE8F1; font-size:14px; line-height:22px; }
.v2-management-scene { width:160px; height:107px; flex:none; }
.v2-management-fallback { display:flex; align-items:center; justify-content:center; }
.v2-management .pending-board { padding:0; margin:24px 0; background:transparent; border:0; box-shadow:none; }
.v2-management .board-head { margin-bottom:12px; }
.v2-management .group-title { font-size:18px; line-height:26px; }
.v2-management .pending-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.v2-management .pending-card { box-sizing:border-box; position:relative; min-width:0; min-height:108px; margin:0; padding:14px; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; border:1px solid var(--af2-line); border-radius:14px; background:#FFFFFF; box-shadow:var(--af2-shadow); }
.v2-pending-icon { position:absolute; top:14px; left:12px; }
.v2-management .entry-title { margin-left:32px; color:var(--af2-muted); font-size:13px; line-height:20px; }
.v2-management .pending-value { color:var(--af2-ink); font-size:30px; line-height:38px; font-weight:600; margin-top:8px; overflow-wrap:anywhere; max-width:100%; }
.v2-management .pending-unit { font-size:13px; font-weight:400; margin-left:4px; color:var(--af2-muted); }
.v2-management .entry-unknown { margin-top:12px; font-size:16px; line-height:24px; color:var(--af2-muted); }
.v2-management .entry-desc { color:var(--af2-primary); font-size:12px; line-height:18px; }
.v2-management .group { margin:20px 0; padding:0; background:transparent; border:0; }
.v2-management .group-head { padding:0; margin-bottom:12px; }
.v2-management .management-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.v2-management .management-tile { box-sizing:border-box; display:flex; flex-direction:row; align-items:center; gap:10px; min-height:56px; padding:12px; margin:0; border:1px solid var(--af2-line); border-radius:12px; background:#FFFFFF; box-shadow:var(--af2-shadow); }
.v2-management .management-icon { width:26px; height:26px; flex:none; margin:0; }
.v2-management .tile-label { font-size:14px; line-height:22px; color:var(--af2-ink); text-align:left; font-weight:600; min-width:0; overflow-wrap:anywhere; }
.v2-management .group-toggle { display:flex; align-items:center; gap:12px; min-height:56px; padding:12px 14px; margin:12px 0 0; border:1px solid var(--af2-line); border-radius:12px; background:#FFFFFF; }
.v2-management .group-toggle .group-title { flex:1; min-width:0; font-size:16px; line-height:24px; font-weight:400; }
.v2-management .group-action { flex:none; font-size:12px; color:var(--af2-muted); }
.v2-management .management-list { display:flex; flex-direction:column; gap:0; padding:4px 8px; border:1px solid var(--af2-line); border-top:0; border-radius:0 0 12px 12px; background:#FFFFFF; }
.v2-management .management-list .management-tile { border:0; border-bottom:1px solid var(--af2-line); border-radius:0; box-shadow:none; }
.v2-management .management-list .management-tile:last-child { border-bottom:0; }
.v2-management .management-tile.v2-dashboard { min-height:73px; margin:24px 0; padding:16px; gap:14px; }
.v2-dashboard-body { flex:1; min-width:0; }
.v2-dashboard-body .tile-label { display:block; font-size:18px; line-height:26px; }
.v2-dashboard-note { display:block; color:var(--af2-muted); font-size:13px; line-height:20px; margin-top:2px; }
.v2-dashboard-arrow { color:var(--af2-primary); font-size:22px; }
@media screen and (max-width:359px) { .v2-management-scene { width:126px; height:84px; } .v2-management-overview { padding:14px; gap:4px; } .v2-management-title { font-size:20px; line-height:28px; } .v2-management .management-tile { gap:8px; padding:10px; } .v2-management .tile-label { font-size:13px; line-height:20px; } }

/* Additive semantic surfaces; no implied payment/completion state. */
.v2-management .pending-card.v2-pending--money { background:var(--af2-surface-money); border-color:var(--af2-surface-money); }
.v2-management .v2-pending--money .entry-title,.v2-management .v2-pending--money .entry-desc { color:var(--af2-ink-money); }
.v2-management .pending-card.v2-pending--current { background:var(--af2-surface-current); border-color:var(--af2-surface-current); }
.v2-management .v2-pending--current .entry-title,.v2-management .v2-pending--current .entry-desc { color:var(--af2-ink-current); }
.v2-management .pending-card.v2-pending--physical { background:var(--af2-surface-physical); border-color:var(--af2-surface-physical); }
.v2-management .v2-pending--physical .entry-title,.v2-management .v2-pending--physical .entry-desc { color:var(--af2-ink-physical); }
.v2-management .pending-card.v2-pending--neutral { background:var(--af2-surface-neutral); border-color:var(--af2-surface-neutral); }
.v2-management .v2-pending--neutral .entry-title,.v2-management .v2-pending--neutral .entry-desc { color:var(--af2-ink-neutral); }
.v2-management .management-tile.v2-dashboard { background:var(--af2-surface-money); border-color:var(--af2-surface-money); }

/* Phone defect: the old 3-column width also constrained grid children and dashboard.
   These navigation entries are views, not native buttons; action-family sizing is unchanged. */
.v2-management .management-tile { width:100%; min-width:0; flex:none; }
.v2-management .management-grid { align-items:stretch; }
.v2-management .tile-label { flex:1; width:auto; min-width:0; font-size:14px; line-height:22px; }
.v2-management .management-tile.v2-dashboard { width:100%; }
.v2-management .pending-board { margin:16px 0; }
.v2-management .board-head { min-height:44px; padding:0; margin-bottom:8px; }
.v2-management .group-head { margin-bottom:8px; }
.v2-management .management-tile.v2-dashboard { min-height:64px; margin:16px 0; }
.v2-management-overview { min-height:84px; padding:12px 16px; background:var(--af2-surface-current); color:var(--af2-ink-current); box-shadow:none; }
.v2-management-title { font-size:20px; line-height:28px; }
.v2-management-scene { width:120px; height:80px; }
@media screen and (max-width:359px) { .v2-management-overview { padding:12px; gap:8px; } .v2-management-scene { width:96px; height:64px; } .v2-management .tile-label { font-size:14px; line-height:22px; } }

/* Real pending facts precede management navigation, without demo figures. */
.v2-management .pending-cards { display:flex; flex-direction:column; gap:0; overflow:hidden; border:1px solid #DDE5EF; border-radius:12px; background:#FFFFFF; }
.v2-management .pending-card { display:flex; flex:0 0 auto; flex-direction:row; align-items:center; justify-content:flex-start; gap:10px; min-height:56px; padding:10px 12px; border:0; border-bottom:1px solid #DDE5EF; border-radius:0; background:#FFFFFF; box-shadow:none; }
.v2-management .pending-card:last-child { border-bottom:0; }
.v2-management .v2-pending-icon { position:static; flex:none; }
.v2-management .entry-title { flex:1; min-width:0; margin:0; color:#223247; font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.v2-management .pending-value,.v2-management .entry-unknown { flex:0 1 auto; min-width:0; margin:0; color:#223247; font-size:16px; line-height:24px; overflow-wrap:anywhere; }
.v2-management .entry-desc { flex:none; margin:0; color:#1264D6; font-size:18px; line-height:24px; }
