/* 历史认领独立页面；金额和桶票分别列示，不改全局主题。 */
.claim-page { padding: 24rpx; padding-bottom: 72rpx;
  background: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}
.claim-card { background: var(--bg-white, #fff); border-radius: var(--radius-md); padding: 24rpx; margin: 20rpx 0;
  border: 1rpx solid var(--border-color);
}
.claim-title { display: block; font-size: 29rpx; font-weight: 600; line-height: 1.6; color: var(--text-primary, #182230); }
.claim-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.claim-status { color: var(--primary-color, #1264D6); font-size: 25rpx; margin-left: 16rpx; }
.claim-banner, .claim-notice, .claim-error { padding: 22rpx; margin-bottom: 18rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.7; }
.claim-banner { background: var(--primary-bg); color: var(--text-regular);
  border-left: 5rpx solid var(--primary-color);
}
.claim-notice { background: var(--bg-gray); color: var(--warning-color); border-left: 4rpx solid var(--warning-color); }
.claim-error { background: var(--bg-gray); color: var(--text-regular); border-left: 4rpx solid var(--error-color); }
.claim-muted, .claim-row { display: block; font-size: 25rpx; line-height: 1.7; margin-top: 12rpx; color: var(--text-regular); }
.claim-amount { display: block; font-size: 29rpx; line-height: 1.7; font-weight: 600; margin-top: 16rpx; color: var(--text-primary, #182230); }
.claim-material { display: block; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; margin-top: 18rpx; }
.claim-line { padding-top: 22rpx; margin-top: 22rpx; border-top: 1rpx solid var(--border-color); }
.claim-field { font-size: 27rpx; line-height: 1.7; padding-top: 20rpx; }
.claim-picker { padding: 22rpx 14rpx; background: var(--bg-gray); border-radius: 10rpx; font-size: 27rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.claim-input { display: block; box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 18rpx; margin-top: 12rpx; background: var(--bg-gray); border-radius: 10rpx; font-size: 28rpx; color: var(--text-primary, #182230); }
.claim-textarea { height: 200rpx; margin-bottom: 22rpx; }
.claim-primary, .claim-secondary { margin-top: 18rpx; min-height: 48px; font-size: 16px; border-radius: 12rpx; }
.claim-primary { background: var(--primary-color); color: #fff; }
.claim-secondary { background: var(--primary-bg); color: var(--primary-color); }
.claim-actions { display: flex; }
.claim-actions button { flex: 1; }
.claim-actions button:first-child { margin-right: 18rpx; }

/* 长商品名/状态各自保留可读宽度；窄屏自动换行，不挤压金额与操作。 */
.claim-heading { flex-wrap: wrap; gap: 8rpx 16rpx; }
.claim-heading .claim-title { flex: 1; min-width: 180rpx; word-break: break-all; }
.claim-status { flex-shrink: 0; margin-left: 0; max-width: 100%; line-height: 1.7; word-break: break-all; }
.claim-picker, .claim-row, .claim-amount { word-break: break-all; }
.claim-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }

/* 本页所有状态共用的可读与触控边界。 */
.claim-row, .claim-material, .claim-muted { line-height: 1.75; overflow-wrap: anywhere; }
.claim-heading { gap: 16rpx; flex-wrap: wrap; }
.claim-input { font-size: 28rpx; }
.claim-product { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--border-color); }
.claim-product-image { width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 10rpx; background: var(--bg-gray); }
.claim-no-image { display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: var(--text-regular); }
.claim-product-info { flex: 1; min-width: 0; }
.claim-add { color: var(--primary-color); font-size: 26rpx; }
.claim-refresh { margin: 0; }
.claim-photo { display: block; width: 200rpx; height: 200rpx; margin-top: 12rpx; background: var(--bg-gray); border-radius: 10rpx; }

.claim-catalog-toggle, .claim-record-toggle { min-height: 44px; display: flex; align-items: center; color: var(--primary-color); }
.claim-catalog-toggle { font-size: 28rpx; font-weight: 600; }
.claim-record-toggle { justify-content: space-between; }
.claim-picker, .claim-input { min-height: 44px; }
.claim-line > button.claim-secondary { width: auto; margin-left: 0; font-size: 14px; padding: 0 24rpx; }

.claim-catalog { height: 300px; }
.claim-edit-line { display: flex; flex-wrap: wrap; gap: 0 16rpx; align-items: flex-start; }
.claim-edit-line > .claim-title { flex: 1 0 100%; }
.claim-edit-line > .claim-field { flex: 1 1 142px; min-width: 142px; box-sizing: border-box; }
.claim-edit-line > button.claim-secondary { flex: 0 0 auto; }

/* 填写示意不是申请状态；状态仍来自原记录。 */
.claim-steps { display:flex; flex-wrap:wrap; gap:8px 16px; margin:16px 0 8px; color:var(--af-text-secondary); font-size:13px; }
.claim-steps > view { display:flex; align-items:center; gap:6px; }
.claim-step-number { width:24px; height:24px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--af-soft); color:var(--af-primary); font-weight:600; }
.claim-guide { margin-top:16px; border-top:1px solid var(--af-border); }
.claim-guide-toggle { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.claim-guide-body { display:flex; flex-wrap:wrap; align-items:center; gap:12px; padding:8px 0 16px; }
.claim-guide-body > view:last-child { flex:1; min-width:140px; }
.claim-guide-graphic { width:144px; height:96px; flex:none; display:flex; align-items:center; justify-content:center; background:var(--af-soft); border-radius:8px; }
.claim-guide-graphic image { width:100%; height:100%; }
.claim-card > .af-action--primary { margin-top:16px; }

/* 认领状态与填写区分开；示意步骤不充当审核结果。 */
.claim-banner { background:var(--af2-surface-order); color:var(--af2-ink-order); border-radius:14px; }
.claim-card { border-radius:14px; }
.claim-status { color:var(--af2-ink-order); }
.claim-steps { display:flex; gap:8px; }
.claim-steps > view { flex:1 1 76px; padding:10px 8px; border-radius:10px; background:var(--af2-surface-neutral); box-sizing:border-box; }
.claim-step-number { background:var(--af2-surface-order); color:var(--af2-ink-order); flex:none; }
.claim-guide-graphic { background:var(--af2-surface-order); }

/* Visual v2: page hierarchy and semantic surfaces. */
.claim-line { overflow-wrap:anywhere; }
.claim-amount { color:var(--af2-ink-money); }
