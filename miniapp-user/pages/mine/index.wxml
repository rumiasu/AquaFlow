<!-- 我的 · Step6 重构（2026-09-12）：钱包与桶四格卡 + 三组菜单
     原则：回答「我有什么」，不陈列「本 App 还有什么功能」；措辞务实，不玩商务黑话。 -->
<view class="page">
  <!-- 用户行 -->
  <view class="card user-card" bindtap="{{isLogin ? 'onEditProfile' : 'onLogin'}}">
    <image class="avatar" src="{{isLogin && userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/image/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname">{{isLogin ? (userInfo.nickName || userInfo.nickname || '用户') : '点击登录'}}</text>
      <text class="user-tag" wx:if="{{isLogin}}">普通用户{{statsText ? ' · ' + statsText : ''}}</text>
    </view>
    <text class="row-arrow">›</text>
  </view>

  <block wx:if="{{isLogin}}">
    <!--
      钱包与桶：余额/押金/水票/我的桶 四格同框，每格可点。
      [2026-09-27 走查 C05 修] 每一格都有自己的加载态：`*Loaded=false` 时显示「暂未加载」
      并给一个整卡可点的「重试」，**不再把没拉到的项画成 0**（0 与"没加载出来"是两种事实，
      客户分不清就会以为押金/水票丢了）。文案与状态全部由 js 的 assetsView 算好。
      [2026-09-27 走查 C06 修] 第四格原文写的是「水桶权益」，而它渲染的是 `summary.heldBuckets`
      = **持有**（权益 + 配送中，见 docs/architecture/02-领域模型.md §4）：配送中的桶既不能抵扣、
      也不能退，叫"权益"会让客户以为在途的桶已经可以退/可以抵扣。改成中性的「我的桶」，
      入口进到明细页看"已到手 / 配送中"的拆分。
    -->
    <view class="card assets-card">
      <view class="assets-head">
        <text class="assets-title">我的钱包与桶</text>
        <text class="assets-station" wx:if="{{stationName}}">{{stationName}}</text>
      </view>
      <view class="assets-grid">
        <view class="asset-cell" data-url="/pages/payment/records" bindtap="onMenuTap">
          <text class="asset-value {{balanceLoaded ? '' : 'asset-value-unloaded'}}">{{balanceLoaded ? '¥' + balanceText : balanceText}}</text>
          <text class="asset-label">余额 ›</text>
        </view>
        <view class="asset-cell" data-url="/pages/barrel/index" bindtap="onMenuTap">
          <text class="asset-value {{depositLoaded ? '' : 'asset-value-unloaded'}}">{{depositLoaded ? '¥' + depositText : depositText}}</text>
          <text class="asset-label">押金 ›</text>
        </view>
        <view class="asset-cell" data-url="/pages/ticket/index" bindtap="onMenuTap">
          <text class="asset-value {{ticketLoaded ? '' : 'asset-value-unloaded'}}">{{ticketText}}<text class="asset-unit" wx:if="{{ticketLoaded}}"> 张</text></text>
          <text class="asset-label">水票 ›</text>
        </view>
        <view class="asset-cell" data-url="/pages/barrel/index" bindtap="onMenuTap">
          <text class="asset-value {{barrelLoaded ? '' : 'asset-value-unloaded'}}">{{barrelText}}<text class="asset-unit" wx:if="{{barrelLoaded}}"> 个</text></text>
          <text class="asset-label">我的桶 ›</text>
        </view>
      </view>
      <!-- 有格子没加载出来时的显式提示 + 重试（toast 会消失，这一条不会） -->
      <view class="assets-unloaded-tip" wx:if="{{unloadedCount > 0}}" bindtap="onRetryAssets">
        <text class="assets-unloaded-text">有 {{unloadedCount}} 项没加载出来（不是 0）</text>
        <text class="assets-unloaded-retry">重新加载 ›</text>
      </view>
      <!-- 还空桶说明（务实版）：还空桶≠退押金，顾客侧不用也不能自己记账 -->
      <view class="asset-note">
        <text class="asset-note-text">空桶怎么还？不用自己操作：送水时配送员会顺手收走，还空桶不扣押金。</text>
        <view class="asset-note-link" data-url="/pages/barrel/index" bindtap="onMenuTap">退桶退押金 ›</view>
      </view>
    </view>

    <!-- 账单 -->
    <view class="group-title">账单</view>
    <view class="card menu-card">
      <view class="menu-row" data-url="/pages/payment/records" bindtap="onMenuTap">
        <text class="menu-name">账单记录</text>
        <text class="row-arrow">›</text>
      </view>
      <!-- 押金流水：上面四格卡里的「押金」只回答"现在多少"，这一页回答"为什么变" -->
      <view class="menu-row" data-url="/pages/deposit/records/index" bindtap="onMenuTap">
        <text class="menu-name">押金流水</text>
        <text class="menu-desc">押金的每一笔增减</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <!-- 我的信息 -->
    <view class="group-title">我的信息</view>
    <view class="card menu-card">
      <view class="menu-row" data-url="/pages/address/list" bindtap="onMenuTap">
        <text class="menu-name">地址管理</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" wx:if="{{isCompany}}" data-url="/pages/mine/company" bindtap="onMenuTap">
        <text class="menu-name">企业资料</text>
        <text class="menu-desc">月结客户</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/template/index" bindtap="onMenuTap">
        <text class="menu-name">常用订单模板</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <!-- 服务 -->
    <view class="group-title">服务</view>
    <view class="card menu-card">
      <view class="menu-row" data-url="/pages/shop/index" bindtap="onMenuTap">
        <text class="menu-name">更多商品</text>
        <text class="menu-desc">查看水站全部在售商品</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/notice/index" bindtap="onMenuTap">
        <text class="menu-name">公告</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/service/index" bindtap="onMenuTap">
        <text class="menu-name">客服与反馈</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/exception/list/list" bindtap="onMenuTap">
        <text class="menu-name">服务记录</text>
        <text class="menu-desc">送水异常的处理进度</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/mine/about" bindtap="onMenuTap">
        <text class="menu-name">关于我们</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <!-- 游客态 -->
  <block wx:else>
    <view class="group-title">服务</view>
    <view class="card menu-card">
      <view class="menu-row" data-url="/pages/shop/index" bindtap="onMenuTap">
        <text class="menu-name">更多商品</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/notice/index" bindtap="onMenuTap">
        <text class="menu-name">公告</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/service/index" bindtap="onMenuTap">
        <text class="menu-name">联系客服</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row" data-url="/pages/mine/about" bindtap="onMenuTap">
        <text class="menu-name">关于我们</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </block>
</view>
