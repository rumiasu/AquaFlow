<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" focus="{{true}}"></input>
    <text class="clear-btn" wx:if="{{keyword}}" bindtap="onClearInput">×</text>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{searchHistory.length > 0 && searchResults.length === 0}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <text class="clear-history" bindtap="onClearHistory">清空</text>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{searchHistory}}" wx:key="*this" bindtap="onHistoryTap" data-keyword="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="result-section" wx:if="{{searchResults.length > 0}}">
    <view class="section-header">
      <text class="section-title">搜索结果</text>
    </view>
    <view class="result-list">
      <view class="result-item" wx:for="{{searchResults}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <image class="result-image" src="{{item.image || '/assets/image/default-product.png'}}" mode="aspectFill"></image>
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-spec">{{item.spec}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 无结果 -->
  <view class="empty-section" wx:if="{{keyword && searchResults.length === 0 && !loading}}">
    <text class="empty-text">未找到相关商品</text>
  </view>
</view>
