.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 已选摘要：滚动到下半屏时仍能确认"这单给谁、送到哪" */
.summary {
  background: var(--primary-bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.summary-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 44rpx;
}
.summary-label {
  color: var(--text-secondary);
  width: 90rpx;
  flex-shrink: 0;
}
.summary-value {
  color: var(--text-primary);
  flex: 1;
}
.summary-change {
  color: var(--primary-color);
  font-size: 24rpx;
  padding-left: 16rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 0 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 14px; min-height:44px; display:flex; align-items:center; justify-content:center; }

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  overflow: hidden;
}
.row-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}
.row-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.row-arrow {
  color: var(--text-placeholder);
  font-size: 34rpx;
  padding-left: 12rpx;
}

.qty {
  display: flex;
  align-items: center;
}
.qty-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 34rpx;
  color: var(--text-primary);
  margin-left: 16rpx;
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  line-height: 40rpx;
}

.fee-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 48rpx;
}
.fee-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  border-top: 1rpx solid #E8ECF1;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.warn {
  font-size: 24rpx;
  color: var(--warning-color);
  line-height: 40rpx;
  margin-top: 8rpx;
}
.blocked {
  font-size: 24rpx;
  color: var(--error-color);
  line-height: 40rpx;
  margin-top: 8rpx;
}

.methods {
  display: flex;
  flex-wrap: wrap;
}
.method {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  margin: 0 16rpx 16rpx 0;
}
.method-on {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background: var(--primary-bg);
}
.method-off {
  color: var(--text-placeholder);
  border-color: var(--border-light);
}

.btn-primary {
  height: auto;
  line-height: 1.5;
  text-align: center;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 16px; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-disabled {
  background: var(--primary-bg);
}
.hint {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.work-head { padding: 8rpx 4rpx 24rpx; }
.work-title { display:block; font-size:38rpx; font-weight:700; line-height:1.4; color:var(--text-primary); }
.work-desc { display:block; margin-top:8rpx; font-size:26rpx; line-height:1.6; color:var(--text-regular); }

.page { box-sizing:border-box; }
.summary { position:static; border-radius:12rpx; border-left:6rpx solid var(--primary-color); }
.summary-line { align-items:flex-start; flex-wrap:wrap; gap:12rpx; }
.summary-value { font-size:30rpx; line-height:1.6; min-width:0; overflow-wrap:break-word; }
.summary-change { min-height:88rpx; display:flex; align-items:center; padding:0 16rpx; }
.card { border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.card-title { font-size:32rpx; }
.search-input { min-width:0; min-height:88rpx; font-size:28rpx; border-radius:10rpx; }
.search-btn { min-height: 44px; height:auto; line-height:1.5; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:10rpx; }
.row { min-height:112rpx; box-sizing:border-box; border-color:var(--border-color); gap:16rpx; flex-wrap:wrap; }
.row-main { flex:1 1 120px; min-width:0; overflow:visible; overflow-wrap:anywhere; }
.row-title { font-size:32rpx; line-height:1.5; }
.row-sub,.hint { color:var(--text-regular); font-size:28rpx; line-height:1.6; }
.qty-btn { width:96rpx; height: auto; line-height: 1.5; font-size:36rpx; border-radius:10rpx; min-height:44px; display:flex; align-items:center; justify-content:center; }
.qty { flex-shrink:0; }
.fee-line { font-size:30rpx; line-height:1.6; }
.fee-total { font-size:38rpx; color:var(--text-primary); border-top:2rpx solid var(--border-color); }
.methods { flex-wrap:wrap; gap:12rpx; }
.method { min-height:96rpx; box-sizing:border-box; padding:20rpx; font-size:28rpx; border-radius:10rpx; display:flex; align-items:center; justify-content:center; }
.btn-primary { min-height:104rpx; height:auto; line-height:1.5; padding:20rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; border-radius:10rpx; font-size:32rpx; }
.warn,.blocked { font-size:28rpx; line-height:1.6; border-radius:8rpx; }
.qty-value { min-width:42rpx; text-align:center; color:#17385f; font-weight:600; }
.qty-btn { min-width:44px; min-height:44px; display:flex; align-items:center; justify-content:center; }
.selected-product { margin-top:16rpx; padding-top:20rpx; border-top:1rpx solid var(--border-color); }
.selector-hint { display:block; margin-top:16rpx; color:var(--text-regular); font-size:14px; line-height:1.5; }
.qty-btn { margin:0; padding:0; box-sizing:border-box; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .work-head { padding:16px; border-radius:14px; background:var(--af2-surface-order); } .work-title,.work-desc { color:var(--af2-ink-order); } .card { border-radius:14px; box-shadow:none; } .s-fee-summary { background:var(--af2-surface-money); } .s-fee-summary .fee-line { padding:8px 0; color:var(--af2-ink-money); } .row { border-bottom:1px solid var(--af-border); } .methods { gap:8px; }
