.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }
.record-card { background: var(--bg-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-header { margin-bottom: 12rpx; }
.status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; display: inline-block; }
.status.pending { background: #fff3e0; color: #f57c00; }
.status.approved { background: #e3f2fd; color: #1976d2; }
.status.done { background: #e8f5e9; color: #4caf50; }
.status.rejected { background: #fce4ec; color: #f44336; }
.info-row { font-size: 26rpx; color: var(--text-primary); margin-bottom: 8rpx; display: flex; justify-content: space-between; }
.card-actions { margin-top: 16rpx; display: flex; gap: 16rpx; }
.btn-approve, .btn-reject { flex: 1; padding: 16rpx; border-radius: 12rpx; font-size: 26rpx; border: none; }
.btn-approve { background: var(--primary-gradient); color: #fff; }
.btn-reject { background: #fce4ec; color: #f44336; }
/* 欠桶提醒（over>0）与暂存提醒（over<0）——两者都是合法状态，必须如实显示 */
.info-row .warn { color: #d32f2f; font-size: 24rpx; }
.info-row .tip { color: var(--text-secondary); font-size: 24rpx; }
.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }
