<view class="page">
  <view class="card">
    <text class="title">个人资料与注销</text>
    <text class="body">申请查询、更正、导出或删除个人资料，也可申请注销账户。</text>
    <text class="body" wx:if="{{options && !options.intakeEnabled}}">申请暂未开放。</text>
    <text class="body" wx:if="{{options && options.intakeContact}}">受理联系渠道：{{options.intakeContact}}</text>
    <button wx:if="{{options.intakeEnabled}}" class="af-action af-action--quiet" bindtap="onToggleDetails"><text class="af-action__face">办理说明 {{detailsExpanded ? '收起 −' : '展开 +'}}</text></button>
    <view wx:if="{{detailsExpanded}}"><text class="body">申请登记后需人工核实，登记不代表办理完成。</text><text class="body" wx:if="{{options.notice}}">{{options.notice}}</text><text class="body">不会自动导出、删除或匿名化资料，也不会注销账户或清理未结业务。</text></view>
    <text class="error" wx:if="{{error}}">{{error}}</text>
    <button class="af-action af-action--secondary" wx:if="{{needLogin}}" bindtap="onLogin">去登录</button>
    <button class="af-action af-action--quiet" wx:if="{{error && !needLogin}}" bindtap="onRetry" disabled="{{loading}}" loading="{{loading}}"><text class="af-action__face">重新查询</text></button>
  </view>
  <view class="card" wx:if="{{options && !options.intakeEnabled && options.closureCheckSupported}}">
    <text class="title">注销前检查</text><text class="body">检查本人未结事项，不会注销账户。</text>
    <text class="error" wx:if="{{checkError}}">{{checkError}}</text><button class="af-action af-action--quiet" bindtap="onCheck" disabled="{{loading}}"><text class="af-action__face">查询未结事项</text></button>
    <text class="body" wx:if="{{check}}">{{check.message}}</text><view wx:for="{{check.blockingItems}}" wx:key="index"><text class="body">{{item.stationName}}：{{item.label}}</text></view>
  </view>
  <view class="card" wx:if="{{submitNotice && !intentBlocked}}"><text class="body">{{submitNotice}}</text></view>
  <view class="card" wx:if="{{draftAvailable || draftNotice || intentBlocked}}">
    <text class="body" wx:if="{{draftAvailable}}">有上次未提交的申请输入。</text><text class="error" wx:if="{{draftNotice}}">{{draftNotice}}</text>
    <text class="error" wx:if="{{intentBlocked}}">{{submitNotice || '原申请记录暂时无法读取，请联系水站核对，暂不能新建申请。'}}</text>
    <button class="af-action af-action--quiet" wx:if="{{draftAvailable}}" bindtap="onRestoreDraft" disabled="{{pending || submitting || loading}}"><text class="af-action__face">恢复原输入</text></button><button class="af-action af-action--quiet" wx:if="{{draftAvailable}}" bindtap="onDiscardDraft" disabled="{{pending || submitting}}"><text class="af-action__face">放弃原草稿</text></button>
  </view>
  <view class="tabs" wx:if="{{options || items.length}}"><view class="tab af-choice {{tab === 'apply' ? 'active af-choice--selected' : ''}}" data-tab="apply" bindtap="onTab"><text class="af-choice__face">办理申请</text></view><view class="tab af-choice {{tab === 'records' ? 'active af-choice--selected' : ''}}" data-tab="records" bindtap="onTab"><text class="af-choice__face">我的记录</text></view></view>
  <view class="card" wx:if="{{tab === 'apply' && options.intakeEnabled}}">
    <text class="title">登记本人申请</text>
    <picker range="{{options.requestTypes}}" range-key="label" bindchange="onType" disabled="{{pending || submitting}}"><view class="body">{{selectedLabel}} ›</view></picker>
    <view class="closure-check" wx:if="{{tab === 'apply' && options.closureCheckSupported && isClosure}}">
    <text class="title">注销前检查</text>
    <text class="body">检查本人未结事项，不会注销账户。</text>
    <text class="error" wx:if="{{checkError}}">{{checkError}}</text>
    <button class="af-action af-action--quiet" bindtap="onCheck" disabled="{{loading}}"><text class="af-action__face">查询未结事项</text></button>
    <text class="body" wx:if="{{check}}">{{check.message}}</text>
    <view wx:for="{{check.blockingItems}}" wx:key="index"><text class="body">{{item.stationName}}：{{item.label}}</text></view>
  </view>
    <textarea placeholder="补充说明（选填，最多500字）" value="{{note}}" maxlength="500" bindinput="onNote" disabled="{{pending || submitting}}" />
    <button class="af-action af-action--primary af-action--block" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting || loading || intentBlocked}}">{{pending ? '重试原申请' : '登记申请'}}</button>
  </view>
  <view class="card" wx:if="{{tab === 'records' && (options || items.length)}}">
    <text class="title">我的申请记录</text>
    <text class="body" wx:if="{{options && items.length === 0 && !loading && !error}}">暂无登记记录。</text>
    <view class="record" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onDetail"><text class="body">{{item.statusText}} · {{item.requestTypeText}} ›</text></view>
    <button class="af-action af-action--quiet" wx:if="{{nextBeforeId}}" bindtap="onMore" disabled="{{loading}}"><text class="af-action__face">更多记录</text></button>
  </view>
  <view id="request-detail" class="card" wx:if="{{tab === 'records' && detail}}">
    <text class="title">{{detail.request.requestTypeText}}</text>
    <text class="request-status">{{detail.request.statusText}}</text>
    <text class="body" wx:if="{{detail.request.note}}">{{detail.request.note}}</text>
    <text class="body">{{detail.request.notice}}</text>
    <text class="body" wx:if="{{detail.checkNotice}}">{{detail.checkNotice}}</text>
    <text class="body" wx:if="{{detail.closureCheck}}">{{detail.closureCheck.message}}</text>
    <view wx:for="{{detail.closureCheck.blockingItems}}" wx:key="index"><text class="body">{{item.stationName}}：{{item.label}}</text></view>
  </view>
</view>
<business-dialog id="business-dialog" />
