.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 已选摘要：滚动到下半屏时仍能确认"这单给谁、送到哪" */
.summary {
  background: var(--primary-bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.summary-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 44rpx;
}
.summary-label {
  color: var(--text-secondary);
  width: 90rpx;
  flex-shrink: 0;
}
.summary-value {
  color: var(--text-primary);
  flex: 1;
}
.summary-change {
  color: var(--primary-color);
  font-size: 24rpx;
  padding-left: 16rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1ECE1;
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  overflow: hidden;
}
.row-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}
.row-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.row-arrow {
  color: var(--text-placeholder);
  font-size: 34rpx;
  padding-left: 12rpx;
}

.qty {
  display: flex;
  align-items: center;
}
.qty-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 34rpx;
  color: var(--text-primary);
  margin-left: 16rpx;
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  line-height: 40rpx;
}

.fee-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 48rpx;
}
.fee-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  border-top: 1rpx solid #F1ECE1;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.warn {
  font-size: 24rpx;
  color: var(--warning-color);
  line-height: 40rpx;
  margin-top: 8rpx;
}
.blocked {
  font-size: 24rpx;
  color: var(--error-color);
  line-height: 40rpx;
  margin-top: 8rpx;
}

.methods {
  display: flex;
  flex-wrap: wrap;
}
.method {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  margin: 0 16rpx 16rpx 0;
}
.method-on {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background: var(--primary-bg);
}
.method-off {
  color: var(--text-placeholder);
  border-color: var(--border-light);
}

.btn-primary {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-disabled {
  background: var(--primary-bg);
}
.hint {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}
