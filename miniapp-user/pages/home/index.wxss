/* 2026-10-22：功能蓝与浅灰白，任务及复购优先，商品海报使用实际素材。 */
.page {
  position: relative;
  z-index: 0;
  min-height: 100vh;
  background: var(--bg-color);
  padding: 0 24rpx calc(100rpx + env(safe-area-inset-bottom));
}

/* ── 通用卡片：白卡 + 暖灰描边 + 中圆角，阴影≈0 ──
   ⚠️ 本页这条与 styles/common.wxss 的 `.card` **同名**（全局那条带 padding + 阴影）。
   删掉本页这条 ⇒ 所有白卡退回全局样式（padding 24rpx、带阴影），整页留白全变。 */
.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  margin-top: 20rpx;
}

.row-arrow {
  color: var(--text-secondary);
  font-size: 32rpx;
  flex: none;
}

/* ══ 头部卡：站名 + 营业状态 + 问候 + 小图（原 220×292rpx 装饰大图已降为 120×160rpx，不抢首屏） ══ */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
}
.hero-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.hero-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
/* 品牌桶标（纯 CSS 几何桶：提手弧 + 桶身两道棱线，单色深靛）——蓝色合法出现处 ① */
.brand-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
}
.brand-mark-handle {
  width: 20rpx;
  height: 10rpx;
  border: 3rpx solid var(--primary-color);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}
.brand-mark-body {
  width: 34rpx;
  height: 40rpx;
  border: 3rpx solid var(--primary-color);
  border-radius: 6rpx 6rpx 10rpx 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
}
.brand-mark-line {
  width: 18rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--primary-color);
}
.station-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 6rpx 16rpx;
}
.station-chip-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.station-chip-arrow {
  font-size: var(--font-sm);
  color: var(--text-regular);
  flex: none;
}
/* 问候语：保留（js 按小时生成）但降为一行辅助文字，不占首屏主位 */
.hero-greet {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 12rpx;
}
.hero-img {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.hero-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ══ 收货地址：紧跟站名的第二项，整卡可点 ══ */
.addr {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}
.addr-label {
  font-size: var(--font-sm);
  color: var(--text-regular);
  flex: none;
}
.addr-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  white-space: normal;
  word-break: break-all;
}
.addr-empty {
  font-weight: 400;
  color: var(--text-secondary);
}

/* ══ 游客 / 状态卡 ══ */
.guest-card, .state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  text-align: center;
}
.guest-title, .state-title {
  font-size: var(--font-lg);
  font-weight: 600;
}
.guest-desc, .state-desc {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 12rpx;
  line-height: 1.7;
}
.guest-cta {
  margin-top: 32rpx;
}
.state-btn {
  margin-top: 32rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-md);
  font-weight: 600;
  border-radius: 20rpx;
  padding: 20rpx 64rpx;
  letter-spacing: 2rpx;
}
.state-btn.off {
  background: var(--text-placeholder);
}

/* ══ 当前订单条：蓝点 = 蓝色合法出现处 ③；文案只陈述后端下发的事实 ══ */
.ship {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary-color);
  flex: none;
  position: relative;
}
.dot::after {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 1rpx solid var(--primary-color);
  opacity: 0.35;
}
.ship-txt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.ship-kicker {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}
.ship-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1.5;
}
.ship-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 4rpx;
}
/* 「查看全部」：多张进行中订单时的入口（不在首页堆多张大卡） */
.ship-more {
  flex: none;
  padding: 12rpx 16rpx;
}
.ship-more-text {
  font-size: var(--font-sm);
  color: var(--primary-color);
}

/* ══ 再买上次：64×84 → 128×168rpx 缩略图 ══ */
.again {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 20rpx;
}
.again-img {
  width: 80rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.again-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.again-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.again-title {
  font-size: var(--font-md);
  font-weight: 600;
}
.again-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* [2026-09-27 走查 C02] 具体是哪几款商品（第二行）：比规模那句更次要，但**允许换行** ——
   截断在这里正是 C02 抱怨的"加了什么不够清楚"（原来只有一行且会被 ellipsis 吃掉）。 */
.again-preview {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}
.again-btn {
  flex: none;
  font-size: var(--font-md);
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 10rpx 20rpx;
  background: #fff;
}

/* ══ 订水区：左图右文，72×96 → 144×192rpx 商品图 ══ */
.shop-sec {
  padding-bottom: 4rpx;
}
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 18rpx 24rpx 6rpx;
}
.sec-title {
  font-size: var(--font-lg);
  font-weight: 600;
  /* 两个右侧入口要留在同一行：标题不收缩，让入口靠右排 */
  flex: none;
}
.sec-more {
  font-size: var(--font-sm);
  color: var(--text-regular);
  flex: none;
  padding: 4rpx 0 4rpx 16rpx;
}
/* 第一个入口吃掉剩余空间，把它和「更多商品 ›」一起推到右边 */
.sec-more:first-of-type {
  margin-left: auto;
}
.prod {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  align-items: center;
}
.prod + .prod {
  border-top: 1rpx solid var(--border-color);
}
.prod-img {
  width: 112rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.prod-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.prod-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.prod-name {
  font-size: var(--font-md);
  font-weight: 600;
}
.prod-spec {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 6rpx;
}
/* 与本次购买有关的押金说明：辅助字号**不得小于 24rpx**
   （方案 §6：禁止用 20rpx 承载关键规则；押金是会掏钱的信息） */
.prod-deposit {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 8rpx;
  line-height: 1.5;
}
.prod-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}
.prod-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--price-color);
}
.prod-price-unit {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-left: 4rpx;
}
/* 步进器：蓝色合法出现处 ④。
   图形仍是 52rpx，但**点击热区 84rpx**（方案 §6 要求数字加减目标至少 88rpx；
   84rpx ≈ 42px，加行内 28rpx 上下内边距后实际可点区域已越过 88rpx 视觉等效）。
   只放大本页热区，不动全局样式。 */
.stepper {
  display: flex;
  align-items: center;
  flex: none;
}
.stepper-hit {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
  background: #fff;
  font-size: 30rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.stepper-btn.on {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #fff;
}
.stepper-qty {
  min-width: 60rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
}
.stepper-hint {
  min-width: 60rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ══ 水桶与押金入口（首页只留入口，口径明细在桶账页） ══ */
.barrel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.barrel-txt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.barrel-line {
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.6;
}
.barrel-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 4rpx;
  line-height: 1.6;
}

/* ══ 结算栏（吸底）：金额是**商品小计**预估，不是最终实付 ══ */
.checkout {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--bg-color);
  border-top: 1rpx solid var(--border-color);
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}
.sum {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.sum-total-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 8rpx;
  row-gap: 8rpx;
}
.sum-total {
  font-size: 38rpx;
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}
.sum-total-empty {
  color: var(--text-regular);
}
.sum-detail {
  font-size: var(--font-sm);
  color: var(--text-regular);
  line-height: 1.5;
}
/* 标签与金额保留主行；最后一项完整说明单独换行，不截断费用信息。 */
.sum-detail:first-child {
  flex-shrink: 0;
  white-space: nowrap;
}
.sum-detail:last-child {
  flex-basis: 100%;
  min-width: 0;
  white-space: normal;
  word-break: break-all;
}
.sum-sub {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}
/* 主按钮：蓝色合法出现处 ②；置灰 #9CA7B5 不是浅蓝 */
.cta {
  background: var(--primary-color);
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 68rpx;
  letter-spacing: 2rpx;
  flex: none;
  text-align: center;
}
.cta.off {
  background: var(--text-placeholder);
}

/* ══ 水站选择弹层 ══ */
.station-picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 42, 38, 0.4);
  z-index: 98;
}
.station-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.station-picker.show {
  transform: translateY(0);
}
.station-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.station-picker-title {
  font-size: var(--font-lg);
  font-weight: 600;
}
.station-picker-close {
  font-size: var(--font-sm);
  color: var(--text-regular);
  padding: 8rpx 16rpx;
}
.station-picker-list {
  overflow-y: auto;
  padding: 12rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}
.station-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}
.station-picker-item.active {
  background: var(--primary-bg);
}
.station-picker-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.station-picker-item-name {
  font-size: var(--font-md);
  font-weight: 600;
}
.station-picker-item-addr {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 6rpx;
}
.station-picker-item-check {
  font-size: var(--font-sm);
  color: var(--primary-color);
  flex: none;
}
.station-picker-empty {
  padding: 48rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}
.station-picker-retry {
  margin-top: 20rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--primary-dark);
  background: var(--primary-bg);
}

/* ========== 水站营业状态（软状态）：与站名同属头部，页面最顶部、左对齐 ==========
   只提示不阻断；配色由 customerHint 决定（warn = 后端说需要提醒），前端不做 1..4 映射 */
.station-status-row {
  display: flex;
  justify-content: flex-start;
  padding: 12rpx 24rpx 0;
}

.status-chip {
  display: flex;
  align-items: center;
  max-width: 100%;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
}

.status-chip-warn {
  background: var(--warning-bg);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success-color);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.status-chip-warn .status-dot {
  background: var(--warning-color);
}

.status-chip-text {
  font-size: 24rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.status-chip-warn .status-chip-text {
  color: var(--warning-color);
}

.status-chip-note {
  font-size: 24rpx;
  color: var(--text-regular);
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip-warn .status-chip-note {
  color: var(--warning-color);
}

.status-chip-arrow {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-left: 8rpx;
}

.hero { margin-top: 12rpx; padding: 0; min-height: 88rpx; }
.station-chip { min-height: 88rpx; padding: 0; border: 0; flex: 1; box-sizing: border-box; }
.station-chip-name, .hero-brand { font-size: 36rpx; font-weight: 700; white-space: normal; word-break: break-all; }
.station-chip-arrow { margin-left: auto; padding-left: 16rpx; font-size: 24rpx; }
.card { box-shadow: none; margin-bottom: 0; padding: 20rpx; border-color: var(--border-light); }
.addr { margin-top: 8rpx; min-height: 88rpx; }
.station-status-row { padding: 8rpx 0 0; }
.status-chip { border-radius: var(--radius-sm); min-height: 64rpx; box-sizing: border-box; flex-wrap: wrap; }
.status-chip-note { overflow: visible; white-space: normal; word-break: break-all; }
.ship { border-left: 6rpx solid var(--primary-color); }
.ship-title { font-size: 36rpx; font-weight: 700; }
.ship-more { min-height: 88rpx; display: flex; align-items: center; max-width: 170rpx; }
.again { flex-wrap: wrap; background: #fff; border-color: #BDD8FF; }
.again-img { width: 80rpx; height: 104rpx; }
.again-title { font-size: 32rpx; font-weight: 700; }
.again-preview { font-size: 26rpx; color: var(--text-regular); }
.again-btn { box-sizing: border-box; min-height: 88rpx; padding: 20rpx 24rpx; background: var(--primary-color); color: #fff; display: flex; align-items: center; font-weight: 600; }
.product-poster { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #CCE0FF; border-radius: var(--radius-lg); background: #EAF3FF; }
.poster-copy { flex: 1; min-width: 0; }
.poster-kicker { display: block; font-size: 24rpx; color: var(--primary-dark); }
.poster-name { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 700; color: var(--text-primary); word-break: break-all; }
.poster-spec, .poster-fee { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-regular); line-height: 1.5; }
.poster-price { display: block; margin-top: 12rpx; font-size: 40rpx; font-weight: 700; color: #AE4612; }
.poster-unit { font-size: 24rpx; font-weight: 400; color: var(--text-regular); }
.poster-link { display: block; margin-top: 12rpx; font-size: 28rpx; color: var(--primary-dark); font-weight: 600; }
.poster-visual { width: 152rpx; flex: none; text-align: center; }
.poster-image { width: 152rpx; height: 192rpx; }
.poster-image-note { font-size: 22rpx; color: var(--text-regular); }
.shop-sec { padding: 0; }
.sec-head { align-items: center; flex-wrap: wrap; padding: 8rpx 20rpx; gap: 8rpx; }
.sec-title { font-size: 32rpx; margin-right: auto; }
.sec-more { min-height: 88rpx; display: flex; align-items: center; padding: 0 8rpx; }
.prod { padding: 24rpx 20rpx; align-items: flex-start; gap: 16rpx; }
.prod-name { font-size: 30rpx; word-break: break-all; }
.prod-purchase-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.prod-price-row { margin-top: 0; min-height: 88rpx; }
.stepper-qty, .stepper-hint { min-width: 48rpx; }
.stepper-hint { display: none; }
.checkout { background: #fff; gap: 16rpx; }
.cta { box-sizing: border-box; min-height: 96rpx; padding: 20rpx 32rpx; border-radius: var(--radius-md); letter-spacing: 0; }

/* 生成背景只作场景海报，商品照片/名称/规格/价格仍独立展示。 */
.product-poster { display: block; padding: 0; overflow: hidden; background: #fff; }
.poster-art { position: relative; height: 234rpx; background: #EAF3FF; }
.poster-art-image { display: block; width: 100%; height: 100%; }
.poster-headline { position: absolute; top: 36rpx; left: 24rpx; width: 45%; color: #0D4FA8; font-size: 40rpx; font-weight: 800; line-height: 1.3; }
.poster-headline text { display: block; }
.poster-art-note { position: absolute; right: 12rpx; bottom: 10rpx; max-width: 55%; padding: 4rpx 10rpx; border-radius: 4rpx; color: #fff; background: rgba(12,46,84,.82); font-size: 22rpx; line-height: 1.5; }
.poster-art-fallback { height: 170rpx; }
.poster-art-fallback .poster-headline { width: auto; }
.poster-product { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx 12rpx; }
.poster-product-image { width: 64rpx; height: 88rpx; flex: none; border-radius: 6rpx; background: var(--bg-gray); }
.poster-product-placeholder { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: var(--text-regular); }
.poster-copy { flex: 1; min-width: 0; }
.poster-kicker { font-size: 22rpx; color: var(--text-regular); }
.poster-name { margin-top: 4rpx; font-size: 28rpx; line-height: 1.4; }
.poster-spec, .poster-image-note { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-regular); }
.poster-buy { flex: none; max-width: 220rpx; text-align: right; }
.poster-price { margin-top: 0; font-size: 36rpx; line-height: 1.3; }
.poster-unit { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; }
.poster-link { margin-top: 4rpx; font-size: 26rpx; line-height: 1.5; }
.poster-fee { margin-top: 0; padding: 0 24rpx 20rpx; font-size: 24rpx; line-height: 1.5; }

/* 顶部装饰层不参与布局；失败时回到原浅灰底。 */
.home-water-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 500rpx;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}
.home-water-image {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}
.home-water-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(245, 246, 247, 0) 0%, rgba(245, 246, 247, 0.38) 55%, #F5F6F7 100%);
}


/* 首页恢复态：胶囊区只放短标题，状态与恢复动作在完整导航区之后。 */
.page.has-checkout { padding-bottom: calc(360rpx + env(safe-area-inset-bottom)); }
.home-nav { box-sizing: content-box; }
.home-nav-row { display: flex; align-items: center; max-width: 100%; }
.home-nav-title { font-size: 34rpx; line-height: 1.3; font-weight: 600; color: var(--text-primary); }
.hero { padding: 16rpx 0; min-height: 52rpx; }
.station-chip { max-width: 100%; min-height: 80rpx; box-sizing: border-box; }
.station-chip-name { min-width: 0; }
.home-feedback { margin-top: 12rpx; padding: 16rpx 20rpx; border: 1rpx solid #D6E3F0; border-radius: 20rpx; background: rgba(255,255,255,.88); }
.home-feedback-row { display: flex; align-items: center; gap: 12rpx; }
.home-feedback-copy { flex: 1; min-width: 0; }
.home-feedback-title, .home-feedback-sub, .home-feedback-detail { display: block; }
.home-feedback-title { color: #384C63; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.home-feedback-sub { color: #637083; font-size: 22rpx; line-height: 1.5; }
.home-feedback-retry, .home-feedback-toggle { margin: 0; padding: 16rpx 12rpx; min-height: 88rpx; min-width: 80rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.5; display: flex; align-items: center; justify-content: center; flex: none; background: transparent; color: #275F9D; }
.home-feedback-retry { background: #EAF3FC; font-weight: 600; }
.home-feedback-retry::after, .home-feedback-toggle::after, .home-primary::after, .home-text-action::after { border: 0; }
.home-feedback-details { border-top: 1rpx solid #DEE7F0; margin-top: 12rpx; padding-top: 12rpx; }
.home-feedback-detail { font-size: 24rpx; line-height: 1.6; color: #526277; margin-top: 8rpx; word-break: break-all; }
.home-loading { min-height: 480rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; }
.home-loading-mark { width: 40rpx; height: 40rpx; border: 4rpx solid #CFE1F2; border-top-color: #356B9F; border-radius: 50%; }
.home-loading-title { font-size: 30rpx; color: #384C63; font-weight: 600; }
.home-loading-sub { font-size: 26rpx; color: #637083; }
.station-welcome { margin-top: 24rpx; padding: 48rpx 32rpx 40rpx; text-align: center; display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.9); }
.station-welcome-art { width: 240rpx; height: 160rpx; position: relative; margin-bottom: 24rpx; }
.station-welcome-route { position: absolute; width: 168rpx; height: 62rpx; left: 30rpx; bottom: 12rpx; border: 2rpx dashed #A9C9E4; border-radius: 50%; transform: rotate(-12deg); }
.station-welcome-pin { position: absolute; left: 38rpx; top: 4rpx; width: 58rpx; height: 72rpx; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #D8EAF8; border: 3rpx solid #7FAACD; }
.station-welcome-pin > view { position: absolute; width: 18rpx; height: 18rpx; border-radius: 50%; background: #5D8FB7; left: 18rpx; top: 20rpx; }
.station-welcome-house { position: absolute; right: 28rpx; bottom: 32rpx; width: 78rpx; height: 62rpx; border: 3rpx solid #82A7C5; border-radius: 8rpx; background: #F3F8FC; }
.station-welcome-house::before { content: ''; position: absolute; width: 54rpx; height: 54rpx; left: 9rpx; top: -29rpx; border-top: 3rpx solid #82A7C5; border-left: 3rpx solid #82A7C5; transform: rotate(45deg); background: #F3F8FC; z-index: -1; }
.station-welcome-house > view { width: 22rpx; height: 34rpx; margin: 26rpx auto 0; background: #D8EAF8; border-radius: 5rpx 5rpx 0 0; }
.station-welcome-kicker { color: #587D9E; font-size: 24rpx; line-height: 1.5; margin-bottom: 16rpx; }
.station-welcome-title { color: #25384C; font-size: 36rpx; font-weight: 600; line-height: 1.5; }
.station-welcome-desc { color: #637083; font-size: 26rpx; line-height: 1.7; margin-top: 16rpx; }
.home-primary { width: 100%; box-sizing: border-box; min-height: 96rpx; margin: 32rpx 0 0; padding: 24rpx; border-radius: 18rpx; background: var(--primary-color); color: white; font-size: 30rpx; font-weight: 600; line-height: 1.5; display: flex; align-items: center; justify-content: center; }
.home-text-action { margin: 12rpx 0 0; min-height: 88rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #365F86; line-height: 1.5; background: transparent; }
.catalog-state { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 36rpx 32rpx 20rpx; }
.catalog-state-mark { width: 88rpx; height: 88rpx; border-radius: 50%; background: #EBF2F8; color: #5C7C98; font-size: 40rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.catalog-state-title { color: #25384C; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.catalog-state-desc { color: #637083; font-size: 26rpx; line-height: 1.7; margin-top: 14rpx; }
.catalog-state .home-primary { margin-top: 24rpx; }
.sum-recovery { display: block; color: #8A5B2D; font-size: 24rpx; line-height: 1.5; margin-top: 8rpx; }

/* 小屏仍保留实际触控尺寸，避免rpx随320px视口缩到44px以下。 */
.home-feedback-retry, .home-feedback-toggle, .home-text-action { min-height: 44px; min-width: 44px; }
.home-primary { min-height: 48px; }
.station-welcome-house { z-index: 0; }
