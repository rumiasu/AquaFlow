/* ========== AquaFlow 清泉青蓝设计系统 ========== */
page {
  /* 主色 - 清泉青蓝（更贴近"水"的联想） */
  --primary-color: #0EA5E9;
  --primary-light: #38BDF8;
  --primary-dark: #0369A1;
  --primary-bg: rgba(14, 165, 233, 0.08);

  --accent-color: #0EA5E9;
  --accent-gradient: linear-gradient(135deg, #38BDF8 0%, #0EA5E9 100%);
  --primary-gradient: linear-gradient(135deg, #0EA5E9 0%, #0369A1 100%);
  --header-gradient: linear-gradient(135deg, #38BDF8 0%, #0EA5E9 50%, #0369A1 100%);

  /* 功能色 */
  --success-color: #10B981;
  --warning-color: #F59E0B;
  --error-color: #EF4444;
  --info-color: #0EA5E9;

  /* 价格色 */
  --price-color: #EF4444;

  /* 中性色 */
  --text-primary: #0F172A;
  --text-regular: #475569;
  --text-secondary: #94A3B8;
  --text-placeholder: #CBD5E1;

  /* 背景色 */
  --bg-color: #F1F5F9;
  --bg-white: #FFFFFF;
  --bg-gray: #F8FAFC;
  --bg-card: #FFFFFF;

  /* 边框 */
  --border-color: #E2E8F0;
  --border-light: #F1F5F9;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 999rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(15, 23, 42, 0.08);
  --shadow-primary: 0 8rpx 24rpx rgba(14, 165, 233, 0.25);
}
