/* ========== 页面 ========== */
.page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 140rpx;
}

/* ========== 顶部 Logo 头 ========== */
.header {
  position: relative;
  padding-top: env(safe-area-inset-top);
  background: var(--header-gradient);
  border-radius: 0 0 40rpx 40rpx;
}

.header-bg {
  display: none;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 24rpx;
}

.logo-row {
  display: flex;
  align-items: center;
}

.logo-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 255, 255, 0.3);
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.logo-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.logo-slogan {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* ========== Banner ========== */
.banner {
  position: relative;
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  height: 320rpx;
  background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
  box-shadow: var(--shadow-md);
}

.banner-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.banner-overlay {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  background: linear-gradient(90deg, rgba(3, 105, 161, 0.55) 0%, rgba(14, 165, 233, 0.15) 60%, rgba(255, 255, 255, 0) 100%);
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(3, 105, 161, 0.3);
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  display: block;
  margin-bottom: 24rpx;
}

.banner-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 0 40rpx;
  height: 64rpx;
  width: fit-content;
  box-shadow: 0 4rpx 16rpx rgba(3, 105, 161, 0.25);
}

.banner-btn text {
  color: var(--primary-dark);
  font-size: 26rpx;
  font-weight: 600;
}

/* ========== 地址栏 ========== */
.address-section {
  padding: 24rpx 32rpx 0;
}

.address-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.address-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.address-text {
  flex: 1;
  overflow: hidden;
}

.address-detail {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-empty {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.address-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== 金刚位 ========== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 32rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.action-icon-primary {
  background: linear-gradient(135deg, #0EA5E9, #0369A1);
}

.action-icon-success {
  background: linear-gradient(135deg, #10B981, #047857);
}

.action-icon-warning {
  background: linear-gradient(135deg, #F59E0B, #D97706);
}

.action-icon-accent {
  background: linear-gradient(135deg, #38BDF8, #0284C7);
}

.action-text {
  font-size: 24rpx;
  color: var(--text-regular);
  font-weight: 500;
}

/* ========== 通用区块 ========== */
.section {
  padding: 32rpx 32rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
}

.section-link {
  font-size: 24rpx;
  color: var(--primary-color);
}

/* ========== 常用订单 ========== */
.recent-order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.recent-order-items {
  margin-bottom: 16rpx;
}

.recent-order-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.recent-order-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-order-item-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.recent-order-item-qty {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.recent-order-footer {
  display: flex;
  align-items: center;
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}

.recent-order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price-color);
  flex-shrink: 0;
}

.recent-order-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
  margin-left: 16rpx;
}

.recent-order-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-bg);
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.recent-order-btn icon {
  margin-right: 8rpx;
}

.recent-order-btn text {
  color: var(--primary-color);
  font-size: 26rpx;
  font-weight: 600;
}

/* ========== 我的水桶（站级汇总 + 明细/续购） ========== */
.barrel-summary {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: var(--shadow-sm);
  margin-bottom: 16rpx;
}

.bs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.bs-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: var(--border-light);
}

.bs-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.bs-num.owed {
  color: var(--error-color);
}

.bs-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.owed-tip {
  font-size: 22rpx;
  color: #D97706;
  background: #FFFBEB;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.barrel-sub-header {
  margin: 8rpx 0 16rpx;
}

.barrel-sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-regular);
}

/* 商品卡内的桶明细行 */
.barrel-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.barrel-meta {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--primary-color);
}

.barrel-meta.transit {
  color: #F59E0B;
}

.barrel-meta.deposit {
  color: var(--text-secondary);
}

.barrel-empty {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
}

/* ========== P6: 水站选择栏 ========== */
.station-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.station-bar-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-left: 12rpx;
}

.station-bar-empty {
  color: var(--text-secondary);
}

/* ========== P6: 无水站引导 ========== */
.no-station-section {
  padding: 60rpx 32rpx;
}

.no-station-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  box-shadow: var(--shadow-sm);
}

.no-station-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 20rpx;
}

.no-station-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  margin-bottom: 32rpx;
}

.no-station-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-gradient);
  border-radius: var(--radius-round);
  padding: 0 48rpx;
  height: 72rpx;
  box-shadow: var(--shadow-primary);
}

.no-station-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== P6: 水站选择弹窗 ========== */
.station-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.station-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
}

.station-picker.show {
  transform: translateY(0);
}

.station-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.station-picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.station-picker-close {
  padding: 8rpx 16rpx;
}

.station-picker-close text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.station-picker-list {
  padding: 16rpx 0;
  overflow-y: auto;
  max-height: calc(70vh - 100rpx);
}

.station-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  transition: background 0.15s;
}

.station-picker-item:active {
  background: var(--bg-gray);
}

.station-picker-item.active {
  background: var(--primary-bg);
}

.station-picker-item-info {
  flex: 1;
}

.station-picker-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.station-picker-item-addr {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.station-picker-item-check {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.station-picker-empty {
  padding: 60rpx 0;
  text-align: center;
}

.station-picker-empty text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ========== 商品卡片（与配送端一致） ========== */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.product-card:active {
  opacity: 0.85;
}

.product-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.product-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img-placeholder text {
  font-size: 56rpx;
}

.product-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.product-brand {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price-color);
}

.product-deposit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.barrel-tag {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.stepper-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0;
  margin-top: 4rpx;
}

.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn:active {
  opacity: 0.7;
}

.stepper-btn.disabled {
  opacity: 0.35;
}

.stepper-btn text {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
  line-height: 1;
}

.stepper-input {
  width: 72rpx;
  height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 游客 Banner ========== */
.guest-section {
  padding: 32rpx;
}

.guest-banner {
  background: var(--header-gradient);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow-primary);
}

.guest-banner-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: block;
  margin: 0 auto 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 255, 255, 0.3);
}

.guest-banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.guest-banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 32rpx;
}

.guest-banner-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 48rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.guest-banner-btn text {
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 商城入口（section header 内联） ========== */
.shop-entry {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.shop-entry-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ========== 商城入口卡片 ========== */
.shop-banner {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-light);
}

.shop-banner:active {
  transform: scale(0.98);
  background: var(--bg-gray);
}

.shop-banner-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.shop-banner-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-primary);
}

.shop-banner-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.shop-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.shop-banner-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-banner-arrow {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.shop-banner-btn-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ========== 浮动购物车 ========== */
.fab-cart {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.4);
  z-index: 90;
}

.fab-cart:active {
  transform: scale(0.92);
}

.fab-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--error-color);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.fab-cart-badge text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}
