.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 74, 104, 0.25);
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.form-area {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 50rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: var(--primary-color);
}

.btn-area {
  width: 100%;
  margin-bottom: 40rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(46, 74, 104, 0.4);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-dev {
  width: 100%;
  height: 80rpx;
  background: #F4EFE4;
  color: #999;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 24rpx;
}

.btn-dev::after {
  border: none;
}

/* [2026-09-24] 「点击即同意」的告知行：贴在登录按钮正下方，居中。
   原来是 margin-bottom（它当时是页面最后一个块）；现在它夹在按钮与"开发者登录"之间，
   改成上下留白，避免和按钮挤在一起。
   ⚠️ .checkbox / .checkbox.checked / .check-icon 三条规则已删 —— 必须勾选的复选框
   随产品要求去掉了，规则留着会让人以为界面上还有个勾选框。 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

/* [2026-09-27 走查 X01] `.agreement-link` 已删：两个协议名原先看起来可点、实际没有点击处理。
   协议正文到位前按普通说明文字渲染（顾客端 pages/login 同口径）。 */
.agreement-strong {
  font-size: 24rpx;
  color: #fff;
}

.tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #bbb;
}
