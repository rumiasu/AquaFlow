<view class="page">
  <text class="title">先交桶押金，再买票或订水</text>
  <text class="tip">{{stationName}} · 押金由所选水站保管。这里仅购买用桶权益，不含水；水桶随下次送水送达。</text>
  <text class="error" wx:if="{{error}}">{{error}}</text>
  <view class="recovery" wx:if="{{recoveryEntries.length > 0 || recoveryError}}">
    <text class="section-title">原桶押金购买</text>
    <text class="tip">结果未确认时，原购买会一直保留。查询或恢复原请求不需要重新选择商品或确认现价。</text>
    <text class="error" wx:if="{{recoveryError}}">{{recoveryError}}</text>
    <text class="tip" wx:if="{{recoveryHint}}">{{recoveryHint}}</text>
    <view class="recovery-record" wx:for="{{recoveryEntries}}" wx:key="key">
      <text class="record-id">{{item.active ? '当前原购买' : '已保留原购买'}} · 请求编号 {{item.key}}</text>
      <text>{{item.summary}}</text>
      <text class="tip" wx:if="{{item.known}}">购买编号 {{item.record.id}} · ¥{{item.record.amount}} · {{item.record.statusText}}</text>
      <text class="tip" wx:else>原购买结果尚未确认，请勿改内容重复购买。</text>
      <button data-key="{{item.key}}" bindtap="onQueryOriginal" disabled="{{busy || recoveryBusy || safetyBlocked}}" loading="{{recoveryBusy}}">查询原购买</button>
      <button wx:if="{{!item.known || item.record.status === 'PENDING'}}" data-key="{{item.key}}" bindtap="onRetryOriginal" disabled="{{busy || recoveryBusy || safetyBlocked}}" loading="{{busy}}">恢复原请求</button>
    </view>
    <button wx:if="{{canAnother}}" bindtap="onAnotherPurchase" disabled="{{busy || recoveryBusy || safetyBlocked}}">明确另买一笔</button>
  </view>
  <text class="tip" wx:if="{{productsLoading}}">正在加载可购买商品…</text>
  <view wx:elif="{{productsError}}">
    <text class="error">{{productsError}}</text>
    <button bindtap="loadProducts" disabled="{{busy}}">重试加载商品</button>
  </view>
  <text class="tip" wx:elif="{{productsLoaded && products.length === 0}}">该站暂无可购买押金的桶装水，已有购买记录仍可在下方查看。</text>
  <view wx:elif="{{productsLoaded}}">
    <picker range="{{products}}" range-key="name" value="{{index}}" bindchange="onProduct" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}"><view class="field">商品：{{products[index].name || '请选择'}}</view></picker>
    <view class="field">数量 <input type="number" value="{{quantity}}" bindinput="onQuantity" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}" /></view>
  </view>
  <text class="tip" wx:if="{{quoteLoading}}">正在确认本次押金金额…</text>
  <view wx:elif="{{quoteError}}">
    <text class="error">{{quoteError}}</text>
    <button bindtap="refreshQuote" disabled="{{busy}}">重试确认金额</button>
  </view>
  <view wx:elif="{{quote}}">
    <text class="amount">本次押金 ¥{{quote.amount}}</text>
    <text class="tip">{{quote.notice}}</text>
    <button data-method="2" bindtap="onMethod" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}">{{paymentMethod === 2 ? '已选：' : ''}}向水站交现金，等收款确认</button>
    <button wx:if="{{quote.onlineAvailable}}" data-method="1" bindtap="onMethod" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}">{{paymentMethod === 1 ? '已选：' : ''}}微信支付</button>
  </view>
  <button bindtap="onPurchase" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked || !quote || quoteLoading || productsLoading || !productsLoaded || productsError || products.length === 0}}" loading="{{busy}}">确认新的桶押金购买</button>
  <button bindtap="onBack">返回继续下单</button>
  <view class="history">
    <text class="section-title">已有桶押金购买记录</text>
    <text class="tip">商品下架不影响查询原购买记录。已交钱但水站尚未确认的，请先联系水站核实，勿直接撤回。</text>
    <text class="tip" wx:if="{{purchasesLoading}}">正在加载购买记录…</text>
    <view wx:elif="{{purchasesError}}">
      <text class="error">{{purchasesError}}</text>
      <text class="tip" wx:if="{{purchases.length > 0}}">下方为上次加载的记录，请重试确认最新状态后再办理。</text>
    </view>
    <text class="tip" wx:elif="{{purchasesLoaded && purchases.length === 0}}">该站暂无桶押金购买记录。</text>
    <button wx:if="{{stationId}}" bindtap="loadPurchases" disabled="{{purchasesLoading || withdrawingId}}" loading="{{purchasesLoading}}">{{purchasesError ? '重试加载购买记录' : '刷新购买记录'}}</button>
    <view class="record" wx:for="{{purchases}}" wx:key="id">
      <text class="record-id">购买编号 {{item.id}}</text>
      <text>购买 {{item.quantity}} 个 · ¥{{item.amount}} · {{item.statusText}}</text>
      <button wx:if="{{item.status === 'PENDING'}}" data-id="{{item.id}}" bindtap="onWithdraw" disabled="{{busy || purchasesLoading || purchasesError || withdrawingId}}" loading="{{withdrawingId === item.id}}">撤回尚未交款的购买</button>
    </view>
  </view>
</view>
