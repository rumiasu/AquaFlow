.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

.about-section {
  padding: 48rpx 24rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-section {
  background-color: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 48rpx;
  box-shadow: var(--shadow-sm);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item:active {
  background-color: var(--bg-gray);
}

.info-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.info-arrow {
  color: var(--text-placeholder);
  font-size: 32rpx;
}

.copyright {
  text-align: center;
}

.copyright text {
  display: block;
  font-size: 24rpx;
  color: var(--text-placeholder);
  line-height: 1.8;
}
