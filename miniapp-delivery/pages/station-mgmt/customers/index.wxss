.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }
.search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-input { flex: 1; background: var(--bg-card); border-radius: 40rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.search-btn { background: var(--primary-gradient); color: #fff; border-radius: 40rpx; padding: 0 32rpx; display: flex; align-items: center; font-size: 28rpx; }
.customer-card { background: var(--bg-card); border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; }
.customer-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.customer-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.customer-type { font-size: 22rpx; color: var(--primary); align-self: flex-start; padding: 2rpx 14rpx; border-radius: 20rpx; background: var(--primary-bg); }
.customer-phone { font-size: 26rpx; color: var(--text-secondary); }
.customer-address { font-size: 24rpx; color: var(--text-secondary); }
.call-btn { background: var(--success-color); color: #fff; border-radius: 40rpx; padding: 16rpx 32rpx; font-size: 26rpx; margin-left: 20rpx; }
.empty, .loading { text-align: center; color: var(--text-secondary); font-size: var(--font-md); padding-top: 120rpx; }