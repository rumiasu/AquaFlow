.page-container { padding: 24rpx; }

.status-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

/* 状态卡片配色：与本端「状态色 = 绿完成 / 琥珀需关注 / 红失败」的规则一致。
   ⚠️ [2026-09-26] 补 .status-card.status-2（配送中）—— 原来只定义了 1/3/4/5/6/7，
   而 OrderStatus 的 2 = 配送中（constant/OrderStatus.java），于是**配送中的单整张卡
   没有任何状态配色**：客户最关心"到哪一步了"的那个状态反而最不显眼。 */
.status-card.status-1 { border-left: 8rpx solid var(--warning-color); }
.status-card.status-2 { border-left: 8rpx solid var(--info-color); }
.status-card.status-3 { border-left: 8rpx solid var(--primary-color); }
.status-card.status-4 { border-left: 8rpx solid #7c3aed; }
.status-card.status-5 { border-left: 8rpx solid var(--success-color); }
.status-card.status-6 { border-left: 8rpx solid var(--error-color); }
.status-card.status-7 { border-left: 8rpx solid var(--error-color); }

.status-main {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pay-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.pay-badge.success {
  background: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
}

.pay-badge.warning {
  background: rgba(217, 119, 6, 0.08);
  color: var(--warning-color);
}

.pay-badge.default {
  background: var(--bg-gray);
  color: var(--text-secondary);
}

.collect-banner {
  background: rgba(217, 119, 6, 0.1);
  color: var(--warning-color);
  border: 1rpx solid rgba(217, 119, 6, 0.3);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.info-section {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 费用明细的合计行：与上面的分项拉开层次（不另起卡片，避免与「桶资产」重复成两张表） */
.fee-total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f3;
}

.fee-total .label,
.fee-total .value {
  font-weight: 600;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.pay-hint {
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.btn-action {
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  font-weight: 500;
}

.btn-cancel {
  background: rgba(220, 38, 38, 0.06);
  color: var(--error-color);
}

.btn-reorder {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.btn-call {
  background: rgba(5, 150, 105, 0.06);
  color: var(--success-color);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.order-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--bg-gray);
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-gray);
}

.item-thumb-img {
  width: 100%;
  height: 100%;
}

.item-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

/*
 * ⚠️ 商品名**不许截断**（2026-09-27 产品口径：「商品信息需要显示好，不要隐藏省略」）：
 * 原先这里是 `overflow:hidden + text-overflow:ellipsis + white-space:nowrap`，
 * 名字长一点就变成「农夫山泉 19L 桶装水（整箱…」——客户看不出自己买的到底哪款。
 * 改成允许换行；`.item-info` 已有 `min-width: 0`（flex 子项能收缩的前提），别删它。
 */
.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  word-break: break-all;
}

.item-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.item-right {
  text-align: right;
  flex-shrink: 0;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.item-qty {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}
