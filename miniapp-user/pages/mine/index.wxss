.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.user-section {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  padding: 48rpx 24rpx 60rpx;
}

.user-info,
.login-section {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.edit-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 12rpx;
}

.login-text {
  font-size: 32rpx;
  color: #fff;
}

/* 水桶押金概况卡片 */
.barrel-summary-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.barrel-row {
  display: flex;
  align-items: center;
}

.barrel-item {
  flex: 1;
  text-align: center;
}

.barrel-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.barrel-num.deposit {
  color: #ff6b35;
}

.barrel-label {
  font-size: 22rpx;
  color: #999;
}

.barrel-divider {
  width: 1rpx;
  height: 48rpx;
  background: #f0e6d6;
}

.barrel-detail-link {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.menu-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-title {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.logout-section {
  padding: 48rpx 24rpx;
}

.logout-btn {
  height: 88rpx;
  background-color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff4d4f;
  font-size: 30rpx;
}
