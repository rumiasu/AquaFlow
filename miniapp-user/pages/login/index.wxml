<view class="page">
  <view class="login-bg"></view>
  <view class="login-content">
    <view class="logo-section">
      <view class="logo-wrap">
        <image class="logo" src="/assets/logo/aiquan-mark.png" mode="aspectFit"></image>
      </view>
      <view class="af-brand-wordmark">
        <image wx:if="{{!brandWordmarkFailed}}" class="af-brand-wordmark-image" src="/assets/logo/aiquan-wordmark.png" mode="aspectFit" aria-label="艾泉 AquaFlow" binderror="onBrandWordmarkError" />
        <view wx:else class="af-brand-wordmark-fallback"><text class="af-brand-name">艾泉</text><text class="af-brand-english">AquaFlow</text></view>
      </view>
      <text class="af-brand-function">订水</text>
    </view>

    <view class="login-section">
      <!-- 微信一键登录：仅 wx.login 静默换 openid，不弹任何授权框 -->
      <button class="af-action af-action--primary af-action--block" bindtap="onWxLogin" disabled="{{loading}}">
        <text wx:if="{{loading}}">登录中...</text>
        <text wx:else>微信一键登录</text>
      </button>
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>

      <!-- 当前草稿如实告知未启用；仍不新增强制复选框或把登录视为全部隐私处理授权。 -->
      <view class="agreement">
        <text class="agreement-text">{{agreementNotice}}</text>
        <text class="agreement-text agreement-link" bindtap="onOpenAgreement" data-type="user">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-text agreement-link" bindtap="onOpenAgreement" data-type="privacy">《隐私政策》</text>
      </view>

    <view class="test-login" wx:if="{{showTestLogin}}">
      <text class="test-login-title">测试账号登录</text>
      <input class="test-login-input" value="{{testAccount}}" placeholder="测试账号" maxlength="48" bindinput="onTestAccountInput" disabled="{{loading}}" />
      <input class="test-login-input" value="{{testPassword}}" placeholder="密码" password="{{true}}" maxlength="72" bindinput="onTestPasswordInput" disabled="{{loading}}" />
      <button class="af-action af-action--quiet af-action--block" bindtap="onTestLogin" loading="{{loading}}" disabled="{{loading}}">登录测试账号</button>
    </view>
    </view>
  </view>
</view>
<business-dialog id="business-dialog" />
