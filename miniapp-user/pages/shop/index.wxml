<page-meta page-style="{{showStationPicker ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="container">
  <loading wx:if="{{loading}}"></loading>
  <block wx:else>
    <!--
      游客登录入口。[2026-09-26 Wave3 H1] 原来这页顶部是一整块品牌头（logo + AquaFlow + 口号
      「新鲜水源 · 快速配送 · 品质保障」），登录入口是它里面那个小胶囊，文案「登录下单享优惠」——
      全仓没有任何优惠事实来源（js 里没有优惠/券字段），属于无凭据承诺，整块一并去掉（docs/design/29 §1/§3）。
      ⚠️ 登录入口本身**不能跟着删**：本页没有独立的游客卡（首页 pages/home 有），
      这块是游客在本页唯一的登录入口，删了游客就只剩「请先登录」的 toast、无处可点。
    -->
    <view class="guest-login" wx:if="{{!isLogin}}" bindtap="onLogin">
      <view class="guest-login-text">
        <text class="guest-login-title">登录后可下单</text>
        <text class="guest-login-desc">先选服务水站，再看本站商品与价格</text>
      </view>
      <text class="guest-login-arrow">›</text>
    </view>

    <!-- 水站营业状态（软状态）：只提示、不隐藏商品、不拦截下单 -->
    <view class="station-status-banner" wx:if="{{stationStatusHint}}">
      <text class="banner-text">{{stationStatusHint}}</text>
    </view>

    <!--
      商品没加载出来的提示（空串时不渲染）。[2026-09-20 真机联调] 原来商品接口失败被静默吞成空数组，
      页面显示「暂无商品」—— 顾客会以为这个水站没货可买（AGENTS §8.22）。
      样式复用 styles/common.wxss 的 .load-error（全局已 import，不要再写一份）。
    -->
    <view class="load-error" wx:if="{{loadError}}">{{loadError}}<button bindtap="onRetryProducts">重新加载商品</button></view>

    <view class="station-bar" wx:if="{{isLogin}}" bindtap="onOpenStationPicker">
      <icon name="location" size="32rpx" color="#1677FF" />
      <text class="station-bar-label" wx:if="{{currentStation}}">{{currentStation.name}}</text>
      <text class="station-bar-label station-bar-empty" wx:else>请选择水站查看商品</text>
      <view class="station-bar-switch">
        <text>切换</text>
      </view>
    </view>

    <view class="search-bar">
      <view class="search-input-wrap">
        <icon name="search" size="32rpx" color="#94A3B8" />
        <input class="search-input" placeholder="搜索商品" value="{{keywords}}" bindinput="onSearch" focus="{{focusSearch}}" />
        <text class="search-clear" wx:if="{{keywords}}" bindtap="onClearSearch">×</text>
      </view>
    </view>

    <view class="section">
      <!-- 商品目录：入口在首页「更多商品 ›」/「搜索 ›」（两者都落到本页，?focus=1 时自动聚焦搜索框） -->
      <text class="section-title">商品目录</text>
      <text class="catalog-note">商品价格为本站零售价；水票、配送费及新增押金在确认页核算。</text>
      <view class="product-grid">
        <view class="product-card"
          wx:for="{{visibleProducts}}" wx:key="id">
          <view class="product-img" wx:if="{{item.imageUrl}}">
            <image src="{{item.imageUrl}}" mode="aspectFit" style="width:100%;height:100%;" data-id="{{item.id}}" data-url="{{item.imageUrl}}" binderror="onProductImageError" />
          </view>
          <view class="product-img product-img-placeholder" wx:else>
          </view>
          <view class="product-info">
            <view class="name-row">
              <text class="product-name">{{item.name}}</text>
            </view>
            <text class="product-image-note" wx:if="{{item.imageUrl === '/assets/product/barrel-neutral-template.webp'}}">商品示意图 · 包装以实物为准</text>
            <text class="product-brand" wx:if="{{item.brand || item.spec}}">{{item.brand}}{{item.brand && item.spec ? ' · ' : ''}}{{item.spec}}</text>
            <view class="info-row">
              <!-- 本站有效价（站级覆盖 → 通用库参考价），后端下发，前端不再自己拼价 -->
              <text class="product-price">¥{{item.effectivePrice}}</text>
              <text class="product-deposit" wx:if="{{item.effectiveDeposit > 0}}">桶押金参考 ¥{{item.effectiveDeposit}}</text>
            </view>
            <view class="btn-row">
              <!-- [2026-10-07 #12] 术语统一为「订水清单」（与首页"加入清单/去结算"同链，
                   正本 docs/design/36 §4）；JS 侧 toast 随 GPT 的购物车持久化一起改。 -->
              <view class="cart-btn" bindtap="onAddToCart" data-id="{{item.id}}">
                <text>加入清单</text>
              </view>
              <view class="buy-btn {{isLogin ? '' : 'login-required'}}" bindtap="onBuyNow" data-id="{{item.id}}">
                <text>选购此商品</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <!-- [2026-09-20] 空态分两种：loadError 非空 = 商品没拉到（不是"这个站没商品"） -->
      <view class="local-empty" wx:if="{{!currentStationId && !loadError}}"><text>请选择水站查看本站商品</text></view>
      <view class="local-empty" wx:elif="{{allProducts.length === 0 && !loadError}}"><text>本站暂无在售商品</text></view>
      <view class="local-empty" wx:elif="{{keywords && !visibleProducts.length && !loadError}}"><text>没有找到匹配的商品，可清空搜索再看</text></view>
    </view>
  </block>

  <view class="fab-cart" wx:if="{{isLogin && cartCount > 0}}" bindtap="onGoCheckout">
    <icon name="cart" size="40rpx" color="#FFFFFF" />
    <view class="fab-cart-badge">
      <text>{{cartCount}}</text>
    </view>
  </view>

  <page-container show="{{showStationPicker}}" position="bottom" overlay="{{false}}" close-on-slide-down="{{false}}" duration="{{0}}" custom-style="height:100%;background:transparent;" bindbeforeleave="onStationPickerBeforeLeave">
  <view class="station-picker-mask" wx:if="{{showStationPicker}}" bindtap="onCloseStationPicker"></view>
  <view class="station-picker {{showStationPicker ? 'show' : ''}}">
    <view class="station-picker-header">
      <text class="station-picker-title">选择水站</text>
      <view class="station-picker-close" bindtap="onCloseStationPicker">
        <text>关闭</text>
      </view>
    </view>
    <view class="station-picker-list">
      <text class="station-picker-empty" wx:if="{{stationListLoading}}">正在读取水站列表…</text>
      <view class="station-picker-item {{item.id === currentStationId ? 'active' : ''}}" wx:for="{{stationList}}" wx:key="id"
            bindtap="onSelectStation" data-id="{{item.id}}">
        <view class="station-picker-item-info">
          <text class="station-picker-item-name">{{item.name}}</text>
          <text class="station-picker-item-addr" wx:if="{{item.address}}">{{item.address}}</text>
        </view>
        <text class="station-picker-item-check" wx:if="{{item.id === currentStationId}}">当前</text>
      </view>
      <!--
        空态分两种：[2026-09-20] 原来只有「暂无可用水站」—— 接口失败时列表同样是空的，
        于是"没查到"被说成"平台确实没有水站"（AGENTS §8.22）。
        stationListError 由 loadStationList 在失败时写入（含可读原因）。
      -->
      <view class="station-picker-empty" wx:if="{{!stationListLoading && stationList.length === 0}}">
        <text wx:if="{{stationListError}}">水站列表没加载出来（{{stationListError}}），请稍后重试</text>
        <text wx:else>暂无可用水站</text>
      </view>
      <button wx:if="{{stationListError}}" bindtap="loadStationList" disabled="{{stationListLoading}}">重新加载水站</button>
    </view>
  </view>
  </page-container>
</view>
<business-dialog id="business-dialog" />
