.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 通用区块 */
.section {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: 12rpx;
  box-shadow: none;
  padding: var(--spacing-lg);
  border: 1rpx solid var(--border-color);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-lg);
  display: block;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.info-value {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
  flex: 1;
}

/* 「所属水站」缺名称时的重试入口（[2026-09-27 走查 D06]）：
   已绑定但名字没拉到时，说的是「名称暂未加载」+ 可点这一下补拉，不再写成「未分配」。 */
.info-retry {
  font-size: var(--font-sm);
  color: var(--primary-color);
  margin-left: 16rpx;
  flex-shrink: 0;
  min-height: 96rpx;
  display: flex;
  align-items: center;
}

/* 设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 112rpx;
  box-sizing: border-box;
}

.setting-row:last-child {
  border-bottom: none;
}

/* 带副标题的设置行（如「待办提醒」）：文字竖排、开关靠右 */
.setting-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.setting-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.setting-label {
  font-size: var(--font-md);
  color: var(--text-primary);
}

.setting-arrow {
  font-size: var(--font-lg);
  color: var(--text-secondary);
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: var(--spacing-xl) var(--spacing-lg);
}

.version-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.logout-btn { min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-size: 14px; color: var(--error-color); }

/* 2026-10-28：本页信息层级、小屏长字与触控下限；业务语义由原数据决定。 */
button:not(.af-action):not(.af-choice) { min-height:44px; height:auto; line-height:1.45; white-space:normal; box-sizing:border-box; }
.btn-primary,.primary-button,.btn-confirm { min-height:48px; }

.section { border:1px solid #dbe3ed; box-shadow:none; border-radius:12px; }
.info-row,.setting-row,.logout-btn { min-height:52px; box-sizing:border-box; }
.info-value { min-width:0; overflow-wrap:anywhere; }
.info-retry { min-height:44px; min-width:44px; display:flex; align-items:center; justify-content:center; }
.setting-sub { font-size:14px; line-height:1.6; }
.logout-btn { background:#fff; border:1px solid #e6c8c5; color:#ad3b31; }
.version-text { font-size:13px; line-height:1.6; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .b2-setting-row { justify-content: space-between; gap: 12px; padding: 12px 16px; } .b2-logout { margin: 24px auto; }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-settings { padding:20px 16px 28px; }
.lv2-settings .section { margin:0 0 16px; padding:16px; background:var(--af2-surface); border:0; border-radius:16px; box-shadow:none; }
.lv2-settings .section-title { font-size:13px; line-height:20px; color:var(--af2-muted); margin-bottom:10px; font-weight:400; }
.lv2-settings .info-row { display:flex; align-items:center; gap:12px; padding:12px 0; min-height:48px; box-sizing:border-box; }
.lv2-settings .info-label { font-size:14px; line-height:22px; flex:0 0 72px; }
.lv2-settings .info-value { font-size:15px; line-height:23px; min-width:0; overflow-wrap:anywhere; }
.lv2-settings .b2-setting-row { padding:10px 0; min-height:56px; }
.lv2-settings .setting-label { flex:1; font-size:15px; line-height:23px; }
.lv2-settings .setting-sub { font-size:13px; line-height:21px; }
.lv2-settings .b2-logout { margin:0; width:100%; color:var(--af2-ink-neutral); }
.lv2-settings .logout-text { font-size:15px; line-height:23px; color:inherit; }
.lv2-settings .version-text { font-size:12px; line-height:20px; }
