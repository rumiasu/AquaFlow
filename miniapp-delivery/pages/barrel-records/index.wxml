<view class="container b2-page b2-d39 af2-page lv2-page lv2-barrels">
  <view class="page-state" wx:if="{{loading}}"><text class="page-state-text">{{loaded ? '正在刷新...' : '加载中...'}}</text></view>
  <view class="page-state" wx:if="{{error}}"><text class="page-state-text page-state-error">{{error}}</text><button bindtap="onRetry" class="af-action af-action--quiet"><view class="af-action__face">重试</view></button></view>
<view class="lv2-title-row"><view class="af2-icon-tile lv2-physical-tile"><icon name="barrel" size="24px" color="#235F5A" variant="duotone" fill-color="#D8EFED" /></view><text>空桶记录</text></view>
  <view class="summary-card" wx:if="{{loaded && records.length}}">
    <view class="summary-item">
      <text class="summary-num">{{totalDeliveries}}</text>
      <text class="summary-label">本次记录</text>
    </view>
    <view class="summary-item">
      <text class="summary-num">{{totalReturnText}}</text>
      <text class="summary-label">已知回收（桶）</text>
    </view>
    <view class="summary-item">
      <text class="summary-num warn">{{totalShortText}}</text><text class="summary-label">已知少回（桶）</text>
    </view>
    <view class="summary-item"><text class="summary-num">{{totalExtraText}}</text><text class="summary-label">已知多回（桶）</text>
    </view>
  </view>

  <text class="known-scope" wx:if="{{loaded && (unknownReturn || unknownDiscrepancy)}}">{{unknownReturn}} 条回收量、{{unknownDiscrepancy}} 条差异未提供，未计入对应小计。</text>
  <view class="record-list">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-top">
        <!-- 跨站履约单后端刻意不下发 customerName（画像归归属站）→ 回落订单收件人 -->
        <text class="record-customer">{{item.customerName || item.receiverName || '未知客户'}}</text>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-address" wx:if="{{item.addressDetail}}">{{item.addressDetail}}</view>
      <view class="record-meta">
        <text class="meta-bucket">配送 {{item.quantity}}桶</text>
        <text class="meta-divider">|</text>
        <text class="meta-bucket">{{item.returnText}}</text>
        <text class="meta-divider">|</text>
        <text class="meta-bucket">{{item.firstProductName}}</text>
      </view>
      <view class="record-bottom" wx:if="{{item.hasDiscrepancy || !item.discKnown}}">
        <text class="discrepancy-tag {{item.discTagClass}}">
          {{item.discLabel}}<text wx:if="{{item.discKnown}}"> {{item.discAbsText}}桶</text>
        </text>
        <text class="discrepancy-note" wx:if="{{item.barrelDiscrepancyNote}}">{{item.barrelDiscrepancyNote}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && !loading && !error && records.length === 0}}">
    <view class="af2-icon-tile lv2-physical-tile"><icon name="barrel" size="32px" color="#235F5A" variant="duotone" fill-color="#D8EFED" /></view><text>暂无空桶回收记录</text>
  </view>
</view>
<business-dialog id="business-dialog" />
