<view class="container af2-page finance-page payments-page">
  <view class="history-tabs"><view class="af-choice {{view === 'pending' ? 'af-choice--selected' : ''}}" bindtap="onSetView" data-key="pending"><text class="af-choice__face">待确认收款</text></view><view class="af-choice {{view === 'ticketHistory' ? 'af-choice--selected' : ''}}" bindtap="onSetView" data-key="ticketHistory"><text class="af-choice__face">水票购买收款历史</text></view></view>
  <view class="history-controls" wx:if="{{view === 'ticketHistory'}}">
    <include src="../../../utils/station-history-customer.wxml" />
    <view class="history-date-row"><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onPaymentHistoryDate"><view>{{startDate || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onPaymentHistoryDate"><view>{{endDate || '结束日期'}}</view></picker><text bindtap="onClearPaymentDates">清除日期</text></view>
    <view class="history-scope">{{historyScope}}</view>
  </view>

  <!--
    [2026-09-27 走查 M01 修] 原文是「这里列出『钱已收到但系统还未确认』的款项」——
    与列表的真实口径**相反**：本页取的是 `payment_record.status = 1`（待收款）的流水，
    而待收款只说明"这单该收钱/客户发起了支付"，**不是到账证明**
    （现金单在下单那一刻就落 PENDING，见 PaymentServiceImpl）。
    原文让人读成"钱已经在我账上了，点一下确认就行"，站长会据此跳过对账。
    现在按事实写：钱还没核实到账，确认动作才是"核对之后登记"。
    文案口径与页面按钮（确认已到账）一致，不再自造一个没有证据的"已到账"状态。
  -->
  <view class="hint payment-caution af2-tone-panel af2-tone-money" wx:if="{{view === 'pending'}}"><view class="finance-section-head"><icon name="wallet" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text class="caution-title">待核实到账</text></view><text>待确认不代表已到账。核对收款方及款项后登记。</text></view>

  <!--
    [2026-09-27 走查 U01 同族修] 加载失败**常驻可见**（原来只有一句会消失的 toast，
    toast 过后页面剩「暂无待确认收款」，与"真的没有待收款"无法区分 —— AGENTS §8.22）。
  -->
  <view class="load-error" wx:if="{{loadError}}">
    <text>记录没加载出来（{{loadError}}），请重试核对。</text>
    <text class="load-error-retry" bindtap="onRetryLoad">重新加载</text>
  </view>

  <view class="record-card" wx:for="{{list}}" wx:key="id">
    <view class="card-header"><view class="record-icon"><icon name="bill" size="22px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /></view><text class="payment-person">{{item.customerName || ('客户编号：' + item.customerId)}}</text><text class="status pending" wx:if="{{view === 'pending'}}">待确认</text><text class="status history-status" wx:else>{{item.statusText}}</text></view>
    <view class="info-row amount-row"><text class="label">{{view === 'pending' ? '本笔待确认金额' : '流水金额'}}</text><text class="amount">¥{{item.amountText}}</text></view>
    <text class="status ticket" wx:if="{{item.isTicketPurchase}}">线上购票</text>
    <view class="info-row" wx:if="{{item.customerPhone}}">
      <text class="label">电话</text>
      <text>{{item.customerPhone}}</text>
    </view>
    <view class="info-row" wx:if="{{item.orderId}}">
      <text class="label">订单</text>
      <text>#{{item.orderId}}{{item.productName ? ' · ' + item.productName : ''}}</text>
    </view>
    <view class="info-row" wx:else>
      <text class="label">类型</text>
      <text>{{item.purposeText}}</text>
    </view>
    <view class="info-row">
      <text class="label">支付方式</text>
      <text>{{item.methodText}}</text>
    </view>
    <view class="info-row" wx:if="{{item.createTime}}">
      <text class="label">生成时间</text>
      <text>{{item.createTime}}</text>
    </view>
    <view class="info-row" wx:if="{{item.isTicketPurchase}}"><text class="label">购票数量</text><text>{{item.ticketQty}} 张</text></view>
    <view class="info-row" wx:if="{{item.isTicketPurchase}}"><text class="label">购票商品</text><text>{{item.productName || (item.ticketWaterTypeId ? '商品 #' + item.ticketWaterTypeId : '商品信息未核对')}}</text></view>
    <view class="card-actions" wx:if="{{view === 'pending'}}">
      <button class="af-action af-action--primary" data-id="{{item.id}}" bindtap="onConfirm">确认已到账</button>
    </view>
  </view>

  <view class="history-more" wx:if="{{view === 'ticketHistory' && historyHasMore}}" bindtap="onHistoryMore">显示更多已取回记录</view>
  <view class="empty" wx:if="{{!loading && !loadError && list.length === 0}}">
    <icon name="wallet" size="24px" variant="duotone" color="#54467C" fill-color="#E7E2F7" /><text>{{view === 'pending' ? '暂无待确认收款' : '当前范围内暂无购票收款记录'}}</text>
  </view>
</view>
<business-dialog id="business-dialog" />
