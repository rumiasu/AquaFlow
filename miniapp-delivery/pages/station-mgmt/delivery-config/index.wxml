<view class="container">
  <view class="card">
    <view class="card-header">
      <view class="card-title-row">
        <text class="card-title">配送计费</text>
        <!-- [2026-09-24] 各段说明藏进「?」：原来本页 5 张卡各平铺一整句，字段反被挤没了。
             藏什么、不藏什么见 components/HelpTip/index.js 文件头。 -->
        <help-tip title="配送计费" text="留空表示「不限 / 不收」。费用在客户下单时快照进订单，改这里不影响历史订单。" />
      </view>
      <text class="badge badge-on" wx:if="{{configured}}">已配置</text>
      <text class="badge badge-warn" wx:else>未配置</text>
    </view>
  </view>

  <!--
    本站「配置完善度」（2026-09-19）：产品要求「所有需要/建议填写的字段，都加一层引导」。
    规则目录在后端 StationSetupGuideService —— 这里只渲染后端给的中文（label / why / where / action），
    前端不自建 key→文案映射。只列"还没配好的"，P0 排前面。
  -->
  <view class="card setup-card" wx:if="{{setupPending.length}}">
    <view class="card-header">
      <text class="card-title">本站还差这些</text>
      <text class="badge badge-warn">{{setup.summaryText}}</text>
    </view>
    <view class="setup-item" wx:for="{{setupPending}}" wx:key="key">
      <view class="setup-head">
        <!-- ⚠️ 渲染 levelText（必填/建议/可选）而不是 level（P0/P1/P2）—— 后者是内部代号，
             摆给站长看等于让他读开发文档（同营业状态小框，2026-09-24）。 -->
        <text class="setup-label">{{item.levelText}} · {{item.label}}</text>
        <view class="setup-head-right">
          <!-- 说明同样藏进「?」：原来每条 why + action 平铺，一屏放不下三项。
               ⚠️ 正文用 js 拼好的 item.helpText —— **不要**写成
               `text="{{item.why}}{{item.suggestion ? '\n\n' + item.suggestion : ''}}"`
               （WXML 表达式解析器吃不下带换行的拼接，会直接编译报错，2026-09-24 实测）。 -->
          <help-tip title="{{item.label}}" text="{{item.helpText}}" />
          <text class="setup-where">去「{{item.where}}」</text>
        </view>
      </view>
    </view>
  </view>

  <!--
    金额门槛引导（2026-09-19）：本站上架了非桶装商品（瓶装水/一次性桶/饮水器）却只配了桶数门槛时，
    那条规则对这类订单其实**不生效** —— 非桶装不占桶。所以这里把站长引到金额字段上；
    建议值由后端按"本站最便宜的一桶水"算好（前端只展示与回填，不自算倍数、不自造文案）。
  -->
  <view class="card guide-card" wx:if="{{guide.requiredAmountFields.length}}">
    <text class="card-title">还差金额门槛</text>
    <text class="card-sub">{{guideText}}</text>
    <button class="btn-fill" bindtap="onFillSuggested">一键填入建议值</button>
  </view>

  <!-- ============ 起送量 ============ -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">起送量</text>
      <help-tip title="起送量" text="桶数与金额满足其一即达门槛；两项都留空 = 不限起送量。没有桶装水的订单（纯瓶装水/饮水机）只按金额核验。" />
    </view>

    <view class="field">
      <text class="label">起送桶数</text>
      <input class="input" type="number" placeholder="如 2（留空=不限）" value="{{form.minOrderBuckets}}" bindinput="onInput" data-field="minOrderBuckets" />
    </view>
    <view class="field">
      <text class="label">起送金额（元）</text>
      <input class="input" type="digit" placeholder="{{guide.suggestedMinOrderAmount ? '建议 ' + guide.suggestedMinOrderAmount + '（留空=不限）' : '如 30（留空=不限）'}}" value="{{form.minOrderAmount}}" bindinput="onInput" data-field="minOrderAmount" />
    </view>

    <text class="label">未达起送量时</text>
    <view class="options">
      <view class="option {{form.minOrderMode === item.value ? 'active' : ''}}" wx:for="{{limitModes}}" wx:key="value"
            bindtap="onPickMode" data-field="minOrderMode" data-value="{{item.value}}">
        <text class="option-name">{{item.name}}</text>
        <text class="option-desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="field" wx:if="{{form.minOrderMode === 'FEE'}}">
      <text class="label">加收金额（元）</text>
      <input class="input" type="digit" placeholder="如 5" value="{{form.minOrderFee}}" bindinput="onInput" data-field="minOrderFee" />
    </view>
  </view>

  <!-- ============ 配送范围 ============ -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">配送范围</text>
      <!-- 正文在 js 里拼好（wxml 里不许做字符串拼接，见 delivery-config/index.js 的 ⚠️）。
           2026-09-24 产品要求：坐标这类概念也藏起来 → 原来那句可见警告并进这里。 -->
      <help-tip title="配送范围" text="{{rangeHelpText}}" />
    </view>

    <view class="field">
      <text class="label">配送半径（米）</text>
      <input class="input" type="number" placeholder="如 3000（留空=不限）" value="{{form.deliveryRadiusM}}" bindinput="onInput" data-field="deliveryRadiusM" />
    </view>

    <text class="label">超出范围时</text>
    <view class="options">
      <view class="option {{form.overRadiusMode === item.value ? 'active' : ''}}" wx:for="{{limitModes}}" wx:key="value"
            bindtap="onPickMode" data-field="overRadiusMode" data-value="{{item.value}}">
        <text class="option-name">{{item.name}}</text>
        <text class="option-desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="field" wx:if="{{form.overRadiusMode === 'FEE'}}">
      <text class="label">远程费（元）</text>
      <input class="input" type="digit" placeholder="如 8" value="{{form.remoteFee}}" bindinput="onInput" data-field="remoteFee" />
    </view>
  </view>

  <!-- ============ 运费 ============ -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">配送费</text>
      <help-tip title="配送费" text="达到免运费门槛（桶数或金额任一）即免收；两项门槛都留空 = 一直收基础配送费。" />
    </view>

    <view class="field">
      <text class="label">基础配送费（元）</text>
      <input class="input" type="digit" placeholder="如 3（0 或留空=不收）" value="{{form.baseDeliveryFee}}" bindinput="onInput" data-field="baseDeliveryFee" />
    </view>
    <view class="field">
      <text class="label">免运费桶数</text>
      <input class="input" type="number" placeholder="如 2" value="{{form.freeDeliveryBuckets}}" bindinput="onInput" data-field="freeDeliveryBuckets" />
    </view>
    <view class="field">
      <text class="label">免运费金额（元）</text>
      <input class="input" type="digit" placeholder="{{guide.suggestedFreeDeliveryAmount ? '建议 ' + guide.suggestedFreeDeliveryAmount : '如 40'}}" value="{{form.freeDeliveryAmount}}" bindinput="onInput" data-field="freeDeliveryAmount" />
    </view>
  </view>

  <!-- ============ 楼层费 ============ -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">楼层费（向客户收）</text>
      <help-tip title="楼层费" text="只在「无电梯」且超出免费楼层时收。客户没填楼层、或没确认电梯时，不收、只在结算页提示。" />
    </view>

    <view class="field">
      <text class="label">免费楼层</text>
      <input class="input" type="number" placeholder="如 1" value="{{form.floorFreeLevel}}" bindinput="onInput" data-field="floorFreeLevel" />
    </view>
    <view class="field">
      <text class="label">每超一层加收（元）</text>
      <input class="input" type="digit" placeholder="如 2（留空=不收楼层费）" value="{{form.floorFeePerLevel}}" bindinput="onInput" data-field="floorFeePerLevel" />
    </view>

    <text class="label">计费口径</text>
    <view class="options">
      <view class="option {{form.floorFeeMode === item.value ? 'active' : ''}}" wx:for="{{floorModes}}" wx:key="value"
            bindtap="onPickMode" data-field="floorFeeMode" data-value="{{item.value}}">
        <text class="option-name">{{item.name}}</text>
        <text class="option-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <button class="btn-primary" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存配送计费</button>
</view>
