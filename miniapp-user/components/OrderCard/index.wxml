<view class="order-card" bindtap="onOrderTap">
  <view class="order-header">
    <text class="order-no">订单号：{{order.id}}</text>
    <text class="order-status tag tag-{{statusClass}}">{{statusText}}</text>
  </view>

  <view class="order-content">
    <view class="order-item">
      <text class="item-label">商品：</text>
      <text class="item-value">{{order.waterTypeName}} {{order.waterTypeSpec}}</text>
    </view>
    <view class="order-item">
      <text class="item-label">数量：</text>
      <text class="item-value">{{order.quantity}}桶</text>
    </view>
    <view class="order-item">
      <text class="item-label">地址：</text>
      <text class="item-value">{{order.addressDetail}}</text>
    </view>
    <view class="order-item">
      <text class="item-label">时间：</text>
      <text class="item-value">{{order.createTime}}</text>
    </view>
  </view>

  <view class="order-footer" wx:if="{{order.status === 3}}">
    <view class="reorder-btn" catchtap="onReorder">
      <text>再次购买</text>
    </view>
  </view>
</view>
