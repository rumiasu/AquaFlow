.page-container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background-color: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-regular);
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.order-list {
  padding: 24rpx;
}

.orders-heading { padding: 28rpx 24rpx 16rpx; }
.orders-title { display: block; font-size: 38rpx; font-weight: 700; color: var(--text-primary); }
.orders-note { display: block; font-size: 26rpx; color: var(--text-regular); margin-top: 8rpx; }
.tab-bar { flex-wrap: wrap; }
.tab-item { min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 28rpx; padding: 12rpx 8rpx; }
.page-container { padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.orders-retry { min-height: 88rpx; margin: 16rpx 24rpx; padding: 18rpx; font-size: 28rpx; line-height: 1.6; color: var(--primary-color); background: #fff; border: 1rpx solid var(--border-color); border-radius: 12rpx; }
.list-progress { padding: 24rpx; text-align: center; color: var(--text-regular); font-size: 26rpx; }

.local-empty { padding: 40rpx 24rpx; margin: 20rpx 0; color: var(--text-regular); background: #fff; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
