.container {
  padding-bottom: 120rpx;
}

.product-image {
  width: 100%;
  height: 600rpx;
  background-color: #f5f5f5;
}

.product-info {
  background-color: #fff;
  padding: 24rpx;
}

.product-header {
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.product-spec {
  font-size: 26rpx;
  color: #999;
}

.product-price {
  margin-bottom: 16rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.quantity-section {
  background-color: #fff;
  padding: 24rpx;
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  color: #333;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn.disabled {
  opacity: 0.5;
}

.quantity-btn text {
  font-size: 32rpx;
  color: #333;
}

.quantity-input {
  width: 100rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.buy-btn {
  flex: 1;
  background-color: #1890ff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  margin: 16rpx 0;
}
