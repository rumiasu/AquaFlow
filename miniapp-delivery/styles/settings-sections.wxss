.settings-section-nav { display:flex; gap:8rpx; position:sticky; top:0; z-index:5; padding:12rpx 0; background:var(--bg-gray,#f6f8fa); }
.settings-section-nav button { flex:1; min-width:0; min-height:44px; margin:0; padding:8rpx 4rpx; font-size:14px; line-height:1.5; background:#fff; color:var(--primary-color,#007aff); }
.settings-section-nav button::after { border:0; }
