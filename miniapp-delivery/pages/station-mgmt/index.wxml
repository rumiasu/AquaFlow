<!-- 管理目录保留二十个既有目的页。四类待办及未知状态始终可见，低频入口可展开。 -->
<view class="container">
  <view class="work-head"><text class="work-title">水站管理</text><text class="work-desc">先处理待办，常用操作就在下方。</text></view>
  <view class="badge-error" wx:if="{{badgeError}}" bindtap="loadBadgeCounts">{{badgeError}}</view>
  <view class="group">
    <view class="group-head"><text class="group-title">待处理</text></view>
    <view class="entry-card">
      <view class="entry-row pending-entry" bindtap="onNavigate" data-url="/pages/station-mgmt/receivables/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">应收账款</text><text class="entry-desc">查看欠款与登记收款</text></view><view class="entry-badge" wx:if="{{receivablesBadgeCount > 0}}">{{receivablesBadgeCount > 99 ? '99+' : receivablesBadgeCount}}</view><text class="entry-unknown" wx:elif="{{receivablesBadgeCount === null}}">{{badgeLoading ? '核对中' : '未核对'}}</text><text class="entry-arrow">›</text></view>
      <view class="entry-row pending-entry" bindtap="onNavigate" data-url="/pages/station-mgmt/business-waiting/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">业务待办与退出</text><text class="entry-desc">缺货、拒付与退出处理</text></view><view class="entry-badge" wx:if="{{businessWaitingBadgeCount > 0}}">{{businessWaitingBadgeCount > 99 ? '99+' : businessWaitingBadgeCount}}</view><text class="entry-unknown" wx:elif="{{businessWaitingBadgeCount === null}}">{{badgeLoading ? '核对中' : '未核对'}}</text><text class="entry-arrow">›</text></view>
      <view class="entry-row pending-entry" bindtap="onNavigate" data-url="/pages/station-mgmt/barrel-return/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">退桶审批</text><text class="entry-desc">审核退桶与退押金</text></view><view class="entry-badge" wx:if="{{barrelReturnBadgeCount > 0}}">{{barrelReturnBadgeCount > 99 ? '99+' : barrelReturnBadgeCount}}</view><text class="entry-unknown" wx:elif="{{barrelReturnBadgeCount === null}}">{{badgeLoading ? '核对中' : '未核对'}}</text><text class="entry-arrow">›</text></view>
      <view class="entry-row pending-entry" bindtap="onNavigate" data-url="/pages/station-mgmt/customer-feedback/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">客户反馈</text><text class="entry-desc">处理退款争议与反馈</text></view><view class="entry-badge" wx:if="{{refundDisputeBadgeCount > 0}}">{{refundDisputeBadgeCount > 99 ? '99+' : refundDisputeBadgeCount}}</view><text class="entry-unknown" wx:elif="{{refundDisputeBadgeCount === null}}">{{badgeLoading ? '核对中' : '未核对'}}</text><text class="entry-arrow">›</text></view>
    </view>
  </view>
  <view class="group">
    <view class="group-head"><text class="group-title">常用操作</text></view>
    <view class="entry-card">
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/orders/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">订单管理</text><text class="entry-desc">查找订单与配送状态</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/customers/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">客户管理</text><text class="entry-desc">客户资料与企业审核</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/products/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">商品与库存</text><text class="entry-desc">编辑商品、售价与库存</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/payments/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">待确认收款</text><text class="entry-desc">核对到账后确认</text></view><text class="entry-arrow">›</text></view>
    </view>
  </view>
  <view class="group">
    <view class="group-head group-toggle" bindtap="onToggleGroup" data-group="records" hover-class="entry-pressed"><text class="group-title">业务记录</text><text>{{expandedGroups.records ? '收起 −' : '展开 +'}}</text></view>
    <view class="entry-card" wx:if="{{expandedGroups.records}}">
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/exceptions/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">异常订单</text><text class="entry-desc">桶异常与处理记录</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/asset-claims/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">历史资产认领</text><text class="entry-desc">核对旧押金、桶权益与水票</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/customers/adjust/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">客户资产调整</text><text class="entry-desc">人工补正桶、押金与水票</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/inter-station/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">站间结算</text><text class="entry-desc">核对站间往来与结清记录</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/owed-barrels/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">欠桶台账</text><text class="entry-desc">查看欠桶与归还记录</text></view><text class="entry-arrow">›</text></view>
    </view>
  </view>
  <view class="group">
    <view class="group-head group-toggle" bindtap="onToggleGroup" data-group="settings" hover-class="entry-pressed"><text class="group-title">水站设置</text><text>{{expandedGroups.settings ? '收起 −' : '展开 +'}}</text></view>
    <view class="entry-card" wx:if="{{expandedGroups.settings}}">
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/delivery-config/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">配送计费</text><text class="entry-desc">起送条件、范围与费用</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/station-status/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">营业状态与公告</text><text class="entry-desc">营业提示与本站公告</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/staff/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">员工管理</text><text class="entry-desc">员工资料与绑定审批</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/station-info/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">水站资料</text><text class="entry-desc">名称、联系资料与地图坐标</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/payroll/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">计件工资</text><text class="entry-desc">单价设置与工资结算</text></view><text class="entry-arrow">›</text></view>
    </view>
  </view>
  <view class="group">
    <view class="group-head group-toggle" bindtap="onToggleGroup" data-group="reports" hover-class="entry-pressed"><text class="group-title">经营报表</text><text>{{expandedGroups.reports ? '收起 −' : '展开 +'}}</text></view>
    <view class="entry-card" wx:if="{{expandedGroups.reports}}">
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/gross-profit/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">利润报表</text><text class="entry-desc">收入、成本与净利</text></view><text class="entry-arrow">›</text></view>
      <view class="entry-row " bindtap="onNavigate" data-url="/pages/station-mgmt/dashboard/index" hover-class="entry-pressed"><view class="entry-main"><text class="entry-title">经营看板</text><text class="entry-desc">趋势与商品排行</text></view><text class="entry-arrow">›</text></view>
    </view>
  </view>
</view>
