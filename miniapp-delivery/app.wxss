/* ========== AquaFlow 配送员小程序 设计系统 ========== */
/*
 * [2026-09-26 轨道 D] 品牌色统一：色值照抄 miniapp-user/styles/variable.wxss，
 * 同一套品牌语法（暖纸底 / 白卡 / 深灰文字 / 深靛品牌蓝 #2E4A68 / 中圆角 / 极少阴影）。
 * 两端各自维护自己的 token、没有共享层 —— 这里是**同值**，不是引用。
 * ⚠️ --accent-gradient / --primary-gradient / --header-gradient 三个名字是历史包袱：
 * 「无渐变」硬规则下**只降级值、不改名**（客户端 variable.wxss:14-18 是先例）——
 * 改名会炸全端 25 处 var(--*-gradient) 引用，引用侧一处都不用动。
 */
page {
  /* 主色 - 深靛蓝（唯一的品牌/交互色） */
  --primary-color: #2E4A68;
  --primary-light: #3D5E82;
  --primary-dark: #22384F;
  --primary-bg: rgba(46, 74, 104, 0.08);

  /* 「无渐变」硬规则：历史渐变变量统一降级为纯色（名字保留，见文件头注释） */
  --accent-color: #2E4A68;
  --accent-gradient: #2E4A68;
  --primary-gradient: #2E4A68;
  --header-gradient: #2E4A68;

  /* 功能色 */
  --success-color: #2E9E6B;
  --warning-color: #C9764B;
  --error-color: #B5442C;
  --info-color: #2E4A68;

  /* 配送状态色 */
  --status-pending: #C9764B;
  --status-delivering: #2E4A68;
  --status-completed: #2E9E6B;

  /* 中性色 */
  --text-primary: #2B2A26;
  --text-regular: #6E6A61;
  --text-secondary: #A39E92;
  --text-placeholder: #C9C4B8;

  /* 背景色 */
  --bg-color: #FAF7F0;
  --bg-white: #FFFFFF;
  --bg-gray: #F4EFE4;
  --bg-card: #FFFFFF;

  /* 边框 */
  --border-color: #EAE4D8;
  --border-light: #F1ECE1;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 999rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 阴影（极少，仅分层用） */
  --shadow-sm: 0 2rpx 12rpx rgba(43, 42, 38, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(43, 42, 38, 0.05);
  --shadow-lg: 0 8rpx 32rpx rgba(43, 42, 38, 0.06);
  --shadow-primary: 0 8rpx 24rpx rgba(46, 74, 104, 0.18);
}

/* 全局容器 */
.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/*
 * [2026-09-26] 自绘底栏（tabBar.custom = true）下，tab 页的根容器要**自己**留出导航条的高度：
 * 原生 tabBar 会占掉视口，自绘的是浮在内容上（position: fixed），不留白最后一张卡片会被压住。
 * 高度 = 100rpx 导航条 + 底部安全区 + 一点余量。用法：三个 tab 页的根 view 加这个类。
 */
.custom-tabbar-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 通用按钮 */
.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: var(--radius-round);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-success {
  background: var(--success-color);
  color: #fff;
  border: none;
  border-radius: var(--radius-round);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-success::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: var(--radius-round);
  font-size: var(--font-md);
  font-weight: 600;
  padding: 24rpx 48rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

/* 卡片通用样式 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin: var(--spacing-md);
  padding: var(--spacing-lg);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: var(--spacing-md) 0;
}

/*
 * [2026-09-20 真机联调] 「部分数据没加载出来」提示条（全局，各页可复用）。
 * 为什么需要它：多个列表/汇总请求失败时被静默降级成空数据，页面渲染出的
 * 「0 单 / 0 桶」与"确实没有"完全无法区分（AGENTS §8.22）。
 * 用法：data 里放一个 loadError 字符串（空串 = 全部正常），wxml 写
 * `<view class="load-error" wx:if="{{loadError}}">{{loadError}}</view>`。
 * 当前使用方：pages/home（配送页看板）。色值走色板变量，别写死。
 */
.load-error {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 149, 0, 0.12);
  border-left: 6rpx solid var(--warning-color);
  color: var(--text-regular);
  font-size: 24rpx;
  line-height: 1.5;
}
