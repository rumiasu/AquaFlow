.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.location-item {
  justify-content: space-between;
}

.location-btn {
  color: #1890ff;
  font-size: 26rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background-color: #f5f5f5;
  font-size: 26rpx;
  color: #666;
}

.tag-item.active {
  background-color: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.switch-item {
  justify-content: space-between;
}

.form-switch {
  transform: scale(0.8);
}

.submit-btn {
  margin: 48rpx 24rpx;
  height: 88rpx;
  background-color: #1890ff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
}

.submit-btn.disabled {
  background-color: #ccc;
}
