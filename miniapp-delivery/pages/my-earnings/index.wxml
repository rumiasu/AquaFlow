<!--
  员工端「我的工资」：只读自助页（规格 docs/design/18）。
  金额 / 时间 / 文案全部由 JS 预格式化（wxml 里不能调方法，也不能用 Math、Date）。
  这里刻意没有「提现 / 打款」按钮：发钱是站长在线下做的，系统只登记发放状态。
-->
<view class="page b2-page b2-d40 af2-page lv2-page lv2-earnings">

<view class="lv2-title-row"><view class="af2-icon-tile lv2-money-tile"><icon name="wallet" size="24px" color="#54467C" variant="duotone" fill-color="#E7E2F7" /></view><text>我的收益</text></view>
  <!-- 未结合计是配送员最关心的那个数，放在最上面 -->
  <view class="summary">
    <view class="summary-main">
      <text class="summary-label">尚未计入结算单（元）</text>
      <text class="summary-value">{{unsettledTotalText}}</text>
      <text class="summary-hint">全部未结记录 · 不受下方日期限制</text>
    </view>
    <view class="summary-side">
      <text class="summary-label">区间收益（元）</text>
      <text class="summary-value-sm">{{periodTotalText}}</text>
      <text class="summary-hint">{{from}} 至 {{to}}</text>
    </view>
  </view>

  <view class="chips">
    <view bindtap="onRange" data-range="month" class="af-choice b2-choice {{range === 'month' ? 'af-choice--selected' : ''}}"><view class="af-choice__face"><text class="af-choice__mark" wx:if="{{range === 'month'}}">✓</text>本月至今</view></view>
    <view bindtap="onRange" data-range="today" class="af-choice b2-choice {{range === 'today' ? 'af-choice--selected' : ''}}"><view class="af-choice__face"><text class="af-choice__mark" wx:if="{{range === 'today'}}">✓</text>只看今天</view></view>
  </view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>

  <view class="ui-state" wx:if="{{loadError}}"><text class="ui-state-title">工资加载失败</text><text class="ui-state-copy">{{loadError}}</text><button bindtap="onRetry" class="af-action af-action--quiet"><view class="af-action__face">重新读取工资</view></button></view>

  <block wx:if="{{loaded && !loading && !loadError}}">
    <!-- ============ 结算单 ============ -->
    <view class="card">
      <view class="card-title">我的结算单</view><text class="summary-hint">仅登记线下发薪，不触发转账</text>
      <view class="empty" wx:if="{{payrolls.length === 0}}">暂无结算单</view>
      <view class="payroll" wx:for="{{payrolls}}" wx:key="id">
        <view class="payroll-row">
          <text class="payroll-period">{{item.periodText}}</text>
          <text class="payroll-status">{{item.statusText}}</text>
        </view>
        <view class="payroll-row">
          <text class="payroll-no">{{item.payrollNo}}</text>
          <text class="payroll-amount">¥{{item.totalText}}</text>
        </view>
        <view class="payroll-paid" wx:if="{{item.paidText}}">已发放登记时间：{{item.paidText}}</view>
      </view>
    </view>

    <!-- ============ 收益明细 ============ -->
    <view class="card">
      <view class="card-title">收益明细</view>
      <view class="empty" wx:if="{{items.length === 0}}">该区间暂无收益；已配送的请联系站长核对。</view>
      <view class="item" wx:for="{{items}}" wx:key="id">
        <view class="item-left">
          <text class="item-kind">{{item.kindText}}</text>
          <text class="item-meta">{{item.timeText}}<block wx:if="{{item.orderId}}"> · 订单 #{{item.orderId}}</block></text>
          <text class="item-meta" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="item-right">
          <text class="item-amount">{{item.amountText}}</text>
          <text class="item-detail" wx:if="{{item.detailText}}">{{item.detailText}}</text>
        </view>
      </view>
    </view>

    <!-- 口径说明由服务端下发，前端不复述 -->
    <view class="note b2-earnings-scope" wx:if="{{note}}"><text>收益统计口径</text><help-tip title="收益统计口径" text="{{note}}" /></view>
  </block>

</view>
<business-dialog id="business-dialog" />
