.container {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 100rpx;
  padding-top: 40rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-regular);
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 48rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 74, 104, 0.08);
  transition: transform 0.15s ease;
}

.role-card:active {
  transform: scale(0.98);
}

.role-card.station-manager {
  border-left: 8rpx solid var(--primary-color);
}

.role-card.delivery {
  border-left: 8rpx solid var(--success-color);
}

.role-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: var(--bg-color);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.station-manager .role-icon {
  background: rgba(46, 74, 104, 0.1);
}

.delivery .role-icon {
  background: rgba(52, 199, 89, 0.1);
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.role-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.role-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.role-arrow {
  font-size: 48rpx;
  color: var(--text-placeholder);
  margin-left: 16rpx;
}

.footer-tip {
  text-align: center;
  margin-top: 80rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
