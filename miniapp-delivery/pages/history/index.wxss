.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 统计头部 */
.stats-header {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-title {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.stats-count {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--primary-color);
}

/* 订单列表 */
.order-list {
  padding: 0 var(--spacing-md);
}

.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.status-tag {
  font-size: var(--font-sm);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-round);
  font-weight: 600;
}

.status-completed {
  background: rgba(52, 199, 89, 0.1);
  color: var(--status-completed);
}

.order-date {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.customer-info {
  margin-bottom: var(--spacing-sm);
}

.customer-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.product-list { margin-bottom: var(--spacing-sm); }

.product-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.product-image {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  background: var(--bg-gray);
}

.product-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.product-copy { flex: 1; min-width: 0; }

.product-fallback {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  color: var(--text-regular);
  font-size: var(--font-md);
  word-break: break-all;
}

.product-name {
  display: block;
  white-space: normal;
  word-break: break-all;
  line-height: 1.5;
  font-size: var(--font-md);
  color: var(--text-regular);
}

.product-spec {
  display: inline-block;
  word-break: break-all;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-gray);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.product-qty {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 600;
  margin-left: auto;
}

.address-info {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}


.address-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex: 1;
}

.barrel-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border-light);
}

.barrel-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.barrel-count {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}


.empty-text {
  font-size: var(--font-lg);
  color: var(--text-regular);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

/* 2026-10-02：失败状态常驻，刷新失败时旧记录不能冒充本次结果。 */
.page-state { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; text-align: center; }
.page-state-text { display: block; font-size: 28rpx; color: var(--text-regular); line-height: 1.6; }
.page-state-error { color: var(--error-color); }
.page-state-retry { margin-top: 20rpx; font-size: 28rpx; color: #fff; background: var(--primary-color); }
