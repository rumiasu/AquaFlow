@import "../../styles/actions.wxss";
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.privacy-popup {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  text-align: center;
  margin-bottom: 32rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 48rpx;
}

/* display: inline 是必需的：链接已由 <text> 改成 <navigator>（open-type="openPrivacyContract"），
   navigator 默认块级，不加这一行「…请仔细阅读并同意《用户隐私保护指引》。」会被拆成三行。 */
.privacy-link {
  color: var(--primary-color);
  display: inline;
}

.privacy-buttons {
  display: flex;
  gap: 24rpx;
}

.btn-reject {
  flex: 1;
  background: var(--bg-gray);
  color: #666666;
  border: none;
  border-radius: var(--radius-md);
  font-size: 14px;
  padding: 24rpx 0;
}

.btn-reject::after {
  border: none;
}

.btn-agree {
  flex: 1;
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 600;
  padding: 24rpx 0;
}

.btn-agree::after {
  border: none;
}

.privacy-dialog, .privacy-popup { box-sizing: border-box; width: calc(100% - 48rpx); max-height: 85vh; overflow-y: auto; padding: 32rpx 24rpx; border-radius: var(--radius-lg); }
.privacy-btn, .btn-reject, .btn-agree { min-height: 44px; height: auto; line-height: 1.5; padding: 24rpx 12rpx; box-sizing: border-box; font-size: 14px; }
.privacy-btn.reject, .btn-reject { color: var(--text-regular); background: var(--bg-gray); }

/* B0: one primary authorization and a compact neutral exit. */
.privacy-btns{display:flex;gap:8px;align-items:stretch}.privacy-btns button.reject{flex:0 0 80px;width:80px;min-width:80px;background:var(--af-soft);color:var(--af-ink)}.privacy-btns button.agree{flex:1;min-width:44px;background:var(--af-primary);color:var(--af-on-primary)}

/* Visual 28: readable consent with the same authorization and refusal paths. */
.privacy-mask{padding-left:20px;padding-right:20px}
.privacy-dialog,.privacy-popup{width:100%;max-width:360px;padding:20px}
.privacy-title{font-size:18px;line-height:26px;margin-bottom:12px;color:var(--af-ink)}
.privacy-content{font-size:15px;line-height:24px;margin-bottom:20px;color:var(--af-text-secondary)}
.privacy-link{display:inline-block;min-height:44px;line-height:44px;color:var(--af-primary)}
.privacy-buttons{gap:8px;align-items:stretch}
.privacy-buttons .btn-reject{flex:0 0 80px;min-height:48px;margin:0;color:var(--af-ink);background:var(--af-soft)}
.privacy-buttons .btn-agree{flex:1;min-width:44px;min-height:48px;margin:0;color:var(--af-on-primary);background:var(--af-primary)}
