<!--
  站长端「站间结算」台账（v67 / docs/design/31 §8）。

  ⚠️ 页面里**不做任何计算与口径判断**：
    · 金额、方向（谁欠谁）、计价口径、状态、能不能结清/改价，全部用后端下发的字段；
    · 展示用的串（`_amountText` / `_ruleText` / `_routeText` / `_settledText`）在 index.js 里算好；
    · 口径说明那一行（scopeNote）也是服务端下发的整句，前端不自造同义句
      （同 statusText / payMethodText 的既定判据：文案属口径、不属呈现）。
-->
<view class="page">

  <!-- 三个数：别人欠本站 / 本站欠别人 / 净额 -->
  <view class="ui-state" wx:if="{{ledgerError || loading}}"><text class="ui-state-title">{{loading ? '正在核对站间台账' : '台账待核实'}}</text><text class="ui-state-copy" wx:if="{{ledgerError}}">{{ledgerError}}</text><button wx:if="{{ledgerError}}" size="mini" bindtap="onRetryLedger">重新核对台账</button></view>
  <view class="sum-grid" wx:if="{{loaded && !ledgerError && !loading}}">
    <view class="sum-card">
      <text class="sum-value receive">¥{{summary.receivableText}}</text>
      <text class="sum-label">别人欠本站</text>
    </view>
    <view class="sum-card">
      <text class="sum-value pay">¥{{summary.payableText}}</text>
      <text class="sum-label">本站欠别人</text>
    </view>
    <view class="sum-card">
      <text class="sum-value">{{summary.netPositive ? '+' : '-'}}¥{{summary.netText}}</text>
      <text class="sum-label">{{summary.netLabel}}</text>
    </view>
  </view>

  <view class="scope-note" wx:if="{{scopeNote}}">{{scopeNote}}</view>

  <!-- 需要冲销的那一批：已登记结清、但订单后来被取消/退款。
       ⚠️ 它们**不在正常列表里**（那批单已经不算数了），所以必须单独一块 ——
       不显示的话，站长结过的那笔会凭空消失，"冲销"也就无从下手。 -->
  <view class="section reversal-section" wx:if="{{dangling.length > 0}}">
    <view class="section-title">需要冲销（{{dangling.length}} 笔）</view>
    <view class="hint">这些单已经取消或退款，当时登记的站间应付不再成立。若钱已经真的付给对方了，请先协商。</view>
    <view class="card" wx:for="{{dangling}}" wx:key="_key">
      <view class="row">
        <text class="row-main">{{item._routeText}}</text>
        <text class="row-amount">¥{{item._amountText}}</text>
      </view>
      <view class="row-sub">
        <text class="tag">{{item.directionText}}</text>
        <text class="tag">{{item._ruleText}}</text>
      </view>
      <view class="row-sub" wx:if="{{item._settledText}}"><text class="sub-text">{{item._settledText}}</text></view>
      <view class="actions">
        <button class="btn-outline-small" disabled="{{loading || ledgerError}}" catchtap="onReverse" data-id="{{item.orderId}}" data-amount="{{item._amountText}}">冲销</button>
        <button class="btn-outline-small" catchtap="onOpenAftercare" data-id="{{item.orderId}}">核对本单售后分担</button>
      </view>
    </view>
  </view>

  <!-- 正常台账 -->
  <view class="section">
    <view class="section-title">跨站单明细</view>
    <view class="hint" wx:if="{{loaded && !ledgerError && !loading && items.length === 0}}">
      目前没有需要结算的跨站单。客户在别站下单、由本站配送的单会出现在这里。
    </view>
    <view class="hint" wx:elif="{{loading && !loaded}}">正在加载…</view>

    <view class="card" wx:for="{{items}}" wx:key="_key">
      <view class="row">
        <text class="row-main">订单 #{{item.orderId}}</text>
        <text class="row-amount">¥{{item._amountText}}</text>
      </view>
      <view class="row-sub">
        <text class="tag">{{item.directionText}}</text>
        <text class="tag">{{item.statusText}}</text>
        <text class="tag" wx:if="{{item._payMethodText}}">{{item._payMethodText}}</text>
      </view>
      <view class="row-sub"><text class="sub-text">{{item._routeText}}</text></view>
      <view class="row-sub"><text class="sub-text">{{item._ruleText}}</text></view>
      <view class="row-sub" wx:if="{{item._settledText}}"><text class="sub-text">{{item._settledText}}</text></view>
      <view class="actions">
        <button class="btn-outline-small" catchtap="onOpenOrder" data-id="{{item.orderId}}">看订单</button>
        <button class="btn-outline-small" catchtap="onOpenAftercare" data-id="{{item.orderId}}">核对本单售后分担</button>
        <button class="btn-outline-small" wx:if="{{item.canChangePrice && !loading && !ledgerError}}" catchtap="onPriceByListed" data-id="{{item.orderId}}">按挂牌价结</button>
        <text class="hint" wx:if="{{item.canSettle && !item._amountKnown}}">本笔金额待核实，请重新核对台账后登记结清。</text>
        <button class="btn-ok-small" wx:if="{{item.canSettle && !loading && !ledgerError}}" disabled="{{!item._amountKnown}}" catchtap="onSettle" data-id="{{item.orderId}}" data-amount="{{item._amountText}}">登记结清</button>
      </view>
    </view>
  </view>

  <view class="section aftercare-section">
    <view class="section-title">售后责任核对入口</view>
    <text class="hint">售后分担与原结算分列。原单已冲销，未核定或未交付的责任仍继续处理；客户实际退款记录保留。</text>
    <button wx:for="{{aftercarePendingOrders}}" wx:key="*this" class="btn-outline-small" bindtap="onOpenAftercare" data-id="{{item}}">核对待处理订单 #{{item}}</button>
    <text wx:if="{{aftercareHasMore}}">还有更早责任订单；本次显示最新200笔，可按原订单编号继续核对。</text>
    <input type="number" value="{{aftercareSearch}}" bindinput="onAftercareSearchInput" placeholder="输入原订单编号" />
    <button bindtap="onAftercareSearch" disabled="{{aftercareBusy}}">按原订单核对</button>
    <text class="aftercare-error" wx:if="{{!aftercareOrderId && aftercareError}}">{{aftercareError}}</text>
  </view>
  <view class="section aftercare-section" wx:if="{{aftercareOrderId}}">
    <view class="section-title">订单 #{{aftercareOrderId}} · 实际售后分担</view>
    <text class="hint">{{aftercareNote}}</text>
    <text wx:if="{{aftercareLoading}}">正在核对原实退与责任记录…</text>
    <text class="aftercare-error" wx:if="{{aftercareError}}">{{aftercareError}}</text>
    <button class="btn-outline-small" bindtap="onRetryAftercareRead" disabled="{{aftercareBusy || aftercareLoading}}">查询原责任记录</button>
    <text wx:if="{{aftercareReady && !aftercareItems.length}}">暂无可核对的实际消费退款凭据。</text>
    <view class="card" wx:for="{{aftercareItems}}" wx:key="refundPaymentId">
      <text>{{item.refundVerified ? '已核实退' : '原退款凭据待核'}} #{{item.refundPaymentId}} · 记录金额 ¥{{item.refundAmount}} · 关联站 {{item.refundStationId}}</text>
      <text>{{item.statusText}}</text>
      <text wx:if="{{item.amount !== null}}">站 {{item.otherStationId}} 向实际退款站 {{item.refundStationId}} 分担 ¥{{item.amount}}；其余由实际退款站承担。</text>
      <text wx:else>具体责任金额待核对，不自动追收原整单报酬。</text>
      <text wx:if="{{item.reason}}">{{item.reason}}</text>
      <view class="actions">
        <button wx:if="{{aftercareReady && (item.canPropose || item.retryPROPOSE)}}" bindtap="onChooseAftercare" data-id="{{item.refundPaymentId}}" data-action="PROPOSE">{{item.retryPROPOSE ? '重试原责任方案' : '提出或补充责任方案'}}</button>
        <button wx:if="{{aftercareReady && (item.canAgree || item.retryAGREE)}}" bindtap="onChooseAftercare" data-id="{{item.refundPaymentId}}" data-action="AGREE">{{item.retryAGREE ? '核对上次责任结果' : '核对并接受原责任金额'}}</button>
        <button wx:if="{{aftercareReady && (item.canPay || item.retryPAID)}}" bindtap="onChooseAftercare" data-id="{{item.refundPaymentId}}" data-action="PAID">{{item.retryPAID ? '只同步原交付登记' : '登记本笔已实际交付'}}</button>
      </view>
      <view wx:for="{{item.history}}" wx:for-item="entry" wx:key="id"><text>{{entry.actionText}} · ¥{{entry.amount}} · {{entry.reason}} · {{entry.createTime}}</text></view>
    </view>
    <view class="card" wx:if="{{aftercareSelected}}">
      <text>原实退 #{{aftercareSelected.refundPaymentId}} · 本笔原退款 ¥{{aftercareSelected.refundAmount}}</text>
      <text>站 {{aftercareSelected.otherStationId}} 向实际退款站 {{aftercareSelected.refundStationId}} 分担的金额；明确为0表示本笔由实际退款站承担。</text>
      <input wx:if="{{aftercareAction !== 'AGREE'}}" type="digit" value="{{aftercareAmount}}" bindinput="onAftercareAmount" disabled="{{aftercarePending || aftercareBusy || aftercareAction !== 'PROPOSE'}}" placeholder="分担金额（元）" />
      <text wx:else>核对原方案 ¥{{aftercareSelected.amount}}，本次只确认责任金额，不表示交款。</text>
      <textarea value="{{aftercareReason}}" bindinput="onAftercareReason" maxlength="1000" disabled="{{aftercarePending || aftercareBusy}}" placeholder="{{aftercareAction === 'PROPOSE' ? '责任事实与方案说明（必填）' : '说明（选填）'}}" />
      <text wx:if="{{aftercarePending}}">原请求已保存，结果待核对；只查询或重试原请求，勿再次交款。</text>
      <button bindtap="onSubmitAftercare" loading="{{aftercareBusy}}" disabled="{{aftercareBusy || !aftercareReady}}">{{aftercarePending ? '重试原请求' : aftercareAction === 'PAID' ? '核实已交付并登记' : '保存本次责任核对'}}</button>
    </view>
  </view>
</view>
