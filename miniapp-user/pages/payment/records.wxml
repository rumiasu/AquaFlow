<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <view class="record-list" wx:else>
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-main">
        <view class="record-title-row">
          <text class="record-method">{{item.methodText}}</text>
          <text class="record-order" wx:if="{{item.orderId}}">订单 #{{item.orderId}}</text>
          <text class="record-order" wx:else>水票购买</text>
        </view>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-right">
        <text class="record-amount">¥{{item.amountText}}</text>
        <text class="record-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
    </view>
    <empty wx:if="{{records.length === 0}}" text="暂无账单记录"></empty>
  </view>
</view>