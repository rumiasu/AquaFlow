/* ========== AquaFlow 主题样式 ========== */

/* 主按钮 */
.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-lg);
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
  box-shadow: none;
}

.btn-primary:active {
  opacity: 0.85;

}

/* 描边按钮 */
.btn-outline {
  background-color: transparent;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-lg);
  text-align: center;
  font-size: var(--font-md);
}

.btn-outline:active {
  background-color: var(--primary-bg);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  background-color: var(--primary-bg);
  color: var(--primary-color);
  font-weight: 500;
}

.tag-success {
  background-color: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
}

.tag-warning {
  background-color: rgba(217, 119, 6, 0.08);
  color: var(--warning-color);
}

.tag-error {
  background-color: rgba(220, 38, 38, 0.08);
  color: var(--error-color);
}

/* 价格 */
.price {
  color: var(--price-color);
  font-weight: 700;
}

.price-symbol {
  font-size: var(--font-sm);
  margin-right: 4rpx;
}

.price-value {
  font-size: var(--font-lg);
}

/* 渐变按钮 */
.btn-gradient {
  background: var(--accent-gradient);
  color: #fff;
  border-radius: var(--radius-md);
  font-weight: 600;
  box-shadow: none;
}

.btn-gradient:active {
  opacity: 0.9;

}

/* 卡片高亮边框 */
.card-highlight {
  border-left: 6rpx solid var(--primary-color);
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-link {
  font-size: var(--font-sm);
  color: var(--primary-light);
}

/* 2026-10-22：主动作保持完整触控高度，长文字允许换行。 */
.btn-primary, .btn-outline, .btn-gradient, .btn-success { box-sizing: border-box; min-height: 88rpx; display: flex; align-items: center; justify-content: center; line-height: 1.45; white-space: normal; }
