.container {
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 品牌头 */
.brand-header {
  background: var(--accent-gradient);
  padding: 48rpx 40rpx;
  text-align: center;
}

.brand-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 24rpx;
}

.brand-login {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.brand-login text {
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 600;
}

/* 搜索栏 */
.search-bar {
  padding: 24rpx;
  background-color: #fff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: var(--bg-gray);
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
  border: 1rpx solid var(--border-color);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 32rpx;
  color: var(--text-secondary);
  padding: 0 8rpx;
}

/* 区块 */
.section {
  background-color: #fff;
  margin: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

/* 产品网格 */
.product-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background-color: var(--bg-gray);
  border-radius: var(--radius-md);
  padding: 28rpx;
  border: 1rpx solid var(--border-light);
  transition: all 0.2s;
}

.product-card:active {
  transform: scale(0.98);
  border-color: var(--border-color);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.owned-tag {
  background-color: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(5, 150, 105, 0.2);
  font-weight: 500;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6rpx;
}

.product-note {
  font-size: 24rpx;
  color: var(--text-regular);
  display: block;
  margin-bottom: 16rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--price-color);
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: var(--price-color);
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.buy-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 32rpx;
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.2);
}

.buy-btn.login-required {
  background: var(--text-placeholder);
  box-shadow: none;
}
