/* ========== AquaFlow 设计系统（2026-09-11 锁定版） ==========
 * 浅灰白底 / 白色内容区 / 高对比文字 / 功能蓝 / 紧凑圆角 / 极少阴影
 * 硬规则：无渐变、无玻璃拟态；主按钮与选中状态使用下方 --primary-color。
 * 主动作色以 design/37 的 #1264D6 为准，信息图标不按主按钮批量换色。
 * 变量名保持兼容（其他页面仍在引用），只换值，不换名。
 */
page {
  /* 品牌色 - 功能蓝（唯一的品牌/交互色） */
  --primary-color: #1264D6;
  --primary-light: #1264D6;
  --primary-dark: #0D4FA8;
  --primary-bg: #EAF3FF;

  /* 「无渐变」硬规则：历史渐变变量统一降级为纯色，变量名保留以免炸旧页面 */
  --accent-color: #1264D6;
  --accent-gradient: #1264D6;
  --primary-gradient: #1264D6;
  --header-gradient: #1264D6;

  /* 功能色 */
  --success-color: #16834A;
  --warning-color: #A95516;
  --error-color: #BD3328;
  --info-color: #1677FF;

  /* 功能色浅底（2026-10-07 新增，语义正本 docs/design/36 §1.1：标签/横幅/提示条的底色，
     文字一律用对应的 *-color 实色，不拿浅底当文字色） */
  --success-bg: #EAF6EE;
  --warning-bg: #FFF3E8;
  --error-bg: #FFF0EE;

  /* 价格色：与正文同为深灰，靠字重区分，不用红色 */
  --price-color: #182230;

  /* 中性色 */
  --text-primary: #182230;
  --text-regular: #4B596A;
  --text-secondary: #637083;
  --text-placeholder: #9CA7B5;

  /* 背景色 */
  --bg-color: #F5F6F7;
  --bg-white: #FFFFFF;
  --bg-gray: #F0F2F5;
  --bg-card: #FFFFFF;

  /* 边框 */
  --border-color: #DAE0E8;
  --border-light: #E8ECF1;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角（紧凑圆角） */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-round: 999rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  /* 阴影（极少，仅分层用） */
  --shadow-sm: 0 2rpx 8rpx rgba(43, 42, 38, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(43, 42, 38, 0.05);
  --shadow-lg: 0 8rpx 24rpx rgba(43, 42, 38, 0.06);
  --shadow-primary: 0 8rpx 24rpx rgba(22, 119, 255, 0.10);
}
