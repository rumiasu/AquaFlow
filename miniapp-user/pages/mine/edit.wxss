.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 32rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.submit-btn {
  margin-top: 48rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(79, 172, 254, 0.35);
}

.submit-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  background: #ccc;
  box-shadow: none;
}
