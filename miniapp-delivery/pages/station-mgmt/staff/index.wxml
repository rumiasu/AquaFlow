<view class="container">
  <view class="toolbar">
    <button class="btn-add" bindtap="onShowAdd">新增配送员</button>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索姓名/手机号" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <view class="search-btn" bindtap="onSearch"><text>搜索</text></view>
  </view>

  <view class="filter-chips">
    <view class="chip {{filterStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="onFilterStatus"><text>全部</text></view>
    <view class="chip {{filterStatus === '1' ? 'active' : ''}}" data-status="1" bindtap="onFilterStatus"><text>在职</text></view>
    <view class="chip {{filterStatus === '0' ? 'active' : ''}}" data-status="0" bindtap="onFilterStatus"><text>离职</text></view>
  </view>

  <view class="staff-card" wx:for="{{list}}" wx:key="id">
    <view class="avatar" style="background:{{item.avatarColor}}">{{item.avatarText}}</view>
    <view class="staff-body">
      <view class="name-row">
        <text class="staff-name">{{item.name}}</text>
        <text class="badge role">{{item.roleText}}</text>
        <text class="badge {{item.status === 1 ? 'on' : 'off'}}">{{item.statusText}}</text>
      </view>
      <text class="staff-phone" wx:if="{{item.phone}}">{{item.phoneMasked}}</text>
      <text class="staff-phone muted" wx:else>未填写电话</text>
    </view>
    <view class="card-actions">
      <button class="btn-profile" data-id="{{item.id}}" bindtap="onViewProfile">画像</button>
      <button class="btn-detach" wx:if="{{item.status === 1}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onDetach">解除</button>
    </view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">
    <text>暂无配送员</text>
  </view>

  <!-- 新增配送员弹窗 -->
  <view class="modal-overlay" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="stopPropagation">
      <text class="modal-title">新增配送员</text>
      <input class="modal-input" placeholder="姓名" model:value="{{formName}}" />
      <input class="modal-input" placeholder="电话" type="number" model:value="{{formPhone}}" />
      <text class="modal-hint">新增后将自动归属到当前水站</text>
      <button class="btn-submit" bindtap="onSubmitAdd">确认添加</button>
      <button class="btn-cancel" bindtap="onCloseModal">取消</button>
    </view>
  </view>
</view>
