.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.section-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  margin-bottom: 28rpx;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.required {
  color: var(--error-color);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-btn {
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.station-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.station-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.station-item.selected {
  background: rgba(46, 74, 104, 0.06);
  border-color: var(--primary-color);
}

.station-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.station-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 就近找站（2026-09-26）：定位状态行 + 搜索框 + 距离 ===== */

/* 定位状态行：说清"现在按什么顺序排"以及"还能怎么找" */
.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin: 0 0 16rpx;
}

.loc-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-regular);
  line-height: 1.5;
}

.loc-action {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.search-clear {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 10rpx;
}

.station-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

/* 距离由服务端算好下发（distanceKm）；没坐标的站显示「位置未设置」，样式弱一档 */
.station-distance {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary-color);
  background: var(--primary-bg);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.station-map-link {
  font-size: 22rpx;
  color: var(--primary-color);
  padding: 6rpx 0;
}

.station-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.station-phone {
  font-size: 24rpx;
  color: var(--primary-color);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-placeholder);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.radio.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.radio-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-tip {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ===== 申请历史（只读列表）===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
}

.history-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.history-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.history-station {
  flex: 1;
  font-size: 26rpx;
  color: var(--primary-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-status {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.history-note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #F1ECE1;
}

.btn-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 16rpx;
}

.btn-submit[disabled] {
  background: var(--primary-bg);
  color: #ffffff;
}

/* 「绑定规则 ?」一行（2026-09-24）：说明收进问号后，这行只剩标签 + 问号，居中即可 */
.footer-hint-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 退出出口：本页是被 redirectTo 进来的，页面栈无上一页，没有这个按钮用户就出不去 */
.footer-action {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  background: var(--bg-card);
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.footer-action:active { opacity: 0.8; }
