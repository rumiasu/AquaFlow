<!-- Reading/retrying never invokes login or records acceptance. Draft notices cannot be removed by a switch. -->
<view class="page">
  <view class="doc-notice" wx:if="{{error}}">
    <text class="doc-notice-text">{{error}} {{fallbackNotice}}</text>
    <button size="mini" bindtap="onRetry" loading="{{loading}}" disabled="{{loading}}">重试</button>
  </view>
  <view class="doc-notice" wx:if="{{doc.notice}}">
    <text class="doc-notice-tag">阅读提示</text>
    <text class="doc-notice-text">{{doc.notice}}</text>
  </view>
  <view class="doc-head" wx:if="{{doc}}">
    <text class="doc-title">{{doc.docTitle}}</text>
    <text class="doc-updated">{{doc.updatedAt}}</text>
    <text class="doc-updated">版本标识：{{doc.versionId}}</text>
  </view>
  <view class="doc-section" wx:for="{{doc.sections}}" wx:key="heading">
    <text class="doc-heading">{{item.heading}}</text>
    <text class="doc-body">{{item.body}}</text>
  </view>
  <view class="doc-foot">
    <text class="doc-foot-text">阅读本页不会执行登录或记录条款接受、处理同意。</text>
  </view>
</view>
