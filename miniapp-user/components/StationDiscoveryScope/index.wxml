<view class="discovery-scope">
  <text class="discovery-title">查找送水水站</text>
  <view class="discovery-actions">
    <picker mode="region" level="city" value="{{region}}" bindchange="onCityChange" disabled="{{!active || locating}}">
      <view class="discovery-button">{{scope && scope.city ? scope.city : scope ? '补选地图所在城市' : '选择城市'}} ▾</view>
    </picker>
    <button class="discovery-button" bindtap="onChooseLocation" disabled="{{!active || locating}}">{{locating ? '正在打开地图' : '选择地图位置'}}</button>
  </view>
  <text class="discovery-hint" wx:if="{{!scope}}">先选择城市或地图位置，再查看可选水站。</text>
  <block wx:else>
    <text class="discovery-hint">{{scope.city ? '城市：' + scope.city : '城市：待确认'}}</text>
    <text class="discovery-hint">{{scope.lat !== undefined ? '地图位置：已选择' : '地图位置：未选择，请补选以核对配送范围'}}</text>
    <text class="discovery-hint">能否配送以送水地址核对结果为准。</text>
  </block>
  <text class="discovery-message" wx:if="{{message}}">{{message}}</text>
</view>
