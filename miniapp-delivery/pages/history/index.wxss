.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 统计头部 */
.stats-header {
  background: var(--bg-card);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-title {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.stats-count {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--primary-color);
}

/* 订单列表 */
.order-list {
  padding: 0 var(--spacing-md);
}

.order-card {
  background: var(--bg-card);
  border-radius: 12rpx;
  box-shadow: none;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  border: 1rpx solid var(--border-color);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-tag {
  font-size: var(--font-sm);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-round);
  font-weight: 600;
}

.status-completed {
  background: rgba(52, 199, 89, 0.1);
  color: var(--status-completed);
}

.order-date {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.customer-info {
  margin-bottom: var(--spacing-sm);
}

.customer-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.product-list { margin-bottom: var(--spacing-sm); }

.product-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.product-image {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  background: var(--bg-gray);
}

.product-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.product-copy { flex: 1; min-width: 0; }

.product-fallback {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  color: var(--text-regular);
  font-size: var(--font-md);
  word-break: break-all;
}

.product-name {
  display: block;
  white-space: normal;
  word-break: break-all;
  line-height: 1.5;
  font-size: var(--font-md);
  color: var(--text-regular);
}

.product-spec {
  display: inline-block;
  word-break: break-all;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-gray);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.product-qty {
  flex-shrink: 0;
  white-space: normal;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-left: auto;
  overflow-wrap: anywhere;
  max-width: 40%;
}

.address-info {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}


.address-text {
  font-size: 32rpx;
  color: var(--text-primary);
  flex: 1;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.barrel-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border-light);
}

.barrel-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.barrel-count {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}


.empty-text {
  font-size: var(--font-lg);
  color: var(--text-regular);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

/* 2026-10-02：失败状态常驻，刷新失败时旧记录不能冒充本次结果。 */
.page-state { margin: 24rpx; padding: 28rpx; background: #fff; border-radius: 12rpx; text-align: center;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}
.page-state-text { display: block; font-size: 28rpx; color: var(--text-regular); line-height: 1.6; }
.page-state-error { color: var(--error-color); }
.page-state-retry { margin-top: 20rpx; font-size: 28rpx; color: #fff; background: var(--primary-color); }

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.page-state-retry { height: auto; min-height: 96rpx; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.45; white-space: normal; word-break: break-all; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.order-date, .note-text { overflow-wrap: anywhere; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .order-card { box-shadow: none; border-radius: 10px; border-color: var(--af-border); } .order-card::after { color: var(--af-text-secondary); }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-history, .lv2-transfer { padding:20px 16px; }
.lv2-history .stats-header { margin:0 0 16px; padding:16px; background:var(--af2-surface-neutral); border:0; border-radius:16px; box-shadow:none; }
.lv2-history-heading { display:flex; align-items:center; gap:10px; }
.lv2-history .stats-title { font-size:20px; line-height:28px; color:var(--af2-ink); }
.lv2-history .stats-count { font-size:13px; line-height:22px; color:var(--af2-muted); }
.lv2-history .order-list, .lv2-transfer .order-list { padding:0 16px; background:var(--af2-surface); border-radius:16px; }
.lv2-history .order-card, .lv2-transfer .order-card { margin:0; padding:16px 0; border:0; border-bottom:1px solid var(--af2-line); border-radius:0; box-shadow:none; }
.lv2-history .product-info, .lv2-transfer .product-info { align-items:center; gap:10px; padding:10px 0; flex-wrap:nowrap; }
.lv2-history .product-image, .lv2-transfer .product-image { flex:none; width:48px; height:48px; border-radius:10px; background:var(--af2-surface-neutral); }
.lv2-history .product-placeholder, .lv2-transfer .product-placeholder { display:flex; align-items:center; justify-content:center; }
.lv2-history .product-copy, .lv2-transfer .product-copy { flex:1; min-width:0; }
.lv2-history .product-name, .lv2-transfer .product-name { font-size:14px; line-height:22px; }
.lv2-history .product-spec, .lv2-transfer .product-spec { font-size:12px; line-height:19px; }
.lv2-history .product-qty, .lv2-transfer .product-qty { flex:none; max-width:32%; font-size:15px; line-height:22px; white-space:normal; }
.lv2-history .order-date, .lv2-transfer .order-date { font-size:12px; line-height:20px; }
.lv2-history .empty-state, .lv2-transfer .empty-state { display:flex; flex-direction:column; align-items:center; gap:12px; padding:32px 0; background:transparent; }
.lv2-history .empty-text, .lv2-transfer .empty-text { font-size:16px; line-height:24px; }
