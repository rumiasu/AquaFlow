.skeleton {
  padding: 24rpx;
  background-color: var(--bg-white);
}

.skeleton-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.skeleton-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.skeleton-header-info {
  flex: 1;
}

.skeleton-title {
  height: 32rpx;
  width: 60%;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
}

.skeleton-desc {
  height: 24rpx;
  width: 80%;
  border-radius: 8rpx;
}

.skeleton-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-item {
  display: flex;
  align-items: center;
}

.skeleton-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
}

.skeleton-line-short {
  width: 60%;
}

.skeleton-animate {
  background: linear-gradient(90deg, var(--bg-gray) 25%, var(--border-light) 50%, var(--bg-gray) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
