.container { background: var(--bg-color); min-height: 100vh; padding: 24rpx; }

.summary-card { background: linear-gradient(135deg, #4F8EF7, #3b7de6); border-radius: 16rpx; padding: 32rpx 24rpx; display: flex; margin-bottom: 24rpx; }
.summary-item { flex: 1; text-align: center; }
.summary-num { display: block; font-size: 44rpx; font-weight: 700; color: #fff; }
.summary-num.warn { color: #ffcd78; }
.summary-label { display: block; font-size: 22rpx; color: rgba(255,255,255,.75); margin-top: 6rpx; }

.record-card { background: var(--bg-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.record-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.record-customer { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.record-time { font-size: 22rpx; color: var(--text-secondary); }
.record-address { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.record-meta { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--text-regular); flex-wrap: wrap; }
.meta-divider { color: #ddd; }
.record-bottom { margin-top: 12rpx; display: flex; flex-direction: column; gap: 6rpx; }
.discrepancy-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; display: inline-block; align-self: flex-start; }
.discrepancy-tag.owe { background: #fff3e0; color: #e65100; }
.discrepancy-tag.extra { background: #e3f2fd; color: #1565c0; }
.discrepancy-note { font-size: 22rpx; color: var(--text-secondary); }

.empty { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: var(--text-secondary); }
