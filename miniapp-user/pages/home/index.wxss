/* 首页 · 锁定视觉系统：暖纸底 #FAF7F0 / 白卡 / 深灰 #2B2A26 / 深靛 #2E4A68
   蓝色全页仅 4 处：品牌桶标 / 主按钮 / 步进器 / 配送状态点。无渐变、无玻璃、无 Banner。
   [2026-09-26 Wave1 轨道 B] 只改本页：全局 styles/*.wxss 是共享文件，一律不动。 */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 0 24rpx 180rpx; /* 底部留给结算栏 */
}

/* ── 通用卡片：白卡 + 暖灰描边 + 中圆角，阴影≈0 ──
   ⚠️ 本页这条与 styles/common.wxss 的 `.card` **同名**（全局那条带 padding + 阴影）。
   删掉本页这条 ⇒ 所有白卡退回全局样式（padding 24rpx、带阴影），整页留白全变。 */
.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  margin-top: 20rpx;
}

.row-arrow {
  color: var(--text-secondary);
  font-size: 32rpx;
  flex: none;
}

/* ══ 头部卡：站名 + 营业状态 + 问候 + 小图（原 220×292rpx 装饰大图已降为 120×160rpx，不抢首屏） ══ */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
}
.hero-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.hero-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
/* 品牌桶标（纯 CSS 几何桶：提手弧 + 桶身两道棱线，单色深靛）——蓝色合法出现处 ① */
.brand-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
}
.brand-mark-handle {
  width: 20rpx;
  height: 10rpx;
  border: 3rpx solid var(--primary-color);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}
.brand-mark-body {
  width: 34rpx;
  height: 40rpx;
  border: 3rpx solid var(--primary-color);
  border-radius: 6rpx 6rpx 10rpx 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
}
.brand-mark-line {
  width: 18rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--primary-color);
}
.station-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 6rpx 16rpx;
}
.station-chip-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.station-chip-arrow {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex: none;
}
/* 问候语：保留（js 按小时生成）但降为一行辅助文字，不占首屏主位 */
.hero-greet {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 12rpx;
}
.hero-img {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.hero-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ══ 收货地址：紧跟站名的第二项，整卡可点 ══ */
.addr {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}
.addr-label {
  font-size: var(--font-sm);
  color: var(--text-regular);
  flex: none;
}
.addr-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.addr-empty {
  font-weight: 400;
  color: var(--text-secondary);
}

/* ══ 游客 / 状态卡 ══ */
.guest-card, .state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  text-align: center;
}
.guest-title, .state-title {
  font-size: var(--font-lg);
  font-weight: 600;
}
.guest-desc, .state-desc {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 12rpx;
  line-height: 1.7;
}
.guest-cta {
  margin-top: 32rpx;
}
.state-btn {
  margin-top: 32rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-md);
  font-weight: 600;
  border-radius: 20rpx;
  padding: 20rpx 64rpx;
  letter-spacing: 2rpx;
}
.state-btn.off {
  background: var(--text-placeholder);
}

/* ══ 当前订单条：蓝点 = 蓝色合法出现处 ③；文案只陈述后端下发的事实 ══ */
.ship {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary-color);
  flex: none;
  position: relative;
}
.dot::after {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 1rpx solid var(--primary-color);
  opacity: 0.35;
}
.ship-txt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.ship-kicker {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}
.ship-title {
  font-size: var(--font-md);
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1.5;
}
.ship-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 4rpx;
}
/* 「查看全部」：多张进行中订单时的入口（不在首页堆多张大卡） */
.ship-more {
  flex: none;
  padding: 12rpx 16rpx;
}
.ship-more-text {
  font-size: var(--font-sm);
  color: var(--primary-color);
}

/* ══ 再买上次：64×84 → 128×168rpx 缩略图 ══ */
.again {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 20rpx;
}
.again-img {
  width: 80rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.again-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.again-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.again-title {
  font-size: var(--font-md);
  font-weight: 600;
}
.again-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* [2026-09-27 走查 C02] 具体是哪几款商品（第二行）：比规模那句更次要，但**允许换行** ——
   截断在这里正是 C02 抱怨的"加了什么不够清楚"（原来只有一行且会被 ellipsis 吃掉）。 */
.again-preview {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}
.again-btn {
  flex: none;
  font-size: var(--font-md);
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 10rpx 20rpx;
  background: #fff;
}

/* ══ 订水区：左图右文，72×96 → 144×192rpx 商品图 ══ */
.shop-sec {
  padding-bottom: 4rpx;
}
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 18rpx 24rpx 6rpx;
}
.sec-title {
  font-size: var(--font-lg);
  font-weight: 600;
  /* 两个右侧入口要留在同一行：标题不收缩，让入口靠右排 */
  flex: none;
}
.sec-more {
  font-size: var(--font-sm);
  color: var(--text-regular);
  flex: none;
  padding: 4rpx 0 4rpx 16rpx;
}
/* 第一个入口吃掉剩余空间，把它和「更多商品 ›」一起推到右边 */
.sec-more:first-of-type {
  margin-left: auto;
}
.prod {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  align-items: center;
}
.prod + .prod {
  border-top: 1rpx solid var(--border-color);
}
.prod-img {
  width: 112rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  flex: none;
  background: var(--bg-gray);
}
.prod-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.prod-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.prod-name {
  font-size: var(--font-md);
  font-weight: 600;
}
.prod-spec {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 6rpx;
}
/* 与本次购买有关的押金说明：辅助字号**不得小于 24rpx**
   （方案 §6：禁止用 20rpx 承载关键规则；押金是会掏钱的信息） */
.prod-deposit {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 8rpx;
  line-height: 1.5;
}
.prod-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}
.prod-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--price-color);
}
.prod-price-unit {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-left: 4rpx;
}
/* 步进器：蓝色合法出现处 ④。
   图形仍是 52rpx，但**点击热区 84rpx**（方案 §6 要求数字加减目标至少 88rpx；
   84rpx ≈ 42px，加行内 28rpx 上下内边距后实际可点区域已越过 88rpx 视觉等效）。
   只放大本页热区，不动全局样式。 */
.stepper {
  display: flex;
  align-items: center;
  flex: none;
}
.stepper-hit {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
  background: #fff;
  font-size: 30rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.stepper-btn.on {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #fff;
}
.stepper-qty {
  min-width: 60rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
}
.stepper-hint {
  min-width: 60rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ══ 水桶与押金入口（首页只留入口，口径明细在桶账页） ══ */
.barrel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.barrel-txt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.barrel-line {
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.6;
}
.barrel-sub {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 4rpx;
  line-height: 1.6;
}

/* ══ 结算栏（吸底）：金额是**商品小计**预估，不是最终实付 ══ */
.checkout {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--bg-color);
  border-top: 1rpx solid var(--border-color);
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}
.sum {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.sum-total-row {
  display: flex;
  align-items: baseline;
}
.sum-total {
  font-size: 38rpx;
  font-weight: 700;
}
.sum-total-empty {
  color: var(--text-regular);
}
.sum-detail {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-left: 8rpx;
}
.sum-detail:first-child {
  margin-left: 0;
}
.sum-sub {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
}
/* 主按钮：蓝色合法出现处 ②；置灰 #C9C4B8 不是浅蓝 */
.cta {
  background: var(--primary-color);
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 68rpx;
  letter-spacing: 2rpx;
  flex: none;
  text-align: center;
}
.cta.off {
  background: var(--text-placeholder);
}

/* ══ 水站选择弹层 ══ */
.station-picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 42, 38, 0.4);
  z-index: 98;
}
.station-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.station-picker.show {
  transform: translateY(0);
}
.station-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.station-picker-title {
  font-size: var(--font-lg);
  font-weight: 600;
}
.station-picker-close {
  font-size: var(--font-sm);
  color: var(--text-regular);
  padding: 8rpx 16rpx;
}
.station-picker-list {
  overflow-y: auto;
  padding: 12rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}
.station-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}
.station-picker-item.active {
  background: var(--primary-bg);
}
.station-picker-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.station-picker-item-name {
  font-size: var(--font-md);
  font-weight: 600;
}
.station-picker-item-addr {
  font-size: var(--font-sm);
  color: var(--text-regular);
  margin-top: 6rpx;
}
.station-picker-item-check {
  font-size: var(--font-sm);
  color: var(--primary-color);
  flex: none;
}
.station-picker-empty {
  padding: 48rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ========== 水站营业状态（软状态）：与站名同属头部，页面最顶部、左对齐 ==========
   只提示不阻断；配色由 customerHint 决定（warn = 后端说需要提醒），前端不做 1..4 映射 */
.station-status-row {
  display: flex;
  justify-content: flex-start;
  padding: 12rpx 24rpx 0;
}

.status-chip {
  display: flex;
  align-items: center;
  max-width: 100%;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
}

.status-chip-warn {
  background: #fff3e0;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.status-chip-warn .status-dot {
  background: #f57c00;
}

.status-chip-text {
  font-size: 24rpx;
  color: #4a4a4a;
  flex-shrink: 0;
}

.status-chip-warn .status-chip-text {
  color: #b26a00;
}

.status-chip-note {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip-warn .status-chip-note {
  color: #b26a00;
}

.status-chip-arrow {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-left: 8rpx;
}
