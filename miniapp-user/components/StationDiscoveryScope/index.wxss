.discovery-scope { padding: 20rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.discovery-title { color: #172b4d; font-size: 30rpx; font-weight: 600; }
.discovery-actions { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; }
.discovery-button { margin: 0; padding: 0 20rpx; min-height: 44px; line-height: 44px; box-sizing: border-box; border-radius: 12rpx; color: #1258b5; background: #eef5ff; font-size: 28rpx; }
.discovery-button::after { border: 0; }
.discovery-hint, .discovery-message { color: #52647a; font-size: 26rpx; line-height: 1.6; display: block; overflow-wrap: anywhere; }
