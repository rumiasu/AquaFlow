/* [2026-10-13] 必要说明曾误用低对比次要/占位色；只改正常文字为正文辅助色，保留非文本与禁用态原声明。 */
.container {
  min-height: 100vh;
  padding: 48rpx 24rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.header {
  text-align: left;
  margin-bottom: 40rpx;
  padding-top: 0;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-regular);
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: none;
  transition: transform 0.15s ease;
  border: 1rpx solid var(--border-color);
  min-height: 152rpx;
  box-sizing: border-box;
}

.role-card:active {
  transform: scale(0.98);
}

.role-card.station-manager {
  border-left: 8rpx solid var(--primary-color);
}

.role-card.delivery {
  border-left: 8rpx solid var(--success-color);
}

.role-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: none;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: var(--bg-color);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.station-manager .role-icon {
  background: var(--primary-bg);
}

.delivery .role-icon {
  background: rgba(52, 199, 89, 0.1);
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.role-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.role-desc {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

.role-arrow {
  font-size: 48rpx;
  color: var(--text-placeholder);
  margin-left: 16rpx;
}

.footer-tip {
  text-align: left;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.7;
}

/* 户外阅读与窄屏操作：保持业务字段、动作与风险提示完整。 */
.footer-tip text { display: block; margin-bottom: 12rpx; }
