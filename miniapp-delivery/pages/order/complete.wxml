<view class="container b2-complete af2-page lv2-page lv2-complete">
  <!-- 隐私授权弹窗：本页用 wx.chooseImage 选送达/回桶照片，必须渲染（原因见 components/PrivacyPopup/index.js 文件头） -->
  <privacy-popup />
  <view class="ui-state" wx:if="{{orderLoading || orderLoadError}}">
    <text class="ui-state-title">{{orderLoading ? '正在读取订单' : '订单尚未核实'}}</text>
    <text class="ui-state-copy" wx:if="{{!orderLoading}}">{{orderLoadError}}</text>
    <view class="ui-state-actions" wx:if="{{!orderLoading}}">
      <button wx:if="{{orderId}}" bindtap="onRetryOrder" class="af-action af-action--secondary">重新读取</button>
      <button bindtap="onBackToOrders" class="af-action af-action--quiet"><text class="af-action__face">返回订单列表</text></button>
    </view>
  </view>
  <block wx:if="{{orderLoaded || resultState === 'unknown' || resultState === 'success'}}">
  <!--
    [2026-09-27 走查 D03 修] 页头**只在服务端确认成功之后**才画大绿勾 +「完成配送」。
    原来这两个元素是一进页面就渲染的静态占位：还没提交，页面已经在说"完成配送"了，
    提交失败的红色弹窗与大绿勾同时出现在一屏上（判据见 resultState 的注释）。
    提交前说的是动作与后果；提交中/失败/结果未知各有自己的文案，都不带绿勾。
  -->
  <view class="head-card">
    <!-- 2026-10-14：确认前也须辨认原单，不能只在 unknown 核实按钮里显示 ID。 -->
    <text class="head-subtitle" wx:if="{{orderLoaded && orderInfo}}">原订单：{{orderInfo.orderNo || (orderInfo.id ? '#' + orderInfo.id : '编号未加载')}}</text>
    <block wx:if="{{resultState === 'success'}}">
      <view class="success-icon">✓</view>
      <text class="success-title">{{successTitle}}</text>
      <text class="success-subtitle">{{successSubtitle}}</text>
    </block>
    <block wx:else>
      <text class="head-title" wx:if="{{resultState === 'submitting'}}">正在提交…</text>
      <text class="head-title" wx:else>{{completionTitle}}</text>
      <text class="head-subtitle" wx:if="{{resultState !== 'submitting'}}">{{completionHint}}</text>
      <text class="head-subtitle" wx:else>请稍等，别重复点击</text>
    </block>
  </view>
  <!--
    结果未知（网络断开/超时，提交可能已经生效）：必须常驻可见 —— 只弹一次窗，
    下一次进来看页面与"什么都没发生"一样，人会直接再点一次提交。
  -->
  <view class="load-error" wx:if="{{(resultState === 'unknown' || resultState === 'failed') && unknownHint}}">{{unknownHint}}</view>
  <button wx:if="{{resultState === 'unknown' || resultState === 'success' || (resultState === 'failed' && unknownHint)}}" bindtap="onVerifyOriginalOrder" class="af-action af-action--secondary">核实原订单 #{{orderId}}</button>

  <!-- 2026-10-28：交付、回桶、收款、凭证独立分组；所有事实仍取原响应与当前输入。 -->
  <view class="seg-head lv2-group-heading lv2-group-order">
    <icon name="truck" size="24px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /><text class="seg-title">实际交付</text>
  </view>
  <view class="cust-card" wx:if="{{orderInfo}}">
    <view class="cust-main">
      <text class="cust-name">{{orderInfo.customerName || orderInfo.receiverName || '客户'}}</text>
      <text class="cust-tag" wx:if="{{orderInfo.payMethodText}}">{{orderInfo.payMethodText}}</text>
    </view>
    <view class="cust-row cust-address" wx:if="{{addressText}}" bindtap="onCopyAddress">
      <text class="cust-row-text">{{addressText}}</text>
      <text class="cust-row-action">复制</text>
    </view>
    <view class="cust-row" wx:if="{{contactPhone}}" bindtap="onCallPhone">
      <text class="cust-row-text">{{contactPhone}}</text>
      <text class="cust-row-action">拨打</text>
    </view>
    <!--
      [2026-09-27 走查 D02 修] **送货清单**（原来这里只有客户与金额，商品名只出现在下面的回桶行里，
      而回桶行只对桶装水画、首单整块不画 ⇒ 新押金单 / 纯瓶装水单上看不到任何商品）。
      ⚠️ 它读的是 deliveryItems（= 整单 order.items 全量），**不是** items（只含要回桶的桶装水行）。
      ⚠️ 它不参与提交：该回几桶仍取后端 suggestedReturnQty，别拿这里的"送出数量"当默认回桶数。
    -->
    <view class="goods-row" wx:for="{{deliveryItems}}" wx:key="id">
      <view class="lv2-sku-thumb"><image wx:if="{{item.imageUrl && !displayImageErrors[item.imageUrl]}}" src="{{item.imageUrl}}" mode="aspectFit" binderror="onDisplayImageError" data-src="{{item.imageUrl}}" /><view wx:else class="lv2-sku-fallback"><icon name="products" size="24px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /></view></view>
      <text class="goods-name">{{item.name}}</text>
      <text class="goods-qty" wx:if="{{item.qtyText}}">{{item.qtyText}}</text>
    </view>
<view class="money-prep" wx:if="{{showStockPrepPrompt}}">
      <text class="money-prep-text">{{stockPrepText}}</text>
      <text class="money-prep-link" catchtap="onGoInventory">去补货 ›</text>
    </view>
    <view class="goods-empty" wx:if="{{deliveryItems.length === 0}}">这单没有商品明细</view>
    <!--
      电话与地址：客户不一定在门口等着，能一键拨、一键复制比"把号码摆在那儿让你背"有用。
      `contactPhone` 取 receiverPhone（订单快照）优先 —— 跨站履约单**刻意不下发** customerPhone
      （画像归归属站，见 util/CustomerProfileMask），快照里的收件人电话照常可用。
      [2026-09-26] 行首的 📞 / 📍 装饰图标按 §6（员工端逐步去除表情符号）去掉：
      「拨打」「复制」两个动作文字本来就在，图标只是抢视觉。
    -->


  </view>

  <!--
    [2026-09-27 走查 D01 修] 钱卡：**先给结论，再给数字**。
    · 本次要收钱（后端 needCollect）→ 红字大字 = 要上门收的金额（唯一需要行动的那种）；
    · 已付款 / 不归本次收 → 主结论一句话（"已付款"等，全部由后端 payStateText/payHint 下发），
      总额降级成小字 —— 原来无论哪种都用 56rpx 红字，看着像"还要收这么多钱"。
    ⚠️ 别为了好看把 needCollect 或 paymentStatus 改掉，也别默认勾成已收（契约 C1）。
  -->
  

  <!-- ============ 段二 · 实际收回空桶 ============
       按商品核对回桶：**只对桶装水**（后端 barrelItem / util/BarrelScope 一个判据）。
       瓶装水 / 饮水机既没有押金条也没有还桶入口，整块不渲染 —— 以前它们也在这里画步进器、
       默认值还等于送出数，提交上去会被桶账的物理上限拒掉（混合单必踩）。
       标题从卡里提到段头（§4 的段名就叫「实际收回空桶」）：`*` 表示这一单必须填，
       首单（整单都是新买的押金桶、本次不回桶）不挂这个星号 —— 与原来的分支口径一致。 -->
  <view class="seg-head lv2-group-heading lv2-group-physical" wx:if="{{isFirstBarrelOrder || hasBarrelItems}}">
    <icon name="barrel" size="24px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /><text class="seg-title">实际收回空桶</text>
    <text class="required" wx:if="{{!isFirstBarrelOrder}}">*</text>
  </view>
  <view class="section lv2-return-section" wx:if="{{isFirstBarrelOrder || hasBarrelItems}}">
    <text class="section-tip old-barrel-hint" wx:if="{{hasDepositOldBarrelHint}}">默认回桶数不含本单新押金桶</text>
    <!-- 本次送的桶是**本单新买押金**的：不要求本次回收（§7：不能说成"首次下单"，
         客户可能早就买过水票 —— 那与"有没有桶权益"不是一回事） -->
    <view class="first-order-tip" wx:if="{{isFirstBarrelOrder}}">
      <text class="first-order-text">本单新押金桶无需回收</text>
      <text class="first-order-desc">下次换水时交回空桶</text>
    </view>

    <!-- 续购订单：正常回桶核对 -->
    <block wx:else>
      <view class="item-return" wx:for="{{items}}" wx:key="id" wx:for-index="idx">
        <view class="item-header">
          <view class="item-name-wrap">
            <text class="item-name">{{item.productName}}</text>
            <text class="item-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
          </view>
        </view>

        <view class="barrel-row">
          <view class="lv2-quantity-label"><text class="barrel-label">实际收回</text><text class="lv2-quantity-context">送出 {{item.sentQty}} 桶 · 应回 {{item.expected}} 桶</text></view>
          <view class="barrel-stepper">
            <view class="step-btn {{item.actual === 0 ? 'step-btn-disabled' : ''}}" catchtap="onActualDecrease" data-idx="{{idx}}">−</view>
            <input class="step-input" type="number" value="{{item.actual}}" bindinput="onActualChange" data-idx="{{idx}}" />
            <view class="step-btn" catchtap="onActualIncrease" data-idx="{{idx}}">+</view>
          </view>

        </view>

        <!-- 实际差额醒目提醒；原因选填，不替现场事实补齐未知原因。 -->
        <view class="discrepancy-section" wx:if="{{item.discrepancy > 0}}">
          <view class="discrepancy-warn">
            <text>⚠ 应回 {{item.expected}} 桶，实回 {{item.actual}} 桶，少回收 {{item.discrepancy}} 桶</text>
          </view>

          <view class="reason-list">
            <view class="reason-item" wx:for="{{item.reasons}}" wx:for-item="reason" wx:for-index="ridx" wx:key="key">
              <text class="reason-label">{{reason.key === 'customer_kept' ? '客户留存' : reason.key === 'lost' ? '路上丢失' : reason.key === 'damaged' ? '破损' : reason.key === 'wrong' ? '送错' : '其他'}}</text>
              <view class="reason-qty-wrap">
                <text class="reason-qty-label">×</text>
                <input class="reason-qty-input" type="number" value="{{reason.qty}}" bindinput="onReasonQtyChange" data-idx="{{idx}}" data-ridx="{{ridx}}" />
              </view>
              <view class="af-action af-action--quiet b2-reason-remove" catchtap="onRemoveReason" data-idx="{{idx}}" data-ridx="{{ridx}}"><text class="af-action__face">移除</text></view>
            </view>
          </view>

          <view class="af-entry b2-reason-entry" catchtap="onOpenReasonPicker" data-idx="{{idx}}">
            <text class="af-entry__icon">＋</text>
            <text class="af-entry__body">添加异常原因<text class="b2-optional"> · 选填</text></text><text class="af-entry__arrow">›</text>
          </view>

          <view class="reason-hint" wx:if="{{item.reasons.length > 0}}">
            已说明 {{item.reasonQtySum}} 桶；其余保留未说明差额
          </view>
        </view>

        <view class="item-divider" wx:if="{{idx < items.length - 1}}"></view>
      </view>
    </block>
  </view>

  <!-- ============ 段三 · 本次收款 ============
       现场收款（契约 C1）：只说"这单还要收多少 + 收了没"。
       · 只在**后端说还要收**（needCollect：现金单且未付）时出现 —— 付过款的单不再问一遍；
       · 金额取服务端 totalAmount（含水费/押金/配送费/楼层费），不在这里另算；
       · "已收齐 / 未收款"**必须人选**（默认两边都不选），不许自动默认已收。 -->
  <view class="seg-head lv2-group-heading lv2-group-money" wx:if="{{orderInfo}}">
    <icon name="wallet" size="24px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /><text class="seg-title">{{needCollect ? '本次收款' : '付款情况'}}</text>
  </view>
  <view class="money-card {{needCollect ? '' : 'lv2-money-standalone'}}" wx:if="{{orderInfo}}">
    <view class="money-line" wx:if="{{moneyMode === 'collect'}}">
      <text class="money-label">本单尚应收</text>
      <text class="money-amount">{{orderInfo.totalAmount === null || orderInfo.totalAmount === undefined || orderInfo.totalAmount === '' ? '金额待核实' : '¥' + orderInfo.totalAmount}}</text>
    </view>
    <block wx:else>
      <view class="money-head">
        <text class="money-headline {{moneyMode === 'paid' ? 'money-headline-paid' : 'money-headline-wait'}}">{{moneyHeadline}}</text>
        <text class="money-amount-muted" wx:if="{{moneyMode === 'paid'}}">本单总额 {{orderInfo.totalAmount === null || orderInfo.totalAmount === undefined || orderInfo.totalAmount === '' ? '金额待核实' : '¥' + orderInfo.totalAmount}}</text>
      </view>
      <!-- 不归本次收的钱（水票/微信未付、已退款…）：总额照实列，但**降级**，不冒充要收的款 -->
      <view class="money-line money-line-muted" wx:if="{{moneyMode !== 'paid'}}">
        <text class="money-label">本单总额</text>
        <text class="money-amount-muted">{{orderInfo.totalAmount === null || orderInfo.totalAmount === undefined || orderInfo.totalAmount === '' ? '金额待核实' : '¥' + orderInfo.totalAmount}}</text>
      </view>
      <text class="money-meta-item" wx:if="{{moneySub}}">{{moneySub}}</text>
    </block>
    <view class="money-meta">
      <text class="money-meta-item collect-sub-text" wx:if="{{orderInfo.depositAmount > 0}}">含押金 ¥{{orderInfo.depositAmount}}（可退）</text>
    </view>
    <!-- 备货：**备齐了不占位置**（正常单不该多一行字），没备齐时才说清还差什么 + 给站长一个补货入口 -->
    
  </view>
  <view class="section section-collect" wx:if="{{needCollect}}">
    
    <view class="collect-selector">
      <view class="af-choice b2-collect-option {{collected === true ? 'af-choice--selected' : ''}}" catchtap="onSelectCollected" data-value="true">
        <view class="af-choice__face"><text>已收齐</text><text wx:if="{{collected === true}}"> ✓</text></view>
      </view>
      <view class="af-choice b2-collect-option {{collected === false ? 'af-choice--selected' : ''}}" catchtap="onSelectCollected" data-value="false">
        <view class="af-choice__face"><text>未收款</text><text wx:if="{{collected === false}}"> ✓</text></view>
        <text class="collect-option-desc">{{cashUncollectedDesc}}</text>
      </view>
    </view>
    <text class="collect-tip" wx:if="{{!collectedChosen}}">{{collectionChoiceHint}}</text>
    <text class="collect-tip" wx:elif="{{collected === false}}">{{cashUncollectedHint}}</text>
  </view>

  <!--
    送达凭证（原名「签收凭证」，[2026-09-26] 改名）：**客户不一定在现场签收**，
    所以这里不要求签字，照片只用来证明"水送到了"（放好了 / 门口 / 客户留的条）。
    ⚠️ 常显、不折叠：它是"这单到底交付了没有"唯一能拿出来看的东西（原来这个名字
      逼着配送员去找客户签字，客户不在就干脆不拍 —— 凭据反而没了）。
  -->
  <view class="section">
    <view class="section-title-row">
      <view class="lv2-proof-glyph" aria-hidden="true"><view></view></view><text class="section-title">送达凭证<text class="lv2-optional"> · 选填</text></text>
      <help-tip title="送达凭证"
        text="可拍摄送达现场供站长协助核对，不要求客户签字。" />
    </view>
    <view class="photo-grid">
      <view class="photo-item" wx:for="{{photos}}" wx:key="index">
        <view class="photo-img ui-proof-frame" ><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewPhoto" style="width:100%;height:100%;" binderror="onDisplayImageError" data-src="{{item}}" wx:if="{{!displayImageErrors[item]}}" /><view class="ui-image-fallback" wx:else bindtap="onPreviewPhoto" data-index="{{index}}">图片暂无法显示，点此预览原图</view></view>
        <view class="photo-remove" data-index="{{index}}" catchtap="onRemovePhoto">×</view>
      </view>
      <view class="af-entry b2-photo-add" bindtap="onAddPhoto" wx:if="{{photos.length < 3}}">
        <text class="af-entry__icon">＋</text><text class="af-entry__body photo-add-text">{{uploading ? '上传中...' : '添加照片'}}</text>
      </view>
    </view>
  </view>

  <!-- 更多（选填）：楼层与楼梯凭证 / 备注（契约 C2 —— 正常送达只要"商品 + 回桶 + 收钱"三件事，
       其余按需展开，减少无意义翻页与必读段落）。 -->
  <view class="section">
    <view class="af-entry b2-more-toggle" bindtap="onToggleMore">
      <text class="more-toggle-text">{{showMore ? '收起选填内容' : '更多（楼层补贴核对 / 备注）'}}</text>
      <text class="more-toggle-icon">{{showMore ? '▲' : '▼'}}</text>
    </view>
  </view>

  <block wx:if="{{showMore}}">
    <!--
      楼层与楼梯凭证（v43）—— [2026-09-26] 由「常显」改成「**默认收起、有争议才展开**」：
        · 楼层一般不会"不清楚"（客户地址里就写着），常显等于每次送达都问一遍"你爬了几层"；
        · 但它关系到配送员自己的**楼层补贴**，所以不能埋得找不着，两种情况会展开：
          ① 客户地址**没写清有没有电梯**（`addressHasElevator` 为空 = 三态里的"没确认过"）
             → 载入时自动展开，并在下面说明原因；
          ② 现场起了争议（跟客户对楼层/爬楼说法不一致）→ 点下面那行「楼梯有争议」展开。
        ⚠️ 它**不影响**向客户收的楼层费 —— 那笔钱在下单时就按地址快照了。
        ⚠️ 展开后不提供'收起'：填了一半又收起来只会让人以为白填了。
    -->
    <view class="section" wx:if="{{floorBlockOpen}}">
      <view class="section-title-row">
        <text class="section-title">楼层与楼梯凭证</text>
        <help-tip title="楼层与楼梯凭证"
          text="楼层已按客户地址带出，可按现场情况核对修改。未填写时沿用地址楼层；电梯情况未确认或存在争议时请补充说明与凭证，补贴以实际核实结果为准。修改这里不会改变本单向客户收取的楼层费。" />
      </view>
      <text class="section-tip" wx:if="{{elevatorUnknown}}">电梯情况尚未确认：请核对现场楼层，必要时补充楼梯凭证，补贴以核实结果为准</text>
      <text class="section-tip" wx:else>有争议才需要填；不填就沿用客户地址里的楼层</text>
      <view class="floor-row">
        <input class="floor-input" type="number" placeholder="如 6" value="{{reportedFloor}}" bindinput="onFloorInput" />
        <text class="floor-unit">层</text>
      </view>
      <text class="floor-proof-title">楼梯凭证（可选）</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{floorPhotos}}" wx:key="index">
          <view class="photo-img ui-proof-frame" ><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewFloorPhoto" style="width:100%;height:100%;" binderror="onDisplayImageError" data-src="{{item}}" wx:if="{{!displayImageErrors[item]}}" /><view class="ui-image-fallback" wx:else bindtap="onPreviewFloorPhoto" data-index="{{index}}">图片暂无法显示，点此预览原图</view></view>
          <view class="photo-remove" data-index="{{index}}" catchtap="onRemoveFloorPhoto">×</view>
        </view>
        <view class="af-entry b2-photo-add" bindtap="onAddFloorPhoto" wx:if="{{floorPhotos.length < 3}}">
          <text class="af-entry__icon">＋</text><text class="af-entry__body photo-add-text">{{floorUploading ? '上传中...' : '添加照片'}}</text>
        </view>
      </view>
    </view>

    <!-- 争议入口（只有收起时才给）：现场跟客户就楼层/爬楼说法不一致时点它展开 -->
    <view class="section" wx:else>
      <view class="af-entry b2-dispute-entry" bindtap="onOpenFloorDispute">
        <text class="dispute-entry-text">楼梯 / 楼层有争议？记楼层并拍照</text>
        <text class="dispute-entry-arrow">›</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="section">
      <view class="note-header">
        <text class="note-label">备注（可选）</text>
        <text class="note-count">{{noteText.length}}/100</text>
      </view>
      <textarea class="note-input" placeholder="订单补充说明" maxlength="100" bindinput="onNoteInput" value="{{noteText}}" />
    </view>
  </block>

  <!--
    确认完成配送（主按钮）。⚠️ 它**固定**在屏幕底部（.footer 是 position: fixed，见 complete.wxss），
    所以无论页面上面的三段 —— 包括常显的「送达凭证」—— 有多长，按钮都在眼前，
    **不需要先滚过凭证**；底部留白（.container 的 padding-bottom）按它的实际高度留足，
    免得最后一块被它压住。
  -->
  <view class="footer">
    <!--
      [2026-09-27 走查 D03 修] 按钮文字反映**当前状态**：提交前是动作（「确认送达」），
      提交中不能让人再点，结果未知时保留原单核实入口及安全重试。
      服务端确认成功后按钮所在页会跳走（见 complete.js 的 setTimeout 跳转）。
    -->
    <button class="af-action af-action--primary af-action--final af-action--block" bindtap="onConfirmComplete" loading="{{checkingCompletion}}" disabled="{{submittingComplete || checkingCompletion || completionBlocked}}">
      {{resultState === 'submitting' ? '提交中…' : (resultState === 'success' ? successButtonText : (resultState === 'unknown' ? '核实并恢复原提交' : completionButtonText))}}
    </button>
  </view>

  </block>

  <!-- 异常原因选择弹窗 -->
  <view class="modal-overlay" wx:if="{{showReasonPicker}}" bindtap="onCloseReasonPicker">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="lv2-sheet-head"><text class="modal-title">异常原因</text><button class="af-action af-action--quiet" catchtap="onCloseReasonPicker"><text class="af-action__face">关闭</text></button></view>
      <text class="modal-desc">选填，合计不超过少回差额；选中后可改数量。</text>
      <view class="modal-list">
        <view class="modal-item {{item.disabled ? 'modal-item-disabled' : ''}}" wx:for="{{reasonOptions}}" wx:key="key"
               catchtap="onSelectReason" data-key="{{item.key}}">
          <view class="modal-item-info">
            <text class="modal-item-name">{{item.label}}</text>
          </view>
          <view class="modal-check" wx:if="{{item.checked}}">✓</view>
        </view>
      </view>
      
    </view>
  </view>
</view>

<view wx:if="{{uploadRecoveryCases.length || uploadRecoveryReadFailed}}" class="upload-recovery-panel">
  <button bindtap="onToggleUploadRecovery" class="af-action af-action--quiet"><text class="af-action__face">{{uploadRecoveryReadFailed ? '图片异常记录读取失败' : '图片上传异常（' + uploadRecoveryCases.length + '）'}} · {{uploadRecoveryExpanded ? '收起' : '查看'}}</text></button>
  <block wx:if="{{uploadRecoveryExpanded}}">
  <view wx:if="{{uploadRecoverySelection}}">
    <text>待确认图片 #{{uploadRecoverySelection.imageId}}</text>
    <view class="ui-proof-image ui-proof-frame" ><image src="{{uploadRecoverySelection.url}}" mode="aspectFit" bindtap="onUploadPreviewSelected" style="width:100%;height:100%;" binderror="onDisplayImageError" data-src="{{uploadRecoverySelection.url}}" wx:if="{{!displayImageErrors[uploadRecoverySelection.url]}}" /><view class="ui-image-fallback" wx:else bindtap="onUploadPreviewSelected" >图片暂无法显示，点此预览原图</view></view>
    <button disabled="{{uploadRecovering}}" bindtap="onUploadConfirmSelected" class="af-action af-action--secondary">确认是原来提交的图片</button>
  </view>
  <text wx:if="{{uploadRecoveryReadFailed}}">记录暂时无法读取，请先核实图片</text>
  <view wx:for="{{uploadRecoveryCases}}" wx:key="id">
    <text>{{item.label}}</text>
    <button disabled="{{uploadRecovering}}" data-caseid="{{item.id}}" bindtap="onUploadRecover" class="af-action af-action--secondary">核实图片</button>
  </view>
  </block>
</view>
<business-dialog id="business-dialog" />
