/* Financial page presentation consumes visual-v2-V0-3. Business controls stay in actions.wxss. */
page { background:var(--af2-page); color:var(--af2-ink); }
.finance-page { box-sizing:border-box; padding:16px 16px calc(24px + env(safe-area-inset-bottom)); font-size:14px; line-height:1.5; }
.card { box-sizing:border-box; padding:16px; margin:0 0 16px; background:var(--af2-surface); border:1px solid var(--af2-line); border-radius:16px; }
.card-title,.section-title { font-size:18px; line-height:26px; font-weight:600; color:var(--af2-ink); overflow-wrap:anywhere; }
.card-title-row,.finance-section-head { display:flex; align-items:center; gap:8px; min-width:0; }
.card-title-row { flex-wrap:wrap; }
.card-count { margin-left:auto; font-size:13px; color:var(--af2-muted); }
.card-sub,.row-sub,.hint,.slip-sub { display:block; font-size:14px; line-height:22px; color:var(--af2-muted); overflow-wrap:anywhere; }
.card-sub { margin-top:8px; }
.field { margin-top:16px; min-width:0; }
.label { display:block; font-size:14px; line-height:20px; color:var(--af2-muted); margin-bottom:8px; }
.input,.picker,.dialog-input { box-sizing:border-box; width:100%; min-height:48px; padding:12px; border:1px solid var(--af2-line); border-radius:9px; background:var(--af2-surface); color:var(--af2-ink); font-size:16px; line-height:22px; overflow-wrap:anywhere; }
.input,.dialog-input { height:48px; }
.picker { display:flex; align-items:center; }
.picker-empty { color:var(--af2-muted); }
.field-2col { display:flex; gap:12px; margin-top:16px; }.field.col { flex:1; margin-top:0; }
.row { display:flex; align-items:flex-start; gap:12px; padding:14px 0; border-bottom:1px solid var(--af2-line); }
.row:last-child { border-bottom:0; }.row-main { flex:1; min-width:0; }
.row-between { display:flex; flex-wrap:wrap; align-items:flex-start; gap:6px 12px; }
.row-title { color:var(--af2-ink); font-size:16px; line-height:24px; overflow-wrap:anywhere; }
.row-amount { margin-left:auto; font-size:18px; line-height:26px; font-weight:600; color:var(--af2-ink); text-align:right; overflow-wrap:anywhere; }
.empty { padding:24px 12px; color:var(--af2-muted); font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.finance-empty { display:flex; flex-direction:column; align-items:center; gap:12px; text-align:center; padding:32px 16px; }
.load-error,.ui-state { padding:16px; margin:12px 0; border-radius:12px; background:var(--af2-surface-danger); color:var(--af2-ink); line-height:22px; overflow-wrap:anywhere; }
.ui-state-title { display:block; font-size:16px; font-weight:600; }.ui-state-copy { display:block; margin:6px 0; }
.load-error .af-action,.ui-state .af-action { margin-top:8px; }
.mask { position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(25,42,63,.38); z-index:90; }
.dialog { position:fixed; left:0; right:0; bottom:0; top:auto; z-index:100; box-sizing:border-box; max-height:88vh; padding:20px 20px calc(20px + env(safe-area-inset-bottom)); border-radius:20px 20px 0 0; background:var(--af2-surface); overflow-y:auto; }
.dialog-head { display:flex; align-items:center; gap:8px; margin-bottom:12px; }
.dialog-title { flex:1; min-width:0; font-size:18px; line-height:26px; font-weight:600; overflow-wrap:anywhere; }
.dialog-close { flex:none; font-size:24px; margin-left:auto; }
.kv { display:flex; align-items:flex-start; gap:12px; padding:10px 0; font-size:14px; line-height:22px; }
.kv-k { flex:0 0 7em; color:var(--af2-muted); }.kv-v { flex:1; min-width:0; text-align:right; color:var(--af2-ink); overflow-wrap:anywhere; }
.pill,.tag { display:inline-block; font-size:13px; line-height:20px; padding:3px 8px; border-radius:6px; background:var(--af2-surface-neutral); color:var(--af2-ink-neutral); }
.pill-on,.pill-paid { background:var(--af2-surface-success); color:var(--af2-ink-success); }
.pill-confirmed { background:var(--af2-surface-current); color:var(--af2-ink-current); }
.pill-off,.pill-draft { background:var(--af2-surface-neutral); color:var(--af2-ink-neutral); }
.form-submit { margin-top:20px; }.form-cancel { margin-top:8px; }
@media (max-width:350px) { .field-2col { flex-direction:column; }.row-amount { max-width:100%; } }

.tabs { display:flex; flex-wrap:wrap; align-items:center; gap:2px; margin-bottom:20px; padding:4px; background:var(--af2-surface-neutral); border-radius:12px; }
.tabs .af-choice { flex:1; min-width:0; }.tabs .af-choice__face { padding-left:2px; padding-right:2px; }
.tab-help { display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; font-size:16px; color:var(--af2-muted); }
.draft-note { display:block; padding:12px; margin-bottom:12px; border-radius:10px; color:var(--af2-ink-neutral); background:var(--af2-surface-neutral); font-size:14px; line-height:22px; }
.draft-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.configured-rate { align-items:center; }.configured-rate .row-main { order:1; }.configured-rate .rate-edit { order:2; flex:none; margin-left:auto; }
.configured-default { background:var(--af2-surface-neutral); padding:12px; border-radius:9px; }
.product-list { margin-top:12px; }.product-card { display:flex; align-items:center; gap:12px; min-height:76px; padding:12px 0; border-top:1px solid var(--af2-line); }
.product-selected { background:var(--af2-surface-neutral); border-radius:10px; padding:12px; border:1px solid var(--af-primary); }
.product-image { display:flex; flex:none; align-items:center; justify-content:center; width:52px; height:64px; border-radius:8px; background:var(--af2-surface-neutral); }
.product-placeholder { flex-direction:column; color:var(--af2-muted); font-size:12px; line-height:18px; }.default-image { font-size:28px; color:var(--af2-ink-money); background:var(--af2-surface-money); }
.product-copy { flex:1; min-width:0; }.product-name { display:block; font-size:16px; font-weight:600; line-height:24px; overflow-wrap:anywhere; }
.product-spec,.product-price { display:block; font-size:14px; line-height:22px; color:var(--af2-muted); }.product-price { color:var(--af2-ink); }
.product-check { flex:none; font-size:18px; color:var(--af-primary); }
.payroll-amount-panel { padding:16px; margin-top:16px; border-radius:14px; }
.slip-hero { padding:8px 0 16px; }.slip-hero-amount { display:block; font-size:30px; line-height:38px; font-weight:600; color:var(--af2-ink-money); overflow-wrap:anywhere; }
.slip-hero-label { display:block; font-size:14px; color:var(--af2-ink-money); margin-top:4px; }
.payroll-amount-panel .kv { border-top:1px solid var(--af2-line); }.payroll-amount-panel .kv-k,.payroll-amount-panel .kv-v { color:var(--af2-ink-money); }
.settlement-submit,.adjust-submit { margin-top:20px; }.adjust-toggle { margin-left:auto; }
.direction-choices,.direction-options { display:flex; gap:8px; margin-top:12px; }.direction-choices .af-choice,.direction-options .af-choice { flex:1; min-width:0; }
.payroll-search { box-sizing:border-box; height:48px; padding:12px; width:100%; margin:12px 0 0; border:1px solid var(--af2-line); border-radius:9px; background:var(--af2-surface); font-size:16px; }
.payroll-date-row { display:flex; align-items:center; flex-wrap:wrap; gap:4px 8px; margin:8px 0; font-size:14px; }.payroll-date-row picker { flex:1; min-width:86px; }.payroll-date-row picker > view { min-height:44px; display:flex; align-items:center; }
.payroll-filter-clear { display:flex; align-items:center; min-height:44px; padding:0 8px; color:var(--af2-muted); }
.slip { padding:16px 0; border-top:1px solid var(--af2-line); }.slip-top { display:flex; align-items:center; gap:12px; }.slip-person { flex:1; min-width:0; }
.slip-label { display:none; }.slip-name { font-size:16px; line-height:24px; font-weight:600; overflow-wrap:anywhere; }
.slip-money { display:flex; align-items:baseline; flex-wrap:wrap; justify-content:space-between; gap:6px 12px; margin:12px 0; }.slip-amount { font-size:26px; line-height:34px; font-weight:600; color:var(--af2-ink); overflow-wrap:anywhere; }.slip-period { font-size:13px; color:var(--af2-muted); }
.pay-caution { display:block; font-size:13px; line-height:20px; color:var(--af2-muted); margin-top:8px; }
.slip-actions { display:flex; align-items:center; gap:8px; margin-top:8px; }.slip-detail-entry { margin-left:auto; display:flex; align-items:center; gap:10px; min-height:44px; color:var(--af2-muted); }
.item-card .row-main { width:100%; }.actions-row { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-top:12px; }.item-more-entry { margin-left:auto; }
.sum-box { padding:12px; margin:12px 0; border-radius:10px; background:var(--af2-surface-neutral); }.sum-title { font-size:13px; color:var(--af2-muted); }.sum-row { display:flex; align-items:flex-start; gap:8px; padding:8px 0; }.sum-name { flex:1; min-width:0; overflow-wrap:anywhere; }.sum-dir { color:var(--af2-muted); }.sum-amount { font-weight:600; overflow-wrap:anywhere; }.sum-add { color:var(--af2-ink-success); }.sum-deduct { color:var(--af2-ink-danger); }.sum-total { padding-top:16px; }
.dialog .slip-hero,.record-direction { padding:16px; margin:12px 0; border-radius:12px; background:var(--af2-surface-money); }.detail-scroll { max-height:34vh; }.detail-close,.history-more { margin-top:8px; }
.item-menu { position:fixed; bottom:0; left:0; right:0; z-index:110; padding:20px 20px calc(20px + env(safe-area-inset-bottom)); border-radius:20px 20px 0 0; background:var(--af2-surface); box-sizing:border-box; max-height:85vh; overflow-y:auto; }.menu-mask { z-index:105; }.menu-title { display:block; margin-bottom:12px; font-size:18px; line-height:26px; font-weight:600; overflow-wrap:anywhere; }
.menu-action,.menu-cancel { display:flex; align-items:center; width:100%; min-height:48px; padding:12px; margin:0; font-size:16px; line-height:24px; border:0; border-top:1px solid var(--af2-line); border-radius:0; background:var(--af2-surface); color:var(--af2-ink); box-sizing:border-box; text-align:left; }.menu-danger { color:var(--af2-ink-danger); }.menu-cancel { justify-content:center; margin-top:12px; background:var(--af2-surface-neutral); border-radius:9px; }.menu-hint { display:block; font-size:13px; line-height:20px; margin:8px 0; color:var(--af2-muted); }

.menu-action::after,.menu-cancel::after { border:0; }
