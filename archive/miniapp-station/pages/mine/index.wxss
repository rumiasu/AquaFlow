.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #007AFF 0%, #00C6FF 100%);
  padding: 40rpx 24rpx 32rpx;
  border-radius: 0 0 24rpx 24rpx;
  color: #fff;
}

.avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 16rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.3);
}

.name {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.station-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.station-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.station-name {
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.switch-btn {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

/* 菜单列表 */
.menu-section {
  background: #fff;
  margin-top: 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger {
  color: #FF4D4F;
}

.menu-item image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.menu-item text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-item.danger text {
  color: #FF4D4F;
}

.arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* 版本信息 */
.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 40rpx 0 60rpx;
  color: #999;
  font-size: 24rpx;
}