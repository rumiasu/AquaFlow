.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: var(--header-gradient);
  padding: 60rpx 32rpx 40rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.2);
}

.user-info {
  flex: 1;
}

.user-nick-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.role-chip {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}
.role-chip.role-manager {
  background: rgba(255, 193, 7, 0.95);
  color: var(--text-regular);
}
.role-chip.role-delivery {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.bind-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bind-status.bind-ok {
  margin-top: 10rpx;
  color: #ffffff;
}

.bind-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--error-bg);
  flex-shrink: 0;
}
.bind-dot.bind-BOUND { background: var(--success-color); }
.bind-dot.bind-PENDING { background: var(--warning-color); }
.bind-dot.bind-REJECTED { background: var(--error-color); }
.bind-dot.bind-PENDING_UNBIND { background: var(--warning-color); }
.bind-dot.bind-UNBOUND { background: var(--text-placeholder); }

.bind-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  padding-left: 16rpx;
}

.manager-entry-card {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.manager-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}


.manager-entry-text {
  display: flex;
  flex-direction: column;
}
.manager-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}
.manager-entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.manager-entry-arrow {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--warning-bg);
  padding: 12rpx 24rpx;
  background: rgba(255, 213, 79, 0.18);
  border-radius: 999rpx;
}

/* 配送员绑定操作卡 */
.bind-action-card {
  background: #ffffff;
  margin: -20rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 20;
}

.bind-info-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--primary-bg);
  margin-bottom: 20rpx;
}
.bind-info-line.bind-info-warning { background: var(--warning-bg); }
.bind-info-line.bind-info-wait { background: var(--warning-bg); }
.bind-info-line.bind-info-danger { background: var(--error-bg); }
.bind-info-line.bind-info-none { background: var(--bg-gray); }

.bind-info-label {
  font-size: 26rpx;
  color: var(--text-regular);
}
.bind-info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}
.bind-info-warning .bind-info-value { color: var(--warning-color); }
.bind-info-wait .bind-info-value { color: var(--warning-color); }
.bind-info-danger .bind-info-value { color: var(--error-color); }
.bind-info-none .bind-info-value { color: var(--text-regular); }

.bind-actions-row {
  display: flex;
  gap: 16rpx;
}

.bind-action-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
}
.bind-action-btn::after { border: none; }

.bind-action-blue {
  background: var(--primary-gradient);
  color: #ffffff;
}
.bind-action-gray {
  background: var(--bg-gray);
  color: var(--text-regular);
}

.stats-card {
  background: var(--bg-card);
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow-md);
  padding: 32rpx 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: block;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 「未填成本」（缺成本，见 _decorateProfit）与"有异常"用同一个警示色 ——
   两者都表示"这个数别按 0 理解"。正常态不套这个类：满屏红字会让真正需要看的那一格失去信号。
   **只管颜色，不改字号**。 */
.stats-value.stats-warn {
  color: var(--error-color);
}

/* 金额格专用：三格里它是唯一可能到 5 位数的（¥12345.67），40rpx 会挤出格子。
   nowrap 是兜底 —— 宁可让金额格窄一点也不要在数字中间换行（"¥123\n45.67" 会被读错）。 */
.stats-value.stats-money {
  font-size: 32rpx;
  white-space: nowrap;
}

/* 第三格的第二行（欠桶 N 户）：比 label 更弱，且**自己可点**（catchtap）——
   一格两数时必须让两个目标各自可点，否则用户点哪都是同一个页面。 */
.stats-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  /* 比 --text-secondary(var(--text-secondary)) 再浅一档：它是同一格里的次要数字，不该与 label 抢注意力。
     app.wxss 没有这一档变量，故写死色值（别引不存在的 --text-tertiary）。 */
  color: var(--text-placeholder);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-light);
}

/* 站长 section card */
.section-card {
  background: #ffffff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.section-link {
  font-size: 24rpx;
  color: var(--primary-color);
}
/* 标题行右侧那一簇（[2026-09-26 Wave1 轨道 G]「员工」改成可折叠后加的）：
   摘要文字 + 展开/收起 + 「更多 ›」三者一行，别各自换行把标题挤掉。 */
.section-head-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 「配送员 N · 待审批 M」——**折叠时也必须在**（AGENTS §8.22：看不见 ≠ 没有） */
.staff-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.section-toggle {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary-color);
}

.station-info-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.station-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}
.station-address {
  font-size: 26rpx;
  color: var(--text-regular);
}
.station-phone {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.station-info-empty {
  padding: 20rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
/* [2026-09-26 Wave1 轨道 G] 原 `.station-edit`（「编辑资料 ›」蓝色链接）随入口一起去掉，
   换成一行**不可点**的灰字提示：本页只留水站摘要，改资料走「水站管理 → 水站资料」。
   ⚠️ 别再把它改成可点跳转 —— 那正好把刚收掉的重复入口加回来。 */
.station-edit-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 员工入口（2026-09-19 IA 重组）：本页保留完整的「配送员管理 / 绑定申请」列表与原地操作，
   站长端 pages/station-mgmt/staff/ 是更全的那一份（多了搜索、筛选、画像、新增），
   两边数据同源，标题行的「更多 ›」跳过去。 */
.staff-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 4rpx;
}
.staff-entry-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.staff-entry-arrow {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 管理 Tab */
.mgmt-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border-light);
  margin-bottom: 20rpx;
}
.mgmt-tab {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
.mgmt-tab.active {
  color: var(--primary-color);
  font-weight: 700;
}
.mgmt-tab.active::after {
  content: '';
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: -2rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary-color);
}

.tab-count {
  display: inline-block;
  min-width: 32rpx;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  background: var(--border-color);
  color: var(--text-regular);
  margin-left: 8rpx;
}
.tab-count.tab-badge {
  background: var(--error-color);
  color: #ffffff;
}

.mgmt-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
.mgmt-empty-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}
/* 折叠态那一行（[2026-09-26 Wave1 轨道 G]）：有待审批时点名条数，
   与标题行的 `.staff-summary` 一起保证"收起来也看得见有几条要办"。 */
.staff-folded-hint {
  padding: 8rpx 0 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.staff-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.staff-item:last-child { border-bottom: none; }
.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.staff-avatar.staff-avatar-blue { background: var(--primary-color); }
.staff-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.staff-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.staff-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 500;
}
.staff-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.staff-remove-btn {
  flex-shrink: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  line-height: 1.4;
  background: var(--error-bg);
  color: var(--error-color);
}
.staff-remove-btn::after { border: none; }
/* 站长行没有「解除」按钮，用一行灰字说明原因（不渲染任何东西会让站长以为界面坏了） */
.staff-self-note {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-placeholder);
  padding: 10rpx 12rpx;
}
.staff-action-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.staff-btn {
  border: none;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  line-height: 1.4;
}
.staff-btn::after { border: none; }
.staff-btn-green {
  background: var(--success-bg);
  color: var(--success-color);
}
.staff-btn-gray {
  background: var(--bg-gray);
  color: var(--text-regular);
}
.menu-list {
  background: var(--bg-card);
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}


.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.logout-btn {
  margin: 0 24rpx;
  padding: 28rpx;
  text-align: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}

.logout-btn text {
  font-size: 28rpx;
  color: var(--error-color);
}

.login-tip {
  margin: 48rpx 24rpx;
  text-align: center;
}

.login-tip-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 32rpx;
}

.btn-login {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
}

.btn-login::after {
  border: none;
}

.btn-login-secondary {
  background: var(--primary-gradient);
  margin-top: 20rpx;
}
