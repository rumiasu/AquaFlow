.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-dialog {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: var(--primary-color);
  display: inline;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-btn.reject {
  background: #f5f5f5;
  color: #999;
}

.privacy-btn.agree {
  background: var(--primary-color);
  color: #fff;
}

.privacy-dialog, .privacy-popup { box-sizing: border-box; width: calc(100% - 48rpx); max-height: 85vh; overflow-y: auto; padding: 32rpx 24rpx; border-radius: var(--radius-lg); }
.privacy-btn, .btn-reject, .btn-agree { min-height: 96rpx; height: auto; line-height: 1.5; padding: 24rpx 12rpx; box-sizing: border-box; font-size: 28rpx; }
.privacy-btn.reject, .btn-reject { color: var(--text-regular); background: var(--bg-gray); }

/* 只补安全区与触控，不改变协议入口或同意/拒绝回调。 */
.privacy-mask { box-sizing: border-box; padding: calc(24rpx + env(safe-area-inset-top)) 0 calc(24rpx + env(safe-area-inset-bottom)); }
.privacy-dialog { max-height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 96px); }
.privacy-content { overflow-wrap: anywhere; }
.privacy-btn { min-height: 48px; }
