/* 与站长管理页共用暖纸底、白卡和品牌蓝；规则说明始终可见。 */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: var(--bg-color);
  color: var(--text-primary);
  font-size: 28rpx;
}

.section {
  margin: 0 0 24rpx;
  padding: 28rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.title {
  display: block;
  padding-left: 16rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.row {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  line-height: 1.7;
}

.row text {
  display: block;
  font-size: 26rpx;
  color: var(--text-regular);
}

.hint {
  display: block;
  margin: 12rpx 0;
  color: var(--text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-state {
  display: block;
  padding: 24rpx 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-sm);
  color: var(--text-regular);
  font-size: 26rpx;
  line-height: 1.6;
}

.error {
  display: block;
  margin-bottom: 12rpx;
  color: var(--error-color);
  font-size: 26rpx;
  line-height: 1.6;
}

button:not(.af-action):not(.af-choice):not(.af-entry) {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  color: var(--primary-color);
  font-size: 14px;
  line-height: 1.6;
}

button:not(.af-action):not(.af-choice):not(.af-entry)::after {
  border: none;
}

/* 本页按账事实与办理动作排版；不改变金额、状态或办理资格。 */

.work-heading { padding: 4rpx 0 24rpx; }
.work-title { display: block; font-size: 36rpx; font-weight: 700; }
.work-caption { display: block; margin-top: 8rpx; color: var(--text-regular); font-size: 25rpx; line-height: 1.6; }
.section { padding: 24rpx; border-radius: 12rpx; box-shadow: none; background: #fff; }
.task-row { padding: 22rpx 0; background: #fff; border-radius: 0; border-top: 1rpx solid var(--border-color); font-size: 30rpx; font-weight: 600; word-break: break-all; }
.task-row text { font-weight: 400; margin-top: 8rpx; color: var(--text-regular); }
.task-row button:not(.af-action):not(.af-choice):not(.af-entry) { font-weight: 500; }
button:not(.af-action):not(.af-choice):not(.af-entry),button:not(.af-action):not(.af-choice):not(.af-entry)[size="mini"] { box-sizing: border-box; min-height: 44px; max-width: 100%; padding: 20rpx; border-radius: 8rpx; font-size: 14px; line-height: 1.6; white-space: normal; word-break: break-all; }
input,textarea { width: 100%; box-sizing: border-box; border: 1rpx solid var(--border-color); padding: 20rpx; margin: 16rpx 0; border-radius: 8rpx; font-size: 28rpx; font-weight: 400; }
input { height: 88rpx; } textarea { height: 200rpx; }
.empty-state { background: var(--bg-color); border-radius: 8rpx; }

/* 待办分组和主要动作 */
.page { background: #f3f6fa; }
.work-heading { padding: 12rpx 4rpx 28rpx; }
.work-title { color: #172b45; }
.section { margin-bottom: 20rpx; padding: 28rpx; border-radius: 20rpx; }
.title { border: 0; padding: 0; color: #172b45; font-weight: 700; }
.task-row { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #e4ebf2; border-radius: 14rpx; background: #f8fafc; word-break: break-all; }
.task-row text.card-title { margin-top: 0; color: #172b45; font-size: 30rpx; font-weight: 700; }
.task-row text.card-amount { color: #1264d6; font-size: 29rpx; font-weight: 700; }
.task-row text.card-action { color: #1264d6; font-weight: 600; }
.task-row button:not(.af-action):not(.af-choice):not(.af-entry) { background: #1264d6; color: #fff; border-color: #1264d6; }
.task-row button:not(.af-action):not(.af-choice):not(.af-entry)[disabled] { opacity: .5; }
.ticket-tool { border: 1rpx solid #dbe5ef; }

/* 2026-10-28：本页信息层级、小屏长字与触控下限；业务语义由原数据决定。 */
button:not(.af-action):not(.af-choice):not(.af-entry) { min-height:44px; height:auto; line-height:1.45; white-space:normal; box-sizing:border-box; }
.btn-primary,.primary-button,.btn-confirm { min-height:48px; }

.waiting-nav { display:flex; flex-wrap:wrap; gap:8px; padding:0 0 16px; }
.waiting-nav button:not(.af-action):not(.af-choice):not(.af-entry) { flex:1 1 96px; margin:0; padding:10px; background:#fff; color:#475569; border:1px solid #dbe3ed; font-size:14px; }
.waiting-nav button:not(.af-action):not(.af-choice):not(.af-entry).selected { background:#eaf2ff; border-color:#1264d6; color:#1264d6; font-weight:600; }
.section { border:1px solid #e2e8f0; box-shadow:none; }
.section button:not(.af-action):not(.af-choice):not(.af-entry) { margin-top:10px; background:#f4f8ff; color:#1264d6; border:1px solid #cbdcf4; font-size:14px; }
.section button:not(.af-action):not(.af-choice):not(.af-entry).waiting-danger { color:#a63228; background:#fff; border-color:#e7c6c2; }
.section button:not(.af-action):not(.af-choice):not(.af-entry).waiting-secondary { color:#536275; background:#fff; border-color:#dbe3ed; }
.title,.card-title,.card-amount { overflow-wrap:anywhere; line-height:1.5; }
.card-amount { font-size:18px; font-weight:700; }
.row { padding:16px 0; }

/* B3: shared B0 families own control appearance; this page owns only arrangement. */
page { --primary-color:var(--af-primary); --primary-bg:var(--af-soft); --warning-color:var(--af-strong); --warning-bg:var(--af-soft); --text-primary:var(--af-ink); --text-regular:var(--af-text-secondary); --border-color:var(--af-border); }
.b3-record-entry { display:block; min-height:52px; }
.b3-disclosure { min-height:52px; box-sizing:border-box; }
.b3-quantity { min-height:48px; min-width:48px; background:var(--af-soft); font-size:20px; }
.b3-on-search,.b3-on-record-search,.b3-on-refusal-search { flex:none; }
.b3-on-remove-evidence { min-width:44px; min-height:44px; }

/* Form actions stretch only where their own task requires it. */
.footer .af-action--cancel,.modal-footer .af-action--cancel { flex:0 0 80px; min-height:48px; }
.footer .af-action--primary,.modal-footer .af-action--primary { flex:1; min-width:44px; }
.b3-on-save,.b3-on-submit,.b3-on-submit-refund-note,.b3-on-close-dispute,.b3-on-save-status { display:flex; width:100%; }
.b3-on-pick-mode .af-choice__face,.b3-on-pick-status .af-choice__face { flex-direction:column; align-items:flex-start; gap:4px; }
.b3-choice-unavailable .af-choice__face { color:var(--af-disabled-text); background:var(--af-disabled-bg); }
button.af-entry { margin:0; border:0; border-radius:0; line-height:22px; font-size:14px; }
button.af-entry::after { border:0; }

/* Visual v2: page-specific information and action grouping. */
 .work-heading { padding:16px; border-radius:14px; background:var(--af2-surface-current); } .work-title { color:var(--af2-ink-current); } .section { border-radius:14px; box-shadow:none; } .task-row { padding:14px 0; border-bottom:1px solid var(--af-border); border-radius:0; box-shadow:none; } .card-action { color:var(--af2-ink-order); } .waiting-nav .af-choice { flex:1; min-width:0; }

.waiting-nav .af-choice.selected .af-choice__face { background:var(--af2-surface); border-color:var(--af-primary); color:var(--af2-ink-order); font-weight:600; }
