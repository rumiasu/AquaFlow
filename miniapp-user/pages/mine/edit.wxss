.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx;
  box-sizing: border-box;
}

.form-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  margin-bottom: 32rpx;
  box-shadow: none;
  border: 1rpx solid var(--border-color);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  min-height: 104rpx;
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  flex-shrink: 0;
  font-weight: 500;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: left;
  min-width: 0;
  min-height: 88rpx;
}

.submit-btn {
  margin-top: 24rpx;
  height: 96rpx;
  background: var(--primary-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.submit-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  background: var(--text-placeholder);
  box-shadow: none;
}


.page-intro { padding: 4rpx 0 24rpx; }
.page-intro-title { display: block; font-size: 36rpx; font-weight: 700; line-height: 1.4; color: var(--text-primary); }
.page-intro-note { display: block; margin-top: 10rpx; font-size: 26rpx; line-height: 1.6; color: var(--text-regular); }
.container { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.save-error { font-size: 28rpx; line-height: 1.65; color: #9a3412; background: #fff7ed; padding: 24rpx; border-radius: 12rpx; }
.submit-btn.disabled { background: var(--bg-gray); }
.submit-btn.disabled text { color: var(--text-regular); }
