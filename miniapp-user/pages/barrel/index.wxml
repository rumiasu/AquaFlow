<view class="container">
  <loading wx:if="{{loading}}"></loading>

  <block wx:else>
    <view class="stats-card">
      <view class="stat-col">
        <text class="stat-label">持有桶</text>
        <view class="stat-value-row">
          <text class="stat-number">{{summary.heldBuckets}}</text>
          <text class="stat-unit">个</text>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col">
        <text class="stat-label">押金</text>
        <view class="stat-value-row">
          <text class="stat-number deposit">¥{{summary.depositBalance}}</text>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col">
        <text class="stat-label">欠桶</text>
        <view class="stat-value-row">
          <text class="stat-number owed">{{summary.owedBuckets}}</text>
          <text class="stat-unit">个</text>
        </view>
      </view>
    </view>

    <view class="owed-tip" wx:if="{{summary.owedBuckets > 0}}">
      <text>欠桶 {{summary.owedBuckets}} 桶：配送应回收未回收的空桶，不参与购买上限，退桶请与水站确认</text>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">长期桶资产（按商品聚合）</text>
        <view class="return-btn-small" bindtap="onShowReturnModal" wx:if="{{maxReturnQty > 0}}">
          <text>申请退桶</text>
        </view>
      </view>

      <view class="bucket-list" wx:if="{{customerBarrelAsset.length > 0}}">
        <view class="bucket-item" wx:for="{{customerBarrelAsset}}" wx:key="productId">
          <view class="bucket-info">
            <view class="bucket-icon"><icon name="barrel" size="40rpx" color="#0EA5E9" /></view>
            <view class="bucket-detail">
              <text class="bucket-id">{{item.productName}} {{item.productSpec}}</text>
              <text class="bucket-time">持有 {{item.assetQty || 0}} 桶 / 欠桶 {{item.owedQty || 0}}</text>
            </view>
          </view>
          <view class="bucket-status">
            <text>押金 ¥{{item.deposit}}/桶</text>
          </view>
        </view>
      </view>

      <empty wx:else text="暂无长期桶资产"></empty>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">水桶记录</text>
      </view>
      <view class="bucket-list" wx:if="{{records.length > 0}}">
        <view class="bucket-item" wx:for="{{records}}" wx:key="id">
          <view class="bucket-info">
            <view class="bucket-icon"><icon name="barrel" size="40rpx" color="#0EA5E9" /></view>
            <view class="bucket-detail">
              <text class="bucket-id">{{item.barrelNo || ('桶号 #' + item.id)}}</text>
              <text class="bucket-time" wx:if="{{item.createTime}}">{{item.createTime}}</text>
            </view>
          </view>
          <view class="bucket-status status-{{item.status || 0}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>
      </view>
      <empty wx:else text="暂无水桶记录"></empty>
    </view>

    <view class="info-card">
      <view class="info-row" wx:if="{{summary.depositPerBucket > 0}}">
        <text class="info-label">最近一次每桶押金</text>
        <text class="info-value">¥{{summary.depositPerBucket}}</text>
      </view>
      <view class="info-tip">
        <text>不同商品的押金不同，退桶时可申请退还押金，退桶后押金将从余额中扣除</text>
      </view>
    </view>

    <view class="eco-card">
      <view class="eco-content">
        <view class="eco-icon"><icon name="droplet" size="40rpx" color="#10B981" /></view>
        <view class="eco-text">
          <text class="eco-title">爱护水桶</text>
          <text class="eco-desc">水桶是可循环使用的资源，请妥善保管，避免暴晒和污染</text>
        </view>
      </view>
      <view class="eco-btn" bindtap="onEcoRuleTap">
        <text>了解回收规则</text>
      </view>
    </view>
  </block>

  <view class="modal-mask" wx:if="{{showReturnModal}}" bindtap="onCloseReturnModal"></view>
  <view class="modal-content {{showReturnModal ? 'show' : ''}}" catchtap="">
    <view class="modal-header">
      <text class="modal-title">申请退桶</text>
      <text class="modal-close" bindtap="onCloseReturnModal">×</text>
    </view>

    <view class="modal-body">
      <view class="return-tip">
        <text>当前可退 <text class="highlight">{{maxReturnQty}}</text> 桶</text>
      </view>

      <view class="form-row" wx:if="{{customerBarrelAsset.length > 0}}">
        <text class="form-label">商品</text>
        <view class="water-type-list">
          <view class="water-type-item {{returnForm.productId === item.productId ? 'active' : ''}}"
                wx:for="{{customerBarrelAsset}}" wx:key="productId"
                data-id="{{item.productId}}" bindtap="onSelectProduct">
            <text>{{item.productName}}{{item.productSpec ? ' ' + item.productSpec : ''}}</text>
            <text class="water-type-qty">持有 {{item.assetQty || 0}} 桶</text>
          </view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">退桶数量</text>
        <view class="quantity-control">
          <view class="qty-btn {{returnForm.quantity <= 1 ? 'disabled' : ''}}" bindtap="onReturnQtyChange" data-type="minus">
            <text>-</text>
          </view>
          <input class="qty-input" type="number" value="{{returnForm.quantity}}" bindinput="onReturnQtyInput"></input>
          <view class="qty-btn {{returnForm.quantity >= maxReturnQty ? 'disabled' : ''}}" bindtap="onReturnQtyChange" data-type="add">
            <text>+</text>
          </view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">退押金（元）</text>
        <view class="deposit-input-row">
          <input class="deposit-input" type="digit" value="{{returnForm.depositRefund}}" bindinput="onDepositRefundInput" placeholder="0"></input>
          <text class="deposit-max" bindtap="onFullRefund">全额退 ¥{{summary.depositBalance}}</text>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="note-input" placeholder="如：搬家、换地址等" value="{{returnForm.note}}" bindinput="onReturnNoteInput"></input>
      </view>
    </view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onCloseReturnModal">
        <text>取消</text>
      </view>
      <view class="modal-btn confirm {{submitting ? 'disabled' : ''}}" bindtap="onSubmitReturn">
        <text>{{submitting ? '提交中...' : '提交申请'}}</text>
      </view>
    </view>
  </view>
</view>
