.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 说明头部 */
.info-header {
  background: var(--primary-bg);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.info-icon {
  font-size: var(--font-xl);
  flex-shrink: 0;
}

.info-text {
  font-size: var(--font-sm);
  color: var(--text-regular);
  line-height: 1.6;
}

/* 订单列表 */
.order-list {
  padding: 0 var(--spacing-md);
}

.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  border-left: 6rpx solid var(--warning-color);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.status-tag {
  font-size: var(--font-sm);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-round);
  font-weight: 600;
}

.status-transfer {
  background: rgba(255, 149, 0, 0.1);
  color: var(--warning-color);
}

.order-date {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.customer-info {
  margin-bottom: var(--spacing-sm);
}

.customer-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.product-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.product-name {
  font-size: var(--font-md);
  color: var(--text-regular);
}

.product-spec {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-gray);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.product-qty {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 600;
  margin-left: auto;
}

.address-info {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.address-icon {
  font-size: var(--font-md);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.address-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex: 1;
}

.transfer-note {
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border-light);
  display: flex;
  gap: var(--spacing-sm);
}

.note-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.note-text {
  font-size: var(--font-sm);
  color: var(--text-regular);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx var(--spacing-lg);
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: var(--spacing-lg);
}

.empty-text {
  font-size: var(--font-lg);
  color: var(--text-regular);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}
