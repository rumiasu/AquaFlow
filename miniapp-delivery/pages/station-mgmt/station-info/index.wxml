<import src="../../../templates/setup-module-tasks.wxml" />
<!--
  站长端「水站资料」：站名 / 电话 / 地址 / 坐标。
  [2026-09-19 新建] 见 index.js 文件头：这几个字段此前在小程序里是死的（只能读不能改）。
  ⚠️ 保存时四项一起提交（后端是整行覆盖）；`status`（营业/停业硬状态）由 js 原样带回，
     本页**不提供**它的入口 —— 停业会真拒单、且不在公开选站列表里，不该藏在资料表单里顺手改掉。
-->
<view class="container">
  <view class="settings-section-nav"><button wx:for="{{settingsSections}}" wx:key="target" data-target="{{item.target}}" bindtap="onSettingsSection" class="af-choice b3-on-settings-section" hover-class="af-action--pressed"><view class="af-choice__face">{{item.label}}</view></button></view>

  <template is="setupModuleTasks" data="{{tasks:moduleSetupTasks,loading:moduleSetupLoading,ready:moduleSetupReady,error:moduleSetupError}}" />
  <!-- 隐私授权弹窗：本页用 wx.chooseLocation 选水站坐标，必须渲染（原因见 components/PrivacyPopup/index.js 文件头） -->
  <privacy-popup />

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="ui-state" wx:elif="{{loadError}}"><text class="ui-state-title">水站资料加载失败</text><text class="ui-state-copy">{{loadError}}</text><button size="mini" bindtap="onRetry" class="af-action af-action--quiet b3-on-retry" hover-class="af-action--pressed"><view class="af-action__face">重新读取资料</view></button></view>
  <block wx:elif="{{origin}}">
    <view class="draft-status" wx:if="{{infoDraftAvailable}}"><text>有上次未保存的资料输入。</text><button bindtap="onRestoreInfoDraft" class="af-action af-action--quiet b3-on-restore-info-draft" hover-class="af-action--pressed"><view class="af-action__face">恢复原输入</view></button><button bindtap="onDiscardInfoDraft" class="af-action af-action--cancel b3-on-discard-info-draft" hover-class="af-action--pressed">放弃旧草稿</button></view>
    <text class="draft-status" wx:if="{{infoDraftStatus}}">{{infoDraftStatus}}</text>
    <!-- ============ 基本资料 ============ -->
    <view class="card" id="info-basics">
      <view class="card-title-row">
        <text class="card-title">基本资料</text>
      </view>

      <view class="field">
        <text class="field-label">水站名称<text class="required">*</text></text>
        <input class="field-input" placeholder="如：阳光水站（城东店）" maxlength="50"
               disabled="{{saving}}" value="{{form.name}}" bindinput="onNameInput" />
      </view>

      <view class="field">
        <text class="field-label">联系电话</text>
        <input id="setup-station-phone" class="field-input" type="number" placeholder="请输入联系电话" maxlength="20"
               disabled="{{saving}}" value="{{form.phone}}" bindinput="onPhoneInput" />
      </view>

      <view class="field">
        <text class="field-label">水站地址</text>
        <textarea class="field-textarea" placeholder="写清到能找得到，如：阳光小区 8 栋 1 单元 101" maxlength="200"
                  disabled="{{saving}}" value="{{form.address}}" bindinput="onAddressInput" />
        <!-- [2026-09-23] 点明"地址与坐标是一次选点同时得到的"，否则站长会以为要填两遍。
             [2026-09-24] 压成一行 —— 产品反馈"界面好啰嗦"，细节留给下面的坐标卡说。 -->
        <text class="field-hint">也可以点下面的「地图选点」自动填入</text>
      </view>

      <text class="draft-status" wx:if="{{infoDraftNotice}}">{{infoDraftNotice}}</text>
      <view class="layout-submit-group"><button disabled="{{saving || coordSaving}}" class="af-action af-action--primary b3-on-save af-action--block" bindtap="onSave" hover-class="af-action--pressed">
        {{saving ? '保存中…' : '保存资料'}}
      </button></view>
    </view>

    <!-- ============ 水站坐标（配送范围判定用）============ -->
    <view class="card" id="setup-station-position">
      <view class="card-head">
        <text class="card-title">水站坐标</text>
        <text class="badge badge-on" wx:if="{{coord.lat !== null && coord.lng !== null}}">已设置</text>
        <text class="badge badge-warn" wx:else>未设置</text>
      </view>
      <text class="card-sub" wx:if="{{coord.lat !== null && coord.lng !== null}}">当前坐标：{{coord.lat}}, {{coord.lng}}</text>
      <text class="field-hint" wx:else>未设置坐标，无法计算配送距离。</text>
      <text class="field-hint">选点后立即保存坐标；地址填入上方草稿，点击保存资料后生效。</text>
      <view class="layout-coordinate-actions"><button class="af-action af-action--secondary b3-on-pick-coordinates" bindtap="onPickCoordinates" loading="{{coordSaving}}" disabled="{{coordSaving}}" hover-class="af-action--pressed">地图选点并保存坐标</button>
      <button class="af-action af-action--danger-quiet b3-on-clear-coordinates" wx:if="{{coord.lat !== null || coord.lng !== null}}" bindtap="onClearCoordinates" hover-class="af-action--pressed">清除坐标</button></view>
    </view>


  </block>

</view>
<business-dialog id="business-dialog" />
