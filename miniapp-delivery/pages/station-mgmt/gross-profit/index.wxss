.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.picker {
  height: 72rpx;
  line-height: 72rpx;
  background: var(--bg-gray);
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 14rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  padding: 12rpx 26rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 32rpx;
  font-size: 25rpx;
  color: var(--text-primary);
  margin: 0 16rpx 16rpx 0;
}
.chip-warn {
  border-color: var(--warning-bg);
  color: var(--warning-color);
  background: var(--warning-bg);
}

/* 合计：三个数字一眼看完；利润算不出（缺成本）时给警示色而不是 0 */
.hero {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}
.hero-item {
  flex: none;
  width: calc(50% - 6rpx);
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 12rpx;
  background: var(--bg-gray);
  text-align: left;
}
.hero-num {
  display: block;
  margin-top: 6rpx;
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.hero-ok {
  color: var(--success-color);
}
.hero-warn {
  color: var(--warning-color);
  font-size: 28rpx;
}
.hero-label {
  display: block;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.missing-cost-strip { padding: 14rpx 18rpx; margin-bottom: 12rpx; border: 1rpx solid var(--warning-bg); border-left: 4rpx solid var(--warning-color); border-radius: 12rpx; background: #FFFBF3; }
.missing-cost-title { display: block; color: var(--warning-color); font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.missing-cost-copy, .missing-cost-action { display: block; margin-top: 4rpx; color: var(--text-regular); font-size: 24rpx; line-height: 1.5; }
.missing-cost-action { color: var(--text-secondary); }
.missing-cost-strip .chips { gap: 8rpx; margin-top: 8rpx; }
.missing-cost-strip .chip { margin: 0; padding: 8rpx 14rpx; font-size: 24rpx; }

.profit-help-card { padding-bottom: 14rpx; }
.profit-help-group { border-top: 1rpx solid #E8ECF1; }
.profit-help-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 76rpx; }
.profit-help-title { min-width: 0; color: var(--text-primary); font-size: 27rpx; font-weight: 600; }
.profit-help-action, .profit-help-all { flex: none; color: var(--primary-color); font-size: 25rpx; }
.profit-help-body { padding: 0 0 16rpx; }
.profit-help-note { display: block; margin-top: 10rpx; color: var(--text-regular); font-size: 24rpx; line-height: 1.65; white-space: pre-line; overflow-wrap: anywhere; }
.profit-help-all { padding-top: 16rpx; border-top: 1rpx solid #E8ECF1; text-align: center; }

@media screen and (max-width: 359px) {
  .hero-item { width: 100%; }
}

.notice {
  background: var(--bg-gray);
  border: 1rpx solid var(--warning-bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: var(--warning-color);
  line-height: 38rpx;
  margin-bottom: 12rpx; border-left: 4rpx solid var(--warning-color); }

/* 收入构成与净利（[2026-09-19]）：一张"减法账"，每行一个数字，合计行加重。
   颜色沿用本页既有的语义：绿 = 正常给数（.hero-ok），橙 = 给不出数/需注意（.hero-warn）。 */
.ledger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}
.ledger-row:last-of-type {
  border-bottom: none;
}
.ledger-label {
  font-size: 26rpx;
  color: var(--text-regular);
}
.ledger-value {
  font-size: 28rpx;
  color: var(--text-primary);
}
.ledger-strong {
  border-top: 1rpx solid #E8ECF1;
}
.ledger-strong .ledger-label,
.ledger-strong .ledger-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.ledger-ok {
  color: var(--success-color);
}
.ledger-warn {
  color: var(--warning-color);
  font-size: 27rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E8ECF1;
}
.row:last-child {
  border-bottom: none;
}
.row-main {
  flex: 1;
  overflow: hidden;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-title {
  font-size: 27rpx;
  color: var(--text-primary);
}
.row-amount {
  font-size: 27rpx;
  color: var(--text-primary);
}
.row-sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 34rpx;
}
.row-warn {
  color: var(--warning-color);
}
.row-arrow {
  color: var(--text-placeholder);
  font-size: 34rpx;
  padding-left: 12rpx;
}

.btn-primary {
  height: auto;
  line-height: 1.5;
  text-align: center;
  background: var(--primary-color);
  color: #fff;
  border-radius: 12rpx;
  font-size: 16px; min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-ghost {
  height: auto;
  line-height: 1.5;
  text-align: center;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--text-primary); min-height:44px; display:flex; align-items:center; justify-content:center; }
.btn-ghost.block {
  margin-top: 18rpx;
}
.btn-disabled {
  background: var(--primary-bg);
}

.empty {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 0;
  line-height: 40rpx;
}
.hint {
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 36rpx;
  margin-top: 12rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.dialog {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 28%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 10;
}
.dialog-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.dialog-input {
  height: 80rpx;
  background: var(--bg-gray);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
.dialog-footer {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.dialog-footer .flex1 {
  flex: 1;
  margin-right: 12rpx;
}
.dialog-footer .flex1:last-child {
  margin-right: 0;
}

/* 本页按账事实与办理动作排版；不改变金额、状态或办理资格。 */

.page { min-height: 100vh; box-sizing: border-box; background: var(--bg-color); }.card,.hero { border-radius: 12rpx; }
.period-card { display: flex; flex-wrap: wrap; gap: 12rpx; }.period-card .card-title { width: 100%; margin-bottom: 0; }.period-card > picker { flex: 1 1 260rpx; min-width: 0; }.period-card .chips,.period-card .hint { width: 100%; }.picker { margin-bottom: 0; height: 88rpx; line-height: 88rpx; box-sizing: border-box; border-radius: 8rpx; }
.chip { min-height: 88rpx; box-sizing: border-box; border-radius: 8rpx; padding: 20rpx; display: flex; align-items: center; line-height: 1.6; white-space: normal; word-break: break-all; }
.hero { flex-wrap: wrap; gap: 12rpx; padding: 18rpx; }.hero-item { min-width: 0; word-break: break-all; }
.hero-label,.hint,.row-sub { font-size: 25rpx; color: var(--text-regular); line-height: 1.6; }.row-main { min-width: 0; overflow: visible; }.row-between,.ledger-row { gap: 16rpx; align-items: flex-start; }.row-between { flex-wrap: wrap; }.row-title { word-break: break-all; }.row-amount { margin-left: auto; word-break: break-all; }.ledger-row,.row,.ledger-strong { border-color: var(--border-color); }.ledger-value { text-align: right; word-break: break-all; }
.btn-primary,.btn-ghost { min-height: 48px; height: auto; box-sizing: border-box; padding: 20rpx; display: flex; justify-content: center; align-items: center; line-height: 1.6; border-radius: 8rpx; white-space: normal; word-break: break-all; }
.dialog { top: 12%; left: 24rpx; right: 24rpx; max-height: 78vh; overflow-y: auto; box-sizing: border-box; border-radius: 12rpx; }.dialog-footer { flex-wrap: wrap; gap: 12rpx; }.dialog-footer .flex1 { margin-right: 0; flex: 1 1 150rpx; }.dialog-input { height: 88rpx; }
