<!-- 我的 · Step6 重构（2026-09-12）：押金/水票/桶三项卡 + 三组菜单
     原则：回答「我有什么」，不陈列「本 App 还有什么功能」；措辞务实，不玩商务黑话。 -->
<view class="page">
  <!-- 用户行 -->
  <view class="card user-card" bindtap="{{isLogin ? 'onEditProfile' : 'onLogin'}}">
    <image wx:if="{{isLogin && userInfo.avatarUrl && !avatarFailed}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
    <view wx:else class="avatar avatar-placeholder"><icon name="user" size="30px" color="#253D59" /></view>
    <view class="user-info">
      <text class="nickname">{{isLogin ? (userInfo.nickName || userInfo.nickname || '用户') : '点击登录'}}</text>
      </view>
    <text class="row-arrow">›</text>
  </view>

  <block wx:if="{{isLogin}}">
    <!-- 2026-10-07 #10：只展示真实押金账户、水票余量和桶汇总；未加载与真实 0 分开。
         桶卡保持中性「我的桶」：新路径读 E+over，历史汇总含配送中，说明由 js 区分。 -->
    <asset-station-view id="asset-station-view" station-id="{{viewStationId}}" station-name="{{stationName}}" status-text="{{viewStationStatusText}}" order-station-name="{{orderStationName}}" busy="{{submitting || recoveringPurchase}}" bind:change="onAssetStationChange" />
    <view class="card assets-card">
      <text class="asset-refresh-note" wx:if="{{assetsLoading}}">正在读取本站资产…</text>
      <text class="asset-refresh-note" wx:if="{{staleAssetsText}}">{{staleAssetsText}}</text>
      <view class="assets-grid {{assetLongValues || assetLargeText || assetStationRequired || unloadedCount > 0 || (depositLoaded && depositText.length > 3) ? 'assets-grid--stacked' : ''}}">
        <!-- 水票、押金和桶各自保留原站级入口；长数字切行而非截断。 -->
        <view class="asset-cell asset-cell-primary asset-order" data-url="/pages/ticket/index" bindtap="onMenuTap" aria-role="button" aria-label="查看水票与购买水票">
          <view class="asset-heading"><view class="asset-icon"><icon name="ticket" size="20px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /></view><text class="asset-label">可用水票</text></view>
          <view class="asset-main"><text class="asset-value {{ticketLoaded ? '' : 'asset-value-unloaded'}}">{{ticketText}}<text class="asset-unit" wx:if="{{ticketLoaded}}"> 张</text></text><text class="asset-entry">购票 ›</text></view>
        </view>
        <view class="asset-cell asset-money-tone" data-url="/pages/deposit/records/index" bindtap="onMenuTap" aria-role="button" aria-label="查看押金余额与流水">
          <view class="asset-heading"><view class="asset-icon"><icon name="wallet" size="20px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /></view><text class="asset-label">押金余额</text></view>
          <view class="asset-main"><text class="asset-value asset-money {{depositLoaded ? '' : 'asset-value-unloaded'}}">{{depositLoaded ? '¥' + depositText : depositText}}</text><text class="asset-entry">流水 ›</text></view>
        </view>
        <view class="asset-cell asset-physical" data-url="/pages/barrel/index" bindtap="onMenuTap" aria-role="button" aria-label="查看我的桶与管理办理">
          <view class="asset-heading"><view class="asset-icon"><icon name="barrel" size="20px" color="#1264D6" variant="duotone" fill-color="#EAF2FF" /></view><text class="asset-label">我的桶</text></view>
          <view class="asset-main"><text class="asset-value {{barrelLoaded ? '' : 'asset-value-unloaded'}}">{{barrelText}}<text class="asset-unit" wx:if="{{barrelLoaded}}"> 个</text></text><text class="asset-entry">管理 ›</text></view>
        </view>
      </view>
      <view class="asset-note" wx:if="{{assetStationRequired}}">
        <text class="asset-note-text">请选择水站后查看资产。</text>
      </view>
      <!-- 有格子没加载出来时的显式提示 + 重试（toast 会消失，这一条不会） -->
      <view class="assets-unloaded-tip" wx:if="{{unloadedCount > 0}}" bindtap="onRetryAssets">
        <text class="assets-unloaded-text">{{unloadedCount}} 项资产暂未加载</text>
        <text class="assets-unloaded-retry">重新加载 ›</text>
      </view>
    </view>

    <!-- 常用操作与低频服务分开，资产流水仍从上方资产卡进入。 -->
    <view class="group-title">常用服务</view>
    <view class="card quick-actions {{isCompany ? 'company-actions' : ''}}">
      <view class="quick-action" data-url="/pages/payment/records" bindtap="onMenuTap" aria-role="button" aria-label="账单记录"><view class="quick-icon"><icon name="bill" size="20px" color="#1264D6" /></view><text class="quick-label">账单记录</text></view>
      <view class="quick-action" data-url="/pages/address/list" bindtap="onMenuTap" aria-role="button" aria-label="地址管理"><view class="quick-icon"><icon name="location" size="20px" color="#1264D6" /></view><text class="quick-label">地址管理</text></view>
      <view class="quick-action" data-url="/pages/service/index" bindtap="onMenuTap" aria-role="button" aria-label="客服反馈"><view class="quick-icon"><icon name="chat" size="20px" color="#1264D6" /></view><text class="quick-label">客服反馈</text></view>
      <view class="quick-action" wx:if="{{isCompany}}" data-url="/pages/mine/company" bindtap="onMenuTap" aria-role="button" aria-label="企业资料"><view class="quick-icon"><icon name="building" size="20px" color="#1264D6" /></view><text class="quick-label">企业资料</text></view>
    </view>
    <!-- 3:1 场景位于原生导航下；整卡只有一个点击目标。 -->
    <view class="scene-entry" data-url="/pages/template/index" bindtap="onMenuTap" aria-role="button" aria-label="常用订水配置">
      <image wx:if="{{!entryGraphicFailed}}" class="scene-entry-image" src="{{sceneImageUrl}}" data-src="{{sceneImageUrl}}" mode="aspectFit" binderror="onEntryGraphicError" />
      <view wx:else class="scene-entry-fallback"><icon name="barrel" size="38px" color="#1264D6" /></view>
      <view class="scene-entry-copy"><text class="scene-entry-title">常用订水</text><text class="scene-entry-link">查看清单 ›</text></view>
    </view>
    <view class="asset-refresh-note" wx:if="{{companyInfoFailed}}" bindtap="onRetryAssets">企业资料状态暂未核实，点此重试。</view>

    <view class="group-title">更多服务</view>
    <view class="card menu-card">
      <view class="menu-row af-entry" data-url="/pages/mine/asset-claims/index" bindtap="onMenuTap"><icon name="ticket" size="20px" color="#1264D6" /><text class="menu-name">历史资产认领</text><text class="row-arrow">›</text></view>
      <view class="menu-row af-entry" data-url="/pages/shop/index" bindtap="onMenuTap"><icon name="shop" size="20px" color="#1264D6" /><text class="menu-name">更多商品</text><text class="row-arrow">›</text></view>
      <view class="menu-row af-entry" data-url="/pages/notice/index" bindtap="onMenuTap"><icon name="notice" size="20px" color="#1264D6" /><text class="menu-name">公告</text><text class="row-arrow">›</text></view>
      <view class="menu-row af-entry" data-url="/pages/exception/list/list" bindtap="onMenuTap"><icon name="order" size="20px" color="#1264D6" /><text class="menu-name">服务记录</text><text class="row-arrow">›</text></view>
      <view class="menu-row af-entry" data-url="/pages/mine/account-data/index" bindtap="onMenuTap"><icon name="user" size="20px" color="#1264D6" /><text class="menu-name">个人资料与注销</text><text class="row-arrow">›</text></view>
      <view class="menu-row af-entry" data-url="/pages/mine/about" bindtap="onMenuTap"><icon name="order" size="20px" color="#1264D6" /><text class="menu-name">关于我们</text><text class="row-arrow">›</text></view>
    </view>

    <button class="logout af-action af-action--secondary" bindtap="onLogout">退出登录</button>
  </block>

  <!-- 游客态 -->
  <block wx:else>
    <view class="group-title">服务</view>
    <view class="card menu-card">
      <view class="menu-row af-entry" data-url="/pages/shop/index" bindtap="onMenuTap">
        <icon name="shop" size="20px" color="#1264D6" /><text class="menu-name">更多商品</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row af-entry" data-url="/pages/notice/index" bindtap="onMenuTap">
        <icon name="notice" size="20px" color="#1264D6" /><text class="menu-name">公告</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row af-entry" data-url="/pages/service/index" bindtap="onMenuTap">
        <icon name="chat" size="20px" color="#1264D6" /><text class="menu-name">联系客服</text>
        <text class="row-arrow">›</text>
      </view>
      <view class="menu-row af-entry" data-url="/pages/mine/about" bindtap="onMenuTap">
        <icon name="order" size="20px" color="#1264D6" /><text class="menu-name">关于我们</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </block>
</view>
<business-dialog id="business-dialog" />
