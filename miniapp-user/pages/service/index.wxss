.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.service-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.service-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.service-item:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.service-value-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-value {
  font-size: 30rpx;
  color: #333;
}

.call-btn,
.copy-btn {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.call-btn {
  background-color: #07c160;
  color: #fff;
}

.copy-btn {
  background-color: #f5f5f5;
  color: #666;
}

.other-section {
  background-color: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.other-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.other-item:last-child {
  border-bottom: none;
}

.other-title {
  font-size: 28rpx;
  color: #333;
}

.other-arrow {
  color: #ccc;
  font-size: 32rpx;
}
