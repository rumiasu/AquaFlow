.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  background: var(--bg-color);
  box-sizing: border-box;
}

.section-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  margin-bottom: 28rpx;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.required {
  color: var(--error-color);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-color);
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-btn {
  width: 160rpx;
  height: auto;
  line-height: 1.5;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 14px;
  padding: 0;
  border: none; min-height:44px; display:flex; align-items:center; justify-content:center; }

.station-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.station-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.station-item.selected {
  background: var(--primary-bg);
  border-color: var(--primary-color);
}

.station-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.station-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.station-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 就近找站（2026-09-26）：定位状态行 + 搜索框 + 距离 ===== */

/* 定位状态行：说清"现在按什么顺序排"以及"还能怎么找" */
.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--primary-bg);
  border: 1rpx solid var(--primary-bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin: 0 0 16rpx;
}

.loc-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-regular);
  line-height: 1.5;
}

.loc-action {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.search-clear {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 10rpx;
}

.station-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

/* 距离由服务端算好下发（distanceKm）；没坐标的站显示「位置未设置」，样式弱一档 */
.station-distance {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--primary-color);
  background: var(--primary-bg);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.station-map-link {
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 6rpx 0;
}

.station-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.station-phone {
  font-size: 24rpx;
  color: var(--primary-color);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-placeholder);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.radio.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.radio-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-tip {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ===== 申请历史（只读列表）===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
}

.history-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.history-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.history-station {
  flex: 1;
  font-size: 26rpx;
  color: var(--primary-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-status {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.history-note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #E8ECF1;
}

.btn-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--primary-color);
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 16rpx;
}

.btn-submit[disabled] {
  background: var(--primary-bg);
  color: #ffffff;
}

/* 「绑定规则 ?」一行（2026-09-24）：说明收进问号后，这行只剩标签 + 问号，居中即可 */
.footer-hint-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 退出出口：本页是被 redirectTo 进来的，页面栈无上一页，没有这个按钮用户就出不去 */
.footer-action {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  background: var(--bg-card);
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.footer-action:active { opacity: 0.8; }

/* 2026-10-22：经营任务层级与窄屏触控；业务状态和数据来源保持原样。 */
.container { padding-bottom:360rpx; }
.section-card { padding:28rpx 24rpx; border-radius:12rpx; box-shadow:none; border:1rpx solid var(--border-color); }
.card-title { font-size:34rpx; }
.card-desc,.station-address,.history-time,.history-status { color:var(--text-regular); font-size:26rpx; line-height:1.6; }
.station-item { background:#fff; border-radius:0; border:0; border-bottom:1rpx solid var(--border-color); padding:24rpx 0; min-height:112rpx; }
.station-name-row,.history-head { flex-wrap:wrap; }
.station-name { font-size:32rpx; overflow-wrap:break-word; }
.station-address { display:block; overflow:visible; -webkit-line-clamp:unset; }
.station-main { overflow:visible; min-width:0; }
.station-action { flex-shrink:0; font-size:28rpx; font-weight:600; color:var(--primary-color); }
.station-map-link,.loc-action,.search-clear { min-height:88rpx; display:flex; align-items:center; font-size:26rpx; box-sizing:border-box; }
.search-input { min-width:0; height:88rpx; }
.search-row { border:1rpx solid var(--border-color); border-radius:10rpx; }
.loc-row { border-radius:8rpx; }
.history-item { background:var(--bg-color); border-radius:8rpx; }
.history-station { white-space:normal; overflow-wrap:break-word; min-width:160rpx; }
.footer { border-color:var(--border-color); }
.footer-action { min-height:88rpx; margin-top:12rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; color:var(--text-regular); }

.container { padding-bottom:calc(48rpx + env(safe-area-inset-bottom)); }
.footer { position:static; padding:20rpx 0; background:transparent; border:0; }
.station-action,.history-toggle { min-height:44px; display:flex; align-items:center; box-sizing:border-box; }
.history-toggle { flex-wrap:wrap; justify-content:space-between; }

/* 2026-10-28 B2: local layout only; B0 owns action/choice faces and tokens. */
 .b2-page { --primary-color: var(--af-primary); --primary-bg: var(--af-soft); --text-primary: var(--af-ink); --text-regular: var(--af-text-secondary); --text-secondary: var(--af-text-secondary); --bg-gray: var(--af-soft); --success-color: var(--af-positive); --error-color: var(--af-danger); --error-bg: var(--af-danger-soft); --bg-color: var(--af-canvas); --bg-card: var(--af-surface); --border-color: var(--af-border); }
 .b2-join-action { margin-left: auto; flex-shrink: 0; } .footer-actions { display: flex; flex-wrap: wrap; gap: 8px; } .search-row { gap: 8px; } .search-row input { flex: 1; min-width: 0; min-height: 44px; }

/* 2026-10-29 visual-L: page-local composition; shared controls and palette stay V0-owned. */
.lv2-page { --bg-color:var(--af2-page); --bg-card:var(--af2-surface); --border-color:var(--af2-line); --text-primary:var(--af2-ink); --text-regular:var(--af2-muted); background:var(--af2-page); color:var(--af2-ink); box-sizing:border-box; font-size:15px; line-height:24px; }
.lv2-page .ui-state { box-sizing:border-box; margin:12px 0; padding:16px; border-radius:14px; border:1px solid var(--af2-line); }
.lv2-title-row { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
.lv2-title-row > text { flex:1; min-width:0; font-size:22px; line-height:30px; font-weight:600; }
.lv2-page .af2-icon-tile { background:var(--af2-surface-order); }
.lv2-page .lv2-neutral-tile { background:var(--af2-surface-neutral); }
.lv2-page .lv2-physical-tile { background:var(--af2-surface-physical); }
.lv2-page .lv2-money-tile { background:var(--af2-surface-money); }

.lv2-apply { padding:16px 16px calc(160px + env(safe-area-inset-bottom)); }
.lv2-apply .section-card { margin:0 0 16px; padding:16px; border:0; border-radius:16px; }
.lv2-station-title { display:flex; align-items:center; gap:10px; }
.lv2-apply .card-title { font-size:18px; line-height:26px; }
.lv2-apply .card-desc, .lv2-apply .loc-text { font-size:13px; line-height:20px; }
.lv2-apply .loc-row { margin:12px 0; padding:10px 12px; background:var(--af2-surface-neutral); border-radius:12px; }
.lv2-apply .search-row { padding:8px 10px; border-radius:12px; background:var(--af2-surface-order); gap:8px; }
.lv2-apply .search-input { min-height:44px; font-size:15px; }
.lv2-apply .station-item { display:flex; flex-direction:column; align-items:stretch; border:0; border-bottom:1px solid var(--af2-line); border-radius:0; padding:16px 0; box-shadow:none; background:var(--af2-surface); gap:10px; }
.lv2-apply .station-main { display:flex; flex-direction:row; align-items:flex-start; gap:12px; min-width:0; margin-right:0; }
.lv2-apply .station-icon-wrap { display:flex; flex:none; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:var(--af2-surface-order); }
.lv2-apply .station-info { min-width:0; flex:1; }
.lv2-apply .station-name { font-size:16px; line-height:24px; }
.lv2-apply .station-address { font-size:14px; line-height:22px; }
.lv2-apply .station-distance { font-size:12px; line-height:20px; }
.lv2-apply .b2-join-action { align-self:flex-end; }
.lv2-apply .station-map-link { min-height:44px; padding:4px 0; font-size:13px; }
.lv2-apply .footer { padding:12px 16px calc(12px + env(safe-area-inset-bottom)); display:flex; flex-wrap:wrap; gap:8px 16px; }
