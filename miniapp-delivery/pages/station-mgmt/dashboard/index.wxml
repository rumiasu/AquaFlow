<view class="container">
  <view class="stats-grid" wx:if="{{!loading}}">
    <view class="stat-card">
      <text class="stat-value">{{stats.pendingOrders || 0}}</text>
      <text class="stat-label">待配送</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.pendingCount || 0}}</text>
      <text class="stat-label">待接单</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.completedCount || 0}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.customerCount || 0}}</text>
      <text class="stat-label">客户数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.inventoryTotal || 0}}</text>
      <text class="stat-label">库存总量</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.lowStock || 0}}</text>
      <text class="stat-label">低库存</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.totalBucketsOwed || 0}}</text>
      <text class="stat-label">客户欠桶</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.unpaidOrders || 0}}</text>
      <text class="stat-label">未支付</text>
    </view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>