<page-meta page-style="{{showProductPicker ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page">
  <view class="intro-card">
    <text class="title">单独办理桶押金</text>
    <text class="tip">{{stationName || '水站名称待核实'}} · 押金由所选水站保管。</text>
  </view>
  <text class="error" wx:if="{{error}}">{{error}}</text>
  <button class="af-action af-action--secondary" wx:if="{{needLogin}}" bindtap="onLogin">登录后办理本人桶押金</button>
  <view class="recovery" wx:if="{{recoveryEntries.length > 0 || recoveryError}}">
    <text class="section-title">原购买结果待核实</text>
    <button class="af-action af-action--quiet" bindtap="onToggleRecoveryDetails"><text class="af-action__face">{{showRecoveryDetails ? '收起购买编号' : '查看购买编号'}}</text></button>
    <text class="error" wx:if="{{recoveryError}}">{{recoveryError}}</text>
    <text class="tip" wx:if="{{recoveryHint}}">{{recoveryHint}}</text>
    <view class="recovery-record" wx:for="{{recoveryEntries}}" wx:key="key">
      <text class="record-id" wx:if="{{showRecoveryDetails}}">{{item.active ? '当前原购买' : '已保留原购买'}} · 请求编号 {{item.key}}</text>
      <text>{{item.summary}}</text>
      <text class="tip" wx:if="{{item.known}}">购买编号 {{item.record.id}} · ¥{{item.record.amount}} · {{item.record.statusText}}</text>
      <text class="tip" wx:else>原购买结果尚未确认，请勿改内容重复购买。</text>
      <button class="af-action af-action--quiet" data-key="{{item.key}}" bindtap="onQueryOriginal" disabled="{{busy || recoveryBusy || safetyBlocked}}" loading="{{recoveryBusy}}"><text class="af-action__face">查询原购买</text></button>
      <button class="af-action af-action--secondary" wx:if="{{!item.known || item.record.status === 'PENDING'}}" data-key="{{item.key}}" bindtap="onRetryOriginal" disabled="{{busy || recoveryBusy || safetyBlocked}}" loading="{{busy}}">恢复原请求</button>
    </view>
    <button class="af-action af-action--secondary" wx:if="{{canAnother}}" bindtap="onAnotherPurchase" disabled="{{busy || recoveryBusy || safetyBlocked}}">明确另买一笔</button>
  </view>
  <text class="tip" wx:if="{{productsLoading}}">正在加载可购买商品…</text>
  <view wx:elif="{{productsError}}">
    <text class="error">{{productsError}}</text>
    <button class="af-action af-action--quiet" bindtap="loadProducts" disabled="{{busy}}"><text class="af-action__face">重试加载商品</text></button>
  </view>
  <text class="tip" wx:elif="{{productsLoaded && products.length === 0}}">该站暂无可购买押金的桶装水，已有购买记录仍可在下方查看。</text>
  <view class="purchase-form" wx:elif="{{productsLoaded}}">
    <view class="selected-product" wx:if="{{productOptions[index]}}">
      <image wx:if="{{productOptions[index].image && !selectedImageFailed}}" class="selected-photo" src="{{productOptions[index].image}}" mode="aspectFit" binderror="onSelectedImageError" />
      <view wx:else class="selected-photo selected-placeholder">水</view>
      <view class="selected-copy"><text class="selected-name">{{productOptions[index].name || '商品名称待确认'}}</text><text wx:if="{{productOptions[index].spec}}" class="selected-detail">{{productOptions[index].spec}}</text><text class="selected-detail">{{productOptions[index].priceText}}</text></view>
      <button class="af-action af-action--quiet change-product" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}" bindtap="onOpenProductPicker">更换 ›</button>
    </view>
    <view class="field"><text>数量（份）</text><integer-stepper value="{{quantity}}" min="{{1}}" max="{{1000}}" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}" bind:change="onQuantity" /></view>
    <text class="error" wx:if="{{quantityError}}">{{quantityError}}</text>
  </view>
  <text class="tip" wx:if="{{quoteLoading}}">正在确认本次押金金额…</text>
  <view wx:elif="{{quoteError}}">
    <text class="error">{{quoteError}}</text>
    <button class="af-action af-action--quiet" bindtap="refreshQuote" disabled="{{busy}}"><text class="af-action__face">重试确认金额</text></button>
  </view>
  <view class="quote-card" wx:elif="{{quote}}">
    <text class="quote-label">本次押金 · {{quantity}} 份</text>
    <text class="amount">¥{{quote.amount}}</text>
    <text class="quote-notice">{{quoteNotice}}</text>
  </view>
  <view class="payment-options" wx:if="{{quote && !quoteLoading && !quoteError}}">
    <text class="section-title">支付方式</text>
    <button class="method-choice af-choice {{paymentMethod === 2 ? 'af-choice--selected' : ''}}" data-method="2" bindtap="onMethod" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}"><text class="af-choice__face">{{paymentMethod === 2 ? '已选：' : ''}}向水站交现金，水站确认收款后生效</text></button>
    <text class="tip" wx:if="{{onlinePayHint}}">{{onlinePayHint}}</text>
    <button class="method-choice af-choice {{paymentMethod === 1 ? 'af-choice--selected' : ''}}" wx:if="{{onlinePayEnabled}}" data-method="1" bindtap="onMethod" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked || quoteLoading}}"><text class="af-choice__face">{{paymentMethod === 1 ? '已选：' : ''}}{{onlinePayLabel}}</text></button>
  </view>
  <button class="af-action af-action--primary af-action--block af-action--final" bindtap="onPurchase" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked || !quote || quoteLoading || productsLoading || !productsLoaded || productsError || products.length === 0 || (paymentMethod === 1 && !onlinePayEnabled)}}" loading="{{busy}}">确认新的桶押金购买</button>
  <button class="af-action af-action--cancel" bindtap="onBack">{{fromOrder ? '返回继续订水' : '返回'}}</button>
  <view class="history">
    <button class="af-action af-action--quiet" bindtap="onToggleHistory"><text class="af-action__face">已有购买记录 {{purchases.length}} 笔 · {{showHistory ? '收起' : '展开'}}</text></button>
    <text class="tip" wx:if="{{showHistory || hasPendingPurchase}}">商品下架后仍可查看购买记录。已付款但水站未确认，请先联系水站核实，勿直接撤回。</text>
    <text class="tip" wx:if="{{purchasesLoading}}">正在加载购买记录…</text>
    <view wx:elif="{{purchasesError}}">
      <text class="error">{{purchasesError}}</text>
      <text class="tip" wx:if="{{purchases.length > 0}}">下方为上次加载的记录，请重试确认最新状态后再办理。</text>
    </view>
    <text class="tip" wx:elif="{{purchasesLoaded && purchases.length === 0}}">该站暂无桶押金购买记录。</text>
    <button class="af-action af-action--quiet" wx:if="{{stationId && (showHistory || purchasesError)}}" bindtap="loadPurchases" disabled="{{purchasesLoading || withdrawingId}}" loading="{{purchasesLoading}}"><text class="af-action__face">{{purchasesError ? '重试加载购买记录' : '刷新购买记录'}}</text></button>
    <view class="record" wx:for="{{purchases}}" wx:key="id" wx:if="{{showHistory || item.status === 'PENDING'}}">
      <text class="record-id">购买编号 {{item.id}}</text>
      <text>购买 {{item.quantity}} 份 · ¥{{item.amount}} · {{item.statusText}}</text>
      <button class="af-action af-action--danger-quiet" wx:if="{{item.status === 'PENDING'}}" data-id="{{item.id}}" bindtap="onWithdraw" disabled="{{busy || purchasesLoading || purchasesError || withdrawingId}}" loading="{{withdrawingId === item.id}}">撤回尚未交款的购买</button>
    </view>
  </view>
  <view class="product-mask" wx:if="{{showProductPicker}}" bindtap="onCloseProductPicker"></view>
  <view class="product-sheet" wx:if="{{showProductPicker}}" catchtap="stopProductPickerTap">
    <view class="product-sheet-head"><text>选择商品</text><button class="af-action af-action--quiet" bindtap="onCloseProductPicker">关闭</button></view>
    <input class="product-search" placeholder="搜索商品名称或规格" value="{{productSearch}}" bindinput="onProductSearch" />
    <scroll-view scroll-y class="product-results"><product-selector items="{{filteredProductOptions}}" selected-id="{{products[index].id}}" disabled="{{busy || recoveryBusy || originalActive || safetyBlocked}}" bind:change="onProductSelect" /><text class="tip" wx:if="{{!filteredProductOptions.length}}">没有找到匹配商品</text></scroll-view>
  </view>
</view>
<business-dialog id="business-dialog" />
