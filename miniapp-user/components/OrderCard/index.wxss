@import "../../styles/actions.wxss";
.order-card {
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
  transition: transform 0.15s;
}

.order-card:active {
  background: var(--bg-gray);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-id {
  font-size: 28rpx;
  color: var(--text-regular);
  font-weight: 500;
}

.status-group {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-tag.warning {
  background: rgba(217, 119, 6, 0.08);
  color: var(--warning-color);
}

.status-tag.primary {
  background: var(--primary-bg);
  color: var(--primary-color);
}

.status-tag.success {
  background: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
}

.status-tag.cancelled {
  background: rgba(255, 59, 48, 0.08);
  color: var(--error-color);
}

.status-tag.default {
  background: var(--bg-gray);
  color: var(--text-secondary);
}

.pay-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.pay-tag.paid {
  background: rgba(5, 150, 105, 0.08);
  color: var(--success-color);
}

.pay-tag.warning {
  background: rgba(217, 119, 6, 0.08);
  color: var(--warning-color);
}

.pay-tag.other {
  background: var(--bg-gray);
  color: var(--text-secondary);
}

.card-content {
  margin-bottom: 16rpx;
}

/* 多明细时：`product-info` 的 `align-items: center` 会让长名字换行后跟数量错位，改成顶对齐 */
.product-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

/* 逐明细摘要（后端下发，含每款的单位与数量）—— 允许换行，不截断 */
.product-summary {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.order-item-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
}

/* ⚠️ 商品名不许截断（[2026-09-27] 产品口径），长名字换行显示；规格**不换行**（"19L" 被拆开没意义） */
.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding-top: 6rpx;
}

.product-qty {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-left: auto;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.delivery-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.address {
  font-size: 26rpx;
  color: var(--text-regular);
}

.time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.footer-left {
  display: flex;
  align-items: center;
}

.amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price-color);
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.btn-reorder, .btn-cancel {
  font-size: 14px;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  line-height: 1.6;
  margin: 0;
}

.btn-reorder {
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  background: #fff;
}

.btn-cancel {
  border: 1rpx solid var(--error-color);
  color: var(--error-color);
  background: #fff;
}

.card-header, .status-group, .card-footer, .footer-actions { flex-wrap: wrap; gap: 12rpx; }
.card-header { align-items: flex-start; }
.order-card { box-shadow: none; padding: 24rpx; }
.order-id { font-size: 26rpx; }
.status-tag, .pay-tag { font-size: 24rpx; line-height: 1.5; }
.address { font-size: 28rpx; word-break: break-all; }
.btn-pay, .btn-reorder, .btn-cancel { min-height: 44px; display: flex; align-items: center; justify-content: center; padding: 16rpx 24rpx; line-height: 1.5; font-size: 14px; border-radius: var(--radius-md); box-sizing: border-box; margin: 0; }
.btn-pay { color: #fff; background: var(--primary-color); }
.order-item-row { flex-wrap: wrap; }

/* 2026-10-22：仅留言省略一行，地址、商品、金额与动作仍按原规则完整展示。 */
.customer-note-preview {
  display: block;
  min-width: 0;
  max-width: 100%;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-regular);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-unknown, .order-card-empty { color: var(--text-regular); font-size: 28rpx; line-height: 1.6; }
.btn-pay, .btn-reorder, .btn-cancel { min-height: 44px; }
.footer-left { min-width: 0; }
.amount { overflow-wrap: anywhere; }

.footer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.footer-actions button.af-action{flex:none;min-width:44px;width:auto;margin:0}.footer-actions button.af-action--primary{min-height:48px}

/* Visual 28: white record, semantic state chips, factual amount, local actions. */
.order-card{padding:16px;border-radius:16px;border:1px solid var(--af2-line,#DCE5ED);background:var(--af2-surface,#FFFFFF);color:var(--af2-ink,#203047)}
.order-id{font-size:14px;line-height:22px;color:var(--af2-muted,#53687B)}
.status-tag,.pay-tag{font-size:12px;line-height:18px;padding:3px 8px;border-radius:6px}
.status-tag.warning,.status-tag.primary{background:var(--af2-surface-current,#DCEAFF);color:var(--af2-ink-current,#244F82)}
.pay-tag.warning{background:var(--af2-surface-money,#E7E2F7);color:var(--af2-ink-money,#54467C)}
.status-tag.success,.pay-tag.paid{background:var(--af2-surface-success,#E7F1EB);color:var(--af2-ink-success,#326451)}
.status-tag.cancelled,.status-tag.default,.pay-tag.other{background:var(--af2-surface-neutral,#EDF1F5);color:var(--af2-ink-neutral,#4A5B70)}
.product-name,.product-summary{font-size:16px;line-height:24px;color:var(--af2-ink,#203047)}
.product-spec,.time{font-size:13px;line-height:20px;color:var(--af2-muted,#53687B)}
.product-qty,.address,.customer-note-preview,.amount-unknown{font-size:14px;line-height:22px}
.card-footer{gap:12px;align-items:flex-start}
.footer-left{flex:1;min-width:100px;max-width:100%}
.amount{max-width:100%;font-size:20px;line-height:28px;color:var(--af2-ink,#203047);word-break:break-all}
.footer-actions{justify-content:flex-end;max-width:100%}
@media(max-width:340px){.card-footer{flex-direction:column;align-items:stretch}.footer-actions{justify-content:flex-end}.order-item-row{gap:8px}}
